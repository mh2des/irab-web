---
/**
 * /challenges: ready-made Arabic i'rab challenges. Login-gated and noindex;
 * Firebase and the sentence bank load lazily inside PracticePlay.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/sections/Footer.astro';
import PracticePlay from '../components/PracticePlay.astro';
---
<BaseLayout lang="ar" title="تحديات الإعراب · إعراب آب" description="تدرّب على جمل جاهزة وحدّد نوع كل كلمة وموقعها وعلامة إعرابها.">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <Nav lang="ar" />
  <main class="px-4 sm:px-6 py-8 md:py-12">
    <PracticePlay lang="ar" mode="curated" />
  </main>
  <Footer lang="ar" />
</BaseLayout>
