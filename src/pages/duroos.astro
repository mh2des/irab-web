---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/sections/Footer.astro';
import DuroosHub from '../components/duroos/DuroosHub.astro';
import { courseLessons } from '../lib/duroos-course';

// Hub for the grammar lessons. The curriculum lives in src/data/duroos.ts;
// every entry has a page at src/pages/duroos/<slug>.astro. The page itself is
// the DuroosHub component, shared with /en/duroos.
const site = 'https://irab.app';
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'دروس النحو: أبواب الإعراب',
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: courseLessons('ar').length,
  itemListElement: courseLessons('ar').map((l) => ({ '@type': 'ListItem', position: l.no, name: l.title, url: `${site}${l.href}` })),
};
---
<BaseLayout
  lang="ar"
  hasEn
  title="دروس النحو: شرح أبواب الإعراب درسًا درسًا · إعراب آب"
  description="دروس نحو مجانية بشرح واضح وأمثلة معربة إعرابًا كاملًا: الجملة الاسمية والفعلية، علامات الإعراب، كان وإنّ وأخواتهما، الحال والتمييز والنعت، حروف الجر وأدوات نصب المضارع وجزمه."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(itemList)} is:inline />
  <Nav lang="ar" />
  <DuroosHub lang="ar" />
  <Footer lang="ar" />
</BaseLayout>
