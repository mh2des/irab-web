---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import Byline from '../../components/Byline.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';
import AyatExamples from '../../components/duroos/AyatExamples.astro';

const faqs = [
  { q: 'لماذا يقال في المنادى "مبني في محل نصب"؟', a: 'لأن المنادى في الأصل مفعول به لفعل محذوف تقديره أدعو أو أنادي. فالعلم المفرد والنكرة المقصودة يبنيان على الضم ويبقى المحل نصبًا، أما المضاف والشبيه بالمضاف والنكرة غير المقصودة فتظهر فيها الأصل فتنصب لفظًا.' },
  { q: 'ما أحرف النداء؟', a: 'يا وهي أم الباب وأكثرها استعمالًا وتصلح لكل نداء، والهمزة وأي للقريب، وأيا وهيا للبعيد، ووا للندبة. وقد يحذف الحرف: ﴿يُوسُفُ أَعْرِضْ عَنْ هَذَا﴾ أي يا يوسف.' },
  { q: 'كيف ينادى ما فيه أل؟', a: 'لا تباشر يا الاسم المقترن بأل، بل يتوسل بأيها للمذكر وأيتها للمؤنث أو باسم الإشارة: يا أيها الرجلُ، يا أيتها النفسُ، يا هذا الرجلُ. فأي منادى نكرة مقصودة مبني على الضم، وها للتنبيه، والرجل صفة مرفوعة. ويستثنى لفظ الجلالة: يا اللهُ، والأكثر: اللهم.' },
  { q: 'ما إعراب "اللهم"؟', a: 'لفظ الجلالة منادى مبني على الضم في محل نصب، والميم المشددة عوض عن يا النداء المحذوفة، ولذلك لا يجمع بينهما إلا في ضرورة الشعر.' },
  { q: 'ما الفرق بين النكرة المقصودة وغير المقصودة؟', a: 'المقصودة يقصد بها واحد بعينه فتتعرف بالنداء وتبنى على الضم: "يا رجلُ" لرجل أمامك. وغير المقصودة لا يقصد بها معين فتبقى نكرة وتنصب: قال الأعمى: "يا رجلًا خذ بيدي" لأي رجل يسمع.' },
  { q: 'كيف ينادى المضاف إلى ياء المتكلم؟', a: 'يجوز فيه: يا صديقي بإثبات الياء، ويا صديقِ بحذفها والاكتفاء بالكسرة، وفي "يا أبي" و"يا أمي" تعوض التاء عن الياء: يا أبتِ، يا أمتِ، ومنه: ﴿يَا أَبَتِ افْعَلْ مَا تُؤْمَرُ﴾.' },
];
---
<BaseLayout
  lang="ar"
  hasEn
  title="المنادى: أنواعه الخمسة وأحكام بنائه ونصبه · إعراب آب"
  description="شرح المنادى: أحرف النداء، أنواعه الخمسة من العلم المفرد إلى المضاف، متى يبنى على الضم ومتى ينصب، ونداء ما فيه أل، مع أمثلة قرآنية معربة إعرابًا كاملًا."
>
  <ArticleSchema slot="head" lang="ar" kind="lesson" headline="المنادى" description="شرح المنادى: أحرف النداء، أنواعه الخمسة من العلم المفرد إلى المضاف، متى يبنى على الضم ومتى ينصب، ونداء ما فيه أل، مع أمثلة قرآنية معربة إعرابًا كاملًا." />
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="المنادى"
    summary="المنادى اسم يذكر بعد حرف نداء طلبًا لإقبال صاحبه، وهو في أصله مفعول به لفعل محذوف. أنواعه خمسة: اثنان يبنيان على الضم وثلاثة تنصب. هذا الدرس يعرض الأحرف والأنواع الخمسة ونداء ما فيه أل، بأمثلة قرآنية معربة كاملة."
  />
  <Byline lang="ar" kind="lesson" />

  <ArticleSection
    lang="ar"
    id="definition"
    title="التعريف وأحرف النداء"
    lead="النداء طلب الإقبال بحرف مخصوص. أشهر أحرفه: يا لكل نداء، والهمزة وأي للقريب، وأيا وهيا للبعيد، ووا للندبة. والمنادى في الأصل مفعول به لفعل محذوف تقديره أنادي."
  >
    <p><span class="ar">يَا طَالِبُ، اجْتَهِدْ</span></p>
    <p><strong>الإعراب:</strong> يا حرف نداء مبني على السكون لا محل له من الإعراب. طالبُ منادى نكرة مقصودة مبني على الضم في محل نصب. اجتهدْ فعل أمر مبني على السكون والفاعل ضمير مستتر وجوبًا تقديره أنت.</p>
    <p>فسر البناء على الضم مع كون المحل نصبًا أن أصل الكلام: أنادي طالبًا، فالمنادى <a href="/duroos/al-maful-bih">مفعول به</a> في المعنى، حذف عامله والتزم حذفه.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="mabni-types"
    title="ما يبنى على الضم: العلم والنكرة المقصودة"
    lead="نوعان من المنادى يبنيان على ما يرفعان به: العلم المفرد والنكرة المقصودة. ومعنى المفرد هنا ما ليس مضافًا ولا شبيهًا بالمضاف، ولو كان مثنى أو جمعًا."
  >
    <ul>
      <li><strong>العلم المفرد:</strong> <span class="ar">﴿يَا نُوحُ اهْبِطْ بِسَلَامٍ﴾</span>: نوحُ منادى علم مفرد مبني على الضم في محل نصب.</li>
      <li><strong>النكرة المقصودة:</strong> <span class="ar">يَا رَجُلُ، انْتَبِهْ</span> لرجل بعينه: رجلُ منادى نكرة مقصودة مبني على الضم في محل نصب.</li>
      <li><strong>المثنى والجمع مبنيان على ما يرفعان به:</strong> <span class="ar">يَا طَالِبَانِ</span> مبني على الألف، و<span class="ar">يَا مُسْلِمُونَ</span> مبني على الواو، في محل نصب.</li>
    </ul>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">نادِ وأعرِب.</span>
    ألصق جملة نداء في محلّل الإعراب وشاهده يحدد نوع المنادى الخمسة ويعلل البناء أو النصب، كلمة بكلمة.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="mansub-types"
    title="ما ينصب: المضاف والشبيه به وغير المقصودة"
    lead="ثلاثة أنواع تظهر فيها أصل المفعولية فتنصب لفظًا: المضاف، والشبيه بالمضاف، والنكرة غير المقصودة."
  >
    <ul>
      <li><strong>المضاف:</strong> <span class="ar">يَا عَبْدَ اللَّهِ</span>: عبدَ منادى مضاف منصوب وعلامة نصبه الفتحة الظاهرة وهو مضاف، ولفظ الجلالة مضاف إليه مجرور، وأحكام <a href="/duroos/al-idafa">الإضافة</a> في درسها.</li>
      <li><strong>الشبيه بالمضاف</strong> وهو ما اتصل به شيء يتمم معناه: <span class="ar">يَا طَالِعًا جَبَلًا</span>: طالعًا منادى شبيه بالمضاف منصوب، وجبلًا مفعول به لاسم الفاعل.</li>
      <li><strong>النكرة غير المقصودة:</strong> قول الأعمى: <span class="ar">يَا رَجُلًا خُذْ بِيَدِي</span>: رجلًا منادى نكرة غير مقصودة منصوب وعلامة نصبه الفتحة الظاهرة.</li>
    </ul>
    <p>مثال قرآني للمضاف: <span class="ar">﴿قَالَ يَا ابْنَ أُمَّ لَا تَأْخُذْ بِلِحْيَتِي﴾</span>: ابنَ منادى مضاف منصوب وعلامة نصبه الفتحة.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="al-and-allahumma"
    title="نداء ما فيه أل"
    lead="لا تدخل يا على المقترن بأل مباشرة، فيتوصل إليه بأيها وأيتها أو باسم الإشارة، ويستثنى لفظ الجلالة."
  >
    <p><span class="ar">﴿يَا أَيُّهَا النَّاسُ اتَّقُوا رَبَّكُمْ﴾</span></p>
    <p><strong>الإعراب:</strong> يا حرف نداء. أيُّ منادى نكرة مقصودة مبني على الضم في محل نصب، وها حرف تنبيه لا محل له. الناسُ صفة لأيّ مرفوعة وعلامة رفعها الضمة الظاهرة على اللفظ. اتقوا فعل أمر مبني على حذف النون وواو الجماعة فاعل، وربكم مفعول به منصوب والكاف مضاف إليه.</p>
    <p>ولفظ الجلالة خاصة ينادى مباشرة: <span class="ar">يَا اللهُ</span>، والأكثر التعويض بالميم: <span class="ar">اللَّهُمَّ</span>، منادى مبني على الضم والميم المشددة عوض عن حرف النداء.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="common-mistakes"
    title="أخطاء شائعة"
    lead="أشيع أخطاء الباب نصب المبني ورفع المنصوب، ومباشرة يا لما فيه أل، وإغفال حذف حرف النداء."
  >
    <ul>
      <li>يقال خطأً "يا محمدًا" بالتنوين والنصب، والصواب <span class="ar">يَا مُحَمَّدُ</span> بالبناء على الضم للعلم المفرد.</li>
      <li>يقال خطأً "يا عبدُ اللهِ" بالضم، والصواب <span class="ar">يَا عَبْدَ اللَّهِ</span> بالنصب للمضاف.</li>
      <li>يقال خطأً "يا الرجلُ"، والصواب <span class="ar">يَا أَيُّهَا الرَّجُلُ</span>.</li>
      <li>قد يحذف حرف النداء: <span class="ar">﴿يُوسُفُ أَعْرِضْ عَنْ هَذَا﴾</span> أي يا يوسفُ، فلا تعرب يوسف مبتدأ.</li>
    </ul>
    <p>وإذا وقع بعد المنادى نعت أو <a href="/duroos/al-tawkid">توكيد</a> أو <a href="/duroos/al-badal">بدل</a> فلكل حكمه في باب التوابع، والأصل الجامع في <a href="/irab">الإعراب</a>.</p>
  </ArticleSection>

  <AyatExamples slug="al-munada" />

  <ArticleFaq lang="ar" items={faqs} />

  <Footer lang="ar" />
</BaseLayout>
