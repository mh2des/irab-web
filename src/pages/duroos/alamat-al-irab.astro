---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';

const faqs = [
  { q: 'ما الفرق بين علامات الإعراب الأصلية والفرعية؟', a: 'الأصلية أربع حركات: الضمة للرفع والفتحة للنصب والكسرة للجر والسكون للجزم، وهي الأصل في كل معرب. والفرعية حروف وحركات تنوب عنها في أبواب معدودة، كالواو في جمع المذكر السالم، والألف في المثنى، وثبوت النون في الأفعال الخمسة. فإذا لم تكن الكلمة من تلك الأبواب أعربت بالحركات الأصلية.' },
  { q: 'ما المواضع التي تنوب فيها العلامات الفرعية عن الأصلية؟', a: 'سبعة أبواب: المثنى، وجمع المذكر السالم، وجمع المؤنث السالم، والممنوع من الصرف، والأسماء الخمسة، والأفعال الخمسة، والفعل المضارع المعتل الآخر. وما عداها يعرب بالحركات الأصلية الظاهرة أو المقدرة.' },
  { q: 'هل السكون علامة إعراب أم علامة بناء؟', a: 'كلاهما بحسب الموضع. فهو علامة إعراب في جزم المضارع الصحيح الآخر نحو لم يكتبْ، وهو علامة بناء في الحروف نحو مِنْ، وفي الماضي المتصل بضمير رفع متحرك نحو كتبْتُ. والعبرة بحال الكلمة: المعرب يتغير آخره بتغير العوامل، والمبني يلزم حالة واحدة.' },
  { q: 'ما الإعراب التقديري ومتى نلجأ إليه؟', a: 'هو تقدير الحركة على آخر الكلمة دون ظهورها. تقدر الحركات كلها على الألف للتعذر نحو الفتى، وتقدر الضمة والكسرة على الياء للثقل نحو القاضي، أما الفتحة فتظهر عليها لخفتها فنقول: رأيت القاضيَ.' },
  { q: 'لماذا يجر الممنوع من الصرف بالفتحة؟', a: 'لأنه أشبه الفعل في امتناعه من التنوين فحمل عليه في الجر، والفعل لا يدخله جر ولا كسر، فنابت الفتحة عن الكسرة. فإذا اقترن الاسم بأل أو أضيف زال شبه الفعل وعاد إلى أصله فجر بالكسرة.' },
  { q: 'كيف أتدرب على تمييز علامات الإعراب؟', a: 'اقرأ نصوصا مشكولة وتتبع أواخر الكلمات، ثم أعرب جملة واحدة كل يوم إعرابا كاملا بالصياغة المعتمدة. ويمكنك لصق أي جملة في المحلل على الصفحة الرئيسية لترى علامة كل كلمة وسببها، ثم الانتقال إلى قسم التدريب حيث يصحح لك الذكاء الاصطناعي إجابتك خطوة خطوة.' },
];
---
<BaseLayout
  lang="ar"
  title="علامات الإعراب: الأصلية والفرعية · إعراب"
  description="علامات الإعراب الأصلية والفرعية في النحو العربي: الضمة والفتحة والكسرة والسكون، وما ينوب عنها من الواو والألف والياء والنون، مع أمثلة إعراب كاملة."
>
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    eyebrow="دروس النحو"
    title="علامات الإعراب"
    summary="علامات الإعراب هي الرموز التي يتغير بها آخر الكلمة المعربة بحسب موقعها من الجملة. أصولها أربع: الضمة والفتحة والكسرة والسكون، وتنوب عنها علامات فرعية في سبعة أبواب كالمثنى والجموع والأسماء الخمسة والأفعال الخمسة. هذا الدرس يعرض العلامات الأصلية ثم مواضع النيابة كلها، مع أمثلة معربة إعرابا كاملا على طريقة كتب النحو."
  />

  <ArticleSection
    lang="ar"
    id="original-signs"
    title="العلامات الأصلية الأربع"
    lead="الأصل في الرفع الضمة، وفي النصب الفتحة، وفي الجر الكسرة، وفي الجزم السكون. الرفع والنصب يدخلان الأسماء والأفعال، والجر خاص بالأسماء، والجزم خاص بالأفعال. وكل ما سوى هذه الحركات الأربع علامات فرعية تنوب عنها في أبواب معدودة."
  >
    <ul>
      <li><strong>الضمة</strong> علامة الرفع الأصلية: <span class="ar">جَاءَ الْمُعَلِّمُ</span>، فالمعلمُ فاعل مرفوع وعلامة رفعه الضمة الظاهرة.</li>
      <li><strong>الفتحة</strong> علامة النصب الأصلية: <span class="ar">قَرَأْتُ الْكِتَابَ</span>، فالكتابَ مفعول به منصوب وعلامة نصبه الفتحة الظاهرة.</li>
      <li><strong>الكسرة</strong> علامة الجر الأصلية: <span class="ar">نَظَرْتُ فِي الْكِتَابِ</span>، فالكتابِ اسم مجرور بفي وعلامة جره الكسرة الظاهرة.</li>
      <li><strong>السكون</strong> علامة الجزم الأصلية: <span class="ar">لَمْ يَذْهَبْ مُحَمَّدٌ</span>، فيذهبْ فعل مضارع مجزوم بلم وعلامة جزمه السكون.</li>
    </ul>
    <p>ولاحظ أن الجزم لا يدخل إلا الفعل المضارع، وأن الجر لا يدخل إلا الأسماء. فإذا رأيت كسرة في آخر فعل فهي حركة عارضة لالتقاء الساكنين، لا علامة إعراب.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="worked-examples-original"
    title="أمثلة معربة بالعلامات الأصلية"
    lead="قبل الانتقال إلى العلامات الفرعية، ثبت الأصل بأمثلة كاملة. ولاحظ الصياغة الكلاسيكية التي سنلتزمها في كل مثال: نذكر موقع الكلمة، ثم حكمها الإعرابي، ثم علامتها وسببها."
  >
    <p><span class="ar">الْعِلْمُ نُورٌ</span>: العلمُ مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة، نورٌ خبر مرفوع وعلامة رفعه الضمة الظاهرة. وهذا هو نمط <a href="/duroos/al-mubtada-wal-khabar">المبتدأ والخبر</a> في أبسط صوره.</p>
    <p><span class="ar">كَتَبَ الطَّالِبُ الدَّرْسَ</span>: كتب فعل ماضٍ مبني على الفتح، الطالبُ فاعل مرفوع وعلامة رفعه الضمة الظاهرة، الدرسَ مفعول به منصوب وعلامة نصبه الفتحة الظاهرة.</p>
    <p><span class="ar">لَمْ يَذْهَبْ خَالِدٌ إِلَى السُّوقِ</span>: لم حرف نفي وجزم وقلب، يذهبْ فعل مضارع مجزوم بلم وعلامة جزمه السكون، خالدٌ فاعل مرفوع وعلامة رفعه الضمة الظاهرة، إلى حرف جر، السوقِ اسم مجرور بإلى وعلامة جره الكسرة الظاهرة.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="substitute-signs"
    title="العلامات الفرعية ومواضع النيابة"
    lead="تنوب علامات فرعية عن الأصلية في سبعة أبواب لا ثامن لها. في المثنى وجمع المذكر السالم والأسماء الخمسة تنوب الحروف عن الحركات، وفي جمع المؤنث السالم والممنوع من الصرف تنوب حركة عن حركة، وفي الأفعال الخمسة والمعتل الآخر ينوب الثبوت والحذف."
  >
    <ul>
      <li><strong>المثنى</strong>: يرفع بالألف وينصب ويجر بالياء: <span class="ar">نَجَحَ الطَّالِبَانِ</span>، فالطالبان فاعل مرفوع وعلامة رفعه الألف لأنه مثنى.</li>
      <li><strong>جمع المذكر السالم</strong>: يرفع بالواو وينصب ويجر بالياء: <span class="ar">جَاءَ الْمُعَلِّمُونَ</span>، فالمعلمون فاعل مرفوع وعلامة رفعه الواو لأنه جمع مذكر سالم.</li>
      <li><strong>جمع المؤنث السالم</strong>: ينصب بالكسرة نيابة عن الفتحة: <span class="ar">كَرَّمْتُ الطَّالِبَاتِ</span>.</li>
      <li><strong>الممنوع من الصرف</strong>: يجر بالفتحة نيابة عن الكسرة، وتفصيل أسبابه وأحكامه في درس <a href="/duroos/al-mamnu-min-al-sarf">الممنوع من الصرف</a>.</li>
      <li><strong>الأسماء الخمسة</strong>: ترفع بالواو وتنصب بالألف وتجر بالياء، وشروطها في درس <a href="/duroos/al-asma-al-khamsa">الأسماء الخمسة</a>.</li>
      <li><strong>الأفعال الخمسة</strong>: ترفع بثبوت النون وتنصب وتجزم بحذفها، وتفصيلها في درس <a href="/duroos/al-afal-al-khamsa">الأفعال الخمسة</a>.</li>
      <li><strong>المضارع المعتل الآخر</strong>: يجزم بحذف حرف العلة: <span class="ar">لَمْ يَدْعُ، لَمْ يَسْعَ، لَمْ يَرْمِ</span>.</li>
    </ul>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">طبق الدرس على جملتك.</span>
    ألصق أي جملة عربية في المحلل على الصفحة الرئيسية وشاهد علامة الإعراب لكل كلمة، أصلية كانت أو فرعية، مع بيان سببها خلال ثوانٍ.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="worked-examples-substitute"
    title="أمثلة معربة بالعلامات الفرعية"
    lead="أربعة أمثلة تجمع أشهر مواضع النيابة. تأمل كيف تذكر العلامة الفرعية دائما مقرونة بسببها: لأنه مثنى، لأنه جمع مذكر سالم، لأنه من الأسماء الخمسة، لأنه من الأفعال الخمسة."
  >
    <p><span class="ar">رَأَيْتُ أَبَاكَ فِي الْمَسْجِدِ</span>: رأيتُ فعل ماضٍ مبني على السكون لاتصاله بتاء الفاعل، والتاء ضمير متصل مبني في محل رفع فاعل، أباك مفعول به منصوب وعلامة نصبه الألف لأنه من الأسماء الخمسة وهو مضاف، والكاف ضمير متصل مبني في محل جر مضاف إليه، في حرف جر، المسجدِ اسم مجرور بفي وعلامة جره الكسرة الظاهرة.</p>
    <p><span class="ar">الْمُسْلِمُونَ يُصَلُّونَ فِي الْمَسْجِدِ</span>: المسلمون مبتدأ مرفوع وعلامة رفعه الواو لأنه جمع مذكر سالم، يصلون فعل مضارع مرفوع وعلامة رفعه ثبوت النون لأنه من الأفعال الخمسة، وواو الجماعة ضمير متصل مبني في محل رفع فاعل، والجملة الفعلية في محل رفع خبر المبتدأ.</p>
    <p><span class="ar">كَرَّمَتِ الْمَدْرَسَةُ الطَّالِبَاتِ</span>: كرم فعل ماضٍ مبني على الفتح، والتاء تاء التأنيث الساكنة حرف لا محل له من الإعراب (حركت بالكسر لالتقاء الساكنين)، المدرسةُ فاعل مرفوع وعلامة رفعه الضمة الظاهرة، الطالباتِ مفعول به منصوب وعلامة نصبه الكسرة نيابة عن الفتحة لأنه جمع مؤنث سالم.</p>
    <p><span class="ar">لَمْ يَدْعُ خَالِدٌ صَدِيقَهُ</span>: لم حرف نفي وجزم وقلب، يدعُ فعل مضارع مجزوم بلم وعلامة جزمه حذف حرف العلة وهو الواو، خالدٌ فاعل مرفوع وعلامة رفعه الضمة الظاهرة، صديقَه مفعول به منصوب وعلامة نصبه الفتحة الظاهرة وهو مضاف، والهاء ضمير متصل مبني في محل جر مضاف إليه.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="visible-and-estimated"
    title="الإعراب الظاهر والمقدر"
    lead="قد تكون العلامة مقدرة لا ظاهرة. تقدر الحركات الثلاث على الألف للتعذر، وتقدر الضمة والكسرة على الياء والواو للثقل، أما الفتحة فتظهر عليهما لخفتها. هذا الباب يفسر لماذا لا نرى حركة على بعض الكلمات مع أنها معربة."
  >
    <p><span class="ar">جَاءَ الْفَتَى</span>: الفتى فاعل مرفوع وعلامة رفعه الضمة المقدرة على الألف منع من ظهورها التعذر.</p>
    <p><span class="ar">حَكَمَ الْقَاضِي بِالْعَدْلِ</span>: القاضي فاعل مرفوع وعلامة رفعه الضمة المقدرة على الياء منع من ظهورها الثقل، بالعدل جار ومجرور.</p>
    <p>فإذا نصبت قلت: <span class="ar">رَأَيْتُ الْقَاضِيَ</span> بفتحة ظاهرة، لأن الفتحة خفيفة تظهر على الياء ولا تثقل.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="choosing-the-sign"
    title="كيف تحدد العلامة الصحيحة؟"
    lead="اجعل تحديد العلامة خطوات مرتبة: حدد نوع الكلمة أولا، ثم موقعها من الجملة، ثم اسأل: هل هي من الأبواب السبعة؟ إن لم تكن منها فالعلامة أصلية، وإن كانت منها فاذكر العلامة الفرعية مقرونة بسببها."
  >
    <ol>
      <li><strong>حدد نوع الكلمة:</strong> اسم مفرد، أم مثنى، أم جمع، أم فعل مضارع؟ فهذا يحصر العلامات الممكنة.</li>
      <li><strong>حدد الموقع من الجملة:</strong> فاعل، مبتدأ، مفعول به، اسم مجرور. فالموقع يحدد الحكم: رفع أو نصب أو جر أو جزم. وإن أشكل عليك الموقع فراجع أساسيات <a href="/nahw">النحو</a> أولا.</li>
      <li><strong>اسأل عن الأبواب السبعة:</strong> إن كانت الكلمة منها فالعلامة فرعية مع ذكر السبب، وإلا فالحركة الأصلية ظاهرة أو مقدرة.</li>
      <li><strong>اختم بالصياغة الكاملة:</strong> الموقع ثم الحكم ثم العلامة، كما جرى عليه أهل <a href="/irab">الإعراب</a> في كتبهم المعتمدة.</li>
    </ol>
  </ArticleSection>

  <ArticleFaq lang="ar" items={faqs} />

  <Footer lang="ar" />
</BaseLayout>
