const faqs = [
  { q: 'ما ركنا الجملة الاسمية؟', a: 'ركناها المبتدأ والخبر، وكلاهما مرفوع. المبتدأ اسم تفتتح به الجملة في الأصل، والخبر هو الجزء الذي تتم به مع المبتدأ الفائدة. ففي "العلمُ نورٌ": العلم مبتدأ مرفوع، ونور خبر مرفوع.' },
  { q: 'هل يجوز أن تبدأ الجملة الاسمية بنكرة؟', a: 'الأصل أن يكون المبتدأ معرفة، ويجوز الابتداء بالنكرة إذا أفادت: بأن تكون موصوفة (رجلٌ كريمٌ زارنا)، أو مسبوقة بنفي أو استفهام (ما أحدٌ عندنا)، أو دالة على دعاء (سلامٌ عليكم)، أو تقدم عليها خبر شبه جملة (في الدار رجلٌ).' },
  { q: 'متى يجب تقديم الخبر على المبتدأ؟', a: 'يجب التقديم إذا كان الخبر شبه جملة والمبتدأ نكرة (في الدار رجلٌ)، وإذا كان الخبر مما له الصدارة كأسماء الاستفهام (أين الكتابُ؟)، وإذا اتصل بالمبتدأ ضمير يعود على شيء في الخبر (في الدار صاحبُها).' },
  { q: 'ما أنواع الخبر؟', a: 'ثلاثة: خبر مفرد (العلمُ نورٌ)، وخبر جملة اسمية أو فعلية بشرط اشتمالها على رابط يعود على المبتدأ (الحديقةُ أزهارُها جميلةٌ)، وخبر شبه جملة من جار ومجرور أو ظرف (الكتابُ فوقَ الطاولةِ).' },
  { q: 'ماذا يحدث للجملة الاسمية إذا دخلت عليها كان أو إن؟', a: 'كان وأخواتها ترفع المبتدأ ويسمى اسمها وتنصب الخبر ويسمى خبرها. وإنّ وأخواتها تعمل العكس: تنصب المبتدأ اسمًا لها وترفع الخبر خبرًا لها. وتسمى هذه الأفعال والحروف النواسخ لأنها تنسخ حكم الرفع في الركنين.' },
  { q: 'ما الفرق بين الجملة الاسمية والجملة الفعلية؟', a: 'الاسمية تبدأ باسم وتدل في الغالب على الثبوت، والفعلية تبدأ بفعل وتدل على الحدوث والتجدد. وعند البصريين إذا تقدم الاسم على الفعل، مثل "الطالبُ كتبَ"، فالجملة اسمية، والاسم مبتدأ، والجملة الفعلية بعده خبر.' },
];
---
<BaseLayout
  lang="ar"
  title="الجملة الاسمية: تعريفها وركناها وأحكامها · إعراب آب"
  description="شرح الجملة الاسمية في النحو: تعريفها، ركناها المبتدأ والخبر، أنواع الخبر، تقديم الخبر والابتداء بالنكرة، ودخول كان وإن عليها، مع أمثلة معربة إعرابا كاملا."
>
  <ArticleSchema slot="head" lang="ar" kind="lesson" headline="الجملة الاسمية" description="شرح الجملة الاسمية في النحو: تعريفها، ركناها المبتدأ والخبر، أنواع الخبر، تقديم الخبر والابتداء بالنكرة، ودخول كان وإن عليها، مع أمثلة معربة إعرابا كاملا." />
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="الجملة الاسمية"
    summary="الجملة الاسمية هي الجملة التي تبدأ باسم، وركناها المبتدأ والخبر، وحكمهما الرفع. ويدور عليها باب واسع من أبواب النحو: أنواع الخبر، والابتداء بالنكرة، وتقديم الخبر، ودخول النواسخ. في هذا الدرس نعرض القاعدة بلغة واضحة، ثم نطبقها في أمثلة معربة إعرابًا كاملًا كما تُكتب في كتب النحو."
  />
  <Byline lang="ar" kind="lesson" />

  <ArticleSection
    lang="ar"
    id="definition"
    title="ما الجملة الاسمية؟"
    lead="الجملة الاسمية عند النحويين هي الجملة التي يكون صدرها اسمًا، مثل: العلمُ نورٌ. وهي تدل في الغالب على الثبوت والدوام، بخلاف الجملة الفعلية التي تدل على الحدوث والتجدد. ومعرفة نوع الجملة هي الخطوة الأولى في أي إعراب صحيح."
  >
    <p>المقصود بصدر الجملة أول ما تفتتح به من كلماتها الأصلية. فجملة <span class="ar">مُحَمَّدٌ مُسَافِرٌ</span> اسمية لأن صدرها اسم، وكذلك <span class="ar">الطَّالِبُ كَتَبَ الدَّرْسَ</span> اسمية عند البصريين، لأن الاسم تقدم على الفعل فصار مبتدأ، والجملة الفعلية بعده في محل رفع خبر. أما <a href="/duroos/al-jumla-al-filiyya">الجملة الفعلية</a> فهي ما بدأت بفعل، مثل: <span class="ar">كَتَبَ الطَّالِبُ الدَّرْسَ</span>.</p>
    <p>وقد بيّنا في درس <a href="/nahw">النحو</a> أن تقسيم الجملة إلى اسمية وفعلية هو مدخل كل تحليل نحوي، فكل باب من أبواب الإعراب يرجع في النهاية إلى أحد هذين البناءين.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="two-pillars"
    title="ركنا الجملة: المبتدأ والخبر"
    lead="للجملة الاسمية ركنان لا تقوم إلا بهما: المبتدأ، وهو الاسم الذي تفتتح به الجملة وتبنى عليه، والخبر، وهو الجزء الذي تتم به مع المبتدأ الفائدة. وحكمهما الرفع: فالمبتدأ مرفوع بالابتداء، والخبر مرفوع بالمبتدأ."
  >
    <p><strong>المثال الأول:</strong> <span class="ar">الْعِلْمُ نُورٌ</span>: العلمُ مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة على آخره، نورٌ خبر مرفوع وعلامة رفعه الضمة الظاهرة على آخره.</p>
    <p><strong>المثال الثاني:</strong> <span class="ar">الْمُؤْمِنُونَ صَادِقُونَ</span>: المؤمنون مبتدأ مرفوع وعلامة رفعه الواو لأنه جمع مذكر سالم، صادقون خبر مرفوع وعلامة رفعه الواو لأنه جمع مذكر سالم.</p>
    <p>والأصل في المبتدأ أن يكون معرفة، لأن الحكم على مجهول لا يفيد السامع. ولهذين الركنين تفصيل واسع في أنواعهما وأحكام كل منهما تجده في درس <a href="/duroos/al-mubtada-wal-khabar">المبتدأ والخبر</a>.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="types-of-khabar"
    title="أنواع الخبر الثلاثة"
    lead="يأتي الخبر على ثلاث صور: خبر مفرد وهو ما ليس جملة ولا شبه جملة، وخبر جملة اسمية أو فعلية بشرط اشتمالها على رابط يعود على المبتدأ، وخبر شبه جملة من الجار والمجرور أو الظرف."
  >
    <ul>
      <li><strong>الخبر المفرد:</strong> <span class="ar">الصِّدْقُ فَضِيلَةٌ</span>: الصدقُ مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة، فضيلةٌ خبر مرفوع وعلامة رفعه الضمة الظاهرة. والمفرد هنا ما ليس جملة ولا شبه جملة، ولو كان مثنى أو جمعًا.</li>
      <li><strong>الخبر الجملة:</strong> <span class="ar">الْحَدِيقَةُ أَزْهَارُهَا جَمِيلَةٌ</span>: الحديقةُ مبتدأ أول مرفوع وعلامة رفعه الضمة الظاهرة، أزهارُ مبتدأ ثانٍ مرفوع وعلامة رفعه الضمة الظاهرة وهو مضاف، والهاء ضمير متصل مبني في محل جر بالإضافة، جميلةٌ خبر المبتدأ الثاني مرفوع وعلامة رفعه الضمة الظاهرة، والجملة الاسمية من المبتدأ الثاني وخبره في محل رفع خبر المبتدأ الأول، والرابط الضمير.</li>
      <li><strong>الخبر شبه الجملة:</strong> <span class="ar">الْكِتَابُ فَوْقَ الطَّاوِلَةِ</span>: الكتابُ مبتدأ مرفوع وعلامة رفعه الضمة الظاهرة، فوقَ ظرف مكان منصوب وعلامة نصبه الفتحة الظاهرة وهو مضاف، الطاولةِ مضاف إليه مجرور وعلامة جره الكسرة الظاهرة، وشبه الجملة متعلق بمحذوف خبر.</li>
    </ul>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">طبّق الدرس على جملتك.</span>
    ألصق أي جملة اسمية في المحلل على الصفحة الرئيسية وشاهد الدرس مطبقًا كلمة كلمة: المبتدأ وعلامة رفعه، ونوع الخبر، والرابط إن كان الخبر جملة، خلال ثوانٍ.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="taqdim-al-khabar"
    title="تقديم الخبر والابتداء بالنكرة"
    lead="الأصل تقديم المبتدأ وتأخير الخبر، وقد ينعكس الترتيب جوازًا أو وجوبًا. فيجب تقديم الخبر إذا كان شبه جملة والمبتدأ نكرة، وإذا كان الخبر مما له الصدارة كأسماء الاستفهام، وإذا اتصل بالمبتدأ ضمير يعود على شيء في الخبر."
  >
    <p><strong>مثال معرب:</strong> <span class="ar">فِي الدَّارِ رَجُلٌ</span>: في حرف جر مبني على السكون لا محل له من الإعراب، الدارِ اسم مجرور بفي وعلامة جره الكسرة الظاهرة، والجار والمجرور متعلقان بمحذوف خبر مقدم، رجلٌ مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة.</p>
    <p>وفي هذا المثال جاز الابتداء بالنكرة لأن الخبر شبه جملة تقدم عليها. ومن مسوغات الابتداء بالنكرة أيضًا أن تكون موصوفة، مثل: <span class="ar">رَجُلٌ كَرِيمٌ زَارَنَا</span>، أو مسبوقة بنفي أو استفهام، مثل: <span class="ar">مَا أَحَدٌ عِنْدَنَا</span>، أو دالة على دعاء، مثل: <span class="ar">سَلَامٌ عَلَيْكُمْ</span>.</p>
    <p>ومن مواضع وجوب التقديم أن يكون الخبر اسم استفهام: <span class="ar">أَيْنَ الْكِتَابُ؟</span>: أين اسم استفهام مبني على الفتح في محل رفع خبر مقدم، الكتابُ مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="nawasikh"
    title="النواسخ الداخلة على الجملة الاسمية"
    lead="تدخل على الجملة الاسمية أفعال وحروف تغير حكم ركنيها فتسمى النواسخ. فكان وأخواتها ترفع المبتدأ اسمًا لها وتنصب الخبر خبرًا لها، وإنّ وأخواتها تعمل العكس: تنصب المبتدأ اسمًا لها وترفع الخبر خبرًا لها."
  >
    <p><strong>مثال على كان:</strong> <span class="ar">كَانَ الْجَوُّ صَحْوًا</span>: كان فعل ماضٍ ناقص مبني على الفتح، الجوُّ اسم كان مرفوع وعلامة رفعه الضمة الظاهرة، صحوًا خبر كان منصوب وعلامة نصبه الفتحة الظاهرة.</p>
    <p><strong>مثال على إنّ:</strong> <span class="ar">إِنَّ اللهَ غَفُورٌ رَحِيمٌ</span>: إنّ حرف توكيد ونصب مبني على الفتح لا محل له من الإعراب، اللهَ لفظ الجلالة اسم إنّ منصوب وعلامة نصبه الفتحة الظاهرة، غَفُورٌ خبر إنّ مرفوع وعلامة رفعه الضمة الظاهرة، رحيمٌ خبر ثانٍ مرفوع وعلامة رفعه الضمة الظاهرة.</p>
    <p>ولكل ناسخ معانيه وشروط عمله، وتفصيل ذلك في درسي <a href="/duroos/kana-wa-akhawatuha">كان وأخواتها</a> و<a href="/duroos/inna-wa-akhawatuha">إنّ وأخواتها</a>.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="common-mistakes"
    title="أخطاء شائعة وطريقة التدريب"
    lead="أكثر أخطاء الطلاب في الجملة الاسمية ترجع إلى ثلاثة مواضع: نصب الخبر توهمًا أنه مفعول به، ونسيان الرابط في الخبر الجملة، والخلط بين المبتدأ المؤخر والفاعل. وعلاجها كله في كثرة الإعراب على جمل حقيقية."
  >
    <ul>
      <li><strong>نصب الخبر:</strong> يقول بعض الطلاب "العلمُ نورًا" قياسًا على المفعول به، والصواب رفع الخبر دائمًا ما لم يدخل ناسخ ينصبه.</li>
      <li><strong>نسيان الرابط:</strong> إذا وقع الخبر جملة وجب أن تشتمل على رابط يعود على المبتدأ، وأشهره الضمير ظاهرًا أو مستترًا.</li>
      <li><strong>الخلط بين الأبواب:</strong> في نحو <span class="ar">فِي الصَّفِّ طَالِبٌ</span> لا فعلَ في الجملة أصلًا، فليس طالبٌ فاعلًا، بل هو مبتدأ مؤخر مرفوع.</li>
    </ul>
    <p>وقبل التدريب راجع مرجع <a href="/irab">الإعراب</a> لتضبط صيغة السطر الإعرابي الكامل، ثم خذ أي جملة من كتاب أو مقال وأعربها بنفسك، وقارن إعرابك بما يعرضه المحلل على الصفحة الرئيسية كلمة كلمة.</p>
  </ArticleSection>

