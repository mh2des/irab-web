---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import Byline from '../../components/Byline.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';
import AyatExamples from '../../components/duroos/AyatExamples.astro';

const faqs = [
  { q: 'ما الفرق بين الظرف المتصرف وغير المتصرف؟', a: 'المتصرف ما يستعمل ظرفًا وغير ظرف، فيقع مبتدأ وفاعلًا ومجرورًا، مثل يوم وساعة: "يومُ الجمعةِ مباركٌ" فيوم هنا مبتدأ لا ظرف. وغير المتصرف ما يلزم النصب على الظرفية أو الجر بمن، مثل: عند، قبل، بعد، فوق، تحت.' },
  { q: 'ما معنى أن الظرف يتضمن معنى "في"؟', a: 'شرط نصب الاسم على الظرفية أن يدل على زمان أو مكان وقوع الفعل بتقدير "في": "سافرتُ ليلًا" أي في الليل. فإن لم يتضمن معنى في لم يكن ظرفًا: "يومُ الجمعةِ مباركٌ" مبتدأ لأنك لا تقدر فيه "في".' },
  { q: 'لماذا تنصب ظروف الزمان بأنواعها وتختص ظروف المكان بالمبهم؟', a: 'لأن الأفعال كلها تقع في زمان فقبلت أسماء الزمان كلها الظرفية، مختصة كانت أو مبهمة. أما المكان فينصب منه المبهم كالجهات الست (فوق، تحت، أمام، خلف، يمين، شمال) والمقادير، ولا ينصب المختص كالمسجد والدار بل يجر بفي: صليتُ في المسجدِ.' },
  { q: 'ما إعراب "عند" و"لدن"؟', a: 'كلاهما ظرف غير متصرف. عند تنصب على الظرفية أو تجر بمن خاصة: "جلستُ عندَ الشيخِ" و"من عندِ اللهِ". ولدن مبنية غالبًا، ومنه قوله تعالى: ﴿مِنْ لَدُنْ حَكِيمٍ خَبِيرٍ﴾.' },
  { q: 'هل يكون الظرف خبرًا؟', a: 'نعم، يقع شبه الجملة الظرفي خبرًا متعلقًا بمحذوف: "الكتابُ فوقَ الطاولةِ"، فوقَ ظرف مكان منصوب متعلق بمحذوف خبر تقديره كائن أو مستقر. وكذلك يقع صفة وحالًا وصلة.' },
  { q: 'ما الفرق بين إذ وإذا الظرفيتين؟', a: 'إذ ظرف لما مضى من الزمان مبني على السكون، وما بعده جملة في محل جر بالإضافة: ﴿وَاذْكُرُوا إِذْ كُنْتُمْ قَلِيلًا﴾. وإذا ظرف لما يستقبل متضمن معنى الشرط غالبًا: ﴿إِذَا جَاءَ نَصْرُ اللَّهِ﴾.' },
];
---
<BaseLayout
  lang="ar"
  title="المفعول فيه: ظرف الزمان والمكان · إعراب"
  description="شرح المفعول فيه: ظرف الزمان وظرف المكان، شرط تضمن معنى في، المبهم والمختص، المتصرف وغير المتصرف، وتعلق الظرف، مع أمثلة قرآنية معربة إعرابًا كاملًا."
>
  <ArticleSchema slot="head" lang="ar" kind="lesson" headline="المفعول فيه" description="شرح المفعول فيه: ظرف الزمان وظرف المكان، شرط تضمن معنى في، المبهم والمختص، المتصرف وغير المتصرف، وتعلق الظرف، مع أمثلة قرآنية معربة إعرابًا كاملًا." />
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="المفعول فيه"
    summary="المفعول فيه هو الظرف: اسم منصوب يبين زمان وقوع الفعل أو مكانه متضمنًا معنى في. ظروف الزمان تنصب كلها، وظروف المكان ينصب مبهمها ويجر مختصها. هذا الدرس يعرض القسمين وشرط الظرفية والمتصرف وغير المتصرف، بأمثلة قرآنية معربة كاملة."
  />
  <Byline lang="ar" kind="lesson" />

  <ArticleSection
    lang="ar"
    id="definition"
    title="التعريف وشرط الظرفية"
    lead="الظرف اسم فضلة منصوب يدل على زمان الفعل أو مكانه على تقدير في. فإن لم يصح تقدير في خرج الاسم عن الظرفية وأعرب بحسب موقعه."
  >
    <p><span class="ar">سَافَرْتُ لَيْلًا</span></p>
    <p><strong>الإعراب:</strong> سافرتُ فعل ماضٍ مبني على السكون لاتصاله بتاء الفاعل، والتاء ضمير متصل مبني في محل رفع فاعل. ليلًا مفعول فيه ظرف زمان منصوب وعلامة نصبه الفتحة الظاهرة، متعلق بالفعل سافر. والمعنى: سافرتُ في الليل.</p>
    <p>وقارن: <span class="ar">يَوْمُ الْجُمُعَةِ مُبَارَكٌ</span>، فيومُ هنا <a href="/duroos/al-mubtada-wal-khabar">مبتدأ</a> مرفوع لا ظرف، إذ لا يصح تقدير "في"، فالحكم واقع على اليوم نفسه.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="time"
    title="ظرف الزمان"
    lead="أسماء الزمان تقبل النصب على الظرفية كلها، مختصة كانت أو مبهمة: يوم، ليلة، ساعة، صباحًا، مساءً، بكرة، أصيلًا، حينًا، أبدًا."
  >
    <p>مثال قرآني: <span class="ar">﴿وَسَبِّحُوهُ بُكْرَةً وَأَصِيلًا﴾</span></p>
    <p><strong>الإعراب:</strong> سبحوه فعل أمر مبني على حذف النون لأن مضارعه من <a href="/duroos/al-afal-al-khamsa">الأفعال الخمسة</a>، وواو الجماعة فاعل، والهاء مفعول به. بكرةً مفعول فيه ظرف زمان منصوب وعلامة نصبه الفتحة الظاهرة. وأصيلًا: الواو حرف <a href="/duroos/al-atf">عطف</a>، أصيلًا معطوف على بكرة منصوب مثله.</p>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">متى وأين وقع فعلك؟</span>
    ألصق جملة فيها ظرف في محلّل الإعراب وشاهده يميز ظرف الزمان من المكان ويحدد متعلقه، كلمة بكلمة.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="place"
    title="ظرف المكان"
    lead="ينصب من أسماء المكان المبهم: الجهات الست والمقادير وما صيغ من المصدر، أما المكان المختص فلا ينصب بل يجر بفي."
  >
    <ul>
      <li><strong>الجهات الست:</strong> <span class="ar">وَقَفَ الْحَارِسُ أَمَامَ الْبَابِ</span>، أمامَ مفعول فيه ظرف مكان منصوب وهو مضاف، والبابِ مضاف إليه مجرور، وأحكام <a href="/duroos/al-idafa">الإضافة</a> في درسها.</li>
      <li><strong>عند:</strong> <span class="ar">جَلَسْتُ عِنْدَ الشَّيْخِ</span>، عندَ ظرف مكان منصوب وهو مضاف.</li>
      <li><strong>المكان المختص يجر ولا ينصب:</strong> <span class="ar">صَلَّيْتُ فِي الْمَسْجِدِ</span>، فلا يقال "صليتُ المسجدَ"، وراجع <a href="/duroos/huruf-al-jarr">حروف الجر</a>.</li>
    </ul>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="taalluq"
    title="تعلق الظرف ووقوعه خبرًا"
    lead="الظرف شبه جملة لا يتم معناه بنفسه، فيتعلق بالفعل أو بوصف أو بمحذوف. وأكثر ما يقع شبه الجملة الظرفي خبرًا أو صفة أو حالًا."
  >
    <ul>
      <li><strong>خبر:</strong> <span class="ar">الْكِتَابُ فَوْقَ الطَّاوِلَةِ</span>، فوقَ ظرف مكان منصوب متعلق بمحذوف خبر.</li>
      <li><strong>صفة:</strong> <span class="ar">رَأَيْتُ عُصْفُورًا فَوْقَ الْغُصْنِ</span>، متعلق بمحذوف <a href="/duroos/al-naat">نعت</a>.</li>
      <li><strong>حال:</strong> <span class="ar">رَأَيْتُ الْهِلَالَ بَيْنَ السَّحَابِ</span>، متعلق بمحذوف <a href="/duroos/al-hal">حال</a>.</li>
    </ul>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="common-mistakes"
    title="أخطاء شائعة"
    lead="أشيع الأخطاء نصب المكان المختص، وإعراب كل اسم زمان ظرفًا وإن لم يتضمن معنى في، وإغفال المضاف إليه بعد الظرف."
  >
    <ul>
      <li>يقال خطأً "ذهبتُ المسجدَ" على الظرفية، والصواب <span class="ar">إِلَى الْمَسْجِدِ</span>، فالمسجد مكان مختص.</li>
      <li>في <span class="ar">يَوْمُ الْجُمُعَةِ مُبَارَكٌ</span> يخطئ من ينصب يومًا على الظرفية وهو مبتدأ مرفوع.</li>
      <li>ما بعد الظرف المضاف مضاف إليه مجرور دائمًا: <span class="ar">قَبْلَ الْفَجْرِ</span> و<span class="ar">بَعْدَ الْعَصْرِ</span>.</li>
    </ul>
    <p>وهذا ثالث المفاعيل بعد <a href="/duroos/al-maful-bih">المفعول به</a> و<a href="/duroos/al-maful-al-mutlaq">المفعول المطلق</a> و<a href="/duroos/al-maful-li-ajlih">المفعول لأجله</a>، والتطبيق الكامل في <a href="/irab">الإعراب</a>.</p>
  </ArticleSection>

  <AyatExamples slug="al-maful-fih" />

  <ArticleFaq lang="ar" items={faqs} />

  <Footer lang="ar" />
</BaseLayout>
