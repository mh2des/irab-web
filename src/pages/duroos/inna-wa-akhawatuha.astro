const faqs = [
  { q: 'لماذا سميت إن وأخواتها حروفًا ناسخة؟', a: 'لأنها نسخت حكم الجملة الاسمية، أي غيرته: كان المبتدأ مرفوعًا فنصبته وسمته اسمها، وبقي الخبر مرفوعًا وسمته خبرها. وهي حروف لا أفعال، فتبنى ولا محل لها من الإعراب، بخلاف كان وأخواتها فهي أفعال ناسخة.' },
  { q: 'ما الفرق بين إنَّ المكسورة وأنَّ المفتوحة؟', a: 'كلتاهما للتوكيد وتعملان العمل نفسه. الفرق في الموقع: المكسورة تقع حيث لا يصح تأويل الجملة بمصدر، كابتداء الكلام وبعد القول والقسم. والمفتوحة تقع حيث يصح تأويلها مع معموليها بمصدر مفرد، نحو "سرني أنك ناجح" أي نجاحُك.' },
  { q: 'ماذا يحدث إذا اتصلت ما بإن وأخواتها؟', a: 'تسمى ما الكافة لأنها تكفها عن العمل، فيعود ما بعدها مبتدأ وخبرًا مرفوعين، نحو قوله تعالى: "إنما المؤمنون إخوة". وتستثنى ليت، فيجوز فيها الإعمال والإهمال: "ليتما زيدًا حاضرٌ" و"ليتما زيدٌ حاضرٌ".' },
  { q: 'هل يجوز تقديم خبر إن على اسمها؟', a: 'لا يجوز أن يتقدم الخبر على الاسم إلا إذا كان الخبر شبه جملة، فيجوز نحو "إن في الصدقِ نجاةً"، ويجب هذا التقديم إذا كان الاسم نكرة غير مخصصة، نحو "إن في الدارِ رجلًا".' },
  { q: 'ما اللام في نحو: إن العلم لنور؟', a: 'هي اللام المزحلقة، وأصلها لام الابتداء دخلت على المبتدأ للتوكيد، فلما جاءت إن وهي للتوكيد أيضًا كرهوا الجمع بين مؤكدين في صدر الجملة، فزحلقوها إلى الخبر. وهي حرف توكيد مبني على الفتح لا محل له من الإعراب.' },
  { q: 'ما الفرق بين ليت ولعل؟', a: 'ليت للتمني، وهو طلب ما لا طمع فيه أو ما فيه عسر، نحو "ليت الشباب عائد". ولعل للترجي في المحبوب، نحو "لعل الفرج قريب"، وللإشفاق في المكروه، نحو "لعل العدو قادم". فالترجي للممكن، والتمني يكون للمستحيل والبعيد.' },
];
---
<BaseLayout
  lang="ar"
  title="إن وأخواتها: عملها ومعانيها وكسر همزتها · إعراب"
  description="شرح إن وأخواتها: عملها في نصب الاسم ورفع الخبر، معاني كل حرف منها، مواضع كسر همزة إن ومواضع فتحها، وما الكافة، مع أمثلة معربة إعرابًا كاملًا."
>
  <ArticleSchema slot="head" lang="ar" kind="lesson" headline="إن وأخواتها" description="شرح إن وأخواتها: عملها في نصب الاسم ورفع الخبر، معاني كل حرف منها، مواضع كسر همزة إن ومواضع فتحها، وما الكافة، مع أمثلة معربة إعرابًا كاملًا." />
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="إن وأخواتها"
    summary="إن وأخواتها حروف ناسخة تدخل على الجملة الاسمية فتنصب المبتدأ ويسمى اسمها، وترفع الخبر ويسمى خبرها، عكس عمل كان تمامًا. هذا الدرس يشرح عملها ومعاني كل حرف منها، ثم يفصل القاعدة التي طالما حيرت الطلاب: متى تكسر همزة إن ومتى تفتح، مع أمثلة معربة إعرابًا كاملًا."
  />
  <Byline lang="ar" kind="lesson" />

  <ArticleSection
    lang="ar"
    id="definition"
    title="ما إن وأخواتها وما عملها؟"
    lead="إن وأخواتها ستة أحرف ناسخة: إنَّ وأنَّ وكأنَّ ولكنَّ وليتَ ولعلَّ. تدخل على المبتدأ والخبر فتنصب الأول ويسمى اسمها، ويبقى الثاني مرفوعًا ويسمى خبرها. وهي حروف مبنية لا محل لها من الإعراب."
  >
    <p>الأصل جملة اسمية كما في درس <a href="/duroos/al-mubtada-wal-khabar">المبتدأ والخبر</a>: <span class="ar">الْعِلْمُ نُورٌ</span>. فإذا دخلت إن قلت: <span class="ar">إِنَّ الْعِلْمَ نُورٌ</span>، فانقلب المبتدأ منصوبًا وبقي الخبر مرفوعًا.</p>
    <p>وإعراب المثال إعرابًا كاملًا: <span class="ar">إِنَّ</span>: حرف توكيد ونصب مبني على الفتح لا محل له من الإعراب، ينصب الاسم ويرفع الخبر. <span class="ar">الْعِلْمَ</span>: اسم إن منصوب وعلامة نصبه الفتحة الظاهرة على آخره. <span class="ar">نُورٌ</span>: خبر إن مرفوع وعلامة رفعه الضمة الظاهرة على آخره.</p>
    <p>ولاحظ أن عملها عكس عمل <a href="/duroos/kana-wa-akhawatuha">كان وأخواتها</a>: تلك ترفع الاسم وتنصب الخبر، وهذه تنصب الاسم وترفع الخبر. والجامع بينهما أنهما نواسخ تدخل على <a href="/duroos/al-jumla-al-ismiyya">الجملة الاسمية</a> فتغير حكمها.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="sisters-meanings"
    title="معاني الأحرف الستة"
    lead="يجمع هذه الأحرف عمل واحد ويفرقها المعنى. اثنان للتوكيد، وواحد للتشبيه، وواحد للاستدراك، وواحد للتمني، وواحد للترجي والإشفاق. ومعرفة المعنى شرط لحسن الاستعمال قبل حسن الإعراب."
  >
    <ul>
      <li><strong><span class="ar">إِنَّ</span> و<span class="ar">أَنَّ</span></strong>: للتوكيد، أي تقوية نسبة الخبر إلى الاسم، نحو <span class="ar">إِنَّ اللَّهَ غَفُورٌ</span>.</li>
      <li><strong><span class="ar">كَأَنَّ</span></strong>: للتشبيه، نحو <span class="ar">كَأَنَّ الْجُنْدِيَّ أَسَدٌ</span>.</li>
      <li><strong><span class="ar">لَكِنَّ</span></strong>: للاستدراك، وهو تعقيب الكلام برفع ما يتوهم منه، نحو <span class="ar">الطَّرِيقُ بَعِيدٌ لَكِنَّ الْعَزْمَ صَادِقٌ</span>.</li>
      <li><strong><span class="ar">لَيْتَ</span></strong>: للتمني، نحو <span class="ar">لَيْتَ الشَّبَابَ عَائِدٌ</span>.</li>
      <li><strong><span class="ar">لَعَلَّ</span></strong>: للترجي في المحبوب والإشفاق في المكروه، نحو <span class="ar">لَعَلَّ الْفَرَجَ قَرِيبٌ</span>.</li>
    </ul>
    <p>ومثال معرب من هذه الأخوات: <span class="ar">كَأَنَّ الْجُنْدِيَّ أَسَدٌ</span>: <span class="ar">كَأَنَّ</span>: حرف تشبيه ونصب مبني على الفتح لا محل له من الإعراب. <span class="ar">الْجُنْدِيَّ</span>: اسم كأن منصوب وعلامة نصبه الفتحة الظاهرة. <span class="ar">أَسَدٌ</span>: خبر كأن مرفوع وعلامة رفعه الضمة الظاهرة.</p>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">طبق القاعدة على جملتك.</span>
    ألصق أي جملة تبدأ بإن أو إحدى أخواتها في المحلل على الصفحة الرئيسية، وشاهد الدرس يطبق كلمة كلمة: الاسم المنصوب، والخبر المرفوع، وسبب كل علامة.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="kasr-hamza"
    title="مواضع كسر همزة إن"
    lead="تكسر همزة إن وجوبًا في كل موضع لا يصح فيه تأويل إن مع معموليها بمصدر. وأشهر هذه المواضع ستة يحفظها الطلاب عن ظهر قلب."
  >
    <ul>
      <li><strong>في ابتداء الكلام</strong>: <span class="ar">إِنَّ الصِّدْقَ مَنْجَاةٌ</span>.</li>
      <li><strong>بعد القول</strong>: <span class="ar">قَالَ إِنِّي عَبْدُ اللَّهِ</span>.</li>
      <li><strong>بعد القسم</strong>: <span class="ar">وَاللَّهِ إِنَّ الْحَقَّ مُنْتَصِرٌ</span>.</li>
      <li><strong>في صدر جملة الصلة</strong>: <span class="ar">جَاءَ الَّذِي إِنَّهُ فَاضِلٌ</span>.</li>
      <li><strong>بعد أَلَا الاستفتاحية</strong>: <span class="ar">أَلَا إِنَّ نَصْرَ اللَّهِ قَرِيبٌ</span>.</li>
      <li><strong>في صدر جملة الحال</strong>: <span class="ar">زُرْتُهُ وَإِنِّي ذُو أَمَلٍ</span>.</li>
    </ul>
    <p>والضابط الجامع: إذا لم يمكن أن تحل محل إن ومعموليها كلمة مفردة مؤولة بمصدر، فالهمزة مكسورة. فجملة الصلة وجملة الحال لا تؤولان بمفرد، ولذلك كسرت الهمزة فيهما.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="fath-hamza"
    title="مواضع فتح همزة أن"
    lead="تفتح الهمزة وجوبًا حيث يصح تأويل أن مع اسمها وخبرها بمصدر مفرد يأخذ موقعًا إعرابيًّا في الجملة: فاعلًا أو مفعولًا به أو مجرورًا بحرف الجر."
  >
    <ul>
      <li><strong>في محل رفع فاعل</strong>: <span class="ar">سَرَّنِي أَنَّكَ نَاجِحٌ</span>، والتقدير: سرني نجاحُك.</li>
      <li><strong>في محل نصب مفعول به</strong>: <span class="ar">عَرَفْتُ أَنَّ الصِّدْقَ مَنْجَاةٌ</span>، والتقدير: عرفت نجاةَ الصدق.</li>
      <li><strong>في محل جر بحرف الجر</strong>: <span class="ar">عَجِبْتُ مِنْ أَنَّكَ مُسَافِرٌ</span>، والتقدير: من سفرِك، وراجع عمل الجار في درس <a href="/duroos/huruf-al-jarr">حروف الجر</a>.</li>
    </ul>
    <p>ومثال معرب كامل: <span class="ar">سَرَّنِي أَنَّكَ نَاجِحٌ</span>: <span class="ar">سَرَّ</span>: فعل ماضٍ مبني على الفتح، والنون للوقاية، والياء ضمير متصل مبني في محل نصب مفعول به. <span class="ar">أَنَّ</span>: حرف توكيد ونصب مبني على الفتح لا محل له من الإعراب. والكاف: ضمير متصل مبني في محل نصب اسم أن. <span class="ar">نَاجِحٌ</span>: خبر أن مرفوع وعلامة رفعه الضمة الظاهرة. والمصدر المؤول من أن ومعموليها في محل رفع فاعل.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="worked-examples"
    title="أمثلة معربة إعرابًا كاملًا"
    lead="هذه نماذج جاهزة بالصياغة الكلاسيكية المعتمدة في كتب النحو، تصلح مراجعة سريعة قبل الامتحان وقالبًا تحاكيه في إعرابك."
  >
    <p><strong>المثال الأول</strong>: <span class="ar">لَيْتَ الشَّبَابَ عَائِدٌ</span>: <span class="ar">لَيْتَ</span>: حرف تمنٍّ ونصب مبني على الفتح لا محل له من الإعراب. <span class="ar">الشَّبَابَ</span>: اسم ليت منصوب وعلامة نصبه الفتحة الظاهرة. <span class="ar">عَائِدٌ</span>: خبر ليت مرفوع وعلامة رفعه الضمة الظاهرة.</p>
    <p><strong>المثال الثاني</strong>: <span class="ar">لَعَلَّ الْفَرَجَ قَرِيبٌ</span>: <span class="ar">لَعَلَّ</span>: حرف ترجٍّ ونصب مبني على الفتح لا محل له من الإعراب. <span class="ar">الْفَرَجَ</span>: اسم لعل منصوب وعلامة نصبه الفتحة الظاهرة. <span class="ar">قَرِيبٌ</span>: خبر لعل مرفوع وعلامة رفعه الضمة الظاهرة.</p>
    <p><strong>المثال الثالث</strong>: <span class="ar">إِنَّ الْمُؤْمِنَ يَصْدُقُ فِي قَوْلِهِ</span>: <span class="ar">إِنَّ</span>: حرف توكيد ونصب مبني على الفتح. <span class="ar">الْمُؤْمِنَ</span>: اسم إن منصوب وعلامة نصبه الفتحة الظاهرة. <span class="ar">يَصْدُقُ</span>: فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة، والفاعل ضمير مستتر تقديره هو. <span class="ar">فِي</span>: حرف جر مبني على السكون. <span class="ar">قَوْلِهِ</span>: اسم مجرور وعلامة جره الكسرة الظاهرة، وهو مضاف، والهاء ضمير متصل مبني في محل جر مضاف إليه. والجملة الفعلية في محل رفع خبر إن.</p>
    <p><strong>المثال الرابع</strong>: <span class="ar">إِنَّ فِي الدَّارِ رَجُلًا</span>: <span class="ar">إِنَّ</span>: حرف توكيد ونصب مبني على الفتح. <span class="ar">فِي الدَّارِ</span>: جار ومجرور، وشبه الجملة في محل رفع خبر إن مقدم. <span class="ar">رَجُلًا</span>: اسم إن مؤخر منصوب وعلامة نصبه الفتحة الظاهرة. وقد وجب تقديم الخبر هنا لأن الاسم نكرة والخبر شبه جملة.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="ma-kaffa"
    title="ما الكافة واللام المزحلقة"
    lead="مسألتان تكملان الدرس: ما الكافة التي تبطل عمل هذه الأحرف، واللام المزحلقة التي تلحق خبر إن للتوكيد. وكلتاهما كثيرة الورود في القرآن والشعر."
  >
    <p><strong>ما الكافة</strong>: إذا اتصلت ما الزائدة بإن وأخواتها كفتها عن العمل، فيعود ما بعدها جملة اسمية مرفوعة الركنين، نحو قوله تعالى: <span class="ar">إِنَّمَا الْمُؤْمِنُونَ إِخْوَةٌ</span>: <span class="ar">إِنَّمَا</span>: إن حرف توكيد مكفوف عن العمل، وما كافة. <span class="ar">الْمُؤْمِنُونَ</span>: مبتدأ مرفوع وعلامة رفعه الواو لأنه جمع مذكر سالم. <span class="ar">إِخْوَةٌ</span>: خبر مرفوع وعلامة رفعه الضمة الظاهرة. وتستثنى ليت فيجوز فيها الإعمال والإهمال.</p>
    <p><strong>اللام المزحلقة</strong>: نحو <span class="ar">إِنَّ الْعِلْمَ لَنُورٌ</span>: اللام لام مزحلقة للتوكيد، حرف مبني على الفتح لا محل له من الإعراب، و<span class="ar">نُورٌ</span>: خبر إن مرفوع وعلامة رفعه الضمة الظاهرة.</p>
    <p>وبهذا يكتمل عندك باب النواسخ الحرفية. ومن أراد أن يرى كيف يلتقي هذا الباب بغيره من أبواب <a href="/nahw">النحو</a> في نص واحد، فليتدرب على <a href="/irab">الإعراب</a> الكامل للجمل الطويلة، فهو الميزان الحق للفهم.</p>
  </ArticleSection>

