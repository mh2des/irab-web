---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import Byline from '../../components/Byline.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';
import AyatExamples from '../../components/duroos/AyatExamples.astro';

const faqs = [
  { q: 'ما الفرق بين التوكيد اللفظي والمعنوي؟', a: 'اللفظي إعادة اللفظ نفسه أو مرادفه: جاء جاء الحقُّ. والمعنوي يكون بألفاظ محفوظة: النفس والعين لرفع المجاز عن الذات، وكل وجميع وعامة للشمول، وكلا وكلتا للمثنى، بشرط اتصالها بضمير يعود على المؤكد.' },
  { q: 'ما شرط التوكيد بالنفس والعين؟', a: 'اتصالهما بضمير يطابق المؤكد: جاء الأميرُ نفسُه، وجاءت هندُ نفسُها. وإذا أكد بهما المثنى أو الجمع جمعتا على أفعُل: جاء الأميران أنفسُهما، وجاء الأمراء أنفسُهم.' },
  { q: 'كيف تعرب كلا وكلتا في التوكيد؟', a: 'إذا أضيفتا إلى الضمير أعربتا إعراب المثنى: بالألف رفعًا وبالياء نصبًا وجرًّا: جاء الطالبان كلاهما، ورأيت الطالبين كليهما. وإذا أضيفتا إلى الاسم الظاهر أعربتا بحركات مقدرة على الألف: جاء كلا الطالبين.' },
  { q: 'هل يفيد تكرار الضمير توكيدًا؟', a: 'نعم، يؤكد الضمير المتصل بضمير منفصل: قمتُ أنا، وأكرمتُك أنتَ. فالضمير المنفصل توكيد لفظي... بل هو عند جمهور النحاة توكيد للضمير المتصل يتبعه في محله.' },
  { q: 'ما فائدة قوله كلهم أجمعون معًا؟', a: 'كلهم تفيد الشمول، وأجمعون تفيد اجتماعهم على الفعل في وقت واحد عند بعض النحاة، أو هي توكيد بعد توكيد لتقوية الشمول. ولهذا قيل في ﴿فسجد الملائكة كلهم أجمعون﴾: لا أبلغ من هذا التوكيد.' },
  { q: 'متى يكون تكرار اللفظ توكيدًا لفظيًّا ومتى لا يكون؟', a: 'يكون توكيدًا إذا قصد به التقوية والتقرير: جاء جاء الحق. فإن أفاد الثاني معنى جديدًا كالتفصيل أو البدل لم يكن توكيدًا، والسياق هو الحكم.' },
];
---
<BaseLayout
  lang="ar"
  title="التوكيد: اللفظي والمعنوي وألفاظه · إعراب آب"
  description="شرح التوكيد وقسميه: اللفظي بإعادة اللفظ، والمعنوي بالنفس والعين وكل وجميع وكلا وكلتا، وشرط الضمير الرابط، وإعراب التوكيد تابعًا، مع أمثلة قرآنية معربة."
>
  <ArticleSchema slot="head" lang="ar" kind="lesson" headline="التوكيد" description="شرح التوكيد وقسميه: اللفظي بإعادة اللفظ، والمعنوي بالنفس والعين وكل وجميع وكلا وكلتا، وشرط الضمير الرابط، وإعراب التوكيد تابعًا، مع أمثلة قرآنية معربة." />
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="التوكيد"
    summary="التوكيد تابع يذكر لتقرير المتبوع ورفع احتمال السهو أو المجاز عنه، وهو رابع التوابع مع النعت والعطف والبدل. قسمان: لفظي بإعادة اللفظ، ومعنوي بألفاظ محفوظة أشهرها النفس والعين وكل وجميع وكلا وكلتا. هذا الدرس يعرض القسمين وشروطهما بأمثلة قرآنية معربة كاملة."
  />
  <Byline lang="ar" kind="lesson" />

  <ArticleSection
    lang="ar"
    id="definition"
    title="التعريف والإعراب"
    lead="التوكيد تابع يتبع المؤكد في إعرابه رفعًا ونصبًا وجرًّا، ويذكر لدفع توهم السهو عن المتكلم أو المجاز في الكلام."
  >
    <p><span class="ar">جَاءَ الْأَمِيرُ نَفْسُهُ</span></p>
    <p><strong>الإعراب:</strong> جاء فعل ماضٍ مبني على الفتح. الأميرُ <a href="/duroos/al-fail">فاعل</a> مرفوع وعلامة رفعه الضمة الظاهرة. نفسُه توكيد معنوي مرفوع وعلامة رفعه الضمة الظاهرة وهو مضاف، والهاء ضمير متصل مبني في محل جر مضاف إليه.</p>
    <p>ففائدة "نفسه" دفع احتمال أن يكون الجائي رسولَه أو خبرَه، فالمجيء للأمير ذاته.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="lafzi"
    title="التوكيد اللفظي"
    lead="اللفظي إعادة اللفظ الأول بعينه أو بمرادفه، ويجري في الاسم والفعل والحرف والجملة."
  >
    <ul>
      <li><strong>توكيد الاسم:</strong> <span class="ar">الصِّدْقُ الصِّدْقُ مَنْجَاةٌ</span>، الصدقُ الثانية توكيد لفظي مرفوع.</li>
      <li><strong>توكيد الفعل:</strong> <span class="ar">جَاءَ جَاءَ الْحَقُّ</span>.</li>
      <li><strong>توكيد الجملة:</strong> <span class="ar">﴿فَإِنَّ مَعَ الْعُسْرِ يُسْرًا * إِنَّ مَعَ الْعُسْرِ يُسْرًا﴾</span>، فالجملة الثانية توكيد لفظي للأولى لا محل لها من الإعراب تبعًا للأولى.</li>
      <li><strong>توكيد الضمير المتصل بالمنفصل:</strong> <span class="ar">قُمْتُ أَنَا</span>، أنا توكيد للتاء في محل رفع.</li>
    </ul>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">أكِّد ولا تكرر عبثًا.</span>
    ألصق جملة فيها توكيد في محلّل الإعراب وشاهده يميز التوكيد اللفظي من المعنوي ويعين المؤكد وعلامة التبعية.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="manawi"
    title="التوكيد المعنوي وألفاظه"
    lead="ألفاظ المعنوي محفوظة: النفس والعين لرفع المجاز، وكل وجميع وعامة للشمول، وكلا وكلتا للمثنى، وشرطها جميعًا ضمير يعود على المؤكد ويطابقه."
  >
    <p>المثال الجامع في التنزيل: <span class="ar">﴿فَسَجَدَ الْمَلَائِكَةُ كُلُّهُمْ أَجْمَعُونَ﴾</span></p>
    <p><strong>الإعراب:</strong> سجدَ فعل ماضٍ مبني على الفتح. الملائكةُ فاعل مرفوع وعلامة رفعه الضمة الظاهرة. كلُّهم توكيد معنوي مرفوع وعلامة رفعه الضمة وهو مضاف، والهاء ضمير متصل مبني في محل جر مضاف إليه، والميم للجمع. أجمعون توكيد ثانٍ مرفوع وعلامة رفعه الواو لأنه ملحق بجمع المذكر السالم.</p>
    <p>ومن كلا وكلتا: <span class="ar">نَجَحَ الطَّالِبَانِ كِلَاهُمَا</span>: كلاهما توكيد معنوي مرفوع وعلامة رفعه الألف لأنه ملحق بالمثنى وهو مضاف، والضمير مضاف إليه. وعلامات المثنى في <a href="/duroos/alamat-al-irab">علامات الإعراب</a>.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="common-mistakes"
    title="أخطاء شائعة"
    lead="أشيع أخطاء الباب كسر التبعية، وإسقاط الضمير الرابط من ألفاظ التوكيد المعنوي، والخلط بين التوكيد والنعت."
  >
    <ul>
      <li>يقال خطأً "رأيتُ الأميرَ نفسُه" بالرفع، والصواب <span class="ar">نَفْسَهُ</span> بالنصب تبعًا للمؤكد.</li>
      <li>لا توكيد بلا ضمير: "جاء الطلابُ كلُّ" خطأ، والصواب <span class="ar">كُلُّهُمْ</span>.</li>
      <li>"نفس وعين" بلا ضمير مطابق ليستا توكيدًا: في <span class="ar">رَأَيْتُ نَفْسَ الرَّجُلِ</span> نفسَ مفعول به مضاف لا توكيد.</li>
    </ul>
    <p>وبهذا تكتمل التوابع الأربعة: <a href="/duroos/al-naat">النعت</a> و<a href="/duroos/al-atf">العطف</a> و<a href="/duroos/al-badal">البدل</a> والتوكيد، وتطبيقها كله في <a href="/irab">الإعراب</a>.</p>
  </ArticleSection>

  <AyatExamples slug="al-tawkid" />

  <ArticleFaq lang="ar" items={faqs} />

  <Footer lang="ar" />
</BaseLayout>
