---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import Byline from '../../components/Byline.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';
import AyatExamples from '../../components/duroos/AyatExamples.astro';

const faqs = [
  { q: 'ما أركان أسلوب الشرط؟', a: 'ثلاثة: أداة الشرط، وجملة الشرط (فعل الشرط)، وجملة الجواب (الجزاء). المعنى: تعليق حصول الجواب على حصول الشرط: إن تذاكرْ تنجحْ.' },
  { q: 'ما الفرق بين أدوات الشرط الجازمة وغير الجازمة؟', a: 'الجازمة تجزم فعلين مضارعين وأشهرها: إن، من، ما، مهما، متى، أين، حيثما. وغير الجازمة لا عمل لها في الفعل وأشهرها: إذا، لو، لولا، كلما، أما. فالفرق عمل إعرابي لا معنوي فقط.' },
  { q: 'متى يجب اقتران جواب الشرط بالفاء؟', a: 'إذا لم يصلح الجواب أن يقع فعل شرط، وجمعها النحاة في سبعة: الجملة الاسمية، والطلبية، والفعل الجامد، والمقرون بما أو لن أو قد أو السين وسوف. ويجمعها قولهم: اسمية طلبية وبجامد وبما ولن وقد وبالتسويف.' },
  { q: 'كيف تعرب الجملة بعد إذا؟', a: 'إذا ظرف لما يستقبل من الزمان خافض لشرطه منصوب بجوابه، والجملة الفعلية بعدها في محل جر بالإضافة. وجواب إذا لا محل له من الإعراب.' },
  { q: 'ما معنى أن لو حرف امتناع لامتناع؟', a: 'أن جوابها ممتنع لامتناع شرطها: "لو ذاكرتَ لنجحتَ" يعني أن النجاح امتنع لامتناع المذاكرة. وتدخل اللام على جوابها المثبت غالبًا وتسمى اللام الواقعة في جواب لو.' },
  { q: 'هل يحذف فعل الشرط أو جوابه؟', a: 'نعم. يحذف الجواب إذا دل عليه ما قبله: أنت ناجحٌ إن اجتهدتَ، أي إن اجتهدت فأنت ناجح. ويحذف فعل الشرط بعد إن المدغمة بلا: وإلا فافعل كذا، أي وإن لا تفعلْ ذلك.' },
];
---
<BaseLayout
  lang="ar"
  title="أسلوب الشرط: أدواته وجوابه واقترانه بالفاء · إعراب"
  description="شرح أسلوب الشرط: أركانه، الأدوات الجازمة وغير الجازمة، إعراب إذا ولو ولولا، مواضع اقتران الجواب بالفاء السبعة، وحذف الشرط والجواب، بأمثلة قرآنية معربة."
>
  <ArticleSchema slot="head" lang="ar" kind="lesson" headline="أسلوب الشرط" description="شرح أسلوب الشرط: أركانه، الأدوات الجازمة وغير الجازمة، إعراب إذا ولو ولولا، مواضع اقتران الجواب بالفاء السبعة، وحذف الشرط والجواب، بأمثلة قرآنية معربة." />
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="أسلوب الشرط"
    summary="الشرط تعليق أمر على أمر: لا يقع الجواب حتى يقع الشرط. أدواته قسمان: جازمة تعمل في المضارع، وغير جازمة كإذا ولو ولولا. وأدق مسائله اقتران الجواب بالفاء ومحل جملة الجواب. هذا الدرس يجمع الباب كله بأمثلة قرآنية معربة كاملة."
  />
  <Byline lang="ar" kind="lesson" />

  <ArticleSection
    lang="ar"
    id="structure"
    title="أركان الأسلوب"
    lead="أسلوب الشرط أداة وجملتان: جملة الشرط وجملة الجواب. والأداة تربط الجملتين رابطة تعليق: الأولى سبب والثانية مسبب."
  >
    <p><span class="ar">إِنْ تَتَّقِ اللَّهَ يَجْعَلْ لَكَ مَخْرَجًا</span></p>
    <p><strong>الإعراب:</strong> إن حرف شرط جازم مبني على السكون لا محل له من الإعراب. تتقِ فعل مضارع مجزوم لأنه فعل الشرط وعلامة جزمه حذف حرف العلة، والفاعل ضمير مستتر وجوبًا تقديره أنت، ولفظ الجلالة مفعول به منصوب. يجعلْ فعل مضارع مجزوم لأنه جواب الشرط وعلامة جزمه السكون. ومخرجًا مفعول به منصوب.</p>
    <p>وعلامات الجزم الثلاث وأدواته الجازمة كلها مفصلة في درس <a href="/duroos/jazm-al-mudari">جزم المضارع</a>، فهذا الدرس يبني عليه.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="non-jazima"
    title="الأدوات غير الجازمة: إذا ولو وكلما"
    lead="إذا ظرف للمستقبل متضمن معنى الشرط والجملة بعده في محل جر بالإضافة، ولو حرف امتناع لامتناع، وكلما ظرف يفيد التكرار، ولا عمل لها جميعًا في الفعل."
  >
    <p><strong>إذا:</strong> <span class="ar">﴿إِذَا جَاءَ نَصْرُ اللَّهِ وَالْفَتْحُ﴾</span>: إذا ظرف لما يستقبل من الزمان متضمن معنى الشرط مبني على السكون. جاء فعل ماضٍ مبني على الفتح، ونصرُ <a href="/duroos/al-fail">فاعل</a> مرفوع وهو مضاف ولفظ الجلالة مضاف إليه مجرور، والجملة الفعلية في محل جر بإضافة إذا إليها.</p>
    <p><strong>لو:</strong> <span class="ar">﴿وَلَوْ شَاءَ اللَّهُ لَذَهَبَ بِسَمْعِهِمْ﴾</span>: لو حرف امتناع لامتناع مبني على السكون، واللام في لذهبَ واقعة في جواب لو، وجملة الجواب لا محل لها من الإعراب.</p>
    <p><strong>لولا:</strong> حرف امتناع لوجود، وما بعدها مبتدأ خبره محذوف وجوبًا، وتفصيله في درس <a href="/duroos/al-mubtada-wal-khabar">المبتدأ والخبر</a>.</p>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">علّق شرطًا وجرّبه.</span>
    ألصق جملة شرطية في محلّل الإعراب وشاهده يميز الأداة الجازمة من غير الجازمة ويعرب الشرط والجواب، كلمة بكلمة.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="fa-jawab"
    title="اقتران الجواب بالفاء"
    lead="إذا لم يصلح الجواب لمباشرة الأداة وجب ربطه بالفاء، والجملة بعد الفاء في محل جزم جواب الشرط إن كانت الأداة جازمة."
  >
    <p><strong>المثال الجامع:</strong> <span class="ar">﴿وَمَنْ يَتَوَكَّلْ عَلَى اللَّهِ فَهُوَ حَسْبُهُ﴾</span></p>
    <p><strong>الإعراب:</strong> من اسم شرط جازم مبني على السكون في محل رفع مبتدأ. يتوكلْ فعل الشرط مجزوم وعلامة جزمه السكون. الفاء واقعة في جواب الشرط لأن الجواب <a href="/duroos/al-jumla-al-ismiyya">جملة اسمية</a>. هو ضمير منفصل مبني في محل رفع مبتدأ، وحسبُه خبر مرفوع والهاء مضاف إليه، والجملة الاسمية في محل جزم جواب الشرط.</p>
    <ul>
      <li><strong>الجملة الطلبية:</strong> <span class="ar">إِنْ لَقِيتَ صَدِيقَكَ فَسَلِّمْ عَلَيْهِ</span>.</li>
      <li><strong>المقرون بلن:</strong> <span class="ar">إِنْ تَكْسَلْ فَلَنْ تَنْجَحَ</span>، وعمل لن في <a href="/duroos/nasb-al-mudari">نصب المضارع</a>.</li>
      <li><strong>الفعل الجامد:</strong> <span class="ar">إِنْ زُرْتَنَا فَنِعْمَ الزَّائِرُ أَنْتَ</span>.</li>
    </ul>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="mahall"
    title="محل جملتي الشرط والجواب"
    lead="جملة الشرط لا محل لها من الإعراب، وكذلك جملة الجواب إلا إذا كانت الأداة جازمة والجواب مقترنًا بالفاء أو إذا الفجائية فتكون في محل جزم."
  >
    <ul>
      <li><span class="ar">مَنْ يَزْرَعْ يَحْصُدْ</span>: جملتا الشرط والجواب في محل رفع خبر المبتدأ "من" على المذهب المختار.</li>
      <li><span class="ar">إِنْ تَجْتَهِدْ فَالنَّجَاحُ حَلِيفُكَ</span>: الجملة الاسمية بعد الفاء في محل جزم جواب الشرط.</li>
      <li>جواب إذا ولو ولولا لا محل له من الإعراب دائمًا لأن أدواتها غير جازمة.</li>
    </ul>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="common-mistakes"
    title="أخطاء شائعة"
    lead="أشيع الأخطاء رفع المضارع بعد الأداة الجازمة، وإغفال الفاء الواجبة، وجزم الفعل بعد إذا."
  >
    <ul>
      <li>يقال خطأً "إن تدرسُ تنجحُ" بالرفع، والصواب <span class="ar">إِنْ تَدْرُسْ تَنْجَحْ</span> بجزم الفعلين.</li>
      <li>يقال خطأً "من اجتهد هو الفائز" بلا فاء، والصواب <span class="ar">مَنِ اجْتَهَدَ فَهُوَ الْفَائِزُ</span> لأن الجواب جملة اسمية.</li>
      <li>إذا لا تجزم: يقال <span class="ar">إِذَا جَاءَ الشِّتَاءُ لَبِسْنَا الصُّوفَ</span> بالفعل الماضي أو المضارع المرفوع، لا المجزوم.</li>
    </ul>
    <p>وتمام الباب في <a href="/duroos/jazm-al-mudari">جزم المضارع</a>، والإطار النظري في <a href="/nahw">ما هو النحو</a>، والتطبيق في <a href="/irab">الإعراب</a>.</p>
  </ArticleSection>

  <AyatExamples slug="uslub-al-shart" />

  <ArticleFaq lang="ar" items={faqs} />

  <Footer lang="ar" />
</BaseLayout>
