---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import Byline from '../../components/Byline.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';
import AyatExamples from '../../components/duroos/AyatExamples.astro';

const faqs = [
  { q: 'لماذا يُحذف الفاعل أصلًا؟', a: 'لأغراض بلاغية أو عملية: الجهل به نحو "سُرِقَ الْمَتَاعُ"، أو العلم به فلا حاجة لذكره نحو ﴿خُلِقَ الْإِنسَانُ ضَعِيفًا﴾، أو الخوف منه أو عليه، أو الرغبة في الإيجاز، أو تعظيمه بصون اسمه عن الاقتران بالفعل.' },
  { q: 'ما الفرق بين نائب الفاعل والفاعل؟', a: 'كلاهما مرفوع وعمدة في الجملة، لكن الفاعل هو من قام بالفعل والفعل معه مبني للمعلوم، ونائب الفاعل هو المفعول به في الأصل ارتفع بعد حذف الفاعل وبناء الفعل للمجهول. المعنى يفترق: "كَتَبَ الطالبُ" الطالب كاتب، و"كُتِبَ الدرسُ" الدرس مكتوب.' },
  { q: 'كيف يُبنى الفعل الماضي للمجهول؟', a: 'يُضم أوله ويُكسر ما قبل آخره: كَتَبَ صارت كُتِبَ، وقَرَأَ صارت قُرِئَ. وإذا كان معتل الوسط مثل قَالَ وبَاعَ قيل: قِيلَ وبِيعَ بكسر الأول وقلب الألف ياء.' },
  { q: 'كيف يُبنى الفعل المضارع للمجهول؟', a: 'يُضم أوله ويُفتح ما قبل آخره: يَكْتُبُ صارت يُكْتَبُ، ويَقُولُ صارت يُقَالُ. نحو: يُقْرَأُ الْقُرْآنُ في الْمَسْجِدِ، القرآنُ نائب فاعل مرفوع.' },
  { q: 'هل يُبنى الفعل اللازم للمجهول؟', a: 'نعم إذا وُجد ما ينوب عن الفاعل غير المفعول به: الجار والمجرور نحو "جُلِسَ عَلَى الْكُرْسِيِّ"، أو الظرف المتصرف المختص نحو "صِيمَ رَمَضَانُ"، أو المصدر المتصرف المختص نحو "سِيرَ سَيْرٌ طَوِيلٌ".' },
  { q: 'هل يتغير الفعل مع نائب الفاعل المؤنث؟', a: 'نعم، تلحقه تاء التأنيث كما تلحقه مع الفاعل المؤنث: "كُتِبَتِ الرِّسَالَةُ" و"تُقْرَأُ الصَّحِيفَةُ"، الرسالةُ والصحيفةُ نائب فاعل مرفوع في الجملتين.' },
];
---
<BaseLayout
  lang="ar"
  hasEn
  title="نائب الفاعل: البناء للمجهول وأحكامه بالأمثلة · إعراب آب"
  description="شرح نائب الفاعل: بناء الماضي والمضارع للمجهول، ما ينوب عن الفاعل المحذوف، علامات رفع النائب، والفرق بينه وبين المفعول به، مع أمثلة معربة إعرابًا كاملًا."
>
  <ArticleSchema slot="head" lang="ar" kind="lesson" headline="نائب الفاعل" description="شرح نائب الفاعل: بناء الماضي والمضارع للمجهول، ما ينوب عن الفاعل المحذوف، علامات رفع النائب، والفرق بينه وبين المفعول به، مع أمثلة معربة إعرابًا كاملًا." />
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="نائب الفاعل"
    summary="إذا حُذف الفاعل من الجملة وبُني الفعل للمجهول، ناب عن الفاعل غيرُه وأخذ أحكامه كلها: الرفع، والعمدة، وتأنيث الفعل. هذا الدرس يشرح كيف يُبنى الفعل للمجهول، وما الذي ينوب عن الفاعل، وكيف يُعرب النائب، مع التنبيه على الفرق الجوهري بينه وبين المفعول به."
  />
  <Byline lang="ar" kind="lesson" />

  <ArticleSection
    lang="ar"
    id="definition"
    title="التعريف"
    lead="نائب الفاعل اسم مرفوع يحل محل الفاعل المحذوف بعد بناء الفعل للمجهول، ويأخذ أحكام الفاعل كلها. وأصله في الغالب المفعول به."
  >
    <p>قارن الجملتين: <span class="ar">فَتَحَ الطَّالِبُ الْبَابَ</span> ثم <span class="ar">فُتِحَ الْبَابُ</span>.</p>
    <p><strong>إعراب الأولى:</strong> فتحَ فعل ماضٍ مبني على الفتح، الطالبُ <a href="/duroos/al-fail">فاعل</a> مرفوع وعلامة رفعه الضمة الظاهرة، البابَ مفعول به منصوب وعلامة نصبه الفتحة الظاهرة.</p>
    <p><strong>إعراب الثانية:</strong> فُتِحَ فعل ماضٍ مبني للمجهول مبني على الفتح، البابُ نائب فاعل مرفوع وعلامة رفعه الضمة الظاهرة.</p>
    <p>فالمفعول به في الجملة الأولى هو نفسه نائب الفاعل في الثانية: حُذف الفاعل، فارتقى <a href="/duroos/al-maful-bih">المفعول به</a> إلى مكانه وأخذ رفعه.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="building"
    title="بناء الفعل للمجهول"
    lead="لبناء الفعل للمجهول صورتان قياسيتان: الماضي بضم الأول وكسر ما قبل الآخر، والمضارع بضم الأول وفتح ما قبل الآخر. وفعل الأمر لا يُبنى للمجهول."
  >
    <ul>
      <li><strong>الماضي:</strong> <span class="ar">كَتَبَ → كُتِبَ</span>، <span class="ar">فَهِمَ → فُهِمَ</span>، <span class="ar">قَرَأَ → قُرِئَ</span>.</li>
      <li><strong>الماضي المعتل الوسط:</strong> <span class="ar">قَالَ → قِيلَ</span>، <span class="ar">بَاعَ → بِيعَ</span>، بكسر الأول وقلب الألف ياء.</li>
      <li><strong>المضارع:</strong> <span class="ar">يَكْتُبُ → يُكْتَبُ</span>، <span class="ar">يَقُولُ → يُقَالُ</span>، <span class="ar">يَرَى → يُرَى</span>.</li>
      <li><strong>المبدوء بتاء زائدة:</strong> يضم أوله وثانيه: <span class="ar">تَعَلَّمَ → تُعُلِّمَ</span>.</li>
    </ul>
    <p>مثال قرآني: <span class="ar">﴿وَقِيلَ يَا أَرْضُ ابْلَعِي مَاءَكِ﴾</span>، قِيلَ فعل ماضٍ مبني للمجهول، وجملة النداء وما بعدها في محل رفع نائب فاعل على المقول.</p>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">جرّب المبني للمجهول بنفسك.</span>
    ألصق جملة مبنية للمجهول في محلّل الإعراب وشاهد كيف يميز نائب الفاعل من الفاعل ومن المفعول به، مع بيان العلامة والسبب.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="what-substitutes"
    title="ما ينوب عن الفاعل"
    lead="الأصل أن ينوب المفعول به، فإن لم يوجد ناب الجار والمجرور أو الظرف المتصرف المختص أو المصدر المتصرف المختص."
  >
    <ul>
      <li><strong>المفعول به</strong> وهو الأصل: <span class="ar">أُكْرِمَ الضَّيْفُ</span>، الضيفُ نائب فاعل مرفوع وعلامة رفعه الضمة الظاهرة.</li>
      <li><strong>الجار والمجرور:</strong> <span class="ar">جُلِسَ عَلَى الْكُرْسِيِّ</span>، الجار والمجرور "على الكرسي" في محل رفع نائب فاعل، وانظر عمل <a href="/duroos/huruf-al-jarr">حروف الجر</a> في بابها.</li>
      <li><strong>الظرف المتصرف المختص:</strong> <span class="ar">صِيمَ رَمَضَانُ</span>، رمضانُ نائب فاعل مرفوع.</li>
      <li><strong>المصدر المتصرف المختص:</strong> <span class="ar">سِيرَ سَيْرٌ طَوِيلٌ</span>، سيرٌ نائب فاعل مرفوع.</li>
    </ul>
    <p>وإذا تعددت المفاعيل ناب الأول: <span class="ar">أُعْطِيَ الْفَائِزُ جَائِزَةً</span>، الفائزُ نائب فاعل مرفوع، جائزةً مفعول به ثانٍ باقٍ على نصبه.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="signs"
    title="علامات رفع نائب الفاعل"
    lead="نائب الفاعل يرفع بما يرفع به الفاعل: الضمة أصلًا، والألف في المثنى، والواو في جمع المذكر السالم والأسماء الخمسة."
  >
    <ul>
      <li><strong>الضمة:</strong> <span class="ar">شُرِحَ الدَّرْسُ</span>، الدرسُ نائب فاعل مرفوع وعلامة رفعه الضمة الظاهرة.</li>
      <li><strong>الألف في المثنى:</strong> <span class="ar">كُرِّمَ الْفَائِزَانِ</span>، الفائزان نائب فاعل مرفوع وعلامة رفعه الألف لأنه مثنى.</li>
      <li><strong>الواو في جمع المذكر السالم:</strong> <span class="ar">يُكَافَأُ الْمُجْتَهِدُونَ</span>، المجتهدون نائب فاعل مرفوع وعلامة رفعه الواو لأنه جمع مذكر سالم.</li>
      <li><strong>الواو في الأسماء الخمسة:</strong> <span class="ar">شُكِرَ أَبُوكَ</span>، أبو نائب فاعل مرفوع وعلامة رفعه الواو لأنه من <a href="/duroos/al-asma-al-khamsa">الأسماء الخمسة</a> والكاف مضاف إليه.</li>
    </ul>
    <p>وتفصيل الأصلي والفرعي من العلامات كله في درس <a href="/duroos/alamat-al-irab">علامات الإعراب</a>.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="common-mistakes"
    title="أخطاء شائعة"
    lead="أشيع أخطاء الباب ثلاثة: نصب النائب على توهم أنه مفعول به، وترك تحويل صورة الفعل، والخلط بين الجملتين عند الترجمة من أسلوب إلى أسلوب."
  >
    <ul>
      <li>يقال خطأً "كُسِرَ الزجاجَ" بالنصب، والصواب <span class="ar">كُسِرَ الزُّجَاجُ</span> بالرفع، لأن الفعل مبني للمجهول ولا فاعل في الجملة.</li>
      <li>عند التحويل يجب تغيير صورة الفعل لا حذف الفاعل فقط: "كتبَ الدرسُ" خطأ مركب، والصواب <span class="ar">كُتِبَ الدَّرْسُ</span>.</li>
      <li>الفعل مع نائب الفاعل يؤنث كما يؤنث مع الفاعل: <span class="ar">كُتِبَتِ الرِّسَالَةُ</span> لا "كُتِبَ الرسالةُ". وترتيب الجملة كلها مشروح في درس <a href="/duroos/al-jumla-al-filiyya">الجملة الفعلية</a>، والأصل النظري في <a href="/irab">ما هو الإعراب</a>.</li>
    </ul>
  </ArticleSection>

  <AyatExamples slug="naib-al-fail" />

  <ArticleFaq lang="ar" items={faqs} />

  <Footer lang="ar" />
</BaseLayout>
