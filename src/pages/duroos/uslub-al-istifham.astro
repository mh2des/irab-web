---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import Byline from '../../components/Byline.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';
import AyatExamples from '../../components/duroos/AyatExamples.astro';

const faqs = [
  { q: 'ما الفرق بين الهمزة وهل؟', a: 'الهمزة تكون للتصور، أي طلب تعيين أحد أمرين "أزيدٌ عندك أم عمرٌو؟"، وللتصديق، أي طلب معرفة النسبة "أسافر زيدٌ؟". أما هل فللتصديق فقط ويجاب عنها بنعم أو لا. والهمزة تتقدم على حرف العطف "أفلا تعقلون"، وهل تتأخر عنه "فهل أنتم منتهون".' },
  { q: 'ما محل أسماء الاستفهام من الإعراب؟', a: 'بحسب موقعها: من وما مبتدأ إن تلاهما فعل لازم أو جملة "من جاء؟"، وخبر مقدم إن تلاهما اسم معرفة "من أنت؟"، ومفعول به مقدم إن تلاهما فعل متعدٍّ لم يستوف مفعوله "ماذا قرأت؟". ومتى وأين وأيان وأنى ظروف في محل نصب. وكيف حال إن تلاها فعل تام، وخبر مقدم إن تلاها اسم.' },
  { q: 'هل أيّ مبنية؟', a: 'لا، أيّ الاستفهامية معربة بالحركات الظاهرة لأنها ملازمة للإضافة: "أيُّ طالبٍ نجح؟" مبتدأ مرفوع، و"أيَّ كتابٍ قرأت؟" مفعول به منصوب، و"بأيِّ قلمٍ كتبت؟" اسم مجرور. وهي الوحيدة المعربة من أسماء الاستفهام.' },
  { q: 'ما الفرق بين كم الاستفهامية وكم الخبرية؟', a: 'الاستفهامية يطلب بها العدد وتمييزها مفرد منصوب: "كم كتابًا قرأت؟". والخبرية تفيد التكثير لا السؤال وتمييزها مجرور مفردًا أو جمعًا: "كم كتابٍ قرأت!" أي كتبًا كثيرة. وكلتاهما مبنية على السكون ومحلها بحسب الموقع.' },
  { q: 'ما الاستفهام الإنكاري والتقريري؟', a: 'الاستفهام قد يخرج عن طلب الفهم إلى معانٍ بلاغية: فالإنكاري يفيد أن ما بعده منكر "أتقولون على الله ما لا تعلمون؟"، والتقريري يفيد حمل المخاطب على الإقرار "ألم نشرح لك صدرك؟"، والتعجبي "كيف تكفرون بالله؟". والإعراب واحد في كل ذلك.' },
  { q: 'لماذا تتقدم الهمزة على الواو والفاء وثم؟', a: 'لأن للهمزة الصدارة الأصلية في الاستفهام، فهي أم الباب، فقدمت على العاطف تنبيهًا على أصالتها: "أوَلم يروا" و"أفلم يسيروا" و"أثم إذا ما وقع". أما هل وسائر الأدوات فتأتي بعد العاطف: "فهل" و"وكيف".' },
];
---
<BaseLayout
  lang="ar"
  title="أسلوب الاستفهام: أدواته ومحلها من الإعراب · إعراب آب"
  description="أسلوب الاستفهام: الهمزة وهل حرفان لا محل لهما، وأسماء الاستفهام من وما ومتى وأين وكيف وكم وأيّ ومحل كل منها بحسب موقعه، ومعانيه البلاغية، مع أمثلة معربة كاملة."
>
  <ArticleSchema slot="head" lang="ar" kind="lesson" headline="أسلوب الاستفهام" description="أسلوب الاستفهام: الهمزة وهل حرفان لا محل لهما، وأسماء الاستفهام من وما ومتى وأين وكيف وكم وأيّ ومحل كل منها بحسب موقعه، ومعانيه البلاغية، مع أمثلة معربة كاملة." />
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="أسلوب الاستفهام"
    summary="الاستفهام طلب العلم بشيء لم يكن معلومًا، وأدواته حرفان لا محل لهما من الإعراب هما الهمزة وهل، وأسماء لها محل يتغير بتغير موقعها في الجملة. وهنا يخطئ الطلاب: يعربون كيف مبتدأ دائمًا، ويظنون أيّ مبنية، ويخلطون بين كم الاستفهامية والخبرية. هذا الدرس يرتب الأدوات ومحالها ومعانيها البلاغية بأمثلة معربة كاملة."
  />
  <Byline lang="ar" kind="lesson" />

  <ArticleSection
    lang="ar"
    id="definition"
    title="الحرفان: الهمزة وهل"
    lead="الهمزة وهل حرفا استفهام مبنيان لا محل لهما من الإعراب، ولا يغيران إعراب ما بعدهما. الهمزة أعم فتكون للتصور والتصديق، وهل للتصديق فقط."
  >
    <p><span class="ar">هَلْ حَضَرَ الطَّالِبُ؟</span></p>
    <p><strong>الإعراب:</strong> <span class="ar">هَلْ</span>: حرف استفهام مبني على السكون لا محل له من الإعراب. <span class="ar">حَضَرَ</span>: فعل ماضٍ مبني على الفتح. <span class="ar">الطَّالِبُ</span>: فاعل مرفوع وعلامة رفعه الضمة الظاهرة.</p>
    <p>وللهمزة الصدارة المطلقة فتتقدم على حرف العطف: <span class="ar">أَفَلَا تَعْقِلُونَ</span>، وهل تتأخر عنه: <span class="ar">فَهَلْ أَنْتُمْ مُنْتَهُونَ</span>. والجملة بعد الحرفين تعرب كما لو لم يوجد، فعلية كانت كما في <a href="/duroos/al-jumla-al-filiyya">الجملة الفعلية</a> أو اسمية.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="names"
    title="أسماء الاستفهام ومحالها"
    lead="أسماء الاستفهام مبنية إلا أيّ، ولها محل من الإعراب بحسب ما تسأل عنه: عن العاقل من، وعن غيره ما وماذا، وعن الزمان متى وأيان، وعن المكان أين وأنى، وعن الحال كيف، وعن العدد كم، وعن التعيين أيّ."
  >
    <ul>
      <li><strong>مبتدأ</strong>: <span class="ar">مَنْ كَتَبَ الدَّرْسَ؟</span>، من في محل رفع مبتدأ وجملة كتب خبره.</li>
      <li><strong>خبر مقدم</strong>: <span class="ar">مَنْ أَنْتَ؟</span> و<span class="ar">كَيْفَ حَالُكَ؟</span>، لأن ما بعدهما اسم معرفة هو المبتدأ.</li>
      <li><strong>مفعول به مقدم</strong>: <span class="ar">مَاذَا قَرَأْتَ؟</span>، لأن الفعل بعدها متعدٍّ لم يستوف مفعوله، وراجع <a href="/duroos/al-maful-bih">المفعول به</a>.</li>
      <li><strong>ظرف</strong>: <span class="ar">مَتَى تُسَافِرُ؟</span> و<span class="ar">أَيْنَ تَسْكُنُ؟</span>، في محل نصب مفعول فيه، وبيانه في درس <a href="/duroos/al-maful-fih">المفعول فيه</a>.</li>
      <li><strong>حال</strong>: <span class="ar">كَيْفَ جِئْتَ؟</span>، لأن ما بعدها فعل تام، وبيان <a href="/duroos/al-hal">الحال</a> في درسها.</li>
      <li><strong>كم</strong>: <span class="ar">كَمْ طَالِبًا حَضَرَ؟</span>، في محل رفع مبتدأ، وطالبًا <a href="/duroos/al-tamyiz">تمييز</a> منصوب.</li>
      <li><strong>أيّ المعربة</strong>: <span class="ar">أَيُّ طَالِبٍ نَجَحَ؟</span> مبتدأ مرفوع، و<span class="ar">أَيَّ كِتَابٍ قَرَأْتَ؟</span> مفعول به منصوب.</li>
    </ul>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">اسأل واعرب.</span>
    ألصق سؤالًا يبدأ بمن أو ماذا أو كيف في محلل الإعراب، وشاهده يقرر محل اسم الاستفهام بحسب ما بعده.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="meanings"
    title="معاني الاستفهام البلاغية"
    lead="قد يخرج الاستفهام عن طلب الفهم إلى الإنكار والتقرير والتعجب والنفي والتشويق. والإعراب في كل ذلك واحد، وإنما يختلف المعنى بالسياق."
  >
    <ul>
      <li><strong>الإنكار</strong>: <span class="ar">أَتَقُولُونَ عَلَى اللَّهِ مَا لَا تَعْلَمُونَ؟</span></li>
      <li><strong>التقرير</strong>: <span class="ar">أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ؟</span></li>
      <li><strong>التعجب</strong>: <span class="ar">كَيْفَ تَكْفُرُونَ بِاللَّهِ؟</span></li>
      <li><strong>النفي</strong>: <span class="ar">هَلْ جَزَاءُ الْإِحْسَانِ إِلَّا الْإِحْسَانُ؟</span> أي ما جزاؤه إلا الإحسان.</li>
    </ul>
    <p>وأدوات الاستفهام لها صدر الكلام، فإذا وقعت بعد ظنّ وأخواتها علقتها عن العمل، كما في درس <a href="/duroos/zanna-wa-akhawatuha">ظنّ وأخواتها</a>، وتشترك مع أدوات <a href="/duroos/uslub-al-shart">الشرط</a> في هذه الصدارة.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="common-mistakes"
    title="أخطاء شائعة"
    lead="أشيع الأخطاء إعراب كيف مبتدأ في كل موضع، وبناء أيّ، ونصب تمييز كم الخبرية أو جر تمييز الاستفهامية، وإعراب ما الاستفهامية موصولة."
  >
    <ul>
      <li>يقال خطأً "كيف: مبتدأ" في <span class="ar">كَيْفَ جِئْتَ؟</span>، والصواب أنها في محل نصب حال لأن بعدها فعلًا تامًّا؛ وتكون خبرًا مقدمًا في <span class="ar">كَيْفَ حَالُكَ؟</span> لأن بعدها اسمًا.</li>
      <li>يقال خطأً "أيّ مبنية في محل رفع"، والصواب أنها معربة: <span class="ar">أَيُّ طَالِبٍ نَجَحَ؟</span> مبتدأ مرفوع بالضمة الظاهرة.</li>
      <li>يقال خطأً "كم كتابٍ قرأت؟" بالجر في الاستفهام، والصواب <span class="ar">كَمْ كِتَابًا قَرَأْتَ؟</span> بالنصب، فالجر لكم الخبرية.</li>
      <li>يقال خطأً إن ما في <span class="ar">مَا اسْمُكَ؟</span> اسم موصول، والصواب أنها اسم استفهام في محل رفع خبر مقدم، واسمُك مبتدأ مؤخر؛ والموصولة تحتاج إلى صلة، وبيانها في درس <a href="/duroos/al-asma-al-mawsula">الأسماء الموصولة</a>.</li>
    </ul>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="worked-examples"
    title="أمثلة معربة إعرابًا كاملًا"
    lead="هذه نماذج جاهزة بالصياغة الكلاسيكية المعتمدة في كتب النحو، تصلح مراجعة سريعة قبل الامتحان وقالبًا تحاكيه في إعرابك."
  >
    <p><strong>المثال الأول</strong>: <span class="ar">مَنْ كَتَبَ الدَّرْسَ؟</span>: <span class="ar">مَنْ</span>: اسم استفهام مبني على السكون في محل رفع مبتدأ. <span class="ar">كَتَبَ</span>: فعل ماضٍ مبني على الفتح، والفاعل ضمير مستتر جوازًا تقديره هو. <span class="ar">الدَّرْسَ</span>: مفعول به منصوب وعلامة نصبه الفتحة الظاهرة. والجملة الفعلية في محل رفع خبر المبتدأ.</p>
    <p><strong>المثال الثاني</strong>: <span class="ar">مَاذَا قَرَأْتَ؟</span>: <span class="ar">مَاذَا</span>: اسم استفهام مبني على السكون في محل نصب مفعول به مقدم. <span class="ar">قَرَأْتَ</span>: فعل ماضٍ مبني على السكون لاتصاله بتاء الفاعل، والتاء ضمير متصل مبني على الفتح في محل رفع فاعل.</p>
    <p><strong>المثال الثالث</strong>: <span class="ar">كَيْفَ حَالُكَ؟</span>: <span class="ar">كَيْفَ</span>: اسم استفهام مبني على الفتح في محل رفع خبر مقدم. <span class="ar">حَالُكَ</span>: حالُ مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة، وهو مضاف، والكاف ضمير متصل مبني على الفتح في محل جر مضاف إليه.</p>
    <p><strong>المثال الرابع</strong>: <span class="ar">أَيَّ كِتَابٍ قَرَأْتَ؟</span>: <span class="ar">أَيَّ</span>: اسم استفهام مفعول به مقدم منصوب وعلامة نصبه الفتحة الظاهرة، وهو مضاف. <span class="ar">كِتَابٍ</span>: مضاف إليه مجرور وعلامة جره الكسرة الظاهرة. <span class="ar">قَرَأْتَ</span>: فعل ماضٍ مبني على السكون لاتصاله بتاء الفاعل، والتاء ضمير متصل مبني على الفتح في محل رفع فاعل.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="in-quran"
    title="من القرآن الكريم"
    lead="قال تعالى في سورة الإنسان: هَلْ أَتَىٰ عَلَى ٱلْإِنسَٰنِ حِينٌۭ مِّنَ ٱلدَّهْرِ. هل حرف استفهام خرج إلى معنى التقرير، لا محل له من الإعراب، والجملة بعده فعلية."
  >
    <p><span class="ar">هَلْ أَتَىٰ عَلَى ٱلْإِنسَٰنِ حِينٌۭ مِّنَ ٱلدَّهْرِ</span> (الإنسان: ١)</p>
    <p><strong>الإعراب:</strong> هلْ: حرف استفهام للتقرير مبني على السكون لا محل له من الإعراب. أتى: فعل ماضٍ مبني على الفتح المقدر على الألف للتعذر. على الإنسانِ: جار ومجرور متعلقان بأتى. حينٌ: فاعل أتى مرفوع وعلامة رفعه الضمة الظاهرة. من الدهرِ: جار ومجرور متعلقان بمحذوف نعت لحين.</p>
    <p>ومن الاستفهام بالهمزة قوله تعالى في الشرح: <span class="ar">أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ</span>، فالهمزة للاستفهام التقريري لا محل لها، ولم حرف نفي وجزم وقلب، ونشرحْ فعل مضارع مجزوم بلم وعلامة جزمه السكون. وتجد الإعراب الكامل في <a href="/quran">إعراب القرآن</a>.</p>
  </ArticleSection>

  <AyatExamples slug="uslub-al-istifham" />

  <ArticleFaq lang="ar" items={faqs} />

  <Footer lang="ar" />
</BaseLayout>
