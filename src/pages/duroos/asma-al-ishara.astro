---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import Byline from '../../components/Byline.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';
import AyatExamples from '../../components/duroos/AyatExamples.astro';

const faqs = [
  { q: 'لماذا أسماء الإشارة مبنية؟', a: 'لشبهها بالحروف في الافتقار إلى ما يوضح معناها: فكما لا يفهم الحرف إلا بما بعده، لا يفهم اسم الإشارة إلا بإشارة حسية أو معنوية تصاحبه. ولذلك بنيت ولزمت صورة واحدة، إلا المثنى منها فأعرب لأنه جاء على صورة المثنى.' },
  { q: 'لماذا هذان وهاتان معربان؟', a: 'لأنهما على صورة المثنى، فأجريا مجراه: بالألف رفعًا "جاء هذان" وبالياء نصبًا وجرًّا "رأيت هذين" و"مررت بهذين". وذهب بعض النحاة إلى أنهما مبنيان على الألف أو الياء في محل كذا، والمشهور في التدريس إعرابهما إعراب المثنى.' },
  { q: 'ما إعراب الاسم الواقع بعد اسم الإشارة؟', a: 'إن كان معرفًا بأل جامدًا فهو بدل من اسم الإشارة أو عطف بيان: "هذا الطالبُ مجتهدٌ" فالطالب بدل مرفوع ومجتهد خبر. وإن كان نكرة فهو خبر: "هذا طالبٌ". وإن كان مشتقًا معرفًا بأل جاز أن يكون نعتًا: "هذا المجتهدُ ناجحٌ".' },
  { q: 'ما الفرق بين ذاك وذلك؟', a: 'ذا للقريب، وذاك بكاف الخطاب للمتوسط، وذلك باللام والكاف للبعيد. واللام حرف للبعد لا محل له من الإعراب، والكاف حرف خطاب لا محل له، وهي تتصرف بحسب المخاطب: ذلك وذلكما وذلكم وذلكن.' },
  { q: 'هل هنا وهناك من أسماء الإشارة؟', a: 'نعم، وهي للإشارة إلى المكان: هنا للقريب، وهناك للمتوسط، وهنالك وثَمَّ للبعيد. وتعرب ظرف مكان مبنيًّا في محل نصب مفعول فيه، متعلقًا في الغالب بمحذوف خبر مقدم: "هنا الكتابُ".' },
  { q: 'ما إعراب الهاء في هذا والكاف في ذلك؟', a: 'الهاء حرف تنبيه مبني على السكون لا محل له من الإعراب، والكاف حرف خطاب مبني على الفتح لا محل له من الإعراب. فلا يقال في الكاف إنها ضمير، لأنها لا تحل محل اسم ولا تقع موقع الفاعل أو المضاف إليه.' },
];
---
<BaseLayout
  lang="ar"
  title="أسماء الإشارة: بناؤها ومحلها وإعراب المثنى منها · إعراب"
  description="أسماء الإشارة: ألفاظها للمفرد والمثنى والجمع والمكان، حروف التنبيه والخطاب والبعد، بناؤها ومحلها من الإعراب، وإعراب هذان وهاتان والاسم بعدها، مع أمثلة معربة."
>
  <ArticleSchema slot="head" lang="ar" kind="lesson" headline="أسماء الإشارة" description="أسماء الإشارة: ألفاظها للمفرد والمثنى والجمع والمكان، حروف التنبيه والخطاب والبعد، بناؤها ومحلها من الإعراب، وإعراب هذان وهاتان والاسم بعدها، مع أمثلة معربة." />
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="أسماء الإشارة"
    summary="أسماء الإشارة معارف مبنية تدل على معين بإشارة إليه، ولها ألفاظ للمفرد والمثنى والجمع مذكرًا ومؤنثًا، وألفاظ للمكان. تلتبس على الطلاب في ثلاثة مواضع: محلها من الإعراب، وإعراب المثنى منها بالحروف، وإعراب الاسم الواقع بعدها بدلًا أو خبرًا. هذا الدرس يفصل الثلاثة بأمثلة معربة كاملة وشاهد من فاتحة سورة البقرة."
  />
  <Byline lang="ar" kind="lesson" />

  <ArticleSection
    lang="ar"
    id="definition"
    title="ألفاظها"
    lead="للمفرد المذكر ذا، وللمفردة المؤنثة ذي وذه وتي وته، وللمثنى ذان وتان، وللجمع أولاء، وللمكان هنا وثَمَّ. وتلحقها ها للتنبيه في أولها، والكاف للخطاب واللام للبعد في آخرها."
  >
    <ul>
      <li><strong>المفرد</strong>: <span class="ar">هَذَا الْكِتَابُ</span> و<span class="ar">هَذِهِ الْمَدْرَسَةُ</span>.</li>
      <li><strong>المثنى</strong>: <span class="ar">هَذَانِ الطَّالِبَانِ</span> و<span class="ar">هَاتَانِ الطَّالِبَتَانِ</span>.</li>
      <li><strong>الجمع</strong>: <span class="ar">هَؤُلَاءِ الطُّلَّابُ</span> للعاقل مذكرًا ومؤنثًا.</li>
      <li><strong>البعيد</strong>: <span class="ar">ذَلِكَ</span> و<span class="ar">تِلْكَ</span> و<span class="ar">أُولَئِكَ</span>، بالكاف للخطاب واللام للبعد.</li>
      <li><strong>المكان</strong>: <span class="ar">هُنَا</span> للقريب و<span class="ar">هُنَاكَ</span> و<span class="ar">هُنَالِكَ</span> و<span class="ar">ثَمَّ</span> للبعيد.</li>
    </ul>
    <p>وهي من المعارف، رتبتها بعد الضمير والعلم، وبيان أقسام المعارف في درس <a href="/duroos/al-nakira-wal-marifa">النكرة والمعرفة</a>.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="irab"
    title="بناؤها ومحلها من الإعراب"
    lead="أسماء الإشارة كلها مبنية، فتأخذ محلها من الإعراب بحسب موقعها في الجملة: رفعًا أو نصبًا أو جرًّا. ويستثنى المثنى منها فيعرب بالألف رفعًا وبالياء نصبًا وجرًّا."
  >
    <ul>
      <li><strong>في محل رفع</strong>: <span class="ar">هَذَا كِتَابٌ</span>، ذا اسم إشارة مبني على السكون في محل رفع مبتدأ.</li>
      <li><strong>في محل نصب</strong>: <span class="ar">قَرَأْتُ هَذَا</span>، ذا في محل نصب مفعول به.</li>
      <li><strong>في محل جر</strong>: <span class="ar">نَظَرْتُ إِلَى هَذَا</span>، ذا في محل جر بإلى.</li>
      <li><strong>المثنى معرب</strong>: <span class="ar">جَاءَ هَذَانِ</span> مرفوع بالألف، و<span class="ar">رَأَيْتُ هَذَيْنِ</span> منصوب بالياء، و<span class="ar">مَرَرْتُ بِهَذَيْنِ</span> مجرور بالياء.</li>
    </ul>
    <p>فهي أخت <a href="/duroos/al-damair">الضمائر</a> و<a href="/duroos/al-asma-al-mawsula">الأسماء الموصولة</a> في البناء، ويجمعها باب المبنيات. وراجع علامات المثنى في درس <a href="/duroos/alamat-al-irab">علامات الإعراب</a>.</p>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">أشر واعرب.</span>
    ألصق جملة تبدأ بهذا أو ذلك أو هؤلاء في محلل الإعراب، وشاهده يبين محل اسم الإشارة وإعراب الاسم الواقع بعده.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="after"
    title="إعراب الاسم الواقع بعد اسم الإشارة"
    lead="الاسم بعد اسم الإشارة إن كان معرفًا بأل فهو بدل منه أو عطف بيان، وإن كان نكرة فهو خبر. وهذا الفرق هو مفتاح إعراب هذا كتابٌ وهذا الكتابُ."
  >
    <ul>
      <li><strong>النكرة خبر</strong>: <span class="ar">هَذَا كِتَابٌ مُفِيدٌ</span>، كتابٌ خبر مرفوع، ومفيدٌ نعت له.</li>
      <li><strong>المعرف بأل بدل</strong>: <span class="ar">هَذَا الْكِتَابُ مُفِيدٌ</span>، الكتابُ بدل من اسم الإشارة مرفوع، ومفيدٌ خبر المبتدأ. وتفصيل <a href="/duroos/al-badal">البدل</a> في درسه.</li>
      <li><strong>المضاف إلى معرفة بدل كذلك</strong>: <span class="ar">هَذَا كِتَابُ الطَّالِبِ مُفِيدٌ</span>.</li>
    </ul>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="common-mistakes"
    title="أخطاء شائعة"
    lead="أشيع الأخطاء استعمال هذان في النصب والجر، وإعراب اسم الإشارة فاعلًا أو مبتدأ من غير ذكر البناء والمحل، وإعراب الكاف في ذلك ضميرًا."
  >
    <ul>
      <li>يقال خطأً "رأيت هذان الطالبان"، والصواب <span class="ar">رَأَيْتُ هَذَيْنِ الطَّالِبَيْنِ</span> بالياء، فالمثنى ينصب ويجر بالياء.</li>
      <li>يقال خطأً "هذا: مبتدأ مرفوع"، والصواب: اسم إشارة مبني على السكون في محل رفع مبتدأ، فالمبني لا يوصف بالرفع بل بالمحل.</li>
      <li>يقال خطأً إن الكاف في <span class="ar">ذَلِكَ</span> ضمير مضاف إليه، والصواب أنها حرف خطاب لا محل له من الإعراب، واللام حرف للبعد.</li>
    </ul>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="worked-examples"
    title="أمثلة معربة إعرابًا كاملًا"
    lead="هذه نماذج جاهزة بالصياغة الكلاسيكية المعتمدة في كتب النحو، تصلح مراجعة سريعة قبل الامتحان وقالبًا تحاكيه في إعرابك."
  >
    <p><strong>المثال الأول</strong>: <span class="ar">هَذَا كِتَابٌ مُفِيدٌ</span>: <span class="ar">هَذَا</span>: الهاء حرف تنبيه مبني على السكون لا محل له من الإعراب، وذا اسم إشارة مبني على السكون في محل رفع مبتدأ. <span class="ar">كِتَابٌ</span>: خبر مرفوع وعلامة رفعه الضمة الظاهرة. <span class="ar">مُفِيدٌ</span>: نعت لكتابٌ مرفوع مثله وعلامة رفعه الضمة الظاهرة.</p>
    <p><strong>المثال الثاني</strong>: <span class="ar">هَذَا الطَّالِبُ مُجْتَهِدٌ</span>: <span class="ar">هَذَا</span>: الهاء للتنبيه، وذا اسم إشارة مبني على السكون في محل رفع مبتدأ. <span class="ar">الطَّالِبُ</span>: بدل من اسم الإشارة مرفوع وعلامة رفعه الضمة الظاهرة. <span class="ar">مُجْتَهِدٌ</span>: خبر المبتدأ مرفوع وعلامة رفعه الضمة الظاهرة.</p>
    <p><strong>المثال الثالث</strong>: <span class="ar">رَأَيْتُ هَذَيْنِ الطَّالِبَيْنِ</span>: <span class="ar">رَأَيْتُ</span>: فعل ماضٍ مبني على السكون لاتصاله بتاء الفاعل، والتاء ضمير متصل مبني على الضم في محل رفع فاعل. <span class="ar">هَذَيْنِ</span>: الهاء للتنبيه، وذين اسم إشارة مفعول به منصوب وعلامة نصبه الياء لأنه مثنى. <span class="ar">الطَّالِبَيْنِ</span>: بدل من اسم الإشارة منصوب وعلامة نصبه الياء لأنه مثنى.</p>
    <p><strong>المثال الرابع</strong>: <span class="ar">قَرَأْتُ فِي تِلْكَ الْمَكْتَبَةِ</span>: <span class="ar">قَرَأْتُ</span>: فعل ماضٍ مبني على السكون لاتصاله بتاء الفاعل، والتاء ضمير متصل مبني على الضم في محل رفع فاعل. <span class="ar">فِي</span>: حرف جر مبني على السكون. <span class="ar">تِلْكَ</span>: تي اسم إشارة مبني على السكون في محل جر بفي، واللام للبعد، والكاف حرف خطاب. <span class="ar">الْمَكْتَبَةِ</span>: بدل من اسم الإشارة مجرور وعلامة جره الكسرة الظاهرة، والجار والمجرور متعلقان بالفعل قرأت.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="in-quran"
    title="من القرآن الكريم"
    lead="قال تعالى في فاتحة سورة البقرة: ذَٰلِكَ ٱلْكِتَٰبُ لَا رَيْبَ ۛ فِيهِ ۛ هُدًۭى لِّلْمُتَّقِينَ. ذا اسم إشارة في محل رفع مبتدأ، واللام للبعد والكاف للخطاب، والكتاب بدل منه."
  >
    <p><span class="ar">ذَٰلِكَ ٱلْكِتَٰبُ لَا رَيْبَ ۛ فِيهِ ۛ هُدًۭى لِّلْمُتَّقِينَ</span> (البقرة: ٢)</p>
    <p><strong>الإعراب:</strong> ذا: اسم إشارة مبني على السكون في محل رفع مبتدأ، واللام للبعد، والكاف للخطاب. الكتابُ: بدل من ذا أو عطف بيان تبعه في الرفع. لا: نافية للجنس. ريبَ: اسم لا مبني على الفتح في محل نصب. فيه: في حرف جر، والهاء ضمير متصل مبني في محل جر بفي، والجار والمجرور متعلقان بمحذوف خبر لا. هدًى: خبر ثانٍ للمبتدأ ذا مرفوع وعلامة رفعه الضمة المقدرة على الألف منع من ظهورها التعذر. للمتقين: جار ومجرور متعلقان بهدى، وعلامة الجر الياء لأنه جمع مذكر سالم.</p>
    <p>ومن الباب قوله تعالى في البقرة: <span class="ar">أُو۟لَٰٓئِكَ ٱلَّذِينَ ٱشْتَرَوُا۟ ٱلضَّلَٰلَةَ بِٱلْهُدَىٰ</span>، فأولاء اسم إشارة في محل رفع مبتدأ، والذين اسم موصول في محل رفع خبر. وتجد الإعراب الكامل في <a href="/quran">إعراب القرآن</a>.</p>
  </ArticleSection>

  <AyatExamples slug="asma-al-ishara" />

  <ArticleFaq lang="ar" items={faqs} />

