---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';

const faqs = [
  { q: 'ما إعراب المعطوف؟', a: 'المعطوف تابع: يأخذ إعراب المعطوف عليه رفعًا ونصبًا وجرًّا وجزمًا. تقول: جاء محمدٌ وعليٌّ بالرفع، ورأيتُ محمدًا وعليًّا بالنصب، ومررتُ بمحمدٍ وعليٍّ بالجر.' },
  { q: 'ما الفرق بين الواو والفاء وثم؟', a: 'الواو لمطلق الجمع لا تفيد ترتيبًا، والفاء للترتيب مع التعقيب (بلا مهلة)، وثم للترتيب مع التراخي (بمهلة). دخل محمدٌ وعليٌّ: لا ترتيب. دخل محمدٌ فعليٌّ: عليّ بعده مباشرة. دخل محمدٌ ثم عليٌّ: بعده بمهلة.' },
  { q: 'متى تكون "أو" للتخيير ومتى للإباحة؟', a: 'بعد الطلب تكون للتخيير إذا امتنع الجمع نحو "تزوج هندًا أو أختَها"، وللإباحة إذا جاز الجمع نحو "جالسِ العلماءَ أو الزهادَ". وبعد الخبر تفيد الشك أو الإبهام.' },
  { q: 'هل يعطف الفعل على الفعل؟', a: 'نعم، يعطف الفعل على الفعل إذا اتحد زمناهما، ويأخذ حكمه الإعرابي: "لم يدرسْ ولم يكتبْ"، ويعطف المضارع المنصوب على مثله: "لن أتأخرَ وأهملَ".' },
  { q: 'ما شرط العطف على الضمير المرفوع المتصل؟', a: 'يحسن الفصل بضمير منفصل أو غيره قبل العطف: "ذهبتُ أنا وأخي" أفصح من "ذهبتُ وأخي". قال تعالى: ﴿اسْكُنْ أَنْتَ وَزَوْجُكَ الْجَنَّةَ﴾ ففصل بأنت.' },
  { q: 'ما الفرق بين "لا" و"بل" و"لكن" العاطفة؟', a: 'لا تنفي الحكم عن المعطوف بعد إثباته لما قبلها: جاء محمدٌ لا عليٌّ. وبل للإضراب: جاء محمدٌ بل عليٌّ. ولكن للاستدراك بعد نفي: ما جاء محمدٌ لكن عليٌّ.' },
];
---
<BaseLayout
  lang="ar"
  title="العطف: حروفه ومعانيها وإعراب المعطوف · إعراب"
  description="شرح العطف: حروف العطف التسعة ومعانيها، إعراب المعطوف تبعًا للمعطوف عليه في الرفع والنصب والجر والجزم، وعطف الفعل والجملة، مع أمثلة قرآنية معربة."
>
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="العطف"
    summary="العطف تابع يتوسط بينه وبين متبوعه حرف من حروف العطف، فيشركه في إعرابه وحكمه. حروفه تسعة مشهورة، ولكل حرف معنى يغير دلالة الجملة وإن اتحد الإعراب. هذا الدرس يعرض الحروف ومعانيها وإعراب المعطوف بالأمثلة المعربة."
  />

  <ArticleSection
    lang="ar"
    id="definition"
    title="التعريف والإعراب"
    lead="المعطوف يتبع المعطوف عليه في إعرابه: إن رفع رفع، وإن نصب نصب، وإن جر جر، وإن جزم الفعل جزم. وحرف العطف مبني لا محل له من الإعراب."
  >
    <p><span class="ar">جَاءَ مُحَمَّدٌ وَعَلِيٌّ</span></p>
    <p><strong>الإعراب:</strong> جاء فعل ماضٍ مبني على الفتح. محمدٌ <a href="/duroos/al-fail">فاعل</a> مرفوع وعلامة رفعه الضمة الظاهرة. الواو حرف عطف مبني على الفتح لا محل له من الإعراب. عليٌّ معطوف على محمد مرفوع مثله وعلامة رفعه الضمة الظاهرة.</p>
    <p>وكذا في النصب والجر: <span class="ar">رَأَيْتُ مُحَمَّدًا وَعَلِيًّا</span>، <span class="ar">مَرَرْتُ بِمُحَمَّدٍ وَعَلِيٍّ</span>. فالعطف من التوابع، إخوة <a href="/duroos/al-naat">النعت</a> و<a href="/duroos/al-badal">البدل</a> و<a href="/duroos/al-tawkid">التوكيد</a>.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="letters"
    title="حروف العطف ومعانيها"
    lead="تسعة حروف مشهورة، أربعة تشرك المعطوف في الحكم والإعراب معًا: الواو والفاء وثم وأو، وخمسة لها أحكام أدق: أم وبل ولا ولكن وحتى."
  >
    <ul>
      <li><span class="ar">الْوَاو</span>: لمطلق الجمع، <span class="ar">﴿وَلَقَدْ أَرْسَلْنَا نُوحًا وَإِبْرَاهِيمَ﴾</span>.</li>
      <li><span class="ar">الْفَاء</span>: للترتيب والتعقيب, <span class="ar">دَخَلَ الْمُعَلِّمُ فَالطُّلَّابُ</span>.</li>
      <li><span class="ar">ثُمَّ</span>: للترتيب والتراخي، <span class="ar">﴿ثُمَّ أَمَاتَهُ فَأَقْبَرَهُ ثُمَّ إِذَا شَاءَ أَنشَرَهُ﴾</span> جمعت الآية الفاء وثم.</li>
      <li><span class="ar">أَوْ</span>: للتخيير أو الشك أو الإباحة، <span class="ar">﴿لَبِثْنَا يَوْمًا أَوْ بَعْضَ يَوْمٍ﴾</span>.</li>
      <li><span class="ar">أَمْ</span>: لطلب التعيين بعد همزة الاستفهام، <span class="ar">أَقَرَأْتَ الدَّرْسَ أَمْ حَفِظْتَهُ؟</span></li>
      <li><span class="ar">بَلْ</span>: للإضراب، <span class="ar">مَا جَاءَ مُحَمَّدٌ بَلْ عَلِيٌّ</span>.</li>
      <li><span class="ar">لَا</span>: لنفي الحكم عن المعطوف، <span class="ar">جَاءَ مُحَمَّدٌ لَا عَلِيٌّ</span>.</li>
      <li><span class="ar">لَكِنْ</span>: للاستدراك بعد نفي، <span class="ar">مَا قَرَأْتُ الْقِصَّةَ لَكِنِ الدَّرْسَ</span>.</li>
      <li><span class="ar">حَتَّى</span>: للغاية بشرط أن يكون المعطوف بعضًا من المعطوف عليه، <span class="ar">قَرَأْتُ الْكِتَابَ حَتَّى فِهْرِسَهُ</span>.</li>
    </ul>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">جرّب سلسلة معطوفات.</span>
    ألصق جملة فيها أكثر من معطوف في محلّل الإعراب وشاهد كل معطوف يرث إعراب متبوعه، مع بيان حرف العطف ومعناه.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="verbs"
    title="عطف الأفعال والجمل"
    lead="يعطف الفعل على الفعل فيتبعه في إعرابه، وتعطف الجملة على الجملة فتأخذ محلها الإعرابي إن كان لها محل."
  >
    <p><strong>عطف المضارع المجزوم:</strong> <span class="ar">لَمْ يَدْرُسْ وَلَمْ يَكْتُبْ</span>، يكتبْ معطوف مجزوم وعلامة جزمه السكون، وتفصيل الجوازم في <a href="/duroos/jazm-al-mudari">درسها</a>.</p>
    <p><strong>عطف المضارع المنصوب:</strong> <span class="ar">لَنْ أَتَأَخَّرَ وَأُهْمِلَ</span>، أهملَ معطوف على أتأخرَ منصوب مثله، وأدوات النصب في <a href="/duroos/nasb-al-mudari">درسها</a>.</p>
    <p><strong>عطف الأفعال الخمسة:</strong> <span class="ar">الطُّلَّابُ يَقْرَؤُونَ وَيَكْتُبُونَ</span>، يكتبون معطوف مرفوع وعلامة رفعه ثبوت النون لأنه من <a href="/duroos/al-afal-al-khamsa">الأفعال الخمسة</a>.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="common-mistakes"
    title="أخطاء شائعة"
    lead="مدار الخطأ في العطف على كسر التبعية: مخالفة المعطوف لمتبوعه في الإعراب، أو الخلط بين معاني الحروف."
  >
    <ul>
      <li>يقال خطأً "رأيتُ محمدًا وعليٌّ" بالرفع، والصواب <span class="ar">وَعَلِيًّا</span> بالنصب تبعًا للمفعول به.</li>
      <li>إذا كان المعطوف ممنوعًا من الصرف جر بالفتحة: <span class="ar">مَرَرْتُ بِمُحَمَّدٍ وَأَحْمَدَ</span>، وتفصيله في <a href="/duroos/al-mamnu-min-al-sarf">درسه</a>.</li>
      <li>استعمال ثم في التعقيب المباشر أو الفاء في التراخي يفسد المعنى وإن صح الإعراب، فاختيار الحرف جزء من الصواب.</li>
    </ul>
    <p>والإطار النظري للتوابع كلها في <a href="/nahw">ما هو النحو</a>، وتطبيقها العملي في <a href="/irab">الإعراب</a>.</p>
  </ArticleSection>

  <ArticleFaq lang="ar" items={faqs} />

  <Footer lang="ar" />
</BaseLayout>
