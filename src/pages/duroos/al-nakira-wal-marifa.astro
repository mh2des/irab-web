---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import Byline from '../../components/Byline.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';
import AyatExamples from '../../components/duroos/AyatExamples.astro';

const faqs = [
  { q: 'كيف أميز النكرة من المعرفة بسرعة؟', a: 'النكرة ما قبل أل فأثرت فيه التعريف: "رجل" تقبل أل فتصير "الرجل". أو ما وقع موقع ما يقبل أل، كذي بمعنى صاحب. فإن لم يقبل الاسم أل ولم يقع موقع ما يقبلها فهو معرفة، كالضمائر والأعلام وأسماء الإشارة.' },
  { q: 'أي المعارف أعرف؟', a: 'أعرف المعارف الضمير، لأنه لا يدل إلا على معين بذاته، ثم العلم، ثم اسم الإشارة، ثم الاسم الموصول، ثم المعرف بأل، ثم المضاف إلى واحد منها، ويتبع المضاف في رتبته ما أضيف إليه.' },
  { q: 'ما مسوغات الابتداء بالنكرة؟', a: 'الأصل أن يكون المبتدأ معرفة لأنه محكوم عليه. ويجوز الابتداء بالنكرة إذا أفادت، ومن أشهر المسوغات: تقدم الخبر شبه الجملة "في الدار رجلٌ"، ووصف النكرة "طالبٌ مجتهدٌ خيرٌ من عالمٍ كسولٍ"، ووقوعها بعد استفهام أو نفي "أرجلٌ في الدار؟" و"ما أحدٌ أفضلُ منك"، وإفادتها العموم "كلٌّ يموت".' },
  { q: 'لماذا الحال نكرة والتمييز نكرة؟', a: 'لأن الحال وصف فضلة يبين هيئة صاحبه، وصاحبه معرفة في الغالب، فلو جاءت الحال معرفة لالتبست بالنعت. والتمييز نكرة لأنه يزيل الإبهام عن ذات أو نسبة فلا حاجة إلى تعريفه. فإذا جاءا معرفة في اللفظ أولا بنكرة: "ادخلوا الأولَ فالأولَ" أي مرتبين.' },
  { q: 'هل المضاف إلى نكرة معرفة؟', a: 'لا. المضاف يكتسب التعريف من المضاف إليه إن كان معرفة: "كتابُ الطالبِ" معرفة. فإن أضيف إلى نكرة بقي نكرة: "كتابُ طالبٍ" نكرة، ولذلك يقبل أل معنى.' },
  { q: 'هل كل اسم فيه أل معرفة؟', a: 'أل العهدية والجنسية تعرف: "الطالب" و"الرجل خير من المرأة". أما أل الزائدة اللازمة في نحو "الذي" و"اللات" فليست للتعريف، وأل الموصولة في نحو "الضارب" اسم موصول. فالمعتبر أل المعرفة عهدية كانت أو جنسية.' },
];
---
<BaseLayout
  lang="ar"
  title="النكرة والمعرفة: أقسام المعارف وأثرها في الإعراب · إعراب آب"
  description="النكرة والمعرفة: تعريف النكرة وعلامتها، أقسام المعارف السبعة من الضمير إلى المنادى، وأثر التعريف والتنكير في المبتدأ والنعت والحال والتمييز، مع أمثلة معربة."
>
  <ArticleSchema slot="head" lang="ar" kind="lesson" headline="النكرة والمعرفة" description="النكرة والمعرفة: تعريف النكرة وعلامتها، أقسام المعارف السبعة من الضمير إلى المنادى، وأثر التعريف والتنكير في المبتدأ والنعت والحال والتمييز، مع أمثلة معربة." />
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="النكرة والمعرفة"
    summary="الاسم في العربية إما نكرة تدل على شائع في جنسها، وإما معرفة تدل على معين. وهذا التقسيم ليس مسألة معنى فحسب، بل يغير الإعراب: فالمبتدأ لا يكون نكرة إلا بمسوغ، والجملة بعد النكرة صفة وبعد المعرفة حال، والنعت يتبع منعوته في التعريف والتنكير. هذا الدرس يعرض أقسام المعارف السبعة وأثر كل ذلك في الإعراب بأمثلة معربة كاملة."
  />
  <Byline lang="ar" kind="lesson" />

  <ArticleSection
    lang="ar"
    id="definition"
    title="ما النكرة وما المعرفة؟"
    lead="النكرة اسم يدل على شائع في جنسه لا يخص واحدًا بعينه، وعلامتها قبول أل. والمعرفة اسم يدل على معين، ولا تقبل أل لأنها معرفة بغيرها."
  >
    <p><span class="ar">رَجُلٌ</span> نكرة لأنها تصدق على كل رجل، وتقبل أل فتصير <span class="ar">الرَّجُلُ</span>. و<span class="ar">مُحَمَّدٌ</span> معرفة لأنه علم على واحد بعينه، ولا يقال "المحمد". و<span class="ar">هُوَ</span> معرفة لأنه ضمير لا يدل إلا على معين.</p>
    <p>ويظهر أثر الفرق أول ما يظهر في <a href="/duroos/al-jumla-al-ismiyya">الجملة الاسمية</a>: <span class="ar">الطَّالِبُ مُجْتَهِدٌ</span> بدأت بمعرفة لأن المبتدأ محكوم عليه، والحكم على المجهول لا يفيد، وجاء الخبر نكرة لأنه هو الفائدة الجديدة.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="kinds"
    title="أقسام المعارف السبعة"
    lead="المعارف محصورة: الضمير، والعلم، واسم الإشارة، والاسم الموصول، والمعرف بأل، والمضاف إلى معرفة، والنكرة المقصودة بالنداء. وما عداها نكرة."
  >
    <ul>
      <li><strong>الضمير</strong>: <span class="ar">أَنَا</span> و<span class="ar">أَنْتَ</span> و<span class="ar">هُوَ</span>، وهو أعرف المعارف، وبيانه في درس <a href="/duroos/al-damair">الضمائر</a>.</li>
      <li><strong>العلم</strong>: <span class="ar">مُحَمَّدٌ</span> و<span class="ar">مَكَّةُ</span> و<span class="ar">النِّيلُ</span>.</li>
      <li><strong>اسم الإشارة</strong>: <span class="ar">هَذَا</span> و<span class="ar">تِلْكَ</span>، وبيانه في درس <a href="/duroos/asma-al-ishara">أسماء الإشارة</a>.</li>
      <li><strong>الاسم الموصول</strong>: <span class="ar">الَّذِي</span> و<span class="ar">الَّتِي</span>، وبيانه في درس <a href="/duroos/al-asma-al-mawsula">الأسماء الموصولة</a>.</li>
      <li><strong>المعرف بأل</strong>: <span class="ar">الْكِتَابُ</span> و<span class="ar">الْمَدْرَسَةُ</span>.</li>
      <li><strong>المضاف إلى معرفة</strong>: <span class="ar">كِتَابُ الطَّالِبِ</span> و<span class="ar">بَيْتُكَ</span>، وبيانه في درس <a href="/duroos/al-idafa">الإضافة</a>.</li>
      <li><strong>النكرة المقصودة بالنداء</strong>: <span class="ar">يَا طَالِبُ</span> إذا قصدت واحدًا بعينه، وبيانه في درس <a href="/duroos/al-munada">المنادى</a>.</li>
    </ul>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">راقب أثر التعريف في جملتك.</span>
    ألصق جملة فيها نكرة ومعرفة في محلل الإعراب، وشاهده يقرر النعت من الحال، والخبر من البدل، بحسب التعريف والتنكير.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="effect"
    title="أثر التعريف والتنكير في الإعراب"
    lead="أربعة أحكام يقررها التعريف والتنكير: الابتداء بالنكرة لا يصح إلا بمسوغ، والجمل بعد النكرات صفات وبعد المعارف أحوال، والنعت يطابق منعوته تعريفًا وتنكيرًا، والحال والتمييز واسم لا النافية للجنس نكرات."
  >
    <ul>
      <li><strong>الابتداء بالنكرة</strong>: لا يقال "رجلٌ في الدار" إلا بمسوغ، كتقدم الخبر شبه الجملة: <span class="ar">فِي الدَّارِ رَجُلٌ</span>، أو الوصف: <span class="ar">طَالِبٌ مُجْتَهِدٌ خَيْرٌ مِنْ عَالِمٍ كَسُولٍ</span>، وتفصيله في درس <a href="/duroos/al-mubtada-wal-khabar">المبتدأ والخبر</a>.</li>
      <li><strong>الجمل بعد النكرات والمعارف</strong>: <span class="ar">رَأَيْتُ طَالِبًا يَقْرَأُ</span> فجملة يقرأ نعت، و<span class="ar">رَأَيْتُ الطَّالِبَ يَقْرَأُ</span> فجملة يقرأ حال.</li>
      <li><strong>مطابقة النعت</strong>: <span class="ar">كِتَابٌ مُفِيدٌ</span> و<span class="ar">الْكِتَابُ الْمُفِيدُ</span>، ولا يقال "كتابٌ المفيدُ"، وتفصيله في درس <a href="/duroos/al-naat">النعت</a>.</li>
      <li><strong>النكرات الواجبة</strong>: <a href="/duroos/al-hal">الحال</a> نكرة وصاحبها معرفة: <span class="ar">جَاءَ الطَّالِبُ مُبْتَسِمًا</span>، و<a href="/duroos/al-tamyiz">التمييز</a> نكرة: <span class="ar">اشْتَرَيْتُ رِطْلًا عَسَلًا</span>، واسم <a href="/duroos/la-nafiya-lil-jins">لا النافية للجنس</a> نكرة: <span class="ar">لَا طَالِبَ فِي الصَّفِّ</span>.</li>
    </ul>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="common-mistakes"
    title="أخطاء شائعة"
    lead="أشيع الأخطاء الابتداء بنكرة من غير مسوغ، ومخالفة النعت لمنعوته في التعريف، والخلط بين النعت والحال."
  >
    <ul>
      <li>يقال خطأً "رجلٌ جاء" على أنه مبتدأ وخبر من غير مسوغ، والصواب <span class="ar">جَاءَ رَجُلٌ</span> فعلًا وفاعلًا، أو <span class="ar">فِي الدَّارِ رَجُلٌ</span> بتقديم الخبر.</li>
      <li>يقال خطأً "قرأت كتابًا المفيدَ"، والصواب <span class="ar">قَرَأْتُ كِتَابًا مُفِيدًا</span>، فالنعت يتبع منعوته في التنكير.</li>
      <li>يقال خطأً إن "المسرعُ" في <span class="ar">جَاءَ الطَّالِبُ الْمُسْرِعُ</span> حال، والصواب أنه نعت لأنه معرفة تبعت معرفة؛ والحال نكرة: <span class="ar">جَاءَ الطَّالِبُ مُسْرِعًا</span>.</li>
    </ul>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="worked-examples"
    title="أمثلة معربة إعرابًا كاملًا"
    lead="هذه نماذج جاهزة بالصياغة الكلاسيكية المعتمدة في كتب النحو، تصلح مراجعة سريعة قبل الامتحان وقالبًا تحاكيه في إعرابك."
  >
    <p><strong>المثال الأول</strong>: <span class="ar">فِي الدَّارِ رَجُلٌ</span>: <span class="ar">فِي</span>: حرف جر مبني على السكون. <span class="ar">الدَّارِ</span>: اسم مجرور وعلامة جره الكسرة الظاهرة، والجار والمجرور متعلقان بمحذوف خبر مقدم. <span class="ar">رَجُلٌ</span>: مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة، وسوغ الابتداء بالنكرة تقدم الخبر شبه الجملة.</p>
    <p><strong>المثال الثاني</strong>: <span class="ar">قَرَأْتُ كِتَابًا مُفِيدًا</span>: <span class="ar">قَرَأْتُ</span>: فعل ماضٍ مبني على السكون لاتصاله بتاء الفاعل، والتاء ضمير متصل مبني على الضم في محل رفع فاعل. <span class="ar">كِتَابًا</span>: مفعول به منصوب وعلامة نصبه الفتحة الظاهرة. <span class="ar">مُفِيدًا</span>: نعت لكتابًا منصوب مثله وعلامة نصبه الفتحة الظاهرة، وقد طابقه في التنكير.</p>
    <p><strong>المثال الثالث</strong>: <span class="ar">جَاءَ الطَّالِبُ مُبْتَسِمًا</span>: <span class="ar">جَاءَ</span>: فعل ماضٍ مبني على الفتح. <span class="ar">الطَّالِبُ</span>: فاعل مرفوع وعلامة رفعه الضمة الظاهرة، وهو معرفة بأل. <span class="ar">مُبْتَسِمًا</span>: حال منصوبة وعلامة نصبها الفتحة الظاهرة، وهي نكرة وصاحبها الطالب.</p>
    <p><strong>المثال الرابع</strong>: <span class="ar">رَأَيْتُ طَالِبًا يَقْرَأُ</span>: <span class="ar">رَأَيْتُ</span>: فعل ماضٍ مبني على السكون لاتصاله بتاء الفاعل، والتاء ضمير متصل مبني على الضم في محل رفع فاعل. <span class="ar">طَالِبًا</span>: مفعول به منصوب وعلامة نصبه الفتحة الظاهرة. <span class="ar">يَقْرَأُ</span>: فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة، والفاعل ضمير مستتر جوازًا تقديره هو، والجملة الفعلية في محل نصب نعت لطالبًا لأنه نكرة.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="in-quran"
    title="من القرآن الكريم"
    lead="قال تعالى في سورة البقرة: رَبِّ ٱجْعَلْ هَٰذَا بَلَدًا ءَامِنًۭا. اجتمع في الآية معرفة هي اسم الإشارة، ونكرة هي بلدًا، ونعت نكرة تبعها هو آمنًا."
  >
    <p><span class="ar">رَبِّ ٱجْعَلْ هَٰذَا بَلَدًا ءَامِنًۭا</span> (البقرة: ١٢٦)</p>
    <p><strong>الإعراب:</strong> ربِّ: منادى مضاف منصوب وعلامة نصبه الفتحة المقدرة على ما قبل ياء المتكلم المحذوفة، والياء المحذوفة في محل جر مضاف إليه. اجعلْ: فعل أمر دعائي، والفاعل ضمير مستتر وجوبًا تقديره أنت. هذا: الهاء حرف تنبيه، وذا اسم إشارة مبني على السكون في محل نصب مفعول به أول. بلدًا: مفعول به ثانٍ منصوب وعلامة نصبه الفتحة الظاهرة. آمنًا: نعت لبلدًا منصوب مثله وعلامة نصبه الفتحة الظاهرة.</p>
    <p>فاسم الإشارة معرفة، وقد صار بالجعل بلدًا آمنًا، وجاء النعت نكرة لأن منعوته نكرة. وتجد الإعراب الكامل للآية في <a href="/quran">إعراب القرآن</a>، والتطبيق على جملك في <a href="/irab">الإعراب</a>.</p>
  </ArticleSection>

