---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';

const faqs = [
  { q: 'ما الفرق بين تمييز الذات وتمييز النسبة؟', a: 'تمييز الذات يفسر اسمًا مبهمًا ملفوظًا قبله كالأعداد والمقادير، مثل: اشتريت صاعًا قمحًا. وتمييز النسبة يفسر إبهام الجملة كلها، مثل: طاب المجتهد نفسًا. ولذلك سُمي الأول ملفوظًا والثاني ملحوظًا.' },
  { q: 'هل يجوز جر التمييز؟', a: 'نعم في تمييز المقادير: يجوز النصب، والجر بمن، والجر بالإضافة، تقول: اشتريت صاعًا قمحًا، أو صاعًا من قمحٍ، أو صاعَ قمحٍ. أما تمييز النسبة المحول عن أصل فواجب النصب.' },
  { q: 'هل يكون التمييز معرفة أو جملة؟', a: 'التمييز لا يكون إلا اسمًا نكرة مفردًا عند البصريين، وما ورد ظاهره التعريف فمؤوَّل بنكرة. وهذا فرق جوهري بينه وبين الحال التي تقع جملة وشبه جملة.' },
  { q: 'هل يتقدم التمييز على عامله؟', a: 'مذهب البصريين المعتمد في المناهج أن التمييز لا يتقدم على عامله، وأجازه بعض النحاة إذا كان العامل فعلًا متصرفًا. والذي تسير عليه كتب المدارس هو المنع، فالزمه في الإجابات.' },
  { q: 'كيف أعرب تمييز العدد من ثلاثة إلى عشرة؟', a: 'يكون جمعًا مجرورًا ويعرب مضافًا إليه، مثل: قرأت ثلاثةَ كتبٍ، فكتبٍ مضاف إليه مجرور وعلامة جره الكسرة الظاهرة، وهو تمييز في المعنى مضاف إليه في اللفظ.' },
  { q: 'ما العلامة التي أعرف بها التمييز في الجملة؟', a: 'اسأل: من أيّ شيء؟ أو قدّر «من» قبل الاسم المنصوب، فإن استقام المعنى فهو تمييز: ازداد الطالب علمًا، أي من جهة العلم. فإن كان الاسم جوابًا عن «كيف؟» ويصور هيئة فهو حال لا تمييز.' },
];
---
<BaseLayout
  lang="ar"
  title="التمييز: تمييز الذات والنسبة وأحكام نصبه · إعراب"
  description="شرح التمييز في النحو العربي: تمييز الذات بعد العدد والمقادير، وتمييز النسبة المحول وغير المحول، وأحكام النصب والجر وتمييز العدد، مع أمثلة إعراب كاملة."
>
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    eyebrow="دروس النحو"
    title="التمييز"
    summary="التمييز اسم نكرة جامد منصوب يفسّر ما انبهم قبله من ذاتٍ أو نسبة، ويجيب عن السؤال: من أيّ شيء؟ قسّمه النحاة قسمين: تمييز الذات بعد الأعداد والمقادير، وتمييز النسبة المحوّل وغير المحوّل. في هذا الدرس ضبط القسمين، وأحكام النصب والجر، وتمييز العدد، مع أمثلة إعراب كاملة على المذهب المعتمد في المناهج."
  />

  <ArticleSection
    lang="ar"
    id="definition"
    title="ما التمييز؟"
    lead="التمييز اسم نكرة جامد فضلة يفسّر ما انبهم قبله، وهو على معنى «من». فإذا قلت: اشتريت صاعًا، بقي السامع ينتظر بيان المكيل، فإذا قلت: قمحًا، زال الإبهام واستقر المعنى."
  >
    <p>التمييز من المنصوبات في <a href="/nahw">النحو</a>، وقسمه النحاة قسمين: <strong>تمييز الذات</strong> ويسمى الملفوظ، لأن المميَّز اسم مبهم مذكور في اللفظ قبله، و<strong>تمييز النسبة</strong> ويسمى الملحوظ، لأن الإبهام في نسبة الجملة كلها لا في اسم بعينه.</p>
    <p><strong>المثال الأول كاملًا:</strong> <span class="ar">اِشْتَرَيْتُ صَاعًا قَمْحًا</span>: اشتريتُ فعل ماضٍ مبني على السكون لاتصاله بتاء الفاعل، والتاء ضمير متصل مبني على الضم في محل رفع فاعل، صاعًا مفعول به منصوب وعلامة نصبه الفتحة الظاهرة، قمحًا تمييز منصوب وعلامة نصبه الفتحة الظاهرة.</p>
    <p>ويشترط فيه عند البصريين أن يكون <strong>نكرة</strong> وأن يكون <strong>جامدًا</strong> في الغالب، وما ورد على خلاف ذلك مؤوَّل.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="tamyiz-al-dhat"
    title="تمييز الذات"
    lead="يقع تمييز الذات بعد المقادير: الكيل والوزن والمساحة، وبعد الأعداد، وبعد ما جرى مجرى المقادير. وسُمي ملفوظًا لأن الاسم المبهم الذي يفسره منطوق به قبله."
  >
    <ul>
      <li><strong>بعد الكيل:</strong> <span class="ar">اِشْتَرَيْتُ صَاعًا قَمْحًا</span>.</li>
      <li><strong>بعد الوزن:</strong> <span class="ar">بِعْتُ رِطْلًا زَيْتًا</span>.</li>
      <li><strong>بعد المساحة:</strong> <span class="ar">زَرَعْتُ فَدَّانًا قُطْنًا</span>.</li>
      <li><strong>بعد العدد:</strong> <span class="ar">قَرَأْتُ أَحَدَ عَشَرَ كِتَابًا</span>.</li>
    </ul>
    <p><strong>المثال الثاني كاملًا، من القرآن:</strong> قال تعالى: <span class="ar">﴿إِنِّي رَأَيْتُ أَحَدَ عَشَرَ كَوْكَبًا﴾</span> (يوسف: ٤): إنِّي مؤلفة من إنَّ حرف توكيد ونصب والياء ضمير متصل مبني في محل نصب اسم <a href="/duroos/inna-wa-akhawatuha">إنّ</a>، رأيتُ فعل ماضٍ مبني على السكون لاتصاله بتاء الفاعل والتاء ضمير متصل مبني على الضم في محل رفع فاعل والجملة الفعلية في محل رفع خبر إنّ، أحدَ عشرَ اسم عدد مبني على فتح الجزأين في محل نصب مفعول به، كوكبًا تمييز منصوب وعلامة نصبه الفتحة الظاهرة.</p>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">جرّب التمييز على جملك.</span>
    ألصق أي جملة فيها تمييز في المحلل على الصفحة الرئيسية، وشاهد الدرس يُطبَّق كلمة كلمة: نوع التمييز، وعامله، وعلامة نصبه، خلال ثوانٍ.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="tamyiz-al-nisba"
    title="تمييز النسبة"
    lead="تمييز النسبة يفسر إبهامًا في الجملة كلها لا في اسم مفرد قبله. وأكثره محوّل عن أصل: عن فاعل أو عن مفعول به أو عن مبتدأ، وغير المحوّل مسموع محفوظ مثل: لله درّه فارسًا."
  >
    <p><strong>المثال الثالث، محوّل عن فاعل:</strong> <span class="ar">طَابَ الْمُجْتَهِدُ نَفْسًا</span>: طابَ فعل ماضٍ مبني على الفتح، المجتهدُ فاعل مرفوع وعلامة رفعه الضمة الظاهرة، نفسًا تمييز منصوب وعلامة نصبه الفتحة الظاهرة، والأصل: طابت نفسُ المجتهدِ.</p>
    <p><strong>المثال الرابع، محوّل عن مفعول به:</strong> قال تعالى: <span class="ar">﴿وَفَجَّرْنَا الْأَرْضَ عُيُونًا﴾</span> (القمر: ١٢): الواو حرف عطف مبني على الفتح لا محل له من الإعراب، فجّرنا فعل ماضٍ مبني على السكون لاتصاله بـ«نا» و«نا» ضمير متصل مبني على السكون في محل رفع فاعل، الأرضَ مفعول به منصوب وعلامة نصبه الفتحة الظاهرة، عيونًا تمييز منصوب وعلامة نصبه الفتحة الظاهرة، والأصل: فجّرنا عيونَ الأرضِ.</p>
    <p><strong>المثال الخامس، محوّل عن مبتدأ:</strong> قال تعالى: <span class="ar">﴿أَنَا أَكْثَرُ مِنْكَ مَالًا﴾</span> (الكهف: ٣٤): أنا ضمير منفصل مبني على السكون في محل رفع مبتدأ، أكثرُ خبر مرفوع وعلامة رفعه الضمة الظاهرة، مِن حرف جر مبني على السكون والكاف ضمير متصل مبني على الفتح في محل جر بحرف الجر، مالًا تمييز منصوب وعلامة نصبه الفتحة الظاهرة، والأصل: مالي أكثرُ من مالِك.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="ahkam-al-nasb"
    title="أحكام نصب التمييز وجرّه"
    lead="الأصل في التمييز النصب. ويجوز في تمييز المقادير جرّه بمن أو بالإضافة، أما تمييز النسبة المحوّل فواجب النصب. ولا يتقدم التمييز على عامله عند البصريين."
  >
    <ul>
      <li><strong>النصب:</strong> <span class="ar">اِشْتَرَيْتُ صَاعًا قَمْحًا</span>.</li>
      <li><strong>الجر بمن:</strong> <span class="ar">اِشْتَرَيْتُ صَاعًا مِنْ قَمْحٍ</span>، فيصير الاسم مجرورًا بـ<a href="/duroos/huruf-al-jarr">حرف الجر</a> وهو تمييز في المعنى.</li>
      <li><strong>الجر بالإضافة:</strong> <span class="ar">اِشْتَرَيْتُ صَاعَ قَمْحٍ</span>، فيعرب مضافًا إليه، وتفصيله في درس <a href="/duroos/al-idafa">الإضافة</a>.</li>
    </ul>
    <p>وتمييز العدد أحكامه محفوظة: من ثلاثة إلى عشرة جمع مجرور، مثل <span class="ar">ثَلَاثَةُ أَقْلَامٍ</span>، ومن أحد عشر إلى تسعة وتسعين مفرد منصوب، مثل <span class="ar">أَحَدَ عَشَرَ كَوْكَبًا</span>، والمائة والألف ومضاعفاتهما مفرد مجرور، مثل <span class="ar">مِائَةُ رَجُلٍ</span>. فإذا جُرّ التمييز في هذه الصور فهو تمييز في المعنى، مضاف إليه في اللفظ والإعراب.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="tamyiz-vs-hal"
    title="التمييز والحال، كيف تفرق بينهما؟"
    lead="كلاهما نكرة منصوبة فضلة تجيء بعد تمام الجملة، ولذلك يلتبسان على الطلاب. والميزان: الحال جواب «كيف؟» وهي مشتقة غالبًا، والتمييز جواب «من أيّ شيء؟» وهو جامد غالبًا."
  >
    <p>قارن: <span class="ar">جَاءَ الطَّالِبُ مُسْرِعًا</span>، فمسرعًا <a href="/duroos/al-hal">حال</a> تبين الهيئة. و<span class="ar">اِزْدَادَ الطَّالِبُ عِلْمًا</span>، فعلمًا تمييز يبين جهة الازدياد، والأصل: ازداد علمُ الطالبِ.</p>
    <p><strong>المثال السادس، غير محوّل:</strong> <span class="ar">لِلَّهِ دَرُّهُ فَارِسًا</span>: اللام حرف جر ولفظ الجلالة اسم مجرور وعلامة جره الكسرة الظاهرة والجار والمجرور متعلقان بمحذوف خبر مقدم، درُّ مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة وهو مضاف والهاء ضمير متصل مبني في محل جر مضاف إليه، فارسًا تمييز منصوب وعلامة نصبه الفتحة الظاهرة.</p>
    <p>وإذا أشكل عليك اسم منصوب بعد تمام الكلام فقدّر «من» قبله، فإن استقامت فهو تمييز، وإلا فاعرض الجملة على منهج <a href="/irab">الإعراب</a> الكامل: العامل، ثم العمدة، ثم الفضلات.</p>
  </ArticleSection>

  <ArticleFaq lang="ar" items={faqs} />

  <Footer lang="ar" />
</BaseLayout>
