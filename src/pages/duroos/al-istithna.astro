---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';

const faqs = [
  { q: 'ما أركان جملة الاستثناء؟', a: 'ثلاثة: المستثنى منه وهو العام المذكور قبل الأداة، وأداة الاستثناء مثل إلا وغير وسوى وعدا وخلا وحاشا، والمستثنى وهو الخارج من الحكم. في "حضر الطلابُ إلا زيدًا": الطلاب مستثنى منه، وإلا أداة، وزيدًا مستثنى.' },
  { q: 'ما معنى الكلام التام والمفرغ؟', a: 'التام ما ذكر فيه المستثنى منه، فإن كان مثبتًا وجب نصب المستثنى، وإن كان منفيًّا جاز النصب والبدلية. والمفرغ ما حذف منه المستثنى منه، فيعرب ما بعد إلا بحسب موقعه في الجملة كأن إلا غير موجودة.' },
  { q: 'كيف يعرب الاسم بعد غير وسوى؟', a: 'مضاف إليه مجرور دائمًا. وتأخذ غير وسوى نفسهما حكم الاسم الواقع بعد إلا: تنصبان في التام المثبت (حضر الطلابُ غيرَ زيدٍ)، ويجوز فيهما النصب والبدلية في التام المنفي، وتعربان بحسب الموقع في المفرغ (ما حضر غيرُ زيدٍ: فاعل).' },
  { q: 'كيف يعرب ما بعد عدا وخلا وحاشا؟', a: 'وجهان: إن أعربتها أفعالًا ماضية نصبت ما بعدها مفعولًا به (حضر الطلابُ عدا زيدًا)، وإن أعربتها حروف جر جررت ما بعدها (عدا زيدٍ). فإن سبقت بما المصدرية وجب كونها أفعالًا والنصب: ما عدا زيدًا.' },
  { q: 'لماذا يرتفع ما بعد إلا في مثل: ما جاء إلا زيدٌ؟', a: 'لأنه استثناء مفرغ: حذف المستثنى منه فأخذ ما بعد إلا موقعه الإعرابي، وهو هنا الفاعل. فإلا في المفرغ أداة حصر لا عمل لها، والجملة في قوة: ما جاء أحدٌ غيرُ زيدٍ.' },
  { q: 'ما إعراب: لا إله إلا الله؟', a: 'لا نافية للجنس، وإله اسمها مبني على الفتح في محل نصب، وخبرها محذوف تقديره حقٌّ أو موجودٌ، ولفظ الجلالة بدل من محل لا واسمها مرفوع. فالاستثناء هنا مفرغ في المعنى: لا معبود بحق إلا الله.' },
];
---
<BaseLayout
  lang="ar"
  title="الاستثناء: أدواته وأحكام المستثنى الثلاثة · إعراب"
  description="شرح الاستثناء: أركانه وأدواته، وجوب النصب في التام المثبت، جواز البدلية في المنفي، الإعراب بحسب الموقع في المفرغ، وأحكام غير وسوى وعدا، مع أمثلة قرآنية معربة."
>
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="الاستثناء"
    summary="الاستثناء إخراج ما بعد الأداة من حكم ما قبلها. ومداره على قاعدة واحدة بثلاث حالات: النصب في الكلام التام المثبت، وجواز النصب والبدلية في التام المنفي، والإعراب على حسب الموقع في المفرغ. هذا الدرس يضبط الحالات الثلاث وأحكام غير وسوى وعدا، بأمثلة قرآنية معربة."
  />

  <ArticleSection
    lang="ar"
    id="definition"
    title="الأركان والأدوات"
    lead="أركان الاستثناء ثلاثة: مستثنى منه، وأداة، ومستثنى. والأدوات: إلا الحرف، وغير وسوى الاسمان، وعدا وخلا وحاشا المترددة بين الفعلية والحرفية."
  >
    <p><span class="ar">حَضَرَ الطُّلَّابُ إِلَّا زَيْدًا</span></p>
    <p><strong>الإعراب:</strong> حضرَ فعل ماضٍ مبني على الفتح. الطلابُ <a href="/duroos/al-fail">فاعل</a> مرفوع وعلامة رفعه الضمة الظاهرة، وهو المستثنى منه. إلا حرف استثناء مبني على السكون لا محل له من الإعراب. زيدًا مستثنى بإلا منصوب وعلامة نصبه الفتحة الظاهرة.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="three-cases"
    title="حالات المستثنى بإلا الثلاث"
    lead="انظر إلى الكلام قبل إلا: تام مثبت فالنصب واجب، تام منفي فالبدلية أرجح والنصب جائز، مفرغ من المستثنى منه فأعرب ما بعد إلا بحسب موقعه."
  >
    <ul>
      <li><strong>تام مثبت، النصب واجب:</strong> <span class="ar">﴿فَشَرِبُوا مِنْهُ إِلَّا قَلِيلًا مِنْهُمْ﴾</span>: قليلًا مستثنى منصوب وعلامة نصبه الفتحة الظاهرة.</li>
      <li><strong>تام منفي، البدلية أو النصب:</strong> <span class="ar">مَا حَضَرَ الطُّلَّابُ إِلَّا زَيْدٌ</span> على <a href="/duroos/al-badal">البدلية</a> من الفاعل، ويجوز: إلا زيدًا على الاستثناء.</li>
      <li><strong>مفرغ، بحسب الموقع:</strong> <span class="ar">﴿وَمَا مُحَمَّدٌ إِلَّا رَسُولٌ﴾</span>: ما نافية، محمدٌ مبتدأ مرفوع، إلا أداة حصر لا عمل لها، رسولٌ خبر <a href="/duroos/al-mubtada-wal-khabar">المبتدأ</a> مرفوع.</li>
    </ul>
    <p>ومثال المفرغ مع الفاعل: <span class="ar">مَا نَجَحَ إِلَّا الْمُجْتَهِدُ</span>: المجتهدُ فاعل مرفوع، كأن إلا غير موجودة مع بقاء معنى الحصر.</p>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">تام أم مفرغ؟ جرّب.</span>
    ألصق جملة استثناء في محلّل الإعراب وشاهده يحدد الحالة من الثلاث ويعلل نصب المستثنى أو رفعه.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="ghayr-siwa"
    title="غير وسوى"
    lead="غير وسوى اسمان يجران ما بعدهما بالإضافة، ويأخذان هما حكم المستثنى بإلا في الحالات الثلاث."
  >
    <ul>
      <li><strong>تام مثبت:</strong> <span class="ar">حَضَرَ الطُّلَّابُ غَيْرَ زَيْدٍ</span>: غيرَ مستثنى منصوب وهو مضاف، وزيدٍ مضاف إليه مجرور، وأحكام <a href="/duroos/al-idafa">الإضافة</a> في درسها.</li>
      <li><strong>تام منفي:</strong> <span class="ar">مَا حَضَرَ الطُّلَّابُ غَيْرُ زَيْدٍ</span> بالرفع على البدلية، أو غيرَ بالنصب.</li>
      <li><strong>مفرغ:</strong> <span class="ar">مَا نَجَحَ غَيْرُ الْمُجْتَهِدِ</span>: غيرُ فاعل مرفوع وهو مضاف.</li>
    </ul>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="ada-khala"
    title="عدا وخلا وحاشا"
    lead="يجوز فيها وجهان: أفعال ماضية تنصب ما بعدها مفعولًا به، أو حروف جر تجر ما بعدها. فإن تقدمتها ما المصدرية تعينت الفعلية والنصب."
  >
    <ul>
      <li><span class="ar">حَضَرَ الطُّلَّابُ عَدَا زَيْدًا</span>: عدا فعل ماضٍ وفاعله ضمير مستتر، وزيدًا مفعول به منصوب. ويجوز: <span class="ar">عَدَا زَيْدٍ</span> على أن عدا حرف جر، وراجع <a href="/duroos/huruf-al-jarr">حروف الجر</a>.</li>
      <li><span class="ar">حَضَرَ الطُّلَّابُ مَا عَدَا زَيْدًا</span>: وجب النصب لأن ما المصدرية لا تدخل إلا على الأفعال.</li>
    </ul>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="common-mistakes"
    title="أخطاء شائعة"
    lead="أشيع أخطاء الباب نصب المستثنى في المفرغ، ورفع ما بعد غير، وإغفال أثر النفي في الحكم."
  >
    <ul>
      <li>يقال خطأً "ما جاء إلا زيدًا" في المفرغ، والصواب <span class="ar">إِلَّا زَيْدٌ</span> بالرفع على الفاعلية.</li>
      <li>ما بعد غير وسوى مجرور دائمًا بالإضافة، فلا يقال "غيرَ زيدٌ".</li>
      <li>الحكم يتغير بالنفي: <span class="ar">حَضَرُوا إِلَّا زَيْدًا</span> نصب واجب، و<span class="ar">مَا حَضَرُوا إِلَّا زَيْدٌ</span> بدل أرجح.</li>
    </ul>
    <p>ويجاور هذا البابَ في الأساليب <a href="/duroos/al-munada">المنادى</a>، والنفي بلا في <a href="/duroos/la-nafiya-lil-jins">لا النافية للجنس</a>، والأصل في <a href="/nahw">ما هو النحو</a>.</p>
  </ArticleSection>

  <ArticleFaq lang="ar" items={faqs} />

  <Footer lang="ar" />
</BaseLayout>
