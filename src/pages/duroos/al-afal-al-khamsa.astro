---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';

const faqs = [
  { q: 'لماذا سميت الأفعال الخمسة بهذا الاسم؟', a: 'لأنها تأتي على خمس صيغ من الفعل المضارع: يفعلانِ وتفعلانِ بألف الاثنين، ويفعلونَ وتفعلونَ بواو الجماعة، وتفعلينَ بياء المخاطبة. خمسة أوزان لا خمسة أفعال بعينها، فكل مضارع اتصل بأحد هذه الضمائر صار منها.' },
  { q: 'ما علامة رفع الأفعال الخمسة؟', a: 'ثبوت النون. نحو: الطالبانِ يكتبانِ، يكتبانِ فعل مضارع مرفوع وعلامة رفعه ثبوت النون لأنه من الأفعال الخمسة، وألف الاثنين ضمير متصل مبني في محل رفع فاعل.' },
  { q: 'ما علامة نصبها وجزمها؟', a: 'حذف النون في الحالين. النصب: لن يكتبَا، والجزم: لم يكتبَا. لذلك لا يفرق بين نصبها وجزمها بالعلامة وإنما بالأداة الداخلة عليها.' },
  { q: 'هل نون "يفعلن" لجمع الإناث من الأفعال الخمسة؟', a: 'لا، وهذا من أشيع الأخطاء. نون النسوة في "يكتبْنَ" ضمير رفع فاعل والفعل معها مبني على السكون لا معرب، أما نون الأفعال الخمسة فعلامة إعراب تثبت وتحذف.' },
  { q: 'كيف نفرق بين نون الأفعال الخمسة ونون التوكيد؟', a: 'نون الأفعال الخمسة يسبقها ألف اثنين أو واو جماعة أو ياء مخاطبة وتكون مكسورة بعد الألف مفتوحة بعد الواو والياء، ونون التوكيد ثقيلة مشددة أو خفيفة ساكنة تلحق آخر الفعل لتوكيده نحو "لَيُكْتَبَنَّ".' },
  { q: 'ماذا يحدث للأفعال الخمسة مع أدوات الشرط؟', a: 'تجزم بحذف النون لأن أدوات الشرط الجازمة تجزم المضارع. نحو: إن تدرسا تنجحا، فعل الشرط وجوابه كلاهما مجزوم وعلامة جزمه حذف النون.' },
];
---
<BaseLayout
  lang="ar"
  title="الأفعال الخمسة: ثبوت النون وحذفها بالأمثلة · إعراب"
  description="شرح الأفعال الخمسة: صيغها الخمس، رفعها بثبوت النون ونصبها وجزمها بحذفها، والفرق بينها وبين نون النسوة ونون التوكيد، مع أمثلة قرآنية معربة إعرابًا كاملًا."
>
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    eyebrow="دروس النحو"
    title="الأفعال الخمسة"
    summary="الأفعال الخمسة كل فعل مضارع اتصلت به ألف الاثنين أو واو الجماعة أو ياء المخاطبة. تخالف سائر الأفعال في علاماتها: ترفع بثبوت النون وتنصب وتجزم بحذفها. هذا الدرس يعرض صيغها الخمس وإعرابها، ويحسم الالتباس الشائع بينها وبين نون النسوة ونون التوكيد."
  />

  <ArticleSection
    lang="ar"
    id="definition"
    title="التعريف والصيغ الخمس"
    lead="الأفعال الخمسة أوزان لا أفعال بأعيانها: كل مضارع أُسند إلى ألف الاثنين أو واو الجماعة أو ياء المخاطبة صار منها."
  >
    <ul>
      <li><span class="ar">يَفْعَلَانِ</span>: للغائبَينِ، نحو <span class="ar">الطَّالِبَانِ يَدْرُسَانِ</span>.</li>
      <li><span class="ar">تَفْعَلَانِ</span>: للمخاطبَينِ، نحو <span class="ar">أَنْتُمَا تَدْرُسَانِ</span>.</li>
      <li><span class="ar">يَفْعَلُونَ</span>: للغائبِينَ، نحو <span class="ar">الطُّلَّابُ يَدْرُسُونَ</span>.</li>
      <li><span class="ar">تَفْعَلُونَ</span>: للمخاطبِينَ، نحو <span class="ar">أَنْتُمْ تَدْرُسُونَ</span>.</li>
      <li><span class="ar">تَفْعَلِينَ</span>: للمخاطبة، نحو <span class="ar">أَنْتِ تَدْرُسِينَ</span>.</li>
    </ul>
    <p>والضمير المتصل في كل صيغة هو الفاعل: الألف أو الواو أو الياء ضمير متصل مبني في محل رفع <a href="/duroos/al-fail">فاعل</a>.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="raf"
    title="الرفع بثبوت النون"
    lead="إذا لم يسبق الأفعال الخمسة ناصب ولا جازم رفعت، وعلامة رفعها ثبوت النون، وهي من العلامات الفرعية التي تنوب عن الضمة."
  >
    <p><span class="ar">الطَّالِبَانِ يَكْتُبَانِ الدَّرْسَ</span></p>
    <p><strong>الإعراب:</strong> الطالبانِ مبتدأ مرفوع وعلامة رفعه الألف لأنه مثنى. يكتبانِ: فعل مضارع مرفوع وعلامة رفعه ثبوت النون لأنه من الأفعال الخمسة، وألف الاثنين ضمير متصل مبني في محل رفع فاعل، والجملة الفعلية في محل رفع خبر المبتدأ. الدرسَ: مفعول به منصوب وعلامة نصبه الفتحة الظاهرة. وبناء هذه الجملة كلها مشروح في درس <a href="/duroos/al-mubtada-wal-khabar">المبتدأ والخبر</a>.</p>
    <p>مثال قرآني: <span class="ar">﴿وَالْوَالِدَاتُ يُرْضِعْنَ أَوْلَادَهُنَّ﴾</span> ليست منها لأن النون نون النسوة، بينما <span class="ar">﴿يُؤْمِنُونَ بِالْغَيْبِ﴾</span> منها: يؤمنون فعل مضارع مرفوع وعلامة رفعه ثبوت النون، وواو الجماعة فاعل.</p>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">اختبر النون بنفسك.</span>
    ألصق أي جملة فيها فعل من الأفعال الخمسة في محلّل الإعراب، وشاهده يعلل ثبوت النون أو حذفها مع تحديد الأداة العاملة.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="nasb-jazm"
    title="النصب والجزم بحذف النون"
    lead="تنصب الأفعال الخمسة بعد أدوات النصب وتجزم بعد أدوات الجزم، وعلامتها واحدة في الحالين: حذف النون. فالتمييز بينهما بالأداة لا بالعلامة."
  >
    <p><strong>النصب:</strong> <span class="ar">لَنْ يَكْتُبَا</span>، لن حرف نفي ونصب واستقبال، يكتبا فعل مضارع منصوب بلن وعلامة نصبه حذف النون لأنه من الأفعال الخمسة، والألف فاعل. وسائر النواصب في درس <a href="/duroos/nasb-al-mudari">نصب المضارع</a>.</p>
    <p><strong>الجزم:</strong> <span class="ar">لَمْ يَكْتُبُوا</span>، لم حرف نفي وجزم وقلب، يكتبوا فعل مضارع مجزوم بلم وعلامة جزمه حذف النون، وواو الجماعة فاعل. وسائر الجوازم في درس <a href="/duroos/jazm-al-mudari">جزم المضارع</a>.</p>
    <p>مثال قرآني للنصب: <span class="ar">﴿وَلَنْ تَفْعَلُوا﴾</span>، وللجزم: <span class="ar">﴿فَإِنْ لَمْ تَفْعَلُوا وَلَنْ تَفْعَلُوا فَاتَّقُوا النَّارَ﴾</span> جمعت الآية الجزم بلم والنصب بلن على الفعل نفسه.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="common-mistakes"
    title="أخطاء شائعة"
    lead="مدار الخطأ في هذا الباب على ثلاث نونات متشابهات في الصورة مختلفات في الحكم: نون الأفعال الخمسة، ونون النسوة، ونون التوكيد."
  >
    <ul>
      <li><strong>نون النسوة ليست منها:</strong> <span class="ar">الطَّالِبَاتُ يَكْتُبْنَ</span>، يكتبْنَ فعل مضارع مبني على السكون لاتصاله بنون النسوة، والنون ضمير متصل مبني في محل رفع فاعل. فعل مبني لا معرب أصلًا.</li>
      <li><strong>إثبات النون بعد الناصب أو الجازم:</strong> يقال خطأً "لم يكتبونَ" والصواب <span class="ar">لَمْ يَكْتُبُوا</span> بحذف النون.</li>
      <li><strong>حذف النون بلا عامل:</strong> يقال خطأً "الطلاب يكتبوا" والصواب <span class="ar">الطُّلَّابُ يَكْتُبُونَ</span> بثبوت النون إذ لا ناصب ولا جازم.</li>
    </ul>
    <p>ونظير هذا الباب في الأسماء درس <a href="/duroos/al-asma-al-khamsa">الأسماء الخمسة</a>، وكلاهما فرع عن <a href="/duroos/alamat-al-irab">علامات الإعراب</a> الفرعية، والإطار الكامل في <a href="/irab">ما هو الإعراب</a>.</p>
  </ArticleSection>

  <ArticleFaq lang="ar" items={faqs} />

  <Footer lang="ar" />
</BaseLayout>
