---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';

const faqs = [
  { q: 'ما الفرق بين المفعول المطلق والمفعول به؟', a: 'المفعول به اسم وقع عليه فعل الفاعل وهو غير مشتق من لفظ الفعل غالبًا، أما المفعول المطلق فمصدر من لفظ الفعل نفسه يؤكد الفعل أو يبين نوعه أو عدده. في "قرأتُ الكتابَ قراءةً متأنيةً": الكتابَ مفعول به، وقراءةً مفعول مطلق.' },
  { q: 'لماذا سمي مطلقًا؟', a: 'لأنه غير مقيد بحرف جر ولا ظرفية ولا غيرها، فهو مفعول على الإطلاق: صدق عليه اسم المفعول دون قيد، بخلاف المفعول به والمفعول فيه والمفعول لأجله المقيدة بقيود في التسمية.' },
  { q: 'ما الذي ينوب عن المصدر في المفعول المطلق؟', a: 'ينوب عنه: صفته (سرتُ أحسنَ السيرِ)، وعدده (ضربتُه ثلاثَ ضرباتٍ)، ونوعه، وكل وبعض مضافتين إلى المصدر (فرحتُ كلَّ الفرحِ)، والإشارة إليه، ومرادفه، وآلته (ضربتُه سوطًا).' },
  { q: 'هل يحذف عامل المفعول المطلق؟', a: 'نعم، ويكثر ذلك في مصادر سماعية جرت مجرى الأمثال: صبرًا (أي اصبر صبرًا)، شكرًا، سمعًا وطاعةً، سبحانَ الله. فالمصدر فيها مفعول مطلق لفعل محذوف وجوبًا.' },
  { q: 'ما أنواع المفعول المطلق الثلاثة؟', a: 'مؤكد للفعل نحو "حفظتُ الدرسَ حفظًا"، ومبين للنوع نحو "سرتُ سيرَ العقلاءِ"، ومبين للعدد نحو "دُرْتُ حولَ الملعبِ دورتين". والمؤكد للفعل لا يثنى ولا يجمع.' },
  { q: 'ما إعراب "سبحان" في سبحان الله؟', a: 'مفعول مطلق منصوب وعلامة نصبه الفتحة الظاهرة لفعل محذوف وجوبًا تقديره أسبح، وهو مضاف، ولفظ الجلالة مضاف إليه مجرور. وهو من المصادر الملازمة للنصب على المصدرية.' },
];
---
<BaseLayout
  lang="ar"
  title="المفعول المطلق: أنواعه وما ينوب عنه · إعراب"
  description="شرح المفعول المطلق: تعريفه، أنواعه الثلاثة المؤكد والمبين للنوع والعدد، ما ينوب عن المصدر، وحذف عامله في مثل سبحان وصبرًا، مع أمثلة قرآنية معربة إعرابًا كاملًا."
>
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="المفعول المطلق"
    summary="المفعول المطلق مصدر منصوب من لفظ الفعل يذكر معه ليؤكده أو يبين نوعه أو عدده. هو أقرب المنصوبات إلى الفعل لأنه ابنه من جهة الاشتقاق، ولذلك سماه النحاة المفعول الحق. هذا الدرس يعرض أنواعه الثلاثة وما ينوب عن مصدره وحذف عامله، بأمثلة معربة كاملة."
  />

  <ArticleSection
    lang="ar"
    id="definition"
    title="التعريف"
    lead="المفعول المطلق مصدر فضلة منصوب، مشتق من لفظ الفعل العامل فيه أو من معناه، يذكر لتوكيد الفعل أو بيان نوعه أو عدده."
  >
    <p><span class="ar">حَفِظْتُ الدَّرْسَ حِفْظًا</span></p>
    <p><strong>الإعراب:</strong> حفظتُ فعل ماضٍ مبني على السكون لاتصاله بتاء الفاعل، والتاء ضمير متصل مبني في محل رفع فاعل. الدرسَ <a href="/duroos/al-maful-bih">مفعول به</a> منصوب وعلامة نصبه الفتحة الظاهرة. حفظًا مفعول مطلق منصوب وعلامة نصبه الفتحة الظاهرة.</p>
    <p>مثال قرآني: <span class="ar">﴿وَكَلَّمَ اللَّهُ مُوسَى تَكْلِيمًا﴾</span>: تكليمًا مفعول مطلق منصوب مؤكد للفعل، وفائدته هنا رفع احتمال المجاز: كلمه حقيقةً.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="types"
    title="أنواعه الثلاثة"
    lead="المفعول المطلق مؤكد للفعل، أو مبين للنوع، أو مبين للعدد. والمؤكد للفعل مفرد دائمًا لا يثنى ولا يجمع."
  >
    <ul>
      <li><strong>مؤكد للفعل:</strong> <span class="ar">﴿فَاصْبِرْ صَبْرًا جَمِيلًا﴾</span>، صبرًا مفعول مطلق منصوب، وجميلًا <a href="/duroos/al-naat">نعت</a> منصوب مثله.</li>
      <li><strong>مبين للنوع:</strong> <span class="ar">سِرْتُ سَيْرَ الْعُقَلَاءِ</span>، سيرَ مفعول مطلق منصوب وهو مضاف، والعقلاءِ مضاف إليه مجرور، وبيان النوع جاء من <a href="/duroos/al-idafa">الإضافة</a>.</li>
      <li><strong>مبين للعدد:</strong> <span class="ar">دُرْتُ حَوْلَ الْمَلْعَبِ دَوْرَتَيْنِ</span>، دورتين مفعول مطلق منصوب وعلامة نصبه الياء لأنه مثنى.</li>
    </ul>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">أكّد فعلك بمصدره.</span>
    ألصق جملة فيها مفعول مطلق في محلّل الإعراب وشاهده يميز المصدر المؤكد من المبين للنوع أو العدد، مع إعراب كل كلمة.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="substitutes"
    title="ما ينوب عن المصدر"
    lead="قد ينصب على المصدرية ما ليس مصدرًا صريحًا لكنه يدل عليه: صفته، وعدده، وكل وبعض مضافتين إليه، واسم الإشارة، والآلة، والمرادف."
  >
    <ul>
      <li><strong>صفة المصدر:</strong> <span class="ar">سِرْتُ أَحْسَنَ السَّيْرِ</span>، أحسنَ نائب عن المفعول المطلق منصوب وهو مضاف.</li>
      <li><strong>العدد:</strong> <span class="ar">ضَرَبْتُهُ ثَلَاثَ ضَرَبَاتٍ</span>، ثلاثَ نائب عن المفعول المطلق منصوب، وضرباتٍ مضاف إليه مجرور.</li>
      <li><strong>كل وبعض:</strong> <span class="ar">فَرِحْتُ كُلَّ الْفَرَحِ</span>، كلَّ نائب عن المفعول المطلق منصوب وهو مضاف.</li>
      <li><strong>الآلة:</strong> <span class="ar">ضَرَبْتُهُ سَوْطًا</span>، أي ضربَ سوطٍ.</li>
    </ul>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="hidden-verb"
    title="حذف عامل المفعول المطلق"
    lead="تحذف العرب الفعل وتبقي مصدره في مواضع كثر دورانها حتى جرت مجرى الأمثال، فيعرب المصدر مفعولًا مطلقًا لفعل محذوف."
  >
    <ul>
      <li><span class="ar">صَبْرًا يَا نَفْسُ</span>: صبرًا مفعول مطلق منصوب لفعل محذوف تقديره اصبري، ويا نفسُ نداء يأتي بيانه في درس <a href="/duroos/al-munada">المنادى</a>.</li>
      <li><span class="ar">شُكْرًا لَكَ</span>: شكرًا مفعول مطلق لفعل محذوف تقديره أشكرُ.</li>
      <li><span class="ar">سُبْحَانَ اللَّهِ</span>: سبحانَ مفعول مطلق منصوب لفعل محذوف وجوبًا وهو مضاف، ولفظ الجلالة مضاف إليه مجرور. ومنه قوله تعالى: <span class="ar">﴿سُبْحَانَ الَّذِي أَسْرَى بِعَبْدِهِ﴾</span>.</li>
    </ul>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="common-mistakes"
    title="أخطاء شائعة"
    lead="أشيع أخطاء الباب الخلط بينه وبين المفعول به، ورفع المصدر على أنه فاعل أو مبتدأ، وإغفال النائب عن المصدر."
  >
    <ul>
      <li>في <span class="ar">قَرَأْتُ الْكِتَابَ قِرَاءَةً</span> ليس "قراءةً" مفعولًا به ثانيًا بل مفعول مطلق، فالفعل قرأ لا ينصب مفعولين.</li>
      <li>يقال خطأً "حفظتُ الدرسَ حفظٌ" بالرفع، والصواب <span class="ar">حِفْظًا</span> بالنصب، فالمصدر هنا فضلة منصوبة لا مبتدأ.</li>
      <li>المصدر المجرور بحرف ليس مفعولًا مطلقًا: في "قرأتُ بتأنٍّ" الجار والمجرور متعلقان بالفعل، وراجع <a href="/duroos/huruf-al-jarr">حروف الجر</a>.</li>
    </ul>
    <p>وأخوا هذا الباب في المفاعيل: <a href="/duroos/al-maful-li-ajlih">المفعول لأجله</a> و<a href="/duroos/al-maful-fih">المفعول فيه</a>، والإطار كله في <a href="/irab">ما هو الإعراب</a>.</p>
  </ArticleSection>

  <ArticleFaq lang="ar" items={faqs} />

  <Footer lang="ar" />
</BaseLayout>
