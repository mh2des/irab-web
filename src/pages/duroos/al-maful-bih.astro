---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import Byline from '../../components/Byline.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';
import AyatExamples from '../../components/duroos/AyatExamples.astro';

const faqs = [
  { q: 'ما الفرق بين المفعول به ونائب الفاعل؟', a: 'المفعول به منصوب يقع عليه فعل الفاعل في الجملة المبنية للمعلوم. فإذا بُني الفعل للمجهول وحُذف الفاعل، ارتفع المفعول به وصار نائب فاعل. في "كَتَبَ الطالبُ الدرسَ" الدرسَ مفعول به منصوب، وفي "كُتِبَ الدرسُ" الدرسُ نائب فاعل مرفوع.' },
  { q: 'هل يتقدم المفعول به على الفاعل؟', a: 'نعم، جائز في مواضع وواجب في أخرى. يجب تقديمه إذا كان ضميرًا متصلًا بالفعل والفاعل اسمًا ظاهرًا نحو "أكرمني المعلمُ"، أو إذا اتصل بالفاعل ضمير يعود على المفعول نحو "أكرمَ المعلمَ تلميذُه".' },
  { q: 'هل يتعدد المفعول به في الجملة؟', a: 'نعم، أفعال تنصب مفعولين: أفعال الظن واليقين نحو "ظننتُ الخبرَ صحيحًا"، وأفعال التحويل والعطاء نحو "أعطى المعلمُ الطالبَ جائزةً". وهناك ما ينصب ثلاثة مفاعيل مثل "أعلمَ" و"أرى".' },
  { q: 'كيف يُنصب المفعول به إذا كان مثنى أو جمعًا؟', a: 'المثنى ينصب بالياء نحو "قرأتُ كتابَيْنِ"، وجمع المذكر السالم بالياء نحو "كافأتُ المجتهدِينَ"، وجمع المؤنث السالم بالكسرة نيابة عن الفتحة نحو "شكرتُ المعلماتِ"، وجمع التكسير بالفتحة نحو "قرأتُ الكتبَ".' },
  { q: 'هل يحذف المفعول به من الجملة؟', a: 'نعم، يحذف إذا دل عليه دليل أو قصد الاختصار أو العموم، نحو قوله تعالى: ﴿وَاللَّهُ يَدْعُو إِلَى دَارِ السَّلَامِ﴾ أي يدعو الناسَ جميعًا. والفعل اللازم أصلًا لا مفعول له.' },
  { q: 'ما إعراب الجملة إذا وقعت مفعولًا به؟', a: 'تقع الجملة مفعولًا به بعد أفعال القول ونحوها، فتكون في محل نصب. نحو: "قالَ الطالبُ: الدرسُ سهلٌ"، فجملة "الدرسُ سهلٌ" مقول القول في محل نصب مفعول به.' },
];
---
<BaseLayout
  lang="ar"
  title="المفعول به: علامات نصبه وأحكامه بالأمثلة · إعراب آب"
  description="شرح المفعول به: تعريفه، علامات نصبه بالفتحة والياء والكسرة، تقديمه وتأخيره، تعدده، وأمثلة معربة إعرابًا كاملًا من القرآن والنصوص الفصيحة."
>
  <ArticleSchema slot="head" lang="ar" kind="lesson" headline="المفعول به" description="شرح المفعول به: تعريفه، علامات نصبه بالفتحة والياء والكسرة، تقديمه وتأخيره، تعدده، وأمثلة معربة إعرابًا كاملًا من القرآن والنصوص الفصيحة." />
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="المفعول به"
    summary="المفعول به اسم منصوب يقع عليه فعل الفاعل، وهو أشهر المنصوبات وأكثرها دورانًا في الكلام. هذا الدرس يشرح تعريفه وعلامات نصبه الأصلية والفرعية، ومتى يتقدم على الفاعل أو يتعدد أو يحذف، مع أمثلة معربة إعرابًا كاملًا كما تكتب في كتب النحو."
  />
  <Byline lang="ar" kind="lesson" />

  <ArticleSection
    lang="ar"
    id="definition"
    title="التعريف"
    lead="المفعول به اسم منصوب يدل على من وقع عليه فعل الفاعل، ولا يغير الفعل صورته لأجله. يأتي بعد الفعل والفاعل في الترتيب الأصلي للجملة الفعلية، اسمًا ظاهرًا أو ضميرًا أو مصدرًا مؤولًا."
  >
    <p>خذ المثال الأشهر: <span class="ar">كَتَبَ الطَّالِبُ الدَّرْسَ</span>. وقع فعل الكتابة من الطالب على الدرس، فالدرس هو المفعول به.</p>
    <p><strong>الإعراب الكامل:</strong> <span class="ar">كَتَبَ</span>: فعل ماضٍ مبني على الفتح. <span class="ar">الطَّالِبُ</span>: فاعل مرفوع وعلامة رفعه الضمة الظاهرة. <span class="ar">الدَّرْسَ</span>: مفعول به منصوب وعلامة نصبه الفتحة الظاهرة.</p>
    <p>ويأتي المفعول به ضميرًا متصلًا نحو <span class="ar">أَكْرَمَكَ الْمُعَلِّمُ</span>: الكاف ضمير متصل مبني على الفتح في محل نصب مفعول به. ومصدرًا مؤولًا نحو <span class="ar">أُحِبُّ أَنْ أَقْرَأَ</span>: المصدر المؤول من "أنْ والفعل" في محل نصب مفعول به، والتقدير: أحبُّ القراءةَ. وهذا الباب فرع عن <a href="/duroos/al-jumla-al-filiyya">الجملة الفعلية</a> بأكملها.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="signs"
    title="علامات نصب المفعول به"
    lead="علامة النصب الأصلية الفتحة، وينوب عنها الياء في المثنى وجمع المذكر السالم، والكسرة في جمع المؤنث السالم، والألف في الأسماء الخمسة، وحذف النون في الأفعال الخمسة لا يدخل هنا لأنه خاص بالأفعال."
  >
    <ul>
      <li><strong>الفتحة الظاهرة:</strong> <span class="ar">قَرَأْتُ الْكِتَابَ</span>، الكتابَ مفعول به منصوب وعلامة نصبه الفتحة الظاهرة.</li>
      <li><strong>الفتحة المقدرة:</strong> <span class="ar">سَمِعْتُ الْفَتَى</span>، الفتى مفعول به منصوب وعلامة نصبه الفتحة المقدرة على الألف منع من ظهورها التعذر.</li>
      <li><strong>الياء في المثنى:</strong> <span class="ar">قَرَأْتُ كِتَابَيْنِ</span>، كتابين مفعول به منصوب وعلامة نصبه الياء لأنه مثنى.</li>
      <li><strong>الياء في جمع المذكر السالم:</strong> <span class="ar">كَافَأَتِ الْمَدْرَسَةُ الْمُجْتَهِدِينَ</span>، المجتهدين مفعول به منصوب وعلامة نصبه الياء لأنه جمع مذكر سالم.</li>
      <li><strong>الكسرة نيابة عن الفتحة:</strong> <span class="ar">شَكَرْتُ الْمُعَلِّمَاتِ</span>، المعلماتِ مفعول به منصوب وعلامة نصبه الكسرة لأنه جمع مؤنث سالم.</li>
      <li><strong>الألف في الأسماء الخمسة:</strong> <span class="ar">رَأَيْتُ أَبَاكَ</span>، أبا مفعول به منصوب وعلامة نصبه الألف لأنه من <a href="/duroos/al-asma-al-khamsa">الأسماء الخمسة</a>، والكاف ضمير متصل مبني في محل جر مضاف إليه.</li>
    </ul>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">أَعرِب جملتك الآن.</span>
    ألصق أي جملة فيها مفعول به في محلّل الإعراب على الصفحة الرئيسية، وشاهد نصبه وعلامته والسبب، كلمة بكلمة خلال ثوانٍ.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="order"
    title="تقديم المفعول به وتأخيره"
    lead="الأصل أن يتأخر المفعول به عن الفاعل، لكنه يتقدم عليه جوازًا للعناية والاهتمام، ويتقدم وجوبًا في مواضع، بل يتقدم على الفعل نفسه في أساليب معروفة."
  >
    <p><strong>يجب تقديمه على الفاعل</strong> إذا كان ضميرًا متصلًا والفاعل اسم ظاهر: <span class="ar">أَكْرَمَنِي الْمُعَلِّمُ</span>، النون للوقاية والياء ضمير متصل مبني في محل نصب مفعول به مقدم، والمعلمُ فاعل مؤخر مرفوع.</p>
    <p><strong>ويجب كذلك</strong> إذا اتصل بالفاعل ضمير يعود على المفعول به: <span class="ar">أَكْرَمَ الْمُعَلِّمَ تِلْمِيذُهُ</span>، فلو أُخّر المفعول لعاد الضمير على متأخر لفظًا ورتبة وهو ممتنع.</p>
    <p><strong>ويتقدم على الفعل والفاعل معًا</strong> إذا كان له الصدارة، كأسماء الاستفهام والشرط: <span class="ar">مَنْ قَابَلْتَ؟</span> مَن اسم استفهام مبني على السكون في محل نصب مفعول به مقدم. ومنه قوله تعالى: <span class="ar">﴿إِيَّاكَ نَعْبُدُ﴾</span>، إياك ضمير منفصل مبني في محل نصب مفعول به مقدم، وتقديمه أفاد الحصر والاختصاص.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="multiple"
    title="الأفعال التي تنصب أكثر من مفعول"
    lead="من الأفعال ما يكتفي بمفعول واحد، ومنها ما ينصب مفعولين أصلهما المبتدأ والخبر، ومنها ما ينصب مفعولين ليس أصلهما كذلك، ومنها ما ينصب ثلاثة."
  >
    <ul>
      <li><strong>مفعولان أصلهما المبتدأ والخبر</strong>، وهي أفعال الظن واليقين والتحويل: <span class="ar">ظَنَنْتُ الْخَبَرَ صَحِيحًا</span>، الخبرَ مفعول به أول منصوب، صحيحًا مفعول به ثانٍ منصوب. وأصلهما: الخبرُ صحيحٌ، وهما في الأصل باب <a href="/duroos/al-mubtada-wal-khabar">المبتدأ والخبر</a>.</li>
      <li><strong>مفعولان ليس أصلهما المبتدأ والخبر:</strong> <span class="ar">أَعْطَى الْمُعَلِّمُ الطَّالِبَ جَائِزَةً</span>، الطالبَ مفعول به أول، جائزةً مفعول به ثانٍ.</li>
      <li><strong>ثلاثة مفاعيل</strong> مع "أعلمَ" و"أرى" وأخواتهما: <span class="ar">أَعْلَمْتُ أَخِي الْخَبَرَ صَحِيحًا</span>.</li>
    </ul>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="common-mistakes"
    title="أخطاء شائعة في إعراب المفعول به"
    lead="أكثر أخطاء هذا الباب من ثلاثة أبواب مجاورة: الخلط بينه وبين نائب الفاعل، ورفع ما حقه النصب في الجموع، وإغفال المصدر المؤول."
  >
    <ul>
      <li><strong>الخلط مع نائب الفاعل:</strong> في <span class="ar">كُسِرَ الزُّجَاجُ</span> ليس في الجملة مفعول به، فالزجاجُ <a href="/duroos/naib-al-fail">نائب فاعل</a> مرفوع لأن الفعل مبني للمجهول.</li>
      <li><strong>رفع جمع المؤنث السالم:</strong> يقال خطأً "شكرتُ المعلماتُ" والصواب <span class="ar">شَكَرْتُ الْمُعَلِّمَاتِ</span> بالكسرة نيابة عن الفتحة.</li>
      <li><strong>إعراب المضاف إليه مفعولًا:</strong> في <span class="ar">قَرَأْتُ كِتَابَ النَّحْوِ</span> المفعول به "كتابَ" وحده، والنحوِ مضاف إليه مجرور، فراجع درس <a href="/duroos/al-idafa">الإضافة</a>.</li>
    </ul>
    <p>ولمعرفة العلامات الفرعية كلها في بابها، انظر درس <a href="/duroos/alamat-al-irab">علامات الإعراب</a>، وللأصل النظري كله راجع <a href="/nahw">ما هو النحو</a> و<a href="/irab">ما هو الإعراب</a>.</p>
  </ArticleSection>

  <AyatExamples slug="al-maful-bih" />

  <ArticleFaq lang="ar" items={faqs} />

  <Footer lang="ar" />
</BaseLayout>
