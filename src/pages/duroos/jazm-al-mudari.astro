---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import Byline from '../../components/Byline.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';
import AyatExamples from '../../components/duroos/AyatExamples.astro';

const faqs = [
  { q: 'ما الفرق بين لم ولما؟', a: 'كلاهما حرف نفي وجزم وقلب، لكن "لم" تنفي الفعل نفيًا مطلقًا في الماضي، و"لما" تنفيه إلى زمن التكلم مع توقع حدوثه: "لما يحضرْ" أي لم يحضر حتى الآن ويتوقع حضوره.' },
  { q: 'ما معنى "حرف نفي وجزم وقلب"؟', a: 'نفي لأنه ينفي الحدث، وجزم لأنه يجزم المضارع، وقلب لأنه يقلب زمن المضارع من الحال أو الاستقبال إلى الماضي: "لم يذهبْ" نفي للذهاب في الماضي بصيغة المضارع.' },
  { q: 'ما الفرق بين لا الناهية ولا النافية؟', a: 'الناهية تفيد طلب الكف وتجزم المضارع المخاطب غالبًا: "لا تكذبْ" بالجزم. والنافية تنفي الحدث ولا تعمل: "لا يكذبُ المؤمنُ" بالرفع. العلامة الإعرابية هي الفيصل.' },
  { q: 'ما الأدوات التي تجزم فعلين؟', a: 'أدوات الشرط الجازمة: إنْ، مَنْ، ما، مهما، متى، أيّان، أين، أينما، أنّى، حيثما، كيفما، أيّ. تجزم فعل الشرط وجوابه: "من يزرعْ يحصدْ".' },
  { q: 'كيف يجزم الفعل المعتل الآخر؟', a: 'بحذف حرف العلة: لم يدعُ أصلها يدعو، ولم يرمِ أصلها يرمي، ولم يسعَ أصلها يسعى. وتبقى الحركة قبل موضع الحذف دالة على الحرف المحذوف.' },
  { q: 'متى يقترن جواب الشرط بالفاء؟', a: 'إذا لم يصلح أن يكون فعل شرط: كأن يكون جملة اسمية أو طلبية أو ماضيًا بقد أو مقرونًا بلن أو ما، كقوله تعالى: ﴿وَمَنْ يَتَوَكَّلْ عَلَى اللَّهِ فَهُوَ حَسْبُهُ﴾، والجملة بعد الفاء في محل جزم.' },
];
---
<BaseLayout
  lang="ar"
  title="جزم الفعل المضارع: الجوازم وعلاماته · إعراب آب"
  description="شرح جزم المضارع: الأدوات التي تجزم فعلًا واحدًا (لم، لما، لام الأمر، لا الناهية) وأدوات الشرط الجازمة لفعلين، وعلامات الجزم بالسكون وحذف حرف العلة وحذف النون."
>
  <ArticleSchema slot="head" lang="ar" kind="lesson" headline="جزم الفعل المضارع" description="شرح جزم المضارع: الأدوات التي تجزم فعلًا واحدًا (لم، لما، لام الأمر، لا الناهية) وأدوات الشرط الجازمة لفعلين، وعلامات الجزم بالسكون وحذف حرف العلة وحذف النون." />
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="جزم الفعل المضارع"
    summary="الجزم أثر يختص بالفعل المضارع، تحدثه أدوات قسمها النحاة قسمين: ما يجزم فعلًا واحدًا، وما يجزم فعلين في أسلوب الشرط. وعلاماته ثلاث: السكون، وحذف حرف العلة، وحذف النون. هذا الدرس يجمع الأدوات والعلامات بأمثلة قرآنية معربة."
  />
  <Byline lang="ar" kind="lesson" />

  <ArticleSection
    lang="ar"
    id="one-verb"
    title="ما يجزم فعلًا واحدًا"
    lead="أربع أدوات تجزم مضارعًا واحدًا: لم ولما للنفي، ولام الأمر للطلب، ولا الناهية للكف."
  >
    <ul>
      <li><span class="ar">لَمْ</span>: حرف نفي وجزم وقلب، <span class="ar">﴿لَمْ يَلِدْ وَلَمْ يُولَدْ﴾</span>: يلدْ فعل مضارع مجزوم بلم وعلامة جزمه السكون.</li>
      <li><span class="ar">لَمَّا</span>: نفي إلى الحاضر مع التوقع، <span class="ar">﴿بَلْ لَمَّا يَذُوقُوا عَذَابِ﴾</span>: يذوقوا مجزوم بلما وعلامة جزمه حذف النون.</li>
      <li><span class="ar">لَامُ الْأَمْرِ</span>: <span class="ar">﴿لِيُنْفِقْ ذُو سَعَةٍ مِنْ سَعَتِهِ﴾</span>: ينفقْ مجزوم بلام الأمر وعلامة جزمه السكون، وذو فاعل مرفوع بالواو لأنه من <a href="/duroos/al-asma-al-khamsa">الأسماء الخمسة</a>.</li>
      <li><span class="ar">لَا النَّاهِيَة</span>: <span class="ar">لَا تُؤَجِّلْ عَمَلَ الْيَوْمِ إِلَى الْغَدِ</span>: تؤجلْ فعل مضارع مجزوم بلا الناهية وعلامة جزمه السكون، والفاعل ضمير مستتر وجوبًا تقديره أنت.</li>
    </ul>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="two-verbs"
    title="أدوات الشرط الجازمة لفعلين"
    lead="تجزم أدوات الشرط فعلين: الأول فعل الشرط والثاني جوابه وجزاؤه. أشهرها: إن، من، ما، مهما، متى، أين، حيثما، كيفما، أي."
  >
    <p><span class="ar">مَنْ يَزْرَعْ يَحْصُدْ</span></p>
    <p><strong>الإعراب:</strong> من اسم شرط جازم مبني على السكون في محل رفع مبتدأ. يزرعْ فعل مضارع مجزوم لأنه فعل الشرط وعلامة جزمه السكون، والفاعل ضمير مستتر تقديره هو. يحصدْ فعل مضارع مجزوم لأنه جواب الشرط وعلامة جزمه السكون، وجملتا الشرط والجواب في محل رفع خبر المبتدأ.</p>
    <p>مثال قرآني: <span class="ar">﴿وَمَا تَفْعَلُوا مِنْ خَيْرٍ يَعْلَمْهُ اللَّهُ﴾</span>: تفعلوا فعل الشرط مجزوم بحذف النون لأنه من <a href="/duroos/al-afal-al-khamsa">الأفعال الخمسة</a>، ويعلمْه جواب الشرط مجزوم بالسكون.</p>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">اختبر أسلوب الشرط.</span>
    ألصق جملة شرطية في محلّل الإعراب وشاهده يعين الأداة وفعل الشرط وجوابه وعلامة الجزم في كل منهما.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="signs"
    title="علامات الجزم الثلاث"
    lead="السكون للفعل الصحيح الآخر، وحذف حرف العلة للمعتل الآخر، وحذف النون للأفعال الخمسة."
  >
    <ul>
      <li><strong>السكون:</strong> <span class="ar">لَمْ يَكْتُبْ</span>، مجزوم وعلامة جزمه السكون.</li>
      <li><strong>حذف حرف العلة:</strong> <span class="ar">﴿وَمَنْ يَتَّقِ اللَّهَ يَجْعَلْ لَهُ مَخْرَجًا﴾</span>: يتقِ فعل الشرط مجزوم وعلامة جزمه حذف حرف العلة (الياء) والكسرة قبله دليل عليها.</li>
      <li><strong>حذف النون:</strong> <span class="ar">لَمْ يَكْتُبُوا</span>، مجزوم وعلامة جزمه حذف النون لأنه من الأفعال الخمسة، وواو الجماعة فاعل.</li>
    </ul>
    <p>وجدول العلامات الأصلية والفرعية كلها في درس <a href="/duroos/alamat-al-irab">علامات الإعراب</a>.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="common-mistakes"
    title="أخطاء شائعة"
    lead="أشيع أخطاء الباب رفع الفعل بعد الجازم، والخلط بين لا الناهية والنافية، وإغفال حذف حرف العلة."
  >
    <ul>
      <li>يقال خطأً "لم يذهبُ" بالرفع، والصواب <span class="ar">لَمْ يَذْهَبْ</span> بالسكون.</li>
      <li>يقال خطأً "لا تنسى الواجبَ" في النهي، والصواب <span class="ar">لَا تَنْسَ الْوَاجِبَ</span> بحذف الألف لأن لا ناهية جازمة.</li>
      <li>الفرق بين <span class="ar">لَا تَكْذِبْ</span> (نهي مجزوم) و<span class="ar">لَا يَكْذِبُ الْمُؤْمِنُ</span> (نفي مرفوع) في العلامة، فالحركة الأخيرة تحسم المعنى.</li>
    </ul>
    <p>ونظير هذا الباب في النصب درس <a href="/duroos/nasb-al-mudari">نصب المضارع</a>، وبناء الجملة الفعلية كلها في <a href="/duroos/al-jumla-al-filiyya">درسها</a>، والأصل في <a href="/irab">ما هو الإعراب</a>.</p>
  </ArticleSection>

  <AyatExamples slug="jazm-al-mudari" />

  <ArticleFaq lang="ar" items={faqs} />

  <Footer lang="ar" />
</BaseLayout>
