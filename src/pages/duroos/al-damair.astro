---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import LessonShell from '../../components/duroos/LessonShell.astro';
import LessonSection from '../../components/duroos/LessonSection.astro';
import IrabExample from '../../components/duroos/IrabExample.astro';
import LessonTry from '../../components/duroos/LessonTry.astro';

const faqs = [
  { q: 'لماذا الضمائر كلها مبنية؟', a: 'لأنها أشبهت الحروف في الجمود وقلة الحروف والافتقار إلى غيرها في بيان المعنى، فبنيت مثلها. لكن لكل ضمير محل إعرابي: رفع أو نصب أو جر، يقال فيه: مبني في محل كذا.' },
  { q: 'ما ضمائر الرفع المنفصلة وضمائر النصب المنفصلة؟', a: 'الرفع: أنا، نحن، أنتَ، أنتِ، أنتما، أنتم، أنتن، هو، هي، هما، هم، هن. والنصب: إياي، إيانا، إياك بفروعها، إياه بفروعها. فالمنفصل إما مرفوع المحل وإما منصوبه، ولا يقع مجرورًا أبدًا.' },
  { q: 'كيف أعرف محل الضمير المتصل بالفعل؟', a: 'ضمائر الرفع المتصلة خمسة تلحق الفعل: تاء الفاعل وألف الاثنين وواو الجماعة وياء المخاطبة ونون النسوة، ومحلها رفع فاعل. وياء المتكلم وكاف الخطاب وهاء الغيبة بعد الفعل في محل نصب مفعول به.' },
  { q: 'ما إعراب "نا" في كتبنا وأكرمنا وكتابنا؟', a: 'نا الدالة على الفاعلين تصلح للمحال الثلاثة: بعد فعل ساكن الآخر فاعل (كتبْنا: في محل رفع)، وبعد فعل متحرك الآخر مفعول (أكرمَنا: في محل نصب)، وبعد الاسم مضاف إليه (كتابُنا: في محل جر).' },
  { q: 'متى يستتر الضمير وجوبًا ومتى جوازًا؟', a: 'وجوبًا إذا لم يصح إحلال اسم ظاهر محله، وذلك مع المتكلم والمخاطب: أكتبُ تقديره أنا، واكتبْ تقديره أنت. وجوازًا مع الغائب: محمدٌ يكتبُ، تقديره هو، إذ يصح: يكتبُ أخوه.' },
  { q: 'ما ضمير الفصل وما إعرابه؟', a: 'ضمير رفع منفصل يقع بين المبتدأ والخبر أو ما أصلهما ليفيد التوكيد والحصر: ﴿وَأُولَئِكَ هُمُ الْمُفْلِحُونَ﴾. والمختار أنه حرف لا محل له من الإعراب، ويجوز إعرابه مبتدأ ثانيًا وما بعده خبره.' },
];
---
<BaseLayout
  lang="ar"
  hasEn
  title="الضمائر وإعرابها: المتصل والمنفصل والمستتر · إعراب آب"
  description="الضمير اسم مبني، ومحله رفع أو نصب أو جر بحسب موقعه. شرح الضمائر المنفصلة والمتصلة والمستترة ونا الفاعلين وضمير الفصل، بأمثلة معربة كلمةً كلمة وآيات تطبيقية."
>
  <ArticleSchema slot="head" lang="ar" kind="lesson" headline="الضمائر وإعرابها" description="الضمير اسم مبني، ومحله رفع أو نصب أو جر بحسب موقعه. شرح الضمائر المنفصلة والمتصلة والمستترة ونا الفاعلين وضمير الفصل، بأمثلة معربة كلمةً كلمة وآيات تطبيقية." />
  <Nav lang="ar" />
  <LessonShell
    lang="ar"
    slug="al-damair"
    title="الضمائر وإعرابها"
    summary="نصف كلمات العربية الجارية ضمائر، وكلها مبنية ذات محل إعرابي. من ضبط ثلاث قوائم صغيرة، المنفصل والمتصل والمستتر، أمِن نصف زلات الإعراب. هذا الدرس يرتبها ويبين محل كل ضمير من الرفع والنصب والجر، مع نا الفاعلين وضمير الفصل، بأمثلة معربة كاملة."
    faqs={faqs}
  >

  <LessonSection
    lang="ar"
    id="mabniyya"
    title="الضمائر مبنية ولها محل"
    lead="كل ضمير مبني على حركته لا يتغير آخره، لكنه يحتل محلًّا إعرابيًّا بحسب موقعه، فيقال: مبني في محل رفع أو نصب أو جر."
  >
    <p><span class="ar">أَنَا طَالِبٌ</span></p>
    <p><strong>الإعراب:</strong> أنا ضمير منفصل مبني على السكون في محل رفع <a href="/duroos/al-mubtada-wal-khabar">مبتدأ</a>. طالبٌ خبر مرفوع وعلامة رفعه الضمة الظاهرة.</p>
    <p>فالضمير لم تظهر عليه حركة إعراب، لكنه أخذ محل المبتدأ كاملًا. وهذا معنى المحل الإعرابي في كل المبنيات.</p>
  </LessonSection>

  <LessonSection
    lang="ar"
    id="munfasil"
    title="الضمائر المنفصلة"
    lead="المنفصل قسمان لا ثالث لهما: ضمائر رفع تقع مبتدأ وفاعلًا معنويًّا، وضمائر نصب صدرها إيا تقع مفعولًا به مقدمًا غالبًا."
  >
    <ul>
      <li><strong>ضمائر الرفع:</strong> <span class="ar">أَنَا، نَحْنُ، أَنْتَ، أَنْتِ، أَنْتُمَا، أَنْتُمْ، أَنْتُنَّ، هُوَ، هِيَ، هُمَا، هُمْ، هُنَّ</span>.</li>
      <li><strong>ضمائر النصب:</strong> <span class="ar">إِيَّايَ، إِيَّانَا، إِيَّاكَ، إِيَّاهُ</span> وفروعها.</li>
    </ul>
    <IrabExample label="المثال الأشهر" ar="﴿إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ﴾">إياك ضمير منفصل مبني على الفتح في محل نصب <a href="/duroos/al-maful-bih">مفعول به</a> مقدم، وتقديمه أفاد الحصر. نعبدُ فعل مضارع مرفوع والفاعل ضمير مستتر وجوبًا تقديره نحن.</IrabExample>
  </LessonSection>

  <LessonTry lang="ar">
    <span slot="title">اختبر ضمائر جملتك.</span>
    ألصق جملة مليئة بالضمائر في محلّل الإعراب وشاهده يعين محل كل ضمير من الرفع والنصب والجر مع التعليل.
  </LessonTry>

  <LessonSection
    lang="ar"
    id="muttasil"
    title="الضمائر المتصلة ومحالها"
    lead="المتصل ثلاث مجموعات بحسب المحل: ضمائر رفع تتصل بالفعل، وضمائر نصب بعد الفعل، وضمائر جر بعد الاسم أو حرف الجر. والصورة الواحدة يحدد محلها موقعها."
  >
    <ul>
      <li><strong>في محل رفع فاعل:</strong> تاء الفاعل وألف الاثنين وواو الجماعة وياء المخاطبة ونون النسوة: <span class="ar">كَتَبْتُ، كَتَبَا، كَتَبُوا، تَكْتُبِينَ، كَتَبْنَ</span>.</li>
      <li><strong>في محل نصب مفعول به:</strong> الياء والكاف والهاء بعد الفعل: <span class="ar">أَكْرَمَنِي، أَكْرَمَكَ، أَكْرَمَهُ</span>، والنون في أكرمني للوقاية لا محل لها.</li>
      <li><strong>في محل جر:</strong> الضمائر نفسها بعد الاسم مضاف إليه: <span class="ar">كِتَابِي، كِتَابُكَ، كِتَابُهُ</span>، وبعد حرف الجر: <span class="ar">بِكَ، لَهُ، عَنِّي</span>، وراجع <a href="/duroos/al-idafa">الإضافة</a> و<a href="/duroos/huruf-al-jarr">حروف الجر</a>.</li>
    </ul>
    <IrabExample label="نا الفاعلين تجمع المحال الثلاثة" ar="رَبَّنَا إِنَّنَا سَمِعْنَا">نا في ربنا مضاف إليه في محل جر، وفي إننا اسم <a href="/duroos/inna-wa-akhawatuha">إنّ</a> في محل نصب، وفي سمعنا <a href="/duroos/al-fail">فاعل</a> في محل رفع. ثلاثة محال في ثلاث كلمات متتاليات.</IrabExample>
  </LessonSection>

  <LessonSection
    lang="ar"
    id="mustatir"
    title="الضمير المستتر وضمير الفصل"
    lead="المستتر ضمير لا صورة له في اللفظ: يستتر وجوبًا مع المتكلم والمخاطب، وجوازًا مع الغائب. وضمير الفصل يتوسط المبتدأ والخبر للتوكيد والحصر."
  >
    <p><strong>المستتر وجوبًا:</strong> <span class="ar">أُحِبُّ الْعَرَبِيَّةَ</span>: الفاعل ضمير مستتر وجوبًا تقديره أنا، إذ لا يصح: أحبُّ محمدٌ.</p>
    <IrabExample label="المستتر جوازًا" ar="مُحَمَّدٌ يَقْرَأُ">الفاعل ضمير مستتر جوازًا تقديره هو، والجملة الفعلية في محل رفع خبر.</IrabExample>
    <IrabExample label="ضمير الفصل" ar="﴿وَأُولَئِكَ هُمُ الْمُفْلِحُونَ﴾">أولئك اسم إشارة مبني في محل رفع مبتدأ، هم ضمير فصل لا محل له من الإعراب على المختار، المفلحون خبر مرفوع وعلامة رفعه الواو لأنه جمع مذكر سالم.</IrabExample>
  </LessonSection>

  <LessonSection
    lang="ar"
    id="common-mistakes"
    title="أخطاء شائعة"
    lead="أشيع الأخطاء إعراب نون الوقاية ضميرًا، والخلط بين محال نا، وظن واو الجماعة حرفًا لا اسمًا."
  >
    <ul>
      <li>في <span class="ar">أَكْرَمَنِي</span> النون للوقاية حرف لا محل له، والياء وحدها في محل نصب مفعول به.</li>
      <li>واو الجماعة اسم في محل رفع فاعل، وواو <a href="/duroos/al-atf">العطف</a> حرف لا محل له: <span class="ar">كَتَبُوا</span> غير <span class="ar">مُحَمَّدٌ وَعَلِيٌّ</span>.</li>
      <li>الألف في <span class="ar">كَتَبَا</span> ضمير الاثنين في محل رفع فاعل، والألف في <span class="ar">كَتَبُوا</span> فارقة لا محل لها.</li>
    </ul>
    <p>وأخو هذا الباب في المبنيات <a href="/duroos/al-asma-al-mawsula">الأسماء الموصولة</a>، والأصل الجامع في <a href="/irab">الإعراب</a>.</p>
  </LessonSection>
  </LessonShell>

  <Footer lang="ar" />
</BaseLayout>
