---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';
import AyatExamples from '../../components/duroos/AyatExamples.astro';

const faqs = [
  { q: 'ما الأسماء الموصولة الخاصة والمشتركة؟', a: 'الخاصة تختص بنوع وعدد: الذي للمفرد المذكر، والتي للمفردة، واللذان واللتان للمثنى، والذين لجمع الذكور، واللاتي واللائي لجمع الإناث. والمشتركة تصلح للجميع بلفظ واحد: من للعاقل، وما لغير العاقل، وأي، وذا بعد ما أو من الاستفهاميتين.' },
  { q: 'لماذا تعرب اللذان واللتان ولا يعرب الذي والتي؟', a: 'الأسماء الموصولة مبنية كلها إلا المثنى منها: اللذان واللتان يعربان إعراب المثنى بالألف رفعًا والياء نصبًا وجرًّا، حملًا على المثنى المعرب. فتقول: جاء اللذان نجحا، ورأيت اللذين نجحا.' },
  { q: 'ما صلة الموصول وما إعرابها؟', a: 'جملة أو شبه جملة تأتي بعد الاسم الموصول لتوضيح المقصود به، ولا محل لها من الإعراب دائمًا. ويشترط أن تشتمل على عائد: ضمير يعود على الموصول.' },
  { q: 'ما العائد ومتى يحذف؟', a: 'ضمير في الصلة يرجع إلى الموصول: قرأت الكتابَ الذي اشتريتُه، الهاء عائد. ويحذف كثيرًا إذا كان مفعولًا به متصلًا: قرأت الكتاب الذي اشتريتُ، أي اشتريتُه، ومنه: ﴿أَهَذَا الَّذِي بَعَثَ اللَّهُ رَسُولًا﴾.' },
  { q: 'كيف أفرق بين ما الموصولة وما الاستفهامية والشرطية؟', a: 'الموصولة يصح إحلال الذي محلها: أعجبني ما قلتَ، أي الذي قلتَ. والاستفهامية يطلب بها الفهم: ما قلتَ؟ والشرطية تجزم فعلين: ما تفعلْ من خير تجدْه. فالمعنى والعمل هما الفيصلان.' },
  { q: 'ما إعراب أي الموصولة؟', a: 'أي معربة بالحركات الثلاث خلافًا لأخواتها المبنية: يعجبني أيُّهم أحسنُ عملًا بالرفع، وأكرم أيَّهم أفضلُ بالنصب. وتبنى على الضم إذا أضيفت وحذف صدر صلتها.' },
];
---
<BaseLayout
  lang="ar"
  title="الأسماء الموصولة: أنواعها وصلتها والعائد · إعراب"
  description="شرح الأسماء الموصولة: الخاصة والمشتركة، إعراب اللذان واللتان إعراب المثنى، صلة الموصول التي لا محل لها، العائد وحذفه، ومحل الموصول من الإعراب، بأمثلة قرآنية معربة."
>
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="الأسماء الموصولة"
    summary="الاسم الموصول اسم مبهم لا يتم معناه إلا بجملة بعده تسمى الصلة، فيها ضمير يعود عليه يسمى العائد. وهو مبني له محل من الإعراب، إلا مثناه فمعرب. هذا الدرس يعرض الخاصة والمشتركة وأحكام الصلة والعائد ومحل الموصول، بأمثلة قرآنية معربة كاملة."
  />

  <ArticleSection
    lang="ar"
    id="definition"
    title="التعريف والمحل"
    lead="الموصول مبني في محل رفع أو نصب أو جر بحسب موقعه من الجملة، وجملة الصلة بعده لا محل لها من الإعراب أبدًا."
  >
    <p><span class="ar">جَاءَ الَّذِي نَجَحَ</span></p>
    <p><strong>الإعراب:</strong> جاء فعل ماضٍ مبني على الفتح. الذي اسم موصول مبني على السكون في محل رفع <a href="/duroos/al-fail">فاعل</a>. نجحَ فعل ماضٍ والفاعل ضمير مستتر جوازًا تقديره هو يعود على الموصول، وهو العائد، وجملة نجح صلة الموصول لا محل لها من الإعراب.</p>
    <p>فللموصول ثلاثة أجزاء تذكر في كل إعراب: محل الموصول، وجملة الصلة، والعائد.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="types"
    title="الخاصة والمشتركة"
    lead="الخاصة ثمانية ألفاظ تفصل النوع والعدد، والمشتركة لفظ واحد لكل الأنواع أشهرها من للعاقل وما لغيره."
  >
    <ul>
      <li><strong>للمفرد:</strong> <span class="ar">الَّذِي</span> و<span class="ar">الَّتِي</span>، مبنيان على السكون.</li>
      <li><strong>للمثنى:</strong> <span class="ar">اللَّذَانِ</span> و<span class="ar">اللَّتَانِ</span>، معربان إعراب المثنى: <span class="ar">جَاءَ اللَّذَانِ نَجَحَا</span> بالألف، و<span class="ar">رَأَيْتُ اللَّذَيْنِ نَجَحَا</span> بالياء، وراجع <a href="/duroos/alamat-al-irab">علامات الإعراب</a>.</li>
      <li><strong>للجمع:</strong> <span class="ar">الَّذِينَ</span> للذكور مبني على الفتح، و<span class="ar">اللَّاتِي واللَّائِي</span> للإناث.</li>
      <li><strong>المشتركة:</strong> <span class="ar">مَنْ</span> للعاقل و<span class="ar">مَا</span> لغير العاقل: <span class="ar">أَعْجَبَنِي مَا قُلْتَ</span> أي الذي قلتَ.</li>
    </ul>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">صِلْ وأعرِب.</span>
    ألصق جملة فيها اسم موصول في محلّل الإعراب وشاهده يعين محل الموصول وجملة الصلة والعائد، كلمة بكلمة.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="silah"
    title="الصلة والعائد"
    lead="الصلة جملة خبرية معهودة للمخاطب لا محل لها من الإعراب، وتكون فعلية أو اسمية أو شبه جملة، وعائدها ضمير ظاهر أو مستتر أو محذوف."
  >
    <p><strong>مثال قرآني معرب:</strong> <span class="ar">﴿قَدْ أَفْلَحَ الْمُؤْمِنُونَ الَّذِينَ هُمْ فِي صَلَاتِهِمْ خَاشِعُونَ﴾</span></p>
    <p><strong>الإعراب:</strong> قد حرف تحقيق، أفلحَ فعل ماضٍ مبني على الفتح، المؤمنون فاعل مرفوع وعلامة رفعه الواو لأنه جمع مذكر سالم. الذين اسم موصول مبني على الفتح في محل رفع <a href="/duroos/al-naat">نعت</a> للمؤمنين. هم ضمير منفصل مبني في محل رفع مبتدأ، وخاشعون خبر مرفوع بالواو، والجملة الاسمية صلة الموصول لا محل لها، والعائد الضمير هم.</p>
    <p><strong>حذف العائد المنصوب:</strong> <span class="ar">قَرَأْتُ الْكِتَابَ الَّذِي اشْتَرَيْتُ</span> أي اشتريتُه، فالعائد محذوف لأنه ضمير متصل منصوب.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="mahall-examples"
    title="محل الموصول من الإعراب"
    lead="يقع الموصول حيث يقع الاسم: فاعلًا ومفعولًا ومبتدأ ونعتًا واسمًا للنواسخ ومجرورًا، ومحله يتبع الموقع لا لفظه."
  >
    <ul>
      <li><strong>اسم إنّ:</strong> <span class="ar">﴿إِنَّ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ كَانَتْ لَهُمْ جَنَّاتُ الْفِرْدَوْسِ نُزُلًا﴾</span>: الذين مبني على الفتح في محل نصب اسم <a href="/duroos/inna-wa-akhawatuha">إنّ</a>، وجملة آمنوا صلة لا محل لها.</li>
      <li><strong>مفعول به:</strong> <span class="ar">أَكْرَمْتُ الَّذِي سَاعَدَنِي</span>: الذي في محل نصب <a href="/duroos/al-maful-bih">مفعول به</a>.</li>
      <li><strong>مجرور:</strong> <span class="ar">سَلَّمْتُ عَلَى الَّذِي فَازَ</span>: الذي في محل جر بعلى، وعمل الحرف في <a href="/duroos/huruf-al-jarr">حروف الجر</a>.</li>
    </ul>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="common-mistakes"
    title="أخطاء شائعة"
    lead="أشيع الأخطاء إعطاء جملة الصلة محلًّا، ونصب اللذان بالألف، والخلط بين ما الموصولة وأخواتها."
  >
    <ul>
      <li>جملة الصلة لا محل لها أبدًا، فلا يقال إنها خبر أو نعت، وإنما الموصول نفسه هو صاحب المحل.</li>
      <li>يقال خطأً "رأيتُ اللذان نجحا"، والصواب <span class="ar">اللَّذَيْنِ</span> بالياء لأنه معرب إعراب المثنى.</li>
      <li>الجمل بعد النكرات صفات لا صلات: <span class="ar">جَاءَ طِفْلٌ يَضْحَكُ</span> جملة يضحك نعت، أما الصلة فلا تكون إلا بعد موصول، وراجع <a href="/duroos/al-naat">النعت</a>.</li>
    </ul>
    <p>وأخو هذا الباب في المبنيات <a href="/duroos/al-damair">الضمائر</a>، والأصل الجامع في <a href="/nahw">ما هو النحو</a> وتطبيقه في <a href="/irab">الإعراب</a>.</p>
  </ArticleSection>

  <AyatExamples slug="al-asma-al-mawsula" />

  <ArticleFaq lang="ar" items={faqs} />

  <Footer lang="ar" />
</BaseLayout>
