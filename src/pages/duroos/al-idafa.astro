---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';

const faqs = [
  { q: 'هل المضاف إليه مجرور دائمًا؟', a: 'نعم، المضاف إليه مجرور أبدًا، هذه من القواعد المطردة بلا استثناء. أما المضاف نفسه فيعرب بحسب موقعه في الجملة: فاعلًا أو مفعولًا أو مبتدأ أو غير ذلك.' },
  { q: 'ماذا يحذف من المضاف؟', a: 'يحذف من المضاف التنوين نحو "كتابُ الطالبِ" لا "كتابٌ الطالبِ"، وتحذف نون المثنى ونون جمع المذكر السالم نحو "معلما المدرسةِ" و"معلمو المدرسةِ".' },
  { q: 'ما الفرق بين الإضافة المعنوية واللفظية؟', a: 'المعنوية تفيد التعريف أو التخصيص وتقدر بحرف جر (كتابُ الطالبِ أي كتابٌ للطالبِ). اللفظية مضافها وصف عامل فيما بعده (حسنُ الوجهِ) ولا تفيد المضاف تعريفًا، وفائدتها التخفيف اللفظي.' },
  { q: 'بأي حرف تقدر الإضافة المعنوية؟', a: 'باللام غالبًا للملك والاختصاص نحو "بابُ الدارِ"، وبمن إذا كان المضاف إليه جنسًا للمضاف نحو "خاتمُ فضةٍ"، وبفي إذا كان ظرفًا للمضاف نحو "مكرُ الليلِ" أي المكر في الليل.' },
  { q: 'هل تدخل أل على المضاف؟', a: 'في الإضافة المعنوية لا يجتمع المضاف مع أل، فلا يقال "الكتابُ الطالبِ". وتجوز في اللفظية بشروط، منها أن يكون المضاف إليه بأل نحو "الحسنُ الوجهِ".' },
  { q: 'كيف يعرب المضاف إليه إذا كان جملة؟', a: 'تقع الجملة مضافًا إليه بعد الظروف: "جلستُ حيثُ جلسَ أخي"، جملة "جلس أخي" في محل جر مضاف إليه. ومثله بعد إذ وإذا ولمّا وحين إذا أضيفت.' },
];
---
<BaseLayout
  lang="ar"
  title="الإضافة والمضاف إليه: أحكام الجر والمطابقة · إعراب"
  description="شرح الإضافة: تعريفها، جر المضاف إليه دائمًا، ما يحذف من المضاف، الإضافة المعنوية واللفظية وتقديرها بالحروف، مع أمثلة قرآنية معربة إعرابًا كاملًا."
>
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    eyebrow="دروس النحو"
    title="الإضافة والمضاف إليه"
    summary="الإضافة نسبة بين اسمين يتنزل ثانيهما من الأول منزلة التنوين، فيجر أبدًا. لا تكاد تخلو جملة عربية من إضافة، وأخطاؤها من أكثر ما يقع في الكتابة. هذا الدرس يشرح أركانها وما يحذف لأجلها، والفرق بين المعنوية واللفظية، مع أمثلة معربة كاملة."
  />

  <ArticleSection
    lang="ar"
    id="definition"
    title="التعريف والحكم"
    lead="الإضافة إسناد اسم إلى اسم آخر على تقدير حرف جر. الاسم الأول مضاف يعرب بحسب موقعه، والثاني مضاف إليه مجرور دائمًا."
  >
    <p><span class="ar">قَرَأْتُ كِتَابَ النَّحْوِ</span></p>
    <p><strong>الإعراب:</strong> قرأتُ فعل ماضٍ مبني على السكون لاتصاله بتاء الفاعل، والتاء ضمير متصل مبني في محل رفع فاعل. كتابَ <a href="/duroos/al-maful-bih">مفعول به</a> منصوب وعلامة نصبه الفتحة الظاهرة وهو مضاف. النحوِ مضاف إليه مجرور وعلامة جره الكسرة الظاهرة.</p>
    <p>فالمضاف "كتاب" أخذ إعرابه من موقعه في الجملة، والمضاف إليه "النحو" لزم الجر. ولو وقع المضاف فاعلًا لارتفع: <span class="ar">أَعْجَبَنِي كِتَابُ النَّحْوِ</span>.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="what-drops"
    title="ما يحذف من المضاف"
    lead="الإضافة تحذف من المضاف ثلاثة أشياء: التنوين، ونون المثنى، ونون جمع المذكر السالم. وحذف النونين من أدق ما يمتحن به الإملاء والإعراب معًا."
  >
    <ul>
      <li><strong>التنوين:</strong> <span class="ar">كِتَابٌ</span> ثم <span class="ar">كِتَابُ الطَّالِبِ</span>.</li>
      <li><strong>نون المثنى:</strong> <span class="ar">مُعَلِّمَانِ</span> ثم <span class="ar">مُعَلِّمَا الْمَدْرَسَةِ</span>: معلما مبتدأ أو فاعل بحسب الجملة مرفوع بالألف وحذفت النون للإضافة.</li>
      <li><strong>نون جمع المذكر السالم:</strong> <span class="ar">مُعَلِّمُونَ</span> ثم <span class="ar">مُعَلِّمُو الْمَدْرَسَةِ</span>، ونصبًا وجرًّا: <span class="ar">مُعَلِّمِي الْمَدْرَسَةِ</span>.</li>
    </ul>
    <p>مثال قرآني: <span class="ar">﴿إِنَّ شَانِئَكَ هُوَ الْأَبْتَرُ﴾</span>: شانئَ اسم إنّ منصوب وهو مضاف، والكاف ضمير متصل مبني في محل جر مضاف إليه. فالضمائر المتصلة بالأسماء كلها في محل جر بالإضافة، وعمل إنّ في <a href="/duroos/inna-wa-akhawatuha">درسها</a>.</p>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">أَعرِب سلسلة إضافات.</span>
    ألصق تركيبًا مثل "بابُ بيتِ جارِ صديقي" في محلّل الإعراب وشاهد كل مضاف إليه يجر ما بعده، حلقة بعد حلقة.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="manawiyya"
    title="الإضافة المعنوية"
    lead="المعنوية هي الأصل، تفيد المضاف تعريفًا إن كان المضاف إليه معرفة وتخصيصًا إن كان نكرة، وتقدر بحرف جر: اللام أو من أو في."
  >
    <ul>
      <li><strong>بتقدير اللام:</strong> <span class="ar">بَابُ الدَّارِ</span> أي بابٌ للدار.</li>
      <li><strong>بتقدير من:</strong> <span class="ar">خَاتَمُ فِضَّةٍ</span> أي خاتمٌ من فضةٍ، والمضاف إليه جنس المضاف.</li>
      <li><strong>بتقدير في:</strong> <span class="ar">﴿بَلْ مَكْرُ اللَّيْلِ وَالنَّهَارِ﴾</span> أي المكر في الليل والنهار.</li>
    </ul>
    <p>ولأن المعنوية تعرّف المضاف، لا تدخل عليه أل: يقال <span class="ar">كِتَابُ الطَّالِبِ</span> ولا يقال "الكتابُ الطالبِ". ومعاني حروف الجر المقدرة مفصلة في درس <a href="/duroos/huruf-al-jarr">حروف الجر</a>.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="lafziyya"
    title="الإضافة اللفظية"
    lead="اللفظية ما كان المضاف فيها وصفًا عاملًا فيما أضيف إليه: اسم فاعل أو اسم مفعول أو صفة مشبهة. لا تفيد تعريفًا ولا تخصيصًا، وفائدتها التخفيف في اللفظ."
  >
    <p><span class="ar">هَذَا رَجُلٌ حَسَنُ الْوَجْهِ</span></p>
    <p><strong>الإعراب:</strong> حسنُ نعت لرجل مرفوع وهو مضاف، الوجهِ مضاف إليه مجرور. والأصل: حسنٌ وجهُه، فأضيفت الصفة المشبهة إلى معمولها تخفيفًا. وأحكام النعت نفسه في <a href="/duroos/al-naat">درسه</a>.</p>
    <p>وعلامة اللفظية أن الإضافة لم تفد المضاف تعريفًا، بدليل وصف النكرة "رجل" بها، ولذلك جاز فيها نحو <span class="ar">الْحَسَنُ الْوَجْهِ</span> بدخول أل على المضاف.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="common-mistakes"
    title="أخطاء شائعة"
    lead="أشيع أخطاء الباب ثلاثة: تنوين المضاف، وإثبات نون المثنى والجمع مع الإضافة، ورفع المضاف إليه أو نصبه."
  >
    <ul>
      <li>يقال خطأً "كتابٌ الطالبِ" بالتنوين، والصواب <span class="ar">كِتَابُ الطَّالِبِ</span>.</li>
      <li>يقال خطأً "معلمونَ المدرسةِ"، والصواب <span class="ar">مُعَلِّمُو الْمَدْرَسَةِ</span> بحذف النون.</li>
      <li>المضاف إليه لا يكون إلا مجرورًا، فيقال خطأً "قرأتُ كتابَ الطالبَ"، والصواب <span class="ar">كِتَابَ الطَّالِبِ</span>.</li>
    </ul>
    <p>ويلتبس المضاف إليه المجرور بالاسم المجرور بالحرف، والتمييز بينهما أساس في <a href="/irab">الإعراب</a> الصحيح. وإذا كان المضاف إليه ممنوعًا من الصرف جُر بالفتحة، وتفصيله في <a href="/duroos/al-mamnu-min-al-sarf">درسه</a>، والإطار كله في <a href="/nahw">ما هو النحو</a>.</p>
  </ArticleSection>

  <ArticleFaq lang="ar" items={faqs} />

  <Footer lang="ar" />
</BaseLayout>
