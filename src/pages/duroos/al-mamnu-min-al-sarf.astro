---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import Byline from '../../components/Byline.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';
import AyatExamples from '../../components/duroos/AyatExamples.astro';

const faqs = [
  { q: 'ما معنى "ممنوع من الصرف" أصلًا؟', a: 'الصرف هو التنوين. فالممنوع من الصرف اسم معرب لا يقبل التنوين، ويُجر بالفتحة نيابة عن الكسرة ما لم يُضف أو تدخل عليه أل. سمي كذلك لأنه مُنع الصرفَ أي التنوين.' },
  { q: 'متى يُجر الممنوع من الصرف بالكسرة؟', a: 'في حالتين: إذا أضيف نحو "صلّيتُ في مساجدِ المدينةِ"، أو اقترن بأل نحو "مررتُ بالمساجدِ". حينها يعود إلى الجر بالكسرة كسائر الأسماء، ويبقى ممنوعًا من التنوين طبعًا لدخول أل أو الإضافة.' },
  { q: 'هل كل الأعلام الأعجمية ممنوعة من الصرف؟', a: 'الممنوع منها ما زاد على ثلاثة أحرف مثل إبراهيم وإسماعيل. أما الثلاثي الساكن الوسط مثل نوح ولوط فمصروف، تقول: قرأتُ عن نوحٍ.' },
  { q: 'لماذا "عمر" ممنوعة من الصرف و"عمرو" مصروفة؟', a: 'عُمَر معدول عن عامِر على وزن فُعَل، والعلمية مع العدل علتان تمنعان الصرف. أما عَمْرو فاسم على أصله لا عدل فيه فيُصرف، تقول: مررتُ بِعَمْرٍو ورأيتُ عَمْرًا.' },
  { q: 'كيف أعرف صيغة منتهى الجموع؟', a: 'كل جمع تكسير بعد ألف تكسيره حرفان نحو مَساجِد ومَنازِل، أو ثلاثة أوسطها ساكن نحو مَصابِيح ومَفاتِيح. هذه الصيغة تمنع الصرف بعلة واحدة قائمة مقام علتين.' },
  { q: 'هل يؤثر منع الصرف على الرفع والنصب؟', a: 'لا. الممنوع من الصرف يرفع بالضمة وينصب بالفتحة كغيره، والفرق كله في الجر (بالفتحة بدل الكسرة) وفي حذف التنوين. تقول: جاءَ إبراهيمُ، ورأيتُ إبراهيمَ، ومررتُ بإبراهيمَ.' },
];
---
<BaseLayout
  lang="ar"
  title="الممنوع من الصرف: أسبابه وجره بالفتحة · إعراب آب"
  description="شرح الممنوع من الصرف: تعريفه، العلل التي تمنع الاسم من التنوين، جره بالفتحة نيابة عن الكسرة، ومتى يعود إلى الكسرة، مع أمثلة قرآنية معربة إعرابًا كاملًا."
>
  <ArticleSchema slot="head" lang="ar" kind="lesson" headline="الممنوع من الصرف" description="شرح الممنوع من الصرف: تعريفه، العلل التي تمنع الاسم من التنوين، جره بالفتحة نيابة عن الكسرة، ومتى يعود إلى الكسرة، مع أمثلة قرآنية معربة إعرابًا كاملًا." />
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="الممنوع من الصرف"
    summary="الممنوع من الصرف اسم معرب لا ينوّن، ويخالف الأسماء في علامة جره: يُجر بالفتحة نيابة عن الكسرة. هذا الدرس يشرح العلل التي تمنع الصرف، علمًا وصفة وصيغة، ومتى يعود الاسم إلى الجر بالكسرة، مع أمثلة معربة من القرآن والكلام الفصيح."
  />
  <Byline lang="ar" kind="lesson" />

  <ArticleSection
    lang="ar"
    id="definition"
    title="التعريف والعلامة"
    lead="الممنوع من الصرف اسم معرب لا يقبل التنوين، يرفع بالضمة وينصب بالفتحة كسائر الأسماء، ويخالفها في الجر: علامته الفتحة نيابة عن الكسرة."
  >
    <p>قارن: <span class="ar">مَرَرْتُ بِمُحَمَّدٍ</span> بالكسرة والتنوين، ثم <span class="ar">مَرَرْتُ بِأَحْمَدَ</span> بالفتحة دون تنوين.</p>
    <p><strong>الإعراب:</strong> أحمدَ اسم مجرور بالباء وعلامة جره الفتحة نيابة عن الكسرة لأنه ممنوع من الصرف، والمانع له العلمية ووزن الفعل.</p>
    <p>مثال قرآني: <span class="ar">﴿وَلَقَدْ أَرْسَلْنَا نُوحًا وَإِبْرَاهِيمَ﴾</span>: نوحًا مفعول به منصوب منوّن لأنه ثلاثي ساكن الوسط مصروف، وإبراهيمَ معطوف عليه منصوب دون تنوين لأنه ممنوع من الصرف. فالآية الواحدة جمعت المصروف والممنوع، وتفصيل العطف في <a href="/duroos/al-atf">بابه</a>.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="one-reason"
    title="ما يمنع لعلة واحدة"
    lead="علتان تكفي كل واحدة منهما وحدها لمنع الصرف: ألف التأنيث المقصورة أو الممدودة، وصيغة منتهى الجموع."
  >
    <ul>
      <li><strong>ألف التأنيث المقصورة:</strong> <span class="ar">ذِكْرَى، كُبْرَى، عَطْشَى</span>. نحو: <span class="ar">فِي ذِكْرَى صَادِقَةٍ</span>.</li>
      <li><strong>ألف التأنيث الممدودة:</strong> <span class="ar">صَحْرَاء، حَمْرَاء، أَصْدِقَاء</span>. نحو: <span class="ar">سِرْتُ فِي صَحْرَاءَ وَاسِعَةٍ</span>، صحراءَ اسم مجرور وعلامة جره الفتحة نيابة عن الكسرة لأنه ممنوع من الصرف.</li>
      <li><strong>صيغة منتهى الجموع</strong> (مَفاعِل ومَفاعِيل): <span class="ar">مَسَاجِد، مَنَازِل, مَصَابِيح</span>. مثال قرآني: <span class="ar">﴿وَزَيَّنَّا السَّمَاءَ الدُّنْيَا بِمَصَابِيحَ﴾</span>، بمصابيحَ: الباء حرف جر، مصابيحَ اسم مجرور وعلامة جره الفتحة نيابة عن الكسرة لأنه ممنوع من الصرف على صيغة منتهى الجموع.</li>
    </ul>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">هل هذا الاسم ممنوع من الصرف؟</span>
    ألصق جملتك في محلّل الإعراب وسيبين لك علامة الجر الصحيحة وسببها، فتعرف فورًا إن كان الاسم مصروفًا أو ممنوعًا من الصرف.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="proper-nouns"
    title="ما يمنع لعلتين: الأعلام"
    lead="العلمية وحدها لا تمنع، فإذا انضمت إليها علة ثانية امتنع الصرف: التأنيث، والعجمة، والتركيب المزجي، وزيادة الألف والنون، ووزن الفعل، والعدل."
  >
    <ul>
      <li><strong>العلمية والتأنيث:</strong> <span class="ar">فَاطِمَة، مَكَّة، حَمْزَة</span>. نحو: <span class="ar">مَرَرْتُ بِفَاطِمَةَ</span>.</li>
      <li><strong>العلمية والعجمة</strong> فيما زاد على ثلاثة: <span class="ar">إِبْرَاهِيم، إِسْمَاعِيل، يَعْقُوب</span>.</li>
      <li><strong>العلمية والتركيب المزجي:</strong> <span class="ar">حَضْرَمَوْت، بَعْلَبَكّ</span>.</li>
      <li><strong>العلمية وزيادة الألف والنون:</strong> <span class="ar">عُثْمَان، سَلْمَان، رَمَضَان</span>.</li>
      <li><strong>العلمية ووزن الفعل:</strong> <span class="ar">أَحْمَد، يَزِيد، يَثْرِب</span>.</li>
      <li><strong>العلمية والعدل:</strong> <span class="ar">عُمَر، زُحَل، قُزَح</span>.</li>
    </ul>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="adjectives"
    title="ما يمنع لعلتين: الصفات"
    lead="الوصفية مع إحدى ثلاث علل تمنع الصرف: وزن أفعل الذي مؤنثه فعلاء، ووزن فعلان الذي مؤنثه فعلى، والعدل في الأعداد."
  >
    <ul>
      <li><strong>الوصفية ووزن أفعل:</strong> <span class="ar">أَحْمَر، أَفْضَل، أَكْبَر</span>. نحو: <span class="ar">كَتَبْتُ بِقَلَمٍ أَحْمَرَ</span>، أحمرَ نعت مجرور وعلامة جره الفتحة نيابة عن الكسرة لأنه ممنوع من الصرف، وأحكام النعت في <a href="/duroos/al-naat">درسه</a>.</li>
      <li><strong>الوصفية ووزن فعلان:</strong> <span class="ar">عَطْشَان، غَضْبَان، جَوْعَان</span>.</li>
      <li><strong>الوصفية والعدل:</strong> <span class="ar">مَثْنَى وَثُلَاثَ وَرُبَاعَ</span> كما في قوله تعالى: <span class="ar">﴿أُولِي أَجْنِحَةٍ مَثْنَى وَثُلَاثَ وَرُبَاعَ﴾</span>.</li>
    </ul>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="back-to-kasra"
    title="متى يعود إلى الجر بالكسرة"
    lead="الممنوع من الصرف يُجر بالكسرة كغيره في حالتين: إذا اقترن بأل، أو أضيف. ويبقى في الحالين غير منوّن."
  >
    <ul>
      <li><strong>مع أل:</strong> <span class="ar">صَلَّيْتُ فِي الْمَسَاجِدِ</span>، المساجدِ اسم مجرور وعلامة جره الكسرة الظاهرة لاقترانه بأل.</li>
      <li><strong>مع الإضافة:</strong> <span class="ar">صَلَّيْتُ فِي مَسَاجِدِ الْمَدِينَةِ</span>، مساجدِ اسم مجرور بالكسرة لأنه مضاف، والمدينةِ مضاف إليه مجرور، وتفصيل ذلك في درس <a href="/duroos/al-idafa">الإضافة</a>.</li>
    </ul>
    <p>وهذا من ألطف أبواب <a href="/duroos/alamat-al-irab">علامات الإعراب</a>: علامة واحدة تتبدل بحسب حال الاسم لا بحسب موقعه. وللسياق النظري الكامل راجع <a href="/nahw">ما هو النحو</a>.</p>
  </ArticleSection>

  <AyatExamples slug="al-mamnu-min-al-sarf" />

  <ArticleFaq lang="ar" items={faqs} />

  <Footer lang="ar" />
</BaseLayout>
