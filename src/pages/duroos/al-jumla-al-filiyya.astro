import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';
import AyatExamples from '../../components/duroos/AyatExamples.astro';

const faqs = [
  { q: 'ما ركنا الجملة الفعلية؟', a: 'الفعل والفاعل، وهما العمدة التي لا تتم الجملة بدونها. أما المفعول به فهو فضلة لا يلزم إلا مع الأفعال المتعدية، فجملة "نام الطفلُ" جملة فعلية تامة بلا مفعول به.' },
  { q: 'هل يتقدم الفاعل على فعله؟', a: 'عند البصريين لا يتقدم أبدًا. فإذا قلت "الطالبُ كتب الدرسَ" فالطالب مبتدأ لا فاعل، والجملة اسمية، وفاعل كتب ضمير مستتر جوازًا تقديره هو، والجملة الفعلية في محل رفع خبر.' },
  { q: 'متى يجب تقديم المفعول به على الفاعل؟', a: 'في موضعين مشهورين: أن يكون المفعول ضميرًا متصلًا والفاعل اسمًا ظاهرًا (أكرمني المعلمُ)، أو أن يتصل بالفاعل ضمير يعود على المفعول (أكرمَ الطالبَ معلمُهُ)، لئلا يعود الضمير على متأخر لفظًا ورتبة.' },
  { q: 'ما الفرق بين الفاعل ونائب الفاعل؟', a: 'كلاهما مرفوع بعد الفعل، لكن الفاعل يأتي بعد فعل مبني للمعلوم ويدل على من فعل الفعل، ونائب الفاعل يأتي بعد فعل مبني للمجهول، وهو في الأصل مفعول به ناب عن الفاعل المحذوف وأخذ أحكامه.' },
  { q: 'هل يثنى الفعل أو يجمع مع الفاعل؟', a: 'لا، يبقى الفعل بصيغة الواحد مع الفاعل الظاهر: نجح الطالبان، نجح الطلابُ. أما نحو "نجحا" فالألف فيه ضمير متصل مبني في محل رفع فاعل، وليست علامة تثنية للفعل.' },
  { q: 'كيف أميز الفاعل من المفعول به عند غياب الحركات؟', a: 'اسأل: من الذي قام بالفعل؟ فهو الفاعل، وما الذي وقع عليه الفعل؟ فهو المفعول به. واستعن بقرائن كمطابقة الفعل للفاعل في التأنيث. وعند خفاء الحركات، كما في "أكرم موسى عيسى"، يلتزم الأصل فالمتقدم هو الفاعل.' },
];
---
<BaseLayout
  lang="ar"
  title="الجملة الفعلية: الفعل والفاعل والمفعول · إعراب"
  description="شرح الجملة الفعلية: أقسام الفعل، الفاعل وأحكامه، المفعول به، نائب الفاعل، وترتيب الأركان وأحكام التقديم والتأخير، مع أمثلة معربة وفق النحو الكلاسيكي."
>
  <ArticleSchema slot="head" lang="ar" kind="lesson" headline="الجملة الفعلية" description="شرح الجملة الفعلية: أقسام الفعل، الفاعل وأحكامه، المفعول به، نائب الفاعل، وترتيب الأركان وأحكام التقديم والتأخير، مع أمثلة معربة وفق النحو الكلاسيكي." />
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="الجملة الفعلية"
    summary="الجملة الفعلية هي التي تبدأ بفعل، وعمودها الفعل والفاعل، ويلحق بهما المفعول به إذا كان الفعل متعديًا. في هذا الدرس نعرض أقسام الفعل، وأحكام الفاعل والمفعول به ونائب الفاعل، ثم قواعد الترتيب بين هذه الأركان: ما يجري فيه على الأصل، وما يجوز فيه التقديم، وما يجب."
  />
  <Byline lang="ar" kind="lesson" />

  <ArticleSection
    lang="ar"
    id="definition"
    title="ما الجملة الفعلية؟"
    lead="الجملة الفعلية هي الجملة التي صدرها فعل، مثل: كتب الطالبُ الدرسَ. ركناها الأساسيان الفعل والفاعل، وهما عمدة لا تتم الجملة بدونهما، أما المفعول به فهو فضلة يجيء مع الأفعال المتعدية."
  >
    <p><strong>مثال معرب:</strong> <span class="ar">كَتَبَ الطَّالِبُ الدَّرْسَ</span>: كتب فعل ماضٍ مبني على الفتح، الطالبُ فاعل مرفوع وعلامة رفعه الضمة الظاهرة، الدرسَ مفعول به منصوب وعلامة نصبه الفتحة الظاهرة.</p>
    <p>وتقابل الجملةُ الفعلية <a href="/duroos/al-jumla-al-ismiyya">الجملةَ الاسمية</a> التي تبدأ باسم، فالفعلية تدل على الحدوث والتجدد، والاسمية تدل غالبًا على الثبوت. وقد بيّنا في درس <a href="/nahw">النحو</a> أن أول خطوة في الإعراب هي تحديد نوع الجملة، فمنه تتفرع بقية الأسئلة.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="the-verb"
    title="الفعل: أقسامه ولزومه وتعديه"
    lead="الفعل ثلاثة أقسام: ماضٍ مبني دائمًا، ومضارع معرب يرفع وينصب ويجزم ما لم تتصل به نون النسوة أو نون التوكيد، وأمر مبني دائمًا. وهو من جهة المعنى لازم يكتفي بفاعله، أو متعدٍّ ينصب مفعولًا به أو أكثر."
  >
    <ul>
      <li><strong>الماضي:</strong> مبني على الفتح في الأصل: <span class="ar">جَلَسَ</span>، وعلى السكون إن اتصل به ضمير رفع متحرك: <span class="ar">جَلَسْتُ</span>، وعلى الضم إن اتصلت به واو الجماعة: <span class="ar">جَلَسُوا</span>.</li>
      <li><strong>المضارع:</strong> معرب، مرفوع ما لم يسبقه ناصب أو جازم: <span class="ar">يَجْلِسُ</span>، <span class="ar">لَنْ يَجْلِسَ</span>، <span class="ar">لَمْ يَجْلِسْ</span>.</li>
      <li><strong>الأمر:</strong> مبني على ما يجزم به مضارعه: <span class="ar">اِجْلِسْ</span> مبني على السكون.</li>
    </ul>
    <p>ومن جهة التعدي: <span class="ar">نَامَ الطِّفْلُ</span> فعل لازم اكتفى بفاعله، و<span class="ar">فَهِمَ الطَّالِبُ الْقَاعِدَةَ</span> فعل متعدٍّ نصب مفعولًا به.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="the-fail"
    title="الفاعل وأحكامه"
    lead="الفاعل اسم مرفوع يقع بعد فعل مبني للمعلوم ويدل على من فعل الفعل أو اتصف به. حكمه الرفع دائمًا، ويأتي اسمًا ظاهرًا أو ضميرًا متصلًا أو ضميرًا مستترًا أو مصدرًا مؤولًا."
  >
    <p><strong>مثال معرب:</strong> <span class="ar">فَازَ الْمُجْتَهِدُونَ</span>: فاز فعل ماضٍ مبني على الفتح، المجتهدون فاعل مرفوع وعلامة رفعه الواو لأنه جمع مذكر سالم.</p>
    <p>ويكون الفاعل ضميرًا متصلًا كالتاء في <span class="ar">كَتَبْتُ</span>، فهي ضمير متصل مبني على الضم في محل رفع فاعل، والفعل معها مبني على السكون لاتصاله بضمير رفع متحرك. ويكون مستترًا كما في <span class="ar">الطَّالِبُ يَكْتُبُ</span>، فالفاعل ضمير مستتر جوازًا تقديره هو.</p>
    <p>ومن أحكامه أن الفعل يبقى بصيغة الواحد وإن كان الفاعل مثنى أو جمعًا: <span class="ar">نَجَحَ الطَّالِبَانِ</span> ولا يقال "نجحا الطالبان". ولهذا الباب تفصيل أوسع في درس <a href="/duroos/al-fail">الفاعل</a>.</p>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">شاهد أركان الجملة تتلوّن أمامك.</span>
    ألصق أي جملة فعلية في المحلل على الصفحة الرئيسية، وشاهد الدرس مطبقًا كلمة كلمة: الفعل ونوعه، والفاعل وعلامة رفعه، والمفعول به وعلامة نصبه.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="the-maful-bih"
    title="المفعول به"
    lead="المفعول به اسم منصوب يقع عليه فعل الفاعل، ولا يوجد إلا مع الأفعال المتعدية. ينصب بالفتحة الظاهرة أو المقدرة، وبالياء في المثنى وجمع المذكر السالم، وبالكسرة نيابة عن الفتحة في جمع المؤنث السالم."
  >
    <p><strong>مثال معرب:</strong> <span class="ar">يَحْتَرِمُ النَّاسُ الصَّادِقَ</span>: يحترم فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة، الناسُ فاعل مرفوع وعلامة رفعه الضمة الظاهرة، الصادقَ مفعول به منصوب وعلامة نصبه الفتحة الظاهرة.</p>
    <p>ويأتي المفعول به ضميرًا متصلًا: <span class="ar">أَكْرَمَنِي الْمُعَلِّمُ</span>، فالياء ضمير متصل مبني في محل نصب مفعول به، والنون للوقاية. وقد ينصب الفعل مفعولين، كأفعال المنح والظن: <span class="ar">مَنَحَ الْمُدِيرُ الْفَائِزَ جَائِزَةً</span>. وتفصيل علاماته وأحواله في درس <a href="/duroos/al-maful-bih">المفعول به</a>.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="naib-al-fail"
    title="نائب الفاعل عند البناء للمجهول"
    lead="إذا حذف الفاعل وبني الفعل للمجهول ناب المفعول به عنه، فارتفع وسمي نائب فاعل، وأخذ أحكام الفاعل كلها. ويتغير شكل الفعل: يضم أوله ويكسر ما قبل آخره في الماضي، ويضم أوله ويفتح ما قبل آخره في المضارع."
  >
    <p><strong>مثال معرب:</strong> <span class="ar">كُتِبَ الدَّرْسُ</span>: كُتب فعل ماضٍ مبني للمجهول مبني على الفتح، الدرسُ نائب فاعل مرفوع وعلامة رفعه الضمة الظاهرة.</p>
    <p>قارن بين <span class="ar">فَهِمَ الطَّالِبُ الْقَاعِدَةَ</span> و<span class="ar">فُهِمَتِ الْقَاعِدَةُ</span>: كانت القاعدة مفعولًا به منصوبًا، فلما حذف الفاعل وبني الفعل للمجهول صارت نائب فاعل مرفوعًا. وشرح صور النيابة كلها، عن المفعول وعن غيره، في درس <a href="/duroos/naib-al-fail">نائب الفاعل</a>.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="word-order"
    title="ترتيب أركان الجملة الفعلية"
    lead="الأصل في الترتيب: فعل ثم فاعل ثم مفعول به. والفاعل لا يتقدم على فعله عند البصريين، فإن تقدم الاسم صارت الجملة اسمية. أما المفعول به فيجوز تقديمه على الفاعل أو على الفعل نفسه، وقد يجب."
  >
    <ul>
      <li><strong>يجب تقديم المفعول به على الفعل</strong> إذا كان مما له الصدارة كاسم الاستفهام: <span class="ar">مَاذَا كَتَبْتَ؟</span>، أو كان ضميرًا منفصلًا يفيد تقديمه الحصر.</li>
      <li><strong>يجب تقديم المفعول به على الفاعل</strong> إذا كان ضميرًا متصلًا والفاعل اسمًا ظاهرًا: <span class="ar">أَكْرَمَنِي الْمُعَلِّمُ</span>، أو اتصل بالفاعل ضمير يعود على المفعول: <span class="ar">أَكْرَمَ الطَّالِبَ مُعَلِّمُهُ</span>.</li>
      <li><strong>يجب التزام الأصل</strong> عند خوف اللبس، كأن تخفى الحركات: <span class="ar">أَكْرَمَ مُوسَى عِيسَى</span>، فالمتقدم هو الفاعل.</li>
    </ul>
    <p><strong>مثال معرب على التقديم الواجب:</strong> <span class="ar">إِيَّاكَ نَعْبُدُ</span>: إياك ضمير منفصل مبني على الفتح في محل نصب مفعول به مقدم وجوبًا، نعبد فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة، والفاعل ضمير مستتر وجوبًا تقديره نحن.</p>
    <p>وإذا أشكل عليك ترتيب جملة حقيقية فراجع صيغة السطر الإعرابي في مرجع <a href="/irab">الإعراب</a>، ثم جرب الجملة نفسها في المحلل على الصفحة الرئيسية وانظر كيف يفصل بين الفاعل والمفعول به.</p>
  </ArticleSection>

