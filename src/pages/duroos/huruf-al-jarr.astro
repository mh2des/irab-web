---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';

const faqs = [
  { q: 'كم عدد حروف الجر؟', a: 'المشهور في المتون عشرون حرفًا جمعها ابن مالك في الألفية، وأكثرها دورانًا تسعة: من، إلى، عن، على، في، الباء، الكاف، اللام، ورب، ويضاف إليها واو القسم وتاؤه ومذ ومنذ وحتى.' },
  { q: 'لماذا تسمى حروف الجر بهذا الاسم؟', a: 'لأنها تجر معنى الفعل إلى الاسم، أي توصله إليه، ولأن عملها الإعرابي جر الاسم بعدها. ويسميها الكوفيون حروف الخفض وحروف الإضافة.' },
  { q: 'ما معنى "التعلق" في الجار والمجرور؟', a: 'الجار والمجرور لا يقفان وحدهما، بل يرتبطان بفعل أو ما يشبهه يتمم معناهما. في "جلستُ في المسجدِ" شبه الجملة متعلق بالفعل جلس. وإن لم يوجد ما يتعلقان به ظاهرًا قُدر كونٌ عام محذوف كما في خبر المبتدأ: "الكتابُ على الطاولةِ".' },
  { q: 'هل تجر حروف الجر الأفعال؟', a: 'لا، حروف الجر مختصة بالأسماء ولا تدخل على الأفعال أبدًا، ولذلك عدت دخولها على الكلمة علامة على اسميتها. وأما "حتى" الداخلة على المضارع فحرف نصب بأن مضمرة لا حرف جر.' },
  { q: 'ما إعراب الاسم بعد "رُبَّ"؟', a: 'اسم مجرور لفظًا بها، وهو في المعنى مبتدأ أو غيره بحسب الجملة، فيقال: مجرور لفظًا مرفوع محلًا. نحو: رُبَّ ضارةٍ نافعةٌ.' },
  { q: 'كيف يجر الممنوع من الصرف بعد حرف الجر؟', a: 'بالفتحة نيابة عن الكسرة ما لم يقترن بأل أو يضف: مررتُ بمساجدَ عظيمةٍ، لكن: مررتُ بالمساجدِ ومساجدِ المدينةِ بالكسرة.' },
];
---
<BaseLayout
  lang="ar"
  title="حروف الجر: معانيها وعملها والتعلق · إعراب"
  description="شرح حروف الجر: عملها في الأسماء، معاني من وإلى وعن وعلى وفي والباء واللام والكاف، علامات الجر الأصلية والفرعية، والتعلق، مع أمثلة قرآنية معربة."
>
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="حروف الجر"
    summary="حروف الجر مفاتيح المعاني: حروف مختصة بالأسماء تجر ما بعدها وتصل معنى الفعل إليه. إتقانها إتقان لنصف الإعراب العملي، فقلّ أن تخلو جملة من جار ومجرور. هذا الدرس يعرض عملها ومعانيها وعلامات الجر بعدها ومسألة التعلق، بأمثلة معربة كاملة."
  />

  <ArticleSection
    lang="ar"
    id="definition"
    title="العمل والاختصاص"
    lead="حرف الجر لا يدخل إلا على اسم، فيجره. وهو مبني لا محل له من الإعراب، والاسم بعده مجرور بالكسرة أو ما ينوب عنها."
  >
    <p><span class="ar">صَلَّيْتُ فِي الْمَسْجِدِ</span></p>
    <p><strong>الإعراب:</strong> صليتُ فعل ماضٍ مبني على السكون لاتصاله بتاء الفاعل، والتاء ضمير متصل مبني في محل رفع فاعل. في حرف جر مبني على السكون لا محل له من الإعراب. المسجدِ اسم مجرور بفي وعلامة جره الكسرة الظاهرة، والجار والمجرور متعلقان بالفعل صليتُ.</p>
    <p>ودخول حرف الجر علامة على الاسمية: فكل ما قبل حرفُ جرٍّ فهو اسم قطعًا، وهذه من أنفع القرائن عند تحليل الجملة في <a href="/irab">الإعراب</a>.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="meanings"
    title="معاني أشهر الحروف"
    lead="لكل حرف معنى رئيس ومعانٍ فرعية يعينها السياق. هذه أشهر تسعة حروف بمعانيها الغالبة."
  >
    <ul>
      <li><span class="ar">مِنْ</span>: ابتداء الغاية والتبعيض، <span class="ar">خَرَجْتُ مِنَ الْبَيْتِ</span>.</li>
      <li><span class="ar">إِلَى</span>: انتهاء الغاية، <span class="ar">﴿سُبْحَانَ الَّذِي أَسْرَى بِعَبْدِهِ لَيْلًا مِنَ الْمَسْجِدِ الْحَرَامِ إِلَى الْمَسْجِدِ الْأَقْصَى﴾</span> جمعت الآية ابتداء الغاية وانتهاءها.</li>
      <li><span class="ar">عَنْ</span>: المجاوزة، <span class="ar">ابْتَعِدْ عَنِ الْكَسَلِ</span>.</li>
      <li><span class="ar">عَلَى</span>: الاستعلاء، <span class="ar">الْكِتَابُ عَلَى الطَّاوِلَةِ</span>.</li>
      <li><span class="ar">فِي</span>: الظرفية مكانًا وزمانًا، <span class="ar">الْعِلْمُ فِي الصُّدُورِ</span>.</li>
      <li><span class="ar">الْبَاء</span>: الإلصاق والاستعانة والسببية، <span class="ar">كَتَبْتُ بِالْقَلَمِ</span>.</li>
      <li><span class="ar">اللَّام</span>: الملك والاختصاص والتعليل، <span class="ar">الْحَمْدُ لِلَّهِ</span>.</li>
      <li><span class="ar">الْكَاف</span>: التشبيه، <span class="ar">الْعِلْمُ كَالنُّورِ</span>.</li>
      <li><span class="ar">رُبَّ</span>: التقليل أو التكثير، <span class="ar">رُبَّ ضَارَّةٍ نَافِعَةٌ</span>.</li>
    </ul>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">اكشف معنى الحرف في جملتك.</span>
    ألصق أي جملة فيها جار ومجرور في محلّل الإعراب، وسيبين لك الحرف وعمله والاسم المجرور وعلامة جره وما يتعلقان به.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="signs"
    title="علامات الجر بعد الحرف"
    lead="الأصل الجر بالكسرة، وينوب عنها الياء في المثنى والجمع السالم والأسماء الخمسة، والفتحة في الممنوع من الصرف."
  >
    <ul>
      <li><strong>الكسرة:</strong> <span class="ar">مَرَرْتُ بِالْمَسْجِدِ</span>.</li>
      <li><strong>الياء في المثنى:</strong> <span class="ar">سَلَّمْتُ عَلَى الطَّالِبَيْنِ</span>، الطالبين اسم مجرور وعلامة جره الياء لأنه مثنى.</li>
      <li><strong>الياء في جمع المذكر السالم:</strong> <span class="ar">مَرَرْتُ بِالْمُعَلِّمِينَ</span>.</li>
      <li><strong>الياء في الأسماء الخمسة:</strong> <span class="ar">سَلَّمْتُ عَلَى أَبِيكَ</span>، أبي اسم مجرور وعلامة جره الياء لأنه من <a href="/duroos/al-asma-al-khamsa">الأسماء الخمسة</a> وهو مضاف والكاف مضاف إليه.</li>
      <li><strong>الفتحة في الممنوع من الصرف:</strong> <span class="ar">مَرَرْتُ بِمَسَاجِدَ عَظِيمَةٍ</span>، وتفصيله في <a href="/duroos/al-mamnu-min-al-sarf">درسه</a>.</li>
    </ul>
    <p>وجدول العلامات كاملًا في <a href="/duroos/alamat-al-irab">علامات الإعراب</a>.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="taalluq"
    title="التعلق: بماذا يرتبط الجار والمجرور"
    lead="شبه الجملة لا يتم معناه وحده، فلا بد له من متعلق: فعل أو وصف يعمل عمله، فإن لم يوجد قُدر محذوف."
  >
    <ul>
      <li><strong>التعلق بفعل ظاهر:</strong> <span class="ar">جَلَسْتُ فِي الْمَسْجِدِ</span>، متعلقان بجلستُ.</li>
      <li><strong>التعلق بوصف:</strong> <span class="ar">أَنَا رَاغِبٌ فِي الْعِلْمِ</span>، متعلقان باسم الفاعل راغب.</li>
      <li><strong>التعلق بمحذوف خبر:</strong> <span class="ar">الْكِتَابُ عَلَى الطَّاوِلَةِ</span>: الكتابُ <a href="/duroos/al-mubtada-wal-khabar">مبتدأ</a> مرفوع، وشبه الجملة متعلق بمحذوف خبر تقديره كائنٌ أو مستقرٌّ.</li>
      <li><strong>التعلق بمحذوف نعت:</strong> <span class="ar">رَأَيْتُ عُصْفُورًا عَلَى الْغُصْنِ</span>، متعلقان بمحذوف <a href="/duroos/al-naat">نعت</a>.</li>
    </ul>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="common-mistakes"
    title="أخطاء شائعة"
    lead="أشيع أخطاء الباب الخلط بين الجر بالحرف والجر بالإضافة، ونصب الاسم بعد الحرف، وإدخال الحرف على الفعل."
  >
    <ul>
      <li>يقال خطأً "ذهبتُ إلى المدرسةَ" بالنصب، والصواب <span class="ar">إِلَى الْمَدْرَسَةِ</span> بالجر.</li>
      <li>الاسم المجرور بعد اسم قبله لا حرف معه مجرور بالإضافة لا بالحرف: في <span class="ar">كِتَابُ النَّحْوِ</span> النحوِ مضاف إليه، وتفصيله في درس <a href="/duroos/al-idafa">الإضافة</a>.</li>
      <li>"حتى" الجارة تدخل على الاسم: <span class="ar">أَكَلْتُ السَّمَكَةَ حَتَّى رَأْسِهَا</span>، فإذا دخلت على مضارع فهي ناصبة به بأن مضمرة، وبيانه في <a href="/duroos/nasb-al-mudari">نصب المضارع</a>.</li>
    </ul>
  </ArticleSection>

  <ArticleFaq lang="ar" items={faqs} />

  <Footer lang="ar" />
</BaseLayout>
