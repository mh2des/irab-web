---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';

const faqs = [
  { q: 'ما الفرق بين البدل وعطف البيان؟', a: 'كلاهما تابع يوضح متبوعه، والفرق دقيق: البدل مقصود بالحكم والمبدل منه توطئة له، وعطف البيان موضح لمتبوعه والمتبوع هو المقصود. كثير من النحاة يجيز الوجهين في نحو "جاء أخوك محمدٌ".' },
  { q: 'ما الفرق بين البدل والنعت؟', a: 'النعت يصف متبوعه بصفة من صفاته وهو مشتق غالبًا، والبدل هو المتبوع نفسه أو جزء منه وهو جامد غالبًا. "جاء الطالبُ المجتهدُ" نعت، و"جاء الطالبُ محمدٌ" بدل مطابق.' },
  { q: 'هل يشترط في بدل البعض والاشتمال ضمير؟', a: 'نعم، يشترط اتصالهما بضمير يعود على المبدل منه: أكلتُ الرغيفَ نصفَه، وأعجبني الطالبُ خلقُه. أما البدل المطابق فلا ضمير معه.' },
  { q: 'كيف أفرق بين بدل البعض وبدل الاشتمال؟', a: 'بدل البعض جزء حسي مادي من المبدل منه (نصف الرغيف من الرغيف)، وبدل الاشتمال معنى مما يشتمل عليه المبدل منه لا جزء مادي (الخلق من الطالب، والعلم من الشيخ).' },
  { q: 'هل يبدل الفعل من الفعل؟', a: 'نعم، نحو قوله تعالى: ﴿وَمَنْ يَفْعَلْ ذَلِكَ يَلْقَ أَثَامًا * يُضَاعَفْ لَهُ الْعَذَابُ﴾، فيضاعفْ بدل من يلقَ مجزوم مثله، لأن مضاعفة العذاب هي لقي الأثام.' },
  { q: 'ما إعراب الاسم بعد اسم الإشارة؟', a: 'إذا كان معرفًا بأل فالمختار إعرابه بدلًا من اسم الإشارة: "هذا الكتابُ مفيدٌ"، الكتابُ بدل من هذا مرفوع مثله. ويجيز بعضهم إعرابه عطف بيان.' },
];
---
<BaseLayout
  lang="ar"
  title="البدل: أنواعه الثلاثة وإعرابه بالأمثلة · إعراب"
  description="شرح البدل: البدل المطابق وبدل البعض من الكل وبدل الاشتمال، شرط الضمير الرابط، إعراب البدل تبعًا للمبدل منه، والبدل بعد اسم الإشارة، مع أمثلة قرآنية معربة."
>
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="البدل"
    summary="البدل تابع مقصود بالحكم بلا واسطة حرف، يمهد له بذكر متبوعه ثم يقع عليه الحكم نفسه. أنواعه ثلاثة مشهورة: المطابق، وبعض من كل، والاشتمال. هذا الدرس يعرضها بأمثلتها المعربة، ويبين شرط الضمير، وإعراب الاسم المعرف بعد اسم الإشارة."
  />

  <ArticleSection
    lang="ar"
    id="definition"
    title="التعريف والإعراب"
    lead="البدل يتبع المبدل منه في إعرابه رفعًا ونصبًا وجرًّا، من غير حرف يتوسط بينهما، وهذا ما يفرقه عن العطف."
  >
    <p><span class="ar">جَاءَ الْخَلِيفَةُ عُمَرُ</span></p>
    <p><strong>الإعراب:</strong> جاء فعل ماضٍ مبني على الفتح. الخليفةُ <a href="/duroos/al-fail">فاعل</a> مرفوع وعلامة رفعه الضمة الظاهرة. عمرُ بدل مطابق من الخليفة مرفوع مثله، ولم ينون لأنه ممنوع من الصرف للعلمية والعدل، وبيانه في <a href="/duroos/al-mamnu-min-al-sarf">درسه</a>.</p>
    <p>فالمقصود بالمجيء هو عمر، وذكر الخليفة توطئة وتمهيد. ولو حذفت المبدل منه لاستقامت الجملة: جاء عمرُ.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="types"
    title="أنواع البدل الثلاثة"
    lead="البدل المطابق هو عين المبدل منه، وبدل البعض جزء حسي منه، وبدل الاشتمال معنى مما يشتمل عليه. والأخيران لا بد فيهما من ضمير يعود على المبدل منه."
  >
    <ul>
      <li><strong>البدل المطابق (كل من كل):</strong> <span class="ar">﴿اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ * صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ﴾</span>، صراطَ الثانية بدل مطابق من الصراط الأولى منصوب مثلها وعلامة نصبه الفتحة الظاهرة وهو مضاف.</li>
      <li><strong>بدل بعض من كل:</strong> <span class="ar">أَكَلْتُ الرَّغِيفَ نِصْفَهُ</span>، نصفَ بدل بعض من كل منصوب وعلامة نصبه الفتحة وهو مضاف، والهاء ضمير متصل مبني في محل جر مضاف إليه، والضمير رابط بين البدل والمبدل منه.</li>
      <li><strong>بدل اشتمال:</strong> <span class="ar">أَعْجَبَنِي الطَّالِبُ خُلُقُهُ</span>، خلقُ بدل اشتمال مرفوع وعلامة رفعه الضمة وهو مضاف والهاء مضاف إليه، والخلق معنى يشتمل عليه الطالب لا جزء حسي منه.</li>
    </ul>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">ميّز نوع البدل في جملتك.</span>
    ألصق جملة فيها بدل في محلّل الإعراب وشاهده يعين المبدل منه ونوع البدل وعلامة الإعراب المشتركة بينهما.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="demonstratives"
    title="البدل بعد اسم الإشارة"
    lead="الاسم المعرف بأل بعد اسم الإشارة يعرب بدلًا منه على المختار، وهو من أكثر مواضع البدل دورانًا في الكلام."
  >
    <p><span class="ar">هَذَا الْكِتَابُ مُفِيدٌ</span></p>
    <p><strong>الإعراب:</strong> هذا: الهاء للتنبيه، ذا اسم إشارة مبني على السكون في محل رفع <a href="/duroos/al-mubtada-wal-khabar">مبتدأ</a>. الكتابُ بدل من اسم الإشارة مرفوع مثله وعلامة رفعه الضمة الظاهرة. مفيدٌ خبر المبتدأ مرفوع وعلامة رفعه الضمة الظاهرة.</p>
    <p>ومنه قوله تعالى: <span class="ar">﴿إِنَّ هَذَا الْقُرْآنَ يَهْدِي لِلَّتِي هِيَ أَقْوَمُ﴾</span>: هذا اسم إشارة مبني في محل نصب اسم إنّ، القرآنَ بدل منه منصوب وعلامة نصبه الفتحة، وعمل إنّ كله في <a href="/duroos/inna-wa-akhawatuha">درسها</a>.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="common-mistakes"
    title="أخطاء شائعة"
    lead="أشيع أخطاء الباب مخالفة البدل لمتبوعه في الإعراب، وإغفال الضمير في بدلي البعض والاشتمال، والخلط بينه وبين النعت."
  >
    <ul>
      <li>يقال خطأً "قرأتُ الكتابَ نصفُه" برفع البدل، والصواب <span class="ar">نِصْفَهُ</span> بالنصب تبعًا للمفعول به.</li>
      <li>لا يصح "أكلتُ الرغيفَ نصفًا" في إرادة البدل بلا ضمير، والصواب <span class="ar">نِصْفَهُ</span>، فالضمير شرط في بدل البعض والاشتمال.</li>
      <li>البدل جامد غالبًا والمقصود بالحكم، بخلاف <a href="/duroos/al-naat">النعت</a> المشتق الواصف، والتوابع الأخرى في <a href="/duroos/al-atf">العطف</a> و<a href="/duroos/al-tawkid">التوكيد</a>.</li>
    </ul>
    <p>وتمام النظرية في <a href="/nahw">ما هو النحو</a>، وتطبيقها على أي جملة في <a href="/irab">الإعراب</a>.</p>
  </ArticleSection>

  <ArticleFaq lang="ar" items={faqs} />

  <Footer lang="ar" />
</BaseLayout>
