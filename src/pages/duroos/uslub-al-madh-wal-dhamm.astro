---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import Byline from '../../components/Byline.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';
import AyatExamples from '../../components/duroos/AyatExamples.astro';

const faqs = [
  { q: 'لماذا نعم وبئس فعلان جامدان؟', a: 'لأنهما لا يتصرفان: لا مضارع لهما ولا أمر ولا مصدر، ولزما صيغة الماضي لإنشاء المدح والذم لا للإخبار عن حدث مضى. وفعليتهما ثابتة باتصال تاء التأنيث بهما: "نعمت المرأةُ" و"بئست الخصلةُ".' },
  { q: 'ما إعراب المخصوص بالمدح أو الذم؟', a: 'فيه وجهان مشهوران: مبتدأ مؤخر خبره الجملة الفعلية قبله، أو خبر لمبتدأ محذوف وجوبًا تقديره هو. ففي "نعم الرجلُ زيدٌ" تقول: زيدٌ مبتدأ مؤخر مرفوع وجملة نعم الرجل في محل رفع خبر مقدم، أو خبر لمبتدأ محذوف تقديره هو زيد.' },
  { q: 'ما الفرق بين نعم ونعمّا؟', a: 'نعمّا أصلها نعم ما: نعم فعل المدح، وما اسم موصول أو نكرة تامة بمعنى شيء في محل رفع فاعل، وأدغمت الميم في الميم. ومنه قوله تعالى: "إن تبدوا الصدقات فنعمّا هي"، أي فنعم الشيءُ هي.' },
  { q: 'هل يذم بحبذا؟', a: 'حبذا للمدح خاصة، فإذا أريد الذم دخلت عليها لا: "لا حبذا الكذبُ". وحبذا تلزم صيغة واحدة فلا تؤنث ولا تثنى ولا تجمع، بل يقال "حبذا هندُ" و"حبذا الطالبان" على لفظ واحد.' },
  { q: 'هل يجوز تقديم المخصوص على الفعل؟', a: 'نعم، فتقول "زيدٌ نعم الرجلُ"، وحينئذ يعرب زيدٌ مبتدأ مرفوعًا، وجملة نعم الرجل في محل رفع خبره لا غير، ولا يجوز فيه الوجه الثاني.' },
  { q: 'ما ساء في باب الذم؟', a: 'ساء فعل جامد يعمل عمل بئس في الذم: "ساء العملُ الغشُّ". وكل فعل ثلاثي صيغ على وزن فَعُلَ يجوز أن يجرى مجرى نعم وبئس في المدح والذم: "كرُم الرجلُ زيدٌ" و"لؤُم الرجلُ عمرٌو".' },
];
---
<BaseLayout
  lang="ar"
  hasEn
  title="أسلوب المدح والذم: نعم وبئس وحبذا وإعراب المخصوص · إعراب آب"
  description="شرح أسلوب المدح والذم: نعم وبئس فعلان جامدان، صور فاعلهما الأربع، إعراب المخصوص بالمدح أو الذم وحذفه، وحبذا ولا حبذا، مع أمثلة معربة كاملة وشواهد قرآنية."
>
  <ArticleSchema slot="head" lang="ar" kind="lesson" headline="أسلوب المدح والذم" description="شرح أسلوب المدح والذم: نعم وبئس فعلان جامدان، صور فاعلهما الأربع، إعراب المخصوص بالمدح أو الذم وحذفه، وحبذا ولا حبذا، مع أمثلة معربة كاملة وشواهد قرآنية." />
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="أسلوب المدح والذم"
    summary="نعم وبئس فعلان ماضيان جامدان وضعا لإنشاء المدح والذم، ولهما فاعل لا يكون إلا على صور محدودة، ثم اسم مرفوع بعدهما هو المخصوص بالمدح أو الذم. ومثلهما حبذا في المدح ولا حبذا في الذم. هذا الدرس يعرض صور الفاعل وإعراب المخصوص ومواضع حذفه، بأمثلة معربة كاملة وشواهد من القرآن الكريم."
  />
  <Byline lang="ar" kind="lesson" />

  <ArticleSection
    lang="ar"
    id="definition"
    title="نعم وبئس وعملهما"
    lead="نعم فعل لإنشاء المدح، وبئس فعل لإنشاء الذم. لكل منهما فاعل مرفوع، ثم يأتي بعدهما المخصوص بالمدح أو الذم مرفوعًا."
  >
    <p><span class="ar">نِعْمَ الرَّجُلُ زَيْدٌ</span></p>
    <p><strong>الإعراب:</strong> <span class="ar">نِعْمَ</span>: فعل ماضٍ جامد لإنشاء المدح مبني على الفتح. <span class="ar">الرَّجُلُ</span>: فاعل مرفوع وعلامة رفعه الضمة الظاهرة على آخره. <span class="ar">زَيْدٌ</span>: مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة، والجملة الفعلية قبله في محل رفع خبر مقدم. ويجوز إعرابه خبرًا لمبتدأ محذوف وجوبًا تقديره هو.</p>
    <p>فالجملة في حقيقتها جملة اسمية قدم خبرها، وراجع أحكام التقديم في درس <a href="/duroos/al-mubtada-wal-khabar">المبتدأ والخبر</a>، وأحكام <a href="/duroos/al-fail">الفاعل</a> في درسه.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="fail-forms"
    title="صور فاعل نعم وبئس"
    lead="لا يكون فاعلهما إلا واحدًا من أربعة: معرفًا بأل، أو مضافًا إلى معرف بأل، أو ضميرًا مستترًا يفسره تمييز بعده، أو ما."
  >
    <ul>
      <li><strong>المعرف بأل</strong>: <span class="ar">نِعْمَ الْخُلُقُ الصِّدْقُ</span>، الخلقُ فاعل مرفوع.</li>
      <li><strong>المضاف إلى المعرف بأل</strong>: <span class="ar">نِعْمَ صَاحِبُ الْعِلْمِ زَيْدٌ</span>، صاحبُ فاعل مرفوع وهو مضاف، والعلمِ مضاف إليه.</li>
      <li><strong>الضمير المستتر المفسر بتمييز</strong>: <span class="ar">نِعْمَ رَجُلًا خَالِدٌ</span>، الفاعل ضمير مستتر وجوبًا تقديره هو، ورجلًا تمييز منصوب يفسره، وتفصيله في درس <a href="/duroos/al-tamyiz">التمييز</a>.</li>
      <li><strong>ما</strong>: <span class="ar">بِئْسَمَا صَنَعْتَ</span>، ما نكرة تامة بمعنى شيء أو اسم موصول في محل رفع فاعل.</li>
    </ul>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">امدح وذمّ بجملتك.</span>
    ألصق جملة تبدأ بنعم أو بئس أو حبذا في محلل الإعراب، وشاهده يبين الفاعل والمخصوص ويعلل رفعهما.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="makhsus"
    title="المخصوص بالمدح أو الذم"
    lead="المخصوص اسم مرفوع يذكر بعد الفعل وفاعله ليبين من وقع عليه المدح أو الذم. ويجوز حذفه إذا دل عليه دليل، ويجوز تقديمه على الفعل."
  >
    <ul>
      <li><strong>ذكره</strong>: <span class="ar">بِئْسَ الْخُلُقُ الْكَذِبُ</span>، الكذبُ مبتدأ مؤخر أو خبر لمبتدأ محذوف.</li>
      <li><strong>حذفه</strong>: كقوله تعالى <span class="ar">نِعْمَ ٱلْعَبْدُ</span> أي سليمان، وقوله <span class="ar">وَبِئْسَ ٱلْمَصِيرُ</span> أي عذاب النار.</li>
      <li><strong>تقديمه</strong>: <span class="ar">زَيْدٌ نِعْمَ الرَّجُلُ</span>، زيدٌ مبتدأ، وجملة نعم الرجل في محل رفع خبر.</li>
    </ul>
    <p>وحبذا للمدح: <span class="ar">حَبَّذَا الصِّدْقُ</span>، حبَّ فعل ماضٍ جامد، وذا اسم إشارة مبني في محل رفع فاعل، والصدقُ مبتدأ مؤخر أو خبر لمبتدأ محذوف. وللذم: <span class="ar">لَا حَبَّذَا الْكَذِبُ</span>. وبيان أسماء الإشارة في <a href="/duroos/asma-al-ishara">درسها</a>.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="common-mistakes"
    title="أخطاء شائعة"
    lead="أشيع الأخطاء نصب المخصوص، وتنكير الفاعل من غير تمييز، وتغيير صيغة حبذا بالتأنيث أو التثنية."
  >
    <ul>
      <li>يقال خطأً "نعم الرجلُ زيدًا" بالنصب، والصواب <span class="ar">نِعْمَ الرَّجُلُ زَيْدٌ</span>، فالمخصوص مرفوع لأنه مبتدأ أو خبر.</li>
      <li>يقال خطأً "نعم رجلٌ زيدٌ" بالرفع، والصواب <span class="ar">نِعْمَ الرَّجُلُ زَيْدٌ</span> بالتعريف، أو <span class="ar">نِعْمَ رَجُلًا زَيْدٌ</span> بنصب النكرة تمييزًا.</li>
      <li>يقال خطأً "حبذت الفتاةُ"، والصواب <span class="ar">حَبَّذَا الْفَتَاةُ</span>، فحبذا تلزم صيغة واحدة مع المذكر والمؤنث والمثنى والجمع.</li>
    </ul>
    <p>وأخو هذا الباب في الجمود والإنشاء <a href="/duroos/uslub-al-taajjub">أسلوب التعجب</a>.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="worked-examples"
    title="أمثلة معربة إعرابًا كاملًا"
    lead="هذه نماذج جاهزة بالصياغة الكلاسيكية المعتمدة في كتب النحو، تصلح مراجعة سريعة قبل الامتحان وقالبًا تحاكيه في إعرابك."
  >
    <p><strong>المثال الأول</strong>: <span class="ar">بِئْسَ الْخُلُقُ الْكَذِبُ</span>: <span class="ar">بِئْسَ</span>: فعل ماضٍ جامد لإنشاء الذم مبني على الفتح. <span class="ar">الْخُلُقُ</span>: فاعل مرفوع وعلامة رفعه الضمة الظاهرة. <span class="ar">الْكَذِبُ</span>: مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة، والجملة الفعلية قبله في محل رفع خبر مقدم.</p>
    <p><strong>المثال الثاني</strong>: <span class="ar">نِعْمَ رَجُلًا خَالِدٌ</span>: <span class="ar">نِعْمَ</span>: فعل ماضٍ جامد لإنشاء المدح مبني على الفتح، والفاعل ضمير مستتر وجوبًا تقديره هو. <span class="ar">رَجُلًا</span>: تمييز منصوب وعلامة نصبه الفتحة الظاهرة يفسر الضمير المستتر. <span class="ar">خَالِدٌ</span>: مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة، والجملة قبله في محل رفع خبر مقدم.</p>
    <p><strong>المثال الثالث</strong>: <span class="ar">نِعْمَ صَاحِبُ الْعِلْمِ زَيْدٌ</span>: <span class="ar">نِعْمَ</span>: فعل ماضٍ جامد لإنشاء المدح مبني على الفتح. <span class="ar">صَاحِبُ</span>: فاعل مرفوع وعلامة رفعه الضمة الظاهرة، وهو مضاف. <span class="ar">الْعِلْمِ</span>: مضاف إليه مجرور وعلامة جره الكسرة الظاهرة. <span class="ar">زَيْدٌ</span>: مبتدأ مؤخر مرفوع، والجملة قبله في محل رفع خبر مقدم.</p>
    <p><strong>المثال الرابع</strong>: <span class="ar">حَبَّذَا الصِّدْقُ</span>: <span class="ar">حَبَّ</span>: فعل ماضٍ جامد لإنشاء المدح مبني على الفتح. <span class="ar">ذَا</span>: اسم إشارة مبني على السكون في محل رفع فاعل. <span class="ar">الصِّدْقُ</span>: مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة، وجملة حبذا في محل رفع خبر مقدم.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="in-quran"
    title="من القرآن الكريم"
    lead="قال تعالى في سورة ص: وَوَهَبْنَا لِدَاوُۥدَ سُلَيْمَٰنَ ۚ نِعْمَ ٱلْعَبْدُ ۖ إِنَّهُۥٓ أَوَّابٌ. نعم فعل المدح، والعبد فاعله، والمخصوص بالمدح محذوف دل عليه ما قبله."
  >
    <p><span class="ar">وَوَهَبْنَا لِدَاوُۥدَ سُلَيْمَٰنَ ۚ نِعْمَ ٱلْعَبْدُ ۖ إِنَّهُۥٓ أَوَّابٌ</span> (ص: ٣٠)</p>
    <p><strong>الإعراب:</strong> الواو استئنافية. وهبنا: فعل ماضٍ مبني على السكون لاتصاله بنا الفاعلين، ونا ضمير متصل مبني على السكون في محل رفع فاعل. لداودَ: جار ومجرور متعلقان بوهبنا، وعلامة الجر الفتحة لأنه ممنوع من الصرف. سليمانَ: مفعول به منصوب وعلامة نصبه الفتحة، ممنوع من الصرف. نعمَ: فعل ماضٍ جامد لإنشاء المدح مبني على الفتح. العبدُ: فاعل مرفوع وعلامة رفعه الضمة الظاهرة. والمخصوص بالمدح محذوف تقديره سليمان. إنه أوابٌ: إنّ حرف توكيد ونصب، والهاء اسمها في محل نصب، وأوابٌ خبرها مرفوع.</p>
    <p>ومن الذم قوله تعالى في البقرة: <span class="ar">وَبِئْسَ ٱلْمَصِيرُ</span>، بئسَ فعل ماضٍ جامد لإنشاء الذم، والمصيرُ فاعل مرفوع، والمخصوص بالذم محذوف تقديره عذاب النار. وفي الحجرات: <span class="ar">بِئْسَ ٱلِٱسْمُ ٱلْفُسُوقُ بَعْدَ ٱلْإِيمَٰنِ</span>، والفسوقُ خبر لمبتدأ محذوف وجوبًا وهو المخصوص بالذم. وتجد إعرابها كاملًا في <a href="/quran">إعراب القرآن</a>.</p>
  </ArticleSection>

