---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import Byline from '../../components/Byline.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';
import AyatExamples from '../../components/duroos/AyatExamples.astro';

const faqs = [
  { q: 'ما الفرق بين النعت والصفة؟', a: 'لا فرق في الاصطلاح الشائع، فالنعت والصفة اسمان لباب واحد. البصريون يغلب عليهم "الصفة" والكوفيون "النعت"، وكتب الإعراب المدرسية تستعملهما بمعنى واحد.' },
  { q: 'في كم شيء يتبع النعت الحقيقي منعوته؟', a: 'في أربعة من عشرة: واحد من أوجه الإعراب الثلاثة (رفع أو نصب أو جر)، وواحد من التعريف والتنكير، وواحد من التذكير والتأنيث، وواحد من الإفراد والتثنية والجمع.' },
  { q: 'ما النعت السببي وكيف يعمل؟', a: 'نعت يصف شيئًا مرتبطًا بالمنعوت لا المنعوت نفسه، نحو "جاءَ الرجلُ الكريمُ أبوهُ". يتبع منعوته في الإعراب والتعريف والتنكير فقط، ويلزم الإفراد، ويطابق ما بعده في التذكير والتأنيث.' },
  { q: 'هل تقع الجملة نعتًا؟', a: 'نعم بشرط أن يكون المنعوت نكرة، وتكون الجملة في محل رفع أو نصب أو جر بحسب المنعوت. نحو: "مررتُ برجلٍ يقرأُ"، جملة يقرأ في محل جر نعت لرجل. ومنه القاعدة: الجمل بعد النكرات صفات وبعد المعارف أحوال.' },
  { q: 'هل يتعدد النعت لمنعوت واحد؟', a: 'نعم، نحو قوله تعالى: ﴿إِنَّهُ لَقُرْآنٌ كَرِيمٌ فِي كِتَابٍ مَكْنُونٍ﴾ وتقول: هذا كتابٌ مفيدٌ ممتعٌ سهلٌ، فكلها نعوت مرفوعة تتبع المنعوت.' },
  { q: 'كيف أفرق بين النعت والحال؟', a: 'النعت يصف اسمًا ويتبعه في إعرابه، والحال تبين هيئة صاحبها وهي منصوبة دائمًا وصاحبها معرفة غالبًا. "جاء الطالبُ المجتهدُ" نعت مرفوع، و"جاء الطالبُ مسرعًا" حال منصوبة.' },
];
---
<BaseLayout
  lang="ar"
  title="النعت: الحقيقي والسببي وقواعد المطابقة · إعراب آب"
  description="شرح النعت (الصفة): تعريفه، النعت الحقيقي ومطابقته في أربعة من عشرة، النعت السببي وأحكامه، النعت الجملة وشبه الجملة، مع أمثلة معربة إعرابًا كاملًا."
>
  <ArticleSchema slot="head" lang="ar" kind="lesson" headline="النعت" description="شرح النعت (الصفة): تعريفه، النعت الحقيقي ومطابقته في أربعة من عشرة، النعت السببي وأحكامه، النعت الجملة وشبه الجملة، مع أمثلة معربة إعرابًا كاملًا." />
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="النعت"
    summary="النعت تابع يكمل منعوته ببيان صفة من صفاته أو صفات ما تعلق به. وهو أول التوابع وأكثرها استعمالًا، وقواعد مطابقته للمنعوت من أدق ما يمتحن به المعربون. هذا الدرس يفصل النعت الحقيقي والسببي والنعت الجملة، مع أمثلة معربة كاملة."
  />
  <Byline lang="ar" kind="lesson" />

  <ArticleSection
    lang="ar"
    id="definition"
    title="التعريف"
    lead="النعت تابع مشتق أو مؤول بالمشتق، يذكر لبيان صفة في متبوعه (الحقيقي) أو في شيء مرتبط بمتبوعه (السببي)، ويسمى الباب كله عند كثيرين بالصفة."
  >
    <p><span class="ar">جَاءَ الطَّالِبُ الْمُجْتَهِدُ</span></p>
    <p><strong>الإعراب:</strong> جاءَ فعل ماضٍ مبني على الفتح. الطالبُ <a href="/duroos/al-fail">فاعل</a> مرفوع وعلامة رفعه الضمة الظاهرة. المجتهدُ نعت مرفوع وعلامة رفعه الضمة الظاهرة.</p>
    <p>فالنعت تبع منعوته في الرفع، ولو نصب المنعوت أو جر لتبعه: <span class="ar">رَأَيْتُ الطَّالِبَ الْمُجْتَهِدَ</span>، <span class="ar">مَرَرْتُ بِالطَّالِبِ الْمُجْتَهِدِ</span>.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="haqiqi"
    title="النعت الحقيقي والمطابقة"
    lead="النعت الحقيقي يصف المنعوت نفسه، ويطابقه في أربعة من عشرة: الإعراب، والتعريف أو التنكير، والتذكير أو التأنيث، والإفراد أو التثنية أو الجمع."
  >
    <ul>
      <li><span class="ar">قَرَأْتُ كِتَابًا مُفِيدًا</span>: مفيدًا نعت منصوب، نكرة مثل منعوته، مذكر مفرد مثله.</li>
      <li><span class="ar">جَاءَتِ الطَّالِبَتَانِ الْمُجْتَهِدَتَانِ</span>: المجتهدتان نعت مرفوع وعلامة رفعه الألف لأنه مثنى، معرفة مؤنث مثنى كمنعوته.</li>
      <li><span class="ar">كَافَأْتُ الْمُعَلِّمِينَ الْمُخْلِصِينَ</span>: المخلصِينَ نعت منصوب وعلامة نصبه الياء لأنه جمع مذكر سالم.</li>
    </ul>
    <p>مثال قرآني: <span class="ar">﴿وَقُلْ رَبِّ أَدْخِلْنِي مُدْخَلَ صِدْقٍ﴾</span> ثم <span class="ar">﴿وَاجْعَلْ لِي مِنْ لَدُنْكَ سُلْطَانًا نَصِيرًا﴾</span>: نصيرًا نعت لسلطانًا منصوب مثله، نكرة مثله.</p>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">اختبر المطابقة بنفسك.</span>
    ألصق جملة فيها نعت في محلّل الإعراب وشاهده يعين المنعوت ويعلل التبعية في الإعراب والتعريف والعدد والجنس.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="sababi"
    title="النعت السببي"
    lead="النعت السببي يصف اسمًا ظاهرًا بعده مرتبطًا بالمنعوت بضمير. يتبع منعوته في الإعراب والتعريف والتنكير فقط، ويلزم الإفراد، ويطابق الاسم الذي بعده في التذكير والتأنيث."
  >
    <p><span class="ar">جَاءَ الرَّجُلُ الْكَرِيمُ أَبُوهُ</span></p>
    <p><strong>الإعراب:</strong> الرجلُ فاعل مرفوع. الكريمُ نعت سببي مرفوع تبعًا للرجل. أبوهُ فاعل للصفة المشبهة "الكريم" مرفوع وعلامة رفعه الواو لأنه من <a href="/duroos/al-asma-al-khamsa">الأسماء الخمسة</a>، والهاء ضمير متصل مبني في محل جر مضاف إليه يربط النعت بالمنعوت.</p>
    <p>ولو كان ما بعده مؤنثًا أُنِّث النعت تبعًا له لا للمنعوت: <span class="ar">جَاءَ الرَّجُلُ الْكَرِيمَةُ أُمُّهُ</span>. فالسببي ينظر إلى ما بعده في التذكير والتأنيث، وإلى ما قبله في الإعراب والتعريف.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="jumla"
    title="النعت الجملة وشبه الجملة"
    lead="تقع الجملة الفعلية والاسمية نعتًا لمنعوت نكرة، ويقع الظرف والجار والمجرور كذلك، ويكون النعت حينها في محل رفع أو نصب أو جر بحسب المنعوت."
  >
    <ul>
      <li><strong>جملة فعلية:</strong> <span class="ar">مَرَرْتُ بِرَجُلٍ يَقْرَأُ الْقُرْآنَ</span>، جملة "يقرأ" في محل جر نعت لرجل، وأصل بنائها في <a href="/duroos/al-jumla-al-filiyya">الجملة الفعلية</a>.</li>
      <li><strong>جملة اسمية:</strong> <span class="ar">اشْتَرَيْتُ كِتَابًا مَوْضُوعُهُ شَيِّقٌ</span>، الجملة الاسمية في محل نصب نعت لكتابًا، وتركيبها في درس <a href="/duroos/al-jumla-al-ismiyya">الجملة الاسمية</a>.</li>
      <li><strong>شبه جملة:</strong> <span class="ar">رَأَيْتُ عُصْفُورًا عَلَى الْغُصْنِ</span>، الجار والمجرور متعلقان بمحذوف نعت لعصفورًا في محل نصب.</li>
    </ul>
    <p>وضابط الباب المشهور: الجمل بعد النكرات صفات، وبعد المعارف أحوال، وفرقه عن <a href="/duroos/al-hal">الحال</a> مفصل في درسها.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="common-mistakes"
    title="أخطاء شائعة"
    lead="أشيع أخطاء الباب كسر المطابقة: نعت معرفة لنكرة، أو إتباع السببي لما بعده في الإعراب، أو معاملة الحال معاملة النعت."
  >
    <ul>
      <li>يقال خطأً "قرأتُ الكتابًا مفيدًا" بخلط التعريف والتنكير، والصواب <span class="ar">قَرَأْتُ كِتَابًا مُفِيدًا</span> أو <span class="ar">قَرَأْتُ الْكِتَابَ الْمُفِيدَ</span>.</li>
      <li>في السببي يقال خطأً "جاء الرجلُ الكريمُ أباه" بنصب ما بعد النعت، والصواب رفعه على الفاعلية: <span class="ar">الْكَرِيمُ أَبُوهُ</span>.</li>
      <li>النعت يتبع في الجر أيضًا، فيقال خطأً "مررتُ بالطالبِ المجتهدَ"، والصواب <span class="ar">بِالطَّالِبِ الْمُجْتَهِدِ</span>، وانظر عمل <a href="/duroos/huruf-al-jarr">حروف الجر</a>.</li>
    </ul>
    <p>وباقي التوابع في دروس <a href="/duroos/al-atf">العطف</a> و<a href="/duroos/al-badal">البدل</a> و<a href="/duroos/al-tawkid">التوكيد</a>، والأصل النظري في <a href="/nahw">ما هو النحو</a>.</p>
  </ArticleSection>

  <AyatExamples slug="al-naat" />

  <ArticleFaq lang="ar" items={faqs} />

  <Footer lang="ar" />
</BaseLayout>
