---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import Byline from '../../components/Byline.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';
import AyatExamples from '../../components/duroos/AyatExamples.astro';

const faqs = [
  { q: 'لماذا تقدر الحركات على المقصور والمنقوص؟', a: 'لأن الألف لا تقبل الحركة أصلًا، فتقدر عليها الحركات الثلاث ويقال منع من ظهورها التعذر. أما الياء فتقبل الفتحة بخفتها ولا تقبل الضمة والكسرة لثقلهما، فتقدر الضمة والكسرة على المنقوص ويقال منع من ظهورهما الثقل، وتظهر الفتحة.' },
  { q: 'متى تحذف ياء المنقوص؟', a: 'إذا كان نكرة غير مضاف حذفت ياؤه في حالتي الرفع والجر وعوض عنها التنوين: "جاء قاضٍ" و"مررت بقاضٍ"، وتثبت في النصب: "رأيت قاضيًا". فإذا عُرِّف بأل أو أضيف ثبتت الياء في الأحوال كلها: "جاء القاضي" و"قاضي المدينة".' },
  { q: 'كيف يثنى المقصور؟', a: 'إن كانت ألفه ثالثة ردت إلى أصلها: "فتى" أصل ألفه ياء فتقول "فتيان"، و"عصا" أصلها واو فتقول "عصوان". وإن كانت رابعة فأكثر قلبت ياء مطلقًا: "مستشفى" تقول "مستشفيان"، و"مصطفى" تقول "مصطفيان".' },
  { q: 'كيف يثنى الممدود؟', a: 'إن كانت همزته أصلية بقيت: "قرّاء" تقول "قرّاءان". وإن كانت زائدة للتأنيث قلبت واوًا: "صحراء" تقول "صحراوان". وإن كانت منقلبة عن أصل واو أو ياء جاز الوجهان: "سماء" تقول "سماءان" أو "سماوان".' },
  { q: 'هل الممدود ممنوع من الصرف؟', a: 'إذا كانت همزته للتأنيث فهو ممنوع من الصرف: "صحراء" و"حمراء" و"أسماء"، فيجر بالفتحة ما لم يعرف بأل أو يضف. وإذا كانت الهمزة أصلية أو منقلبة فهو مصروف: "سماءٍ" و"بناءٍ" بالتنوين.' },
  { q: 'ما الفرق بين ألف "الفتى" وألف "على"؟', a: 'المقصور اسم معرب تقدر عليه الحركات، أما "على" و"إلى" فحرفا جر مبنيان لا محل لهما من الإعراب، ولا يقال فيهما مقصور. والمقصور لا يكون إلا اسمًا معربًا آخره ألف لازمة.' },
];
---
<BaseLayout
  lang="ar"
  title="الاسم المقصور والمنقوص والممدود: إعرابها وتثنيتها · إعراب"
  description="الاسم المقصور والمنقوص والممدود: تعريف كل منها، إعرابها بالحركات المقدرة والظاهرة، حذف ياء المنقوص وتعويض التنوين، وتثنيتها وجمعها، مع أمثلة معربة كاملة."
>
  <ArticleSchema slot="head" lang="ar" kind="lesson" headline="الاسم المقصور والمنقوص والممدود" description="الاسم المقصور والمنقوص والممدود: تعريف كل منها، إعرابها بالحركات المقدرة والظاهرة، حذف ياء المنقوص وتعويض التنوين، وتثنيتها وجمعها، مع أمثلة معربة كاملة." />
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="المقصور والمنقوص والممدود"
    summary="ثلاثة أنواع من الأسماء المعربة يفرقها آخرها: ألف لازمة في المقصور، وياء لازمة قبلها كسرة في المنقوص، وهمزة بعد ألف زائدة في الممدود. وعلى هذا الآخر يتوقف إعرابها: أتظهر الحركة أم تقدر؟ هذا الدرس يعرف الأنواع الثلاثة، ويبين إعراب كل منها، ومتى تحذف ياء المنقوص، وكيف تثنى وتجمع، بأمثلة معربة كاملة."
  />
  <Byline lang="ar" kind="lesson" />

  <ArticleSection
    lang="ar"
    id="definition"
    title="الأنواع الثلاثة"
    lead="المقصور اسم معرب آخره ألف لازمة، والمنقوص اسم معرب آخره ياء لازمة مكسور ما قبلها، والممدود اسم معرب آخره همزة قبلها ألف زائدة."
  >
    <ul>
      <li><strong>المقصور</strong>: <span class="ar">الْفَتَى</span> و<span class="ar">الْهُدَى</span> و<span class="ar">الْعَصَا</span> و<span class="ar">الْمُسْتَشْفَى</span>.</li>
      <li><strong>المنقوص</strong>: <span class="ar">الْقَاضِي</span> و<span class="ar">الدَّاعِي</span> و<span class="ar">السَّاعِي</span> و<span class="ar">الْمُحَامِي</span>.</li>
      <li><strong>الممدود</strong>: <span class="ar">الصَّحْرَاءُ</span> و<span class="ar">السَّمَاءُ</span> و<span class="ar">الْبِنَاءُ</span> و<span class="ar">الْقُرَّاءُ</span>.</li>
    </ul>
    <p>وقيد "اسم معرب" يخرج الأفعال والحروف والأسماء المبنية: فألف <span class="ar">سَعَى</span> ألف فعل، وألف <span class="ar">عَلَى</span> ألف حرف، وياء <span class="ar">الَّذِي</span> ياء اسم مبني، فليست من هذا الباب. وقيد "لازمة" يخرج نحو <span class="ar">أَخُو</span> و<span class="ar">أَخِي</span> فالواو والياء فيهما عارضتان، وبيانهما في درس <a href="/duroos/al-asma-al-khamsa">الأسماء الخمسة</a>.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="irab"
    title="إعراب كل نوع"
    lead="المقصور تقدر عليه الحركات الثلاث. والمنقوص تقدر عليه الضمة والكسرة وتظهر الفتحة. والممدود تظهر عليه الحركات كلها على الهمزة."
  >
    <ul>
      <li><strong>المقصور</strong>: <span class="ar">جَاءَ الْفَتَى</span> و<span class="ar">رَأَيْتُ الْفَتَى</span> و<span class="ar">مَرَرْتُ بِالْفَتَى</span>: الحركة مقدرة على الألف في الأحوال كلها، منع من ظهورها التعذر.</li>
      <li><strong>المنقوص</strong>: <span class="ar">جَاءَ الْقَاضِي</span> بضمة مقدرة على الياء منع من ظهورها الثقل، و<span class="ar">مَرَرْتُ بِالْقَاضِي</span> بكسرة مقدرة كذلك، و<span class="ar">رَأَيْتُ الْقَاضِيَ</span> بفتحة ظاهرة.</li>
      <li><strong>الممدود</strong>: <span class="ar">هَذِهِ سَمَاءٌ</span> و<span class="ar">رَأَيْتُ سَمَاءً</span> و<span class="ar">نَظَرْتُ إِلَى سَمَاءٍ</span>: الحركات ظاهرة على الهمزة.</li>
    </ul>
    <p>فإذا كان المنقوص نكرة غير مضاف حذفت ياؤه رفعًا وجرًّا وعوض عنها التنوين: <span class="ar">مَرَرْتُ بِدَاعٍ إِلَى الْخَيْرِ</span>: داعٍ اسم مجرور بالباء وعلامة جره الكسرة المقدرة على الياء المحذوفة منع من ظهورها الثقل. وتثبت الياء في النصب: <span class="ar">سَمِعْتُ دَاعِيًا</span>. وراجع أصل الحركات وما ينوب عنها في درس <a href="/duroos/alamat-al-irab">علامات الإعراب</a>.</p>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">اختبر الحركة المقدرة.</span>
    ألصق جملة فيها اسم مقصور أو منقوص في محلل الإعراب، وشاهده يبين الحركة المقدرة وسبب تقديرها كلمة كلمة.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="dual-plural"
    title="التثنية والجمع"
    lead="عند التثنية والجمع يتغير آخر هذه الأسماء بقواعد مطردة: ترد ألف المقصور إلى أصلها أو تقلب ياء، وتبقى ياء المنقوص في التثنية وتحذف في جمع المذكر السالم، وتبقى همزة الممدود أو تقلب واوًا."
  >
    <ul>
      <li><strong>المقصور</strong>: إن كانت ألفه ثالثة ردت إلى أصلها: <span class="ar">فَتَى</span> فتيان، و<span class="ar">عَصَا</span> عصوان. وإن كانت رابعة فأكثر قلبت ياء: <span class="ar">مُسْتَشْفَى</span> مستشفيان. وفي جمع المذكر السالم تحذف الألف ويبقى ما قبلها مفتوحًا: <span class="ar">مُصْطَفَى</span> مصطفَوْن.</li>
      <li><strong>المنقوص</strong>: تثبت ياؤه في التثنية: <span class="ar">قَاضِيَانِ</span>، وتحذف في جمع المذكر السالم ويضم ما قبل الواو ويكسر ما قبل الياء: <span class="ar">قَاضُونَ</span> و<span class="ar">قَاضِينَ</span>.</li>
      <li><strong>الممدود</strong>: تبقى الهمزة الأصلية: <span class="ar">قُرَّاءَانِ</span>، وتقلب همزة التأنيث واوًا: <span class="ar">صَحْرَاوَانِ</span>، ويجوز الوجهان في المنقلبة عن أصل: <span class="ar">سَمَاءَانِ</span> و<span class="ar">سَمَاوَانِ</span>.</li>
    </ul>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="common-mistakes"
    title="أخطاء شائعة"
    lead="أشيع الأخطاء إثبات ياء المنقوص النكرة في الرفع والجر، وتقدير الفتحة على المنقوص، وتقدير الحركات على الممدود."
  >
    <ul>
      <li>يقال خطأً "جاء قاضي عادلٌ"، والصواب <span class="ar">جَاءَ قَاضٍ عَادِلٌ</span> بحذف الياء والتنوين، لأنه نكرة غير مضاف في حالة رفع.</li>
      <li>يقال خطأً "رأيت القاضي بفتحة مقدرة"، والصواب أن الفتحة ظاهرة على الياء: <span class="ar">رَأَيْتُ الْقَاضِيَ</span>، فالياء تقبل الفتحة لخفتها.</li>
      <li>يقال خطأً إن حركات الممدود مقدرة، والصواب أنها ظاهرة على الهمزة: <span class="ar">اتَّسَعَتِ الصَّحْرَاءُ</span>. وإنما الذي يحتاج إلى نظر منعه من الصرف إن كانت همزته للتأنيث، وتفصيله في درس <a href="/duroos/al-mamnu-min-al-sarf">الممنوع من الصرف</a>.</li>
    </ul>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="worked-examples"
    title="أمثلة معربة إعرابًا كاملًا"
    lead="هذه نماذج جاهزة بالصياغة الكلاسيكية المعتمدة في كتب النحو، تصلح مراجعة سريعة قبل الامتحان وقالبًا تحاكيه في إعرابك."
  >
    <p><strong>المثال الأول</strong>: <span class="ar">جَاءَ الْفَتَى</span>: <span class="ar">جَاءَ</span>: فعل ماضٍ مبني على الفتح. <span class="ar">الْفَتَى</span>: فاعل مرفوع وعلامة رفعه الضمة المقدرة على الألف منع من ظهورها التعذر.</p>
    <p><strong>المثال الثاني</strong>: <span class="ar">حَكَمَ الْقَاضِي بِالْعَدْلِ</span>: <span class="ar">حَكَمَ</span>: فعل ماضٍ مبني على الفتح. <span class="ar">الْقَاضِي</span>: فاعل مرفوع وعلامة رفعه الضمة المقدرة على الياء منع من ظهورها الثقل. <span class="ar">بِالْعَدْلِ</span>: الباء حرف جر، والعدلِ اسم مجرور وعلامة جره الكسرة الظاهرة، والجار والمجرور متعلقان بالفعل حكم.</p>
    <p><strong>المثال الثالث</strong>: <span class="ar">رَأَيْتُ قَاضِيًا عَادِلًا</span>: <span class="ar">رَأَيْتُ</span>: فعل ماضٍ مبني على السكون لاتصاله بتاء الفاعل، والتاء ضمير متصل مبني على الضم في محل رفع فاعل. <span class="ar">قَاضِيًا</span>: مفعول به منصوب وعلامة نصبه الفتحة الظاهرة، وقد ثبتت ياء المنقوص لأنه منصوب. <span class="ar">عَادِلًا</span>: نعت لقاضيًا منصوب مثله وعلامة نصبه الفتحة الظاهرة.</p>
    <p><strong>المثال الرابع</strong>: <span class="ar">سِرْتُ فِي الصَّحْرَاءِ</span>: <span class="ar">سِرْتُ</span>: فعل ماضٍ مبني على السكون لاتصاله بتاء الفاعل، والتاء ضمير متصل مبني على الضم في محل رفع فاعل. <span class="ar">فِي</span>: حرف جر مبني على السكون. <span class="ar">الصَّحْرَاءِ</span>: اسم مجرور وعلامة جره الكسرة الظاهرة على الهمزة، وقد جر بالكسرة مع أنه ممنوع من الصرف لتعريفه بأل، والجار والمجرور متعلقان بالفعل سرت.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="in-quran"
    title="من القرآن الكريم"
    lead="قال تعالى في آل عمران: قُلْ إِنَّ ٱلْهُدَىٰ هُدَى ٱللَّهِ. الهدى اسم مقصور، اسم إن منصوب بفتحة مقدرة على الألف، وهدى خبرها مرفوع بضمة مقدرة على الألف كذلك."
  >
    <p><span class="ar">قُلْ إِنَّ ٱلْهُدَىٰ هُدَى ٱللَّهِ</span> (آل عمران: ٧٣)</p>
    <p><strong>الإعراب:</strong> قلْ: فعل أمر مبني على السكون، والفاعل ضمير مستتر وجوبًا تقديره أنت. إنّ: حرف توكيد ونصب. الهدى: اسم إنّ منصوب وعلامة نصبه الفتحة المقدرة على الألف. هدى: خبر إنّ مرفوع وعلامة رفعه الضمة المقدرة على الألف، وهو مضاف. اللهِ: لفظ الجلالة مضاف إليه مجرور وعلامة جره الكسرة الظاهرة.</p>
    <p>ومن المنقوص قوله تعالى في طه: <span class="ar">فَٱقْضِ مَآ أَنتَ قَاضٍ</span>، فقاضٍ خبر المبتدأ أنت مرفوع، وعلامة رفعه الضمة المقدرة على الياء المحذوفة، فهو اسم منقوص نكرة حذفت ياؤه وعوض عنها التنوين. وتجد إعراب الآيتين كاملًا في <a href="/quran">إعراب القرآن</a>.</p>
  </ArticleSection>

  <AyatExamples slug="al-maqsur-wal-manqus-wal-mamdud" />

