---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import Byline from '../../components/Byline.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';
import AyatExamples from '../../components/duroos/AyatExamples.astro';

const faqs = [
  { q: 'لماذا تعرب الأسماء الخمسة بالحروف لا بالحركات؟', a: 'لأنها إذا استوفت شروطها أعربت بعلامات فرعية تنوب عن الأصلية: الواو تنوب عن الضمة، والألف عن الفتحة، والياء عن الكسرة. وعلل النحاة ذلك بأن إضافتها إلى ما بعدها أطالت الاسم فناسبه الإعراب بالحروف الطويلة، وهو باب من أبواب النيابة في علامات الإعراب.' },
  { q: 'هل هي خمسة أسماء أم ستة؟', a: 'المشهور في كتب المتأخرين خمسة: أب وأخ وحم وفو وذو. وزاد بعض النحاة سادسًا هو "هن"، لكن الفصيح فيه النقص، أي إعرابه بالحركات الظاهرة على النون، ولذلك قال ابن مالك: والنقص في هذا الأخير أحسن. فجرى أكثر المصنفين على تسميتها الأسماء الخمسة.' },
  { q: 'كيف تعرب كلمة أب إذا أضيفت إلى ياء المتكلم؟', a: 'تعرب بحركات مقدرة، نحو "جاء أبي": فاعل مرفوع وعلامة رفعه الضمة المقدرة على ما قبل الياء منع من ظهورها اشتغال المحل بالحركة المناسبة للياء، وهو مضاف، والياء ضمير متصل مبني في محل جر مضاف إليه. فالإضافة إلى ياء المتكلم تخرجها من الإعراب بالحروف.' },
  { q: 'ما إعراب أبوان وآباء؟', a: 'أبوان مثنى، وقد فقد شرط الإفراد، فيعرب إعراب المثنى: بالألف رفعًا وبالياء نصبًا وجرًّا، نحو "حضر الأبوان". وآباء جمع تكسير يعرب بالحركات الظاهرة، نحو "هؤلاء آباءٌ كرماء". فالإعراب بالواو والألف والياء خاص بالمفرد المستوفي للشروط.' },
  { q: 'ما الفرق بين ذو الاسم والذي الموصول؟', a: 'ذو من الأسماء الخمسة بمعنى صاحب، معربة بالحروف، ولا بد أن تضاف إلى اسم جنس ظاهر، نحو "جاء ذو علمٍ". أما الذي فاسم موصول مبني لا يتغير آخره. وعند طيِّئ تأتي "ذو" موصولة بمعنى الذي، وهي حينئذ مبنية، وهذا استعمال خاص بلغتهم.' },
  { q: 'لماذا يقال فوك بالحروف ويقال الفم بالحركات؟', a: 'لأن شرط إعراب هذا الاسم بالحروف أن تزول منه الميم، فتقول: "هذا فوكَ" و"نظفْ فاكَ" و"في فيكَ". فإن بقيت الميم فهو "فم" يعرب بالحركات الظاهرة، نحو "نظافةُ الفمِ واجبةٌ".' },
];
---
<BaseLayout
  lang="ar"
  hasEn
  title="الأسماء الخمسة: شروط إعرابها بالحروف · إعراب آب"
  description="شرح الأسماء الخمسة وشروط إعرابها بالحروف: الرفع بالواو والنصب بالألف والجر بالياء، مع بيان شروط الإفراد والتكبير والإضافة وأمثلة معربة إعرابًا كاملًا."
>
  <ArticleSchema slot="head" lang="ar" kind="lesson" headline="الأسماء الخمسة" description="شرح الأسماء الخمسة وشروط إعرابها بالحروف: الرفع بالواو والنصب بالألف والجر بالياء، مع بيان شروط الإفراد والتكبير والإضافة وأمثلة معربة إعرابًا كاملًا." />
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="الأسماء الخمسة"
    summary="الأسماء الخمسة هي: أب وأخ وحم وفو وذو، ترفع بالواو وتنصب بالألف وتجر بالياء، نيابة عن الضمة والفتحة والكسرة. لكن هذا الإعراب بالحروف مشروط بشروط متى فقد أحدها عادت إلى الإعراب بالحركات. هذا الدرس يفصل العلامات والشروط، مع أمثلة معربة إعرابًا كاملًا على طريقة كتب النحو."
  />
  <Byline lang="ar" kind="lesson" />

  <ArticleSection
    lang="ar"
    id="definition"
    title="ما الأسماء الخمسة؟"
    lead="الأسماء الخمسة أسماء معدودة محفوظة: أب وأخ وحم وفو وذو. خصها النحاة بالذكر لأنها تعرب بعلامات فرعية، فتخرج عن الأصل المعروف من الإعراب بالحركات الظاهرة."
  >
    <ul>
      <li><span class="ar">أَبٌ</span>: الوالد، نحو <span class="ar">أَبُوكَ</span>.</li>
      <li><span class="ar">أَخٌ</span>: الشقيق، نحو <span class="ar">أَخُوكَ</span>.</li>
      <li><span class="ar">حَمٌ</span>: قريب الزوج، نحو <span class="ar">حَمُوكِ</span>.</li>
      <li><span class="ar">فُو</span>: الفم إذا زالت منه الميم، نحو <span class="ar">فُوكَ</span>.</li>
      <li><span class="ar">ذُو</span>: بمعنى صاحب، نحو <span class="ar">ذُو عِلْمٍ</span>.</li>
    </ul>
    <p>وموقعها من الجملة كموقع أي اسم آخر: تقع مبتدأ وخبرًا و<a href="/duroos/al-fail">فاعلًا</a> ومفعولًا به ومجرورة بالحرف والإضافة، والذي يتغير هو شكل العلامة لا الوظيفة.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="irab-signs"
    title="علامات إعرابها بالحروف"
    lead="ترفع الأسماء الخمسة بالواو نيابة عن الضمة، وتنصب بالألف نيابة عن الفتحة، وتجر بالياء نيابة عن الكسرة. فهي من أبواب النيابة التي تجعل الحرف علامة إعراب مكان الحركة."
  >
    <ul>
      <li><strong>الرفع بالواو</strong>: <span class="ar">جَاءَ أَبُوكَ</span>.</li>
      <li><strong>النصب بالألف</strong>: <span class="ar">أَكْرِمْ أَبَاكَ</span>.</li>
      <li><strong>الجر بالياء</strong>: <span class="ar">سَلِّمْ عَلَى أَبِيكَ</span>.</li>
    </ul>
    <p>فالكلمة واحدة والوظائف ثلاث، والحرف الأخير هو الذي يحمل العلامة: واو ثم ألف ثم ياء. وهذا الباب فرع عن قاعدة أوسع تجدها مفصلة في درس <a href="/duroos/alamat-al-irab">علامات الإعراب</a> الأصلية والفرعية، وهو نظير ما يقع في المثنى وجمع المذكر السالم و<a href="/duroos/al-afal-al-khamsa">الأفعال الخمسة</a> من إعراب بغير الحركات.</p>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">اختبر فهمك للعلامات الفرعية.</span>
    ألصق أي جملة فيها أبوك أو أخاك أو ذو علم في المحلل على الصفحة الرئيسية، وشاهد الدرس يطبق كلمة كلمة: العلامة الفرعية، وموقع الاسم، وسبب النيابة.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="general-conditions"
    title="الشروط العامة لإعرابها بالحروف"
    lead="لا تعرب هذه الأسماء بالواو والألف والياء إلا إذا استوفت أربعة شروط مجتمعة. فإن اختل شرط واحد عادت إلى الإعراب بالحركات، ظاهرة أو مقدرة."
  >
    <ul>
      <li><strong>أن تكون مفردة</strong>: لا مثناة ولا مجموعة. فالمثنى <span class="ar">أَبَوَانِ</span> يعرب إعراب المثنى، والجمع <span class="ar">آبَاءٌ</span> يعرب بالحركات.</li>
      <li><strong>أن تكون مكبرة</strong>: لا مصغرة. فالمصغر <span class="ar">أُخَيٌّ</span> يعرب بالحركات الظاهرة.</li>
      <li><strong>أن تكون مضافة</strong>: فإن قطعت عن الإضافة أعربت بالحركات، نحو <span class="ar">هَذَا أَبٌ حَنُونٌ</span>.</li>
      <li><strong>أن تكون إضافتها إلى غير ياء المتكلم</strong>: فإن أضيفت إلى الياء أعربت بحركات مقدرة، نحو <span class="ar">جَاءَ أَبِي</span>.</li>
    </ul>
    <p>ولأن الإضافة شرط جوهري هنا، فإن هذا الدرس لا يكتمل إلا بفهم أحكام <a href="/duroos/al-idafa">الإضافة</a>: فالاسم من هذه الأسماء مضاف دائمًا، وما بعده مضاف إليه مجرور.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="dhu-and-fu-conditions"
    title="شرطا فو وذو الخاصان"
    lead="يزاد على الشروط الأربعة شرطان: شرط في فو وحدها، وشرطان في ذو وحدها. وهما مما يكثر السؤال عنه في الامتحانات لدقتهما."
  >
    <p><strong>شرط فو</strong>: أن تخلو من الميم. تقول: <span class="ar">هَذَا فُوكَ، وَنَظِّفْ فَاكَ، وَلَا تُدْخِلْ فِي فِيكَ إِلَّا طَيِّبًا</span>. فإن بقيت الميم صارت <span class="ar">فَمٌ</span> وأعربت بالحركات الظاهرة، نحو <span class="ar">نَظَافَةُ الْفَمِ وَاجِبَةٌ</span>.</p>
    <p><strong>شرطا ذو</strong>: أن تكون بمعنى صاحب، وأن تضاف إلى اسم جنس ظاهر، نحو <span class="ar">ذُو مَالٍ</span> و<span class="ar">ذُو الْجَلَالِ</span>. فلا تضاف إلى ضمير، ولا تكون بمعنى الذي، فإن جاءت موصولة على لغة طيِّئ فهي مبنية لا معربة.</p>
    <p>وإعراب مثال على فو: <span class="ar">نَظِّفْ فَاكَ</span>: <span class="ar">نَظِّفْ</span>: فعل أمر مبني على السكون، والفاعل ضمير مستتر وجوبًا تقديره أنت. <span class="ar">فَاكَ</span>: مفعول به منصوب وعلامة نصبه الألف لأنه من الأسماء الخمسة، وهو مضاف، والكاف ضمير متصل مبني في محل جر مضاف إليه.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="worked-examples"
    title="أمثلة معربة إعرابًا كاملًا"
    lead="هذه نماذج تغطي الرفع والنصب والجر، بالصياغة الكلاسيكية التي تعتمدها كتب النحو، حتى ترسخ عندك العبارة كما ترسخ القاعدة."
  >
    <p><strong>المثال الأول، الرفع</strong>: <span class="ar">جَاءَ أَبُوكَ</span>: <span class="ar">جَاءَ</span>: فعل ماضٍ مبني على الفتح. <span class="ar">أَبُوكَ</span>: فاعل مرفوع وعلامة رفعه الواو لأنه من الأسماء الخمسة، وهو مضاف، والكاف ضمير متصل مبني في محل جر مضاف إليه.</p>
    <p><strong>المثال الثاني، النصب</strong>: <span class="ar">أَكْرِمْ أَخَاكَ</span>: <span class="ar">أَكْرِمْ</span>: فعل أمر مبني على السكون، والفاعل ضمير مستتر وجوبًا تقديره أنت. <span class="ar">أَخَاكَ</span>: مفعول به منصوب وعلامة نصبه الألف لأنه من الأسماء الخمسة، وهو مضاف، والكاف ضمير متصل مبني في محل جر مضاف إليه.</p>
    <p><strong>المثال الثالث، الجر</strong>: <span class="ar">مَرَرْتُ بِذِي عِلْمٍ</span>: <span class="ar">مَرَرْتُ</span>: فعل ماضٍ مبني على السكون لاتصاله بتاء الفاعل، والتاء ضمير متصل مبني في محل رفع فاعل. الباء: حرف جر مبني على الكسر. <span class="ar">ذِي</span>: اسم مجرور وعلامة جره الياء لأنه من الأسماء الخمسة، وهو مضاف. <span class="ar">عِلْمٍ</span>: مضاف إليه مجرور وعلامة جره الكسرة الظاهرة.</p>
    <p><strong>المثال الرابع، مع ناسخ</strong>: <span class="ar">كَانَ ذُو الْمَالِ كَرِيمًا</span>: <span class="ar">كَانَ</span>: فعل ماضٍ ناقص مبني على الفتح. <span class="ar">ذُو</span>: اسم كان مرفوع وعلامة رفعه الواو لأنه من الأسماء الخمسة، وهو مضاف. <span class="ar">الْمَالِ</span>: مضاف إليه مجرور وعلامة جره الكسرة الظاهرة. <span class="ar">كَرِيمًا</span>: خبر كان منصوب وعلامة نصبه الفتحة الظاهرة.</p>
    <p>ومن الشواهد القرآنية: <span class="ar">وَأَبُونَا شَيْخٌ كَبِيرٌ</span>: <span class="ar">أَبُونَا</span>: مبتدأ مرفوع وعلامة رفعه الواو لأنه من الأسماء الخمسة، وهو مضاف، ونا ضمير متصل مبني في محل جر مضاف إليه. <span class="ar">شَيْخٌ</span>: خبر مرفوع وعلامة رفعه الضمة الظاهرة. <span class="ar">كَبِيرٌ</span>: نعت مرفوع وعلامة رفعه الضمة الظاهرة.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="when-conditions-missing"
    title="إذا فقدت الشروط"
    lead="فقدان أي شرط يعيد الاسم إلى أصل الإعراب بالحركات، ظاهرة أو مقدرة. ومعرفة هذه الحالات تعصمك من أشهر أخطاء هذا الباب: إعراب كل أب وأخ بالحروف بلا نظر في الشروط."
  >
    <ul>
      <li><strong>التثنية</strong>: <span class="ar">حَضَرَ الْأَبَوَانِ</span>: فاعل مرفوع وعلامة رفعه الألف لأنه مثنى.</li>
      <li><strong>الجمع</strong>: <span class="ar">هَؤُلَاءِ آبَاءٌ كُرَمَاءُ</span>: خبر مرفوع وعلامة رفعه الضمة الظاهرة.</li>
      <li><strong>القطع عن الإضافة</strong>: <span class="ar">لِي أَخٌ صَغِيرٌ</span>: مبتدأ مؤخر مرفوع وعلامة رفعه الضمة الظاهرة.</li>
      <li><strong>الإضافة إلى ياء المتكلم</strong>: <span class="ar">جَاءَ أَبِي</span>: فاعل مرفوع وعلامة رفعه الضمة المقدرة على ما قبل الياء منع من ظهورها اشتغال المحل بالحركة المناسبة، وهو مضاف، والياء ضمير متصل مبني في محل جر مضاف إليه.</li>
    </ul>
    <p>فالقاعدة إذن ليست في الكلمة نفسها بل في حالها داخل الجملة. وهذا جوهر <a href="/irab">الإعراب</a> كله: النظر في الموقع والشروط قبل إطلاق الحكم، وهو المنهج الذي يقوم عليه <a href="/nahw">النحو</a> من أوله إلى آخره.</p>
  </ArticleSection>

  <AyatExamples slug="al-asma-al-khamsa" />

  <ArticleFaq lang="ar" items={faqs} />

  <Footer lang="ar" />
</BaseLayout>
