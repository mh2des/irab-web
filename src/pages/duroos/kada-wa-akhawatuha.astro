---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import Byline from '../../components/Byline.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import ArticleSection from '../../components/ArticleSection.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import ArticleFaq from '../../components/ArticleFaq.astro';
import AyatExamples from '../../components/duroos/AyatExamples.astro';

const faqs = [
  { q: 'لماذا سميت كاد وأخواتها أفعالًا ناقصة؟', a: 'لأنها لا تكتفي بمرفوعها كما يكتفي الفعل التام بفاعله، بل تحتاج إلى خبر يتم به المعنى. "كاد المطر" كلام ناقص حتى تقول "ينقطع". وهي بهذا شبيهة بكان وأخواتها في العمل، لكن خبرها لا يكون إلا جملة فعلية فعلها مضارع.' },
  { q: 'هل يجوز أن يكون خبر كاد مفردًا؟', a: 'لا في الاستعمال الفصيح. خبر هذه الأفعال جملة فعلية فعلها مضارع مسند إلى ضمير يعود على الاسم، أو مصدر مؤول من أن والمضارع. فلا يقال "كاد الطالبُ ناجحًا"، بل "كاد الطالبُ ينجحُ" أو "كاد أن ينجحَ".' },
  { q: 'متى يقترن خبرها بأن ومتى يمتنع؟', a: 'يجب مع حرى واخلولق، ويكثر مع عسى وأوشك، ويقل مع كاد وكرب، ويمتنع مع أفعال الشروع كلها، لأن الشروع يفيد البدء الفعلي في العمل وأن تفيد الاستقبال فتناقضه.' },
  { q: 'ما معنى "وما كادوا يفعلون"؟', a: 'نفي كاد يفيد أن الفعل وقع بعد بطء وتردد، أي فعلوا بعد أن قاربوا ألا يفعلوا. ولذلك قال النحاة: إثبات كاد نفي ونفيها إثبات؛ "كاد ينجح" لم ينجح، و"ما كاد ينجح" نجح بعد جهد.' },
  { q: 'عسى فعل أم حرف؟', a: 'فعل ماضٍ جامد لا يتصرف، بدليل اتصال تاء الفاعل به: "عسيتُ" و"عسيتم"، والحروف لا تتصل بها تاء الفاعل. وقد ذهب بعض النحاة إلى حرفيتها في بعض الاستعمالات، والمشهور فعليتها.' },
  { q: 'هل تتصرف هذه الأفعال؟', a: 'كاد وأوشك يأتي منهما المضارع: "يكاد" و"يوشك"، ومن أوشك اسم الفاعل: "موشك". أما عسى وكرب وحرى واخلولق وأفعال الشروع فجامدة في هذا الباب لا يأتي منها مضارع بمعنى المقاربة أو الشروع.' },
];
---
<BaseLayout
  lang="ar"
  title="كاد وأخواتها: أفعال المقاربة والرجاء والشروع · إعراب"
  description="شرح كاد وأخواتها: أفعال المقاربة والرجاء والشروع، عملها عمل كان في رفع الاسم، وخبرها الجملة الفعلية، ومتى يقترن الخبر بأن ومتى يمتنع، مع أمثلة معربة كاملة."
>
  <ArticleSchema slot="head" lang="ar" kind="lesson" headline="كاد وأخواتها" description="شرح كاد وأخواتها: أفعال المقاربة والرجاء والشروع، عملها عمل كان في رفع الاسم، وخبرها الجملة الفعلية، ومتى يقترن الخبر بأن ومتى يمتنع، مع أمثلة معربة كاملة." />
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    title="كاد وأخواتها"
    summary="كاد وأخواتها أفعال ناقصة تعمل عمل كان: ترفع المبتدأ اسمًا لها، ويكون خبرها جملة فعلية فعلها مضارع. تفيد المقاربة أو الرجاء أو الشروع، وتختلف في اقتران خبرها بأن وجوبًا أو جوازًا أو امتناعًا. هذا الدرس يرتب أقسامها الثلاثة وقواعد خبرها، بأمثلة معربة كاملة وشواهد قرآنية."
  />
  <Byline lang="ar" kind="lesson" />

  <ArticleSection
    lang="ar"
    id="definition"
    title="عملها ومعناها"
    lead="تعمل كاد وأخواتها عمل كان: ترفع الاسم وتنصب الخبر، إلا أن خبرها لا يكون مفردًا بل جملة فعلية فعلها مضارع في محل نصب."
  >
    <p><span class="ar">كَادَ الْمَطَرُ يَنْقَطِعُ</span></p>
    <p><strong>الإعراب:</strong> <span class="ar">كَادَ</span>: فعل ماضٍ ناقص من أفعال المقاربة مبني على الفتح. <span class="ar">الْمَطَرُ</span>: اسم كاد مرفوع وعلامة رفعه الضمة الظاهرة على آخره. <span class="ar">يَنْقَطِعُ</span>: فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة، والفاعل ضمير مستتر جوازًا تقديره هو، والجملة الفعلية في محل نصب خبر كاد.</p>
    <p>فهي أخت <a href="/duroos/kana-wa-akhawatuha">كان وأخواتها</a> في رفع الاسم ونصب الخبر، والفرق أن خبر كان يكون مفردًا وجملة وشبه جملة، وخبر كاد جملة فعلية فحسب.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="members"
    title="أقسامها الثلاثة"
    lead="تنقسم بحسب معناها إلى أفعال المقاربة التي تفيد قرب وقوع الخبر، وأفعال الرجاء التي تفيد رجاء وقوعه، وأفعال الشروع التي تفيد البدء فيه."
  >
    <ul>
      <li><strong>أفعال المقاربة</strong>: <span class="ar">كَادَ</span> و<span class="ar">كَرَبَ</span> و<span class="ar">أَوْشَكَ</span>، نحو <span class="ar">أَوْشَكَتِ الشَّمْسُ أَنْ تَغْرُبَ</span>.</li>
      <li><strong>أفعال الرجاء</strong>: <span class="ar">عَسَى</span> و<span class="ar">حَرَى</span> و<span class="ar">اخْلَوْلَقَ</span>، نحو <span class="ar">عَسَى اللَّهُ أَنْ يَغْفِرَ لَنَا</span>.</li>
      <li><strong>أفعال الشروع</strong>: <span class="ar">شَرَعَ</span> و<span class="ar">أَنْشَأَ</span> و<span class="ar">طَفِقَ</span> و<span class="ar">جَعَلَ</span> و<span class="ar">أَخَذَ</span> و<span class="ar">عَلِقَ</span> و<span class="ar">هَبَّ</span> و<span class="ar">بَدَأَ</span>، نحو <span class="ar">شَرَعَ الْمُعَلِّمُ يَشْرَحُ الدَّرْسَ</span>.</li>
    </ul>
    <p>وأفعال الشروع لا تدخل الباب إلا إذا كان بعدها مضارع؛ فإذا قلت <span class="ar">أَخَذْتُ الْكِتَابَ</span> فأخذ فعل تام ينصب <a href="/duroos/al-maful-bih">مفعولًا به</a>، ولا شأن له بالشروع.</p>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">قارب واشرع في جملتك.</span>
    ألصق جملة تبدأ بكاد أو عسى أو شرع في محلل الإعراب، وشاهده يبين اسمها المرفوع والجملة الواقعة خبرًا في محل نصب.
  </ArticleCta>

  <ArticleSection
    lang="ar"
    id="rules"
    title="اقتران الخبر بأن"
    lead="خبر هذه الأفعال مضارع، وقد تسبقه أن المصدرية الناصبة. والاقتران بها واجب في أفعال، وجائز في أفعال، وممتنع في أفعال."
  >
    <ul>
      <li><strong>يجب الاقتران</strong> مع حرى واخلولق: <span class="ar">حَرَى الْمَرِيضُ أَنْ يُشْفَى</span>.</li>
      <li><strong>يكثر الاقتران</strong> مع عسى وأوشك، ويقل مع كاد وكرب، فيجوز الوجهان: <span class="ar">عَسَى الْفَرَجُ أَنْ يَقْرُبَ</span> و<span class="ar">كَادَ الصُّبْحُ يَطْلُعُ</span>.</li>
      <li><strong>يمتنع الاقتران</strong> مع أفعال الشروع كلها: <span class="ar">طَفِقَ الطِّفْلُ يَبْكِي</span>، ولا يقال "طفق أن يبكي".</li>
    </ul>
    <p>وإذا اقترن الخبر بأن فالمصدر المؤول من أن والفعل في محل نصب خبر، وتفصيل عمل أن في درس <a href="/duroos/nasb-al-mudari">نصب المضارع</a>.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="common-mistakes"
    title="أخطاء شائعة"
    lead="أشيع الأخطاء جعل خبر كاد اسمًا مفردًا منصوبًا، وإدخال أن على أفعال الشروع، وإعراب اسم كاد فاعلًا."
  >
    <ul>
      <li>يقال خطأً "كاد الطالبُ ناجحًا"، والصواب <span class="ar">كَادَ الطَّالِبُ يَنْجَحُ</span>، فالخبر جملة فعلية لا مفرد.</li>
      <li>يقال خطأً "شرع الطالبُ أن يكتبَ"، والصواب <span class="ar">شَرَعَ الطَّالِبُ يَكْتُبُ</span>، لأن أفعال الشروع يمتنع اقتران خبرها بأن.</li>
      <li>يقال خطأً إن "المطر" في <span class="ar">كَادَ الْمَطَرُ يَنْقَطِعُ</span> فاعل، والصواب أنه اسم كاد مرفوع، فالفعل ناقص لا يطلب فاعلًا بل اسمًا وخبرًا، بخلاف <a href="/duroos/al-fail">الفاعل</a> مع الفعل التام.</li>
    </ul>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="worked-examples"
    title="أمثلة معربة إعرابًا كاملًا"
    lead="هذه نماذج جاهزة بالصياغة الكلاسيكية المعتمدة في كتب النحو، تصلح مراجعة سريعة قبل الامتحان وقالبًا تحاكيه في إعرابك."
  >
    <p><strong>المثال الأول</strong>: <span class="ar">عَسَى اللَّهُ أَنْ يَغْفِرَ لَنَا</span>: <span class="ar">عَسَى</span>: فعل ماضٍ جامد من أفعال الرجاء مبني على الفتح المقدر على الألف للتعذر. <span class="ar">اللَّهُ</span>: لفظ الجلالة اسم عسى مرفوع وعلامة رفعه الضمة الظاهرة. <span class="ar">أَنْ</span>: حرف مصدري ونصب. <span class="ar">يَغْفِرَ</span>: فعل مضارع منصوب بأن وعلامة نصبه الفتحة الظاهرة، والفاعل ضمير مستتر جوازًا تقديره هو. <span class="ar">لَنَا</span>: جار ومجرور متعلقان بيغفر. والمصدر المؤول من أن والفعل في محل نصب خبر عسى.</p>
    <p><strong>المثال الثاني</strong>: <span class="ar">شَرَعَ الْمُعَلِّمُ يَشْرَحُ الدَّرْسَ</span>: <span class="ar">شَرَعَ</span>: فعل ماضٍ ناقص من أفعال الشروع مبني على الفتح. <span class="ar">الْمُعَلِّمُ</span>: اسم شرع مرفوع وعلامة رفعه الضمة الظاهرة. <span class="ar">يَشْرَحُ</span>: فعل مضارع مرفوع وعلامة رفعه الضمة الظاهرة، والفاعل ضمير مستتر جوازًا تقديره هو. <span class="ar">الدَّرْسَ</span>: مفعول به منصوب وعلامة نصبه الفتحة الظاهرة. والجملة الفعلية في محل نصب خبر شرع.</p>
    <p><strong>المثال الثالث</strong>: <span class="ar">أَوْشَكَتِ الشَّمْسُ أَنْ تَغْرُبَ</span>: <span class="ar">أَوْشَكَتِ</span>: فعل ماضٍ ناقص من أفعال المقاربة مبني على الفتح، والتاء للتأنيث حرف مبني على السكون حرك بالكسر لالتقاء الساكنين. <span class="ar">الشَّمْسُ</span>: اسم أوشك مرفوع وعلامة رفعه الضمة الظاهرة. <span class="ar">أَنْ تَغْرُبَ</span>: أن حرف مصدري ونصب، وتغربَ فعل مضارع منصوب وعلامة نصبه الفتحة الظاهرة، والفاعل ضمير مستتر جوازًا تقديره هي. والمصدر المؤول في محل نصب خبر أوشك.</p>
    <p><strong>المثال الرابع</strong>: <span class="ar">طَفِقَ الطِّفْلُ يَبْكِي</span>: <span class="ar">طَفِقَ</span>: فعل ماضٍ ناقص من أفعال الشروع مبني على الفتح. <span class="ar">الطِّفْلُ</span>: اسم طفق مرفوع وعلامة رفعه الضمة الظاهرة. <span class="ar">يَبْكِي</span>: فعل مضارع مرفوع وعلامة رفعه الضمة المقدرة على الياء منع من ظهورها الثقل، والفاعل ضمير مستتر جوازًا تقديره هو. والجملة الفعلية في محل نصب خبر طفق.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="in-quran"
    title="من القرآن الكريم"
    lead="قال تعالى في سورة البقرة: يَكَادُ ٱلْبَرْقُ يَخْطَفُ أَبْصَٰرَهُمْ. يكاد مضارع كاد، رفع البرق اسمًا له، وجملة يخطف في محل نصب خبره."
  >
    <p><span class="ar">يَكَادُ ٱلْبَرْقُ يَخْطَفُ أَبْصَٰرَهُمْ</span> (البقرة: ٢٠)</p>
    <p><strong>الإعراب:</strong> يكادُ: فعل مضارع ناقص مرفوع وعلامة رفعه الضمة الظاهرة. البرقُ: اسم يكاد مرفوع وعلامة رفعه الضمة الظاهرة. يخطفُ: فعل مضارع مرفوع، والفاعل ضمير مستتر تقديره هو أي البرق. أبصارَ: مفعول به منصوب، وهو مضاف، وهم: ضمير متصل في محل جر مضاف إليه. والجملة الفعلية في محل نصب خبر يكاد.</p>
    <p>ومن الباب قوله تعالى في الإسراء: <span class="ar">عَسَىٰ رَبُّكُمْ أَن يَرْحَمَكُمْ</span>، فربكم اسم عسى مرفوع، والمصدر المؤول من أن يرحمكم في محل نصب خبرها. وفي البقرة: <span class="ar">وَمَا كَادُوا۟ يَفْعَلُونَ</span>، والواو اسم كاد، ونفيها يفيد أنهم فعلوا بعد تردد. وتجد إعراب هذه الآيات كاملًا في <a href="/quran">إعراب القرآن</a>.</p>
  </ArticleSection>

  <AyatExamples slug="kada-wa-akhawatuha" />

  <ArticleFaq lang="ar" items={faqs} />

  <Footer lang="ar" />
</BaseLayout>
