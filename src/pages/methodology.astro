---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/sections/Footer.astro';
import ArticleHero from '../components/ArticleHero.astro';
import ArticleSection from '../components/ArticleSection.astro';
import ArticleCta from '../components/ArticleCta.astro';
---
<BaseLayout
  lang="ar"
  title="منهجيتنا: كيف نبني المحتوى ونتحقّق منه · إعراب"
  description="منهجية إعراب: كيف يعمل محرّك الإعراب الذكي، وما مصدر إعراب القرآن، وكيف نتحقّق من النص القرآني حرفًا حرفًا، ومن يكتب الدروس ويراجعها، وكيف نصحّح الأخطاء."
>
  <Nav lang="ar" />

  <ArticleHero
    lang="ar"
    eyebrow="الشفافية"
    title="منهجيتنا"
    summary="نؤمن أنّ أدوات تعلّم العربية يجب أن تكون شفّافة في مصادرها ودقيقة في نصوصها. هذه الصفحة تشرح كيف يعمل محرّك التحليل في إعراب، وما مصدر مرجع إعراب القرآن، وكيف نتحقّق من كلّ آية قبل أن تظهر أمامك."
  />

  <ArticleSection
    lang="ar"
    id="engine"
    title="محرّك الإعراب الذكي"
    lead="جوهر إعراب هو محرّك تحليل يعمل بالذكاء الاصطناعي: تكتب أيّ جملة عربية فيعربها لك كلمةً كلمة في ثوانٍ، ويعطيك تقييمًا فوريًّا عندما تتدرّب على الإعراب بنفسك."
  >
    <p>المحرّك مبنيّ على نماذج لغوية حديثة وُجّهت خصّيصًا لقواعد النحو العربي، وتُراجع مخرجاته باستمرار على جملٍ معيارية من كتب النحو المعتمدة. وعندما تجيب عن تمارين الإعراب في التطبيق، يقارن المحرّك إجابتك بالتحليل الصحيح ويشرح لك موضع الخطأ تحديدًا, لا مجرّد "صحيح / خطأ".</p>
    <p>التحليل الآلي اجتهاد تقنيّ قابل للخطأ، ولهذا نوفّر داخل التطبيق زرّ إبلاغ عن أيّ تحليل تراه غير دقيق، وتُراجع البلاغات يدويًّا.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="quran-source"
    title="مصدر إعراب القرآن"
    lead="صفحات إعراب القرآن في هذا الموقع وفي التطبيق تستند إلى مرجع واحد معتمد: الجدول في إعراب القرآن وصرفه وبيانه للشيخ محمود صافي رحمه الله (دار الرشيد، دمشق)، وهو من أوسع مراجع إعراب القرآن المطبوعة, خمسة عشر مجلّدًا."
  >
    <p>اخترنا مصدرًا واحدًا موثوقًا بدل التلفيق من مصادر متعدّدة، حتى يكون التحليل متّسق المنهج من أوّل المصحف إلى آخره، ويُنسب الفضل لأهله. كلّ صفحة آية في الموقع تذكر المصدر صراحة.</p>
    <p>ما تقرؤه من ملخّصات تمهيدية (TL;DR) وأسئلة شائعة في صفحات الآيات فهو ممّا حرّرناه نحن خصّيصًا للموقع، وليس منقولًا من الجدول.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="verification"
    title="التحقّق من النص القرآني"
    lead="لا يُنشر نصّ قرآني في إعراب قبل مطابقته آليًّا، حرفًا حرفًا، مع النصّ القياسي المعتمد من مشروع تنزيل (Tanzil) برواية حفص عن عاصم."
  >
    <p>بنينا خطّ معالجة كاملًا يستخرج المرجع، ويوحّد الرسم الإملائي، ثم يطابق كلّ آية من الآيات الـ٦٢٣٦ مع النصّ العثماني القياسي. أيّ اختلاف, ولو في حرف أو حركة, يوقف النشر حتى يُصحَّح. تغطية التحليل على مستوى الكلمة المفردة تتجاوز ٩٩٪ من آيات المصحف (أكثر من ١٠٠ ألف كلمة محلَّلة).</p>
    <p>هذا التحقّق غير قابل للتفاوض عندنا: تطبيق يخدم القرآن لا يجوز أن يعرض آية فيها خطأ.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="editorial"
    title="من يكتب ومن يراجع"
    lead="كلّ درس في «دروس النحو»، وكلّ ملخّص تمهيدي وأسئلة شائعة في صفحات الآيات، يكتبها منصور حسن، مؤسّس إعراب ومعلّم لغة عربية سابق. ولا يُنشر سطر إعراب ولا استشهاد قرآني قبل مطابقته بالمراجع النحوية."
  >
    <p>نفصل بين ثلاثة أنواع من النصّ ونسمّي كلًّا منها باسمه. <strong>ما نكتبه نحن</strong>: الدروس، والملخّصات التمهيدية، والأسئلة الشائعة، والأمثلة المعربة في صفحة المحلّل؛ تُكتب بأيدينا وتُراجع سطرًا سطرًا قبل النشر، ويحمل كلّ درس اسم كاتبه وتاريخ آخر تحديث تحت عنوانه. <strong>ما ننقله</strong>: إعراب آيات القرآن، منقول عن «الجدول في إعراب القرآن» ويُذكر المصدر في كلّ صفحة تحت عنوان «نقلًا عن المرجع». <strong>ما يولّده الذكاء الاصطناعي</strong>: نتائج المحلّل، وهي اجتهاد آلي قد يخطئ، ولهذا يُعرض بوصفه مساعد دراسة لا مرجعًا.</p>
    <p>لا نستعمل الذكاء الاصطناعي لكتابة الدروس أو نشر صفحات بالجملة. الصفحة التي لا تحمل إضافة حقيقية من عندنا لا تُنشر، وقد أخرجنا في أغسطس ٢٠٢٦ من فهرس محرّكات البحث آلاف صفحات الآيات التي لم تكن تحمل بعدُ شرحًا من عندنا، وتعود كلّ صفحة إلى الفهرس حين يُكتب لها ملخّصها وأسئلتها. تعرف كاتب الدروس في صفحة <a href="/about#mansoor">عن إعراب</a>.</p>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="references"
    title="مراجعنا"
    lead="نرجع إلى كتب النحو المتداولة في التدريس والمراجعة، ونذكر المصدر بالاسم حين ننقل، ونكتب بالصياغة الكلاسيكية التي تعتمدها كتب الإعراب المدرسية والجامعية."
  >
    <ul>
      <li><strong>إعراب القرآن:</strong> «الجدول في إعراب القرآن وصرفه وبيانه» لمحمود صافي، المصدر الوحيد لصفحات الآيات، كما فصّلنا أعلاه.</li>
      <li><strong>النصّ القرآني:</strong> النصّ العثماني القياسي من مشروع تنزيل برواية حفص عن عاصم، ويُطابَق حرفًا حرفًا قبل النشر.</li>
      <li><strong>الدروس والقواعد:</strong> كتب النحو المعتمدة في التدريس، وتُذكر أسماؤها داخل الدرس حين ننقل نصًّا أو تعريفًا بعينه. والأمثلة المعربة نكتبها نحن بالصياغة الكلاسيكية نفسها.</li>
    </ul>
  </ArticleSection>

  <ArticleSection
    lang="ar"
    id="corrections"
    title="الإبلاغ عن خطأ وتصحيحه"
    lead="إذا وجدت خطأ في إعراب أو استشهاد أو نصّ، فراسلنا على support@irab.app. نراجع البلاغ ونصحّح في الصفحة نفسها، ويظهر التصحيح في تاريخ «آخر تحديث» تحت عنوان الدرس."
  >
    <p>ليكون التصحيح سريعًا، أرسل رابط الصفحة، والموضع فيها، وما تراه صوابًا مع مرجعه إن أمكن. ولنتائج المحلّل، على الويب أو في التطبيق، أرسل الجملة والنتيجة التي تراها خاطئة إلى العنوان نفسه، وتُراجع البلاغات يدويًّا. لا نحذف الصفحة التي صُحّحت ولا نخفي تاريخها؛ نصحّح ونبقي التاريخ شاهدًا.</p>
    <p>إعراب مشروع مستقلّ يبنيه مطوّر واحد، بدأ من حاجة شخصية: أداة تجعل التمكّن من الإعراب ممكنًا لكلّ دارس، لا حكرًا على من وجد المعلّم والوقت. التطبيق متوفّر على متجري Google Play وApp Store. نرحّب بكلّ تصحيح أو اقتراح على <a href="mailto:hello@irab.app">hello@irab.app</a>، وإذا كنت من أهل العلم ووجدت في المحتوى ما يحتاج مراجعة، فمراسلتك لنا صدقة نشكرك عليها.</p>
  </ArticleSection>

  <ArticleCta lang="ar">
    <span slot="title">جرّب المحرّك بنفسك.</span>
    ألصق أيّ جملة عربية في التجربة المباشرة على الصفحة الرئيسية، أو حمّل التطبيق وتدرّب على الإعراب بتقييم فوري.
  </ArticleCta>

  <Footer lang="ar" />
</BaseLayout>
