---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthHeader from '../components/AuthHeader.astro';
import Footer from '../components/sections/Footer.astro';
import AuthForm from '../components/AuthForm.astro';
---
<BaseLayout lang="ar" title="تسجيل الدخول · إعراب آب" description="سجّل الدخول إلى حسابك في إعراب أو أنشئ حساباً جديداً للوصول إلى ميزاتك عبر الويب والتطبيق.">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  {/* No site nav on purpose (see AuthHeader): nothing here competes with
      signing in. The heading belongs to AuthForm — it answers the mode. */}
  <AuthHeader lang="ar" />
  <main class="px-6 pt-10 pb-16 md:pt-14 md:pb-24">
    <AuthForm lang="ar" />
  </main>
  <Footer lang="ar" />
</BaseLayout>
