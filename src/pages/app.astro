---
/**
 * /app: the signed in profile dashboard (Arabic). Login-gated, noindex
 * (private surface). Firebase loads only here.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/sections/Footer.astro';
import AppHub from '../components/AppHub.astro';
---
<BaseLayout lang="ar" title="حسابي · إعراب آب" description="لوحة حسابك في إعراب: الخطة، الاستخدام، التقدّم، والأدوات.">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <Nav lang="ar" />
  <main class="px-4 sm:px-6 py-8 md:py-12">
    <AppHub lang="ar" />
  </main>
  <Footer lang="ar" />
</BaseLayout>
