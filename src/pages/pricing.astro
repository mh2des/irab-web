---
/**
 * /pricing: the public pricing page for Irab Plus (Arabic).
 *
 * Doubles as the page Paddle's verification (and reviewers/AEO) read to learn
 * what we sell. The page itself is components/pricing/Pricing.astro; this file
 * keeps the route's title, description and structured data. Indexed (SEO).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/sections/Footer.astro';
import Pricing from '../components/pricing/Pricing.astro';
import { pricingFaqs } from '../lib/pricing';

const offerSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Irab Plus',
  image: 'https://irab.app/og-default.png',
  description: 'اشتراك إعراب بلس: يفتح كلّ ميزات إعراب على الويب والتطبيق بحسابٍ واحد.',
  brand: { '@type': 'Brand', name: 'Irab' },
  offers: [
    { '@type': 'Offer', name: 'شهري', price: '4.99', priceCurrency: 'USD', url: 'https://irab.app/pricing', availability: 'https://schema.org/InStock' },
    { '@type': 'Offer', name: 'سنوي', price: '35.99', priceCurrency: 'USD', url: 'https://irab.app/pricing', availability: 'https://schema.org/InStock' },
  ],
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: pricingFaqs('ar').map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout
  lang="ar"
  hasEn
  title="الأسعار: إعراب بلس · تجربة مجانية ٧ أيام | إعراب آب"
  description="اشترك في إعراب بلس: ٤٫٩٩$ شهريًّا أو ٣٥٫٩٩$ سنويًّا (تجربة مجانية ٧ أيام). يفتح كلّ الميزات على الويب والتطبيق بحسابٍ واحد. الدفع عبر Paddle."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(offerSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
  </Fragment>

  <Nav lang="ar" />
  <main>
    <Pricing lang="ar" />
  </main>
  <Footer lang="ar" />
</BaseLayout>
