---
/**
 * /pricing: public pricing page for Irab Plus (Arabic).
 *
 * Doubles as the page Paddle's verification (and reviewers/AEO) read to learn
 * what we sell. Shows the two plans + what's included, notes Paddle as Merchant
 * of Record and that tax is added at checkout. Indexed (SEO).
 *
 * Design: calm, premium, conversion-focused. Ambient brand glows, a featured
 * annual card with a breathing halo, a free-vs-Plus comparison, and staggered
 * GSAP reveals (the site-wide [data-reveal] system). Every claim mirrors the
 * verified homepage/tool copy. CTAs carry the plan (/app?checkout=…) and the
 * page stays Firebase-free.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import Footer from '../components/sections/Footer.astro';

const features = [
  { t: 'تحليلات إعرابية غير محدودة', b: 'أعرِب ما شئت متى شئت: كلمة بكلمة، بالنوع والوظيفة والعلامة والتشكيل.', i: 'M12 12c-2-2.67-4-4-6-4a4 4 0 0 0 0 8c2 0 4-1.33 6-4Zm0 0c2 2.67 4 4 6 4a4 4 0 0 0 0-8c-2 0-4 1.33-6 4Z' },
  { t: 'تقييمٌ فوري لإعرابك أنت', b: 'أعرِب بنفسك واحصل على تصحيحٍ وشرح لكل كلمة: الميزة التي تصنع الإتقان.', i: 'M22 11.08V12a10 10 0 1 1-5.93-9.14M22 4 12 14.01l-3-3' },
  { t: 'بنك التدريب الكامل: ٥٧٦ جملة', b: 'جملٌ منتقاة بمستويات متدرّجة، بدل مستويين في الخطة المجانية.', i: 'M12 2 2 7l10 5 10-5-10-5ZM2 17l10 5 10-5M2 12l10 5 10-5' },
  { t: 'كل أبواب التحدّي السبعة', b: 'مع الشروحات المدفوعة لكل إجابة، لا البابين الأولين فقط.', i: 'M6 9H4.5a2.5 2.5 0 0 1 0-5H6m12 5h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22m7-7.34V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22M18 2H6v7a6 6 0 0 0 12 0V2Z' },
  { t: 'المعجم الذكي بلا حدود', b: 'بحثٌ غير محدود بالذكاء الاصطناعي، بدل ٥ عمليات يوميًّا.', i: 'M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2V3Zm20 0h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7V3Z' },
  { t: 'إدخال صوتي وتصوير النص', b: 'تكلّم بالجملة أو صوّرها بكاميرا OCR ثم أعرِبها مباشرة.', i: 'M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2v11ZM12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z' },
  { t: 'تصدير PDF وبطاقات مشاركة', b: 'صدّر تحليلاتك وشارك بطاقاتٍ أنيقة بلا علامةٍ مائية.', i: 'M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3' },
  { t: 'شهادات الإتقان', b: 'على الخطة السنوية: شهادة قابلة للمشاركة بعد إتقان كل موضوع.', i: 'M12 15a7 7 0 1 0 0-14 7 7 0 0 0 0 14Zm0 0 3.5 7L12 20l-3.5 2 3.5-7Z' },
];

const compare = [
  { f: 'التحليلات الإعرابية', free: '٣ يوميًّا', plus: 'غير محدودة' },
  { f: 'تقييم إعرابك الخاص', free: null, plus: 'مع شرحٍ لكل كلمة' },
  { f: 'بنك التدريب', free: 'المستويان ١–٢', plus: '٥٧٦ جملة كاملة' },
  { f: 'أبواب التحدّيات', free: 'البابان ١–٢', plus: 'كل الأبواب السبعة' },
  { f: 'المعجم الذكي', free: '٥ عمليات يوميًّا', plus: 'بلا حدود' },
  { f: 'OCR وتصدير PDF', free: null, plus: 'مضمّنان' },
  { f: 'شهادات الإتقان', free: null, plus: 'مع الخطة السنوية' },
];

const faqs = [
  { q: 'هل التجربة المجانية مجانية فعلًا؟', a: 'نعم. عند اختيار الخطة السنوية تدفع ٠٫٠٠$ اليوم، ولك ٧ أيام كاملة بكل الميزات. إن ألغيت قبل انتهائها فلن تُحاسَب، وإلا بدأ الاشتراك السنوي ٣٥٫٩٩$.' },
  { q: 'هل يعمل الاشتراك على الويب والتطبيق معًا؟', a: 'نعم. اشتراكٌ واحد بحسابك نفسه يفتح كل شيء على الموقع وفي تطبيق iOS وAndroid، أينما سجّلت دخولك.' },
  { q: 'ماذا يحدث إذا ألغيت؟', a: 'تُلغي في أي وقت، ويبقى وصولك الكامل حتى نهاية الفترة المدفوعة، ثم تعود تلقائيًّا إلى الخطة المجانية دون فقدان حسابك أو تقدّمك.' },
  { q: 'كيف تتم معالجة الدفع؟', a: 'عبر Paddle (بائع التسجيل)، بأمانٍ كامل وببطاقات الدفع الشائعة وPayPal وApple Pay وGoogle Pay. تُضاف الضرائب عند الدفع حسب بلدك، وقد تختلف الأسعار الإقليمية.' },
];

const offerSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Irab Plus',
  description: 'اشتراك إعراب بلس: يفتح كلّ ميزات إعراب على الويب والتطبيق بحسابٍ واحد.',
  brand: { '@type': 'Brand', name: 'Irab' },
  offers: [
    { '@type': 'Offer', name: 'شهري', price: '4.99', priceCurrency: 'USD', url: 'https://irab.app/pricing', availability: 'https://schema.org/InStock' },
    { '@type': 'Offer', name: 'سنوي', price: '35.99', priceCurrency: 'USD', url: 'https://irab.app/pricing', availability: 'https://schema.org/InStock' },
  ],
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout
  lang="ar"
  hasEn
  title="الأسعار: إعراب بلس · تجربة مجانية ٧ أيام | إعراب آب"
  description="اشترك في إعراب بلس: ٤٫٩٩$ شهريًّا أو ٣٥٫٩٩$ سنويًّا (تجربة مجانية ٧ أيام). يفتح كلّ الميزات على الويب والتطبيق بحسابٍ واحد. الدفع عبر Paddle."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(offerSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
  </Fragment>

  <Nav lang="ar" />

  <main class="pr-page relative overflow-hidden">
    {/* Ambient brand glows: calm, slow, behind everything. */}
    <div class="pr-orb pr-orb-a" aria-hidden="true"></div>
    <div class="pr-orb pr-orb-b" aria-hidden="true"></div>

    {/* ── Hero ─────────────────────────────────────────────────────── */}
    <Section size="sm" class="relative">
      <Container size="narrow">
        <div class="text-center">
          <p class="eyebrow pr-eyebrow justify-center" data-reveal>الأســـعـــار</p>
          <h1 class="font-arabic-display font-bold text-[clamp(2.2rem,5.5vw,3.6rem)] leading-[1.15] tracking-tight mb-5" data-reveal data-reveal-delay="80">
            اشتراكٌ واحد،<br class="sm:hidden" /> يفتح كلَّ شيء.
          </h1>
          <p class="font-arabic text-body-lg text-ink/65 dark:text-mist/65 max-w-xl mx-auto leading-loose" data-reveal data-reveal-delay="160">
            ابدأ مجانًا اليوم. ومتى اشتركت في إعراب بلس فُتح كلُّ شيء على الموقع وفي التطبيق: بالحساب نفسه.
          </p>
        </div>
      </Container>
    </Section>

    {/* ── Plans ────────────────────────────────────────────────────── */}
    <Section size="sm" class="relative !pt-0">
      <Container>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-[44rem] mx-auto items-stretch">

          {/* Annual: featured */}
          <div class="pr-card pr-card-featured p-8 md:p-10 flex flex-col" data-reveal>
            <span class="pr-ribbon">الأفضل قيمة · وفّر ٤٠٪</span>
            <div class="pr-card-inner flex flex-col flex-1">

            <p class="pr-plan-name">سنوي</p>
            <p class="pr-price">
              <span class="pr-price-amount" dir="ltr">$٣٥<span class="pr-price-frac">٫٩٩</span></span>
              <span class="pr-price-per">/ سنويًّا</span>
            </p>
            <p class="font-arabic text-small text-purple-deep dark:text-purple font-bold mb-6">≈ ٣٫٠٠$ شهريًّا فقط</p>

            <ul class="pr-perks pr-perks-plus flex-1">
              <li>تجربة مجانية ٧ أيام: تدفع ٠٫٠٠$ اليوم</li>
              <li>كل ميزات بلس، بلا استثناء</li>
              <li>شهادات الإتقان القابلة للمشاركة</li>
            </ul>

            <a href="/app?checkout=annual" class="btn-primary btn-block btn-lg mt-7">
              ابدأ التجربة المجانية
              <svg class="pr-cta-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5m7-7-7 7 7 7"/></svg>
            </a>
            <p class="text-caption text-ink/55 dark:text-mist/55 text-center mt-3">لن تُحاسَب اليوم · تذكّر الإلغاء قبل اليوم السابع إن غيّرت رأيك</p>
            </div>
          </div>

          {/* Monthly: quiet */}
          <div class="pr-card p-8 md:p-10 flex flex-col" data-reveal data-reveal-delay="120">
            <div class="pr-card-inner flex flex-col flex-1">
            <p class="pr-plan-name">شهري</p>
            <p class="pr-price">
              <span class="pr-price-amount" dir="ltr">$٤<span class="pr-price-frac">٫٩٩</span></span>
              <span class="pr-price-per">/ شهريًّا</span>
            </p>
            <p class="font-arabic text-small text-ink/55 dark:text-mist/55 mb-6">مرونة كاملة، شهرًا بشهر</p>

            <ul class="pr-perks flex-1">
              <li>كل ميزات بلس نفسها</li>
              <li>يُجدَّد شهريًّا، ألغِ متى شئت</li>
              <li>ابدأ الآن وبدّل إلى السنوي لاحقًا</li>
            </ul>

            <a href="/app?checkout=monthly" class="btn-ghost btn-block btn-lg mt-7">اشترك شهريًّا</a>
            <p class="text-caption text-ink/55 dark:text-mist/55 text-center mt-3">بلا التزامٍ طويل: توقّف متى أردت</p>
            </div>
          </div>
        </div>

        <p class="text-caption text-ink/60 dark:text-mist/60 text-center mt-8 max-w-xl mx-auto leading-relaxed" data-reveal>
          الأسعار الإقليمية قد تختلف، وتُضاف الضرائب عند الدفع حسب بلدك. الدفع عبر <strong>Paddle</strong> (بائع التسجيل). راجع
          <a href="/refund" class="text-purple hover:text-purple-deep underline underline-offset-2">سياسة الاسترداد</a> و
          <a href="/terms" class="text-purple hover:text-purple-deep underline underline-offset-2">الشروط</a>.
        </p>
      </Container>
    </Section>

    {/* ── Free vs Plus ─────────────────────────────────────────────── */}
    <Section class="section-tint border-y border-stone dark:border-coal-edge">
      <Container size="narrow">
        <div class="text-center mb-10">
          <p class="eyebrow justify-center mb-4" data-reveal>المقارنة بوضوح</p>
          <h2 class="font-arabic-display font-bold text-[clamp(1.7rem,3.8vw,2.6rem)] leading-[1.25] tracking-tight" data-reveal data-reveal-delay="80">
            المجاني كريم. وبلس بلا سقف.
          </h2>
        </div>

        <div class="pr-table" data-reveal role="table" aria-label="مقارنة الخطة المجانية بإعراب بلس">
          <div class="pr-row pr-row-head" role="row">
            <span role="columnheader" class="text-start">الميزة</span>
            <span role="columnheader">المجاني</span>
            <span role="columnheader" class="pr-col-plus">بلس</span>
          </div>
          {compare.map((r) => (
            <div class="pr-row" role="row">
              <span role="cell" class="text-start font-semibold">{r.f}</span>
              <span role="cell" class="text-ink/60 dark:text-mist/60">
                {r.free ?? <svg class="pr-dash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-label="غير متاح"><path d="M5 12h14"/></svg>}
              </span>
              <span role="cell" class="pr-col-plus font-semibold">{r.plus}</span>
            </div>
          ))}
        </div>
      </Container>
    </Section>

    {/* ── Everything Plus unlocks ──────────────────────────────────── */}
    <Section>
      <Container>
        <div class="text-center mb-12">
          <p class="eyebrow justify-center mb-4" data-reveal>ماذا يفتح لك بلس</p>
          <h2 class="font-arabic-display font-bold text-[clamp(1.7rem,3.8vw,2.6rem)] leading-[1.25] tracking-tight" data-reveal data-reveal-delay="80">
            كلُّ ما تحتاجه لتُتقن الإعراب فعلًا.
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 max-w-5xl mx-auto">
          {features.map((f, idx) => (
            <article class="pr-feature card p-6" data-reveal data-reveal-delay={String((idx % 4) * 90)}>
              <span class="pr-feature-ic" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={f.i}/></svg>
              </span>
              <h3 class="font-arabic font-bold text-h3 leading-snug mb-2">{f.t}</h3>
              <p class="font-arabic text-small text-ink/65 dark:text-mist/65 leading-relaxed">{f.b}</p>
            </article>
          ))}
        </div>
      </Container>
    </Section>

    {/* ── FAQ ──────────────────────────────────────────────────────── */}
    <Section size="sm" class="!pt-0">
      <Container size="narrow">
        <h2 class="font-arabic-display font-bold text-[clamp(1.5rem,3.2vw,2.1rem)] text-center mb-8" data-reveal>أسئلة قبل الاشتراك</h2>
        <div class="space-y-3 max-w-2xl mx-auto" data-acc-group>
          {faqs.map((f) => (
            <details class="pr-faq group cursor-pointer acc-card" data-reveal data-acc>
              <summary class="flex items-start justify-between gap-6 list-none p-5 [&::-webkit-details-marker]:hidden">
                <h3 class="font-arabic font-bold text-h3 leading-snug transition-colors duration-200 group-hover:text-purple">{f.q}</h3>
                <span class="acc-icon shrink-0 mt-1 grid place-items-center w-8 h-8 rounded-full bg-purple/8 group-hover:bg-purple/15 text-purple">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path class="acc-v" d="M12 5v14"/><path d="M5 12h14"/></svg>
                </span>
              </summary>
              <div class="px-5 pb-6">
                <p class="font-arabic text-body text-ink/70 dark:text-mist/70 leading-loose">{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </Container>
    </Section>

    {/* ── Final CTA ────────────────────────────────────────────────── */}
    <Section size="sm" class="!pt-0">
      <Container size="narrow">
        <div class="pr-final text-center p-10 md:p-14" data-reveal>
          <h2 class="font-arabic-display font-bold text-[clamp(1.8rem,4vw,2.8rem)] leading-[1.2] text-white mb-4">جرّب بلس ٧ أيام. مجانًا.</h2>
          <p class="font-arabic text-body-lg text-white/85 leading-loose max-w-md mx-auto mb-8">لن تدفع شيئًا اليوم، وستشعر بالفرق من أول جملةٍ تُعربها.</p>
          <a href="/app?checkout=annual" class="pr-final-btn lift">
            ابدأ تجربتك المجانية الآن
          </a>
          <p class="text-caption text-white/70 mt-4">٧ أيام مجانًا ثم ٣٥٫٩٩$ سنويًّا · ألغِ في أيّ وقت</p>
        </div>
      </Container>
    </Section>
  </main>

  <Footer lang="ar" />
</BaseLayout>

<style>
  /* ── Ambient orbs: slow, calm, behind everything ─────────────────── */
  .pr-orb {
    position: absolute; border-radius: 999px; pointer-events: none;
    filter: blur(90px); opacity: 0.5; z-index: -1;
  }
  .pr-orb-a {
    width: 34rem; height: 34rem; top: -10rem; inset-inline-start: -12rem;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-purple) 22%, transparent), transparent 70%);
    animation: pr-drift 14s ease-in-out infinite alternate;
  }
  .pr-orb-b {
    width: 28rem; height: 28rem; top: 14rem; inset-inline-end: -10rem;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-teal) 20%, transparent), transparent 70%);
    animation: pr-drift 18s ease-in-out infinite alternate-reverse;
  }
  :global(.dark) .pr-orb { opacity: 0.35; }
  @keyframes pr-drift {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to   { transform: translate3d(2.5rem, 2rem, 0) scale(1.08); }
  }

  /* ── Plan cards ──────────────────────────────────────────────────── */
  /* Soft-UI plan cards, on the same recipe as the tool page's .soft-card:
     a near-white surface raised off the canvas by a paired highlight and
     shadow — light above, depth below — with no edge at rest. Solid fills
     only, no gradient, per the design system. These sit deeper than the tool
     cards because they are the page's largest objects and carry the decision. */
  /* The page label: elongated with kashida (ـ) rather than letter-spacing —
     tracking is a Latin device that breaks Arabic ligatures, which is why
     global.css strips it on Arabic pages. Thmanyah is not a variable font (no
     fvar table), so font-stretch would do nothing; kashida is the real Arabic
     elongation and the face draws it cleanly. Bigger than the global eyebrow,
     with real air before the headline. */
  .pr-eyebrow {
    font-size: clamp(1.5rem, 3.4vw, 2.35rem);
    line-height: 1.35;
    margin-bottom: 1.75rem;
  }

  /* Content scales gently as the card lifts, so the whole card feels like it
     is coming toward you rather than just casting a bigger shadow. The ribbon
     is deliberately outside this wrapper: it is anchored to the card's edge
     and must not drift when the content scales. */
  .pr-card-inner {
    transition: transform .34s var(--ease-out-quart);
    transform-origin: center center;
    will-change: transform;
  }
  .pr-card:hover .pr-card-inner { transform: scale(1.028); }
  @media (prefers-reduced-motion: reduce) {
    .pr-card-inner, .pr-card:hover .pr-card-inner { transform: none; transition: none; }
  }

  .pr-card {
    position: relative; border-radius: 22px;
    background: #FDFCFA;
    /* Reserved transparent 1px so the hover edge costs no layout shift. */
    border: 1px solid transparent;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.55),
      -5px -5px 12px rgb(255 255 255 / 0.42),
      12px 16px 32px -10px rgb(23 56 71 / 0.13),
      3px 4px 10px -3px rgb(23 56 71 / 0.06);
    transition:
      transform .34s var(--ease-out-quart),
      box-shadow .34s var(--ease-out-quart),
      border-color .24s var(--ease-out-quart);
  }
  /* Portrait, not letterbox: the cards were 372x488 (ratio 1.31) and read as
     wide slabs. A height floor from md up, where they sit side by side. */
  @media (min-width: 768px) { .pr-card { min-height: 34rem; } }
  .pr-card:hover {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--color-purple) 55%, transparent);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.6),
      -6px -6px 15px rgb(255 255 255 / 0.5),
      18px 24px 46px -12px rgb(23 56 71 / 0.17),
      4px 6px 14px -4px rgb(23 56 71 / 0.07);
  }
  /* Dark cannot borrow white for the highlight: the raised edge is a very
     low-alpha white and the depth is real black, or it reads grey-on-grey. */
  :global(.dark) .pr-card {
    background: #18212A;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.045),
      -5px -5px 12px rgb(255 255 255 / 0.015),
      12px 16px 34px -10px rgb(0 0 0 / 0.52),
      3px 4px 12px -3px rgb(0 0 0 / 0.34);
  }
  :global(.dark) .pr-card:hover {
    border-color: color-mix(in srgb, var(--color-purple) 88%, white);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.055),
      -6px -6px 15px rgb(255 255 255 / 0.02),
      18px 24px 48px -12px rgb(0 0 0 / 0.6),
      4px 6px 16px -4px rgb(0 0 0 / 0.38);
  }

