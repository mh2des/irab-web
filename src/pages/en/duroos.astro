---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import DuroosHub from '../../components/duroos/DuroosHub.astro';
import { courseLessons, isLive } from '../../lib/duroos-course';

// /en/duroos: the English grammar-lesson index. The curriculum and which
// lessons are published live in src/lib/en-duroos.ts; the page is the
// DuroosHub component, shared with /duroos. An unpublished lesson renders as
// a quiet, unlinked row, so the index never carries a dead link.
const site = 'https://irab.app';
const live = courseLessons('en').filter((l) => isLive('en', l.slug));
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Arabic grammar lessons: the chapters of iʿrāb',
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: live.length,
  itemListElement: live.map((l, i) => ({ '@type': 'ListItem', position: i + 1, name: l.title, url: `${site}${l.href}` })),
};
---
<BaseLayout
  lang="en"
  title="Arabic Grammar Lessons: iʿrāb chapter by chapter · Irab App"
  description="Free Arabic grammar lessons in English with full classical iʿrāb: the nominal and verbal sentence, the markers of iʿrāb, kāna and inna, ḥāl and tamyīz, prepositions, and the subjunctive and jussive."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(itemList)} is:inline />
  <Nav lang="en" />
  <DuroosHub lang="en" />
  <Footer lang="en" />
</BaseLayout>
