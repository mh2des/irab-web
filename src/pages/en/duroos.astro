---
/**
 * /en/duroos: the English grammar-lesson index.
 *
 * The full curriculum is shown from the start, because the ten groups ARE the
 * teaching structure and a learner should see the shape of the whole subject.
 * Lessons are linked once their English edition is published and rendered as
 * quiet, unlinked entries until then, so the index never carries a dead link
 * and never pretends a lesson exists.
 *
 * To publish a lesson: create src/pages/en/duroos/<slug>.astro and add the slug
 * to PUBLISHED below. Nothing else here needs touching.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleCta from '../../components/ArticleCta.astro';
import Container from '../../components/Container.astro';
import { EN_DUROOS as PUBLISHED, EN_GROUPS } from '../../lib/en-duroos';

const groups = EN_GROUPS;

const pad = (n: number) => String(n).padStart(2, '0');
const totalLessons = groups.reduce((n, g) => n + g.lessons.length, 0);
let running = 0;
const numbered = groups.map((g, gi) => ({
  ...g,
  no: pad(gi + 1),
  lessons: g.lessons.map((l) => ({ ...l, no: pad(++running), live: PUBLISHED.has(l.slug) })),
}));
const liveCount = groups.reduce((n, g) => n + g.lessons.filter((l) => PUBLISHED.has(l.slug)).length, 0);

/* Once the whole course is out, "planned / published" reads oddly. Show the
   complete count instead, and fall back to the split while any lesson is pending. */
const complete = liveCount === totalLessons;
const stats = complete
  ? [
      { value: String(totalLessons), label: 'lessons' },
      { value: String(groups.length), label: 'chapters' },
      { value: 'full', label: 'iʿrāb on every example' },
      { value: '100%', label: 'free' },
    ]
  : [
      { value: String(totalLessons), label: 'lessons planned' },
      { value: String(liveCount), label: 'published' },
      { value: String(groups.length), label: 'chapters' },
      { value: '100%', label: 'free' },
    ];
---
<BaseLayout
  lang="en"
  title="Arabic Grammar Lessons: iʿrāb chapter by chapter · Irab App"
  description="Free Arabic grammar lessons in English with full classical iʿrāb: the nominal and verbal sentence, the markers of iʿrāb, kāna and inna, ḥāl and tamyīz, prepositions, and the subjunctive and jussive."
>
  <Nav lang="en" />

  <ArticleHero
    lang="en"
    eyebrow="Grammar lessons"
    title="The chapters of iʿrāb"
    summary="Each lesson takes one chapter of Arabic grammar and works it through properly: the terminology without false friends, the rule and what governs it, worked examples parsed in the full classical wording, evidence from the Quran, and the mistakes English speakers actually make. Read the lesson, then try it on any sentence in the analyzer."
  >
    <div class="mt-9 flex flex-wrap gap-3" data-reveal data-reveal-delay="240">
      {stats.map((s) => (
        <span class="inline-flex items-baseline gap-2 rounded-full border border-card-edge bg-card dark:border-coal-edge dark:bg-coal-soft px-4 py-2 shadow-[0_1px_2px_rgb(23_56_71/0.05)]">
          <strong class="font-bold text-ink dark:text-mist">{s.value}</strong>
          <span class="text-small text-ink-subtle dark:text-mist-subtle">{s.label}</span>
        </span>
      ))}
    </div>
  </ArticleHero>

  <section class="py-14 md:py-20">
    <Container>
      <div class="space-y-20">
        {numbered.map((g) => (
          <div style={`--acc: ${g.accent}`}>
            <div class="flex items-center gap-4 md:gap-5 mb-8" data-reveal>
              <span
                class="font-display font-bold text-4xl md:text-5xl leading-none select-none"
                style="color: color-mix(in srgb, var(--acc) 38%, transparent)"
                aria-hidden="true"
              >{g.no}</span>
              <h2 class="font-sans font-bold text-2xl md:text-[1.75rem] text-ink dark:text-mist">{g.title}</h2>
              <span
                class="rounded-full px-3 py-1 text-small font-semibold"
                style="color: var(--acc); background: color-mix(in srgb, var(--acc) 10%, transparent)"
              >{g.lessons.length} lessons</span>
              <span class="hidden sm:block flex-1 h-px bg-stone dark:bg-coal-edge"></span>
            </div>

            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {g.lessons.map((l, i) => (
                l.live ? (
                  <a
                    href={`/en/duroos/${l.slug}`}
                    class="group relative flex flex-col rounded-2xl border border-card-edge bg-card dark:border-coal-edge dark:bg-coal-soft p-6 md:p-7 shadow-[0_1px_3px_rgb(23_56_71/0.06)] transition-[transform,box-shadow,border-color] duration-300 [transition-timing-function:var(--ease-out-quart)] hover:-translate-y-1.5 hover:border-[color:color-mix(in_srgb,var(--acc)_55%,transparent)] hover:shadow-[0_24px_48px_-20px_color-mix(in_srgb,var(--acc)_38%,transparent)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[color:var(--acc)]"
                    data-reveal
                    data-reveal-delay={String((i % 3) * 80)}
                  >
                    <span
                      class="absolute top-5 right-6 font-display text-2xl leading-none select-none transition-colors duration-300"
                      style="color: color-mix(in srgb, var(--acc) 26%, transparent)"
                      aria-hidden="true"
                    >{l.no}</span>
                    <h3 class="font-sans font-bold text-xl text-ink dark:text-mist pr-10 transition-colors duration-300 group-hover:text-[color:var(--acc)]">{l.title}</h3>
                    <p class="mt-2.5 flex-1 text-small text-ink-subtle dark:text-mist-subtle leading-relaxed">{l.blurb}</p>
                    <span class="mt-6 pt-4 border-t border-stone dark:border-coal-edge flex items-center justify-between">
                      <span class="text-small font-semibold" style="color: var(--acc)">Read the lesson</span>
                      <svg
                        class="w-4 h-4 transition-transform duration-300 [transition-timing-function:var(--ease-out-quart)] group-hover:translate-x-1.5"
                        style="color: var(--acc)"
                        viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                      ><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </span>
                  </a>
                ) : (
                  <div
                    class="relative flex flex-col rounded-2xl border border-dashed border-stone dark:border-coal-edge p-6 md:p-7 opacity-60"
                    data-reveal
                    data-reveal-delay={String((i % 3) * 80)}
                  >
                    <span class="absolute top-5 right-6 font-display text-2xl leading-none select-none text-ink/15 dark:text-mist/15" aria-hidden="true">{l.no}</span>
                    <h3 class="font-sans font-bold text-xl text-ink-subtle dark:text-mist-subtle pr-10">{l.title}</h3>
                    <p class="mt-2.5 flex-1 text-small text-ink-subtle dark:text-mist-subtle leading-relaxed">{l.blurb}</p>
                    <span class="mt-6 pt-4 border-t border-stone dark:border-coal-edge text-small text-ink-subtle dark:text-mist-subtle">
                      In preparation · <a href={`/duroos/${l.slug}`} class="underline underline-offset-2 hover:text-ink dark:hover:text-mist">read it in Arabic</a>
                    </span>
                  </div>
                )
              ))}
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <ArticleCta lang="en">
    <span slot="title">Theory is half the road.</span>
    Paste any sentence into the analyzer on the home page and watch the lesson's rule work word by word, or practise with instant correction in the practice section.
  </ArticleCta>

  <Footer lang="en" />
</BaseLayout>
