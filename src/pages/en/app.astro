---
/**
 * /en/app: the signed in profile dashboard (English). Login-gated, noindex
 * (private surface). Firebase loads only here.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import AppHub from '../../components/AppHub.astro';
---
<BaseLayout lang="en" title="Profile · Irab" description="Your Irab profile dashboard: plan, usage, progress, and tools.">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <Nav lang="en" />
  <main class="px-6 py-12 md:py-16">
    <AppHub lang="en" />
  </main>
  <Footer lang="en" />
</BaseLayout>
