---
/**
 * Irab, Homepage
 *
 * Direction C · The Forge.
 * Section order matches /docs/marketing_plan.md.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Schema from '../../components/Schema.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/sections/Hero.astro';
import Thesis from '../../components/sections/Thesis.astro';
import LiveDemo from '../../components/sections/LiveDemo.astro';
import Features from '../../components/sections/Features.astro';
import Audience from '../../components/sections/Audience.astro';
import SocialProof from '../../components/sections/SocialProof.astro';
import Pricing from '../../components/sections/Pricing.astro';
import Faq, { FAQS } from '../../components/sections/Faq.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import AppShowcase from '../../components/sections/AppShowcase.astro';
import LessonLinks from '../../components/LessonLinks.astro';
import StickyCta from '../../components/StickyCta.astro';
import Footer from '../../components/sections/Footer.astro';
---
<BaseLayout
lang="en"   title="Irab App: AI Arabic Grammar Analyzer · Word-by-Word I'rab"
  description="Free AI i'rab analyzer: paste any Arabic sentence and get word-by-word grammar analysis with case, role and vowelization, plus practice with instant feedback."
>
  <Schema slot="head" faqs={FAQS.map(f => ({ q: f.q, a: f.a }))} />

  <Nav lang="en" />
  <main>
    <Hero />
    <LiveDemo />
    <Thesis />
    <Features />
    <Audience />
    {/* Lessons: the site's own teaching, and the page a reader wants next.
        They also need the link — the English course was reachable only from
        its own hub, which Google had not crawled. */}
    <LessonLinks
      lang="en"
      slugs={['alamat-al-irab', 'al-jumla-al-ismiyya', 'al-mubtada-wal-khabar', 'al-jumla-al-filiyya', 'al-fail', 'al-maful-bih', 'kana-wa-akhawatuha', 'inna-wa-akhawatuha']}
      title="Learn nahw chapter by chapter"
      lead="Forty written and reviewed lessons. Each gives the rule, fully parsed examples, and Quran verses that use the construction. Start at the beginning, or jump to the chapter that stops you."
      allLabel="Browse all 40 lessons"
      width="default"
      tone="tinted"
    />

    <AppShowcase lang="en" />
    <SocialProof />
    <div class="section-tint border-t border-stone dark:border-coal-edge pt-12 pb-2 flex justify-center">
      <div class="rating-badge"><span class="stars" aria-hidden="true">★★★★★</span><span>on the App Store &amp; Google Play</span></div>
    </div>
    <Pricing />
    <Faq />
    <FinalCta />
    <StickyCta lang="en" />
  </main>
  <Footer lang="en" />

  {/* Scroll-triggered reveals */}
  <script>
    import '../../scripts/scroll-reveal';
  </script>
</BaseLayout>
