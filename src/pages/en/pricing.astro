---
/**
 * /en/pricing: English twin of the Arabic pricing page.
 *
 * Same structure, styles, and verified claims as /pricing: two plans,
 * free-vs-Plus comparison, what Plus unlocks, pre-purchase FAQ (animated
 * accordion), final CTA. CTAs carry the plan to /en/app?checkout=… and the
 * page stays Firebase-free. Payments via Paddle (Merchant of Record).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import Footer from '../../components/sections/Footer.astro';

const features = [
  { t: "Unlimited i'rab analyses", b: 'Parse anything, anytime: word by word, with type, role, case marker, and vocalization.', i: 'M12 12c-2-2.67-4-4-6-4a4 4 0 0 0 0 8c2 0 4-1.33 6-4Zm0 0c2 2.67 4 4 6 4a4 4 0 0 0 0-8c-2 0-4 1.33-6 4Z' },
  { t: "Instant grading of your i'rab", b: 'Write the i\'rab yourself and get corrections with per-word explanations: the feature that builds mastery.', i: 'M22 11.08V12a10 10 0 1 1-5.93-9.14M22 4 12 14.01l-3-3' },
  { t: 'The full practice bank: 576', b: 'Curated sentences across progressive levels, instead of two levels on the free plan.', i: 'M12 2 2 7l10 5 10-5-10-5ZM2 17l10 5 10-5M2 12l10 5 10-5' },
  { t: 'All seven challenge babs', b: 'With full explanations for every answer, not just the first two babs.', i: 'M6 9H4.5a2.5 2.5 0 0 1 0-5H6m12 5h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22m7-7.34V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22M18 2H6v7a6 6 0 0 0 12 0V2Z' },
  { t: 'Smart Dictionary, unlimited', b: 'Unlimited AI-powered lookups, instead of 5 per day.', i: 'M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2V3Zm20 0h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7V3Z' },
  { t: 'Voice input and OCR', b: 'Speak a sentence, or capture it with the OCR camera and parse it directly.', i: 'M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2v11ZM12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z' },
  { t: 'PDF export and share cards', b: 'Export your analyses and share elegant cards with no watermark.', i: 'M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3' },
  { t: 'Mastery certificates', b: 'On the annual plan: a shareable certificate after mastering each topic.', i: 'M12 15a7 7 0 1 0 0-14 7 7 0 0 0 0 14Zm0 0 3.5 7L12 20l-3.5 2 3.5-7Z' },
];

const compare = [
  { f: "I'rab analyses", free: '3 per day', plus: 'Unlimited' },
  { f: "Grading your own i'rab", free: null, plus: 'With per-word explanations' },
  { f: 'Practice bank', free: 'Levels 1–2', plus: 'All 576 sentences' },
  { f: 'Challenge babs', free: 'Babs 1–2', plus: 'All seven babs' },
  { f: 'Smart Dictionary', free: '5 lookups per day', plus: 'Unlimited' },
  { f: 'OCR & PDF export', free: null, plus: 'Included' },
  { f: 'Mastery certificates', free: null, plus: 'With the annual plan' },
];

const faqs = [
  { q: 'Is the free trial really free?', a: 'Yes. Choose the annual plan and you pay $0.00 today, with 7 full days of every feature. Cancel before the trial ends and you won\'t be charged; otherwise the $35.99 annual subscription begins.' },
  { q: 'Does one subscription work on both web and app?', a: 'Yes. One subscription with the same account unlocks everything on the site and in the iOS and Android apps, wherever you sign in.' },
  { q: 'What happens if I cancel?', a: 'Cancel anytime and keep full access until the end of the paid period. You then return automatically to the free plan without losing your account or progress.' },
  { q: 'How are payments processed?', a: 'Through Paddle (Merchant of Record), securely, with major cards, PayPal, Apple Pay, and Google Pay. Tax is added at checkout based on your country, and regional prices may vary.' },
];

const offerSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Irab Plus',
  description: 'Irab Plus subscription: unlocks every Irab feature on the web and in the app with one account.',
  brand: { '@type': 'Brand', name: 'Irab' },
  offers: [
    { '@type': 'Offer', name: 'Monthly', price: '4.99', priceCurrency: 'USD', url: 'https://irab.app/en/pricing', availability: 'https://schema.org/InStock' },
    { '@type': 'Offer', name: 'Annual', price: '35.99', priceCurrency: 'USD', url: 'https://irab.app/en/pricing', availability: 'https://schema.org/InStock' },
  ],
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout
  lang="en"
  title="Pricing: Irab Plus · 7-day free trial | Irab"
  description="Subscribe to Irab Plus: $4.99/month or $35.99/year with a 7-day free trial. One subscription unlocks everything on the web and in the app. Payments via Paddle."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(offerSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
  </Fragment>

  <Nav lang="en" />

  <main class="pr-page relative overflow-hidden">
    {/* Ambient brand glows: calm, slow, behind everything. */}
    <div class="pr-orb pr-orb-a" aria-hidden="true"></div>
    <div class="pr-orb pr-orb-b" aria-hidden="true"></div>

    {/* ── Hero ─────────────────────────────────────────────────────── */}
    <Section size="sm" class="relative">
      <Container size="narrow">
        <div class="text-center">
          <p class="eyebrow justify-center mb-4" data-reveal>Pricing</p>
          <h1 class="font-display text-[clamp(2.2rem,5.5vw,3.6rem)] leading-[1.1] tracking-tight mb-5" data-reveal data-reveal-delay="80">
            One subscription,<br class="sm:hidden" /> unlocks everything.
          </h1>
          <p class="text-body-lg text-ink/65 dark:text-mist/65 max-w-xl mx-auto leading-relaxed" data-reveal data-reveal-delay="160">
            Start free today. When you subscribe to Irab Plus, everything unlocks on the site and in the app, with the same account.
          </p>
        </div>
      </Container>
    </Section>

    {/* ── Plans ────────────────────────────────────────────────────── */}
    <Section size="sm" class="relative !pt-0">
      <Container>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto items-stretch">

          {/* Annual: featured */}
          <div class="pr-card pr-card-featured p-8 md:p-9 flex flex-col" data-reveal>
            <span class="pr-ribbon">Best value · Save 40%</span>

            <p class="font-display text-h3 mb-4 mt-1">Annual</p>
            <p class="flex items-baseline gap-2 mb-1">
              <span class="font-display text-[3.2rem] leading-none tracking-tight">$35.99</span>
              <span class="text-ink/60 dark:text-mist/60 text-small">/ year</span>
            </p>
            <p class="text-small text-purple-deep dark:text-purple font-bold mb-6">≈ just $3.00 a month</p>

            <ul class="pr-perks flex-1">
              <li>7-day free trial: pay $0.00 today</li>
              <li>Every Plus feature, no exceptions</li>
              <li>Shareable mastery certificates</li>
            </ul>

            <a href="/en/app?checkout=annual" class="btn-primary btn-block btn-lg mt-7">
              Start your free trial
              <svg class="pr-cta-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
            </a>
            <p class="text-caption text-ink/55 dark:text-mist/55 text-center mt-3">You won't be charged today · Cancel before day 7 if you change your mind</p>
          </div>

          {/* Monthly: quiet */}
          <div class="pr-card p-8 md:p-9 flex flex-col" data-reveal data-reveal-delay="120">
            <p class="font-display text-h3 mb-4 mt-1">Monthly</p>
            <p class="flex items-baseline gap-2 mb-1">
              <span class="font-display text-[3.2rem] leading-none tracking-tight">$4.99</span>
              <span class="text-ink/60 dark:text-mist/60 text-small">/ month</span>
            </p>
            <p class="text-small text-ink/55 dark:text-mist/55 mb-6">Full flexibility, month to month</p>

            <ul class="pr-perks flex-1">
              <li>The same full Plus feature set</li>
              <li>Renews monthly, cancel anytime</li>
              <li>Start now, switch to annual later</li>
            </ul>

            <a href="/en/app?checkout=monthly" class="btn-ghost btn-block btn-lg mt-7">Subscribe monthly</a>
            <p class="text-caption text-ink/55 dark:text-mist/55 text-center mt-3">No long commitment: stop whenever you want</p>
          </div>
        </div>

        <p class="text-caption text-ink/60 dark:text-mist/60 text-center mt-8 max-w-xl mx-auto leading-relaxed" data-reveal>
          Regional prices may vary, and tax is added at checkout based on your country. Payments are processed by <strong>Paddle</strong> (Merchant of Record). See the
          <a href="/refund" class="text-purple hover:text-purple-deep underline underline-offset-2">refund policy</a> and
          <a href="/terms" class="text-purple hover:text-purple-deep underline underline-offset-2">terms</a>.
        </p>
      </Container>
    </Section>

    {/* ── Free vs Plus ─────────────────────────────────────────────── */}
    <Section class="section-tint border-y border-stone dark:border-coal-edge">
      <Container size="narrow">
        <div class="text-center mb-10">
          <p class="eyebrow justify-center mb-4" data-reveal>The comparison, plainly</p>
          <h2 class="font-display text-[clamp(1.7rem,3.8vw,2.6rem)] leading-[1.15] tracking-tight" data-reveal data-reveal-delay="80">
            Free is generous. Plus has no ceiling.
          </h2>
        </div>

        <div class="pr-table" data-reveal role="table" aria-label="Free plan vs Irab Plus comparison">
          <div class="pr-row pr-row-head" role="row">
            <span role="columnheader" class="text-start">Feature</span>
            <span role="columnheader">Free</span>
            <span role="columnheader" class="pr-col-plus">Plus</span>
          </div>
          {compare.map((r) => (
            <div class="pr-row" role="row">
              <span role="cell" class="text-start font-semibold">{r.f}</span>
              <span role="cell" class="text-ink/60 dark:text-mist/60">
                {r.free ?? <svg class="pr-dash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-label="Not included"><path d="M5 12h14"/></svg>}
              </span>
              <span role="cell" class="pr-col-plus font-semibold">{r.plus}</span>
            </div>
          ))}
        </div>
      </Container>
    </Section>

    {/* ── Everything Plus unlocks ──────────────────────────────────── */}
    <Section>
      <Container>
        <div class="text-center mb-12">
          <p class="eyebrow justify-center mb-4" data-reveal>What Plus unlocks</p>
          <h2 class="font-display text-[clamp(1.7rem,3.8vw,2.6rem)] leading-[1.15] tracking-tight" data-reveal data-reveal-delay="80">
            Everything you need to truly master i'rab.
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 max-w-5xl mx-auto">
          {features.map((f, idx) => (
            <article class="pr-feature card p-6" data-reveal data-reveal-delay={String((idx % 4) * 90)}>
              <span class="pr-feature-ic" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={f.i}/></svg>
              </span>
              <h3 class="font-display text-h3 leading-snug mb-2">{f.t}</h3>
              <p class="text-small text-ink/65 dark:text-mist/65 leading-relaxed">{f.b}</p>
            </article>
          ))}
        </div>
      </Container>
    </Section>

    {/* ── FAQ ──────────────────────────────────────────────────────── */}
    <Section size="sm" class="!pt-0">
      <Container size="narrow">
        <h2 class="font-display text-[clamp(1.5rem,3.2vw,2.1rem)] text-center mb-8" data-reveal>Questions before subscribing</h2>
        <div class="space-y-3 max-w-2xl mx-auto" data-acc-group>
          {faqs.map((f) => (
            <details class="pr-faq group cursor-pointer acc-card" data-reveal data-acc>
              <summary class="flex items-start justify-between gap-6 list-none p-5 [&::-webkit-details-marker]:hidden">
                <h3 class="font-display text-h3 leading-snug transition-colors duration-200 group-hover:text-purple">{f.q}</h3>
                <span class="acc-icon shrink-0 mt-1 grid place-items-center w-8 h-8 rounded-full bg-purple/8 group-hover:bg-purple/15 text-purple">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path class="acc-v" d="M12 5v14"/><path d="M5 12h14"/></svg>
                </span>
              </summary>
              <div class="px-5 pb-6">
                <p class="text-body text-ink/70 dark:text-mist/70 leading-relaxed">{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </Container>
    </Section>

    {/* ── Final CTA ────────────────────────────────────────────────── */}
    <Section size="sm" class="!pt-0">
      <Container size="narrow">
        <div class="pr-final text-center p-10 md:p-14" data-reveal>
          <h2 class="font-display text-[clamp(1.8rem,4vw,2.8rem)] leading-[1.1] text-white mb-4">Try Plus free for 7 days.</h2>
          <p class="text-body-lg text-white/85 leading-relaxed max-w-md mx-auto mb-8">You pay nothing today, and you'll feel the difference from the first sentence you parse.</p>
          <a href="/en/app?checkout=annual" class="pr-final-btn lift">
            Start your free trial now
          </a>
          <p class="text-caption text-white/70 mt-4">7 days free, then $35.99/year · Cancel anytime</p>
        </div>
      </Container>
    </Section>
  </main>

  <Footer lang="en" />
</BaseLayout>

<style>
  /* ── Ambient orbs: slow, calm, behind everything ─────────────────── */
  .pr-orb {
    position: absolute; border-radius: 999px; pointer-events: none;
    filter: blur(90px); opacity: 0.5; z-index: -1;
  }
  .pr-orb-a {
    width: 34rem; height: 34rem; top: -10rem; inset-inline-start: -12rem;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-purple) 22%, transparent), transparent 70%);
    animation: pr-drift 14s ease-in-out infinite alternate;
  }
  .pr-orb-b {
    width: 28rem; height: 28rem; top: 14rem; inset-inline-end: -10rem;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-teal) 20%, transparent), transparent 70%);
    animation: pr-drift 18s ease-in-out infinite alternate-reverse;
  }
  :global(.dark) .pr-orb { opacity: 0.35; }
  @keyframes pr-drift {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to   { transform: translate3d(2.5rem, 2rem, 0) scale(1.08); }
  }

  /* ── Plan cards ──────────────────────────────────────────────────── */
  .pr-card {
    position: relative; border-radius: 20px;
    background: var(--color-card);
    border: 1px solid var(--color-card-edge);
    box-shadow: var(--shadow-card);
    transition: transform 0.35s var(--ease-out-quart, ease), box-shadow 0.35s var(--ease-out-quart, ease), border-color 0.25s;
  }
  :global(.dark) .pr-card { background: var(--color-coal-soft); border-color: var(--color-coal-edge); }
  .pr-card:hover { transform: translateY(-5px); box-shadow: var(--shadow-lift); }

  .pr-card-featured { border: 2px solid var(--color-purple); }

  .pr-ribbon {
    position: absolute; top: -0.85rem; inset-inline-start: 1.75rem;
    padding: 0.35rem 0.9rem; border-radius: 999px;
    font-size: 0.85rem; font-weight: 700;
    color: #fff; background: var(--color-purple);
    box-shadow: 0 8px 20px -8px color-mix(in srgb, var(--color-purple) 80%, transparent);
  }

  .pr-perks { display: flex; flex-direction: column; gap: 0.65rem; }
  .pr-perks li {
    position: relative; padding-inline-start: 1.6rem;
    font-size: 1rem; line-height: 1.7;
    color: color-mix(in srgb, var(--color-ink) 80%, transparent);
  }
  :global(.dark) .pr-perks li { color: color-mix(in srgb, var(--color-mist) 80%, transparent); }
  .pr-perks li::before {
    content: ''; position: absolute; inset-inline-start: 0; top: 0.48em;
    width: 0.85rem; height: 0.85rem; border-radius: 999px;
    background: color-mix(in srgb, var(--color-teal) 15%, transparent);
    border: 1.5px solid var(--color-teal);
  }
  .pr-perks li::after {
    content: ''; position: absolute; inset-inline-start: 0.24rem; top: calc(0.48em + 0.22rem);
    width: 0.38rem; height: 0.2rem;
    border-inline-start: 1.5px solid var(--color-teal); border-bottom: 1.5px solid var(--color-teal);
    transform: rotate(-45deg);
  }

  /* Forward arrow (LTR: onward points right, nudges further right on hover). */
  .pr-cta-arrow { width: 1.05rem; height: 1.05rem; margin-inline-start: 0.4rem; transition: transform 0.25s; }
  :global(a:hover) > .pr-cta-arrow { transform: translateX(3px); }

  /* ── FAQ cards (homepage look, local styles) ─────────────────────── */
  .pr-faq {
    border-radius: 16px;
    background: var(--color-card);
    border: 1px solid var(--color-card-edge);
    box-shadow: var(--shadow-card);
    transition: border-color 0.25s, box-shadow 0.3s;
  }
  :global(.dark) .pr-faq { background: var(--color-coal-soft); border-color: var(--color-coal-edge); }
  /* Open state keyed to .acc-open (stamped instantly by ui-fx) so it reverts
     with the collapse, not after it; [open]:not(.acc-on) covers no-JS. */
  .pr-faq:hover,
  .pr-faq.acc-open,
  .pr-faq[open]:not(.acc-on) { border-color: color-mix(in srgb, var(--color-purple) 35%, var(--color-card-edge)); }
  .pr-faq.acc-open,
  .pr-faq[open]:not(.acc-on) { box-shadow: var(--shadow-lift); }

  /* ── Comparison table ────────────────────────────────────────────── */
  .pr-table {
    border-radius: 18px; overflow: hidden;
    background: var(--color-card);
    border: 1px solid var(--color-card-edge);
    box-shadow: var(--shadow-card);
  }
  :global(.dark) .pr-table { background: var(--color-coal-soft); border-color: var(--color-coal-edge); }
  .pr-row {
    display: grid; grid-template-columns: 1.4fr 1fr 1fr; align-items: center;
    gap: 0.75rem; padding: 0.9rem 1.25rem; text-align: center;
    font-size: 0.98rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-card-edge) 70%, transparent);
  }
  :global(.dark) .pr-row { border-color: color-mix(in srgb, var(--color-coal-edge) 80%, transparent); }
  .pr-row:last-child { border-bottom: none; }
  .pr-row-head {
    font-weight: 700; font-size: 0.85rem; letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--color-ink) 60%, transparent);
    background: color-mix(in srgb, var(--color-stone) 40%, transparent);
  }
  :global(.dark) .pr-row-head { color: color-mix(in srgb, var(--color-mist) 60%, transparent); background: color-mix(in srgb, var(--color-coal-edge) 50%, transparent); }
  .pr-col-plus { color: var(--color-purple-deep); }
  :global(.dark) .pr-col-plus { color: color-mix(in srgb, var(--color-purple) 75%, white); }
  .pr-row .pr-dash { width: 1rem; height: 1rem; margin-inline: auto; opacity: 0.35; }

  /* ── Feature grid ────────────────────────────────────────────────── */
  .pr-feature { transition: transform 0.3s var(--ease-out-quart, ease), box-shadow 0.3s, border-color 0.25s; }
  .pr-feature:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
    border-color: color-mix(in srgb, var(--color-purple) 35%, var(--color-card-edge));
  }
  .pr-feature-ic {
    display: grid; place-items: center;
    width: 2.75rem; height: 2.75rem; border-radius: 12px; margin-bottom: 1rem;
    color: var(--color-purple-deep);
    background: color-mix(in srgb, var(--color-purple) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-purple) 22%, transparent);
  }
  :global(.dark) .pr-feature-ic { color: color-mix(in srgb, var(--color-purple) 70%, white); background: color-mix(in srgb, var(--color-purple) 16%, transparent); }
  .pr-feature-ic svg { width: 1.35rem; height: 1.35rem; }

  /* ── Final CTA band ──────────────────────────────────────────────── */
  .pr-final {
    position: relative; border-radius: 24px; overflow: hidden;
    background:
      radial-gradient(120% 140% at 85% 0%, color-mix(in srgb, var(--color-teal) 55%, transparent), transparent 55%),
      linear-gradient(135deg, var(--color-purple-deep), var(--color-purple));
    box-shadow: 0 24px 60px -20px color-mix(in srgb, var(--color-purple) 55%, transparent);
  }
  .pr-final-btn {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 0.95rem 2.2rem; border-radius: 999px;
    font-weight: 700; font-size: 1.1rem;
    color: var(--color-purple-deep); background: #fff;
    box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.35);
  }

  @media (prefers-reduced-motion: reduce) {
    .pr-orb-a, .pr-orb-b { animation: none; }
    .pr-card:hover, .pr-feature:hover { transform: none; }
  }
</style>
