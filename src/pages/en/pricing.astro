---
/**
 * /en/pricing: English twin of /pricing.
 *
 * Doubles as the page Paddle's verification (and reviewers/AEO) read to learn
 * what we sell. The page itself is components/pricing/Pricing.astro; this file
 * keeps the route's title, description and structured data. Indexed (SEO).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import Pricing from '../../components/pricing/Pricing.astro';
import { pricingFaqs } from '../../lib/pricing';

const offerSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Irab Plus',
  image: 'https://irab.app/og-default.png',
  description: 'Irab Plus subscription: unlocks every Irab feature on the web and in the app with one account.',
  brand: { '@type': 'Brand', name: 'Irab' },
  offers: [
    { '@type': 'Offer', name: 'Monthly', price: '4.99', priceCurrency: 'USD', url: 'https://irab.app/en/pricing', availability: 'https://schema.org/InStock' },
    { '@type': 'Offer', name: 'Annual', price: '35.99', priceCurrency: 'USD', url: 'https://irab.app/en/pricing', availability: 'https://schema.org/InStock' },
  ],
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: pricingFaqs('en').map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout
  lang="en"
  title="Pricing: Irab Plus · 7-day free trial | Irab App"
  description="Subscribe to Irab Plus: $4.99/month or $35.99/year with a 7-day free trial. One subscription unlocks everything on the web and in the app. Payments via Paddle."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(offerSchema)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
  </Fragment>

  <Nav lang="en" />
  <main>
    <Pricing lang="en" />
  </main>
  <Footer lang="en" />
</BaseLayout>
