---
/**
 * /en/dictionary: the smart dictionary tool in English. Login-gated and
 * noindex; Firebase loads lazily inside Dictionary.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import Dictionary from '../../components/dictionary/Dictionary.astro';
---
<BaseLayout lang="en" title="Smart Dictionary · Irab App" description="A smart Arabic dictionary: meanings, root, pattern, morphology and i'rab for any word, with its Quran occurrences and the classical dictionaries.">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <Nav lang="en" />
  <main class="px-4 sm:px-6 py-8 md:py-12">
    <Dictionary lang="en" />
  </main>
  <Footer lang="en" />
</BaseLayout>
