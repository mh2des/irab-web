---
/**
 * /en/privacy: the same bilingual document as /privacy, led in English.
 * The English text already lives in the shared body HTML alongside the
 * Arabic, block for block; nothing here is a separate translation.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalDoc from '../../components/LegalDoc.astro';
import body from '../../data/legal/privacy.html?raw';
---
<BaseLayout
  lang="en"
  title="Privacy Policy · Irab App"
  description="The Irab App privacy policy: what data we collect, how we use and protect it, and your rights."
>
  <LegalDoc kind="privacy" body={body} lang="en" />
</BaseLayout>
