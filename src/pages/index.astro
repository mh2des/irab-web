  <style>
    /* Shared card family: clear rest-state definition (visible border +
       seated shadow), silky shared transition for the hover lift. */
    .product-card,
    .audience-card,
    .proof-card,
    .pricing-card {
      position: relative;
      background: var(--color-card);
      border: 1px solid color-mix(in srgb, var(--color-ink) 12%, var(--color-card-edge));
      border-radius: 0.75rem;
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.78),
        0 1px 2px rgb(23 56 71 / 0.05),
        0 10px 22px -18px rgb(23 56 71 / 0.18),
        0 18px 44px -34px rgb(23 56 71 / 0.2);
      transform: translate3d(0, 0, 0);
      transition:
        transform 420ms var(--ease-out-quart),
        box-shadow 420ms var(--ease-out-quart),
        border-color 320ms var(--ease-out-quart),
        background-color 320ms var(--ease-out-quart),
        filter 320ms var(--ease-out-quart);
      transform-origin: center;
      will-change: transform;
    }

    .faq-card {
      position: relative;
      background: var(--color-card);
      border: 1px solid color-mix(in srgb, var(--color-ink) 12%, var(--color-card-edge));
      border-radius: 0.75rem;
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.78),
        0 1px 2px rgb(23 56 71 / 0.05),
        0 10px 22px -18px rgb(23 56 71 / 0.18),
        0 18px 44px -34px rgb(23 56 71 / 0.2);
      transform: translate3d(0, 0, 0);
      transition:
        transform 420ms var(--ease-out-quart),
        box-shadow 420ms var(--ease-out-quart),
        border-color 320ms var(--ease-out-quart),
        background-color 320ms var(--ease-out-quart),
        filter 320ms var(--ease-out-quart);
      transform-origin: center;
      will-change: transform;
    }

    :global(.dark) .product-card,
    :global(.dark) .audience-card,
    :global(.dark) .proof-card,
    :global(.dark) .pricing-card,
    :global(.dark) .faq-card {
      background: var(--color-coal-soft);
      border-color: color-mix(in srgb, var(--color-mist) 10%, var(--color-coal-edge));
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.04),
        0 2px 8px -3px rgb(0 0 0 / 0.42),
        0 14px 32px -24px rgb(0 0 0 / 0.52),
        0 22px 48px -36px rgb(0 0 0 / 0.68);
    }

    .product-card:hover,
    .audience-card:hover,
    .proof-card:hover,
    .pricing-card:hover,
    .faq-card:not(.acc-open):hover {
      transform: translate3d(0, -7px, 0);
      border-color: color-mix(in srgb, var(--color-ink) 18%, var(--color-card-edge));
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.82),
        0 8px 18px -10px rgb(23 56 71 / 0.18),
        0 28px 62px -32px rgb(23 56 71 / 0.34);
    }

    :global(.dark) .product-card:hover,
    :global(.dark) .audience-card:hover,
    :global(.dark) .proof-card:hover,
    :global(.dark) .pricing-card:hover,
    :global(.dark) .faq-card:not(.acc-open):hover {
      border-color: color-mix(in srgb, var(--color-purple) 32%, var(--color-coal-edge));
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.06),
        0 4px 14px -8px rgb(0 0 0 / 0.62),
        0 30px 68px -34px rgb(0 0 0 / 0.82);
    }

    /* Open FAQ card: the border/shadow emphasis WITHOUT the hover lift.
       A transform here moves the card's visible edges but not its layout
       box, so neighbors stop tracking it and the motion reads as two-step.
       Keyed to .acc-open (stamped immediately) so it reverts WITH the
       collapse, not after it; [open]:not(.acc-on) covers no-JS. */
    .faq-card.acc-open,
    .faq-card[open]:not(.acc-on) {
      border-color: color-mix(in srgb, var(--color-ink) 18%, var(--color-card-edge));
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.82),
        0 8px 18px -10px rgb(23 56 71 / 0.18),
        0 28px 62px -32px rgb(23 56 71 / 0.34);
    }
    :global(.dark) .faq-card.acc-open,
    :global(.dark) .faq-card[open]:not(.acc-on) {
      border-color: color-mix(in srgb, var(--color-purple) 32%, var(--color-coal-edge));
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.06),
        0 4px 14px -8px rgb(0 0 0 / 0.62),
        0 30px 68px -34px rgb(0 0 0 / 0.82);
    }

    .product-card:active,
    .audience-card:active,
    .proof-card:active,
    .pricing-card:active,
    .faq-card:active {
      transform: translate3d(0, -2px, 0) scale(0.992);
      transition-duration: 120ms;
    }

    .product-card:focus-within,
    .audience-card:focus-within,
    .proof-card:focus-within,
    .pricing-card:focus-within,
    .faq-card:focus-within {
      outline: 2px solid color-mix(in srgb, var(--color-purple) 45%, transparent);
      outline-offset: 3px;
    }

    .product-card h3,
    .audience-card h3,
    .proof-card blockquote,
    .pricing-card h3,
    .faq-card h3,
    .product-index,
    .audience-kicker,
    .pricing-ribbon,
    .proof-stars,
    .faq-card summary span {
      transition:
        transform 260ms var(--ease-out-quart),
        color 220ms var(--ease-out-quart),
        background-color 220ms var(--ease-out-quart),
        border-color 220ms var(--ease-out-quart),
        opacity 220ms var(--ease-out-quart);
    }

    .product-card:hover h3,
    .audience-card:hover h3,
    .proof-card:hover blockquote,
    .pricing-card:hover h3,
    .faq-card:hover h3,
    .faq-card[open] h3 {
      transform: translateY(-1px);
    }

    .product-card:hover .product-index,
    .audience-card:hover .audience-kicker,
    .pricing-card:hover .pricing-ribbon,
    .proof-card:hover .proof-stars,
    .faq-card:hover summary span,
    .faq-card[open] summary span {
      transform: translateY(-1px) scale(1.035);
    }

    .product-index {
      color: color-mix(in srgb, var(--color-ink) 36%, transparent);
      font-size: var(--text-caption);
    }

    .audience-card {
      min-height: 100%;
      overflow: hidden;
    }

    .audience-kicker {
      color: var(--color-ink-muted);
      background: color-mix(in srgb, var(--color-ink) 5%, transparent);
      border: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
      border-radius: 999px;
      display: inline-flex;
      padding: 0.32rem 0.85rem;
      line-height: 1.2;
    }

    .audience-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      /* 44px touch target without changing the visual weight of the link */
      min-height: 2.75rem;
      padding-block: 0.4rem;
    }

    .audience-link::after {
      content: "←";
      transition: transform 220ms var(--ease-out-quart);
    }

    .audience-link:hover::after {
      transform: translateX(-3px);
    }

    .proof-card {
      min-height: 100%;
      overflow: hidden;
    }

    .proof-stars {
      color: #E0A200;
      opacity: 0.9;
    }

    .pricing-card {
      overflow: visible;
    }

    .pricing-card ul li svg {
      transition: transform 220ms var(--ease-out-quart), color 220ms var(--ease-out-quart);
    }

    .pricing-card:hover ul li svg {
      transform: scale(1.08);
    }

    .home-card-teal {
      border-color: color-mix(in srgb, var(--color-teal) 32%, var(--color-card-edge));
    }

    .home-card-purple {
      border-color: color-mix(in srgb, var(--color-purple) 42%, var(--color-card-edge));
    }

    .home-cta {
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.2),
        0 8px 18px -12px currentColor;
      transition:
        transform 220ms var(--ease-out-quart),
        box-shadow 220ms var(--ease-out-quart),
        background-color 180ms,
        filter 180ms;
    }

    .home-cta:hover {
      transform: translateY(-3px);
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 0.24),
        0 16px 28px -16px currentColor;
      filter: brightness(1.04);
    }

    .home-cta:active {
      transform: translateY(0) scale(0.98);
    }

    .faq-card {
      overflow: hidden;
    }

    .faq-card summary {
      border-radius: inherit;
    }

    .faq-answer {
      animation: faq-answer-in 260ms var(--ease-out-quart) both;
    }

    @keyframes faq-answer-in {
      from { opacity: 0; transform: translateY(-6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (prefers-reduced-motion: reduce) {
      .product-card,
      .audience-card,
      .proof-card,
      .pricing-card,
      .faq-card,
      .home-cta,
      .audience-link::after {
        transition: none;
      }

      .product-card:hover,
      .audience-card:hover,
      .proof-card:hover,
      .pricing-card:hover,
      .faq-card:hover,
      .faq-card[open],
      .product-card:active,
      .audience-card:active,
      .proof-card:active,
      .pricing-card:active,
      .faq-card:active,
      .home-cta:hover,
      .home-cta:active,
      .audience-link:hover::after {
        transform: none;
      }

      .faq-answer {
        animation: none;
      }
    }

    .hero-word {
      opacity: 0;
      -webkit-clip-path: inset(0 100% 0 0);
      clip-path: inset(0 100% 0 0);
      animation:
        hero-fade 200ms 100ms forwards,
        hero-write-rtl 1600ms 100ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes hero-fade { to { opacity: 1; } }

    /* RTL: write the word from right to left (i.e. reveal mask shrinks from the LEFT side in RTL) */
    @keyframes hero-write-rtl {
      from { -webkit-clip-path: inset(0 100% 0 0); clip-path: inset(0 100% 0 0); }
      to   { -webkit-clip-path: inset(0 0 0 0);     clip-path: inset(0 0 0 0); }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-word { opacity: 1; animation: none; -webkit-clip-path: none; clip-path: none; }
    }
  </style>
</BaseLayout>
