---
/**
 * Irab, Arabic homepage (الصفحة الرئيسية).
 *
 * Native Arabic copy, not translated from English. Targets MENA + diaspora
 * Arabic readers who already know the language but want to deepen their
 * grammatical understanding.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Schema from '../components/Schema.astro';
import Nav from '../components/Nav.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import LiveDemo from '../components/sections/LiveDemo.astro';
import AppShowcase from '../components/sections/AppShowcase.astro';
import StickyCta from '../components/StickyCta.astro';
import Footer from '../components/sections/Footer.astro';

const features = [
  { title: 'مجالس الإعراب: مسابقات مباشرة', body: 'حوّل الإعراب إلى مسابقة حية: أنشئ الأسئلة يدويًّا أو بالذكاء الاصطناعي، شارك رمز الدخول، ولينضم طلابك مجانًا من أي متصفح أو من التطبيق. نقاط ومتصدرون وشرح نحوي بعد كل سؤال وتقرير كامل في الختام.', span: 'md:col-span-3', href: '/majalis', linkLabel: 'اعرف المزيد عن المجالس' },
  { title: 'محلل إعراب بالذكاء الاصطناعي', body: 'ألصق أيّ جملة عربية فتُعرَب كلمة بكلمة: النوع، الوظيفة، العلامة، التشكيل، التصحيح، وشرح واضح للجملة.', span: 'md:col-span-2' },
  { title: 'تدرّب وأَعرِبْ بنفسك', body: 'أَعرِبْ أنت، واحصل على تقييمٍ فوري وشرحٍ لكلّ كلمة. ٥٧٦ جملة منتقاة، وتقييم بالذكاء الاصطناعي على جملك الخاصة.', span: '' },
  { title: 'تعلَّم باللعب', body: 'حملة من ٧ أبواب، تحدٍّ يومي، نقاط XP، سلاسل، ١٠ رتب، شارات، ولوحات صدارة.', span: '' },
  { title: 'ثلاثة معاجم، تطبيق واحد', body: 'المعجم الذكي، ١٣ معجمًا تراثيًا، ومعجم لهجات من ٨ مناطق عربية يضم أكثر من ٣٠٠٠٠ مدخل ويعمل دون إنترنت.', span: 'md:col-span-2' },
  { title: 'مكتبة الكتب الكلاسيكية', body: '٤٧ كتابًا كلاسيكيًّا في النحو والصرف والبلاغة والإعراب، مع بحث، مفضلة، متابعة قراءة، وفهرس داخلي.', span: '' },
  { title: 'شهادات إتقان', body: 'مشتركو الخطة السنوية يستطيعون طلب شهادة قابلة للمشاركة بعد إكمال مستوى بدقّة قوية في كل موضوع.', span: 'md:col-span-2' },
  { title: 'إعراب القرآن: مزيّة إضافية', body: 'ألصق أيّ آية وادرس بنيتها كلمة بكلمة، أو تصفّح إعراب آيات المصحف على الويب كمكتبة مرجعية تكميلية.', span: '' },
  { title: 'إدخال صوتي + OCR', body: 'تكلّم بالجملة ليحلّلها التطبيق. ومع Plus يمكنك تصوير النص العربي، قصّه، اختيار النص، ثم إعرابه.', span: 'md:col-span-2' },
];

// Stacked-deck presentation for the features section: as the page scrolls,
// each card sticks below the nav and the next slides over it (pure CSS
// position:sticky with staggered tops). Brand-color cycle + a light
// hand-stacked rotation per card; the CSS rotate property composes with the
// tilt effect's inline transform, so both coexist.
const stackLook = [
  { variant: 'stack-purple', rot: -1.2 },
  { variant: 'stack-light stack-accent-purple', rot: 1.1 },
  { variant: 'stack-teal', rot: -1 },
  { variant: 'stack-ink', rot: 1 },
  { variant: 'stack-light stack-accent-teal', rot: -0.7 },
  { variant: 'stack-purple-deep', rot: 1.1 },
  { variant: 'stack-light stack-accent-purple', rot: -1 },
  { variant: 'stack-teal-deep', rot: 0.8 },
  { variant: 'stack-ink', rot: -0.9 },
];

const faqs = [
  { q: 'ما هو الإعراب؟', a: 'الإعراب هو نظام بيان الموقع النحوي ووظيفة الكلمة في الجملة العربية. يُحدّد ما إذا كانت الكلمة فاعلًا أو مفعولًا أو مضافًا إليه، ويبيّن العلاقة بين كل كلمة وأخرى. الإعراب هو الفرق بين فكّ رموز اللغة والقراءة الحقيقية.' },
  { q: 'أكتب "اعراب" بلا همزة، فهل يفهمها الموقع؟', a: 'نعم. الكلمة الصحيحة إعراب بهمزة تحت الألف، لكن كثيرين يكتبون اعراب أو اعرب الجملة أو أعرب لي، وكلها تصل إلى الأداة نفسها. المهم الجملة التي تلصقها: اكتبها بالفصحى واضحة، وستحصل على إعرابها كاملًا كلمة بكلمة.' },
  { q: 'كيف يعمل المحلل بالذكاء الاصطناعي؟', a: 'يستخدم إعراب مسارًا نحويًا مدعومًا بـ Gemini عبر Cloudflare Worker آمن. كل تحليل يحدّد نوع الكلمة، إعرابها، وظيفتها، علامتها، التشكيل الكامل، وملاحظة التصحيح عند الحاجة. هذا هو نفس مسار التحليل في التطبيق والعرض المباشر.' },
  { q: 'هل يتعامل مع العربية القرآنية؟', a: 'نعم، يمكنك لصق نص قرآني والحصول على إعراب كلمة بكلمة. هو مساعد دراسة للنص العربي الكلاسيكي، لا بديل عن معلّم مؤهل أو مرجع قرآني متخصص، خصوصًا في مواضع الاحتمال والقراءات.' },
  { q: 'هل أحتاج إلى الإنترنت؟', a: 'معجم اللهجات يعمل دون إنترنت كاملًا (٣٠٠٠٠+ مدخل في قاعدة محلية). الكتب المحمّلة سابقًا ونتائج المعجم الذكي المخزّنة يمكن الرجوع إليها محليًا. المحلّل بالذكاء الاصطناعي، OCR، التقييم المخصص، البحث الجديد في المعجم الذكي، والمعجم التقليدي تحتاج إلى اتصال.' },
  { q: 'كم معجمًا يضمّ تطبيق إعراب؟', a: 'ثلاثة معاجم. (١) المعجم الذكي: مدعوم بالذكاء الاصطناعي للعربية الحديثة، مع ترجمات بالإنجليزية والفرنسية (لغات إضافية ضمن الخطط). (٢) المعجم التقليدي: ١٣ معجمًا تراثيًا منها لسان العرب، عبر واجهة Qamoos. (٣) معجم اللهجات: أكثر من ٣٠٠٠٠ مدخل في ٨ مناطق عربية (مصري، شامي، فلسطيني، خليجي، مغاربي، عراقي، يمني، سوداني)، يعمل دون إنترنت كاملًا.' },
  { q: 'كم تكلفة Irab Plus؟', a: 'تبدأ من ٤٫٩٩$ شهريًّا أو ٣٥٫٩٩$ سنويًّا في مناطق آسيا وأفريقيا، مع أسعار إقليمية أعلى في بعض الأسواق الغربية. التجربة المجانية ٧ أيام على الخطة السنوية، وهي التي تفتح شهادات الإتقان.' },
  { q: 'هل يعمل مع كتب المدينة / البيّنة / الآجرومية؟', a: 'نعم. مهما كان منهجك، يسرّع إعراب فهمك بإعطائك تحليلًا فوريًّا لأي جملة. هو مكمّل للمنهج الكلاسيكي لا بديل عنه، استعمله جنبًا إلى جنب مع دورتك الحالية.' },
  { q: 'هل بياناتي خاصّة؟', a: 'نعم. لا نبيع بياناتك. تسجيل الدخول يستخدم رموزًا آمنة، والجمل التي تُعربها تُستخدم لتقديم الخدمة وحفظ السجل أو الذاكرة المؤقتة عند تفعيلها وتشغيل التطبيق بأمان. اطّلع على سياسة الخصوصية الكاملة في irab.app/privacy.' },
];
---
<BaseLayout
  lang="ar"
  hasEn
  title="إعراب: موقع إعراب الجمل بالذكاء الاصطناعي · أعرِب أي جملة تريدها فورًا"
  description="موقع إعراب الجمل بالذكاء الاصطناعي: ألصق أي جملة عربية واحصل على إعرابها كلمة بكلمة فورًا، أو أعرِبها بنفسك واحصل على تصحيح وشرح، مع تدريب وإعراب القرآن كاملًا."
>
  <Schema slot="head" faqs={faqs} />

  <Nav lang="ar" />

  <main>
    {/* ── Hero ─────────────────────────────────────────────────────── */}
    <Section size="sm" class="relative overflow-hidden" id="hero">
      {/* Ambient brand watermark */}
      <img
        src="/brand-watermark.webp"
        alt=""
        width="900"
        height="751"
        fetchpriority="high"
        decoding="async"
        aria-hidden="true"
        class="pointer-events-none select-none absolute inset-x-0 mx-auto top-1/2 -translate-y-1/2 w-[80%] max-w-[900px] opacity-[0.09] dark:opacity-[0.14] dark:invert"
      />
      <Container>
        <div class="text-center">
          <div
            lang="ar"
            dir="rtl"
            class="hero-word font-arabic-display font-bold text-[clamp(2.4rem,7vw,4.5rem)] leading-[0.95] text-purple-deep dark:text-purple mt-2 mb-4 select-none"
            aria-label="إعراب"
          >
            إعراب
          </div>

          <h1
            class="font-arabic font-bold text-[clamp(1.7rem,4vw,2.9rem)] leading-[1.25] tracking-tight max-w-3xl mx-auto"
            data-reveal data-reveal-delay="150"
          >
            أعرب أيّ جملة عربية <span class="text-teal">فورًا</span>.
          </h1>

          <p
            class="mt-5 text-base md:text-body-lg max-w-xl mx-auto text-ink-muted dark:text-mist-muted font-arabic leading-loose"
            data-reveal data-reveal-delay="250"
          >
            حلّلها كلمة بكلمة بالذكاء الاصطناعي، أو أَعرِبْ بنفسك واحصل على تصحيحٍ فوري. اكتب جملتك في الأسفل وابدأ الآن.
          </p>

        </div>
      </Container>
    </Section>

    {/* ── The tool, front and center (ChatGPT-style: open straight into it) ── */}
    <div class="-mt-4 md:-mt-6">
      <LiveDemo lang="ar" showHeader={false} />
    </div>

    {/* ── Thesis ───────────────────────────────────────────────────── */}
    <Section size="lg" class="relative bg-teal/[0.035] dark:bg-teal/[0.06] border-y border-teal/15 dark:border-teal/20">
      <Container size="narrow">
        <p class="eyebrow mb-10" data-reveal>الفكرة</p>
        <blockquote
          class="font-arabic font-bold text-[clamp(1.6rem,3.5vw,2.5rem)] leading-[1.5] tracking-tight"
          data-reveal data-reveal-delay="100"
        >
          غيرُك يُعطيك الإعراب جاهزًا. إعراب يجعلك <span class="text-teal">تُعرِبُ بنفسك</span>،<br />
          ثمّ يصحّح لك ويشرح.
        </blockquote>
        <p class="mt-8 text-body-lg text-ink-muted dark:text-mist-muted font-arabic leading-loose" data-reveal data-reveal-delay="200">
          أكثر تطبيقات اللغة تُلقّنك المفردات. إعراب يدرّبك على <span class="text-teal font-medium">ما وراء الكلمة</span>: البنية النحوية: بتحليلٍ فوري بالذكاء الاصطناعي، وتقييمٍ لإعرابك أنت، وتحدّياتٍ ترفع مستواك يومًا بعد يوم.
        </p>
      </Container>
    </Section>

    {/* ── Features ─────────────────────────────────────────────────── */}
    <Section id="features">
      <Container size="wide">
        <div class="stack-layout">
          {/* Stationary companion (Pépite-style): sticks in place while the
              deck stacks beside it, and carries the section's story + CTAs. */}
          <aside class="stack-intro" data-reveal>
            <img src="/brand-mark.png" alt="" aria-hidden="true" width="72" height="72" loading="lazy" class="stack-intro-mark" />
            <p class="eyebrow mb-4">المنتج</p>
            <h2 class="font-arabic font-bold text-[clamp(1.6rem,3vw,2.4rem)] leading-[1.3] tracking-tight">
              ورشة عمل كاملة لقواعد العربية.
            </h2>
            <p class="font-arabic text-body text-ink-muted dark:text-mist-muted leading-loose mt-5">
              كل بطاقة من هذه البطاقات التسع مزية تعمل اليوم في إعراب، من المحلل الفوري إلى مجالس الإعراب المباشرة. مرّر لتقلّبها بطاقة بطاقة.
            </p>
            <div class="flex flex-wrap gap-3 mt-8">
              <a href="#demo" class="btn-primary">جرّب المحلل الآن</a>
              <a href="#app" class="btn-ghost">حمّل التطبيق</a>
            </div>
            <p class="stack-hint font-arabic" aria-hidden="true">
              مرّر لتقليب البطاقات
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="m6 9 6 6 6-6"/></svg>
            </p>
          </aside>

          <ul class="stack-deck">
          {features.map((f, i) => {
            const look = stackLook[i % stackLook.length];
            return (
              <li class="stack-item" style={`z-index:${i + 1}; top:calc(var(--stack-top) + ${i} * var(--stack-peek));`}>
                <article class:list={['stack-card', look.variant]} style={`rotate:${look.rot}deg;`} data-tilt="3">
                  <p class="stack-num font-mono tabular-nums" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
                  <div>
                    <h3 class="font-arabic font-bold stack-title">{f.title}</h3>
                    <p class="font-arabic stack-text leading-loose">{f.body}</p>
                    {'href' in f && (
                      <a href={f.href} class="stack-link font-arabic font-bold">{f.linkLabel}</a>
                    )}
                  </div>
                </article>
              </li>
            );
          })}
          </ul>
        </div>
      </Container>
    </Section>

    {/* ── Audience ─────────────────────────────────────────────────── */}
    <Section id="audience" class="section-tint border-y border-stone dark:border-coal-edge">
      <Container>
        <div class="max-w-2xl mb-16">
          <p class="eyebrow mb-4" data-reveal>لمن</p>
          <h2 class="font-arabic font-bold text-[clamp(1.7rem,3.8vw,2.8rem)] leading-[1.3] tracking-tight" data-reveal data-reveal-delay="100">
            مصنوع للمتعلّمين الجادّين، في كلّ مستوى.
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          <div class="audience-card audience-card-purple spot-card p-7 md:p-8" data-reveal>
            <p class="audience-kicker font-arabic font-bold mb-5">الطلاب</p>
            <h3 class="font-arabic font-bold text-h2 leading-tight mb-6">من البسملة إلى البقرة.</h3>
            <p class="font-arabic text-body text-ink-muted dark:text-mist-muted leading-loose">
              أتقنت العربية المحادثة، لكنّك لا تزال تعجز عن قراءة القرآن بفهم. إعراب هو الجسر: قواعد حقيقية، وتدريب بتقييم ذكي، وعادة يومية تتراكم.
            </p>
          </div>

          <div class="audience-card audience-card-teal spot-card p-7 md:p-8" data-reveal data-reveal-delay="100">
            <p class="audience-kicker font-arabic font-bold mb-5">المعلّمون</p>
            <h3 class="font-arabic font-bold text-h2 leading-tight mb-6">افحص في ثوانٍ.</h3>
            <p class="font-arabic text-body text-ink-muted dark:text-mist-muted leading-loose mb-6">
              إعراب فوري لأي جملة يأتيك بها طلابك. راجع النتائج التي يشاركونها معك، وقارن التحليلات، ووجّههم إلى التدريب دون الحاجة إلى لوحة معلّم أو قائمة طلاب.
            </p>
            <a href="/teachers" class="audience-link font-arabic font-bold text-teal hover:text-teal-deep text-small transition-colors duration-200">للمدارس والأكاديميات</a>
          </div>

          <div class="audience-card audience-card-ink spot-card p-7 md:p-8" data-reveal data-reveal-delay="200">
            <p class="audience-kicker font-arabic font-bold mb-5">طلاب العلم</p>
            <h3 class="font-arabic font-bold text-h2 leading-tight mb-6">رأي ثانٍ، فوريّ.</h3>
            <p class="font-arabic text-body text-ink-muted dark:text-mist-muted leading-loose">
              تحقّق من الحالات المختلطة، وسوِّ الإعرابات الغامضة، وابدأ من نقطة موثوقة في أعمال التفسير والترجمة. ليس بديلًا عن التكوين العلمي، بل تكميلٌ له.
            </p>
          </div>
        </div>
      </Container>
    </Section>

    {/* ── App showcase + download ──────────────────────────────────── */}
    <AppShowcase lang="ar" />

    {/* ── Social Proof ─────────────────────────────────────────────── */}
    <Section id="proof">
      <Container>
        <div class="max-w-2xl mb-16">
          <p class="eyebrow mb-4" data-reveal>قالها الناس، لا نحن</p>
          <h2 class="font-arabic font-bold text-[clamp(1.7rem,3.8vw,2.8rem)] leading-[1.3] tracking-tight" data-reveal data-reveal-delay="100">
            آراء حقيقية من متعلّمين يحبّون العربية.
          </h2>
        </div>

        <div class="proof-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {[
            { body: 'ممتاز جدًا جدًا، لم أرَ مثله في الإعراب.', name: 'محمد', detail: '★★★★★ · Google Play' },
            { body: 'ماشاءالله جميل جدًا لعشاق اللغة العربية، ولِمن لديهم شغف بها، وحتى الذين يتعلّمونها الآن يمكنهم بسهولة فهم أيّ كلمة يريدونها.', name: 'Osamah Alrebaki', detail: '★★★★★ · Google Play' },
            { body: 'التطبيق واضح أنه متعوبٌ عليه، بأسلوبٍ حديثٍ ورائع. أحيّيكم على هذه الجهود المثمرة.', name: 'Aboood Aboooda', detail: '★★★★★ · Google Play' },
            { body: 'بصّ بصّ من غير أيّ كلام كتير، عشرة على عشرة. بسّ محتاج إنترنت.', name: 'مصطفى عبدالرحمن', detail: '★★★★★ · Google Play' },
            { body: 'تطبيق رائع جدًا، ونرجو أن يبقى مجانيًّا دائمًا. بارك الله فيكم.', name: 'Ahmed', detail: '★★★★★ · Google Play' },
            { body: 'تطبيق أكثر من رائع، تمنّيت وجوده عند تحضيري للاختبارات الثانوية وعند دراسة اللغة والقرآن الكريم. أنصح الجميع بتجربته.', name: 'Ali Aljawzi', detail: '★★★★★ · App Store' },
            { body: 'تطبيق عظيم، يعمل على جهازي ماك وهذا الذي أبهرني. شكرًا جزيلًا.', name: 'مستخدم App Store', detail: '★★★★★ · App Store' },
            { body: 'خطوة ممتازة، بالتوفيق.', name: 'Albahr Malek', detail: '★★★★★ · App Store' },
          ].map((q, i) => (
            <figure class:list={['proof-card spot-card p-6', i === 1 || i === 5 ? 'lg:col-span-2' : '']} data-reveal data-reveal-delay={String(i * 60)}>
              <div class="proof-stars flex items-center gap-1 mb-5" aria-label="٥ من ٥">
                {Array.from({ length: 5 }).map(() => (
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" style="color: var(--color-marfu);"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                ))}
              </div>
              <blockquote class="font-arabic text-body leading-loose text-ink/80 dark:text-mist/80">«{q.body}»</blockquote>
              <figcaption class="mt-6 pt-5 border-t border-card-edge/80 dark:border-coal-edge">
                <p class="font-arabic font-bold text-small">{q.name}</p>
                <p class="font-mono text-caption text-ink-muted dark:text-mist-muted mt-0.5">{q.detail}</p>
