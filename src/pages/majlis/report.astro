---
/**
 * /majlis/report?room=<roomId>: full report of a finished majlis, read from
 * majalis_reports (host-only). Login-gated island, noindex.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import MajlisReport from '../../components/MajlisReport.astro';
---
<BaseLayout lang="ar" title="تقرير المجلس · إعراب آب" description="تقرير مجلس الإعراب: الدقة والأسئلة وترتيب المشاركين.">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <Nav lang="ar" />
  <main class="px-4 sm:px-6 py-8 md:py-12">
    <MajlisReport />
  </main>
</BaseLayout>
