---
/**
 * /majlis/host: the host hub (مجالسي) — drafts, past-majlis reports, and the
 * question bank, all from the SAME Firestore collections the mobile app
 * writes, so content created on either platform appears on both.
 * Login-gated island, noindex. Hosting a live majlis runs at /majlis/live.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/sections/Footer.astro';
import MajlisHost from '../../components/MajlisHost.astro';
---
<BaseLayout lang="ar" title="مجالسي · إعراب آب" description="أدر مجالس الإعراب الخاصة بك: المسودات والسجل وبنك الأسئلة.">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <Nav lang="ar" />
  <main class="px-4 sm:px-6 py-8 md:py-12">
    <MajlisHost />
  </main>
  <Footer lang="ar" />
</BaseLayout>
