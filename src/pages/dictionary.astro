---
/**
 * /dictionary: the smart dictionary tool. Login-gated and noindex; Firebase
 * loads lazily inside Dictionary. The public word pages are /dictionary/<word>.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/sections/Footer.astro';
import Dictionary from '../components/dictionary/Dictionary.astro';
---
<BaseLayout lang="ar" title="المعجم الذكي · إعراب آب" description="معجم عربي ذكي: معاني الكلمة وجذرها ووزنها وصرفها وإعرابها، مع مواضعها في القرآن الكريم وما قالته المعاجم الكلاسيكية.">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <Nav lang="ar" />
  <main class="px-4 sm:px-6 py-8 md:py-12">
    <Dictionary lang="ar" />
  </main>
  <Footer lang="ar" />
</BaseLayout>
