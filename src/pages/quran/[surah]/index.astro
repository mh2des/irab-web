---
/**
 * Surah index. Two modes:
 *  • FULL (≤50 ayat, fully published): the complete i'rab of every ayah on
 *    one page — verse, word-by-word grid, and detailed i'rab — matching the
 *    dominant search intent «إعراب سورة X كاملة». Each section links to the
 *    ayah's own page (which stays the richer canonical for that ayah: sarf,
 *    balagha, fawaid, FAQs live only there).
 *  • LIST (longer surahs): the original ayah list, each linking to its page.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/sections/Footer.astro';
import Container from '../../../components/Container.astro';
import WordGrid from '../../../components/quran/WordGrid.astro';
import {
  SURAHS, ayatOfSurah, toArabicDigits, renderIrab, plainVerse, type SurahMeta, type Ayah,
} from '../../../lib/quran';
import { enSurahIds } from '../../../lib/quran-en';

export function getStaticPaths() {
  return SURAHS.filter((s) => s.publishedCount > 0).map((s) => ({
    params: { surah: s.slug },
    props: { surah: s },
  }));
}

const { surah } = Astro.props as { surah: SurahMeta };
const ayat = ayatOfSurah(surah.id);
const placeAr = surah.place === 'makki' ? 'مكية' : 'مدنية';

// FULL mode: short surah with every ayah published — the one-page complete
// i'rab searchers ask for with «إعراب سورة X كاملة».
const FULL_MAX_AYAT = 50;
const full = surah.ayahCount <= FULL_MAX_AYAT && ayat.length >= surah.ayahCount;

const title = full
  ? `إعراب سورة ${surah.name} كاملة، آية آية وكلمة كلمة | إعراب`
  : `إعراب سورة ${surah.name}، كل آية كلمةً كلمة | إعراب`;
// One description template for every surah, 150-158 chars across all 114 names
// and ayah counts, query phrase «إعراب سورة X» first. True for both page modes:
// every ayah has its own detailed page whether or not the surah is inlined here.
const description = `إعراب سورة ${surah.name} (${toArabicDigits(surah.ayahCount)} آية) آيةً آية وكلمةً كلمة: تحليل نحوي مفصّل لكل كلمة، الموقع الإعرابي وعلامة الإعراب وسببها، من «الجدول في إعراب القرآن» لمحمود صافي.`;
const canonical = `https://irab.app/quran/${surah.slug}`;
const hasEnTwin = enSurahIds().includes(surah.id);
const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'إعراب القرآن', item: 'https://irab.app/quran' },
    { '@type': 'ListItem', position: 2, name: `سورة ${surah.name}`, item: canonical },
  ],
};

// Per-ayah render prep for FULL mode. Footnote anchors get an a{N}- prefix so
// markers from different ayat can't collide on the one-page view.
interface FullSection {
  a: Ayah;
  isHead: boolean;
  sharedMember: boolean;
  irabHtml: string;
  fns: { id: string; content: string }[];
}
const fnDigits = (m: string) => m.replace(/[^0-9]/g, '');
const sections: FullSection[] = full
  ? ayat.map((a) => {
      const isHead = a.ayah === a.ayahStart;
      const shared = a.ayahStart !== a.ayahEnd;
      const sharedMember = shared && a.isShared && !isHead;
      let irabHtml = !sharedMember && a.irab ? renderIrab(a.irab, a.footnotes) : '';
      let fns: { id: string; content: string }[] = [];
      if (irabHtml) {
        irabHtml = irabHtml.replaceAll('href="#fn-', `href="#a${a.ayah}-fn-`);
        fns = a.footnotes.map((f) => ({ id: `a${a.ayah}-fn-${fnDigits(f.marker)}`, content: f.content }));
      }
      return { a, isHead, sharedMember, irabHtml, fns };
    })
  : [];
---
<BaseLayout lang="ar" title={title} description={description} hasEn={hasEnTwin}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumb)} is:inline />
  <Nav lang="ar" />

  <main>
    <section class="py-12 md:py-16">
      <Container size="narrow">
        <nav class="bc" aria-label="مسار التنقّل">
          <a href="/quran">إعراب القرآن</a><span aria-hidden="true">›</span>
          <span class="bc-cur">سورة {surah.name}</span>
        </nav>

        <span class="eyebrow eyebrow-teal">{placeAr} · {toArabicDigits(surah.ayahCount)} آية</span>
        <h1 class="s-h1 font-arabic-display">إعراب سورة {surah.name}{full ? ' كاملة' : ''}</h1>
        {full ? (
          <p class="s-lead">
            إعراب سورة {surah.name} كاملةً في صفحة واحدة: كل آية بنصّها، ثم إعراب مفرداتها كلمةً كلمة،
            ثم الإعراب التفصيلي، من «الجدول في إعراب القرآن» لمحمود صافي.
            ولكل آيةٍ صفحةٌ مفصّلة فيها الصرف والبلاغة والفوائد.
          </p>
        ) : (
          <p class="s-lead">التحليل النحوي الكامل لكل آية من سورة {surah.name}، كلمةً كلمة، من «الجدول في إعراب القرآن» لمحمود صافي. اختر آيةً لقراءة إعرابها المفصّل.</p>
        )}

        {full ? (
          <>
            <nav class="toc" aria-label="الآيات">
              {sections.map(({ a }) => (
                <a href={`#ayah-${a.ayah}`} class="toc-n">{toArabicDigits(a.ayah)}</a>
              ))}
            </nav>

            {sections.map(({ a, sharedMember, irabHtml, fns }) => (
              <section id={`ayah-${a.ayah}`} class="af">
                <h2 class="af-h2 font-arabic-display">إعراب الآية {toArabicDigits(a.ayah)}</h2>
                <blockquote class="verse quran-text" lang="ar" dir="rtl">
                  <span class="verse-text">{a.uthmani}</span>
                  <span class="verse-num" aria-hidden="true">{toArabicDigits(a.ayah)}</span>
                </blockquote>

                {a.words.length > 0 && <WordGrid words={a.words} />}

                {sharedMember && (
                  <p class="af-note">
                    الإعراب التفصيلي لهذه الآية مشترك مع ما قبلها:
                    <a href={`#ayah-${a.ayahStart}`}> انظر الآية {toArabicDigits(a.ayahStart)}</a>.
                  </p>
                )}

                {irabHtml && <div class="irab-html classical-naskh" set:html={irabHtml} />}

                {fns.length > 0 && (
                  <ol class="af-fns classical-naskh">
                    {fns.map((f) => <li id={f.id}>{f.content}</li>)}
                  </ol>
                )}

                <p class="af-more">
                  <a href={`/quran/${surah.slug}/${a.ayah}`}>
                    صفحة الآية {toArabicDigits(a.ayah)} كاملة: الصرف والبلاغة والفوائد ←
                  </a>
                </p>
              </section>
            ))}

            <p class="source">
              المصدر: <span class="source-book">الجدول في إعراب القرآن</span>، تأليف محمود صافي ·
              <a href="/methodology" class="lead-link">منهجيتنا في التحقّق</a>
            </p>
          </>
        ) : (
          <ol class="ayat">
            {ayat.map((a) => (
              <li>
                <a href={`/quran/${surah.slug}/${a.ayah}`} class="a-card">
                  <span class="a-num">{toArabicDigits(a.ayah)}</span>
                  <span class="a-verse quran-text">{plainVerse(a.uthmani)}</span>
                  <svg class="a-go" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                </a>
              </li>
            ))}
          </ol>
        )}
      </Container>
    </section>
  </main>

  <Footer lang="ar" />
</BaseLayout>

<style>
  .bc { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; font-size: 1.1rem; color: color-mix(in srgb, var(--color-ink) 55%, transparent); margin-bottom: 1.25rem; }
  :global(.dark) .bc { color: color-mix(in srgb, var(--color-mist) 55%, transparent); }
  .bc a { color: inherit; text-decoration: none; display: inline-block; padding-block: 0.35rem; }
  .bc a:hover { color: var(--color-purple); }
  .bc-cur { color: var(--color-ink); font-weight: 600; }
  :global(.dark) .bc-cur { color: var(--color-mist); }

  .s-h1 { font-size: clamp(2.1rem, 5vw, 3.1rem); font-weight: 700; color: var(--color-ink); margin: 0.5rem 0 0.75rem; }
  :global(.dark) .s-h1 { color: var(--color-mist); }
  .s-lead { font-family: var(--font-arabic); font-size: 1.7rem; line-height: 1.95; color: color-mix(in srgb, var(--color-ink) 72%, transparent); margin-bottom: 2.5rem; max-width: 40rem; }
  :global(.dark) .s-lead { color: color-mix(in srgb, var(--color-mist) 72%, transparent); }
  .lead-link { color: var(--color-teal); font-weight: 600; text-underline-offset: 3px; }

  /* ── TOC (full mode) ─────────────────────────────────────────────── */
  .toc { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2.5rem; }
  .toc-n {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 2.4rem; height: 2.4rem; padding: 0 0.5rem;
    font-family: var(--font-mono); font-size: 1.15rem; font-weight: 600;
    color: var(--color-purple); text-decoration: none;
    border: 1.5px solid color-mix(in srgb, var(--color-purple) 30%, transparent);
    border-radius: 10px; transition: border-color .2s, background .2s;
  }
  .toc-n:hover { border-color: var(--color-purple); background: color-mix(in srgb, var(--color-purple) 8%, transparent); }

  /* ── Per-ayah full sections ──────────────────────────────────────── */
  .af { margin-bottom: 3.25rem; scroll-margin-top: 5.5rem; }
  .af-h2 {
    font-size: clamp(1.7rem, 3.8vw, 2.4rem); font-weight: 700;
    color: var(--color-ink); margin-bottom: 1.1rem;
  }
  :global(.dark) .af-h2 { color: var(--color-mist); }

  .verse {
    position: relative; text-align: center;
    font-size: clamp(2rem, 5vw, 2.8rem); line-height: 2.15;
    color: var(--color-ink);
    background: var(--color-card);
    border: 1px solid var(--color-card-edge);
    border-top: 3px solid var(--color-purple);
    border-radius: 18px;
    padding: 1.75rem 1.5rem 2rem;
    margin: 0 0 1.25rem;
    box-shadow: var(--shadow-card);
  }
  :global(.dark) .verse { color: var(--color-mist); background: var(--color-coal-soft); border-color: var(--color-coal-edge); border-top-color: var(--color-purple); }
  .verse-num {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.1em; height: 2.1em; margin-inline-start: 0.4em;
    font-size: 0.5em; font-family: var(--font-mono); color: var(--color-purple);
    border: 1.5px solid color-mix(in srgb, var(--color-purple) 45%, transparent);
    border-radius: 999px; vertical-align: middle;
  }

  .af-note {
    font-size: 1.3rem; line-height: 1.7; margin: 1rem 0 0;
    padding: 0.85rem 1.1rem; border-radius: 12px;
    background: color-mix(in srgb, var(--color-teal) 8%, var(--color-paper));
    border: 1px solid color-mix(in srgb, var(--color-teal) 20%, transparent);
    color: color-mix(in srgb, var(--color-ink) 80%, transparent);
  }
  :global(.dark) .af-note { background: color-mix(in srgb, var(--color-teal) 14%, var(--color-coal)); color: color-mix(in srgb, var(--color-mist) 80%, transparent); }
  .af-note a { color: var(--color-teal); font-weight: 600; text-underline-offset: 3px; }

  .af-fns { list-style: decimal; padding-inline-start: 1.5rem; margin-top: 1rem; font-size: 1.35rem; line-height: 2.0; color: color-mix(in srgb, var(--color-ink) 78%, transparent); }
  :global(.dark) .af-fns { color: color-mix(in srgb, var(--color-mist) 70%, transparent); }
  .af-fns li:target { background: color-mix(in srgb, var(--color-purple) 12%, transparent); border-radius: 6px; }

  .af-more { margin-top: 1.1rem; font-size: 1.3rem; }
  .af-more a { color: var(--color-purple); font-weight: 600; text-decoration: none; text-underline-offset: 3px; }
  .af-more a:hover { text-decoration: underline; }

  .source {
    font-size: 1.15rem; color: color-mix(in srgb, var(--color-ink) 58%, transparent);
    margin-top: 1rem; text-align: center;
  }
  :global(.dark) .source { color: color-mix(in srgb, var(--color-mist) 58%, transparent); }
  .source-book { color: var(--color-teal); font-weight: 600; }

  /* ── List mode (long surahs) ─────────────────────────────────────── */
  .ayat { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
  .a-card {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem;
    border: 1px solid var(--color-card-edge); border-radius: 14px; padding: 1rem 1.25rem;
    background: var(--color-card); box-shadow: var(--shadow-card);
    text-decoration: none; transition: border-color .2s, transform .2s, box-shadow .2s;
  }
  :global(.dark) .a-card { border-color: var(--color-coal-edge); background: var(--color-coal-soft); }
  .a-card:hover { border-color: var(--color-purple); transform: translateY(-3px); box-shadow: var(--lift-shadow); }
  .a-num {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.4rem; height: 2.4rem; flex: none;
    font-family: var(--font-mono); font-size: 1.2rem; font-weight: 600;
    color: var(--color-purple);
    border: 1.5px solid color-mix(in srgb, var(--color-purple) 35%, transparent);
    border-radius: 10px;
  }
  .a-verse {
    font-size: 1.95rem; line-height: 1.9; color: var(--color-ink);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  :global(.dark) .a-verse { color: var(--color-mist); }
  .a-go { width: 1.1rem; height: 1.1rem; flex: none; color: color-mix(in srgb, var(--color-ink) 60%, transparent); }
</style>

<style is:global>
  /* Injected i'rab HTML (set:html): global because scoped attrs aren't added. */
  .irab-html { font-size: 1.6rem; line-height: 2.2; color: color-mix(in srgb, var(--color-ink) 92%, transparent); }
  .dark .irab-html { color: color-mix(in srgb, var(--color-mist) 90%, transparent); }
  .irab-html p { margin: 0 0 1rem; }
  .irab-html h3 { font-family: var(--font-arabic-display); font-weight: 700; font-size: 1.65rem; color: var(--color-ink); margin: 1.5rem 0 0.6rem; }
  .dark .irab-html h3 { color: var(--color-mist); }
  .irab-html b.tok { color: var(--color-purple); font-weight: 700; }
  .dark .irab-html b.tok { color: color-mix(in srgb, var(--color-purple) 85%, white); }
  .irab-html sup.fn a { color: var(--color-teal); text-decoration: none; font-size: 0.7em; padding: 0 0.15em; }
  .irab-html sup.fn a:hover { text-decoration: underline; }
</style>
