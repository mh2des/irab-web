---
/**
 * Ayah i'rab page: the spoke. Our own material first: verse → (TL;DR) →
 * lessons that teach what the ayah contains → the quoted reference → FAQ →
 * related → app CTA. JSON-LD via AyahSchema.
 *
 * The quoted reference («الجدول في إعراب القرآن»: word grid, detailed i'rab,
 * sarf/balagha/fawaid, footnotes) ships INLINE only on pages Google is told
 * not to index. On every Google-indexable page it loads on demand from
 * /quran-ref/<surah>/<ayah>.json (robots-blocked) when the reader asks, so the
 * indexable HTML is our own words only. See src/lib/quran-index.ts.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/sections/Footer.astro';
import Container from '../../../components/Container.astro';
import ArticleCta from '../../../components/ArticleCta.astro';
import WordGrid from '../../../components/quran/WordGrid.astro';
import AyahSchema from '../../../components/quran/AyahSchema.astro';
import {
  AYAT, surahById, ayatOfSurah, toArabicDigits, renderIrab, plainVerse, type Ayah,
} from '../../../lib/quran';
import { INTROS } from '../../../data/ayah-intros';
import { hasEnAyah } from '../../../lib/quran-en';
import { ayahIndexPolicy } from '../../../lib/quran-index';
import { lessonsForAyah } from '../../../lib/lesson-links';

export function getStaticPaths() {
  return AYAT.map((a) => {
    const s = surahById(a.surah)!;
    return { params: { surah: s.slug, ayah: String(a.ayah) }, props: { ayah: a } };
  });
}

const { ayah } = Astro.props as { ayah: Ayah };
const surah = surahById(ayah.surah)!;
const intro = INTROS[`${ayah.surah}:${ayah.ayah}`] ?? {};
const an = toArabicDigits(ayah.ayah);
const { canonical, isHead, shared, thin, googlebotNoindex, referenceOnDemand } = ayahIndexPolicy(ayah);

const h1 = intro.h1 ?? `إعراب سورة ${surah.name}، الآية ${an}`;
// Named ayat (آية الكرسي…) carry a long H1: keep the whole title within 70
// chars by dropping the middle, then the handle, before the name itself.
const titleFull = intro.h1
  ? `${intro.h1} (${surah.name} ${an}) · كلمة بكلمة | إعراب آب`
  : `إعراب سورة ${surah.name} الآية ${an} · كلمة بكلمة | إعراب آب`;
const title = titleFull.length <= 70
  ? titleFull
  : (`${intro.h1} | إعراب آب`.length <= 70 ? `${intro.h1} | إعراب آب` : `${intro.h1}`);
const versePlain = plainVerse(ayah.uthmani);
// Description: our own summary when we have one (that is what the indexable
// page is about); the reference wording only on book-only pages.
const clamp = (t: string, max: number) => {
  if (t.length <= max) return t;
  const cut = t.slice(0, max - 1);
  const sp = cut.lastIndexOf(' ');
  return `${sp > max * 0.6 ? cut.slice(0, sp) : cut}…`;
};
const description = intro.tldr
  ? clamp(`إعراب ${surah.name} الآية ${an}: ${intro.tldr}`, 158)
  : `إعراب ${surah.name} الآية ${an} كلمةً كلمةً: ${versePlain.slice(0, 80)}… تحليلٌ نحويٌّ مفصّل من «الجدول في إعراب القرآن».`;
const placeAr = surah.place === 'makki' ? 'مكية' : 'مدنية';
const faqs = intro.faqs ?? [];
const refSrc = `/quran-ref/${surah.slug}/${ayah.ayah}.json`;

// Inline reference: only when the page is NOT Google-indexable (book-only,
// googlebot-noindexed). Indexable pages get the on-demand block instead.
const inlineRef = !referenceOnDemand;
const irabHtml = inlineRef ? renderIrab(ayah.irab, ayah.footnotes) : '';
const sarfHtml = inlineRef ? renderIrab(ayah.sarf, ayah.footnotes) : '';
const balaghaHtml = inlineRef ? renderIrab(ayah.balagha, ayah.footnotes) : '';
const fawaidHtml = inlineRef ? renderIrab(ayah.fawaid, ayah.footnotes) : '';

const inSurah = ayatOfSurah(ayah.surah);
const idx = inSurah.findIndex((a) => a.ayah === ayah.ayah);
const prev = idx > 0 ? inSurah[idx - 1] : null;
const next = idx >= 0 && idx < inSurah.length - 1 ? inSurah[idx + 1] : null;

const fnId = (m: string) => `fn-${m.replace(/[^0-9]/g, '')}`;
// hreflang: only advertise the English twin when one actually exists for this ayah.
const hasEnTwin = hasEnAyah(ayah.surah, ayah.ayah);
// Lessons that teach the constructions the book names in this ayah's i'rab:
// our own structure around the quoted text (see src/lib/lesson-links.ts).
const lessons = lessonsForAyah(ayah);
---
<BaseLayout lang="ar" title={title} description={description} noindex={thin} googlebotNoindex={googlebotNoindex} canonicalOverride={canonical} hasEn={hasEnTwin}>
  <AyahSchema slot="head" ayah={ayah} surah={surah} canonical={canonical} title={h1} description={description} faqs={faqs} />
  <Nav lang="ar" />

  <main>
    <article class="py-10 md:py-14">
      <Container size="narrow">
        <nav class="bc" aria-label="مسار التنقّل">
          <a href="/quran">إعراب القرآن</a><span aria-hidden="true">›</span>
          <a href={`/quran/${surah.slug}`}>سورة {surah.name}</a><span aria-hidden="true">›</span>
          <span class="bc-cur">الآية {an}</span>
        </nav>

        <h1 class="ayah-h1 font-arabic-display">{h1}</h1>
        <p class="ayah-sub">سورة {surah.name} · {placeAr} · الآية {an}</p>

        <blockquote class="verse quran-text" lang="ar" dir="rtl">
          <span class="verse-text">{ayah.uthmani}</span>
          <span class="verse-num" aria-hidden="true">{an}</span>
        </blockquote>

        {intro.tldr && (
          <div class="tldr">
            <span class="eyebrow eyebrow-ink">الإعراب باختصار</span>
            <p class="classical-naskh">{intro.tldr}</p>
          </div>
        )}

        {lessons.length > 0 && (
          <section class="blk blk-lessons" aria-labelledby="lessons-h">
            <h2 id="lessons-h">دروس تشرح ما في هذه الآية</h2>
            <div class="rel">
              {lessons.map((l) => (
                <a class="rel-card" href={`/duroos/${l.slug}`}>
                  <span>من أبواب الإعراب</span><b>{l.title}</b>
                </a>
              ))}
            </div>
          </section>
        )}

        {shared && ayah.isShared && !isHead && (
          <p class="shared-note">
            هذا الإعراب مشترك للآيات {toArabicDigits(ayah.ayahStart)} إلى {toArabicDigits(ayah.ayahEnd)}.
            <a href={`/quran/${surah.slug}/${ayah.ayahStart}`}>انظر الإعراب الكامل في الآية {toArabicDigits(ayah.ayahStart)}</a>.
          </p>
        )}

        {referenceOnDemand ? (
          <section class="blk ref" id="reference" aria-labelledby="ref-h" data-ref-src={refSrc}>
            <h2 id="ref-h">الإعراب المفصّل من المرجع</h2>
            <p class="ref-lead classical-naskh">
              إعراب المفردات كلمةً كلمة، والإعراب التفصيلي، والصرف والبلاغة والفوائد، نقلًا عن
              «الجدول في إعراب القرآن» لمحمود صافي{shared ? `، ويشمل الآيات ${toArabicDigits(ayah.ayahStart)} إلى ${toArabicDigits(ayah.ayahEnd)}` : ''}.
              يُعرض عند الطلب.
            </p>
            <button type="button" class="ref-btn" data-ref-load>
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
              اعرض إعراب المفردات والإعراب التفصيلي
            </button>
            <p class="ref-status classical-naskh" data-ref-status role="status" hidden></p>
            <div data-ref-out></div>
            <p class="source source-after">
              <span class="source-label">نقلًا عن المرجع</span>
              المصدر: <span class="source-book">الجدول في إعراب القرآن</span>، تأليف محمود صافي
              · <a href="/methodology" class="source-link">منهجيتنا في التحقّق</a>
            </p>
          </section>
        ) : (
          <>
            <p class="source" id="source">
              <span class="source-label">نقلًا عن المرجع</span>
              المصدر: <span class="source-book">الجدول في إعراب القرآن</span>، تأليف محمود صافي{shared ? `، يشمل الآيات ${toArabicDigits(ayah.ayahStart)} إلى ${toArabicDigits(ayah.ayahEnd)}` : ''}
              · <a href="/methodology" class="source-link">منهجيتنا في التحقّق</a>
            </p>

            {ayah.words.length > 0 && (
              <section class="blk">
                <h2>إعراب المفردات كلمةً كلمة</h2>
                <WordGrid words={ayah.words} />
              </section>
            )}

            {thin && (
              <p class="pending-note classical-naskh">التحليل التفصيلي لهذه الآية قيد الإعداد، وسيُضاف قريباً بإذن الله.</p>
            )}

            {irabHtml && (
              <section class="blk">
                <h2>الإعراب التفصيلي</h2>
                <div class="irab-html classical-naskh" set:html={irabHtml} />
              </section>
            )}

            {(sarfHtml || balaghaHtml || fawaidHtml) && (
              <section class="blk">
                <h2>الصرف والبلاغة والفوائد</h2>
                {sarfHtml && <details class="exp acc-card" data-acc><summary>الصرف</summary><div class="irab-html classical-naskh" set:html={sarfHtml} /></details>}
                {balaghaHtml && <details class="exp acc-card" data-acc><summary>البلاغة</summary><div class="irab-html classical-naskh" set:html={balaghaHtml} /></details>}
                {fawaidHtml && <details class="exp acc-card" data-acc><summary>الفوائد</summary><div class="irab-html classical-naskh" set:html={fawaidHtml} /></details>}
              </section>
            )}

            {ayah.footnotes.length > 0 && (
              <section class="blk">
                <h2>الهوامش</h2>
                <ol class="fns classical-naskh">
                  {ayah.footnotes.map((f) => (
                    <li id={fnId(f.marker)}>{f.content}</li>
                  ))}
                </ol>
              </section>
            )}
          </>
        )}

        {faqs.length > 0 && (
          <section class="blk">
            <h2>أسئلة شائعة</h2>
            <div class="faq" data-acc-group>
              {faqs.map((f) => (
                <details class="exp acc-card" data-acc><summary>{f.q}</summary><p class="classical-naskh faq-a">{f.a}</p></details>
              ))}
            </div>
          </section>
        )}

        {(prev || next) && (
          <section class="blk">
            <h2>آياتٌ ذات صلة</h2>
            <div class="rel">
              {next && (
                <a class="rel-card" href={`/quran/${surah.slug}/${next.ayah}`}>
                  <span>الآية التالية</span><b class="quran-text">{surah.name} · {toArabicDigits(next.ayah)}</b>
                </a>
              )}
              {prev && (
                <a class="rel-card" href={`/quran/${surah.slug}/${prev.ayah}`}>
                  <span>الآية السابقة</span><b class="quran-text">{surah.name} · {toArabicDigits(prev.ayah)}</b>
                </a>
              )}
              <a class="rel-card" href={`/quran/${surah.slug}`}>
                <span>كل آيات السورة</span><b>سورة {surah.name}</b>
              </a>
            </div>
          </section>
        )}

        <section class="blk">
          <h2>تعمّق في الإعراب</h2>
          <div class="rel">
            <a class="rel-card" href="/tool">
              <span>أداة مجانية بالذكاء الاصطناعي</span><b>أعرِب أي جملة بنفسك</b>
            </a>
            <a class="rel-card" href="/irab">
              <span>دليل شامل للمبتدئ والمتقدم</span><b>ما هو الإعراب؟</b>
            </a>
            <a class="rel-card" href="/nahw">
              <span>قواعد النحو من الأساس</span><b>تعلّم النحو</b>
            </a>
          </div>
        </section>

      </Container>

      <ArticleCta lang="ar">
        <span slot="title">ادرس الإعراب كاملاً في التطبيق.</span>
        الصرف والبلاغة والفوائد لكل آية، مع بحثٍ فوري وحفظٍ للآيات، في تطبيق إعراب، ويعمل دون إنترنت.
      </ArticleCta>
    </article>
  </main>

  <Footer lang="ar" />
</BaseLayout>

<script>
  /**
   * On-demand reference loader. The page carries our own words; the quoted
   * book text arrives only when the reader asks. Created nodes receive the
   * page's Astro scoped attribute so .blk/.exp/.fns styles apply unchanged;
   * .wg (WordGrid) and .irab-html are global.
   */
  const box = document.querySelector<HTMLElement>('[data-ref-src]');
  if (box) {
    const btn = box.querySelector<HTMLButtonElement>('[data-ref-load]')!;
    const out = box.querySelector<HTMLElement>('[data-ref-out]')!;
    const status = box.querySelector<HTMLElement>('[data-ref-status]')!;
    const cid = Array.from(box.attributes).map((a) => a.name).find((n) => n.startsWith('data-astro-cid-'));
    const el = (tag: string, cls = '', html?: string) => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (cid) e.setAttribute(cid, '');
      if (html !== undefined) e.innerHTML = html;
      return e;
    };
    const txt = (tag: string, cls: string, t: string) => { const e = el(tag, cls); e.textContent = t; return e; };
    const section = (heading: string) => { const s = el('section', 'blk'); s.append(txt('h2', '', heading)); return s; };

    interface RefWord { token: string; analysis: string; hex: string | null; caseLabel: string | null }
    interface RefPayload {
      words: RefWord[]; irabHtml: string; sarfHtml: string; balaghaHtml: string; fawaidHtml: string;
      footnotes: { id: string; content: string }[];
    }

    const render = (d: RefPayload) => {
      if (d.words?.length) {
        const s = section('إعراب المفردات كلمةً كلمة');
        const g = el('div', 'wg');
        for (const w of d.words) {
          const row = el('div', 'wg-row');
          row.style.setProperty('--case', w.hex ?? 'var(--color-stone-soft)');
          row.append(txt('div', 'wg-tok quran-text', w.token));
          const body = el('div', 'wg-body');
          body.append(txt('p', 'wg-an classical-naskh', w.analysis));
          if (w.caseLabel) body.append(txt('span', 'wg-chip', w.caseLabel));
          row.append(body);
          g.append(row);
        }
        s.append(g);
        out.append(s);
      }
      if (d.irabHtml) {
        const s = section('الإعراب التفصيلي');
        s.append(el('div', 'irab-html classical-naskh', d.irabHtml));
        out.append(s);
      }
      const extras: [string, string][] = [['الصرف', d.sarfHtml], ['البلاغة', d.balaghaHtml], ['الفوائد', d.fawaidHtml]];
      const present = extras.filter(([, h]) => h);
      if (present.length) {
        const s = section('الصرف والبلاغة والفوائد');
        for (const [label, h] of present) {
          const det = el('details', 'exp acc-card');
          det.append(txt('summary', '', label));
          det.append(el('div', 'irab-html classical-naskh', h));
          s.append(det);
        }
        out.append(s);
      }
      if (d.footnotes?.length) {
        const s = section('الهوامش');
        const ol = el('ol', 'fns classical-naskh');
        for (const f of d.footnotes) { const li = txt('li', '', f.content); li.id = f.id; ol.append(li); }
        s.append(ol);
        out.append(s);
      }
    };

    btn.addEventListener('click', async () => {
      btn.disabled = true;
      status.hidden = false;
      status.textContent = 'جارٍ تحميل المرجع…';
      try {
        const r = await fetch(box.dataset.refSrc!, { credentials: 'omit' });
        if (!r.ok) throw new Error(String(r.status));
        render((await r.json()) as RefPayload);
        status.hidden = true;
        btn.hidden = true;
        box.classList.add('ref-loaded');
      } catch {
        status.textContent = 'تعذّر تحميل المرجع الآن، حاول مرة أخرى.';
        btn.disabled = false;
      }
    });
  }
</script>

<style>
  .bc {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem;
    font-size: 1.1rem; color: color-mix(in srgb, var(--color-ink) 55%, transparent);
    margin-bottom: 1.5rem;
  }
  :global(.dark) .bc { color: color-mix(in srgb, var(--color-mist) 55%, transparent); }
  .bc a { color: inherit; text-decoration: none; display: inline-block; padding-block: 0.35rem; }
  .bc a:hover { color: var(--color-purple); }
  .bc-cur { color: var(--color-ink); font-weight: 600; }
  :global(.dark) .bc-cur { color: var(--color-mist); }

  .ayah-h1 {
    font-size: clamp(2.2rem, 5vw, 3.2rem); line-height: 1.15; font-weight: 700;
    color: var(--color-ink); margin-bottom: 0.5rem;
  }
  :global(.dark) .ayah-h1 { color: var(--color-mist); }
  .ayah-sub {
    font-size: 1.3rem; color: color-mix(in srgb, var(--color-ink) 60%, transparent);
    margin-bottom: 1.75rem;
  }
  :global(.dark) .ayah-sub { color: color-mix(in srgb, var(--color-mist) 60%, transparent); }

  .verse {
    position: relative; text-align: center;
    font-size: clamp(2.3rem, 5.5vw, 3.2rem); line-height: 2.15;
    color: var(--color-ink);
    background: var(--color-card);
    border: 1px solid var(--color-card-edge);
    border-top: 3px solid var(--color-purple);
    border-radius: 18px;
    padding: 2rem 1.75rem 2.25rem;
    margin: 0 0 1.1rem;
    box-shadow: var(--shadow-card);
  }
  :global(.dark) .verse {
    color: var(--color-mist); background: var(--color-coal-soft); border-color: var(--color-coal-edge);
    border-top-color: var(--color-purple);
  }
  .verse-num {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.1em; height: 2.1em; margin-inline-start: 0.4em;
    font-size: 0.5em; font-family: var(--font-mono); color: var(--color-purple);
    border: 1.5px solid color-mix(in srgb, var(--color-purple) 45%, transparent);
    border-radius: 999px; vertical-align: middle;
  }

  /* Reference label: sits directly above the quoted material so a reader (and a
     crawler) can tell where our own text ends and the cited book begins. */
  .source {
    font-size: 1.1rem; line-height: 1.8; color: color-mix(in srgb, var(--color-ink) 58%, transparent);
    margin: 2.75rem 0 -1.5rem; padding: 0.6rem 0.9rem;
    border-inline-start: 3px solid color-mix(in srgb, var(--color-teal) 55%, transparent);
    background: color-mix(in srgb, var(--color-teal) 5%, transparent);
    border-radius: 10px; border-start-start-radius: 0; border-end-start-radius: 0;
  }
  :global(.dark) .source { color: color-mix(in srgb, var(--color-mist) 58%, transparent); }
  .source-label {
    display: inline-block; margin-inline-end: 0.5rem; padding: 0.05rem 0.55rem; border-radius: 999px;
    font-size: 0.95rem; font-weight: 700; color: var(--color-teal);
    border: 1px solid color-mix(in srgb, var(--color-teal) 40%, transparent);
  }
  .blk-lessons { margin-top: 1.25rem; }
  .tldr + .blk-lessons { margin-top: 0; }
  .source-book { color: var(--color-teal); font-weight: 600; }
  .source-link { color: var(--color-teal); text-underline-offset: 3px; }

  .shared-note {
    font-size: 1.3rem; line-height: 1.7; margin: 0 0 1.5rem;
    padding: 0.85rem 1.1rem; border-radius: 12px;
    background: color-mix(in srgb, var(--color-teal) 8%, var(--color-paper));
    border: 1px solid color-mix(in srgb, var(--color-teal) 20%, transparent);
    color: color-mix(in srgb, var(--color-ink) 80%, transparent);
  }
  :global(.dark) .shared-note { background: color-mix(in srgb, var(--color-teal) 14%, var(--color-coal)); color: color-mix(in srgb, var(--color-mist) 80%, transparent); }
  .shared-note a { color: var(--color-teal); font-weight: 600; text-underline-offset: 3px; }

  .pending-note {
    font-size: 1.45rem; line-height: 1.9; margin-top: 1.5rem;
    padding: 1.25rem 1.4rem; border-radius: 14px; text-align: center;
    background: var(--color-card); border: 1.5px dashed var(--color-card-edge);
    color: color-mix(in srgb, var(--color-ink) 72%, transparent);
    box-shadow: var(--shadow-card);
  }
  :global(.dark) .pending-note { background: var(--color-coal-soft); border-color: var(--color-coal-edge); color: color-mix(in srgb, var(--color-mist) 72%, transparent); }

  .tldr {
    background: color-mix(in srgb, var(--color-purple) 6%, var(--color-paper));
    border: 1px solid color-mix(in srgb, var(--color-purple) 18%, transparent);
    border-radius: 16px; padding: 1.5rem 1.6rem; margin-bottom: 2.5rem;
  }
  :global(.dark) .tldr { background: color-mix(in srgb, var(--color-purple) 12%, var(--color-coal)); }
  .tldr .eyebrow { margin-bottom: 0.75rem; }
  .tldr p { font-size: 1.8rem; line-height: 2.1; color: var(--color-ink); }
  :global(.dark) .tldr p { color: var(--color-mist); }

  /* On-demand reference block */
  .ref-lead {
    font-size: 1.5rem; line-height: 2; margin-bottom: 1.25rem;
    color: color-mix(in srgb, var(--color-ink) 78%, transparent);
  }
  :global(.dark) .ref-lead { color: color-mix(in srgb, var(--color-mist) 78%, transparent); }
  .ref-btn {
    display: inline-flex; align-items: center; gap: 0.6rem;
    min-height: 44px; padding: 0.7rem 1.3rem; border-radius: 12px;
    font-family: var(--font-arabic-display); font-weight: 700; font-size: 1.35rem;
