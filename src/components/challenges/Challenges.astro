---
/**
 * Challenges: the app's «جمل منتقاة» on the web. Choose a topic (levels as
 * filters; levels 3+ on Irab+), choose a sentence, then for each word its
 * type, syntactic role and case marker; the result as «أعرب بنفسك» shows it,
 * with «لماذا إجابتي خطأ؟» to the teacher. Signed-in only.
 * Logic: lib/challenges/challenges.ts. Tokens: irab-ui.css.
 */
import '../../styles/irab-ui.css';
import '../../styles/irab-result.css';
import '../../styles/irab-teacher-entry.css';
import Paywall from '../Paywall.astro';
import { CHALLENGES } from '../../lib/challenges/strings';
import * as I from '../../lib/irab/icons';

interface Props { lang?: 'ar' | 'en' }
const { lang = 'ar' } = Astro.props;
const s = CHALLENGES[lang];
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const login = lang === 'ar' ? '/login?next=/challenges' : '/en/login?next=/en/challenges';
const back = lang === 'ar' ? I.arrowRight : I.arrowLeft;
const fwd = lang === 'ar' ? I.arrowLeft : I.arrowRight;
// Previous points toward the start of the sentence: right in Arabic.
const prev = I.chevronLeft.replace('<svg', '<svg class="ch-prev-ic"');
const next = I.chevronLeft.replace('<svg', '<svg class="ch-next-ic"');
---

<div class="iu iu-challenges" data-challenges data-lang={lang} dir={dir} lang={lang}>

  <section data-view="gate" class="ch-view" hidden>
    <div class="iu-card ch-gate">
      <span class="ch-gate-icon"><Fragment set:html={I.book} /></span>
      <h1 class="t-display c-1">{s.gateTitle}</h1>
      <p class="t-body c-2">{s.gateBody}</p>
      <a class="iu-btn teal lg" href={login}>{s.signIn}</a>
    </div>
  </section>

  <!-- Topics -->
  <section data-view="topics" class="ch-view">
    <h1 class="t-display c-1">{s.title}</h1>
    <p class="t-body-s c-2 ch-sub">{s.subtitle}</p>
    <h2 class="t-title c-1 ch-h2">{s.chooseTopic}</h2>
    <div class="ch-levels" data-levels role="group" aria-label={s.chooseTopic}></div>
    <div class="ch-topics" data-topics aria-busy="true"></div>
    <div class="iu-card ch-failed" data-topics-msg hidden role="alert">
      <p class="t-body-s c-2">{s.loadFailed}</p>
      <button type="button" class="iu-btn secondary" data-topics-retry><Fragment set:html={I.refresh} />{s.retryLoad}</button>
    </div>
  </section>

  <!-- Sentences -->
  <section data-view="sentences" class="ch-view ch-narrow" hidden>
    <div class="ch-head">
      <button type="button" class="iu-icon-btn" data-back-topics aria-label={s.back} title={s.back}><Fragment set:html={back} /></button>
      <div class="ch-head-text"><span class="t-micro c-teal" data-topic-level></span><h1 class="t-title c-1" data-topic-name></h1></div>
    </div>
    <h2 class="t-body-strong c-2 ch-h2">{s.chooseSentence}</h2>
    <div class="ch-sentences" data-sentences aria-busy="true"></div>
  </section>

  <!-- One word at a time -->
  <section data-view="solve" class="ch-view ch-narrow" hidden>
    <div class="ch-head">
      <button type="button" class="iu-icon-btn" data-back-sentences aria-label={s.back} title={s.back}><Fragment set:html={back} /></button>
      <h1 class="t-title c-1 ch-head-text" data-solve-topic></h1>
      <span class="ch-count" data-answered aria-live="polite"></span>
    </div>
    <div class="ch-progress" data-progress aria-hidden="true"></div>
    <div class="ch-strip" data-strip dir="rtl" lang="ar"></div>
    <div class="iu-card ch-word-card" data-word-card>
      <div class="ch-word-top">
        <button type="button" class="iu-icon-btn" data-prev aria-label={s.previousWord} title={s.previousWord}><Fragment set:html={prev} /></button>
        <p class="t-caption c-3" data-word-n></p>
        <button type="button" class="iu-icon-btn" data-next aria-label={s.nextWord} title={s.nextWord}><Fragment set:html={next} /></button>
      </div>
      <p class="ch-word" data-word dir="rtl" lang="ar"></p>
    </div>
    <div class="ch-steps" data-steps></div>
    <div class="ch-bar">
      <button type="button" class="iu-btn teal lg block" data-confirm disabled><Fragment set:html={I.check} />{s.confirm}</button>
      <button type="button" class="iu-btn teal lg block" data-check hidden><Fragment set:html={I.clipboardCheck} />{s.check}</button>
    </div>
  </section>

  <!-- Result -->
  <section data-view="results" class="ch-view ch-narrow" hidden>
    <div class="ch-head">
      <button type="button" class="iu-icon-btn" data-back-solve aria-label={s.back} title={s.back}><Fragment set:html={back} /></button>
      <h1 class="t-title c-1 ch-head-text">{s.result}</h1>
      <button type="button" class="iu-icon-btn" data-share aria-label={s.share} title={s.share}><Fragment set:html={I.share} /></button>
    </div>
    <p class="t-caption c-teal ch-share-status" data-share-status aria-live="polite"></p>
    <div data-results></div>
    <div class="ch-actions">
      <button type="button" class="iu-btn secondary lg" data-retry><Fragment set:html={I.refresh} />{s.retry}</button>
      <button type="button" class="iu-btn teal lg" data-other>{s.otherSentences}<Fragment set:html={fwd} /></button>
    </div>
  </section>
</div>

<Paywall lang={lang} />

<script>
  import { mountChallenges } from '../../lib/challenges/challenges';
  document.querySelectorAll<HTMLElement>('[data-challenges]').forEach(mountChallenges);
</script>

<style is:global>
  .iu-challenges { max-width: 880px; margin: 0 auto; padding: 0 0 40px; }
  .iu-challenges .ch-view { display: flex; flex-direction: column; }
  .iu-challenges .ch-narrow { max-width: 720px; width: 100%; margin: 0 auto; }
  .iu-challenges .ch-sub { margin: 4px 0 0; max-width: 620px; }
  .iu-challenges .ch-h2 { margin: 22px 0 10px; }

  .iu-challenges .ch-gate { max-width: 560px; margin: 0 auto; padding: 26px 20px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; }
  .iu-challenges .ch-gate .iu-btn { margin-top: 6px; }
  .iu-challenges .ch-gate-icon { width: 52px; height: 52px; border-radius: 999px; display: grid; place-items: center; background: var(--iu-teal-soft); color: var(--iu-teal); }
  .iu-challenges .ch-gate-icon svg { width: 24px; height: 24px; }

  /* Topics */
  .iu-challenges .ch-levels { display: flex; gap: 8px; overflow-x: auto; padding: 2px 2px 10px; margin: 0 -2px 4px; scrollbar-width: none; }
  .iu-challenges .ch-levels::-webkit-scrollbar { display: none; }
  @media (min-width: 720px) { .iu-challenges .ch-levels { flex-wrap: wrap; overflow: visible; } }
  .iu-challenges .ch-level {
    flex: none; display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 14px; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--iu-border); background: var(--iu-card); color: var(--iu-text-2);
    font-family: var(--iu-ui); font-size: 13px; font-weight: 600; white-space: nowrap; transition: background-color .15s ease, border-color .15s ease;
  }
  .iu-challenges .ch-level svg { width: 13px; height: 13px; }
  .iu-challenges .ch-level:hover { border-color: var(--iu-teal); }
  .iu-challenges .ch-level.is-on { background: var(--iu-teal); border-color: var(--iu-teal); color: #fff; }
  .iu-challenges .ch-level:focus-visible { outline: 2px solid var(--iu-teal); outline-offset: 2px; }
  .iu-challenges .ch-topics { display: grid; grid-template-columns: 1fr; gap: 12px; }
  @media (min-width: 640px) { .iu-challenges .ch-topics { grid-template-columns: 1fr 1fr; } }
  .iu-challenges .ch-topic, .iu-challenges .ch-plus-banner, .iu-challenges .ch-sentence {
    display: flex; align-items: center; gap: 12px; width: 100%; padding: 14px 16px; text-align: start; cursor: pointer;
    font: inherit; color: inherit;
    transition: border-color .2s ease, box-shadow .25s ease, transform .3s cubic-bezier(.22, 1, .36, 1);
  }
  .iu-challenges .ch-topic:hover, .iu-challenges .ch-sentence:hover { border-color: var(--iu-teal); }
  /* Hover: the card lifts a little and its shadow deepens, the icon tile
     grows a touch and the chevron leans the reading way. Pointer devices
     only; a press settles the card back down. */
  .iu-challenges :is(.ch-topic-icon, .ch-plus-icon, .ch-num) { transition: transform .3s cubic-bezier(.22, 1, .36, 1), background-color .2s ease, color .2s ease; }
  .iu-challenges :is(.ch-topic, .ch-plus-banner, .ch-sentence) > svg { transition: translate .3s cubic-bezier(.22, 1, .36, 1), color .2s ease; }
  @media (hover: hover) {
    .iu-challenges :is(.ch-topic, .ch-plus-banner, .ch-sentence):hover { transform: translateY(-3px); box-shadow: var(--iu-shadow-lift); }
    .iu-challenges :is(.ch-topic, .ch-plus-banner):hover :is(.ch-topic-icon, .ch-plus-icon) { transform: scale(1.06); }
    .iu-challenges .ch-sentence:hover .ch-num { transform: scale(1.06); background: var(--iu-teal-soft); color: var(--iu-teal-text); }
    .iu-challenges :is(.ch-topic, .ch-sentence):hover > svg { color: var(--iu-teal); translate: -3px 0; }
    .iu-challenges .ch-plus-banner:hover > svg { color: var(--iu-primary); translate: -3px 0; }
    .iu-challenges[dir='ltr'] :is(.ch-topic, .ch-plus-banner, .ch-sentence):hover > svg { translate: 3px 0; }
  }
  .iu-challenges :is(.ch-topic, .ch-plus-banner, .ch-sentence):active { transform: translateY(-1px) scale(.99); transition-duration: .2s, .2s, .1s; }
  @media (prefers-reduced-motion: reduce) {
    .iu-challenges :is(.ch-topic, .ch-plus-banner, .ch-sentence, .ch-topic-icon, .ch-plus-icon, .ch-num) { transform: none !important; }
    .iu-challenges :is(.ch-topic, .ch-plus-banner, .ch-sentence) > svg { translate: none !important; }
  }
  .iu-challenges .ch-topic:focus-visible, .iu-challenges .ch-plus-banner:focus-visible, .iu-challenges .ch-sentence:focus-visible { outline: 2px solid var(--iu-teal); outline-offset: 2px; }
  .iu-challenges .ch-topic > svg, .iu-challenges .ch-plus-banner > svg, .iu-challenges .ch-sentence > svg { width: 16px; height: 16px; color: var(--iu-text-3); flex: none; }
  .iu-challenges .ch-topic-icon, .iu-challenges .ch-plus-icon { width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center; flex: none; }
  .iu-challenges .ch-topic-icon svg, .iu-challenges .ch-plus-icon svg { width: 20px; height: 20px; }
  .iu-challenges .ch-teal .ch-topic-icon { background: var(--iu-teal-soft); color: var(--iu-teal); }
  .iu-challenges .ch-primary .ch-topic-icon { background: var(--iu-primary-soft); color: var(--iu-primary); }
  .iu-challenges .ch-topic-text { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .iu-challenges .ch-teal .ch-topic-level { color: var(--iu-teal-text); }
  .iu-challenges .ch-primary .ch-topic-level { color: var(--iu-primary-text); }
  .iu-challenges .ch-topic.is-locked .ch-topic-icon { background: var(--iu-sunken); color: var(--iu-text-3); }
  .iu-challenges .ch-topic.is-locked .ch-topic-level { color: var(--iu-text-3); }
  .iu-challenges .ch-topic.is-locked:hover { border-color: var(--iu-primary); }
  .iu-challenges .ch-plus { flex: none; padding: 4px 10px 4px 8px; font-size: 12px; }
  .iu-challenges .ch-plus svg { width: 14px; height: 14px; }
  .iu-challenges .ch-plus-banner { grid-column: 1 / -1; background: var(--iu-primary-wash); border-color: var(--iu-primary-soft); }
  .iu-challenges .ch-plus-banner:hover { border-color: var(--iu-primary); }
  .iu-challenges .ch-plus-icon { background: var(--iu-primary-soft); color: var(--iu-primary); }
  .iu-challenges .ch-failed { padding: 18px; display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center; }
  .iu-challenges .ch-empty { text-align: center; padding: 24px 0; }

  /* Head shared by the inner screens */
  .iu-challenges .ch-head { display: flex; align-items: center; gap: 4px; min-height: 52px; margin: 0 -8px 8px; }
  .iu-challenges .ch-head-text { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .iu-challenges .ch-count {
    flex: none; height: 30px; padding: 0 12px; border-radius: 999px; display: inline-flex; align-items: center;
    background: var(--iu-teal-soft); color: var(--iu-teal-text); font-size: 12px; font-weight: 600;
  }

  /* Sentences */
  .iu-challenges .ch-sentences { display: flex; flex-direction: column; gap: 12px; }
  .iu-challenges .ch-num {
    width: 32px; height: 32px; border-radius: 999px; display: grid; place-items: center; flex: none;
    background: var(--iu-sunken); color: var(--iu-text-2); font-size: 13px; font-weight: 600;
  }
  .iu-challenges .ch-sentence.is-started .ch-num { background: var(--iu-teal-soft); color: var(--iu-teal-text); }
  .iu-challenges .ch-sentence-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .iu-challenges .ch-sentence .t-sentence-s { font-size: 20px; }
  .iu-challenges .ch-sentence-meta { display: flex; align-items: center; gap: 10px; }
  .iu-challenges .ch-dots { display: inline-flex; gap: 4px; }
  .iu-challenges .ch-dots i { width: 6px; height: 6px; border-radius: 999px; background: var(--iu-border-strong); }
  .iu-challenges .ch-dots i.is-on { background: var(--iu-teal); }

  /* One word at a time */
  .iu-challenges .ch-progress { display: flex; gap: 6px; margin-bottom: 14px; }
  .iu-challenges .ch-progress span { flex: 1; height: 4px; border-radius: 2px; background: var(--iu-border); transition: background-color .2s ease; }
  .iu-challenges .ch-progress span.is-done { background: color-mix(in srgb, var(--iu-teal) 55%, transparent); }
  .iu-challenges .ch-progress span.is-on { background: var(--iu-teal); }
  .iu-challenges .ch-strip { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin-bottom: 14px; }
  .iu-challenges .ch-chip {
    display: inline-flex; align-items: center; gap: 4px; padding: 2px 12px; border-radius: 12px; cursor: pointer;
    border: 1.5px solid transparent; background: none; color: var(--iu-text-2);
    font-family: var(--iu-studied); font-size: 19px; font-weight: 700; line-height: 1.7;
  }
  .iu-challenges .ch-chip svg { width: 15px; height: 15px; color: var(--iu-teal); }
  .iu-challenges .ch-chip.is-done { color: var(--iu-text); }
  .iu-challenges .ch-chip.is-on { background: var(--iu-teal-soft); color: var(--iu-teal-text); border-color: var(--iu-teal); }
  .iu-challenges .ch-chip:focus-visible { outline: 2px solid var(--iu-teal); outline-offset: 2px; }
  .iu-challenges .ch-word-card { padding: 8px 10px 14px; border-color: var(--iu-teal); }
  .iu-challenges .ch-word-top { display: flex; align-items: center; justify-content: space-between; }
  .iu-challenges .ch-word-top .iu-icon-btn:disabled { opacity: .35; cursor: default; }
  .iu-challenges .ch-next-ic { transform: none; }
  .iu-challenges .ch-prev-ic { transform: scaleX(-1); }
  .iu-challenges[dir='ltr'] .ch-next-ic { transform: scaleX(-1); }
  .iu-challenges[dir='ltr'] .ch-prev-ic { transform: none; }
  .iu-challenges .ch-word { font-family: var(--iu-studied); font-size: 34px; font-weight: 700; line-height: 1.6; text-align: center; color: var(--iu-word); margin: 0; }
  .iu-challenges .ch-steps { display: flex; flex-direction: column; gap: 12px; margin-top: 12px; }
  .iu-challenges .ch-step { padding: 14px 16px 16px; scroll-margin: 90px 0 120px; }
  .iu-challenges .ch-step-head { display: flex; align-items: center; gap: 10px; margin: 0 0 12px; }
  .iu-challenges .ch-step-n {
    width: 26px; height: 26px; border-radius: 999px; display: grid; place-items: center; flex: none;
    background: var(--iu-teal); color: #fff; font-size: 12px; font-weight: 700;
  }
  .iu-challenges .ch-step-n svg { width: 14px; height: 14px; }
  .iu-challenges .ch-step.is-done { border-color: var(--iu-teal-soft); }
  .iu-challenges .ch-step.is-done .ch-step-n { background: var(--iu-teal-soft); color: var(--iu-teal-text); }
  .iu-challenges .ch-step.is-locked { background: var(--iu-sunken); box-shadow: none; }
  .iu-challenges .ch-step.is-locked .ch-step-head { margin-bottom: 6px; color: var(--iu-text-3); }
  .iu-challenges .ch-step.is-locked .ch-step-n { background: var(--iu-border); color: var(--iu-text-3); }
  .iu-challenges .ch-locked { display: flex; align-items: center; gap: 6px; margin: 0; }
  .iu-challenges .ch-locked svg { width: 14px; height: 14px; }
  .iu-challenges .ch-opts { display: flex; flex-wrap: wrap; gap: 8px; }
  .iu-challenges .ch-opt {
    min-height: 38px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--iu-border); background: var(--iu-card); cursor: pointer;
    font-family: var(--iu-ui); font-size: 14px; font-weight: 600; color: var(--iu-text); transition: border-color .15s ease, background-color .15s ease;
  }
  .iu-challenges .ch-opt:hover { border-color: var(--iu-teal); background: var(--iu-teal-wash); }
  .iu-challenges .ch-opt.is-on { background: var(--iu-teal); border-color: var(--iu-teal); color: #fff; }
  .iu-challenges .ch-opt:focus-visible { outline: 2px solid var(--iu-teal); outline-offset: 2px; }
  .iu-challenges .ch-bar {
    position: sticky; bottom: 0; z-index: 5; margin: 6px -16px 0; padding: 14px 16px calc(14px + env(safe-area-inset-bottom));
    background: linear-gradient(to top, var(--iu-canvas) 70%, transparent);
  }

  /* Result */
  .iu-challenges .ch-share-status:empty { display: none; }
  .iu-challenges .ch-share-status { margin: -4px 0 8px; text-align: end; }
  .iu-challenges .ch-actions { display: flex; gap: 10px; margin-top: 22px; }
  .iu-challenges .ch-actions .iu-btn { flex: 1; }
  .iu-challenges .ch-actions .iu-btn.teal { flex: 1.6; }
</style>
