---
/**
 * ArticleHero, common hero block for pillar / long-form pages.
 */
import Container from './Container.astro';

interface Props {
  eyebrow?: string;
  title: string;
  summary: string;
  lang?: 'en' | 'ar';
  /** Keep the title on ONE line at every width (fluid size scales down instead of wrapping). */
  nowrapTitle?: boolean;
}

const { eyebrow, title, summary, lang = 'ar', nowrapTitle = false } = Astro.props;
const titleClass = lang === 'ar' ? 'font-arabic-display' : 'font-display';
// nowrapTitle keeps the title on one line from md up. On phones a five-word
// Arabic title forced onto one line shrank to ~21px (smaller than the summary
// under it), so below md it wraps at a real headline size instead.
const titleSize = nowrapTitle
  ? 'text-[clamp(1.9rem,7.5vw,3.4rem)] md:text-[clamp(1.35rem,4.1vw,3.4rem)] md:whitespace-nowrap'
  : 'text-[clamp(2.5rem,6vw,5rem)]';
const summaryClass = lang === 'ar' ? 'font-arabic leading-loose' : 'leading-relaxed';
---
<header class="relative overflow-hidden border-b border-stone dark:border-coal-edge">
  {/* Ambient brand watermark, sits in the corner away from the text column */}
  <img
    src="/brand-watermark.webp"
    alt=""
    aria-hidden="true"
    width="900"
    height="751"
    class:list={[
      'pointer-events-none select-none absolute top-1/2 -translate-y-1/2 w-[40%] max-w-[480px] opacity-[0.05] dark:opacity-[0.10] dark:invert',
      // Place opposite to the text alignment: text reads from start side, so watermark sits on the end side
      lang === 'ar' ? 'left-[-6%]' : 'right-[-6%]',
    ]}
  />

  {/* Soft ambient wash: two large radial glows behind the text column give the
      hero depth without competing with the page texture. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
    style="background:
      radial-gradient(42rem 22rem at 78% 0%, color-mix(in srgb, var(--color-purple) 7%, transparent), transparent 70%),
      radial-gradient(36rem 20rem at 12% 100%, color-mix(in srgb, var(--color-teal) 6%, transparent), transparent 70%);"
  ></div>

  <Container size="narrow">
    {/* Tighter on phones so the page's answer (the analyzer on /tool, the
        first section on articles) starts within the first screen. */}
    <div class="relative py-12 md:py-28">
      {eyebrow && (
        <p
          class="eyebrow mb-8 rounded-full border border-purple/25 bg-purple/[0.07] dark:border-purple/40 dark:bg-purple/15 px-4 py-1.5"
          data-reveal
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.4 6.8L21 9l-5.2 4 1.8 7L12 16.6 6.4 20l1.8-7L3 9l6.6-.2z"/></svg>
          {eyebrow}
        </p>
      )}
      {/* Aref Ruqaa's ascenders and swashes overflow the em box: at leading-[1.1]
          they collided with the eyebrow above (visible on every article page).
          Arabic display titles get the line-height the face actually needs. */}
      <h1
        class:list={[titleClass, titleSize, 'tracking-tight', lang === 'ar' ? 'leading-[1.45] pb-1' : 'leading-[1.1]']}
        data-reveal
        data-reveal-delay="80"
      >{title}</h1>
      <p class:list={[summaryClass, 'mt-5 text-body md:text-body-lg text-ink/80 dark:text-mist/80 max-w-2xl']} data-reveal data-reveal-delay="160">{summary}</p>
      {/* Optional meta row (chips/stats) a page can inject under the summary. */}
      <slot />
    </div>
  </Container>
</header>
