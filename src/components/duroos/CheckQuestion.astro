---
/**
 * CheckQuestion: a small self-check placed directly after an explanation, so
 * the learner applies the rule while it is still fresh rather than only at the
 * end of the page.
 *
 * No scoring and no JavaScript: the answer is a <details>, which keeps the
 * page static, crawlable and reliable. The value is in the pause before
 * opening it, not in a score.
 */
interface Props {
  q: string;
  ar?: string;        // optional Arabic the question is about
  answer: string;
  why?: string;
}
const { q, ar, answer, why } = Astro.props;
---
<div class="chk">
  <p class="chk-k">Check yourself</p>
  <p class="chk-q">{q}</p>
  {ar && <p class="chk-ar" lang="ar" dir="rtl">{ar}</p>}
  <details class="chk-a" data-acc>
    <summary><span>Show the answer</span><span class="chk-chev" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span></summary>
    <div class="chk-a-body">
      <p class="chk-ans">{answer}</p>
      {why && <p class="chk-why">{why}</p>}
    </div>
  </details>
</div>

<style is:global>
  .ls .chk {
    margin: 1.75rem 0 0; padding: 1.3rem 1.4rem 1.35rem; border-radius: 22px;
    background: var(--iu-teal-soft); border: 1px solid color-mix(in srgb, var(--iu-teal) 18%, transparent);
  }
  .ls .chk-k {
    display: inline-flex; align-items: center; gap: 0.4rem; margin: 0 0 0.6rem; padding: 0.15rem 0.75rem; border-radius: 999px;
    font-size: 0.82rem; font-weight: 700; line-height: 1.8; color: #fff; background: var(--iu-teal);
  }
  .ls .chk-q { margin: 0; font-size: 1.1rem; font-weight: 700; line-height: 1.7; color: var(--iu-text); }
  .ls .chk-ar {
    margin: 0.9rem 0 0; padding: 0.7rem 1rem; border-radius: 16px; background: var(--iu-card);
    direction: rtl; unicode-bidi: isolate; text-align: center;
    font-size: clamp(1.45rem, 3.6vw, 1.75rem); font-weight: 700; line-height: 2; color: var(--iu-text);
  }
  .ls .chk-a { margin-top: 1rem; }
  .ls .chk-a > summary {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.6rem; padding: 0 1.1rem; border-radius: 999px; cursor: pointer; list-style: none;
    font-size: 0.95rem; font-weight: 700; color: var(--iu-teal-text); background: var(--iu-card); border: 1px solid color-mix(in srgb, var(--iu-teal) 25%, transparent);
    transition: background-color .25s, color .25s, border-color .25s;
  }
  .ls .chk-a > summary::-webkit-details-marker { display: none; }
  .ls .chk-a > summary:hover { color: #fff; background: var(--iu-teal); border-color: var(--iu-teal); }
  .ls .chk-chev { display: grid; transition: rotate .35s cubic-bezier(.22, 1, .36, 1); }
  .ls .chk-chev svg { width: 1rem; height: 1rem; }
  .ls .chk-a[open] .chk-chev, .ls .chk-a.acc-open .chk-chev { rotate: 180deg; }
  .ls .chk-a:not(.acc-open).acc-on .chk-chev { rotate: 0deg; }
  .ls .chk-a-body { display: grid; gap: 0.45rem; margin-top: 0.9rem; padding: 1rem 1.15rem; border-radius: 16px; background: var(--iu-card); border-inline-start: 3px solid var(--iu-success); }
  .ls .chk-ans { margin: 0; font-size: 1.05rem; font-weight: 700; line-height: 1.8; color: var(--iu-text); }
  .ls .chk-why { margin: 0; font-size: 1rem; line-height: 1.85; color: var(--iu-text-2); }
</style>
