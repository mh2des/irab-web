---
/**
 * ExampleCard: one worked example, with the Arabic as the focal point.
 *
 * In the Arabic lessons a شاهد is an inline pill inside a paragraph, which is
 * right for a reader who reads Arabic fluently. An English learner needs the
 * opposite emphasis: the sentence large, vocalised and unhurried, with the
 * English kept deliberately secondary.
 *
 * `focus` names the word the lesson is teaching. It is matched against the
 * `ar` string and marked, so the learner can see at a glance which word the
 * rule is about. Matching is literal, so pass the word exactly as it appears,
 * vowels included.
 *
 * The i'rab sits in a <details>. That is a teaching decision, not a way to
 * hide text: the learner should attempt the parse before reading it. It stays
 * in the DOM, so it is still crawlable and still searchable on the page.
 */
interface Props {
  ar: string;              // the vocalised Arabic sentence
  translit?: string;
  en: string;              // plain English rendering
  focus?: string | string[];
  irab?: string;           // full classical wording
  note?: string;           // the decoded explanation, shown under the i'rab
  label?: string;          // e.g. "Example 1", "Fronted predicate"
}
const { ar, translit, en, focus, irab, note, label } = Astro.props;

// Split the sentence around the focus word(s) so they can be marked without
// resorting to innerHTML on author-supplied text.
const targets = (Array.isArray(focus) ? focus : focus ? [focus] : []).filter(Boolean);
type Piece = { t: string; hit: boolean };
const pieces: Piece[] = targets.length
  ? targets.reduce<Piece[]>((acc, word) => acc.flatMap((p) => {
      if (p.hit || !p.t.includes(word)) return [p];
      const out: Piece[] = [];
      p.t.split(word).forEach((chunk, i) => {
        if (i > 0) out.push({ t: word, hit: true });
        if (chunk) out.push({ t: chunk, hit: false });
      });
      return out;
    }), [{ t: ar, hit: false }])
  : [{ t: ar, hit: false }];
---
<figure class="exc">
  {label && <figcaption class="exc-label">{label}</figcaption>}

  <p class="exc-ar" lang="ar" dir="rtl">
    {pieces.map((p) => (p.hit ? <mark class="exc-hit">{p.t}</mark> : <span>{p.t}</span>))}
  </p>

  {translit && <p class="exc-translit">{translit}</p>}
  <p class="exc-en">{en}</p>

  {irab && (
    <details class="exc-irab" data-acc>
      <summary><span>Show the i‘rāb</span><span class="exc-chev" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span></summary>
      <div class="exc-irab-body">
        <p class="exc-irab-ar" lang="ar" dir="rtl">{irab}</p>
        {note && <p class="exc-note">{note}</p>}
      </div>
    </details>
  )}
</figure>

<style is:global>
  .ls .exc {
    margin: 1.75rem 0 0; padding: 1.35rem 1.4rem 0.4rem; border-radius: 22px;
    background: var(--iu-card); border: 1px solid var(--iu-border); box-shadow: var(--iu-shadow-card);
  }
  .ls .exc-label {
    display: inline-flex; padding: 0.15rem 0.75rem; border-radius: 999px;
    font-size: 0.82rem; font-weight: 700; line-height: 1.8; color: var(--acc-text); background: var(--acc-soft);
  }
  /* The Arabic is the point of the card: large, generously led, centred. */
  .ls .exc-ar {
    margin: 0.8rem 0 0; direction: rtl; unicode-bidi: isolate; text-align: center;
    font-size: clamp(1.75rem, 4.4vw, 2.2rem); font-weight: 700; line-height: 2; color: var(--iu-text);
  }
  /* The word the lesson is about. */
  .ls .exc-hit {
    color: var(--acc-text); background: var(--acc-soft); border-radius: 0.25em;
    box-shadow: inset 0 -0.12em 0 var(--acc-line);
    -webkit-box-decoration-break: clone; box-decoration-break: clone;
  }
  .ls .exc-translit { margin: 0.35rem 0 0; text-align: center; font-style: italic; font-size: 1rem; line-height: 1.7; color: var(--iu-text-3); }
  .ls .exc-en { margin: 0.15rem 0 0; text-align: center; font-size: 1.05rem; font-weight: 600; line-height: 1.7; color: var(--iu-text-2); }

  .ls .exc-irab { margin: 1.1rem -1.4rem 0; border-top: 1px solid var(--iu-border); }
  .ls .exc-irab > summary {
    display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.85rem 1.4rem; cursor: pointer; list-style: none;
    font-size: 0.95rem; font-weight: 700; color: var(--acc-text); border-radius: 0 0 22px 22px; transition: background-color .25s;
  }
  .ls .exc-irab > summary::-webkit-details-marker { display: none; }
  .ls .exc-irab > summary:hover { background: var(--acc-soft); }
  .ls .exc-irab[open] > summary { border-radius: 0; }
  .ls .exc-chev { display: grid; transition: rotate .35s cubic-bezier(.22, 1, .36, 1); }
  .ls .exc-chev svg { width: 1.1rem; height: 1.1rem; }
  .ls .exc-irab[open] .exc-chev, .ls .exc-irab.acc-open .exc-chev { rotate: 180deg; }
  .ls .exc-irab:not(.acc-open).acc-on .exc-chev { rotate: 0deg; }
  .ls .exc-irab-body { display: grid; gap: 0.8rem; padding: 0.2rem 1.4rem 1.3rem; }
  .ls .exc-irab-ar {
    margin: 0; direction: rtl; unicode-bidi: isolate; text-align: right;
    font-size: 1.18rem; line-height: 2.15; color: var(--iu-text);
    padding: 0.85rem 1rem; border-radius: 14px; background: var(--iu-sunken);
  }
  .ls .exc-note { margin: 0; font-size: 1rem; line-height: 1.85; color: var(--iu-text-2); }
</style>
