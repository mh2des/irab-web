---
/**
 * DuroosHub: the whole of /duroos and /en/duroos below the site nav.
 *
 * Shaped like a course syllabus rather than a wall of cards: a short hero
 * with one place to start (or, once the visitor has read something, the
 * lesson to continue), then the ten chapters as cards whose lessons are
 * numbered rows. From 1024px a sticky outline of the chapters sits beside
 * them and follows the scroll. A search box filters the forty lessons as you
 * type, folding diacritics and hamza forms so «الفاعل» finds «الفاعِل».
 *
 * Progress is read from this browser only (lib/duroos-progress): a lesson the
 * visitor finished shows a check, a chapter shows how much of it is done,
 * and the hero card switches from "start here" to "continue". The page is
 * complete without any of that; the script only adds to it.
 */
import '../../styles/irab-ui.css';
import { course, courseLessons, num, arCount, isLive, type Lang } from '../../lib/duroos-course';
import { fold } from '../../lib/duroos-progress';

interface Props { lang?: Lang }
const { lang = 'ar' } = Astro.props;
const en = lang === 'en';
const dir = en ? 'ltr' : 'rtl';
const base = en ? '/en' : '';

const chapters = course(lang);
const lessons = courseLessons(lang);
const total = lessons.length;
const first = lessons[0];

// Quranic citations quoted in the Arabic lessons' own text, counted from the
// pages at build time so the figure never drifts from the content.
const pages = import.meta.glob('../../pages/duroos/*.astro', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const shawahid = Object.values(pages).reduce((n, src) => n + (src.match(/﴿/g)?.length ?? 0), 0);

const lessonsWord = (n: number) => (en ? `${n} ${n === 1 ? 'lesson' : 'lessons'}` : arCount(n, ['درس واحد', 'درسان', 'دروس', 'درسًا']));

const s = en
  ? {
      eyebrow: 'Grammar lessons',
      title: 'The chapters of iʿrāb',
      intro: 'Each lesson takes one chapter of Arabic grammar and works it through properly: the rule and what governs it, worked examples parsed in the full classical wording, evidence from the Quran, and the mistakes English speakers actually make.',
      facts: [`${total} lessons`, `${chapters.length} chapters`, 'Worked examples with full iʿrāb', 'Free'],
      start: 'Start lesson 1',
      resume: 'Continue learning',
      browse: 'Browse the chapters',
      startHere: 'Start here',
      continueChip: 'Pick up where you stopped',
      nextChip: 'Your next lesson',
      lessonOf: (n: number) => `Lesson ${n} of ${total}`,
      read: 'Read the lesson',
      doneOf: (n: number) => `${n} of ${total} lessons finished`,
      sample: [{ w: 'العلمُ', r: 'Mubtadaʾ' }, { w: 'نورٌ', r: 'Khabar' }],
      outline: 'Chapters',
      search: 'Search the lessons',
      clear: 'Clear',
      found: (n: number) => (n === 1 ? '1 lesson' : `${n} lessons`),
      none: 'No lesson matches that. Try a shorter word, or a term in Arabic.',
      ofDone: (d: number, t: number) => `${d} of ${t}`,
      finished: 'Finished',
      inPrep: 'In preparation',
      practiceK: 'Practice',
      practiceT: 'Parse a sentence yourself',
      practiceB: 'Write your own iʿrāb and get it corrected word by word.',
      finalTitle: 'Theory is half the road.',
      finalLead: "Paste any sentence into the analyzer and watch a lesson's rule work word by word, or practise with instant correction.",
      finalCta: 'Try the analyzer',
      finalAlt: 'Start practising',
    }
  : {
      eyebrow: 'دروس النحو',
      title: 'أبواب الإعراب',
      intro: 'كل درس يشرح بابًا واحدًا: القاعدة بلغة واضحة، ثم أمثلة معربة إعرابًا كاملًا كما تُكتب في كتب النحو، ثم الأخطاء الشائعة. اقرأ الدرس، ثم جرّب ما تعلّمته على أي جملة في محلّل الإعراب.',
      facts: [arCount(total, ['درس واحد', 'درسان', 'دروس', 'درسًا']), arCount(chapters.length, ['باب واحد', 'بابان', 'أبواب', 'بابًا']), arCount(shawahid, ['شاهد قرآني واحد', 'شاهدان قرآنيان', 'شواهد قرآنية', 'شاهدًا قرآنيًا', 'شاهدٍ قرآنيٍّ']), 'مجانية بالكامل'],
      start: 'ابدأ الدرس الأول',
      resume: 'تابع التعلّم',
      browse: 'تصفّح الأبواب',
      startHere: 'ابدأ من هنا',
      continueChip: 'تابع من حيث توقفت',
      nextChip: 'درسك التالي',
      lessonOf: (n: number) => `الدرس ${num('ar', n)} من ${num('ar', total)}`,
      read: 'اقرأ الدرس',
      doneOf: (n: number) => `أتممت ${num('ar', n)} من ${num('ar', total)}`,
      sample: [{ w: 'العلمُ', r: 'مبتدأ' }, { w: 'نورٌ', r: 'خبر' }],
      outline: 'الأبواب',
      search: 'ابحث في الدروس',
      clear: 'مسح',
      found: (n: number) => arCount(n, ['درس واحد', 'درسان', 'دروس', 'درسًا']),
      none: 'لا يوجد درس بهذا الاسم. جرّب كلمة أقصر.',
      ofDone: (d: number, t: number) => `${num('ar', d)} من ${num('ar', t)}`,
      finished: 'مكتمل',
      inPrep: 'قيد الإعداد',
      practiceK: 'التدريب',
      practiceT: 'أعرِب بنفسك',
      practiceB: 'اكتب إعرابك لأي جملة وصحّحه كلمةً كلمة.',
      finalTitle: 'النظرية نصف الطريق.',
      finalLead: 'ألصق أي جملة في محلّل الإعراب وشاهد قاعدة الدرس تعمل كلمةً كلمة، أو تدرّب مع التصحيح الفوري.',
      finalCta: 'جرّب المحلّل',
      finalAlt: 'ابدأ التدريب',
    };

// What the client needs to fill the hero card and count progress.
const index = {
  l: lessons.map((l) => ({ s: l.slug, t: l.title, b: l.blurb, n: l.no, c: l.chapter, h: l.href })),
  c: chapters.map((c) => c.title),
  i18n: {
    lessonOf: lessons.map((l) => s.lessonOf(l.no)),
    doneOf: Array.from({ length: total + 1 }, (_, n) => s.doneOf(n)),
    ofDone: chapters.map((c) => Array.from({ length: c.lessons.length + 1 }, (_, d) => s.ofDone(d, c.lessons.length))),
    found: Array.from({ length: total + 1 }, (_, n) => s.found(n)),
    continueChip: s.continueChip, nextChip: s.nextChip, resume: s.resume, finished: s.finished,
  },
};

const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>';
const check = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>';
const searchIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>';
---

<link rel="preload" href="/fonts/thmanyah-text-bold.woff2" as="font" type="font/woff2" crossorigin />
<div class="iu dh" lang={lang} dir={dir} data-dh>
  {/* ── Hero ─────────────────────────────────────────────────────────── */}
  <section class="dh-hero">
    <div class="dh-hero-text">
      <p class="dh-eyebrow" data-reveal>{s.eyebrow}</p>
      <h1 class="dh-title" data-reveal data-reveal-delay="60">{s.title}</h1>
      <p class="dh-intro" data-reveal data-reveal-delay="120">{s.intro}</p>
      <ul class="dh-facts" data-reveal data-reveal-delay="180">{s.facts.map((f) => <li>{f}</li>)}</ul>
      <div class="dh-ctas" data-reveal data-reveal-delay="240">
        <a class="dh-btn is-primary" href={first.href} data-dh-cta><span data-dh-cta-label>{s.start}</span><Fragment set:html={arrow} /></a>
        <a class="dh-btn is-ghost" href="#syllabus">{s.browse}</a>
      </div>
    </div>

    <a class="dh-ticket spot-card" href={first.href} data-dh-ticket data-tilt="4" data-reveal data-reveal-delay="160">
      <span class="dh-ticket-top">
        <span class="dh-ticket-chip" data-t-chip>{s.startHere}</span>
        <span class="dh-ticket-no" data-t-no>{s.lessonOf(1)}</span>
      </span>
      <span class="dh-ticket-body">
        <span class="dh-ticket-ch" data-t-ch>{chapters[0].title}</span>
        <span class="dh-ticket-title" data-t-title>{first.title}</span>
        <span class="dh-ticket-blurb" data-t-blurb>{first.blurb}</span>
      </span>
      <span class="dh-ticket-sample" data-t-sample lang="ar" dir="rtl" aria-hidden="true">
        {s.sample.map((w, i) => (
          <span class="dh-w" style={`--i:${i}`}><b>{w.w}</b><i lang={lang} dir={dir}>{w.r}</i></span>
        ))}
      </span>
      <span class="dh-ticket-prog" data-t-prog hidden>
        <span class="dh-ticket-bar"><span data-t-bar></span></span>
        <span data-t-prog-label></span>
      </span>
      <span class="dh-ticket-go"><span>{s.read}</span><Fragment set:html={arrow} /></span>
    </a>
  </section>

  {/* ── Syllabus ─────────────────────────────────────────────────────── */}
  <div class="dh-body" id="syllabus">
    <aside class="dh-aside">
      <nav class="dh-outline" aria-label={s.outline}>
        <p class="dh-outline-k">{s.outline}</p>
        <ol>
          {chapters.map((c) => (
            <li>
              <a href={`#ch-${c.no}`} data-ol={c.no} style={`--acc:${c.accent}`}>
                <span class="dh-ol-no">{num(lang, c.no)}</span>
                <span class="dh-ol-t">{c.title}</span>
                <span class="dh-ol-p" data-ol-p>{num(lang, c.lessons.length)}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
      <a class="dh-practice" href={`${base}/practice`}>
        <span class="dh-practice-k">{s.practiceK}</span>
        <span class="dh-practice-t">{s.practiceT}</span>
        <span class="dh-practice-b">{s.practiceB}</span>
        <span class="dh-practice-go" aria-hidden="true"><Fragment set:html={arrow} /></span>
      </a>
    </aside>

    <div class="dh-main">
      <div class="dh-search" role="search">
        <span class="dh-search-ic" aria-hidden="true"><Fragment set:html={searchIcon} /></span>
        <input type="search" class="dh-input" data-dh-q placeholder={s.search} aria-label={s.search} dir="auto" autocomplete="off" />
        <button type="button" class="dh-clear" data-dh-clear hidden>{s.clear}</button>
      </div>
      <p class="dh-results" data-dh-results role="status" aria-live="polite"></p>

      {chapters.map((c) => (
        <section class="dh-ch spot-card" id={`ch-${c.no}`} data-ch={c.no} style={`--acc:${c.accent}`} aria-labelledby={`ch-${c.no}-h`} data-reveal>
          <header class="dh-ch-head">
            <span class="dh-ch-no" aria-hidden="true">{num(lang, c.no)}</span>
            <div class="dh-ch-text">
              <h2 id={`ch-${c.no}-h`}>{c.title}</h2>
              <p>{c.desc}</p>
            </div>
            <span class="dh-ch-meta">
              <span class="dh-ch-count" data-ch-count>{lessonsWord(c.lessons.length)}</span>
              <span class="dh-ch-prog" data-ch-prog hidden>
                <span class="dh-mini"><span data-ch-bar></span></span>
                <span data-ch-label></span>
              </span>
            </span>
          </header>
          <ol class="dh-list">
            {c.lessons.map((l) => {
              const q = fold(`${l.title} ${l.blurb} ${l.slug.replace(/-/g, ' ')}`);
              return isLive(lang, l.slug) ? (
                <li data-row data-slug={l.slug} data-q={q}>
                  <a class="dh-row" href={l.href}>
                    <span class="dh-row-no"><span class="dh-row-n">{num(lang, l.no, 2)}</span><span class="dh-row-ok"><Fragment set:html={check} /></span></span>
                    <span class="dh-row-text">
                      <span class="dh-row-title">{l.title}<span class="sr-only" data-row-sr></span></span>
                      <span class="dh-row-blurb">{l.blurb}</span>
                    </span>
                    <span class="dh-row-go" aria-hidden="true"><Fragment set:html={arrow} /></span>
                  </a>
                </li>
              ) : (
                <li data-row data-slug={l.slug} data-q={q}>
                  <span class="dh-row is-off">
                    <span class="dh-row-no"><span class="dh-row-n">{num(lang, l.no, 2)}</span></span>
                    <span class="dh-row-text">
                      <span class="dh-row-title">{l.title}</span>
                      <span class="dh-row-blurb">{s.inPrep}</span>
                    </span>
                  </span>
                </li>
              );
            })}
          </ol>
        </section>
      ))}
      <p class="dh-empty" data-dh-empty hidden>{s.none}</p>
    </div>
  </div>

  {/* ── Closing call ─────────────────────────────────────────────────── */}
  <section class="dh-final" data-reveal>
    <h2 class="dh-final-title">{s.finalTitle}</h2>
    <p class="dh-final-lead">{s.finalLead}</p>
    <div class="dh-final-ctas">
      <a href={en ? '/en#demo' : '/#demo'} class="dh-final-btn" data-magnetic>{s.finalCta}<Fragment set:html={arrow} /></a>
      <a href={`${base}/practice`} class="dh-final-alt">{s.finalAlt}</a>
    </div>
  </section>

  <script type="application/json" data-dh-index set:html={JSON.stringify(index)} />
</div>

<style>
  .dh {
    --dh-ease: cubic-bezier(.22, 1, .36, 1);
    max-width: 1180px; margin: 0 auto; padding: clamp(2rem, 5vw, 3.75rem) 1.25rem 4rem;
    font-family: var(--iu-ui); color: var(--iu-text);
  }
  @media (min-width: 640px) { .dh { padding-inline: 1.75rem; } }
  .dh :global(svg) { flex: none; }
  .dh[dir='ltr'] :global(.dh-btn svg), .dh[dir='ltr'] :global(.dh-ticket-go svg),
  .dh[dir='ltr'] :global(.dh-row-go svg), .dh[dir='ltr'] :global(.dh-practice-go svg),
  .dh[dir='ltr'] :global(.dh-final-btn svg) { transform: scaleX(-1); }

  /* ── Hero ── */
  .dh-hero { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 1000px) { .dh-hero { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 3.5rem; } }
  .dh-eyebrow {
    display: inline-flex; margin: 0 0 1rem; padding: 0.3rem 0.85rem; border-radius: 999px;
    font-size: 0.9rem; font-weight: 700; color: var(--iu-primary-text); background: var(--iu-primary-soft);
  }
  .dh-title { font-size: clamp(2.3rem, 5.2vw, 3.6rem); font-weight: 700; line-height: 1.25; letter-spacing: 0; }
  .dh[lang='en'] .dh-title { line-height: 1.08; letter-spacing: -0.025em; }
  .dh-intro { max-width: 38rem; margin: 1rem 0 0; font-size: 1.12rem; line-height: 1.95; color: var(--iu-text-2); text-wrap: pretty; }
  .dh[lang='en'] .dh-intro { line-height: 1.75; }
  .dh-facts { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.35rem 0 0; padding: 0; }
  .dh-facts li {
    padding: 0.32rem 0.85rem; border-radius: 999px; font-size: 0.9rem; font-weight: 600;
    color: var(--iu-text-2); background: var(--iu-card); border: 1px solid var(--iu-border);
  }
  .dh-facts li:last-child { color: var(--iu-teal-text); background: var(--iu-teal-soft); border-color: transparent; }
  .dh-ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  .dh-btn {
    display: inline-flex; align-items: center; gap: 0.6rem; min-height: 3.1rem; padding: 0 1.5rem; border-radius: 999px;
    font-size: 1.02rem; font-weight: 700; text-decoration: none;
    transition: transform .3s var(--dh-ease), box-shadow .3s var(--dh-ease), background-color .2s, border-color .2s, color .2s;
  }
  .dh-btn :global(svg) { width: 1.1rem; height: 1.1rem; transition: translate .35s var(--dh-ease); }
  .dh-btn.is-primary { color: #fff; background: var(--iu-primary); box-shadow: var(--iu-shadow-primary); }
  .dh-btn.is-ghost { color: var(--iu-text); background: var(--iu-card); border: 1px solid var(--iu-border-strong); }
  @media (hover: hover) {
    .dh-btn:hover { transform: translateY(-2px); }
    .dh-btn.is-primary:hover { box-shadow: 0 16px 30px -12px rgb(124 77 255 / 0.55); }
    .dh-btn.is-primary:hover :global(svg) { translate: -4px 0; }
    .dh[dir='ltr'] .dh-btn.is-primary:hover :global(svg) { translate: 4px 0; }
    .dh-btn.is-ghost:hover { border-color: var(--iu-primary); color: var(--iu-primary-text); }
  }
  .dh-btn:active { transform: translateY(0) scale(.98); }
  .dh-btn:focus-visible { outline: 2px solid var(--iu-primary); outline-offset: 3px; }

  /* The hero card: the first lesson as a ticket on the site's ink, with the
     lattice, and the two words of «العلمُ نورٌ» labelled as the lesson labels them. */
  .dh-ticket {
    position: relative; isolation: isolate; overflow: hidden;
    display: flex; flex-direction: column; gap: 1.1rem;
    padding: clamp(1.5rem, 3vw, 2rem); border-radius: 26px;
    color: #fff; background-color: #173847; text-decoration: none;
    box-shadow: 0 30px 60px -32px rgb(23 56 71 / 0.75);
    transition: box-shadow .45s var(--dh-ease);
  }
  @media (min-width: 1000px) { .dh-ticket { min-height: 22rem; } }
  .dh-ticket::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background-image:
      repeating-linear-gradient(45deg, rgb(255 255 255 / 0.05) 0 1px, transparent 1px 30px),
      repeating-linear-gradient(135deg, rgb(255 255 255 / 0.05) 0 1px, transparent 1px 30px);
  }
  .dh-ticket.spot-card::after { background: radial-gradient(300px circle at var(--spot-x, 50%) var(--spot-y, 30%), rgb(255 255 255 / 0.10), transparent 62%); }
  :global(.dark) .dh-ticket { background-color: #131B22; box-shadow: inset 0 0 0 1px #2B3844, 0 30px 60px -32px rgb(0 0 0 / 0.8); }
  .dh-ticket-top { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .dh-ticket-chip { padding: 0.28rem 0.75rem; border-radius: 999px; font-size: 0.85rem; font-weight: 700; color: #fff; background: rgb(255 255 255 / 0.14); }
  .dh-ticket-no { font-size: 0.85rem; font-weight: 600; color: rgb(255 255 255 / 0.7); }
  .dh-ticket-body { display: flex; flex-direction: column; gap: 0.3rem; }
  .dh-ticket-ch { font-size: 0.9rem; font-weight: 700; color: #C4B0FF; }
  .dh-ticket-title { font-size: clamp(1.7rem, 3vw, 2.1rem); font-weight: 700; line-height: 1.4; }
  .dh[lang='en'] .dh-ticket-title { line-height: 1.2; letter-spacing: -0.015em; }
  .dh-ticket-blurb { font-size: 1rem; line-height: 1.75; color: rgb(255 255 255 / 0.74); }
  .dh-ticket-sample { display: flex; justify-content: center; gap: 1.6rem; margin-block: auto 0; padding: 1.1rem 1rem 0.9rem; border-radius: 18px; background: rgb(255 255 255 / 0.06); }
  .dh-w { display: flex; flex-direction: column; align-items: center; gap: 0.45rem; animation: dh-rise .7s var(--dh-ease) both; animation-delay: calc(0.35s + var(--i) * 0.25s); }
  .dh-w b { font-size: 2.2rem; font-weight: 700; line-height: 1.5; color: #fff; }
  .dh-w i { font-style: normal; padding: 0.12rem 0.65rem; border-radius: 999px; font-size: 0.82rem; font-weight: 700; color: #E3D9FF; background: rgb(124 77 255 / 0.38); }
  .dh-ticket-prog { display: flex; flex-direction: column; gap: 0.5rem; margin-top: auto; font-size: 0.92rem; font-weight: 600; color: rgb(255 255 255 / 0.8); }
  .dh-ticket-prog[hidden] { display: none; }
  .dh-ticket-bar { height: 6px; border-radius: 99px; background: rgb(255 255 255 / 0.14); overflow: hidden; }
  .dh-ticket-bar > span { display: block; height: 100%; width: var(--p, 0%); border-radius: inherit; background: #A88BFF; transition: width .9s var(--dh-ease); }
  .dh-ticket-go {
    align-self: flex-start; display: inline-flex; align-items: center; gap: 0.55rem; min-height: 2.6rem; padding: 0 1.1rem; border-radius: 999px;
    font-size: 0.95rem; font-weight: 700; color: #173847; background: #fff;
    transition: background-color .25s, color .25s;
  }
  .dh-ticket-go :global(svg) { width: 1rem; height: 1rem; transition: translate .35s var(--dh-ease); }
  @media (hover: hover) {
    .dh-ticket:hover { box-shadow: 0 36px 70px -30px rgb(23 56 71 / 0.85); }
    .dh-ticket:hover .dh-ticket-go { background: #C4B0FF; }
    .dh-ticket:hover .dh-ticket-go :global(svg) { translate: -4px 0; }
    .dh[dir='ltr'] .dh-ticket:hover .dh-ticket-go :global(svg) { translate: 4px 0; }
  }
  .dh-ticket:focus-visible { outline: 3px solid var(--iu-primary); outline-offset: 4px; }

  /* ── Body: outline + chapters ── */
  .dh-body { display: grid; gap: 2rem; margin-top: clamp(3rem, 7vw, 5rem); scroll-margin-top: 5.5rem; }
  @media (min-width: 1024px) { .dh-body { grid-template-columns: 16.5rem minmax(0, 1fr); gap: 2.5rem; align-items: start; } }
  .dh-aside { display: none; }
  @media (min-width: 1024px) { .dh-aside { display: flex; flex-direction: column; gap: 1rem; position: sticky; top: 5.75rem; } }
  .dh-outline-k { margin: 0 0 0.6rem; padding-inline: 0.75rem; font-size: 0.85rem; font-weight: 700; color: var(--iu-text-3); }
  .dh-outline ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .dh-outline a {
    position: relative; display: grid; grid-template-columns: 1.6rem 1fr auto; align-items: center; gap: 0.5rem;
    padding: 0.55rem 0.75rem; border-radius: 12px; text-decoration: none; color: var(--iu-text-2);
    font-size: 0.95rem; font-weight: 600; line-height: 1.5;
    transition: background-color .25s, color .25s;
  }
  .dh-outline a::before {
    content: ''; position: absolute; inset-block: 0.55rem; inset-inline-start: 0; width: 3px; border-radius: 99px;
    background: var(--acc); transform: scaleY(0); transition: transform .35s var(--dh-ease);
  }
  .dh-ol-no { font-size: 0.85rem; font-weight: 700; color: var(--acc-text); }
  .dh-ol-p { font-size: 0.78rem; font-weight: 700; color: var(--iu-text-3); font-variant-numeric: tabular-nums; }
  .dh-ol-p.is-full { color: var(--iu-success-text); }
  @media (hover: hover) { .dh-outline a:hover { background: var(--iu-card); color: var(--iu-text); } }
  .dh-outline a.is-on { background: var(--iu-card); color: var(--iu-text); box-shadow: 0 1px 3px rgb(23 56 71 / 0.08); }
  .dh-outline a.is-on::before { transform: scaleY(1); }
  .dh-outline a.is-dim { opacity: 0.4; }
  .dh-outline a:focus-visible { outline: 2px solid var(--iu-primary); outline-offset: 1px; }

  .dh-practice {
    position: relative; display: flex; flex-direction: column; gap: 0.25rem; padding: 1.1rem 1.15rem; border-radius: 18px;
    text-decoration: none; color: var(--iu-text); background: var(--iu-teal-soft);
    transition: transform .35s var(--dh-ease), box-shadow .35s var(--dh-ease);
  }
  .dh-practice-k { font-size: 0.8rem; font-weight: 700; color: var(--iu-teal-text); }
  .dh-practice-t { font-size: 1.05rem; font-weight: 700; }
  .dh-practice-b { font-size: 0.88rem; line-height: 1.65; color: var(--iu-text-2); padding-inline-end: 1.5rem; }
  .dh-practice-go { position: absolute; bottom: 1rem; inset-inline-end: 1rem; color: var(--iu-teal-text); }
  .dh-practice-go :global(svg) { width: 1.1rem; height: 1.1rem; transition: translate .35s var(--dh-ease); }
  @media (hover: hover) {
    .dh-practice:hover { transform: translateY(-2px); box-shadow: var(--iu-shadow-lift); }
    .dh-practice:hover .dh-practice-go :global(svg) { translate: -3px 0; }
    .dh[dir='ltr'] .dh-practice:hover .dh-practice-go :global(svg) { translate: 3px 0; }
  }

  /* Search */
  .dh-search {
    display: flex; align-items: center; gap: 0.4rem; height: 3.35rem; padding-inline: 1.1rem 0.45rem; border-radius: 999px;
    background: var(--iu-card); border: 1px solid var(--iu-border); box-shadow: var(--iu-shadow-card);
    transition: border-color .18s, box-shadow .18s;
  }
  .dh-search:focus-within { border-color: var(--iu-primary); box-shadow: 0 0 0 4px var(--iu-primary-wash), var(--iu-shadow-card); }
  .dh-search-ic { display: grid; color: var(--iu-text-3); }
  .dh-search-ic :global(svg) { width: 1.3rem; height: 1.3rem; }
  .dh-input { flex: 1; min-width: 0; height: 100%; border: 0; outline: 0; background: transparent; padding: 0 0.4rem; font: inherit; font-size: 1.05rem; color: var(--iu-text); }
  .dh-input::placeholder { color: var(--iu-text-3); opacity: .85; }
  .dh-input::-webkit-search-cancel-button { display: none; }
  .dh-clear { height: 2.4rem; padding: 0 1rem; border: 0; border-radius: 999px; cursor: pointer; font: inherit; font-size: 0.9rem; font-weight: 700; color: var(--iu-text-2); background: var(--iu-sunken); }
  .dh-clear:hover { color: var(--iu-primary-text); }
  .dh-clear:focus-visible { outline: 2px solid var(--iu-primary); outline-offset: 2px; }
  .dh-results { min-height: 1.25rem; margin: 0.7rem 0.4rem 0.4rem; font-size: 0.92rem; font-weight: 600; color: var(--iu-text-3); }
  .dh-empty { margin: 1rem 0; padding: 2rem; border-radius: 20px; text-align: center; font-size: 1rem; color: var(--iu-text-2); background: var(--iu-sunken); }

  /* Chapter cards */
  .dh-ch, .dh-outline a { --acc-text: color-mix(in srgb, var(--acc) 76%, var(--iu-text)); }
  .dh-ch {
    margin-top: 1.1rem; border-radius: 24px; overflow: hidden; scroll-margin-top: 5.75rem;
    background: var(--iu-card); border: 1px solid var(--iu-border); box-shadow: var(--iu-shadow-card);
  }
  .dh-ch.spot-card::after { background: radial-gradient(420px circle at var(--spot-x, 50%) var(--spot-y, 50%), color-mix(in srgb, var(--acc) 7%, transparent), transparent 65%); }
  .dh-ch[hidden] { display: none; }
  .dh-ch-head { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: start; gap: 0.35rem 1rem; padding: 1.35rem 1.4rem 1.2rem; border-bottom: 1px solid var(--iu-border); }
  @media (min-width: 640px) { .dh-ch-head { grid-template-columns: auto minmax(0, 1fr) auto; padding-inline: 1.6rem; } }
  .dh-ch-no {
    display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 15px;
    font-size: 1.25rem; font-weight: 700; color: var(--acc-text); background: color-mix(in srgb, var(--acc) 11%, transparent);
  }
  .dh-ch-text h2 { font-size: 1.32rem; font-weight: 700; line-height: 1.5; }
  .dh-ch-text p { margin: 0.15rem 0 0; font-size: 0.95rem; line-height: 1.7; color: var(--iu-text-3); }
  .dh-ch-meta { grid-column: 2; display: flex; align-items: center; gap: 0.6rem; }
  @media (min-width: 640px) { .dh-ch-meta { grid-column: auto; align-self: center; } }
  .dh-ch-count { padding: 0.22rem 0.7rem; border-radius: 999px; font-size: 0.82rem; font-weight: 700; color: var(--acc-text); background: color-mix(in srgb, var(--acc) 9%, transparent); white-space: nowrap; }
  .dh-ch-prog { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.82rem; font-weight: 700; color: var(--iu-text-2); white-space: nowrap; }
  .dh-ch-prog[hidden] { display: none; }
  .dh-mini { width: 4.5rem; height: 6px; border-radius: 99px; background: var(--iu-sunken); overflow: hidden; }
  .dh-mini > span { display: block; height: 100%; width: var(--p, 0%); border-radius: inherit; background: var(--acc); transition: width .9s var(--dh-ease); }
  .dh-ch.is-full .dh-ch-prog { color: var(--iu-success-text); }

  .dh-list { list-style: none; margin: 0; padding: 0.4rem; }
  .dh-list > li[hidden] { display: none; }
  .dh-row {
    position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 1rem;
    padding: 0.85rem 1rem; border-radius: 16px; text-decoration: none; color: inherit;
    transition: background-color .3s var(--dh-ease);
  }
  .dh-list > li + li .dh-row::after {
    content: ''; position: absolute; top: -1px; inset-inline: 4.1rem 1rem; height: 1px; background: var(--iu-border);
    transition: opacity .2s;
  }
  .dh-row-no {
    position: relative; display: grid; place-items: center; width: 2.35rem; height: 2.35rem; border-radius: 999px;
    border: 1.5px solid var(--iu-border-strong); font-size: 0.85rem; font-weight: 700; color: var(--iu-text-3);
    font-variant-numeric: tabular-nums;
    transition: border-color .3s, background-color .3s, color .3s, transform .45s cubic-bezier(.34, 1.56, .64, 1);
  }
  .dh-row-ok { position: absolute; inset: 0; display: grid; place-items: center; opacity: 0; transform: scale(.4); transition: opacity .3s, transform .45s cubic-bezier(.34, 1.56, .64, 1); }
  .dh-row-ok :global(svg) { width: 1.05rem; height: 1.05rem; }
  .dh-row-n { transition: opacity .2s; }
  .dh-row-text { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .dh-row-title { font-size: 1.08rem; font-weight: 700; line-height: 1.6; transition: color .25s; }
  .dh-row-blurb { font-size: 0.93rem; line-height: 1.65; color: var(--iu-text-3); }
  .dh-row-go { display: grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: 999px; color: var(--iu-text-3); transition: color .25s, background-color .25s; }
  .dh-row-go :global(svg) { width: 1.05rem; height: 1.05rem; transition: translate .4s var(--dh-ease); }
  .dh-row.is-off { opacity: 0.6; }

  @media (hover: hover) {
    a.dh-row:hover { background: color-mix(in srgb, var(--acc) 6%, var(--iu-card)); }
    a.dh-row:hover::after, li:has(> a.dh-row:hover) + li .dh-row::after { opacity: 0; }
    a.dh-row:hover .dh-row-no { border-color: var(--acc); color: var(--acc-text); transform: scale(1.08); }
    a.dh-row:hover .dh-row-title { color: var(--acc-text); }
    a.dh-row:hover .dh-row-go { color: #fff; background: var(--acc); }
    a.dh-row:hover .dh-row-go :global(svg) { translate: -2px 0; }
    .dh[dir='ltr'] a.dh-row:hover .dh-row-go :global(svg) { translate: 2px 0; }
  }
  a.dh-row:active { background: color-mix(in srgb, var(--acc) 10%, var(--iu-card)); }
  a.dh-row:focus-visible { outline: 2px solid var(--acc); outline-offset: -2px; }

  /* Finished lessons: the number becomes a check in the chapter's colour. */
  li.is-done .dh-row-no { border-color: var(--acc); background: var(--acc); color: #fff; }
  li.is-done .dh-row-n { opacity: 0; }
  li.is-done .dh-row-ok { opacity: 1; transform: scale(1); }
  @media (hover: hover) { li.is-done a.dh-row:hover .dh-row-no { color: #fff; } }

  /* ── Closing call ── */
  .dh-final {
    position: relative; overflow: hidden; isolation: isolate;
    margin: clamp(4rem, 9vw, 6rem) auto 0; max-width: 58rem;
    padding: clamp(2.5rem, 6vw, 3.5rem) clamp(1.5rem, 5vw, 3rem);
    border-radius: 28px; text-align: center; color: #fff; background-color: var(--color-purple-deep);
  }
  .dh-final::before {
    content: ''; position: absolute; inset: 0; z-index: -1; opacity: 0.55;
    background-image:
      repeating-linear-gradient(45deg, rgb(255 255 255 / 0.07) 0 1px, transparent 1px 30px),
      repeating-linear-gradient(135deg, rgb(255 255 255 / 0.07) 0 1px, transparent 1px 30px);
  }
  :global(.dark) .dh-final { background-color: #3B1E8F; }
  .dh-final-title { font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 700; line-height: 1.35; color: #fff; }
  .dh[lang='en'] .dh-final-title { letter-spacing: -0.02em; line-height: 1.15; }
  .dh-final-lead { max-width: 32rem; margin: 0.9rem auto 1.75rem; font-size: 1.08rem; line-height: 1.85; color: rgb(255 255 255 / 0.86); }
  .dh-final-ctas { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.75rem 1.5rem; }
  .dh-final-btn {
    display: inline-flex; align-items: center; gap: 0.6rem; min-height: 3.2rem; padding: 0 1.9rem; border-radius: 999px;
    font-weight: 700; font-size: 1.05rem; text-decoration: none; color: var(--color-purple-deep); background: #fff;
    box-shadow: 0 12px 30px -12px rgb(0 0 0 / 0.45);
    transition: transform .25s var(--dh-ease), box-shadow .25s var(--dh-ease);
  }
  .dh-final-btn :global(svg) { width: 1.1rem; height: 1.1rem; }
  .dh-final-btn:hover { transform: translateY(-2px); box-shadow: 0 18px 36px -14px rgb(0 0 0 / 0.5); }
  .dh-final-alt { font-weight: 700; color: #fff; text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  .dh-final-alt:hover { text-decoration-thickness: 2px; }

  @keyframes dh-rise { from { opacity: 0; translate: 0 10px; } to { opacity: 1; translate: 0 0; } }
  @media (prefers-reduced-motion: reduce) {
    .dh-w { animation: none; }
    .dh-btn, .dh-btn:hover, .dh-practice:hover, .dh-final-btn:hover { transform: none; }
    .dh-row-no, .dh-row-ok, .dh-mini > span, .dh-ticket-bar > span { transition: none; }
  }
</style>

<script>
  import { readProgress, fold } from '../../lib/duroos-progress';

  (() => {
    const root = document.querySelector<HTMLElement>('[data-dh]');
    const raw = root?.querySelector('[data-dh-index]')?.textContent;
    if (!root || !raw) return;
    type L = { s: string; t: string; b: string; n: number; c: number; h: string };
    const idx = JSON.parse(raw) as {
      l: L[]; c: string[];
      i18n: { lessonOf: string[]; doneOf: string[]; ofDone: string[][]; found: string[]; continueChip: string; nextChip: string; resume: string; finished: string };
    };
    const t = idx.i18n;

    // ── Progress ────────────────────────────────────────────────────────
    const p = readProgress();
    const done = new Set(p.done.filter((sl) => idx.l.some((l) => l.s === sl)));

    root.querySelectorAll<HTMLElement>('li[data-row]').forEach((li) => {
      if (!done.has(li.dataset.slug || '')) return;
      li.classList.add('is-done');
      const sr = li.querySelector('[data-row-sr]');
      if (sr) sr.textContent = ` (${t.finished})`;
    });

    root.querySelectorAll<HTMLElement>('.dh-ch').forEach((ch) => {
      const c = Number(ch.dataset.ch);
      const rows = [...ch.querySelectorAll<HTMLElement>('li[data-row]')];
      const d = rows.filter((r) => r.classList.contains('is-done')).length;
      const ol = root.querySelector<HTMLElement>(`[data-ol="${c}"] [data-ol-p]`);
      if (!d) return;
      const prog = ch.querySelector<HTMLElement>('[data-ch-prog]');
      ch.querySelector<HTMLElement>('[data-ch-count]')?.setAttribute('hidden', '');
      if (prog) {
        prog.hidden = false;
        prog.querySelector<HTMLElement>('[data-ch-label]')!.textContent = d === rows.length ? t.finished : t.ofDone[c - 1][d];
        requestAnimationFrame(() => prog.querySelector<HTMLElement>('[data-ch-bar]')?.style.setProperty('--p', `${(d / rows.length) * 100}%`));
      }
      if (d === rows.length) ch.classList.add('is-full');
      if (ol) {
        ol.textContent = d === rows.length ? t.finished : t.ofDone[c - 1][d];
        ol.classList.toggle('is-full', d === rows.length);
      }
    });

    // The hero card: resume the last lesson, or offer the next unread one.
    const at = p.last ? idx.l.findIndex((l) => l.s === p.last!.slug) : -1;
    if (at >= 0) {
      let pick = idx.l[at];
      let chip = t.continueChip;
      if (done.has(pick.s)) {
        const nextUnread = idx.l.slice(at + 1).find((l) => !done.has(l.s)) ?? idx.l.find((l) => !done.has(l.s));
        if (nextUnread) { pick = nextUnread; chip = t.nextChip; }
      }
      const card = root.querySelector<HTMLAnchorElement>('[data-dh-ticket]');
      const cta = root.querySelector<HTMLAnchorElement>('[data-dh-cta]');
      if (card) {
        card.href = pick.h;
        const set = (sel: string, v: string) => { const el = card.querySelector(sel); if (el) el.textContent = v; };
        set('[data-t-chip]', chip);
        set('[data-t-no]', t.lessonOf[pick.n - 1]);
        set('[data-t-ch]', idx.c[pick.c - 1]);
        set('[data-t-title]', pick.t);
        set('[data-t-blurb]', pick.b);
        card.querySelector<HTMLElement>('[data-t-sample]')?.setAttribute('hidden', '');
        const prog = card.querySelector<HTMLElement>('[data-t-prog]');
        if (prog) {
          prog.hidden = false;
          prog.querySelector('[data-t-prog-label]')!.textContent = t.doneOf[done.size];
          requestAnimationFrame(() => prog.querySelector<HTMLElement>('[data-t-bar]')?.style.setProperty('--p', `${(done.size / idx.l.length) * 100}%`));
        }
      }
      if (cta) {
        cta.href = pick.h;
        const label = cta.querySelector('[data-dh-cta-label]');
        if (label) label.textContent = t.resume;
      }
    }

    // ── Outline follows the scroll ─────────────────────────────────────
    const links = new Map<string, HTMLElement>();
    root.querySelectorAll<HTMLElement>('[data-ol]').forEach((a) => links.set(`ch-${a.dataset.ol}`, a));
    const visible = new Map<string, number>();
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => visible.set(e.target.id, e.isIntersecting ? e.intersectionRatio : 0));
      let best = ''; let top = Infinity;
      root.querySelectorAll<HTMLElement>('.dh-ch:not([hidden])').forEach((ch) => {
        if ((visible.get(ch.id) ?? 0) > 0) {
          const y = ch.getBoundingClientRect().top;
          if (y < top) { top = y; best = ch.id; }
        }
      });
      links.forEach((a, id) => a.classList.toggle('is-on', id === best));
    }, { rootMargin: '-90px 0px -45% 0px', threshold: [0, 0.01, 0.25, 0.5] });
    root.querySelectorAll('.dh-ch').forEach((ch) => io.observe(ch));

    // ── Search ──────────────────────────────────────────────────────────
    const input = root.querySelector<HTMLInputElement>('[data-dh-q]');
    const clear = root.querySelector<HTMLButtonElement>('[data-dh-clear]');
    const results = root.querySelector<HTMLElement>('[data-dh-results]');
    const empty = root.querySelector<HTMLElement>('[data-dh-empty]');
    const rows = [...root.querySelectorAll<HTMLElement>('li[data-row]')];
    const run = () => {
      const q = fold(input?.value || '');
      let shown = 0;
      rows.forEach((r) => {
        const hit = !q || (r.dataset.q || '').includes(q);
        r.hidden = !hit;
        if (hit) shown++;
      });
      root.querySelectorAll<HTMLElement>('.dh-ch').forEach((ch) => {
        const any = !!ch.querySelector('li[data-row]:not([hidden])');
        ch.hidden = !any;
        links.get(ch.id)?.classList.toggle('is-dim', !any);
      });
      if (clear) clear.hidden = !q;
      if (empty) empty.hidden = !q || shown > 0;
      if (results) results.textContent = q && shown ? t.found[shown] : '';
    };
    input?.addEventListener('input', run);
    clear?.addEventListener('click', () => { if (input) { input.value = ''; run(); input.focus(); } });
    input?.addEventListener('keydown', (e) => { if (e.key === 'Escape' && input.value) { input.value = ''; run(); } });
  })();
</script>
