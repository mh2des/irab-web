---
/**
 * LessonObjective: what the learner will be able to do by the end, stated
 * before any explanation, so the lesson opens with a purpose rather than a
 * definition. Each objective carries a small check in the chapter colour.
 */
interface Props {
  items: string[];
}
const { items } = Astro.props;
---
<div class="obj">
  <p class="obj-k">By the end of this lesson</p>
  <ul class="obj-list">
    {items.map((i) => <li><span class="obj-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg></span><span>{i}</span></li>)}
  </ul>
</div>

<style is:global>
  .ls .obj {
    margin: 1.6rem 0 0; padding: 1.3rem 1.4rem; border-radius: 22px;
    background: var(--iu-card); border: 1px solid var(--iu-border);
  }
  .ls .obj-k { margin: 0 0 0.8rem; font-size: 0.85rem; font-weight: 700; color: var(--acc-text); }
  .ls .obj-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .ls .obj-list li { display: flex; align-items: flex-start; gap: 0.75rem; font-size: 1.04rem; line-height: 1.75; color: var(--iu-text); }
  .ls .obj-ic { flex: none; display: grid; place-items: center; width: 1.45rem; height: 1.45rem; margin-top: 0.15rem; border-radius: 99px; color: var(--acc-text); background: var(--acc-soft); }
  .ls .obj-ic svg { width: 0.85rem; height: 0.85rem; }
</style>
