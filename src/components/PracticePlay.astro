      gateBody: 'Pick a ready-made sentence or write your own, then parse it and get corrected.',
      signIn: 'Sign in',
      chooseTitle: 'How do you want to practice?',
      chooseBody: 'Start with the strongest feature: write your i\'rab, then get AI feedback.',
      curatedTitle: 'Ready-made sentences',
      curatedBody: 'Pick a sentence from the bank, then set each word\'s type, role, and case.',
      curatedTag: 'Second option',
      curatedFeats: ['576 ready sentences', 'Guided practice'],
      customTitle: 'Write your own',
      customBody: 'Enter any sentence, type your i\'rab, and let AI grade and explain it.',
      customTag: 'Golden feature',
      customFeats: ['AI feedback', 'Any sentence you write'],
      start: 'Start',
      back: 'Back',
      chooseSentence: 'Choose a sentence',
      chooseSentenceBody: 'Choose an exercise from this chapter, then begin parsing its words.',
      chooseChapter: 'Choose a grammar chapter',
      challengeEyebrow: 'Challenge path',
      challengeBody: 'Structured chapters, selected sentences, and focused practice one step at a time.',
      plusRequired: 'Irab Plus exclusive',
      chapter: 'Chapter',
      openChapter: 'Open chapter',
      appliedExercises: 'Applied exercises',
      sentenceCount: (n: number) => `${n} sentences`,
      startChallenge: 'Start challenge',
      stepChapter: 'Choose chapter',
      stepSentence: 'Choose sentence',
      stepAnswer: 'Parse the words',
      customIntroEyebrow: 'Practice',
      customIntroTitleLead: 'How does ',
      customIntroTitleAccent: 'Practice work?',
      customIntroBody: "Enter a sentence, write your i'rab for each word, then receive an instant score and intelligent correction.",
      loadingBank: 'Loading the sentence bank…',
      noTopics: 'Couldn\'t load sentences right now. Please retry.',
      noSentences: 'No sentences in this topic.',
      level: 'Level',
      words: 'words',
      answerTitle: 'Set the i\'rab for each word',
      sentenceLabel: 'Challenge sentence',
      solveInstruction: 'Complete the type, role, and marker for every word, then submit your answers for correction.',
      progressLabel: 'Challenge progress',
      wordLabel: 'Word',
      incompleteWord: 'Waiting for answer',
      completeWord: 'Complete',
      type: 'Type', role: 'Role', caseMarker: 'Marker', select: 'Select',
      answered: (a: number, n: number) => `${a} of ${n}`,
      check: 'Check answers',
      completeAll: 'Complete every word\'s choices first.',
