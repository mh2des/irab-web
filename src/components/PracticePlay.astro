const gateTitle = mode === 'curated'
  ? (lang === 'ar' ? 'سجّل الدخول لتبدأ التحديات' : 'Sign in to start a challenge')
  : t.gateTitle;
const gateBody = mode === 'curated'
  ? (lang === 'ar' ? 'اختر جملة جاهزة، ثم حدّد نوع كل كلمة وموقعها وعلامتها.' : "Choose a ready-made sentence, then set each word's type, role, and case marker.")
  : mode === 'custom'
    ? (lang === 'ar' ? 'اكتب جملتك وإعرابك بنفسك، ثم احصل على تصحيح ذكي لكل كلمة.' : "Write your sentence and i'rab, then get intelligent feedback on every word.")
    : t.gateBody;
const againLabel = mode === 'curated'
  ? (lang === 'ar' ? 'تحدٍّ آخر' : 'Another challenge')
  : t.again;
---
<div data-practice-root data-lang={lang} data-login={login} data-practice-mode={mode} dir={dir} class="pr-shell">
  {mode === 'custom' && (
    <section class="pr-feature-intro" aria-labelledby="practice-intro-title">
      <p class="eyebrow mb-4">{t.customIntroEyebrow}</p>
      {/* Deliberately NOT titleClass (Aref Ruqaa): this is a full phrase with
          punctuation, which the font-arabic-display usage rule in global.css
          keeps off Ruqaa. Same treatment as the /tool and majalis heroes. */}
      <h1 id="practice-intro-title" class="font-arabic font-bold text-[clamp(2rem,5vw,3.4rem)] leading-[1.25] tracking-tight">
        {t.customIntroTitleLead}<span class="text-purple">{t.customIntroTitleAccent}</span>
      </h1>
      <p class="mt-6 font-arabic text-body md:text-body-lg text-ink-muted dark:text-mist-muted leading-loose max-w-2xl">{t.customIntroBody}</p>
    </section>
  )}

  {/* Loading */}
  <div data-pr-loading aria-busy="true" class="space-y-4">
    <div class="skeleton h-40 rounded-2xl"></div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4"><div class="skeleton h-52 rounded-2xl"></div><div class="skeleton h-52 rounded-2xl"></div></div>
  </div>

  {/* Gate */}
  <div data-pr-gate class="hidden card panel-in p-8 md:p-12 text-center">
    <div class="pr-gate-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15v2"/><path d="M7 10V8a5 5 0 0 1 10 0v2"/><rect x="5" y="10" width="14" height="10" rx="2"/></svg>
    </div>
    <h2 class:list={[titleClass, 'text-h2 leading-tight mb-3']}>{gateTitle}</h2>
    <p class="text-body text-ink/75 dark:text-mist/75 mb-7 max-w-md mx-auto">{gateBody}</p>
    <a href={login} class="btn-primary btn-lg">{t.signIn}</a>
  </div>

  {/* Tool */}
  <div data-pr-tool class="hidden">
    <div class="pr-toolbar">
      <button type="button" data-pr-mute class="pr-mute" aria-label={t.sound} aria-pressed="false">
        <svg class="ic-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M19 5a9 9 0 0 1 0 14"/></svg>
        <svg class="ic-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M22 9l-6 6"/><path d="M16 9l6 6"/></svg>
      </button>
    </div>
    {/* Quota pill (premium only) */}
    <p data-pr-quota class="pr-quota"></p>

    <Paywall lang={lang} />

    {/* ── Phase: mode chooser ───────────────────────────────── */}
    <section data-phase="choose" class="pr-phase">
      <div class="text-center max-w-xl mx-auto mb-8">
        <h1 class:list={[titleClass, 'text-h1 leading-tight']}>{t.chooseTitle}</h1>
        <p class="text-body text-ink/70 dark:text-mist/70 mt-3">{t.chooseBody}</p>
      </div>
      <div class="pr-modes">
        <button type="button" data-go="custom" class="pr-mode pr-mode-purple pr-mode-featured">
          <span class="pr-mode-ribbon">{t.customTag}</span>
          <span class="pr-mode-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg></span>
          <span class:list={[titleClass, 'pr-mode-title']}>{t.customTitle}</span>
          <span class="pr-mode-body">{t.customBody}</span>
          <span class="pr-mode-feats">
            {t.customFeats.map((f) => (
              <span class="pr-mode-feat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{f}</span>
            ))}
          </span>
          <span class="pr-mode-cta">{t.start}<span class="pr-mode-arrow" aria-hidden="true">{lang === 'ar' ? '←' : '→'}</span></span>
        </button>
        <button type="button" data-go="curated" class="pr-mode pr-mode-teal">
          <span class="pr-mode-tag">{t.curatedTag}</span>
          <span class="pr-mode-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><path d="M9 7h7"/><path d="M9 11h5"/></svg></span>
          <span class:list={[titleClass, 'pr-mode-title']}>{t.curatedTitle}</span>
          <span class="pr-mode-body">{t.curatedBody}</span>
          <span class="pr-mode-feats">
            {t.curatedFeats.map((f) => (
              <span class="pr-mode-feat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>{f}</span>
            ))}
          </span>
          <span class="pr-mode-cta">{t.start}<span class="pr-mode-arrow" aria-hidden="true">{lang === 'ar' ? '←' : '→'}</span></span>
        </button>
      </div>
    </section>

    {/* ── Phase: curated chapter library ────────────────────── */}
    <section data-phase="browse" class="pr-phase hidden">
      <div class="pr-challenge-hero">
        <div class="pr-journey" aria-label={t.stepChapter}>
          <span class="is-active">1</span><i></i><span>2</span><i></i><span>3</span>
        </div>
        <p class="pr-kicker">{t.challengeEyebrow}</p>
        <h1 class:list={[titleClass, 'pr-challenge-title']}>{t.chooseChapter}</h1>
        <p class="pr-challenge-body">{t.challengeBody}</p>
      </div>
      <p data-bank-loading class="pr-hint text-center py-6">{t.loadingBank}</p>
      <p data-bank-error class="hidden pr-hint text-center py-6">{t.noTopics}</p>
      <div data-topic-grid class="pr-chapters"></div>
    </section>

    {/* ── Phase: sentence selection inside one chapter ─────── */}
    <section data-phase="sentences" class="pr-phase hidden">
      <div class="pr-head pr-head-between">
        <div class="pr-head-main">
          <button type="button" data-back="browse" class="icon-btn" aria-label={t.back}><svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={back}/></svg></button>
          <div class="min-w-0">
            <p class="pr-kicker" data-sentence-chapter></p>
            <h2 class:list={[titleClass, 'text-h2 leading-tight']} data-sentence-topic></h2>
          </div>
        </div>
        <div class="pr-journey pr-journey-compact" aria-label={t.stepSentence}>
          <span class="is-done">✓</span><i class="is-done"></i><span class="is-active">2</span><i></i><span>3</span>
        </div>
      </div>
      <div class="pr-sentence-intro">
        <p>{t.chooseSentenceBody}</p>
        <span data-sentence-count></span>
      </div>
      <div data-sentence-list class="pr-sentences"></div>
    </section>

    {/* ── Phase: curated solve ──────────────────────────────── */}
    <section data-phase="solve" class="pr-phase hidden">
      <div class="pr-head">
        <button type="button" data-back="sentences" class="icon-btn" aria-label={t.back}><svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={back}/></svg></button>
        <div class="min-w-0">
          <p class="pr-kicker" data-solve-topic></p>
          <h2 class:list={[titleClass, 'text-h2 leading-tight']}>{t.answerTitle}</h2>
        </div>
        <div class="pr-journey pr-journey-compact pr-journey-end" aria-label={t.stepAnswer}>
          <span class="is-done">✓</span><i class="is-done"></i><span class="is-done">✓</span><i class="is-done"></i><span class="is-active">3</span>
        </div>
      </div>
      <div class="pr-solve-context">
        <div class="pr-solve-context-top">
          <span class="pr-solve-label">{t.sentenceLabel}</span>
          <span data-solve-word-count class="pr-solve-word-count"></span>
        </div>
        <p data-solve-sentence class="pr-sentence-show pr-solve-sentence" lang="ar" dir="rtl"></p>
        <p class="pr-solve-instruction">{t.solveInstruction}</p>
      </div>
      <div class="pr-solve-progress-head">
        <span>{t.progressLabel}</span>
        <strong data-solve-percent>0%</strong>
      </div>
      <div class="pr-progressbar pr-solve-progressbar" aria-hidden="true"><span data-solve-bar></span></div>
      <div data-solve-words class="pr-question-list"></div>
      <div data-solve-dock class="pr-solve-dock">
        <div class="pr-solve-dock-copy">
          <span>{t.progressLabel}</span>
          <strong data-solve-progress class="pr-progress" aria-live="polite"></strong>
        </div>
        <button type="button" data-solve-check class="btn-primary pr-solve-submit" disabled>
          <span data-solve-check-label>{t.check}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>
        </button>
      </div>
      <p data-solve-msg class="hidden pr-msg"></p>
    </section>

    {/* ── Phase: custom write + solve ───────────────────────── */}
    <section data-phase="custom" class="pr-phase hidden">
      <div class="pr-head">
        <button type="button" data-back="choose" class="icon-btn" aria-label={t.back}><svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={back}/></svg></button>
        <h2 class:list={[titleClass, 'text-h2 leading-tight']}>{t.writeTitle}</h2>
      </div>
      {/* write step */}
      <div data-custom-write>
        <textarea data-custom-input rows="3" dir="rtl" maxlength="500" placeholder={t.sentencePlaceholder} class="input pr-textarea"></textarea>
        {/* Empty-state suggestions: tap a curated sentence to fill the textarea. */}
        <div class="mt-3">
          <p class="text-small font-semibold text-ink-subtle dark:text-mist-subtle mb-2">{t.trySentence}</p>
          <div class="flex flex-wrap gap-2">
            {EXAMPLES.map((ex) => (
              <button type="button" class="ex-chip" data-practice-example={ex.id} lang="ar" dir="rtl">{ex.source}</button>
            ))}
          </div>
        </div>
        <p class="pr-hint mt-3 mb-4">{t.splitHint}</p>
        <button type="button" data-custom-split class="btn-primary btn-block">{t.split}</button>
      </div>
      {/* solve step */}
      <div data-custom-solve class="hidden">
        <p data-custom-sentence class="pr-sentence-show" lang="ar" dir="rtl"></p>
        <div data-custom-words class="space-y-3"></div>
        <button type="button" data-custom-grade class="btn-primary btn-block mt-2"><span data-custom-grade-label>{t.gradeCustom}</span></button>
        <p data-custom-msg class="hidden pr-msg"></p>
      </div>
    </section>

    {/* ── Phase: results (shared) ───────────────────────────── */}
    <section data-phase="results" class="pr-phase hidden">
      <div data-results-overall></div>
      <div data-results-words class="space-y-3 mt-5"></div>
      {/* Share sits at the END of the results, not under the input. */}
      <div class="pr-share-row">
        <button type="button" data-result-share class="pr-share-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
          <span data-result-share-label>{t.shareResult}</span>
        </button>
        <button type="button" data-result-copy class="pr-share-btn pr-share-ghost">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          <span data-result-copy-label>{t.copyResult}</span>
        </button>
      </div>
      <button type="button" data-again class="btn-ghost btn-block mt-4">{againLabel}</button>
    </section>
  </div>
</div>

<style is:global>
  /* Global (not scoped): the chips, sentence cards, word cards, selects and
     results are injected via JS, so scoped styles would never reach them. All
  selectors are pr-* prefixed to avoid leaking into other components. */
  .pr-shell { width: 100%; max-width: 60rem; margin-inline: auto; }
  /* Was a gradient pill card with an icon; now the page's hero, styled by the
     same utilities as the /tool and majalis heroes so all three read as one
     system. Only the spacing below it lives here. */
  .pr-feature-intro { margin-bottom: 2.5rem; color: var(--color-ink); }
  .dark .pr-feature-intro { color: var(--color-mist); }
  .pr-gate-icon { width: 4rem; height: 4rem; border-radius: 1.1rem; margin: 0 auto 1.25rem; display: grid; place-items: center; color: var(--color-purple-deep); background: color-mix(in srgb, var(--color-purple) 12%, white); border: 1px solid color-mix(in srgb, var(--color-purple) 26%, var(--color-card-edge)); }
  .dark .pr-gate-icon { background: color-mix(in srgb, var(--color-purple) 22%, var(--color-coal-soft)); }
  .pr-gate-icon svg { width: 1.9rem; height: 1.9rem; }

  .pr-quota { text-align: center; font-weight: 800; color: var(--color-teal); font-size: var(--text-caption); margin-bottom: 1.25rem; }
  .pr-quota:empty { display: none; }

  /* Fixed routes begin at their own feature and never return to the old mode chooser. */
  [data-practice-mode="custom"] [data-phase="custom"] > .pr-head > .icon-btn { display: none; }

  /* Phase transition */
  .pr-phase { animation: pr-in .34s var(--ease-out-quart) both; }
  @keyframes pr-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

  /* Mode chooser */
  .pr-modes { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; align-items: stretch; }
  .pr-mode {
    --accent: var(--color-teal); --accent-deep: var(--color-teal-deep);
    position: relative; overflow: hidden; text-align: start; display: flex; flex-direction: column; gap: 0.55rem;
    padding: clamp(1.5rem, 3vw, 2.1rem); border-radius: 1.5rem;
    background: var(--color-card); border: 1px solid var(--color-card-edge); box-shadow: var(--shadow-card);
    transition: transform .22s var(--ease-out-quart), box-shadow .22s, border-color .22s;
  }
  .dark .pr-mode { background: var(--color-coal-soft); border-color: var(--color-coal-edge); }
  /* Top accent bar */
  .pr-mode::before {
    content: ""; position: absolute; inset: 0 0 auto 0; height: 0.32rem;
    background: linear-gradient(90deg, var(--accent), var(--accent-deep));
    opacity: 0.9;
  }
  .pr-mode:hover { transform: translateY(-5px); box-shadow: var(--shadow-lift); border-color: color-mix(in srgb, var(--accent) 50%, var(--color-card-edge)); }
  .pr-mode-purple { --accent: var(--color-purple); --accent-deep: var(--color-purple-deep); }
  .pr-mode-teal { --accent: var(--color-teal); --accent-deep: var(--color-teal-deep); }
  /* Featured (golden) card: a faint accent wash so it leads the eye */
  .pr-mode-featured {
    border-color: color-mix(in srgb, var(--accent) 42%, var(--color-card-edge));
    background:
      radial-gradient(120% 80% at 100% 0%, color-mix(in srgb, var(--accent) 10%, transparent) 0%, transparent 52%),
      var(--color-card);
  }
  .dark .pr-mode-featured {
    background:
      radial-gradient(120% 80% at 100% 0%, color-mix(in srgb, var(--accent) 20%, transparent) 0%, transparent 52%),
      var(--color-coal-soft);
  }
  /* Ribbon on the featured card */
  .pr-mode-ribbon {
    position: absolute; inset-block-start: 1.15rem; inset-inline-end: 1.15rem;
    padding: 0.28rem 0.7rem; border-radius: 999px; font-size: 0.78rem; font-weight: 800;
    color: #fff; background: linear-gradient(120deg, var(--accent), var(--accent-deep));
    box-shadow: 0 6px 16px -6px var(--accent);
  }
  .pr-mode-ic {
    width: 3.6rem; height: 3.6rem; border-radius: 1.1rem; display: grid; place-items: center; margin-bottom: 0.5rem;
    color: #fff; background: linear-gradient(135deg, var(--accent), var(--accent-deep));
    box-shadow: 0 12px 24px -12px var(--accent);
    transition: transform .22s var(--ease-out-quart);
  }
  .pr-mode:hover .pr-mode-ic { transform: scale(1.06) rotate(-3deg); }
  .pr-mode-ic svg { width: 1.8rem; height: 1.8rem; }
  .pr-mode-tag { font-family: var(--font-mono); font-size: 0.85rem; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; color: var(--accent-deep); }
  .dark .pr-mode-tag { color: color-mix(in srgb, var(--accent) 82%, white); }
  .pr-mode-title { font-size: clamp(1.55rem, 3vw, 1.9rem); line-height: 1.18; color: var(--color-ink); }
  .dark .pr-mode-title { color: var(--color-mist); }
  .pr-mode-body { color: color-mix(in srgb, var(--color-ink) 68%, transparent); font-size: var(--text-caption); line-height: 1.65; }
  .dark .pr-mode-body { color: color-mix(in srgb, var(--color-mist) 70%, transparent); }
  .pr-mode-feats { display: flex; flex-direction: column; gap: 0.4rem; margin-top: 0.5rem; }
  .pr-mode-feat { display: flex; align-items: center; gap: 0.45rem; font-size: 0.92rem; font-weight: 600; color: color-mix(in srgb, var(--color-ink) 74%, transparent); }
  .dark .pr-mode-feat { color: color-mix(in srgb, var(--color-mist) 76%, transparent); }
  .pr-mode-feat svg { width: 1rem; height: 1rem; flex: none; padding: 0.13rem; border-radius: 50%; color: #fff; background: var(--accent); }
  .pr-mode-cta { margin-top: auto; padding-top: 0.85rem; display: inline-flex; gap: 0.45rem; align-items: center; font-weight: 800; font-size: 1.05rem; color: var(--accent-deep); }
  .dark .pr-mode-cta { color: color-mix(in srgb, var(--accent) 84%, white); }
  .pr-mode-arrow { display: inline-block; transition: transform .2s var(--ease-out-quart); }
  .pr-mode:hover .pr-mode-arrow { transform: translateX(-0.3rem); }
  :root[dir="ltr"] .pr-mode:hover .pr-mode-arrow { transform: translateX(0.3rem); }

  /* Phase head */
  .pr-head { display: flex; align-items: center; gap: 0.9rem; margin-bottom: 1.4rem; }
  .pr-head-between { justify-content: space-between; }
  .pr-head-main { display: flex; align-items: center; gap: 0.9rem; min-width: 0; }
  .pr-kicker { font-weight: 800; font-size: var(--text-caption); color: var(--color-teal); }
  .pr-hint { color: color-mix(in srgb, var(--color-ink) 62%, transparent); font-size: var(--text-caption); }
  .dark .pr-hint { color: color-mix(in srgb, var(--color-mist) 66%, transparent); }

  /* Challenges: a clear chapter → sentence → answer journey. */
  .pr-challenge-hero { position: relative; overflow: hidden; margin-bottom: 1.5rem; padding: clamp(1.4rem, 4vw, 2.1rem); border-radius: 1.35rem; color: var(--color-ink); background: radial-gradient(90% 120% at 100% 0%, color-mix(in srgb, var(--color-teal) 15%, transparent), transparent 58%), var(--color-card); border: 1px solid color-mix(in srgb, var(--color-teal) 28%, var(--color-card-edge)); box-shadow: var(--shadow-card); }
  .dark .pr-challenge-hero { color: var(--color-mist); background: radial-gradient(90% 120% at 100% 0%, color-mix(in srgb, var(--color-teal) 20%, transparent), transparent 58%), var(--color-coal-soft); border-color: color-mix(in srgb, var(--color-teal) 30%, var(--color-coal-edge)); }
  .pr-challenge-title { max-width: 42rem; margin-top: 0.35rem; font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1.08; }
  .pr-challenge-body { max-width: 38rem; margin-top: 0.65rem; font-size: var(--text-small); line-height: 1.7; color: color-mix(in srgb, var(--color-ink) 68%, transparent); }
  .dark .pr-challenge-body { color: color-mix(in srgb, var(--color-mist) 72%, transparent); }

  .pr-journey { display: flex; align-items: center; width: min(100%, 15rem); margin-bottom: 1.2rem; direction: ltr; }
  .pr-journey span { width: 1.85rem; height: 1.85rem; flex: none; display: grid; place-items: center; border-radius: 999px; font-family: var(--font-mono); font-size: 0.78rem; font-weight: 800; color: color-mix(in srgb, var(--color-ink) 45%, transparent); background: color-mix(in srgb, var(--color-ink) 7%, transparent); border: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent); }
  .dark .pr-journey span { color: color-mix(in srgb, var(--color-mist) 52%, transparent); background: color-mix(in srgb, var(--color-mist) 9%, transparent); border-color: color-mix(in srgb, var(--color-mist) 12%, transparent); }
  .pr-journey i { height: 2px; flex: 1; background: color-mix(in srgb, var(--color-ink) 11%, transparent); }
  .dark .pr-journey i { background: color-mix(in srgb, var(--color-mist) 14%, transparent); }
  .pr-journey span.is-active { color: #fff; background: var(--color-teal); border-color: var(--color-teal); box-shadow: 0 7px 16px -8px var(--color-teal); }
  .pr-journey span.is-done { color: #fff; background: var(--color-purple); border-color: var(--color-purple); }
  .pr-journey i.is-done { background: var(--color-purple); }
  .pr-journey-compact { width: 9rem; margin: 0; }
  .pr-journey-compact span { width: 1.55rem; height: 1.55rem; font-size: 0.68rem; }
  .pr-journey-end { margin-inline-start: auto; }

  .pr-chapters { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem; }
  .pr-chapter { --chapter-accent: var(--color-teal); position: relative; overflow: hidden; min-height: 12rem; display: flex; flex-direction: column; align-items: stretch; text-align: start; padding: 1.25rem; border-radius: 1.15rem; color: var(--color-ink); background: var(--color-card); border: 1px solid var(--color-card-edge); box-shadow: var(--shadow-card); transition: transform .22s var(--ease-out-quart), box-shadow .22s, border-color .22s; }
  .dark .pr-chapter { color: var(--color-mist); background: var(--color-coal-soft); border-color: var(--color-coal-edge); }
  .pr-chapter::after { content: ""; position: absolute; inset-inline-end: -2rem; inset-block-end: -3.5rem; width: 8.5rem; height: 8.5rem; border-radius: 50%; background: color-mix(in srgb, var(--chapter-accent) 9%, transparent); transition: transform .3s var(--ease-out-quart); }
  .pr-chapter:nth-child(3n + 2) { --chapter-accent: var(--color-purple); }
  .pr-chapter:nth-child(3n) { --chapter-accent: var(--color-teal-deep); }
  .pr-chapter:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--chapter-accent) 45%, var(--color-card-edge)); box-shadow: var(--shadow-lift); }
  .pr-chapter:hover::after { transform: scale(1.16); }
  .pr-chapter.is-locked { --chapter-accent: var(--color-purple); border-color: color-mix(in srgb, var(--color-purple) 22%, var(--color-card-edge)); background: linear-gradient(135deg, color-mix(in srgb, var(--color-purple) 4%, white), var(--color-card)); }
  .dark .pr-chapter.is-locked { border-color: color-mix(in srgb, var(--color-purple) 26%, var(--color-coal-edge)); background: linear-gradient(135deg, color-mix(in srgb, var(--color-purple) 7%, var(--color-coal-soft)), var(--color-coal-soft)); }
  .pr-chapter.is-locked:hover { border-color: color-mix(in srgb, var(--color-purple) 48%, var(--color-card-edge)); }
  .pr-chapter-top { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }
  .pr-chapter-num { width: 2.65rem; height: 2.65rem; display: grid; place-items: center; border-radius: 0.8rem; color: #fff; background: var(--chapter-accent); font-family: var(--font-mono); font-size: 0.88rem; font-weight: 800; box-shadow: 0 10px 20px -13px var(--chapter-accent); }
  .pr-chapter-level { padding: 0.28rem 0.65rem; border-radius: 999px; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 800; color: color-mix(in srgb, var(--color-ink) 58%, transparent); background: color-mix(in srgb, var(--color-ink) 6%, transparent); }
  .pr-chapter-level svg { width: 0.78rem; height: 0.78rem; display: inline-block; margin-inline-end: 0.28rem; vertical-align: -0.08rem; }
  .pr-chapter.is-locked .pr-chapter-level { color: var(--color-purple-deep); background: color-mix(in srgb, var(--color-purple) 10%, transparent); }
  .dark .pr-chapter-level { color: color-mix(in srgb, var(--color-mist) 64%, transparent); background: color-mix(in srgb, var(--color-mist) 9%, transparent); }
  .dark .pr-chapter.is-locked .pr-chapter-level { color: color-mix(in srgb, var(--color-purple) 86%, white); background: color-mix(in srgb, var(--color-purple) 15%, transparent); }
  .pr-chapter-title { position: relative; z-index: 1; margin-top: 1rem; font-family: var(--font-arabic-display); font-size: clamp(1.35rem, 3vw, 1.75rem); font-weight: 700; line-height: 1.35; }
  [dir="ltr"] .pr-chapter-title { font-family: var(--font-display); }
  .pr-chapter-meta { position: relative; z-index: 1; margin-top: 0.3rem; font-size: var(--text-caption); color: color-mix(in srgb, var(--color-ink) 60%, transparent); }
  .dark .pr-chapter-meta { color: color-mix(in srgb, var(--color-mist) 64%, transparent); }
  .pr-chapter-cta { position: relative; z-index: 1; margin-top: auto; padding-top: 1rem; display: flex; align-items: center; justify-content: space-between; gap: 0.7rem; font-size: var(--text-caption); font-weight: 800; color: var(--chapter-accent); }
  .pr-chapter-cta svg { width: 1rem; height: 1rem; transition: transform .2s; }
  .pr-chapter:hover .pr-chapter-cta svg { transform: translateX(-0.2rem); }
  [dir="ltr"] .pr-chapter:hover .pr-chapter-cta svg { transform: translateX(0.2rem); }

  .pr-sentence-intro { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; padding: 0.9rem 1rem; border-radius: 0.85rem; background: color-mix(in srgb, var(--color-teal) 8%, transparent); border: 1px solid color-mix(in srgb, var(--color-teal) 20%, transparent); }
  .pr-sentence-intro p { font-size: var(--text-caption); line-height: 1.6; color: color-mix(in srgb, var(--color-ink) 68%, transparent); }
  .dark .pr-sentence-intro p { color: color-mix(in srgb, var(--color-mist) 72%, transparent); }
  .pr-sentence-intro span { flex: none; padding: 0.3rem 0.7rem; border-radius: 999px; color: var(--color-teal-deep); background: var(--color-card); border: 1px solid color-mix(in srgb, var(--color-teal) 22%, var(--color-card-edge)); font-family: var(--font-mono); font-size: 0.78rem; font-weight: 800; }
  .pr-sentence-intro span:empty { display: none; }
  .dark .pr-sentence-intro span { color: color-mix(in srgb, var(--color-teal) 84%, white); background: var(--color-coal-soft); border-color: color-mix(in srgb, var(--color-teal) 28%, var(--color-coal-edge)); }

  /* Sentence list */
  .pr-sentences { display: grid; grid-template-columns: 1fr; gap: 0.75rem; }
  .pr-sentence {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 1rem;
    width: 100%; text-align: start; padding: 1.05rem 1.15rem; border-radius: 1.1rem;
    background: var(--color-card); border: 1px solid var(--color-card-edge); box-shadow: var(--shadow-card);
    transition: transform .18s var(--ease-out-quart), border-color .18s, box-shadow .18s;
  }
  .dark .pr-sentence { background: var(--color-coal-soft); border-color: var(--color-coal-edge); }
  .pr-sentence:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--color-teal) 50%, var(--color-card-edge)); box-shadow: var(--shadow-lift); }
  .pr-sentence-idx {
    flex: none; width: 2.75rem; height: 2.75rem; display: grid; place-items: center; border-radius: 0.8rem;
    font-family: var(--font-mono); font-weight: 800; font-size: 0.88rem;
    color: var(--color-teal); background: color-mix(in srgb, var(--color-teal) 12%, transparent);
  }
  .dark .pr-sentence-idx { color: color-mix(in srgb, var(--color-teal) 82%, white); background: color-mix(in srgb, var(--color-teal) 22%, transparent); }
  .pr-sentence:hover .pr-sentence-idx { color: #fff; background: var(--color-teal); }
  .pr-sentence-main { min-width: 0; display: flex; flex-direction: column; gap: 0.3rem; }
  .pr-sentence-text { font-family: var(--font-arabic-classical); font-size: 1.45rem; line-height: 1.55; color: var(--color-ink); }
  .dark .pr-sentence-text { color: var(--color-mist); }
  .pr-sentence-meta { width: fit-content; font-family: var(--font-mono); font-size: 0.78rem; color: color-mix(in srgb, var(--color-ink) 54%, transparent); }
  .dark .pr-sentence-meta { color: color-mix(in srgb, var(--color-mist) 60%, transparent); }
  .pr-sentence-open { display: flex; align-items: center; gap: 0.45rem; padding: 0.48rem 0.7rem; border-radius: 0.65rem; color: var(--color-teal-deep); background: color-mix(in srgb, var(--color-teal) 10%, transparent); font-size: 0.82rem; font-weight: 800; }
  .dark .pr-sentence-open { color: color-mix(in srgb, var(--color-teal) 86%, white); background: color-mix(in srgb, var(--color-teal) 15%, transparent); }
  .pr-sentence-open svg { width: 0.95rem; height: 0.95rem; transition: transform .18s; }
  .pr-sentence:hover .pr-sentence-open svg { transform: translateX(-0.18rem); }
  :root[dir="ltr"] .pr-sentence:hover .pr-sentence-open svg { transform: translateX(0.18rem); }

  /* Sentence shown while solving */
  .pr-sentence-show {
    font-family: var(--font-arabic-classical); font-size: clamp(1.7rem, 4vw, 2.3rem); line-height: 1.9;
    text-align: center; color: var(--color-ink); padding: 1.1rem 1.25rem; margin-bottom: 1.25rem;
    border-radius: 1rem; background: color-mix(in srgb, var(--color-paper-soft) 60%, white); border: 1px solid var(--color-card-edge);
  }
  .dark .pr-sentence-show { color: var(--color-mist); background: color-mix(in srgb, var(--color-coal) 45%, var(--color-coal-soft)); border-color: var(--color-coal-edge); }

  /* Final challenge screen: sentence context, assessment cards, live progress. */
  .pr-solve-context { position: relative; overflow: hidden; margin-bottom: 1.15rem; padding: 1.15rem; border-radius: 1.2rem; background: radial-gradient(75% 140% at 100% 0%, color-mix(in srgb, var(--color-purple) 13%, transparent), transparent 62%), var(--color-card); border: 1px solid color-mix(in srgb, var(--color-purple) 24%, var(--color-card-edge)); box-shadow: var(--shadow-card); }
  .dark .pr-solve-context { background: radial-gradient(75% 140% at 100% 0%, color-mix(in srgb, var(--color-purple) 18%, transparent), transparent 62%), var(--color-coal-soft); border-color: color-mix(in srgb, var(--color-purple) 30%, var(--color-coal-edge)); }
  .pr-solve-context-top { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin-bottom: 0.55rem; }
  .pr-solve-label { font-size: var(--text-caption); font-weight: 800; color: var(--color-purple-deep); }
  .dark .pr-solve-label { color: color-mix(in srgb, var(--color-purple) 84%, white); }
  .pr-solve-word-count { padding: 0.28rem 0.65rem; border-radius: 999px; font-family: var(--font-mono); font-size: 0.76rem; font-weight: 800; color: color-mix(in srgb, var(--color-ink) 58%, transparent); background: color-mix(in srgb, var(--color-ink) 6%, transparent); }
  .dark .pr-solve-word-count { color: color-mix(in srgb, var(--color-mist) 64%, transparent); background: color-mix(in srgb, var(--color-mist) 9%, transparent); }
  .pr-solve-sentence { margin: 0; padding: 0.8rem 0.75rem; border: 0; background: transparent; box-shadow: none; }
