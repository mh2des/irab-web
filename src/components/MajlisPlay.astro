---
/**
 * MajlisPlay: the web PLAYER for مجالس الإعراب live rooms (/majlis), the
 * phone side of the stage. Same dark board, the same four colours, shapes
 * and letters as the projector, so a student's screen and the room's screen
 * read as one game.
 *
 * Joins the same Firebase RTDB rooms the app and the web stage host (the
 * app's QR encodes https://irab.app/majlis?pin=NNNNNN). Anonymous auth is
 * enough; a signed-in account also earns XP.
 *
 * Protocol (docs/majlis-web-player-plan.md + 2026-10 additions):
 *   join     → callable majalisJoinRoom {pin, displayName, avatar}
 *   listen   → rooms/{id}/meta, participants (RTDB)
 *   phases   → meta.questionReadAt (read time) / questionStartAt / EndAt
 *   answer   → write-once answers/{index}/{uid} = {answer, ts: server}
 *   reveal   → reveal/{index}, readable once the question closes
 *   react    → reactions/{uid} = {e: 0..3, ts: server}, one per 1.5 s
 *   rescue   → majalisCloseQuestion after the deadline if the host is quiet
 * meta.currentQuestionIndex is a STRING. Western digits (owner decision).
 */
const REACTIONS = [
  { img: 'react-clapping-hands', label: 'تصفيق' },
  { img: 'react-fire', label: 'حماس' },
  { img: 'react-face-with-open-mouth', label: 'دهشة' },
  { img: 'react-thinking-face', label: 'تفكير' },
];
---

<div class="mp-page" data-majlis-root dir="rtl">
  <header class="mp-head">
    <a class="mp-brand" href="/" data-head-brand>
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="5" width="14" height="14" fill="none" stroke="#F5C15E" stroke-width="1.6"/><rect x="5" y="5" width="14" height="14" fill="none" stroke="#F5C15E" stroke-width="1.6" transform="rotate(45 12 12)"/></svg>
      مجالس الإعراب
    </a>
    <div class="mp-me mp-hide" data-head-me><img alt="" data-head-avatar /><span data-head-name></span></div>
    <div class="mp-head-end">
      <span class="mp-score mp-hide" data-head-score>0</span>
      <button class="mp-icon" type="button" data-mute aria-pressed="false" aria-label="الصوت">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4V5Z"/><path data-wave d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14"/></svg>
      </button>
    </div>
  </header>

  <main class="mp-main">
    <p class="mp-offline mp-hide" data-offline role="status">انقطع الاتصال، نعيد الاتصال تلقائيًّا…</p>

    <!-- ═══ JOIN ═══ -->
    <section class="mp-screen" data-s="join">
      <div>
        <h1 class="mp-title">انضم إلى المجلس</h1>
        <p class="mp-sub mt-1">أدخل الرمز الظاهر على شاشة المجلس، ثم اختر اسمك وصورتك.</p>
      </div>
      <div class="mp-card mp-screen">
        <label class="mp-label" for="mj-pin">رمز المجلس</label>
        <div class="mp-pin" data-pin-boxes aria-hidden="true"></div>
        <input id="mj-pin" data-pin-input inputmode="numeric" autocomplete="one-time-code" maxlength="6" class="sr-only" aria-label="رمز المجلس المكوّن من ستة أرقام" />

        <label class="mp-label" for="mj-name">اسمك في المجلس</label>
        <div class="mp-field">
          <input id="mj-name" class="mp-input" data-name maxlength="20" placeholder="اكتب اسمك" autocomplete="nickname" />
          <button class="mp-dice" type="button" data-nickname title="اسم يختاره لك المجلس من مصطلحات النحو">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="8.5" cy="8.5" r="1.2" fill="currentColor"/><circle cx="15.5" cy="15.5" r="1.2" fill="currentColor"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/></svg>
            لقب نحوي
          </button>
        </div>

        <span class="mp-label">صورتك</span>
        <div class="mp-avpick">
          <img class="big" alt="" data-avatar-preview />
          <div class="mp-avgrid" data-avatar-grid role="group" aria-label="اختر صورتك"></div>
        </div>
        <button class="mp-link" type="button" data-avatar-more style="justify-self:start;background:none;border:0;padding:0">صور أخرى</button>

        <div class="mp-error mp-hide" data-join-error role="alert"></div>
        <button class="mp-btn primary" type="button" data-join-btn disabled>ادخل المجلس</button>
      </div>
      <button class="mp-btn mp-hide" type="button" data-rejoin>عُد إلى مجلسك السابق</button>
      <p class="mp-sub" style="text-align:center">
        أنت المضيف؟ <a class="mp-link" href="/majlis/host">أدر مجالسك من هنا</a>
        · <a class="mp-link" href="/majalis">ما مجالس الإعراب؟</a>
      </p>
    </section>

    <!-- ═══ LOBBY ═══ -->
    <section class="mp-screen mp-center mp-hide" data-s="lobby">
      <img class="mp-avatar-xl mp-bob" alt="" data-lobby-avatar />
      <p class="mp-name-xl" data-lobby-name></p>
      <span class="mp-chip">أنت في المجلس، واسمك ظاهر على الشاشة</span>
      <p class="mp-sub">ينتظر الجميع بدء المضيف. ابقَ على هذه الصفحة.</p>
      <div class="mp-dots" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="mp-card" style="width:100%">
        <p class="mp-label" style="text-align:center"><span data-lobby-count>0</span> في المجلس</p>
        <div class="mp-faces mt-2" data-lobby-faces></div>
      </div>
      <div class="mp-react" data-react role="group" aria-label="تفاعل يظهر على الشاشة">
        {REACTIONS.map((r, i) => (<button type="button" data-react-btn={i} aria-label={r.label}><img alt="" src={`/majlis-fx/${r.img}.png`} width="36" height="36" /></button>))}
      </div>
    </section>

    <!-- ═══ COUNTDOWN ═══ -->
    <section class="mp-screen mp-center mp-hide" data-s="count" style="padding-top:40px">
      <p class="mp-qnum" data-count-qnum></p>
      <div class="mp-bignum" data-count-num>3</div>
      <p class="mp-sub">استعد، وانظر إلى الشاشة</p>
    </section>

    <!-- ═══ READ (rooms with read time) ═══ -->
    <section class="mp-screen mp-hide" data-s="read">
      <p class="mp-qnum" data-read-num></p>
      <div class="mp-card mp-qcard">
        <p class="mp-sentence mp-hide" data-read-source></p>
        <p class="mp-qtext" data-read-text></p>
      </div>
      <p class="mp-hint">اقرأ جيدًا، تظهر الخيارات بعد لحظات</p>
      <div class="mp-bar"><i data-read-bar></i></div>
    </section>

    <!-- ═══ QUESTION ═══ -->
    <section class="mp-screen mp-hide" data-s="question">
      <div class="mp-qtop">
        <p class="mp-qnum" data-q-num></p>
        <div class="mp-ring" data-ring-wrap>
          <svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="16" fill="none" stroke="#283A5C" stroke-width="4"/><circle data-time-ring cx="20" cy="20" r="16" fill="none" stroke="#F5C15E" stroke-width="4" stroke-linecap="round" stroke-dasharray="100.5" stroke-dashoffset="0"/></svg>
          <span data-time-left></span>
        </div>
      </div>
      <div class="mp-card mp-qcard">
        <p class="mp-sentence mp-hide" data-q-source></p>
        <p class="mp-qtext" data-q-text></p>
      </div>
      <p class="mp-hint" data-q-hint></p>
      <div data-q-zone class="mp-screen"></div>
      <button class="mp-btn primary mp-hide" type="button" data-submit-btn>أرسل إجابتي</button>
    </section>

    <!-- ═══ LOCKED IN ═══ -->
    <section class="mp-screen mp-center mp-hide" data-s="locked" style="padding-top:36px">
      <div class="mp-lockmark plain" data-lock-mark></div>
      <h2 class="mp-name-xl">تم إرسال إجابتك</h2>
      <p class="mp-sub">انظر إلى الشاشة، والنتيجة بعد لحظات</p>
      <div class="mp-dots" aria-hidden="true"><i></i><i></i><i></i></div>
    </section>

    <!-- ═══ WAIT (time's up, or the result is on its way) ═══ -->
    <section class="mp-screen mp-center mp-hide" data-s="wait" style="padding-top:48px">
      <h2 class="mp-name-xl" data-wait-title></h2>
      <p class="mp-sub" data-wait-body></p>
      <div class="mp-dots" aria-hidden="true" data-wait-dots><i></i><i></i><i></i></div>
      <button class="mp-btn primary mp-hide" type="button" data-wait-retry style="max-width:260px">أعد المحاولة</button>
    </section>

    <!-- ═══ REVEAL ═══ -->
    <section class="mp-screen mp-hide" data-s="reveal">
      <div class="mp-verdict" data-verdict>
        <span class="vh" data-verdict-title></span>
        <span class="vp" data-verdict-points></span>
      </div>
      <div class="mp-streak mp-hide" data-streak><img alt="" src="/majlis-fx/fire.png" width="32" height="32" /><span data-streak-text></span></div>
      <div class="mp-card mp-stand" data-stand>
        <span class="k">موقعك الآن</span>
        <span class="v" data-stand-rank></span>
        <span class="g" data-stand-gap></span>
      </div>
      <div class="mp-card mp-answer">
        <span class="k">الإجابة الصحيحة</span>
        <span class="v" data-reveal-correct></span>
        <p class="mp-why mp-hide" data-reveal-why><b>التعليل: </b><span></span></p>
      </div>
    </section>

    <!-- ═══ STANDINGS ═══ -->
    <section class="mp-screen mp-center mp-hide" data-s="board">
      <p class="mp-label">ترتيبك بعد السؤال <span data-board-q></span></p>
      <p class="mp-rankbig"><span data-board-rank></span><small> / <span data-board-total></span></small></p>
      <p class="mp-move" data-board-move></p>
      <div class="mp-card mp-stand" style="width:100%;text-align:start"><span class="g" data-board-gap></span></div>
      <div class="mp-top3" data-board-top style="width:100%"></div>
      <div class="mp-react" data-react role="group" aria-label="تفاعل يظهر على الشاشة">
        {REACTIONS.map((r, i) => (<button type="button" data-react-btn={i} aria-label={r.label}><img alt="" src={`/majlis-fx/${r.img}.png`} width="36" height="36" /></button>))}
      </div>
    </section>

    <!-- ═══ PODIUM ═══ -->
    <section class="mp-screen mp-center mp-hide" data-s="podium">
      <img class="mp-medal mp-hide" alt="" data-final-medal />
      <h2 class="mp-title">انتهى المجلس</h2>
      <p class="mp-rankbig" style="font-size:56px"><span data-final-rank></span><small> / <span data-final-total></span></small></p>
      <div class="mp-stats">
        <span><b data-final-score>0</b>نقطة</span>
        <span><b data-final-correct>0</b>إجابات صحيحة</span>
      </div>
      <p class="mp-chip mp-hide" data-final-xp>أُضيفت نقاط الخبرة إلى حسابك</p>
      <button class="mp-btn primary" type="button" data-open-review>راجع إجاباتك والتعليل</button>
      <div class="mp-react" data-react role="group" aria-label="تفاعل يظهر على الشاشة">
        {REACTIONS.map((r, i) => (<button type="button" data-react-btn={i} aria-label={r.label}><img alt="" src={`/majlis-fx/${r.img}.png`} width="36" height="36" /></button>))}
      </div>
      <div class="mp-card mp-screen" style="width:100%">
        <p style="font-weight:900">أعجبك المجلس؟ استضف مجلسك الخاص لطلابك.</p>
        <a class="mp-btn" href="/majlis/host">مجالسي</a>
      </div>
    </section>

    <!-- ═══ REVIEW ═══ -->
    <section class="mp-screen mp-hide" data-s="review">
      <div class="mp-qtop">
        <h2 class="mp-name-xl">مراجعتك</h2>
        <button class="mp-btn small" type="button" data-review-back>عودة</button>
      </div>
      <p class="mp-sub" data-review-sum></p>
      <div class="mp-rv" data-review-list></div>
    </section>

    <!-- ═══ TERMINAL ═══ -->
    <section class="mp-screen mp-center mp-hide" data-s="terminal" style="padding-top:48px">
      <h2 class="mp-name-xl" data-terminal-title></h2>
      <p class="mp-sub" data-terminal-body></p>
      <a class="mp-btn primary" href="/majlis" style="max-width:280px">انضم إلى مجلس آخر</a>
    </section>
  </main>
</div>

<script>
  import { signInAnonymously, onAuthStateChanged, type User } from 'firebase/auth';
  import {
    ref, onValue, onDisconnect, get, set, serverTimestamp, type Database, type Unsubscribe,
  } from 'firebase/database';
  import { auth } from '../lib/firebase';
  import { rtdb, callMajlis, track as trackEvent } from '../lib/majlis/fb';
  import { sfx, confetti, isMuted, setMuted } from '../lib/celebrate';
  import { shapeSvg, tileClass, LETTERS } from '../lib/majlis/stage/shapes';
  import { grammarNickname } from '../lib/majlis/nicknames';

  const root = document.querySelector<HTMLElement>('[data-majlis-root]');
  if (root) {
    const AVATAR_COUNT = 64;
    const REJOIN_MS = 90 * 60 * 1000; // mirrors the app's 90-min rejoin memory
    const q = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const qa = <T extends Element = HTMLElement>(s: string) => [...root.querySelectorAll<T>(s)];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const JOIN_ERRORS: Record<string, string> = {
      ROOM_NOT_FOUND: 'لا يوجد مجلس بهذا الرمز. تأكد من الرقم الظاهر على الشاشة.',
      ROOM_STARTED: 'بدأ هذا المجلس بالفعل ولا يقبل لاعبين جددًا.',
      ROOM_LOCKED: 'أغلق المضيف باب الانضمام.',
      ROOM_FULL: 'اكتمل عدد اللاعبين في هذا المجلس.',
      NAME_LENGTH: 'اكتب اسمًا من حرفين إلى عشرين حرفًا.',
      NAME_REJECTED: 'لا يمكن استخدام هذا الاسم في المجلس.',
      KICKED: 'أخرجك المضيف من هذا المجلس.',
      RATE_LIMITED: 'محاولات كثيرة، انتظر قليلًا ثم جرّب مجددًا.',
    };

    // ── State ──────────────────────────────────────────────────────────────
    type Status = 'lobby' | 'questionLive' | 'answerReview' | 'leaderboard' | 'finished';
    type P = { uid: string; name: string; avatar: number; score: number; correct: number; joinedAt: number };
    let db: Database; let uid = '';
    let roomId = ''; let myName = ''; let myAvatar = Math.floor(Math.random() * AVATAR_COUNT);
    let meta: any = null; let joined = false;
    let participants: P[] = [];
    let serverOffset = 0;
    let qIndex = ''; let qData: any = null; let answered = false; let reveal: any = null;
    // submitted: this device tried to send an answer for the current question
    // (the write may still have been refused after the deadline).
    let submitted = false; let renderedIdx = ''; let readShownIdx = '';
    // A stuck question (host asleep) may be closed by any player once the
    // deadline has passed; each device waits a random extra moment so they
    // don't all call at once. The server elects a single scorer anyway.
    let closeAskedIdx = ''; let closeJitter = 0;
    let tickTimer: number | undefined;
    let unsubs: Unsubscribe[] = [];
    // fix_error two-step selection and arrange order
    let selWord = -1; let selOpt = -1; let arrangeOrder: number[] = [];
    // Per-question results from the reveals, for the streak and the review.
    const results: Record<string, { correct: boolean; points: number; answered: boolean }> = {};
    // My rank when the current question went live, for "you climbed".
    let rankBefore = 0; let rankBeforeIdx = '';
    let lastCount = -1; let lastSecond = -1;
    let reactReadyAt = 0;

    const now = () => Date.now() + serverOffset;
    const avatarUrl = (i: number) => `/majlis-avatars/a${((i % AVATAR_COUNT) + AVATAR_COUNT) % AVATAR_COUNT}.svg`;
    const track = (event: string, params: Record<string, string | number | boolean | null | undefined> = {}) =>
      trackEvent(event, { platform: 'web', ...params });
    const vibrate = (p: number | number[]) => { try { navigator.vibrate?.(p); } catch { /* unsupported */ } };
    const store = {
      get(k: string) { try { return localStorage.getItem(k); } catch { return null; } },
      set(k: string, v: string) { try { localStorage.setItem(k, v); } catch { /* ignore */ } },
      del(k: string) { try { localStorage.removeItem(k); } catch { /* ignore */ } },
    };

    // ── Screens ────────────────────────────────────────────────────────────
    const screens = ['join', 'lobby', 'count', 'read', 'question', 'locked', 'wait', 'reveal', 'board', 'podium', 'review', 'terminal'];
    let current = 'join';
    function show(name: string) {
      if (name === current) return;
      current = name;
      for (const s of screens) {
        const el = q(`[data-s="${s}"]`);
        el.classList.toggle('mp-hide', s !== name);
        if (s === name && !reduced) { el.classList.remove('mp-in'); void el.offsetWidth; el.classList.add('mp-in'); }
      }
      window.scrollTo({ top: 0 });
    }
    function showWait(title: string, body: string, retry?: () => void) {
      q('[data-wait-title]').textContent = title;
      q('[data-wait-body]').textContent = body;
      const btn = q<HTMLButtonElement>('[data-wait-retry]');
      btn.classList.toggle('mp-hide', !retry);
      q('[data-wait-dots]').classList.toggle('mp-hide', !!retry);
      btn.onclick = retry ? () => { btn.classList.add('mp-hide'); retry(); } : null;
      if (current === 'wait') current = '';
      show('wait');
    }
    const pop = (el: Element, delay = 0) => { if (reduced) return; (el as HTMLElement).style.animationDelay = `${delay}ms`; el.classList.add('mp-pop'); };

    // ── Sound toggle (shared with the rest of the site) ────────────────────
    const muteBtn = q<HTMLButtonElement>('[data-mute]');
    const paintMute = () => { muteBtn.setAttribute('aria-pressed', String(!isMuted())); muteBtn.querySelector('[data-wave]')!.setAttribute('opacity', isMuted() ? '0' : '1'); };
    paintMute();
    muteBtn.addEventListener('click', () => { setMuted(!isMuted()); paintMute(); if (!isMuted()) sfx.tap(); });

    // ── PIN input (6 boxes backed by one hidden input) ─────────────────────
    const pinInput = q<HTMLInputElement>('[data-pin-input]');
    const pinBoxes = q('[data-pin-boxes]');
    for (let i = 0; i < 6; i++) pinBoxes.appendChild(document.createElement('span'));
    function renderPin() {
      const v = pinInput.value;
      [...pinBoxes.children].forEach((b, i) => { b.textContent = v[i] ?? ''; b.classList.toggle('at', i === Math.min(v.length, 5) && document.activeElement === pinInput); });
      updateJoinEnabled();
    }
    pinBoxes.addEventListener('click', () => pinInput.focus());
    pinInput.addEventListener('input', () => { pinInput.value = pinInput.value.replace(/\D/g, '').slice(0, 6); renderPin(); });
    pinInput.addEventListener('focus', renderPin);
    pinInput.addEventListener('blur', renderPin);

    const nameInput = q<HTMLInputElement>('[data-name]');
    const joinBtn = q<HTMLButtonElement>('[data-join-btn]');
    const joinErr = q('[data-join-error]');
    function updateJoinEnabled() { joinBtn.disabled = !(pinInput.value.length === 6 && nameInput.value.trim().length >= 2); }
    nameInput.addEventListener('input', updateJoinEnabled);
    q('[data-nickname]').addEventListener('click', () => {
      nameInput.value = grammarNickname(nameInput.value.trim());
      updateJoinEnabled(); sfx.tap();
    });

    // ── Avatar picker: the chosen face plus a grid of others ───────────────
    const avatarPreview = q<HTMLImageElement>('[data-avatar-preview]');
    const avatarGrid = q('[data-avatar-grid]');
    let gridSet: number[] = [];
    function shuffleGrid() {
      const pool = [...Array(AVATAR_COUNT).keys()].filter((i) => i !== myAvatar);
      for (let i = pool.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [pool[i], pool[j]] = [pool[j], pool[i]]; }
      gridSet = [myAvatar, ...pool.slice(0, 11)];
      renderAvatars();
    }
    function renderAvatars() {
      avatarPreview.src = avatarUrl(myAvatar);
      avatarGrid.textContent = '';
      for (const i of gridSet) {
        const b = document.createElement('button');
        b.type = 'button'; b.setAttribute('aria-pressed', String(i === myAvatar)); b.setAttribute('aria-label', `الصورة ${i + 1}`);
        const img = document.createElement('img'); img.alt = ''; img.src = avatarUrl(i); img.loading = 'lazy';
        b.appendChild(img);
        b.addEventListener('click', () => { myAvatar = i; renderAvatars(); sfx.tap(); });
        avatarGrid.appendChild(b);
      }
    }
    q('[data-avatar-more]').addEventListener('click', shuffleGrid);
    shuffleGrid();

    // Prefill from ?pin= (the QR payload) and restore the last name.
    const urlPin = new URLSearchParams(location.search).get('pin') ?? '';
    if (/^\d{6}$/.test(urlPin)) pinInput.value = urlPin;
    nameInput.value = store.get('mj-name') ?? '';
    renderPin();

    // One-tap rejoin.
    let saved: any = null;
    try { saved = JSON.parse(store.get('mj-session') ?? 'null'); } catch { /* ignore */ }
    if (saved && Date.now() - saved.ts < REJOIN_MS && /^\d{6}$/.test(saved.pin ?? '')) {
      const rejoinBtn = q('[data-rejoin]');
      rejoinBtn.classList.remove('mp-hide');
      rejoinBtn.addEventListener('click', () => {
        pinInput.value = saved.pin; nameInput.value = saved.name ?? nameInput.value;
        myAvatar = saved.avatar ?? myAvatar; shuffleGrid(); renderPin();
        join();
      });
    }

    // ── Auth + join ────────────────────────────────────────────────────────
    async function ensureUser(): Promise<User> {
      const existing = await new Promise<User | null>((resolve) => {
        const stop = onAuthStateChanged(auth, (u) => { stop(); resolve(u); });
      });
      if (existing) return existing;
      return (await signInAnonymously(auth)).user;
    }

    async function join() {
      joinErr.classList.add('mp-hide');
      joinBtn.disabled = true;
      joinBtn.textContent = 'جارٍ الانضمام…';
      track('majlis_web_join_attempt');
      try {
        const user = await ensureUser();
        uid = user.uid;
        db = await rtdb();
        const res: any = await callMajlis('majalisJoinRoom', { pin: pinInput.value, displayName: nameInput.value.trim(), avatar: myAvatar });
        roomId = res.roomId; myName = res.displayName; myAvatar = res.avatar ?? myAvatar;
        joined = true;
        store.set('mj-name', nameInput.value.trim());
        store.set('mj-session', JSON.stringify({ pin: pinInput.value, name: myName, avatar: myAvatar, ts: Date.now() }));
        track('majlis_web_joined');
        attachRoom();
      } catch (e: any) {
        const msg = String(e?.message ?? '');
        const code = Object.keys(JOIN_ERRORS).find((k) => msg.includes(k));
        joinErr.textContent = code ? JOIN_ERRORS[code] : 'تعذّر الانضمام، تحقق من اتصالك ثم جرّب مجددًا.';
        if (code === 'NAME_REJECTED' || code === 'NAME_LENGTH') {
          // Offer a grammar nickname instead of a dead end.
          const nick = grammarNickname();
          const b = document.createElement('button');
          b.type = 'button'; b.className = 'mp-btn small'; b.textContent = `استخدم «${nick}»`;
          b.addEventListener('click', () => { nameInput.value = nick; updateJoinEnabled(); joinErr.classList.add('mp-hide'); });
          joinErr.appendChild(b);
        }
        joinErr.classList.remove('mp-hide');
        track('majlis_web_join_error', { code: code ?? 'unknown' });
      } finally {
        joinBtn.textContent = 'ادخل المجلس';
        updateJoinEnabled();
      }
    }
    joinBtn.addEventListener('click', join);

    // ── Room streams ───────────────────────────────────────────────────────
    // Keep the phone awake: a dimmed screen drops a student mid-question.
    let wake: any = null;
    const holdAwake = async () => { try { wake = await (navigator as any).wakeLock?.request('screen'); } catch { /* not granted */ } };
    document.addEventListener('visibilitychange', () => { if (joined && document.visibilityState === 'visible' && (!wake || wake.released)) holdAwake(); });

    function attachRoom() {
      holdAwake();
      q('[data-head-brand]').classList.add('mp-hide');
      q('[data-head-me]').classList.remove('mp-hide');
      q('[data-head-score]').classList.remove('mp-hide');
      q<HTMLImageElement>('[data-head-avatar]').src = avatarUrl(myAvatar);
      q('[data-head-name]').textContent = myName;
      unsubs.push(onValue(ref(db, '.info/serverTimeOffset'), (s) => { serverOffset = s.val() ?? 0; }));
      unsubs.push(onValue(ref(db, '.info/connected'), (s) => {
        q('[data-offline]').classList.toggle('mp-hide', s.val() === true || !joined);
        if (s.val() === true && joined) {
          // Register the offline write first, then mark this device present.
          const pres = ref(db, `rooms/${roomId}/participants/${uid}/presence`);
          onDisconnect(pres).set({ connected: false, lastSeen: serverTimestamp() })
            .then(() => set(pres, { connected: true, lastSeen: serverTimestamp() }))
            .catch(() => {});
        }
      }));
      unsubs.push(onValue(ref(db, `rooms/${roomId}/participants`), (s) => {
        const val = s.val() ?? {};
        participants = Object.entries<any>(val)
          .map(([id, p]) => ({ uid: id, name: String(p?.profile?.displayName ?? '؟'), avatar: Number(p?.profile?.avatar) || 0, score: Number(p?.score) || 0, correct: Number(p?.correctCount) || 0, joinedAt: Number(p?.profile?.joinedAt) || 0 }))
          .sort((a, b) => a.joinedAt - b.joinedAt);
        q('[data-head-score]').textContent = String(me()?.score ?? 0);
        renderLobbyPlayers();
        // Our profile vanished: the host removed us (they also ban the uid).
        if (joined && !val[uid]) {
          get(ref(db, `rooms/${roomId}/banned/${uid}`)).then((b) => {
            if (b.exists()) terminal('أخرجك المضيف من المجلس', 'لا يمكنك العودة إلى هذا المجلس.');
          }).catch(() => {});
        }
      }));
      unsubs.push(onValue(ref(db, `rooms/${roomId}/meta`), (s) => onMeta(s.val())));
      show('lobby');
      q<HTMLImageElement>('[data-lobby-avatar]').src = avatarUrl(myAvatar);
      q('[data-lobby-name]').textContent = myName;
      startTick();
    }

    const me = () => participants.find((p) => p.uid === uid);
    /** Competition rank: equal scores share a rank. */
    function standing() {
      const mine = me();
      const sorted = [...participants].sort((a, b) => b.score - a.score);
      if (!mine) return { rank: 0, total: sorted.length, above: null as P | null, below: null as P | null, score: 0 };
      const rank = 1 + sorted.filter((p) => p.score > mine.score).length;
      const above = [...sorted].reverse().find((p) => p.score > mine.score) ?? null;
      const below = sorted.find((p) => p.uid !== mine.uid && p.score <= mine.score) ?? null;
      return { rank, total: sorted.length, above, below, score: mine.score };
    }
    // Arabic number agreement for points: one, two, 3 to 10, 11 and up.
    const points = (n: number) => n === 1 ? '<b>نقطة واحدة</b>' : n === 2 ? '<b>نقطتان</b>'
      : n <= 10 ? `<b>${n}</b> نقاط` : `<b>${n}</b> نقطة`;
    function gapText(): string {
      const s = standing();
      if (!s.rank) return '';
      if (s.above) return `تفصلك ${points(s.above.score - s.score)} عن ${escapeHtml(s.above.name)}`;
      if (s.below && s.below.score === s.score) return `في الصدارة مع ${escapeHtml(s.below.name)}`;
      if (s.below) {
        const n = s.score - s.below.score;
        // After بـ the dual is genitive: بنقطتين.
        const lead = n === 1 ? 'بنقطة واحدة' : n === 2 ? 'بنقطتين' : `بـ <b>${n}</b> ${n <= 10 ? 'نقاط' : 'نقطة'}`;
        return `في الصدارة، متقدمًا ${lead}`;
      }
      return 'في الصدارة';
    }
    const escapeHtml = (t: string) => t.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

    function renderLobbyPlayers() {
      q('[data-lobby-count]').textContent = String(participants.length);
      const wrap = q('[data-lobby-faces]');
      wrap.textContent = '';
      participants.slice(0, 18).forEach((p) => { const img = document.createElement('img'); img.src = avatarUrl(p.avatar); img.alt = ''; img.title = p.name; wrap.appendChild(img); });
      if (participants.length > 18) { const more = document.createElement('span'); more.textContent = `+${participants.length - 18}`; wrap.appendChild(more); }
    }

    // ── Reactions: a tap floats on the projector ───────────────────────────
    qa<HTMLButtonElement>('[data-react-btn]').forEach((b) => b.addEventListener('click', () => {
      if (!joined || Date.now() < reactReadyAt) return;
      reactReadyAt = Date.now() + 1600;
      qa<HTMLButtonElement>('[data-react-btn]').forEach((x) => { x.disabled = true; });
      setTimeout(() => qa<HTMLButtonElement>('[data-react-btn]').forEach((x) => { x.disabled = false; }), 1600);
      pop(b.querySelector('img')!);
      vibrate(10);
      set(ref(db, `rooms/${roomId}/reactions/${uid}`), { e: Number(b.dataset.reactBtn), ts: serverTimestamp() }).catch(() => {});
    }));

    // ── Meta-driven state machine ──────────────────────────────────────────
    function onMeta(m: any) {
      if (joined && m == null) { terminal('أُغلق المجلس', 'انتهت هذه الجلسة أو أغلقها المضيف.'); return; }
      meta = m;
      const status: Status = m?.status ?? 'lobby';
      const idx = String(m?.currentQuestionIndex ?? '');
      switch (status) {
        case 'lobby': show('lobby'); break;
        case 'questionLive':
          if (idx !== qIndex || qData == null) loadQuestion(idx);
          else renderPhase();
          break;
        case 'answerReview':
          if (reveal?.__idx !== idx) { showWait('انتهى السؤال', 'النتيجة بعد لحظات…'); fetchReveal(idx); }
          else renderReveal();
          break;
        case 'leaderboard': renderBoard(); break;
        case 'finished': if (current !== 'review') renderPodium(); break;
      }
    }

    async function loadQuestion(idx: string) {
      qIndex = idx; qData = null; answered = false; submitted = false; reveal = null; renderedIdx = ''; readShownIdx = '';
      selWord = -1; selOpt = -1; arrangeOrder = [];
      closeJitter = Math.random() * 2500; lastCount = -1; lastSecond = -1;
      if (rankBeforeIdx !== idx) { rankBefore = standing().rank; rankBeforeIdx = idx; }
      try { qData = (await get(ref(db, `rooms/${roomId}/publicQ/${idx}`))).val(); }
      catch {
        setTimeout(() => { if (meta?.status === 'questionLive' && !qData) loadQuestion(idx); }, 400);
        return;
      }
      if (qData) renderPhase();
    }

    // The asked-about word, «like this», lit in the sentence (harakat ignored).
    function sentenceInto(el: HTMLElement, sentence: string, questionText: string) {
      el.textContent = '';
      const m = /«([^»]+)»/.exec(questionText ?? '');
      const letters = (m?.[1] ?? '').replace(/[\u064B-\u0652\u0670\u0640]/g, '').trim();
      const found = letters
        ? new RegExp([...letters].map((c) => c.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('[\u064B-\u0652\u0670\u0640]*') + '[\u064B-\u0652\u0670]*').exec(sentence)
        : null;
      if (!found) { el.textContent = sentence; return; }
      const hl = document.createElement('span'); hl.className = 'hl'; hl.textContent = found[0];
      el.append(document.createTextNode(sentence.slice(0, found.index)), hl, document.createTextNode(sentence.slice(found.index + found[0].length)));
    }
    const qNum = () => `السؤال ${Number(qIndex) + 1} من ${meta?.qCount ?? '؟'}`;

    // countdown, read time, then the question; driven by meta and the ticker
    function renderPhase() {
      if (!qData || meta?.status !== 'questionLive') return;
      const startAt = meta.questionStartAt ?? 0;
      const readAt = meta.questionReadAt ?? startAt;
      if (now() < readAt) {
        q('[data-count-qnum]').textContent = qNum();
        show('count');
      } else if (now() < startAt) {
        showRead(readAt, startAt);
      } else if (answered) {
        show('locked');
      } else if (now() >= (meta.questionEndAt ?? Infinity)) {
        showWait('انتهى الوقت', 'النتيجة بعد لحظات…');
      } else {
        // Render once per question: a meta change mid-question must not wipe
        // a half-built arrangement or a fix_error selection.
        if (renderedIdx !== qIndex) { renderQuestion(); renderedIdx = qIndex; }
        show('question');
      }
    }

    function showRead(readAt: number, startAt: number) {
      if (readShownIdx !== qIndex) {
        readShownIdx = qIndex;
        q('[data-read-num]').textContent = qNum();
        const src = q('[data-read-source]');
        const sentence = qData.type === 'arrange_irab' ? '' : String(qData.sourceText ?? '');
        src.classList.toggle('mp-hide', !sentence);
        if (sentence) sentenceInto(src, sentence, String(qData.questionText ?? ''));
        q('[data-read-text]').textContent = qData.questionText ?? '';
        const bar = q('[data-read-bar]');
        bar.getAnimations().forEach((a) => a.cancel());
        const done = Math.min(1, Math.max(0, (now() - readAt) / Math.max(1, startAt - readAt)));
        if (reduced) bar.style.width = '100%';
        else bar.animate([{ width: `${done * 100}%` }, { width: '100%' }], { duration: Math.max(0, startAt - now()), easing: 'linear', fill: 'forwards' });
      }
      show('read');
    }

    function startTick() {
      stopTick();
      tickTimer = window.setInterval(() => {
        if (meta?.status !== 'questionLive' || !qData) return;
        const startAt = meta.questionStartAt ?? 0; const endAt = meta.questionEndAt ?? 0;
        const readAt = meta.questionReadAt ?? startAt;
        const t = now();
        if (t < readAt) {
          const n = Math.min(3, Math.max(1, Math.ceil((readAt - t) / 1000)));
          if (n !== lastCount) { lastCount = n; const el = q('[data-count-num]'); el.textContent = String(n); pop(el); sfx.tap(); }
          if (current !== 'count') renderPhase();
          return;
        }
        if (t < startAt) { if (current !== 'read') renderPhase(); return; }
        if (current === 'count' || current === 'read') { renderPhase(); if ((current as string) === 'question') sfx.select(); }
        const span = Math.max(1, endAt - startAt);
        const left = Math.max(0, endAt - t);
        const sec = Math.ceil(left / 1000);
        if (sec !== lastSecond) {
          lastSecond = sec;
          q('[data-time-left]').textContent = String(sec);
          q('[data-ring-wrap]').classList.toggle('urgent', sec <= 5);
        }
        q<SVGCircleElement>('[data-time-ring]').style.strokeDashoffset = String(100.5 * (1 - left / span));
        if (left === 0 && !answered && current === 'question') showWait('انتهى الوقت', 'النتيجة بعد لحظات…');
        // The host normally closes on time. If it hasn't (device asleep),
        // ask the server to close; it only accepts after the deadline.
        if (endAt > 0 && t > endAt + 2000 + closeJitter && closeAskedIdx !== qIndex) {
          closeAskedIdx = qIndex;
          callMajlis('majalisCloseQuestion', { roomId, questionIndex: Number(qIndex) }).catch(() => {});
        }
      }, 200);
    }
    function stopTick() { if (tickTimer) { clearInterval(tickTimer); tickTimer = undefined; } }

    // ── Question rendering by type ─────────────────────────────────────────
    const HINTS: Record<string, string> = {
      mcq: 'اختر الإجابة، وهي بالألوان نفسها على الشاشة',
      true_false: 'صواب أم خطأ؟',
      tap_word: 'انقر الكلمة المطلوبة',
      arrange_irab: 'انقر البطاقات بالترتيب الصحيح',
      fix_error: 'انقر الكلمة الخاطئة، ثم اختر تصويبها',
    };
    const words = () => String(qData?.sourceText ?? qData?.questionText ?? '').split(/\s+/).filter(Boolean);

    function tileBtn(label: string, i: number): HTMLButtonElement {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = `mp-tile ${tileClass(i)}`;
      b.setAttribute('aria-label', `${LETTERS[i] ?? ''}: ${label}`);
      b.innerHTML = `${shapeSvg(i)}<span class="lt">${LETTERS[i] ?? ''}</span><span class="tx"></span>`;
      b.querySelector('.tx')!.textContent = label;
      return b;
    }

    function renderQuestion() {
      const type = String(qData.type ?? 'mcq');
      q('[data-q-num]').textContent = qNum();
      const src = q('[data-q-source]');
      const sentence = String(qData.sourceText ?? '');
      const showSource = !!sentence && type !== 'fix_error' && type !== 'tap_word';
      src.classList.toggle('mp-hide', !showSource);
      if (showSource) sentenceInto(src, sentence, String(qData.questionText ?? ''));
      q('[data-q-text]').textContent = qData.questionText ?? '';
      q('[data-q-hint]').textContent = HINTS[type] ?? '';

      const zone = q('[data-q-zone]');
      zone.textContent = '';
      const submit = q<HTMLButtonElement>('[data-submit-btn]');
      submit.classList.add('mp-hide');
      const options: string[] = (qData.options ?? []).map(String);

      if (type === 'mcq' || type === 'true_false') {
        const labels = type === 'true_false' ? ['صواب', 'خطأ'] : options;
        const tiles = document.createElement('div');
        tiles.className = 'mp-tiles' + (labels.length === 2 ? ' two' : '');
        labels.forEach((label, i) => {
          const b = tileBtn(label, i);
          b.addEventListener('click', () => submitAnswer(type === 'true_false' ? i === 0 : i, label, i, b));
          tiles.appendChild(b);
          if (!reduced) { b.classList.add('mp-rise'); b.style.animationDelay = `${i * 50}ms`; }
        });
        zone.appendChild(tiles);
      } else if (type === 'tap_word') {
        const wrap = document.createElement('div'); wrap.className = 'mp-words';
        options.forEach((w, i) => {
          const b = document.createElement('button'); b.type = 'button'; b.className = 'mp-word'; b.textContent = w;
          b.addEventListener('click', () => submitAnswer(i, w, -1, b));
          wrap.appendChild(b);
        });
        zone.appendChild(wrap);
      } else if (type === 'arrange_irab') {
        submit.classList.remove('mp-hide'); submit.disabled = true;
        const list = document.createElement('div'); list.className = 'mp-arr';
        const btns: HTMLButtonElement[] = [];
        options.forEach((o, i) => {
          const b = document.createElement('button'); b.type = 'button';
          b.innerHTML = '<span class="tx"></span><span class="n"></span>';
          b.querySelector('.tx')!.textContent = o;
          b.addEventListener('click', () => {
            const at = arrangeOrder.indexOf(i);
            if (at >= 0) arrangeOrder.splice(at, 1); else arrangeOrder.push(i);
            btns.forEach((x, j) => { const pos = arrangeOrder.indexOf(j); x.classList.toggle('on', pos >= 0); x.querySelector('.n')!.textContent = pos >= 0 ? String(pos + 1) : ''; });
            submit.disabled = arrangeOrder.length !== options.length;
            sfx.tap();
          });
          btns.push(b); list.appendChild(b);
        });
        zone.appendChild(list);
        submit.onclick = () => { if (arrangeOrder.length === options.length) submitAnswer([...arrangeOrder], arrangeOrder.map((i) => options[i]).join(' '), -1, submit); };
      } else if (type === 'fix_error') {
        submit.classList.remove('mp-hide'); submit.disabled = true;
        const ws = words();
        const wrap = document.createElement('div'); wrap.className = 'mp-words';
        const wordBtns: HTMLButtonElement[] = [];
        ws.forEach((w, i) => {
          const b = document.createElement('button'); b.type = 'button'; b.className = 'mp-word'; b.textContent = w;
          b.setAttribute('aria-pressed', 'false');
          b.addEventListener('click', () => {
            selWord = i;
            wordBtns.forEach((x, j) => x.setAttribute('aria-pressed', String(j === i)));
            submit.disabled = !(selWord >= 0 && selOpt >= 0);
            sfx.tap();
          });
          wordBtns.push(b); wrap.appendChild(b);
        });
        const head = document.createElement('p'); head.className = 'mp-hint'; head.textContent = 'التصويب';
        const tiles = document.createElement('div'); tiles.className = 'mp-tiles';
        const optBtns: HTMLButtonElement[] = [];
        options.forEach((o, i) => {
          const b = tileBtn(o, i);
          b.addEventListener('click', () => {
            selOpt = i;
            optBtns.forEach((x, j) => x.classList.toggle('picked', j === i));
            tiles.classList.add('has-pick');
            submit.disabled = !(selWord >= 0 && selOpt >= 0);
            sfx.tap();
          });
          optBtns.push(b); tiles.appendChild(b);
        });
        zone.append(wrap, head, tiles);
        submit.onclick = () => {
          if (selWord >= 0 && selOpt >= 0) submitAnswer({ w: selWord, o: selOpt }, `«${ws[selWord]}» صوابها «${options[selOpt]}»`, selOpt, submit);
        };
      }
    }

    // Keys 1 to 4 pick a tile on a computer.
    document.addEventListener('keydown', (e) => {
      if (current !== 'question' || answered || e.altKey || e.ctrlKey || e.metaKey) return;
      const n = Number(e.key);
      if (!(n >= 1 && n <= 4)) return;
      const tiles = qa<HTMLButtonElement>('[data-s="question"] .mp-tiles .mp-tile');
      tiles[n - 1]?.click();
    });

    // ── Submit (write-once; rules enforce the window) ──────────────────────
    function rememberAnswer(label: string) {
      const k = `mj-ans:${roomId}`;
      let m: Record<string, string> = {};
      try { m = JSON.parse(store.get(k) ?? '{}'); } catch { /* fresh */ }
      m[qIndex] = label;
      store.set(k, JSON.stringify(m));
    }
    async function submitAnswer(answer: unknown, label: string, tile: number, btn?: HTMLElement) {
      // Only while this question is open on screen: a late tap must never
      // pull the player back from a result that has already arrived.
      if (answered || meta?.status !== 'questionLive' || current !== 'question') return;
      if (now() >= (meta?.questionEndAt ?? Infinity)) { showWait('انتهى الوقت', 'النتيجة بعد لحظات…'); return; }
      answered = true; submitted = true;
      btn?.classList.add('picked');
      vibrate(15); sfx.select();
      rememberAnswer(label);
      const mark = q('[data-lock-mark]');
      mark.className = 'mp-lockmark ' + (tile >= 0 ? tileClass(tile) : 'plain');
      mark.innerHTML = tile >= 0 ? shapeSvg(tile) : '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="#F5C15E" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      show('locked'); pop(mark);
      try {
        await set(ref(db, `rooms/${roomId}/answers/${qIndex}/${uid}`), { answer, ts: serverTimestamp() });
        track('majlis_web_answer_submitted', { type: qData?.type });
      } catch { /* window closed or double write; the reveal tells the truth */ }
    }

    // ── Reveal ─────────────────────────────────────────────────────────────
    // The reveal lands moments after the status flips; a cold function can
    // take several seconds. Back off for about 15 s, then offer a retry.
    const REVEAL_DELAYS = [...Array(10).fill(200), ...Array(10).fill(500), ...Array(8).fill(1000)];
    async function fetchReveal(idx: string, attempt = 0) {
      try {
        const snap = await get(ref(db, `rooms/${roomId}/reveal/${idx}`));
        if (snap.exists()) {
          reveal = { ...snap.val(), __idx: idx };
          noteResult(idx, reveal);
          if (meta?.status === 'answerReview' && String(meta?.currentQuestionIndex) === idx) renderReveal(true);
          return;
        }
      } catch { /* readable only after close; retry below */ }
      if (meta?.status !== 'answerReview' || String(meta?.currentQuestionIndex) !== idx) return;
      if (attempt < REVEAL_DELAYS.length) setTimeout(() => fetchReveal(idx, attempt + 1), REVEAL_DELAYS[attempt]);
      else showWait('تأخرت النتيجة', 'تحقق من اتصالك ثم أعد المحاولة.', () => { showWait('انتهى السؤال', 'النتيجة بعد لحظات…'); fetchReveal(idx); });
    }
    function noteResult(idx: string, r: any) {
      const a = r?.awarded?.[uid];
      results[idx] = { correct: !!a?.correct, points: Number(a?.points) || 0, answered: !!a };
    }
    /** Results of every question played so far (fills gaps after a reload). */
    async function ensureResults(upTo: number) {
      const missing: number[] = [];
      for (let i = 0; i <= upTo; i++) if (!results[String(i)]) missing.push(i);
      await Promise.all(missing.map(async (i) => {
        try { const s = await get(ref(db, `rooms/${roomId}/reveal/${i}`)); if (s.exists()) noteResult(String(i), s.val()); } catch { /* not played */ }
      }));
    }
    function streakNow(upTo: number): number {
      let n = 0;
      for (let i = upTo; i >= 0; i--) { const r = results[String(i)]; if (r?.correct) n++; else break; }
      return n;
    }

    async function renderReveal(fresh = false) {
      // The server's award is the truth: it survives a reload and knows when
      // a tap arrived after the deadline.
      const award = reveal?.awarded?.[uid];
      const correct = !!award?.correct;
      const v = q('[data-verdict]');
      v.className = 'mp-verdict ' + (award ? (correct ? 'ok' : 'no') : 'none');
      q('[data-verdict-title]').textContent = award
        ? (correct ? 'إجابة صحيحة' : 'إجابة غير صحيحة')
        : submitted ? 'انتهى الوقت قبل وصول إجابتك' : 'لم تُجب هذه المرة';
      q('[data-verdict-points]').textContent = correct ? `+${award?.points ?? 0}` : '';
      q('[data-reveal-correct]').textContent = reveal?.correctDisplay ?? '';
      const why = String(reveal?.explanation ?? '').trim();
      q('[data-reveal-why]').classList.toggle('mp-hide', !why);
      q('[data-reveal-why] span').textContent = why;
      const s = standing();
      q('[data-stand-rank]').textContent = s.rank ? `المركز ${s.rank} من ${s.total}` : '';
      q('[data-stand-gap]').innerHTML = gapText();
      show('reveal');
      if (fresh) {
        pop(v);
        if (award) { if (correct) { sfx.correct(); vibrate([20, 40, 30]); } else { sfx.wrong(); vibrate(60); } }
      }
      const idx = Number(qIndex);
      await ensureResults(idx);
      const streak = streakNow(idx);
      q('[data-streak]').classList.toggle('mp-hide', streak < 2);
      q('[data-streak-text]').textContent = streak === 2 ? 'إجابتان صحيحتان متتاليتان'
        : streak <= 10 ? `${streak} إجابات صحيحة متتالية` : `${streak} إجابة صحيحة متتالية`;
    }

    // ── Standings ──────────────────────────────────────────────────────────
    function renderBoard() {
      const s = standing();
      q('[data-board-q]').textContent = String(Number(meta?.currentQuestionIndex ?? 0) + 1);
      q('[data-board-rank]').textContent = String(s.rank || '؟');
      q('[data-board-total]').textContent = String(s.total);
      const moved = rankBefore && s.rank ? rankBefore - s.rank : 0;
      const mv = q('[data-board-move]');
      mv.className = 'mp-move ' + (moved > 0 ? 'up' : 'dn');
      // Arabic number agreement: one, two, 3 to 10, 11 and up.
      const places = (n: number) => n === 1 ? 'مركزًا' : n === 2 ? 'مركزين' : n <= 10 ? `${n} مراكز` : `${n} مركزًا`;
      mv.textContent = moved > 0 ? `صعدت ${places(moved)}` : moved < 0 ? `نزلت ${places(-moved)}` : '';
      q('[data-board-gap]').innerHTML = gapText();
      const top = q('[data-board-top]'); top.textContent = '';
      [...participants].sort((a, b) => b.score - a.score).slice(0, 3).forEach((p, i) => {
        const row = document.createElement('div');
        if (p.uid === uid) row.className = 'me';
        row.innerHTML = `<span class="r">${i + 1}</span><img alt="" src="${avatarUrl(p.avatar)}"><span class="n"></span><span class="s">${p.score}</span>`;
        row.querySelector('.n')!.textContent = p.name;
        top.appendChild(row);
      });
      show('board');
      pop(q('[data-board-rank]'));
    }

    // ── Podium ─────────────────────────────────────────────────────────────
    let celebrated = false;
    async function renderPodium() {
      stopTick();
      store.del('mj-session');
      const s = standing(); const mine = me();
      q('[data-final-rank]').textContent = String(s.rank || '؟');
      q('[data-final-total]').textContent = String(s.total);
      q('[data-final-score]').textContent = String(mine?.score ?? 0);
      q('[data-final-correct]').textContent = String(mine?.correct ?? 0);
      const medal = q<HTMLImageElement>('[data-final-medal]');
      const medalName = s.rank === 1 ? '1st' : s.rank === 2 ? '2nd' : s.rank === 3 ? '3rd' : '';
      medal.classList.toggle('mp-hide', !medalName || s.total < 2);
      if (medalName) medal.src = `/majlis-fx/${medalName}-place-medal.png`;
      show('podium');
      if (!celebrated) {
        celebrated = true;
        track('majlis_web_game_completed', { rank: s.rank, players: s.total });
        if (s.rank > 0 && s.rank <= 3 && s.total >= 2) { pop(medal); confetti(); sfx.finish(1); vibrate([30, 60, 30]); }
        else sfx.finish(0.5);
        // XP for signed-in players, once per majlis (idempotent server-side),
        // with the app's rules: played, plus top three when 3 or more played.
        const user = auth.currentUser;
        if (user && !user.isAnonymous) {
          callMajlis('awardXP', { source: 'majalis_played', idempotencyKey: `majalis_played_${roomId}` })
            .then(() => q('[data-final-xp]').classList.remove('mp-hide')).catch(() => {});
          if (s.rank > 0 && s.rank <= 3 && s.total >= 3) {
            callMajlis('awardXP', { source: 'majalis_top3', idempotencyKey: `majalis_top3_${roomId}` }).catch(() => {});
          }
        }
      }
    }

    // ── Review: every question with my answer and the explanation ──────────
    q('[data-open-review]').addEventListener('click', openReview);
    q('[data-review-back]').addEventListener('click', () => show('podium'));
    async function openReview() {
      const list = q('[data-review-list]');
      list.textContent = '';
      showWait('نجهّز مراجعتك', 'لحظات…');
      const count = Number(meta?.qCount ?? 0);
      let mine: Record<string, string> = {};
      try { mine = JSON.parse(store.get(`mj-ans:${roomId}`) ?? '{}'); } catch { /* none */ }
      const items = await Promise.all([...Array(count).keys()].map(async (i) => {
        try {
          const [pq, rv] = await Promise.all([get(ref(db, `rooms/${roomId}/publicQ/${i}`)), get(ref(db, `rooms/${roomId}/reveal/${i}`))]);
          return rv.exists() ? { i, q: pq.val(), r: rv.val() } : null;
        } catch { return null; }
      }));
      const played = items.filter(Boolean) as Array<{ i: number; q: any; r: any }>;
      let right = 0;
      for (const it of played) {
        const a = it.r?.awarded?.[uid];
        if (a?.correct) right++;
        const card = document.createElement('article');
        card.className = 'mp-card mp-rv-item';
        const tag = a ? (a.correct ? '<span class="mp-tag ok">صحيحة</span>' : '<span class="mp-tag no">خطأ</span>') : '<span class="mp-tag none">لم تُجب</span>';
        card.innerHTML = `<div class="mp-rv-head"><span class="mp-qnum">السؤال ${it.i + 1}</span>${tag}</div>`;
        const sentence = String(it.q?.sourceText ?? '');
        if (sentence && it.q?.type !== 'arrange_irab') {
          const p = document.createElement('p'); p.className = 'mp-sentence'; sentenceInto(p, sentence, String(it.q?.questionText ?? '')); card.appendChild(p);
        }
        const qt = document.createElement('p'); qt.className = 'mp-qtext'; qt.textContent = String(it.q?.questionText ?? ''); card.appendChild(qt);
        const line = (k: string, v: string) => { const p = document.createElement('p'); p.className = 'mp-rv-line'; p.innerHTML = `<span>${k}: </span>`; p.append(document.createTextNode(v)); card.appendChild(p); };
        if (mine[String(it.i)]) line('إجابتك', mine[String(it.i)]);
        line('الصحيح', String(it.r?.correctDisplay ?? ''));
        const why = String(it.r?.explanation ?? '').trim();
        if (why) { const p = document.createElement('p'); p.className = 'mp-why'; p.innerHTML = '<b>التعليل: </b>'; p.append(document.createTextNode(why)); card.appendChild(p); }
        if (sentence) {
          const a2 = document.createElement('a'); a2.className = 'mp-link'; a2.href = `/tool?s=${encodeURIComponent(sentence)}`; a2.textContent = 'أعرب الجملة كاملة';
          a2.addEventListener('click', () => track('majlis_web_review_analyze'));
          card.appendChild(a2);
        }
        list.appendChild(card);
      }
      q('[data-review-sum]').textContent = played.length
        ? `أجبت صوابًا عن ${right} من ${played.length}. اقرأ تعليل كل سؤال، وأعرب جمله كاملة إن شئت.`
        : 'لم نجد أسئلة هذا المجلس. ربما أُغلق منذ مدة.';
      track('majlis_web_review_opened', { questions: played.length });
      show('review');
    }

    // ── Terminal ───────────────────────────────────────────────────────────
    function terminal(title: string, body: string) {
      joined = false;
      unsubs.forEach((u) => u()); unsubs = [];
      stopTick();
      try { wake?.release?.(); } catch { /* ignore */ }
      q('[data-terminal-title]').textContent = title;
      q('[data-terminal-body]').textContent = body;
      show('terminal');
      store.del('mj-session');
    }
  }
</script>
