---
/**
 * Pricing: /pricing and /en/pricing.
 *
 * Two plans side by side: Irab Plus first (the decision the page exists for),
 * Free beside it. Plus holds its own billing choice as two option rows, so the
 * price, the button and the small print change together and the Free card,
 * which has no billing, never pretends to react. The choice is two radios and
 * :has(), so it works before (and without) any script, and the page stays
 * Firebase-free: the buttons carry the plan to /app?checkout=…, which signs in
 * and opens Paddle.
 *
 * Below: a grouped comparison that becomes stacked rows on a phone, the
 * pre-purchase questions beside their heading, and one closing call.
 * Solid surfaces only, the site's tokens in both themes, motion from the
 * site's own reveal and accordion scripts.
 */
import * as I from '../../lib/irab/icons';
import { pricingFaqs } from '../../lib/pricing';

interface Props { lang?: 'ar' | 'en'; }
const { lang = 'ar' } = Astro.props;
const en = lang === 'en';
const dir = en ? 'ltr' : 'rtl';
const base = en ? '/en' : '';

type Cell = string | true | null;
interface Row { f: string; d?: string; free: Cell; plus: Cell; }
interface Group { title: string; rows: Row[]; }

const s = en
  ? {
      eyebrow: 'Pricing',
      title: 'Start free. Unlock everything when you need it.',
      lead: 'One subscription on your account unlocks Irab Plus on the web and in the iOS and Android apps.',
      plusBadge: 'Irab Plus',
      plusName: 'Everything, without daily limits',
      cycle: 'Billing period',
      annual: 'Annual', monthly: 'Monthly',
      save: 'Save 40%',
      annualNote: 'About $3.00 a month · 7-day free trial',
      monthlyNote: 'Flexible, month to month',
      perYear: '/ year', perMonth: '/ month',
      ctaAnnual: 'Start the free trial', ctaMonthly: 'Subscribe monthly',
      memberCta: 'Go to your account',
      memberNote: 'Your Irab Plus subscription is active on web and mobile with the same account.',
      fineAnnual: "You pay $0.00 today. Cancel before day 7 and you won't be charged.",
      fineMonthly: 'Renews every month. Cancel whenever you like.',
      plusList: [
        'Everything in Free, with no daily limits',
        'Deep analysis of every sentence',
        'The full practice bank (576 sentences) and all seven challenge babs',
        'Bigger majalis with every question type',
        'OCR camera and PDF export',
        'Mastery certificates on the annual plan',
      ],
      freeName: 'Free',
      freePrice: '$0',
      freeSub: 'For everyone learning. No card needed.',
      freeCta: 'Create a free account',
      freeList: [
        "5 i'rab analyses a day",
        "3 gradings of your own i'rab a day",
        '5 questions to the teacher a day',
        'Practice levels 1–2 and challenge babs 1–2',
        'One majlis every 24 hours',
        'The whole grammar library',
      ],
      trust: ['Secure payment through Paddle', 'Cancel anytime', 'One account for web and app'],
      fine1: 'Regional prices may vary, and tax is added at checkout based on your country. Payments are processed by',
      fine2: '(Merchant of Record). See the',
      refund: 'refund policy', and: 'and', terms: 'terms',
      compareEyebrow: 'Compare',
      compareTitle: 'What each plan includes',
      colFeature: 'Feature', colFree: 'Free', colPlus: 'Plus',
      included: 'Included', notIncluded: 'Not included',
      faqEyebrow: 'Questions',
      faqTitle: 'Before you subscribe',
      faqLead: "Can't find your answer? Write to us and a person will reply.",
      finalTitle: 'Try Plus free for 7 days.',
      finalLead: "You pay nothing today, and you'll feel the difference from the first sentence you parse.",
      finalCta: 'Start your free trial',
      finalFine: '7 days free, then $35.99 a year · Cancel anytime',
    }
  : {
      eyebrow: 'الأسعـــار',
      title: 'ابدأ مجانًا، وافتح كلَّ شيء حين تحتاجه.',
      lead: 'اشتراكٌ واحد بحسابك يفتح إعراب بلس على الموقع وفي تطبيقَي iOS وAndroid.',
      plusBadge: 'إعراب بلس',
      plusName: 'كلُّ شيء، بلا حدود يومية',
      cycle: 'مدة الاشتراك',
      annual: 'سنوي', monthly: 'شهري',
      save: 'وفّر ٤٠٪',
      annualNote: 'نحو ٣٫٠٠$ شهريًّا · تجربة مجانية ٧ أيام',
      monthlyNote: 'مرونة كاملة، شهرًا بشهر',
      perYear: '/ سنويًّا', perMonth: '/ شهريًّا',
      ctaAnnual: 'ابدأ التجربة المجانية', ctaMonthly: 'اشترك شهريًّا',
      memberCta: 'اذهب إلى حسابك',
      memberNote: 'اشتراكك في إعراب بلاس فعّال على الويب والتطبيق بالحساب نفسه.',
      fineAnnual: 'تدفع ٠٫٠٠$ اليوم. ألغِ قبل اليوم السابع ولن تُحاسَب.',
      fineMonthly: 'يتجدّد كل شهر، وتلغيه متى شئت.',
      plusList: [
        'كل ما في المجاني، بلا حدود يومية',
        'الإعراب المعمّق لكل جملة',
        'بنك التدريب كاملًا (٥٧٦ جملة) وكل أبواب التحدّي السبعة',
        'مجالس أكبر بكل أنواع الأسئلة',
        'الكاميرا وتصدير PDF',
        'شهادات الإتقان مع الخطة السنوية',
      ],
      freeName: 'المجاني',
      freePrice: 'مجانًا',
      freeSub: 'لكل من يتعلّم، بلا بطاقة دفع.',
      freeCta: 'أنشئ حسابًا مجانيًّا',
      freeList: [
        '٥ تحليلات إعرابية يوميًّا',
        '٣ تقييمات لإعرابك يوميًّا',
        '٥ أسئلة للأستاذ يوميًّا',
        'المستويان ١–٢ من بنك التدريب، والبابان ١–٢ من التحديات',
        'مجلس إعراب كل ٢٤ ساعة',
        'المكتبة النحوية كاملة',
      ],
      trust: ['دفعٌ آمن عبر Paddle', 'ألغِ متى شئت', 'حسابٌ واحد للويب والتطبيق'],
      fine1: 'قد تختلف الأسعار الإقليمية، وتُضاف الضرائب عند الدفع حسب بلدك. يعالج الدفعَ',
      fine2: '(بائع التسجيل). راجع',
      refund: 'سياسة الاسترداد', and: 'و', terms: 'الشروط',
      compareEyebrow: 'المقارنة',
      compareTitle: 'ماذا تتضمّن كل خطة',
      colFeature: 'الميزة', colFree: 'المجاني', colPlus: 'بلس',
      included: 'مضمّن', notIncluded: 'غير متاح',
      faqEyebrow: 'أسئلة',
      faqTitle: 'قبل أن تشترك',
      faqLead: 'لم تجد جوابك؟ راسلنا وسيردّ عليك شخصٌ من فريقنا.',
      finalTitle: 'جرّب بلس سبعة أيام، مجانًا.',
      finalLead: 'لن تدفع شيئًا اليوم، وستشعر بالفرق من أول جملةٍ تُعربها.',
      finalCta: 'ابدأ تجربتك المجانية',
      finalFine: '٧ أيام مجانًا ثم ٣٥٫٩٩$ سنويًّا · ألغِ في أيّ وقت',
    };

const groups: Group[] = en
  ? [
      { title: "I'rab", rows: [
        { f: "I'rab analyses", d: 'Word by word: type, role, case marker and vocalization.', free: '5 a day', plus: 'Unlimited' },
        { f: 'Deep analysis', d: 'Each clause and its place, other valid readings, morphology and the rule.', free: null, plus: true },
        { f: "Grading your own i'rab", d: 'Write the i\'rab yourself and get every word corrected.', free: '3 a day', plus: 'Unlimited, with per-word explanations' },
        { f: 'Ask the teacher', d: 'Ask about any word in your sentence and get the reason, with an example.', free: '5 questions a day', plus: 'Unlimited' },
        { f: 'Smart Dictionary', d: "A word's meaning, root, pattern and how it is parsed.", free: '5 a day (10 in your first week)', plus: 'Unlimited' },
      ] },
      { title: 'Practice', rows: [
        { f: 'Practice bank', d: 'Curated sentences across progressive levels.', free: 'Levels 1–2', plus: 'All 576 sentences' },
        { f: 'Challenge babs', d: 'Challenges by topic, with an explanation for every answer.', free: 'Babs 1–2', plus: 'All seven babs' },
      ] },
      { title: 'Majalis', rows: [
        { f: 'Hosting majalis', d: 'Live i\'rab quizzes for your class or friends.', free: '1 every 24 hours, up to 10 questions and 20 players', plus: '10 a day, up to 50 questions and 100 players' },
        { f: 'Question types', free: 'Multiple choice and true or false', plus: "Every type, including fix-the-mistake and order-the-i'rab" },
        { f: 'AI questions', free: '10 a day', plus: '100 a day, from your text or a book photo, with smart review' },
      ] },
      { title: 'Tools and extras', rows: [
        { f: 'Grammar library', d: '47 classical books, readable in full.', free: true, plus: true },
        { f: 'OCR camera and PDF export', d: 'Capture a page from your book, parse it, export your analyses.', free: null, plus: true },
        { f: 'Mastery certificates', d: 'A shareable certificate after mastering each topic.', free: null, plus: 'With the annual plan' },
      ] },
    ]
  : [
      { title: 'الإعراب', rows: [
        { f: 'التحليلات الإعرابية', d: 'كلمة بكلمة: النوع والوظيفة والعلامة والتشكيل.', free: '٥ يوميًّا', plus: 'غير محدودة' },
        { f: 'الإعراب المعمّق', d: 'إعراب الجمل ومحلّها، والأوجه الأخرى، والصرف، والقاعدة.', free: null, plus: true },
        { f: 'تقييم إعرابك الخاص', d: 'أعرِب بنفسك واحصل على تصحيحٍ لكل كلمة.', free: '٣ يوميًّا', plus: 'بلا حدود، مع شرحٍ لكل كلمة' },
        { f: 'اسأل الأستاذ', d: 'اسأل عن أي كلمة في جملتك فيشرح لك السبب مع مثال.', free: '٥ أسئلة يوميًّا', plus: 'بلا حدود' },
        { f: 'المعجم الذكي', d: 'معنى الكلمة وجذرها ووزنها وكيف تُعرب.', free: '٥ يوميًّا (١٠ في أسبوعك الأول)', plus: 'بلا حدود' },
      ] },
      { title: 'التدريب', rows: [
        { f: 'بنك التدريب', d: 'جملٌ منتقاة بمستويات متدرّجة.', free: 'المستويان ١–٢', plus: '٥٧٦ جملة كاملة' },
        { f: 'أبواب التحدّيات', d: 'تحدّيات مبوّبة مع شرحٍ لكل إجابة.', free: 'البابان ١–٢', plus: 'كل الأبواب السبعة' },
      ] },
      { title: 'مجالس الإعراب', rows: [
        { f: 'استضافة المجالس', d: 'مسابقات إعراب مباشرة لصفّك أو أصدقائك.', free: 'مجلس كل ٢٤ ساعة، حتى ١٠ أسئلة و٢٠ لاعبًا', plus: '١٠ مجالس يوميًّا، حتى ٥٠ سؤالًا و١٠٠ لاعب' },
        { f: 'أنواع الأسئلة', free: 'اختيار من متعدد وصواب وخطأ', plus: 'كل الأنواع، ومنها صحّح الخطأ وترتيب الإعراب' },
        { f: 'أسئلة بالذكاء الاصطناعي', free: '١٠ يوميًّا', plus: '١٠٠ يوميًّا، مع التوليد من نصك أو صورة الكتاب والمراجعة الذكية' },
      ] },
      { title: 'أدوات وإضافات', rows: [
        { f: 'المكتبة النحوية', d: '٤٧ كتابًا كلاسيكيًّا تُقرأ كاملة.', free: true, plus: true },
        { f: 'الكاميرا وتصدير PDF', d: 'صوّر صفحة من كتابك وأعرِب جملها، وصدّر تحليلاتك.', free: null, plus: true },
        { f: 'شهادات الإتقان', d: 'شهادة قابلة للمشاركة بعد إتقان كل موضوع.', free: null, plus: 'مع الخطة السنوية' },
      ] },
    ];

const faqList = pricingFaqs(lang);

// Prices: the whole part and the cents, so the cents can sit as a raised
// fraction. At display size the Arabic decimal separator reads as a comma
// between two numbers; the raised cents read as one price.
const price = en
  ? { annual: ['$35', '.99'], monthly: ['$4', '.99'] }
  : { annual: ['$٣٥', '٫٩٩'], monthly: ['$٤', '٫٩٩'] };

const tick = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>';
const dash = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 12h12"/></svg>';
// "Onward": left in Arabic, right in English.
const arrow = `<svg class="pr-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${en ? 'M5 12h14m-7-7 7 7-7 7' : 'M19 12H5m7-7-7 7 7 7'}"/></svg>`;
const trustIcons = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10.5" width="16" height="10" rx="2.5"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v4h4"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4.5" width="13" height="10" rx="1.8"/><path d="M6 18.5h6"/><rect x="16" y="8" width="5.5" height="11" rx="1.4"/></svg>',
];
const cellHtml = (v: Cell, plus: boolean) => v === true
  ? `<span class="pr-yes${plus ? ' is-plus' : ''}" role="img" aria-label="${s.included}">${tick}</span>`
  : v === null
    ? `<span class="pr-no" role="img" aria-label="${s.notIncluded}">${dash}</span>`
    : v;
---

<div class="pr" dir={dir} lang={lang}>
  {/* ── Hero ─────────────────────────────────────────────────────────── */}
  <header class="pr-hero">
    <p class="pr-eyebrow">{s.eyebrow}</p>
    <h1 class="pr-title">{s.title}</h1>
    <p class="pr-lead">{s.lead}</p>
  </header>

  {/* ── Plans ────────────────────────────────────────────────────────── */}
  <div class="pr-plans">
    <article class="pr-plan pr-plus spot-card" aria-labelledby="pr-plus-name">
      <span class="pr-badge"><Fragment set:html={I.crown} />{s.plusBadge}</span>
      <h2 id="pr-plus-name" class="pr-plan-name">{s.plusName}</h2>

      <fieldset class="pr-cycle">
        <legend class="sr-only">{s.cycle}</legend>
        <label class="pr-opt">
          <input type="radio" name="pr-cycle" value="annual" class="pr-radio" checked />
          <span class="pr-dot" aria-hidden="true"></span>
          <span class="pr-opt-main">
            <span class="pr-opt-name">{s.annual}<span class="pr-save">{s.save}</span></span>
            <span class="pr-opt-note">{s.annualNote}</span>
          </span>
          <span class="pr-opt-price"><bdi dir="ltr" class="pr-num">{price.annual[0]}<span class="pr-frac">{price.annual[1]}</span></bdi><span class="pr-per">{s.perYear}</span></span>
        </label>
        <label class="pr-opt">
          <input type="radio" name="pr-cycle" value="monthly" class="pr-radio" />
          <span class="pr-dot" aria-hidden="true"></span>
          <span class="pr-opt-main">
            <span class="pr-opt-name">{s.monthly}</span>
            <span class="pr-opt-note">{s.monthlyNote}</span>
          </span>
          <span class="pr-opt-price"><bdi dir="ltr" class="pr-num">{price.monthly[0]}<span class="pr-frac">{price.monthly[1]}</span></bdi><span class="pr-per">{s.perMonth}</span></span>
        </label>
      </fieldset>

      {/* Both calls are in the page; the chosen one shows. Stacked in one grid
          cell so switching is a cross-fade with no jump in height. */}
      <div class="pr-ctas">
        <div class="pr-cta is-annual">
          <a href={`${base}/app?checkout=annual`} class="btn-primary btn-block btn-lg">{s.ctaAnnual}<Fragment set:html={arrow} /></a>
          <p class="pr-cta-fine">{s.fineAnnual}</p>
        </div>
        <div class="pr-cta is-monthly">
          <a href={`${base}/app?checkout=monthly`} class="btn-primary btn-block btn-lg">{s.ctaMonthly}<Fragment set:html={arrow} /></a>
          <p class="pr-cta-fine">{s.fineMonthly}</p>
        </div>
        <div class="pr-cta pr-member">
          <a href={`${base}/app`} class="btn-primary btn-block btn-lg">{s.memberCta}<Fragment set:html={arrow} /></a>
          <p class="pr-cta-fine">{s.memberNote}</p>
        </div>
      </div>

      <ul class="pr-list is-plus">
        {s.plusList.map((li) => <li><span class="pr-li-ic" set:html={tick} />{li}</li>)}
      </ul>
    </article>

    <article class="pr-plan pr-free spot-card" aria-labelledby="pr-free-name">
      <h2 id="pr-free-name" class="pr-free-name">{s.freeName}</h2>
      {/* Arabic says «مجانًا»: a lone Arabic zero (٠) is a dot and «$٠» read as «$ •». */}
      <p class="pr-free-price">{en ? <bdi dir="ltr" class="pr-num">{s.freePrice}</bdi> : <span class="pr-num">{s.freePrice}</span>}</p>
      <p class="pr-free-sub">{s.freeSub}</p>
      <a href={`${base}/login?mode=up`} class="btn-ghost btn-block btn-lg pr-free-cta">{s.freeCta}</a>
      <ul class="pr-list">
        {s.freeList.map((li) => <li><span class="pr-li-ic" set:html={tick} />{li}</li>)}
      </ul>
    </article>
  </div>

  <ul class="pr-trust">
    {s.trust.map((t, i) => <li><span class="pr-trust-ic" set:html={trustIcons[i]} />{t}</li>)}
  </ul>
  <p class="pr-fine">
    {s.fine1} <strong>Paddle</strong> {s.fine2} <a href={`${base}/refund`}>{s.refund}</a> {s.and} <a href={`${base}/terms`}>{s.terms}</a>.
  </p>

  {/* ── Comparison ───────────────────────────────────────────────────── */}
  <section class="pr-section" aria-labelledby="pr-compare-h">
    <header class="pr-sec-head" data-reveal>
      <p class="pr-sec-eyebrow">{s.compareEyebrow}</p>
      <h2 id="pr-compare-h" class="pr-sec-title">{s.compareTitle}</h2>
    </header>
    <div class="pr-table-wrap" data-reveal>
      <table class="pr-table">
        <thead>
          <tr>
            <th scope="col" class="pr-th-f">{s.colFeature}</th>
            <th scope="col">{s.colFree}</th>
            <th scope="col" class="is-plus">{s.colPlus}</th>
          </tr>
        </thead>
        {groups.map((g) => (
          <tbody>
            <tr class="pr-group"><th scope="rowgroup" colspan="3">{g.title}</th></tr>
            {g.rows.map((r) => (
              <tr>
                <th scope="row" class="pr-feat">
                  <span class="pr-feat-name">{r.f}</span>
                  {r.d && <span class="pr-feat-desc">{r.d}</span>}
                </th>
                <td data-label={s.colFree}><span class="pr-val" set:html={cellHtml(r.free, false)} /></td>
                <td data-label={s.colPlus} class="is-plus"><span class="pr-val" set:html={cellHtml(r.plus, true)} /></td>
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
  </section>

  {/* ── FAQ ──────────────────────────────────────────────────────────── */}
  <section class="pr-section pr-faq" aria-labelledby="pr-faq-h">
    <header class="pr-faq-head" data-reveal>
      <p class="pr-sec-eyebrow">{s.faqEyebrow}</p>
      <h2 id="pr-faq-h" class="pr-sec-title">{s.faqTitle}</h2>
      <p class="pr-faq-lead">{s.faqLead}</p>
      <a href="mailto:support@irab.app" class="pr-mail" dir="ltr">support@irab.app</a>
    </header>
    <div class="pr-faq-list" data-acc-group data-reveal>
      {faqList.map((f) => (
        <details class="pr-q" data-acc>
          <summary>
            <h3>{f.q}</h3>
            <span class="acc-icon pr-q-ic" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path class="acc-v" d="M12 5v14"/><path d="M5 12h14"/></svg>
            </span>
          </summary>
          <div><p class="pr-a">{f.a}</p></div>
        </details>
      ))}
    </div>
  </section>

  {/* ── Closing call ─────────────────────────────────────────────────── */}
  <section class="pr-final" data-reveal>
    <h2 class="pr-final-title">{s.finalTitle}</h2>
    <p class="pr-final-lead">{s.finalLead}</p>
    <a href={`${base}/app?checkout=annual`} class="pr-final-btn" data-magnetic>{s.finalCta}<Fragment set:html={arrow} /></a>
    <p class="pr-final-fine">{s.finalFine}</p>
  </section>
</div>

<style>
  .pr {
    --pr-surface: var(--color-card);
    --pr-edge: var(--color-card-edge);
    --pr-sunken: var(--color-paper-soft);
    --pr-text: var(--color-ink);
    --pr-muted: var(--color-ink-muted);
    --pr-subtle: var(--color-ink-subtle);
    --pr-accent: var(--color-purple);
    --pr-accent-text: var(--color-purple-deep);
    --pr-accent-soft: color-mix(in srgb, var(--color-purple) 7%, var(--color-card));
    --pr-accent-line: color-mix(in srgb, var(--color-purple) 30%, var(--color-card-edge));
    --pr-teal: var(--color-teal);
