          renderAll(); touch();
          sentenceIn.focus();
        });
        q('[data-dup]').addEventListener('click', () => {
          if (!canAdd()) return;
          const c: Item = {
            ...sel, id: freshId(), mcq: [...sel.mcq], fixDecoys: [...sel.fixDecoys], arr: [...sel.arr],
            bank: false, lastGood: undefined, order: sel.order ? { ...sel.order } : undefined,
            raw: sel.raw ? { ...sel.raw } : undefined,
