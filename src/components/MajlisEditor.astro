        whyIn.addEventListener('input', () => { sel.why = whyIn.value; refreshCurrentRail(); touch(); });
        titleInput.addEventListener('input', () => { titleCustom = titleInput.value.trim().length > 0; touch(); });

        // Harakat: typed into whichever field was last in use.
        let lastField: HTMLInputElement | HTMLTextAreaElement = sentenceIn;
        q('[data-canvas]').addEventListener('focusin', (e) => {
