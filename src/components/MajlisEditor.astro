          try {
            const s = await fs.getDocs(fs.query(fs.collection(db, 'majalis_bank', uid, 'questions'), fs.limit(200)));
            bankDocs = s.docs.flatMap((d) => { try { return [d.data()]; } catch { return []; } });
          } catch { bankDocs = []; }
          renderBank();
        });

        // ═══ AI generation (contract: AI Generation + Quotas section) ═════
        const API_PRIMARY = 'https://api.irab.app';
        const API_FALLBACK = 'https://irab-api-v2.mansourhassan783.workers.dev';
        // Fallback host only on network-level failure (never 4xx/5xx, never
        // timeout); one full retry after a forced token refresh on 401.
        async function workerPost(path: string, body: any, timeoutMs = 60000): Promise<Response> {
          const attempt = async (base: string, token: string) => {
            const ctl = new AbortController();
            const t = setTimeout(() => ctl.abort(), timeoutMs);
            try {
              return await fetch(base + path, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json; charset=utf-8', Authorization: `Bearer ${token}` },
                body: JSON.stringify(body),
                signal: ctl.signal,
              });
            } finally { clearTimeout(t); }
          };
          const run = async (token: string) => {
            try { return await attempt(API_PRIMARY, token); }
            catch (e: any) {
              if (e?.name === 'AbortError') throw e;
              return attempt(API_FALLBACK, token);
            }
          };
          let res = await run(await user.getIdToken());
          if (res.status === 401) res = await run(await user.getIdToken(true));
          return res;
        }

        const AI_TOPICS = ['المبتدأ والخبر', 'كان وأخواتها', 'إن وأخواتها', 'الفاعل والمفعول به', 'الحال والتمييز', 'الجار والمجرور', 'الأفعال الخمسة', 'المنصوبات'];
        const AI_SOURCES: Array<{ key: string; label: string; free: boolean }> = [
          { key: 'topic', label: 'موضوع', free: true },
          { key: 'text', label: 'من نص', free: false },
          { key: 'photo', label: 'صورة من الكتاب', free: false },
          { key: 'review', label: 'مراجعة ذكية', free: false },
        ];
        const AI_STEPS = ['نقرأ المصدر ونحدد المفاهيم', 'نصوغ الأسئلة بأنواعها', 'ندقق الإعراب والإجابات', 'نجهز الأسئلة لمجلسك'];

        // The generator's question patterns (the skill each card tests), as
        // in the app (lib/features/majalis/logic/majlis_patterns.dart) and the
        // Worker (cloudflare-workers/src/lib/majalis_patterns.ts).
        const AI_PATTERNS: { id: string; name: string; hint: string; levels: string[]; types: string[] }[] = [
          { id: 'direct', name: 'إعراب مباشر', hint: 'ما إعراب كلمة في جملة؛ للتثبيت.', levels: ['beginner', 'intermediate', 'advanced'], types: ['mcq', 'true_false', 'arrange_irab'] },
          { id: 'intruder', name: 'الدخيل والفخ', hint: 'أيّ الجمل أو الألفاظ من الباب، والبقية من أبواب تشبهه.', levels: ['beginner', 'intermediate', 'advanced'], types: ['mcq', 'true_false'] },
          { id: 'role', name: 'نوع اللفظ في سياقه', hint: 'اللفظ نفسه تامّ أو ناقص أو زائد، عامل أو مهمل، بحسب موقعه.', levels: ['intermediate', 'advanced'], types: ['mcq', 'true_false'] },
          { id: 'rule', name: 'القاعدة وشرطها', hint: 'عبارة عن قاعدة أو شرط أو استثناء، والتعليل يبيّن الصواب.', levels: ['beginner', 'intermediate', 'advanced'], types: ['true_false', 'mcq'] },
          { id: 'order', name: 'الرتبة والتقديم', hint: 'متى يتقدّم الخبر أو يتأخّر جوازًا أو وجوبًا، وما له الصدارة.', levels: ['intermediate', 'advanced'], types: ['mcq', 'true_false'] },
          { id: 'pair', name: 'جملتان متشابهتان', hint: 'جملتان تختلفان في لفظ واحد، والسؤال عن أثر الفرق.', levels: ['beginner', 'intermediate', 'advanced'], types: ['mcq', 'true_false'] },
          { id: 'shahid', name: 'شاهد يحتاج تأمّلًا', hint: 'آية أو شاهد مشهور، والسؤال عن موضع يحتاج نظرًا.', levels: ['intermediate', 'advanced'], types: ['mcq', 'true_false'] },
          { id: 'ellipsis', name: 'الحذف والتقدير', hint: 'أين المحذوف، وما تقديره، ولماذا جاء الإعراب هكذا.', levels: ['advanced'], types: ['mcq'] },
          { id: 'rank', name: 'رتّب', hint: 'رتّب أجزاء إعراب لفظ معرب.', levels: ['intermediate', 'advanced'], types: ['arrange_irab'] },
          { id: 'fix', name: 'صحّح الخطأ', hint: 'جملة فيها خطأ واحد في تطبيق قاعدة الباب.', levels: ['beginner', 'intermediate', 'advanced'], types: ['fix_error'] },
        ];
        const patternsFor = () => AI_PATTERNS.filter((p) => p.levels.includes(aiDiff) && p.types.some((t) => aiTypes.has(t)));

        let aiSrc = 'topic';
        const aiTopics = new Set<string>();
        const aiTypes = new Set<string>(['mcq', 'true_false']);
        // The teacher's «نمط الأسئلة»; empty: mixed by level.
        const aiPatterns = new Set<string>();
        let aiDiff = 'intermediate';
        let aiCount = 5;
        let aiQuota: { used: number; limit: number; remaining: number } | null = null;
        let ocrDone = false;
        let weakFocus = '';
        let aiBusy = false;
        let stepTimer: ReturnType<typeof setInterval> | null = null;

        const aiDrawer = q('[data-ai-drawer]');
        const aiErrEl = q('[data-ai-err]');
        const aiText = q<HTMLTextAreaElement>('[data-ai-text]');
        const aiTopicFree = q<HTMLInputElement>('[data-ai-topic-free]');
        const aiConfirm = q('[data-ai-confirm]');
        const aiErr = (m: string) => { aiErrEl.textContent = m; aiErrEl.hidden = false; };
        const aiClearErr = () => { aiErrEl.hidden = true; aiConfirm.hidden = true; };

        function chip(label: string, on: boolean, locked: boolean, click: () => void, cls = 'me-chip') {
          const b = document.createElement('button');
          b.type = 'button'; b.className = cls;
          b.setAttribute('aria-pressed', String(on));
          b.innerHTML = `<span></span>${locked ? PLUS_CHIP : ''}`;
          b.firstElementChild!.textContent = label;
          b.addEventListener('click', click);
          return b;
        }

        function renderAiControls() {
          const seg = q('[data-ai-src-seg]');
          seg.textContent = '';
          for (const s of AI_SOURCES) {
            const locked = !isPremium && !s.free;
            seg.appendChild(chip(s.label, aiSrc === s.key, locked, () => {
              aiClearErr();
              if (locked) { paywall(); return; }
              const was = aiSrc; aiSrc = s.key;
              // Entering photo mode clears stale text + the OCR-done flag (app parity).
              if (s.key === 'photo' && was !== 'photo') { aiText.value = ''; ocrDone = false; q('[data-ai-ocr-status]').textContent = ''; }
              if (s.key === 'review') mineWeakPoints();
              renderAiControls();
            }));
          }
          q('[data-ai-topic-block]').hidden = aiSrc !== 'topic';
          q('[data-ai-text-block]').hidden = aiSrc !== 'text' && aiSrc !== 'photo';
          q('[data-ai-photo-row]').hidden = aiSrc !== 'photo';
          q('[data-ai-text-label]').textContent = aiSrc === 'photo' ? 'النص المستخرج من الصورة (يمكنك تعديله)' : 'النص المصدر (من 10 إلى 1000 حرف)';
          q('[data-ai-review-block]').hidden = aiSrc !== 'review';

          const topics = q('[data-ai-topics]');
          topics.textContent = '';
          for (const t of AI_TOPICS) {
            const on = aiTopics.has(t);
            topics.appendChild(chip(t, on, false, () => { on ? aiTopics.delete(t) : aiTopics.add(t); renderAiControls(); }, 'me-chip teal'));
          }

          const diffs = q('[data-ai-diff-seg]');
          diffs.textContent = '';
          for (const [k, label] of [['beginner', 'مبتدئ'], ['intermediate', 'متوسط'], ['advanced', 'متقدم']] as const) {
            const locked = !isPremium && k === 'advanced';
            diffs.appendChild(chip(label, aiDiff === k, locked, () => {
              if (locked) { paywall(); return; }
              aiDiff = k; renderAiControls();
            }));
          }

          const typeChips = q('[data-ai-type-chips]');
          typeChips.textContent = '';
          for (const t of ['mcq', 'true_false', 'fix_error', 'arrange_irab']) {
            const locked = !isPremium && PREMIUM_TYPES.has(t);
            const on = aiTypes.has(t);
            typeChips.appendChild(chip(TYPE_LABELS[t], on, locked, () => {
              if (locked) { paywall(); return; }
              // At least one type must stay selected (app parity).
              if (on && aiTypes.size === 1) return;
              on ? aiTypes.delete(t) : aiTypes.add(t);
              renderAiControls();
            }, 'me-chip teal'));
          }
          // Patterns are for topic sets; a pattern the level or the chosen
          // forms no longer allow drops out.
          const allowed = patternsFor();
          for (const id of [...aiPatterns]) if (!allowed.some((p) => p.id === id)) aiPatterns.delete(id);
          q('[data-ai-pattern-block]').hidden = aiSrc !== 'topic';
          const pats = q('[data-ai-patterns]');
          pats.textContent = '';
          pats.appendChild(chip('منوّع حسب المستوى', aiPatterns.size === 0, false, () => { aiPatterns.clear(); renderAiControls(); }));
          for (const p of allowed) {
            const on = aiPatterns.has(p.id);
            pats.appendChild(chip(p.name, on, false, () => { on ? aiPatterns.delete(p.id) : aiPatterns.add(p.id); renderAiControls(); }));
          }
          const chosen = AI_PATTERNS.filter((p) => aiPatterns.has(p.id));
          q('[data-ai-pattern-hint]').textContent = chosen.length === 0
            ? 'يوزّع الأسئلة على مهاراتٍ مختلفة بحسب المستوى: الدخيل والفخ، والقاعدة وشرطها، وجملتان متشابهتان، وشواهد من القرآن للمتقدّم.'
            : chosen.length === 1 ? chosen[0].hint : chosen.map((p) => p.name).join('، ');

          // Who writes topic sets: Irab+ gets the strongest model.
          const writer = q('[data-ai-writer]');
          writer.hidden = aiSrc !== 'topic';
          writer.classList.toggle('free', !isPremium);
          writer.innerHTML = `${PLUS_CHIP}<span></span>`;
          writer.lastElementChild!.textContent = isPremium
            ? 'يكتب أسئلةَ مجلسك نموذجُنا الأقوى.'
            : 'مع إعراب بلس يكتب أسئلةَ مجلسك نموذجُنا الأقوى، فتأتي أعمقَ في الفهم وأدقَّ في الفخاخ.';
          writer.setAttribute('role', isPremium ? 'note' : 'button');
          writer.tabIndex = isPremium ? -1 : 0;
          q('[data-ai-c-val]').textContent = String(aiCount);
        }
        const writerEl = q('[data-ai-writer]');
        writerEl.addEventListener('click', () => { if (!isPremium) paywall(); });
        writerEl.addEventListener('keydown', (e) => { if (!isPremium && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); paywall(); } });
        q('[data-ai-c-minus]').addEventListener('click', () => { aiCount = Math.max(1, aiCount - 1); renderAiControls(); });
        q('[data-ai-c-plus]').addEventListener('click', () => { aiCount = Math.min(10, aiCount + 1); renderAiControls(); });

        async function probeAiQuota() {
          try {
            const res = await workerPost('/api/majalis-generate', { probe: true }, 20000);
            if (!res.ok) return;
            const j: any = await res.json();
            const qd = j?.data?.quota;
            if (qd && typeof qd.remaining === 'number') {
              aiQuota = { used: Number(qd.used) || 0, limit: Number(qd.limit) || 0, remaining: Number(qd.remaining) || 0 };
              const pill = q('[data-ai-quota]');
              pill.textContent = `متبقٍّ لك اليوم: ${aiQuota.remaining}.`;
              pill.hidden = false;
            }
          } catch { /* stays hidden */ }
        }

        // Smart review: mine weak points from the host's last 5 reports
        // (answeredCount > 0 and correctRate <= 0.6, worst 6 by wrong pct).
        // From the report's «مجلس علاجي»: mine that one majlis only.
        async function mineWeakPoints() {
          const wrap = q('[data-ai-weak]');
          wrap.innerHTML = `<p class="t-body-s c-word">${remedialRoom ? 'جارٍ قراءة تقرير المجلس' : 'جارٍ قراءة مجالسك الأخيرة'}</p>`;
          weakFocus = '';
          q('[data-ai-weak-label]').textContent = remedialRoom ? 'نقاط الضعف في هذا المجلس' : 'نقاط الضعف من مجالسك الأخيرة';
          try {
            const docs = remedialRoom
              ? [await fs.getDoc(fs.doc(db, 'majalis_reports', remedialRoom))].filter((d) => d.exists())
              : (await fs.getDocs(fs.query(
                fs.collection(db, 'majalis_reports'),
                fs.where('hostUid', '==', uid),
                fs.orderBy('finishedAt', 'desc'),
                fs.limit(5),
              ))).docs;
            const seen = new Set<string>();
            const weak: Array<{ label: string; wrongPct: number }> = [];
            for (const d of docs) {
              let v: any; try { v = d.data(); } catch { continue; }
              const per = Array.isArray(v?.perQuestion) ? v.perQuestion : [];
              for (const rq of per) {
                const answered = Number(rq?.answeredCount) || 0;
                const rate = Number(rq?.correctRate);
                if (answered === 0 || !(rate <= 0.6)) continue;
                const label = String(rq?.questionText ?? '') + (rq?.sourceText ? ` «${rq.sourceText}»` : '');
                if (!label.trim() || seen.has(label)) continue;
                seen.add(label);
                weak.push({ label, wrongPct: Math.round((1 - rate) * 100) });
              }
            }
            weak.sort((a, b) => b.wrongPct - a.wrongPct);
            const top = weak.slice(0, 6);
            wrap.textContent = '';
            if (!top.length) {
              wrap.innerHTML = '<p class="t-body-s c-word">لا نقاط ضعف كافية بعد. أدر بعض المجالس أولًا ثم عد إلى المراجعة الذكية.</p>';
              return;
            }
            let focus = top.map((w) => `أخطأ ${w.wrongPct}% في: ${w.label}`).join('؛');
            if (focus.length > 580) focus = focus.slice(0, 580);
            weakFocus = focus;
            top.forEach((w) => {
              const row = document.createElement('div');
              row.className = 'me-weak';
              row.textContent = `أخطأ ${w.wrongPct}% في: ${w.label}`;
              wrap.appendChild(row);
            });
          } catch {
            wrap.innerHTML = '<p class="t-body-s c-word">تعذر قراءة مجالسك. حاول مجددًا.</p>';
          }
        }

        // Photo → resize (max width 1600, JPEG 0.82) → /api/ocr → textarea.
        q<HTMLInputElement>('[data-ai-photo]').addEventListener('change', async (e) => {
          const file = (e.currentTarget as HTMLInputElement).files?.[0];
          if (!file) return;
          const status = q('[data-ai-ocr-status]');
          status.textContent = 'جارٍ قراءة الصورة';
          try {
            const bmp = await createImageBitmap(file);
            const scale = Math.min(1, 1600 / bmp.width);
            const canvas = document.createElement('canvas');
            canvas.width = Math.round(bmp.width * scale);
            canvas.height = Math.round(bmp.height * scale);
            canvas.getContext('2d')!.drawImage(bmp, 0, 0, canvas.width, canvas.height);
            const b64 = canvas.toDataURL('image/jpeg', 0.82).split(',')[1] ?? '';
            const res = await workerPost('/api/ocr', { imageBase64: b64, mimeType: 'image/jpeg' }, 60000);
            const j: any = await res.json().catch(() => null);
            if (res.status === 403) { status.textContent = ''; paywall(); return; }
            if (!res.ok) { status.textContent = 'تعذر استخراج النص. حاول بصورة أوضح.'; return; }
            const text = String(j?.data?.text ?? '').trim();
            if (text.length < 10) { status.textContent = 'لم نجد نصًّا كافيًا في الصورة. حاول بصورة أوضح.'; ocrDone = false; return; }
            aiText.value = text.slice(0, 1000);
            ocrDone = true;
            status.textContent = 'تم استخراج النص، راجعه وعدّله إن احتجت';
          } catch {
            status.textContent = 'تعذر قراءة الصورة. حاول مجددًا.';
          }
        });

        function startOverlay() {
          const ov = q('[data-ai-overlay]');
          const step = q('[data-ai-step]');
          let i = 0;
          step.textContent = AI_STEPS[0];
          ov.hidden = false;
          stepTimer = setInterval(() => { i = (i + 1) % AI_STEPS.length; step.textContent = AI_STEPS[i]; }, 1900);
        }
        function stopOverlay() {
          if (stepTimer) { clearInterval(stepTimer); stepTimer = null; }
          q('[data-ai-overlay]').hidden = true;
        }

        async function runGenerate() {
          aiClearErr();
          if (aiBusy) return;

          // Exactly one source key (server rejects none; app never sends two).
          const body: any = { count: aiCount, types: [...aiTypes], difficulty: aiDiff };
          if (aiSrc === 'topic') {
            const topic = [...aiTopics, aiTopicFree.value.trim()].filter(Boolean).join('، ');
            if (!topic) { aiErr('اختر موضوعًا أو اكتب واحدًا'); return; }
            body.topic = topic;
            if (aiPatterns.size) body.patterns = [...aiPatterns];
          } else if (aiSrc === 'text' || aiSrc === 'photo') {
            const t = aiText.value.trim();
            if (aiSrc === 'photo' && !ocrDone) { aiErr('اختر صورة أولًا ليُستخرج نصها'); return; }
            if (t.length < 10) { aiErr('اكتب نصًّا من 10 أحرف على الأقل'); return; }
            body.sourceText = t;
          } else {
            if (!weakFocus) { aiErr('لا نقاط ضعف كافية بعد. أدر بعض المجالس أولًا.'); return; }
            body.focus = weakFocus;
          }

          const room = maxQ - items.filter((x) => !isBlank(x)).length;
          if (room <= 0) { aiErr('وصل مجلسك إلى أقصى عدد من الأسئلة في خطتك.'); if (!isPremium) paywall(); return; }

          // Pre-flight quota gate: never silently short-order.
          if (aiQuota) {
            if (aiQuota.remaining <= 0) {
              aiErr('انتهت أسئلة الذكاء الاصطناعي المتاحة لك اليوم، وتتجدد غدًا.');
              if (!isPremium) paywall();
              return;
            }
            if (aiCount > aiQuota.remaining) {
              q('[data-ai-confirm-msg]').textContent = `بقي لك ${aiQuota.remaining} من حصة اليوم، وطلبت ${aiCount}.`;
              q('[data-ai-confirm-go]').textContent = `ولّد المتبقي ${aiQuota.remaining}`;
              q('[data-ai-confirm-up]').hidden = isPremium;
              aiConfirm.hidden = false;
              return;
            }
          }

          aiBusy = true;
          startOverlay();
          try {
            const res = await workerPost('/api/majalis-generate', body, 60000);
            const j: any = await res.json().catch(() => null);
            if (res.status === 429 && j?.error === 'majalis_ai_quota') {
              aiQuota = { used: Number(j.used) || 0, limit: Number(j.limit) || 0, remaining: 0 };
              aiErr('انتهت أسئلة الذكاء الاصطناعي المتاحة لك اليوم، وتتجدد غدًا.');
              if (!isPremium) paywall();
              return;
            }
            if (res.status === 403) {
              const { emailGateFor } = await import('../lib/guard');
              if (!emailGateFor(403, j)) paywall();
              return;
            }
            const maps: any[] = Array.isArray(j?.data?.questions) ? j.data.questions : [];
            if (!res.ok || !maps.length) { aiErr('تعذر التوليد. حاول مجددًا.'); return; }

            // Server-validated wire questions go into the draft VERBATIM.
            const toAdd = maps.slice(0, room).map((w) => { const it = fromWire(w); it.lastGood = w; return it; });
            insertAfterSel(...toAdd);
            const qd = j?.data?.quota;
            if (qd && typeof qd.remaining === 'number') {
              aiQuota = { used: Number(qd.used) || 0, limit: Number(qd.limit) || 0, remaining: Number(qd.remaining) || 0 };
              q('[data-ai-quota]').textContent = `متبقٍّ لك اليوم: ${aiQuota.remaining}.`;
            }
            aiDrawer.hidden = true;
            renderAll(); touch();
            track('majlis_ai_generated', { platform: 'web', count: toAdd.length, source: aiSrc });
            toast(toAdd.length < aiCount
              ? `وُلّد ${toAdd.length} من ${aiCount}. راجعها، وأضف البقية يدويًّا إن أردت.`
              : 'أُضيفت الأسئلة المولّدة إلى مجلسك. راجعها قبل الإطلاق.', undefined, 7000);
          } catch (e: any) {
            aiErr(e?.name === 'AbortError' ? 'استغرق التوليد وقتًا طويلًا. حاول مجددًا.' : 'تعذر التوليد. تحقق من اتصالك وحاول مجددًا.');
          } finally {
            aiBusy = false;
            stopOverlay();
          }
        }
        q('[data-ai-generate]').addEventListener('click', () => { runGenerate(); });
        q('[data-ai-confirm-go]').addEventListener('click', () => {
          aiCount = Math.max(1, aiQuota?.remaining ?? 1);
          aiConfirm.hidden = true;
          renderAiControls();
          runGenerate();
        });
        q('[data-ai-confirm-up]').addEventListener('click', paywall);
        q('[data-ai-confirm-cancel]').addEventListener('click', () => { aiConfirm.hidden = true; });

        function openAi() {
          aiClearErr();
          renderAiControls();
          probeAiQuota();
          openDrawer(aiDrawer);
        }
        q('[data-add-ai]').addEventListener('click', openAi);

        // ═══ Preview: the real stage ═════════════════════════════════════
        const prev = q('[data-prev]');
        let prevAt = 0; let prevMode: 'q' | 'a' = 'q';
        let unfit: (() => void) | null = null;
        function displayWire(it: Item): any {
          const r = toWire(it);
          if (r.wire) return r.wire;
          return {
            type: it.type, questionText: it.text, sourceText: it.sentence.trim() || null,
            options: it.type === 'mcq' ? it.mcq.filter((v) => v.trim())
              : it.type === 'fix_error' ? [it.fixCorrect, ...it.fixDecoys].filter((v) => v.trim())
              : it.type === 'arrange_irab' ? it.arr.filter((v) => v.trim()) : [],
            correctAnswer: {}, explanation: it.why, timeLimitSeconds: it.time,
          };
        }
        function renderPreview() {
          const list = items.filter((x) => !isBlank(x));
          const it = list[prevAt] ?? sel;
          const w = displayWire(it);
          const type = String(w.type ?? 'mcq');
          const options: string[] = (w.options ?? []).map(String);
          const sentence = String(w.sourceText ?? '');
          const c = w.correctAnswer ?? {};
          const answer = prevMode === 'a';
          q('[data-p-name]').textContent = titleInput.value.trim() || 'مجلس الإعراب';
          q('[data-p-num]').innerHTML = `السؤال <b>${prevAt + 1}</b> من ${Math.max(list.length, 1)}`;
          const wordsMode = type === 'fix_error' || type === 'tap_word' || type === 'arrange_irab';
          const sEl = q('[data-p-sent]');
          sEl.classList.toggle('ms-hide', wordsMode || !sentence);
          if (!wordsMode && sentence) sentenceInto(sEl, sentence, String(w.questionText ?? ''));
          q('[data-p-text]').textContent = String(w.questionText ?? '');
          q('[data-p-time]').textContent = String(w.timeLimitSeconds ?? 30);

          const words = q('[data-p-words]');
          words.textContent = '';
          const arrangement: number[] = Array.isArray(c.arrangement) ? c.arrangement : [];
          const chips = type === 'arrange_irab'
            ? (answer && arrangement.length ? arrangement.map((i) => options[i] ?? '') : options)
            : wordsMode ? sentence.split(/\s+/).filter(Boolean) : [];
          words.classList.toggle('ms-hide', chips.length === 0);
          chips.forEach((t, i) => {
            const s = document.createElement('span');
            s.className = 'ms-word';
            if (answer && ((type === 'fix_error' && i === c.wordIndex) || (type === 'arrange_irab' && arrangement.length))) s.classList.add('right');
            s.textContent = t;
            words.appendChild(s);
          });
          words.style.top = type === 'fix_error' ? '220px' : '';

          const tiles = q('[data-p-tiles]');
          tiles.textContent = '';
          const labels = type === 'true_false' ? ['صواب', 'خطأ'] : (type === 'mcq' || type === 'fix_error') ? options : [];
          const right = type === 'true_false' ? (c.boolValue === true ? 0 : c.boolValue === false ? 1 : -1) : typeof c.optionIndex === 'number' ? c.optionIndex : -1;
          tiles.classList.toggle('ms-hide', labels.length === 0);
          labels.forEach((label, i) => {
            const t = document.createElement('div');
            t.className = `ms-tile ${tileClass(i)}`;
            if (answer && right >= 0) t.classList.add(i === right ? 'right' : 'dim');
            t.innerHTML = `<div class="fill"></div>${shapeSvg(i)}<span class="lt">${LETTERS[i] ?? ''}</span><span class="tx"></span><span class="pc"></span><span class="tick">${TICK_SVG}</span>`;
            t.querySelector('.tx')!.textContent = label;
            tiles.appendChild(t);
          });
          const why = String(w.explanation ?? '').trim();
          const showWhy = answer && !!why;
          q('[data-p-why]').classList.toggle('ms-hide', !showWhy);
          q('[data-p-why-t]').textContent = why;
          tiles.classList.toggle('up', showWhy);

          q('[data-p-n]').textContent = `${prevAt + 1} / ${Math.max(list.length, 1)}`;
          q<HTMLButtonElement>('[data-p-prev]').disabled = prevAt <= 0;
          q<HTMLButtonElement>('[data-p-next]').disabled = prevAt >= list.length - 1;
          root!.querySelectorAll('[data-p-mode]').forEach((b) => b.setAttribute('aria-pressed', String((b as HTMLElement).dataset.pMode === prevMode)));
        }
        function openPreview() {
          const list = items.filter((x) => !isBlank(x));
          if (!list.length) { toast('اكتب سؤالًا أولًا لتراه على شاشة العرض.'); return; }
          prevAt = Math.max(0, list.indexOf(sel));
          prevMode = 'q';
          prev.hidden = false;
          unfit = fitStage(q('[data-p-vp]'), q('[data-p-scaler]'), q('[data-p-stage]'));
          renderPreview();
          q<HTMLButtonElement>('[data-p-close]').focus();
        }
        function closePreview() { prev.hidden = true; unfit?.(); unfit = null; }
        q('[data-preview-open]').addEventListener('click', openPreview);
        q('[data-p-close]').addEventListener('click', closePreview);
        q('[data-p-prev]').addEventListener('click', () => { prevAt = Math.max(0, prevAt - 1); renderPreview(); });
        q('[data-p-next]').addEventListener('click', () => { prevAt += 1; renderPreview(); });
        root!.querySelectorAll<HTMLElement>('[data-p-mode]').forEach((b) => b.addEventListener('click', () => { prevMode = b.dataset.pMode as 'q' | 'a'; renderPreview(); }));
        document.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape') return;
          if (!prev.hidden) { closePreview(); return; }
          root!.querySelectorAll<HTMLElement>('.me-scrim').forEach((s) => { s.hidden = true; });
        });

        // ═══ Launch ══════════════════════════════════════════════════════
        let launching = false;
        q<HTMLButtonElement>('[data-launch]').addEventListener('click', async (e) => {
          if (launching) return;
          const unfinished = items.find((it) => !isBlank(it) && !toWire(it).wire);
          if (unfinished) {
            select(unfinished);
            toast(`أكمل السؤال ${items.indexOf(unfinished) + 1} أو احذفه قبل الإطلاق.`);
            return;
          }
          if (!items.some((it) => !isBlank(it))) { toast('أضف سؤالًا واحدًا على الأقل.'); return; }
          if (!isPremium && items.some((it) => PREMIUM_TYPES.has(it.type))) {
            toast('في مجلسك أسئلة من أنواع إعراب بلس.');
            paywall();
            return;
          }
          launching = true;
          const b = e.currentTarget as HTMLButtonElement;
          b.disabled = true;
          // Blank questions are dropped before the final save.
          const kept = items.filter((it) => !isBlank(it));
          if (kept.length !== items.length) { items = kept; if (!items.includes(sel)) sel = items[0]; renderAll(); }
          rev++;
          const ok = await saveNow();
          if (!ok || !draftId) {
            launching = false; b.disabled = false;
            toast('تعذر حفظ المجلس. تحقق من اتصالك وحاول مجددًا.');
            return;
          }
          leaving = true;
          location.href = `/majlis/live?draft=${encodeURIComponent(draftId)}`;
        });

        // ═══ Entry ═══════════════════════════════════════════════════════
        if (draftId) {
          try {
            const snap = await fs.getDoc(fs.doc(db, 'majalis_drafts', uid, 'drafts', draftId));
            if (!snap.exists()) {
              q('[data-fatal-msg]').textContent = 'المسودة غير موجودة';
              show('fatal'); return;
            }
            const d: any = snap.data() ?? {};
            const raw: any[] = Array.isArray(d.questions) ? d.questions.filter((x: any) => x && typeof x === 'object') : [];
            items = raw.map((w) => {
              const it = fromWire(w);
              // A loaded question keeps its saved form until it is complete again.
              it.lastGood = toWire(it).wire ?? w;
              if (it.lastGood?.saveToBank) bankSent.set(String(it.lastGood.id), JSON.stringify(it.lastGood));
              return it;
            });
            if (d.titleCustom === true) { titleInput.value = String(d.title ?? ''); titleCustom = !!titleInput.value.trim(); }
            settings.readTime = d.settings?.readTime === true;
            settings.scoring = d.settings?.scoring === 'accuracy' ? 'accuracy' : 'speed';
            if (!items.length) items = [blankItem()];
            sel = items[0];
            setSaved('saved');
          } catch {
            q('[data-fatal-msg]').textContent = 'تعذر فتح المسودة. تحقق من اتصالك وحاول مجددًا.';
            show('fatal'); return;
          }
        } else {
          items = [blankItem()];
          sel = items[0];
          setSaved('empty');
        }
        show('app');
        renderAll();
        if (remedialRoom && !draftId) {
          // «مجلس علاجي» opens the generator on that majlis's weak points
          // (a Plus source; free hosts see the upgrade sheet).
          if (isPremium) { aiSrc = 'review'; mineWeakPoints(); }
          openAi();
          if (!isPremium) paywall();
        } else if (!draftId) {
          sentenceIn.focus();
        }
      });
    }
  }
</script>
