                x.addEventListener('click', rm);
                r.appendChild(x);
              }
              rows.appendChild(r);
            };
            const wrong = sel.fixWord != null ? wordsOf(sel.sentence)[sel.fixWord] : '';
            row('الصواب', true, sel.fixCorrect, wrong ? `صواب «${wrong}»` : 'الصورة الصحيحة للكلمة', (v) => { sel.fixCorrect = v; });
            sel.fixDecoys.forEach((d, i) => row('مموّه', false, d, 'صورة خاطئة مغرية', (v) => { sel.fixDecoys[i] = v; },
              sel.fixDecoys.length > 1 ? () => { sel.fixDecoys.splice(i, 1); renderAnswers(); renderIssue(); touch(); } : undefined));
            answersEl.appendChild(rows);
            if (sel.fixDecoys.length < 2) {
              const add = document.createElement('button');
              add.type = 'button'; add.className = 'me-link'; add.textContent = '+ مموّه آخر';
              add.addEventListener('click', () => { sel.fixDecoys.push(''); renderAnswers(); (answersEl.querySelectorAll('input')[sel.fixDecoys.length] as HTMLInputElement)?.focus(); });
              answersEl.appendChild(add);
            }
          } else if (t === 'arrange_irab') {
            answersEl.appendChild(lbl('أجزاء الإعراب بترتيبها الصحيح · تُخلط للاعبين'));
            const rows = document.createElement('div'); rows.className = 'me-rows';
            sel.arr.forEach((v, i) => {
              const r = document.createElement('div'); r.className = 'me-row';
              const n = document.createElement('span'); n.className = 'me-num'; n.textContent = String(i + 1);
              const input = document.createElement('input');
              input.type = 'text'; input.className = 'me-input'; input.maxLength = 60; input.value = v;
              input.placeholder = i === 0 ? 'مثال: مبتدأ' : i === 1 ? 'مثال: مرفوع' : 'جزء من الإعراب';
              input.setAttribute('aria-label', `الجزء ${i + 1}`);
              input.addEventListener('input', () => { sel.arr[i] = input.value; renderIssue(); refreshCurrentRail(); touch(); });
              const mv = (d: number) => { const j = i + d; [sel.arr[i], sel.arr[j]] = [sel.arr[j], sel.arr[i]]; renderAnswers(); renderIssue(); touch(); };
              const up = document.createElement('button'); up.type = 'button'; up.className = 'me-mini'; up.innerHTML = ICON_UP; up.disabled = i === 0; up.setAttribute('aria-label', 'قدّم الجزء');
              up.addEventListener('click', () => mv(-1));
              const down = document.createElement('button'); down.type = 'button'; down.className = 'me-mini'; down.innerHTML = ICON_DOWN; down.disabled = i === sel.arr.length - 1; down.setAttribute('aria-label', 'أخّر الجزء');
              down.addEventListener('click', () => mv(1));
              r.append(n, input, up, down);
              if (sel.arr.length > 2) {
                const x = document.createElement('button'); x.type = 'button'; x.className = 'me-mini'; x.innerHTML = ICON_X; x.setAttribute('aria-label', 'احذف الجزء');
                x.addEventListener('click', () => { sel.arr.splice(i, 1); renderAnswers(); renderIssue(); touch(); });
                r.appendChild(x);
              }
              rows.appendChild(r);
            });
            answersEl.appendChild(rows);
            if (sel.arr.length < 6) {
              const add = document.createElement('button');
              add.type = 'button'; add.className = 'me-link'; add.textContent = '+ جزء آخر';
              add.addEventListener('click', () => { sel.arr.push(''); renderAnswers(); const ins = answersEl.querySelectorAll<HTMLInputElement>('input'); ins[ins.length - 1]?.focus(); });
              answersEl.appendChild(add);
