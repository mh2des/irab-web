---
/**
 * MajlisEditor: the majlis creator (/majlis/create), the whole majlis on
 * one screen (rail of questions, the selected question typed into the
 * game's own coloured and shaped tiles, its settings, the majlis settings).
 *
 * Wire contract (docs/majlis-host-contracts.md, creation section) is kept:
 *   - Draft doc majalis_drafts/{uid}/drafts: client Timestamps (updatedAt
 *     every save, createdAt first save only), hasAiQuestions, questions in
 *     play order with ALL keys (explicit nulls). New fields: titleCustom
 *     (the host named the majlis; the title is otherwise derived from Q1)
 *     and settings {readTime, scoring}, applied by /majlis/live at launch.
 *   - Editor types: mcq, true_false, fix_error, arrange_irab (tap_word is
 *     shown read-only). mcq and true_false may now carry a sentence
 *     (sourceText), lit on the stage at the word «quoted» in the question.
 *   - fix_error options shuffled, arrange fragments shuffled with a
 *     non-identity permutation; the shuffle is kept while the content is
 *     unchanged so saves and the preview stay stable.
 *   - Saves on its own (debounced). Only complete questions are written; a
 *     question being edited keeps its last complete version in the draft.
 *   - saveToBank upserts AFTER the draft write, only when changed; bank
 *     reuse mints a FRESH id; edits PRESERVE id and AI provenance;
 *     sourceReference cleared when the sentence changes.
 *   - Free: the two basic types and fewer questions; the plan's numbers are
 *     never shown here (they live on /pricing).
 * Western digits, Thmanyah only, no em-dashes.
 */
import '../styles/irab-ui.css';
import '../styles/majlis-stage.css';
import '../styles/majlis-editor.css';
import { MARK_SVG } from '../lib/majlis/stage/shapes';
---

<div class="iu me-root" data-medit-root dir="rtl" lang="ar">

  <div data-v="loading" class="me-center" aria-busy="true">
    <div class="me-skel"></div>
    <div class="me-skel tall"></div>
  </div>

  <section data-v="gate" class="me-center" hidden>
    <div class="iu-card me-gate">
      <h1 class="t-display">سجّل الدخول لإنشاء مجلسك</h1>
      <p class="t-body c-word">أنشئ أسئلة الإعراب مرة واحدة، واستضفها من الويب أو التطبيق.</p>
      <a data-login-link href="/login?next=/majlis/create" class="iu-btn primary lg">تسجيل الدخول</a>
    </div>
  </section>

  <section data-v="fatal" class="me-center" hidden>
    <div class="iu-card me-gate">
      <h1 class="t-title-l" data-fatal-msg></h1>
      <a href="/majlis/host" class="iu-btn secondary">العودة إلى مجالسي</a>
    </div>
  </section>

  <!-- ═══ The creator ═══ -->
  <section data-v="app" class="me-app" hidden>
    <header class="iu-card flat me-bar">
      <a href="/majlis/host" class="iu-btn secondary" data-back>مجالسي</a>
      <input id="me-title" data-title class="me-title" type="text" maxlength="60" autocomplete="off" placeholder="سمِّ مجلسك" aria-label="اسم المجلس" />
      <div class="me-bar-meta">
        <span class="me-saved" data-saved aria-live="polite"><i></i><span></span></span>
        <span class="me-count" data-count></span>
      </div>
      <div class="me-bar-actions">
        <button type="button" class="iu-btn secondary" data-preview-open>معاينة</button>
        <button type="button" class="iu-btn primary" data-launch>استضف الآن</button>
      </div>
    </header>

    <div class="me-body">
      <aside class="iu-card flat me-rail" aria-label="أسئلة المجلس">
        <div class="me-rail-h"><span>أسئلة المجلس</span><span class="me-hint">اسحب لتغيير الترتيب</span></div>
        <ol class="me-list" data-list></ol>
        <div class="me-adds">
          <button type="button" class="me-add main" data-add-new><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>سؤال جديد</button>
          <button type="button" class="me-add" data-add-ai>ولّد بالذكاء الاصطناعي</button>
          <button type="button" class="me-add" data-add-bank>من بنك الأسئلة</button>
        </div>
      </aside>

      <main class="me-canvas" data-canvas>
        <p class="me-note" data-ai-note hidden>هذا السؤال مولّد بالذكاء الاصطناعي. راجعه وتأكد من صحته قبل الإطلاق، فأنت المسؤول عما يُعرض في مجلسك.</p>
        <div class="me-types" data-types role="group" aria-label="نوع السؤال"></div>

        <div class="iu-card flat me-legacy" data-legacy hidden>
          <span class="me-tag" style="justify-self:start">تحديد الكلمة</span>
          <p class="t-title" data-legacy-text></p>
          <p class="t-body c-word" data-legacy-src></p>
          <p class="t-body-s c-word">سؤال من نوع قديم يعمل في المجلس كما هو، ولا يُعدّل هنا. يمكنك نقله أو تكراره أو حذفه.</p>
        </div>

        <div class="iu-card flat me-qcard" data-qcard>
          <div class="me-field">
            <label class="me-lbl" for="me-sentence"><span data-sentence-lbl></span><span class="me-hint" data-sentence-hint></span></label>
            <input id="me-sentence" data-sentence class="me-sentence" type="text" autocomplete="off" spellcheck="false" />
            <div class="me-words" data-words></div>
            <p class="me-hint" data-words-hint style="text-align:center"></p>
          </div>
          <div class="me-harakat" data-harakat role="group" aria-label="أضف حركة إلى الحقل الذي تكتب فيه"></div>
          <div class="me-field">
            <label class="me-lbl" for="me-qtext"><span>السؤال</span><span class="me-hint" data-qtext-hint>الكلمة بين «» تُضاء في الجملة على الشاشة</span></label>
            <textarea id="me-qtext" data-qtext class="me-qtext" rows="2" maxlength="300"></textarea>
          </div>
          <div class="me-field" data-answers></div>
        </div>

        <div class="me-why" data-why-box>
          <label class="me-lbl" for="me-why"><span>التعليل</span><span class="me-hint">يقرؤه كل اللاعبين بعد السؤال</span></label>
          <textarea id="me-why" data-why rows="3" maxlength="600" placeholder="اشرح لماذا هذه هي الإجابة الصحيحة، مثل: خبر كان منصوب وعلامة نصبه الفتحة."></textarea>
        </div>
        <p class="me-issue" data-issue hidden></p>
      </main>

      <aside class="iu-card flat me-side">
        <h2 class="me-h">هذا السؤال</h2>
        <div class="me-field" data-time-box>
          <span class="me-lbl">المدة بالثواني</span>
          <div class="me-times" data-times role="group" aria-label="مدة السؤال بالثواني"></div>
        </div>
        <div class="me-set" data-bank-box><span id="me-bank-l">احفظه في بنك أسئلتك</span><button type="button" class="me-sw" role="switch" aria-checked="false" aria-labelledby="me-bank-l" data-bank-sw></button></div>
        <div class="me-acts">
          <button type="button" class="iu-btn secondary" data-dup>تكرار</button>
          <button type="button" class="iu-btn secondary" data-up>تقديم</button>
          <button type="button" class="iu-btn secondary" data-down>تأخير</button>
          <button type="button" class="iu-btn secondary" data-del>حذف</button>
        </div>
        <hr class="me-sep" />
        <h2 class="me-h">إعدادات المجلس</h2>
        <div class="me-set"><span id="me-read-l">مهلة القراءة</span><button type="button" class="me-sw" role="switch" aria-checked="false" aria-labelledby="me-read-l" data-read-sw></button></div>
        <p class="me-hint">تظهر الجملة والسؤال وحدهما لحظات قبل الخيارات، ليقرأ الجميع قبل السباق.</p>
        <div class="me-set"><span id="me-acc-l">الدقة أولًا</span><button type="button" class="me-sw" role="switch" aria-checked="false" aria-labelledby="me-acc-l" data-acc-sw></button></div>
        <p class="me-hint">لكل إجابة صحيحة النقاط نفسها، بلا نقاط للسرعة. يمكنك تغيير الإعدادين في ردهة المجلس أيضًا.</p>
      </aside>
    </div>
  </section>

  <!-- ═══ AI drawer ═══ -->
  <div class="me-scrim" data-ai-drawer hidden>
    <div class="me-drawer" role="dialog" aria-modal="true" aria-labelledby="me-ai-h">
      <div class="me-drawer-h">
        <h2 id="me-ai-h">ولّد أسئلة بالذكاء الاصطناعي</h2>
        <button type="button" class="iu-btn secondary" data-close>إغلاق</button>
      </div>
      <p class="t-body-s c-word">تُضاف الأسئلة المولّدة إلى مجلسك بعد السؤال الحالي، فتراجعها وتعدلها في مكانها. <span data-ai-quota hidden></span></p>

      <div class="me-sec">
        <span class="me-lbl">المصدر</span>
        <div class="me-chips" data-ai-src-seg></div>
      </div>

      <div class="me-sec" data-ai-topic-block>
        <span class="me-lbl">اختر موضوعًا أو أكثر</span>
        <div class="me-chips" data-ai-topics></div>
        <input data-ai-topic-free type="text" class="me-search" placeholder="أو اكتب موضوعًا آخر" aria-label="موضوع آخر" />
      </div>

      <div class="me-sec" data-ai-text-block hidden>
        <div data-ai-photo-row hidden>
          <label class="iu-btn secondary">اختر صورة من الكتاب<input data-ai-photo type="file" accept="image/*" hidden /></label>
          <p class="me-hint" data-ai-ocr-status></p>
        </div>
        <label class="me-lbl" for="me-ai-text" data-ai-text-label>النص المصدر (من 10 إلى 1000 حرف)</label>
        <textarea id="me-ai-text" data-ai-text rows="6" maxlength="1000" class="me-qtext" style="text-align:start;font-size:16px;font-weight:500" placeholder="الصق النص الذي تريد التوليد منه"></textarea>
      </div>

      <div class="me-sec" data-ai-review-block hidden>
        <span class="me-lbl" data-ai-weak-label>نقاط الضعف من مجالسك الأخيرة</span>
        <div class="me-rows" data-ai-weak></div>
      </div>

      <div class="me-sec">
        <span class="me-lbl">المستوى</span>
        <div class="me-chips" data-ai-diff-seg></div>
      </div>

      <div class="me-sec">
        <span class="me-lbl">أنواع الأسئلة</span>
        <div class="me-chips" data-ai-type-chips></div>
      </div>

      <div class="me-sec" data-ai-pattern-block>
        <span class="me-lbl">نمط الأسئلة</span>
        <div class="me-chips" data-ai-patterns></div>
        <p class="me-hint" data-ai-pattern-hint></p>
      </div>

      <div class="me-set">
        <span>عدد الأسئلة</span>
        <div class="me-stepper">
          <button type="button" class="me-mini" data-ai-c-minus aria-label="أقل">-</button>
          <span data-ai-c-val>5</span>
          <button type="button" class="me-mini" data-ai-c-plus aria-label="أكثر">+</button>
        </div>
      </div>

      <div class="me-writer" data-ai-writer hidden></div>
      <p class="me-err" data-ai-err hidden></p>
      <div class="me-confirm" data-ai-confirm hidden>
        <p class="t-body-s" data-ai-confirm-msg></p>
        <div class="me-acts">
          <button type="button" class="iu-btn primary" data-ai-confirm-go></button>
          <button type="button" class="iu-btn secondary" data-ai-confirm-up>ترقية</button>
          <button type="button" class="iu-btn secondary" data-ai-confirm-cancel>إلغاء</button>
        </div>
      </div>
      <button type="button" class="iu-btn primary lg block" data-ai-generate>ولّد الأسئلة</button>
      <p class="me-hint" style="text-align:center">ستراجع كل الأسئلة المولّدة قبل إطلاق المجلس.</p>
    </div>
  </div>

  <div class="me-busy" data-ai-overlay hidden>
    <div class="iu-card">
      <span class="az-spinner" style="width:36px;height:36px;border-width:4px"></span>
      <p class="t-title" data-ai-step></p>
    </div>
  </div>

  <!-- ═══ Bank drawer ═══ -->
  <div class="me-scrim" data-bank-drawer hidden>
    <div class="me-drawer" role="dialog" aria-modal="true" aria-labelledby="me-bank-h">
      <div class="me-drawer-h">
        <h2 id="me-bank-h">من بنك أسئلتك</h2>
        <button type="button" class="iu-btn secondary" data-close>إغلاق</button>
      </div>
      <input data-bank-q type="search" class="me-search" placeholder="ابحث في أسئلتك" aria-label="ابحث في أسئلتك" />
      <div class="me-chips" data-bank-types style="display:flex;flex-wrap:wrap;gap:6px"></div>
      <div class="me-rows" data-bank-list></div>
      <p class="t-body-s c-word" data-bank-empty hidden>بنك أسئلتك فارغ. فعّل «احفظه في بنك أسئلتك» في أي سؤال ليظهر هنا.</p>
    </div>
  </div>

  <!-- ═══ Preview: the real stage ═══ -->
  <div class="me-prev ms-page" data-prev hidden role="dialog" aria-modal="true" aria-label="معاينة على شاشة العرض">
    <div class="me-prev-top">
      <span class="me-prev-n" style="text-align:start">معاينة على شاشة العرض</span>
      <button type="button" class="me-prev-btn" data-p-close>إغلاق المعاينة</button>
    </div>
    <div class="me-prev-vp" data-p-vp>
      <div class="ms-scaler" data-p-scaler>
        <div class="ms-stage" data-p-stage>
          <div class="ms-top"><div class="ms-brand"><Fragment set:html={MARK_SVG} /><b class="ms-title" data-p-name></b></div></div>
          <div class="ms-view on">
            <div class="ms-qhead"><p class="ms-qnum" data-p-num></p><p class="ms-sentence" data-p-sent></p><p class="ms-qtext" data-p-text></p></div>
            <div class="ms-timer"><svg viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="44" fill="none" stroke="#283A5C" stroke-width="9"/><circle cx="50" cy="50" r="44" fill="none" stroke="#F5C15E" stroke-width="9" stroke-linecap="round" stroke-dasharray="276.5" stroke-dashoffset="0"/></svg><span class="num" data-p-time></span></div>
            <div class="ms-words ms-hide" data-p-words></div>
            <div class="ms-tiles" data-p-tiles></div>
            <div class="ms-explain ms-hide" data-p-why><b>التعليل</b><span data-p-why-t></span></div>
          </div>
        </div>
      </div>
    </div>
    <div class="me-prev-bot">
      <button type="button" class="me-prev-btn" data-p-prev>السابق</button>
      <button type="button" class="me-prev-btn" data-p-mode="q" aria-pressed="true">السؤال</button>
      <button type="button" class="me-prev-btn" data-p-mode="a" aria-pressed="false">الإجابة</button>
      <span class="me-prev-n" data-p-n></span>
      <button type="button" class="me-prev-btn" data-p-next>التالي</button>
    </div>
  </div>

  <div class="me-toast" data-toast role="status" hidden><span data-toast-msg></span><button type="button" data-toast-act hidden></button></div>
</div>

<script>
  import { maybeSignedIn } from '../lib/session';
  import { firestore, callMajlis, track } from '../lib/majlis/fb';
  import { shapeSvg, tileClass, LETTERS, TICK_SVG } from '../lib/majlis/stage/shapes';
  import { fitStage } from '../lib/majlis/stage/fit';
  import { askedRange, sentenceInto } from '../lib/majlis/sentence';
  import { crown } from '../lib/irab/icons';

  const root = document.querySelector<HTMLElement>('[data-medit-root]');
  if (root) {
    const q = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const VIEWS = ['loading', 'gate', 'fatal', 'app'];
    const show = (v: string) => { for (const x of VIEWS) q(`[data-v="${x}"]`).hidden = x !== v; };

    const params = new URLSearchParams(location.search);
    const draftParam = params.get('draft');
    const remedialRoom = params.get('remedial');
    if (draftParam) {
      q<HTMLAnchorElement>('[data-login-link]').href = `/login?next=${encodeURIComponent('/majlis/create?draft=' + draftParam)}`;
    }

    type Kind = 'mcq' | 'true_false' | 'fix_error' | 'arrange_irab' | 'tap_word';
    const TYPE_LABELS: Record<string, string> = {
      mcq: 'اختيار من متعدد', true_false: 'صواب وخطأ', tap_word: 'تحديد الكلمة',
      fix_error: 'صحّح الخطأ', arrange_irab: 'ترتيب الإعراب',
    };
    const EDITOR_TYPES: Kind[] = ['mcq', 'true_false', 'fix_error', 'arrange_irab'];
    const PREMIUM_TYPES = new Set(['fix_error', 'arrange_irab', 'tap_word']);
    // The app prefills this fixed instruction when fix_error is picked on an empty box.
    const FIX_INSTRUCTION = 'في الجملة خطأ إعرابي واحد، اضغط الكلمة الخاطئة ثم اختر صوابها';
    const TIMES = [10, 20, 30, 45, 60, 90, 120];
    const HARAKAT: Array<[string, string]> = [
      ['َ', 'فتحة'], ['ُ', 'ضمة'], ['ِ', 'كسرة'], ['ً', 'تنوين فتح'],
      ['ٌ', 'تنوين ضم'], ['ٍ', 'تنوين كسر'], ['ْ', 'سكون'], ['ّ', 'شدة'],
    ];
    const PLUS_CHIP = `<span class="me-plus" title="لمشتركي إعراب بلس">${crown}بلس</span>`;
    const ICON_UP = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 15l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    const ICON_DOWN = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    const ICON_X = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>';
    const paywall = () => (window as any).IrabPaywall?.show({ reason: 'limit' });

    if (!maybeSignedIn()) { show('gate'); }
    else init();

    async function init() {
      const [{ onAuth }, fs, db] = await Promise.all([import('../lib/auth'), import('firebase/firestore'), firestore()]);
      let started = false;

      onAuth(async (u) => {
        if (!u || u.isAnonymous) { show('gate'); return; }
        if (started) return;
        started = true;
        const user = u;
        const uid = u.uid;

        let isPremium = false;
        try {
          const res: any = await callMajlis('majalisQuotaStatus', {});
          isPremium = !!res?.isPremium;
        } catch { /* default to free; the server re-enforces at launch */ }
        const maxQ = isPremium ? 50 : 10;

        // ═══ Model ═══════════════════════════════════════════════════════
        interface Order { key: string; options: string[]; optionIndex?: number; arrangement?: number[] }
        interface Item {
          id: string; type: Kind;
          text: string; sentence: string;
          mcq: string[]; mcqRight: number;
          tf: boolean | null;
          fixWord: number | null; fixCorrect: string; fixDecoys: string[];
          arr: string[];
          why: string; time: number; bank: boolean;
          ai: boolean; topic: any; difficulty: any; ref: any; refSentence: string;
          raw?: any; order?: Order; lastGood?: any;
        }

        const freshId = () => `mq_${Date.now() * 1000 + Math.floor(Math.random() * 1000)}`;
        const wordsOf = (s: any) => String(s ?? '').split(/\s+/).filter(Boolean);
        const clampTime = (n: any) => Math.min(120, Math.max(5, Math.round(Number(n)) || 30));
        function shuffled<T>(arr: T[]): T[] {
          const a = [...arr];
          for (let i = a.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [a[i], a[j]] = [a[j], a[i]];
          }
          return a;
        }
        // Arrange fragments must never be stored in play order (contract 1.3).
        function nonIdentityPerm(n: number): number[] {
          let p: number[];
          do { p = shuffled([...Array(n).keys()]); }
          while (n > 1 && p.every((v, i) => v === i));
          return p;
        }
        /** «سؤال واحد، سؤالان، 3 أسئلة، 11 سؤالًا». */
        const countText = (n: number) => n === 0 ? 'لا أسئلة بعد' : n === 1 ? 'سؤال واحد' : n === 2 ? 'سؤالان'
          : n <= 10 ? `${n} أسئلة` : `${n} سؤالًا`;

        function blankItem(type: Kind = 'mcq'): Item {
          return {
            id: freshId(), type, text: type === 'fix_error' ? FIX_INSTRUCTION : '', sentence: '',
            mcq: ['', '', '', ''], mcqRight: -1, tf: null,
            fixWord: null, fixCorrect: '', fixDecoys: [''], arr: ['', '', ''],
            why: '', time: 30, bank: false,
            ai: false, topic: null, difficulty: null, ref: null, refSentence: '',
          };
        }

        function fromWire(w: any): Item {
          const type = String(w?.type ?? 'mcq') as Kind;
          const c = w?.correctAnswer ?? {};
          const opts: string[] = Array.isArray(w?.options) ? w.options.map(String) : [];
          const it = blankItem('mcq');
          it.id = String(w?.id ?? freshId());
          it.type = (EDITOR_TYPES.includes(type) || type === 'tap_word') ? type : 'tap_word';
          it.text = String(w?.questionText ?? '');
          it.sentence = String(w?.sourceText ?? '');
          it.why = String(w?.explanation ?? '');
          it.time = clampTime(w?.timeLimitSeconds);
          it.bank = !!w?.saveToBank;
          it.ai = !!w?.aiGenerated;
          it.topic = w?.grammarTopic ?? null;
          it.difficulty = w?.difficulty ?? null;
          it.ref = w?.sourceReference ?? null;
          it.refSentence = it.sentence.trim();
          if (it.type === 'mcq') {
            it.mcq = [...opts];
            while (it.mcq.length < 4) it.mcq.push('');
            it.mcqRight = typeof c.optionIndex === 'number' && c.optionIndex < opts.length ? c.optionIndex : -1;
          } else if (it.type === 'true_false') {
            it.tf = typeof c.boolValue === 'boolean' ? c.boolValue : null;
          } else if (it.type === 'fix_error') {
            it.fixWord = typeof c.wordIndex === 'number' ? c.wordIndex : null;
            const oi = typeof c.optionIndex === 'number' ? c.optionIndex : -1;
            it.fixCorrect = opts[oi] ?? '';
            it.fixDecoys = opts.filter((_, i) => i !== oi);
            if (!it.fixDecoys.length) it.fixDecoys = [''];
            it.order = { key: fixKey(it), options: opts, optionIndex: oi };
          } else if (it.type === 'arrange_irab') {
            const arrangement: number[] = Array.isArray(c.arrangement) ? c.arrangement.map(Number) : [];
            it.arr = arrangement.map((i) => opts[i] ?? '');
            while (it.arr.length < 2) it.arr.push('');
            it.order = { key: arrKey(it), options: opts, arrangement };
          } else {
            it.raw = w;
          }
          return it;
        }

        function fixKey(it: Item) {
          return JSON.stringify([it.fixCorrect.trim(), [...new Set(it.fixDecoys.map((t) => t.trim()).filter(Boolean))]]);
        }
        function arrKey(it: Item) { return JSON.stringify(it.arr.map((t) => t.trim()).filter(Boolean)); }

        /** The wire question, or the reasons it is not complete yet. */
        function toWire(it: Item): { wire: any | null; issues: string[] } {
          if (it.type === 'tap_word') return { wire: it.raw ?? null, issues: [] };
          const issues: string[] = [];
          const text = it.text.trim();
          if (!text) issues.push('اكتب نص السؤال');
          let sourceText: string | null = null;
          let options: string[] = [];
          let optionIndex: number | null = null, wordIndex: number | null = null;
          let boolValue: boolean | null = null, arrangement: number[] | null = null;

          if (it.type === 'mcq' || it.type === 'true_false') {
            sourceText = it.sentence.trim() || null;
          }
          if (it.type === 'mcq') {
            const nonBlank = it.mcq.map((v, i) => ({ v: v.trim(), i })).filter((x) => x.v);
            if (nonBlank.length < 2) issues.push('أضف خيارين على الأقل');
            else if (it.mcqRight < 0 || !it.mcq[it.mcqRight]?.trim()) issues.push('اضغط دائرة الخيار الصحيح');
            else if (new Set(nonBlank.map((x) => x.v)).size !== nonBlank.length) issues.push('الخيارات متكررة');
            options = nonBlank.map((x) => x.v);
            optionIndex = nonBlank.findIndex((x) => x.i === it.mcqRight);
          } else if (it.type === 'true_false') {
            if (it.tf == null) issues.push('اختر الحكم: صواب أم خطأ');
            boolValue = it.tf;
          } else if (it.type === 'fix_error') {
            const src = it.sentence.trim();
            const words = wordsOf(src);
            const correct = it.fixCorrect.trim();
            const decoys = [...new Set(it.fixDecoys.map((t) => t.trim()).filter(Boolean))];
            if (words.length < 2) issues.push('اكتب جملة من كلمتين على الأقل');
            else if (it.fixWord == null || it.fixWord >= words.length) issues.push('اضغط الكلمة الخاطئة في الجملة');
            if (!correct) issues.push('اكتب صواب الكلمة');
            else if (it.fixWord != null && words[it.fixWord] === correct) issues.push('صواب الكلمة يجب أن يختلف عن الكلمة الخاطئة');
            if (!decoys.length) issues.push('أضف مموّهًا واحدًا على الأقل');
            else if (decoys.includes(correct)) issues.push('المموّهات يجب أن تختلف عن الصواب');
            if (!issues.length) {
              const key = fixKey(it);
              if (it.order?.key !== key || it.order.optionIndex == null) {
                const o = shuffled([correct, ...decoys]);
                it.order = { key, options: o, optionIndex: o.indexOf(correct) };
              }
              options = [...it.order.options];
              optionIndex = it.order.optionIndex!;
              wordIndex = it.fixWord;
            }
            sourceText = src || null;
          } else if (it.type === 'arrange_irab') {
            const target = it.sentence.trim();
            const frags = it.arr.map((t) => t.trim()).filter(Boolean);
            if (!target) issues.push('اكتب الكلمة المستهدفة');
            if (frags.length < 2) issues.push('أضف جزأين على الأقل');
            else if (new Set(frags).size !== frags.length) issues.push('أجزاء الإعراب يجب أن تختلف');
            if (!issues.length) {
              const key = arrKey(it);
              if (it.order?.key !== key || !it.order.arrangement) {
                const perm = nonIdentityPerm(frags.length);
                it.order = { key, options: perm.map((i) => frags[i]), arrangement: frags.map((_, k) => perm.indexOf(k)) };
              }
              options = [...it.order.options];
              arrangement = [...it.order.arrangement!];
            }
            sourceText = target || null;
          }
          if (issues.length) return { wire: null, issues };
          return {
            wire: {
              id: it.id,
              type: it.type,
              questionText: text,
              sourceText,
              options,
              correctAnswer: { optionIndex, boolValue, wordIndex, arrangement },
              explanation: it.why.trim() || null,
              grammarTopic: it.topic ?? null,
              difficulty: it.difficulty ?? null,
              timeLimitSeconds: it.time,
              sourceReference: (sourceText ?? '') === it.refSentence ? (it.ref ?? null) : null,
              aiGenerated: it.ai,
              saveToBank: it.bank,
            },
            issues: [],
          };
        }

        function isBlank(it: Item): boolean {
          if (it.type === 'tap_word') return false;
          const t = it.text.trim();
          return (!t || t === FIX_INSTRUCTION) && !it.sentence.trim() && !it.why.trim()
            && it.mcq.every((v) => !v.trim()) && !it.fixCorrect.trim() && it.fixDecoys.every((v) => !v.trim())
            && it.arr.every((v) => !v.trim());
        }

        // ═══ State ═══════════════════════════════════════════════════════
        let items: Item[] = [];
        let sel: Item = blankItem();
        let draftId: string | null = draftParam;
        let titleCustom = false;
        const settings = { readTime: false, scoring: 'speed' as 'speed' | 'accuracy' };
        let rev = 0; let savedRev = 0;
        let leaving = false;
        const bankSent = new Map<string, string>();
        const idx = () => Math.max(0, items.indexOf(sel));

        // ═══ Saving ══════════════════════════════════════════════════════
        const savedEl = q('[data-saved]');
        function setSaved(state: 'saved' | 'saving' | 'error' | 'empty') {
          savedEl.dataset.state = state;
          savedEl.querySelector('span')!.textContent = state === 'saved' ? 'حُفظ'
            : state === 'saving' ? 'يُحفظ…'
            : state === 'error' ? 'تعذّر الحفظ، نعيد المحاولة'
            : 'يُحفظ حين يكتمل سؤال';
        }
        let saveTimer: number | undefined;
        let retryTimer: number | undefined;
        function touch() {
          rev++;
          clearTimeout(saveTimer);
          saveTimer = window.setTimeout(() => { saveNow(); }, 900);
          if (savedEl.dataset.state !== 'error') setSaved('saving');
        }
        // One chain: overlapping saves could otherwise both see draftId==null
        // and addDoc TWO draft docs.
        let chain: Promise<boolean> = Promise.resolve(true);
        function saveNow(): Promise<boolean> {
          clearTimeout(saveTimer);
          const p = chain.then(() => doSave());
          chain = p.catch(() => false);
          return p;
        }
        async function doSave(): Promise<boolean> {
          const myRev = rev;
          if (myRev === savedRev && draftId) { setSaved('saved'); return true; }
          const wires = items.map((it) => {
            const r = toWire(it);
            if (r.wire) { it.lastGood = r.wire; return r.wire; }
            return it.lastGood ?? null;
          }).filter(Boolean);
          if (!wires.length && !draftId) { setSaved('empty'); return false; }
          try {
            const data: any = { questions: wires, settings: { ...settings }, updatedAt: fs.Timestamp.now(), hasAiQuestions: wires.some((w: any) => !!w.aiGenerated) };
            const custom = titleInput.value.trim();
            if (titleCustom && custom) { data.title = custom.slice(0, 60); data.titleCustom = true; }
            else if (wires.length) {
              const first = wires[0];
              data.title = (String(first.sourceText ?? '').trim() || String(first.questionText ?? '').trim()).slice(0, 60);
              data.titleCustom = false;
            }
            if (!draftId) {
              data.createdAt = fs.Timestamp.now();
              const ref = await fs.addDoc(fs.collection(db, 'majalis_drafts', uid, 'drafts'), data);
              draftId = ref.id;
              history.replaceState(null, '', `/majlis/create?draft=${encodeURIComponent(draftId)}`);
            } else {
              await fs.setDoc(fs.doc(db, 'majalis_drafts', uid, 'drafts', draftId), data, { merge: true });
            }
            // Bank upserts only after the draft write, only what changed; failures are silent.
            for (const w of wires) {
              if (!w.saveToBank) continue;
              const j = JSON.stringify(w);
              if (bankSent.get(w.id) === j) continue;
              bankSent.set(w.id, j);
              fs.setDoc(fs.doc(db, 'majalis_bank', uid, 'questions', String(w.id)), w, { merge: true }).catch(() => bankSent.delete(w.id));
            }
            savedRev = Math.max(savedRev, myRev);
            setSaved(rev === savedRev ? 'saved' : 'saving');
            return true;
          } catch {
            setSaved('error');
            clearTimeout(retryTimer);
            retryTimer = window.setTimeout(() => { saveNow(); }, 8000);
            return false;
          }
        }
        const hasUnfinished = () => items.some((it) => !isBlank(it) && !toWire(it).wire);
        window.addEventListener('beforeunload', (e) => {
          if (leaving) return;
          if (rev !== savedRev || hasUnfinished()) e.preventDefault();
        });

        // ═══ Elements ════════════════════════════════════════════════════
        const titleInput = q<HTMLInputElement>('[data-title]');
        const listEl = q('[data-list]');
        const typesEl = q('[data-types]');
        const sentenceIn = q<HTMLInputElement>('[data-sentence]');
        const qtextIn = q<HTMLTextAreaElement>('[data-qtext]');
        const whyIn = q<HTMLTextAreaElement>('[data-why]');
        const answersEl = q('[data-answers]');
        const wordsEl = q('[data-words]');
        const issueEl = q('[data-issue]');

        // ═══ Toast ═══════════════════════════════════════════════════════
        const toastEl = q('[data-toast]');
        let toastTimer: number | undefined;
        function toast(msg: string, action?: { label: string; fn: () => void }, ms = 5000) {
          q('[data-toast-msg]').textContent = msg;
          const b = q<HTMLButtonElement>('[data-toast-act]');
          b.hidden = !action;
          b.textContent = action?.label ?? '';
          b.onclick = action ? () => { toastEl.hidden = true; action.fn(); } : null;
          toastEl.hidden = false;
          clearTimeout(toastTimer);
          toastTimer = window.setTimeout(() => { toastEl.hidden = true; }, ms);
        }
        function canAdd(n = 1): boolean {
          const used = items.filter((x) => !isBlank(x)).length;
          if (used + n <= maxQ) return true;
          toast('وصل مجلسك إلى أقصى عدد من الأسئلة في خطتك.');
          if (!isPremium) paywall();
          return false;
        }

        // ═══ Rail ════════════════════════════════════════════════════════
        let dragFrom: Item | null = null;
        function renderRail() {
          listEl.textContent = '';
          items.forEach((it, i) => listEl.appendChild(railItem(it, i)));
          q('[data-count]').textContent = countText(items.filter((x) => !isBlank(x)).length);
        }
        function railItem(it: Item, i: number): HTMLElement {
          const li = document.createElement('li');
          li.className = 'me-qi';
          li.draggable = true;
          li.setAttribute('aria-current', String(it === sel));
          li.innerHTML = `<button type="button" class="me-qi-btn"><span class="me-qi-n">${i + 1}</span><span class="me-qi-body"><span class="me-qi-meta"></span><span class="me-qi-tx"></span></span></button>`;
          fillRailItem(li, it);
          li.querySelector('button')!.addEventListener('click', () => select(it));
          li.addEventListener('dragstart', (e) => {
            dragFrom = it; li.classList.add('dragging');
            e.dataTransfer?.setData('text/plain', it.id);
            if (e.dataTransfer) e.dataTransfer.effectAllowed = 'move';
          });
          li.addEventListener('dragend', () => {
            dragFrom = null;
            listEl.querySelectorAll('.me-qi').forEach((x) => x.classList.remove('dragging', 'drop-before', 'drop-after'));
          });
          li.addEventListener('dragover', (e) => {
            if (!dragFrom) return;
            e.preventDefault();
            const r = li.getBoundingClientRect();
            const after = e.clientY > r.top + r.height / 2;
            listEl.querySelectorAll('.me-qi').forEach((x) => x.classList.remove('drop-before', 'drop-after'));
            li.classList.add(after ? 'drop-after' : 'drop-before');
          });
          li.addEventListener('drop', (e) => {
            if (!dragFrom) return;
            e.preventDefault();
            const r = li.getBoundingClientRect();
            const after = e.clientY > r.top + r.height / 2;
            const moving = dragFrom;
            const from = items.indexOf(moving);
            let to = items.indexOf(it) + (after ? 1 : 0);
            if (from < 0 || to < 0) return;
            items.splice(from, 1);
            if (to > from) to--;
            items.splice(to, 0, moving);
            renderRail(); renderSide(); touch();
          });
          return li;
        }
        function fillRailItem(li: Element, it: Item) {
          const meta = li.querySelector('.me-qi-meta')!;
          const r = toWire(it);
          const blank = isBlank(it);
          meta.innerHTML = `<span class="me-tag">${TYPE_LABELS[it.type] ?? '؟'}</span>${it.ai ? '<span class="me-tag ai">مولّد</span>' : ''}${r.wire && !it.why.trim() && it.type !== 'tap_word' ? '<span class="me-tag warn">بلا تعليل</span>' : ''}`;
          const tx = it.type === 'fix_error' && it.text.trim() === FIX_INSTRUCTION ? it.sentence : (it.text.trim() || it.sentence);
          li.querySelector('.me-qi-tx')!.textContent = blank ? '' : tx;
          li.querySelector('.me-qi-dot')?.remove();
          if (!r.wire && !blank) {
            const d = document.createElement('span');
            d.className = 'me-qi-dot'; d.title = 'سؤال غير مكتمل';
            li.querySelector('button')!.appendChild(d);
          }
        }
        function refreshCurrentRail() {
          const li = listEl.children[idx()];
          if (li) fillRailItem(li, sel);
          q('[data-count]').textContent = countText(items.filter((x) => !isBlank(x)).length);
        }

        // ═══ Canvas ══════════════════════════════════════════════════════
        function select(it: Item) {
          sel = it;
          renderAll();
        }
        function renderAll() {
          renderRail();
          renderCanvas();
          renderSide();
        }
        function renderTypes() {
          typesEl.textContent = '';
          for (const t of EDITOR_TYPES) {
            const locked = !isPremium && PREMIUM_TYPES.has(t);
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'me-chip';
            b.setAttribute('aria-pressed', String(sel.type === t));
            b.innerHTML = `<span></span>${locked ? PLUS_CHIP : ''}`;
            b.firstElementChild!.textContent = TYPE_LABELS[t];
            b.addEventListener('click', () => {
              if (locked) { paywall(); return; }
              if (sel.type === t) return;
              const wasFix = sel.type === 'fix_error';
              sel.type = t;
              if (t === 'fix_error' && !sel.text.trim()) sel.text = FIX_INSTRUCTION;
              if (wasFix && sel.text.trim() === FIX_INSTRUCTION) sel.text = '';
              renderCanvas(); refreshCurrentRail(); touch();
            });
            typesEl.appendChild(b);
          }
        }
        function renderCanvas() {
          const legacy = sel.type === 'tap_word';
          q('[data-ai-note]').hidden = !sel.ai;
          q('[data-legacy]').hidden = !legacy;
          q('[data-qcard]').hidden = legacy;
          q('[data-why-box]').hidden = legacy;
          typesEl.hidden = legacy;
          if (legacy) {
            q('[data-legacy-text]').textContent = String(sel.raw?.questionText ?? '');
            q('[data-legacy-src]').textContent = sel.raw?.sourceText ? `«${sel.raw.sourceText}»` : '';
            issueEl.hidden = true;
            return;
          }
          renderTypes();
          const t = sel.type;
          q('[data-sentence-lbl]').textContent = t === 'arrange_irab' ? 'الكلمة المستهدفة بالإعراب' : t === 'fix_error' ? 'الجملة، وفيها الخطأ' : 'الجملة';
          q('[data-sentence-hint]').textContent = t === 'mcq' || t === 'true_false' ? 'اختيارية، تظهر كبيرة على الشاشة' : '';
          sentenceIn.placeholder = t === 'arrange_irab' ? 'مثال: الطالبُ' : t === 'fix_error' ? 'اكتب الجملة كاملة، وفيها خطأ واحد' : 'مثال: كانَ الطالبُ مجتهدًا';
          qtextIn.placeholder = t === 'true_false' ? 'عبارة يحكم عليها اللاعبون، مثل: «الطالبُ» اسم كان مرفوع'
            : t === 'arrange_irab' ? 'مثال: رتّب إعراب «الطالبُ»' : 'مثال: ما إعراب «مجتهدًا»؟';
          q('[data-qtext-hint]').hidden = t === 'fix_error' || t === 'arrange_irab';
          sentenceIn.value = sel.sentence;
          qtextIn.value = sel.text;
          whyIn.value = sel.why;
          renderWords();
          renderAnswers();
          renderIssue();
        }

        function wordSpans(s: string): Array<{ w: string; a: number; b: number }> {
          const out: Array<{ w: string; a: number; b: number }> = [];
          const re = /\S+/g; let m: RegExpExecArray | null;
          while ((m = re.exec(s))) out.push({ w: m[0], a: m.index, b: m.index + m[0].length });
          return out;
        }
        const bare = (w: string) => w.replace(/[،؛.,!?؟:"'«»()\[\]]/g, '');

        function renderWords() {
          const t = sel.type;
          wordsEl.textContent = '';
          const hint = q('[data-words-hint]');
          const spans = t === 'arrange_irab' ? [] : wordSpans(sel.sentence);
          wordsEl.hidden = spans.length === 0;
          if (t === 'fix_error') {
            if (sel.fixWord != null && sel.fixWord >= spans.length) sel.fixWord = null;
            spans.forEach((s, i) => {
              const b = document.createElement('button');
              b.type = 'button';
              b.className = 'me-word' + (sel.fixWord === i ? ' bad' : '');
              b.setAttribute('aria-pressed', String(sel.fixWord === i));
              b.textContent = s.w;
              b.addEventListener('click', () => { sel.fixWord = i; renderWords(); renderAnswers(); renderIssue(); refreshCurrentRail(); touch(); });
              wordsEl.appendChild(b);
            });
            hint.textContent = spans.length ? (sel.fixWord == null ? 'اضغط الكلمة الخاطئة' : 'الكلمة الخاطئة معلّمة. اكتب صوابها ومموّهاتها أدناه') : 'اكتب الجملة لتختار الكلمة الخاطئة';
            return;
          }
          if (t === 'arrange_irab') { hint.textContent = ''; return; }
          const r = askedRange(sel.sentence, sel.text);
          spans.forEach((s) => {
            const b = document.createElement('button');
            b.type = 'button';
            const lit = !!r && s.a < r[1] && s.b > r[0];
            b.className = 'me-word' + (lit ? ' lit' : '');
            b.setAttribute('aria-pressed', String(lit));
            b.textContent = s.w;
            b.addEventListener('click', () => askAbout(bare(s.w)));
            wordsEl.appendChild(b);
          });
          hint.textContent = !spans.length ? ''
            : r ? `تُضاء «${sel.sentence.slice(r[0], r[1])}» على الشاشة. اضغط كلمة أخرى لتغييرها`
            : 'اضغط الكلمة التي تسأل عنها لتُضاء على الشاشة';
        }

        /** Make the question ask about `w`: quote it, or write the usual question. */
        function askAbout(w: string) {
          if (!w) return;
          const t = sel.text.trim();
          const letters = (s: string) => s.replace(/[ً-ْٰـ]/g, '');
          if (!t || /^ما إعراب «[^»]*»؟?$/.test(t)) sel.text = `ما إعراب «${w}»؟`;
          else if (/«[^»]*»/.test(sel.text)) sel.text = sel.text.replace(/«[^»]*»/, `«${w}»`);
          else {
            // The word already written plainly in the question: quote it there.
            const r = askedRange(sel.text, `«${letters(w)}»`);
            if (r) sel.text = `${sel.text.slice(0, r[0])}«${sel.text.slice(r[0], r[1])}»${sel.text.slice(r[1])}`;
            else { toast('ضع الكلمة بين «» في نص السؤال لتُضاء على الشاشة.'); return; }
          }
          qtextIn.value = sel.text;
          renderWords(); renderIssue(); refreshCurrentRail(); touch();
        }

        function tickBtn(on: boolean, label: string): HTMLButtonElement {
          const b = document.createElement('button');
          b.type = 'button'; b.className = 'me-ck';
          b.setAttribute('aria-pressed', String(on));
          b.setAttribute('aria-label', label);
          b.innerHTML = TICK_SVG;
          return b;
        }
        function lbl(text: string): HTMLElement {
          const p = document.createElement('span');
          p.className = 'me-lbl'; p.textContent = text;
          return p;
        }

        function renderAnswers() {
          answersEl.textContent = '';
          const t = sel.type;
          if (t === 'mcq') {
            answersEl.appendChild(lbl('الخيارات · اضغط دائرة الخيار الصحيح'));
            const tiles = document.createElement('div'); tiles.className = 'me-tiles';
            sel.mcq.forEach((v, i) => {
              const tile = document.createElement('div');
              tile.className = `me-tile ${tileClass(i)}${sel.mcqRight === i ? ' right' : ''}`;
              tile.innerHTML = `${shapeSvg(i)}<span class="lt">${LETTERS[i] ?? ''}</span>`;
              const input = document.createElement('input');
              input.type = 'text'; input.className = 'me-tile-in'; input.maxLength = 80; input.value = v;
              input.placeholder = i < 2 ? 'خيار' : 'خيار (اختياري)';
              input.setAttribute('aria-label', `الخيار ${LETTERS[i] ?? i + 1}`);
              input.addEventListener('input', () => { sel.mcq[i] = input.value; renderIssue(); refreshCurrentRail(); touch(); });
              const ck = tickBtn(sel.mcqRight === i, `اجعل الخيار ${LETTERS[i] ?? i + 1} الإجابة الصحيحة`);
              ck.addEventListener('click', () => {
                sel.mcqRight = i;
                tiles.querySelectorAll('.me-tile').forEach((x, k) => { x.classList.toggle('right', k === i); x.querySelector('.me-ck')?.setAttribute('aria-pressed', String(k === i)); });
                renderIssue(); refreshCurrentRail(); touch();
              });
              tile.append(input, ck);
              tiles.appendChild(tile);
            });
            answersEl.appendChild(tiles);
          } else if (t === 'true_false') {
            answersEl.appendChild(lbl('الحكم الصحيح'));
            const tiles = document.createElement('div'); tiles.className = 'me-tiles';
            [true, false].forEach((val, i) => {
              const tile = document.createElement('div');
              tile.className = `me-tile ${tileClass(i)}${sel.tf === val ? ' right' : ''}`;
              tile.innerHTML = `${shapeSvg(i)}<span class="lt">${LETTERS[i]}</span><span class="tx">${val ? 'صواب' : 'خطأ'}</span>`;
