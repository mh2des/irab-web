        // ═══ Bank ════════════════════════════════════════════════════════
        const bankDrawer = q('[data-bank-drawer]');
        let bankDocs: any[] = [];
        let bankType = '';
        function openDrawer(el: HTMLElement) {
          el.hidden = false;
          (el.querySelector('[data-close]') as HTMLElement)?.focus();
        }
        root!.querySelectorAll<HTMLElement>('.me-scrim').forEach((s) => {
          s.addEventListener('click', (e) => { if (e.target === s || (e.target as HTMLElement).closest('[data-close]')) s.hidden = true; });
        });
        function renderBank() {
          const list = q('[data-bank-list]');
          list.textContent = '';
          const term = q<HTMLInputElement>('[data-bank-q]').value.trim();
          const types = q('[data-bank-types]');
          types.textContent = '';
          for (const [k, label] of [['', 'الكل'], ...EDITOR_TYPES.map((t) => [t, TYPE_LABELS[t]])]) {
            const b = document.createElement('button');
            b.type = 'button'; b.className = 'me-chip'; b.textContent = label;
