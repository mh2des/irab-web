          sel = c;
          renderAll(); touch();
          toast('كُرّر السؤال. عدّل النسخة كما تشاء.');
        });
        const move = (d: number) => {
          const i = idx(); const j = i + d;
          if (j < 0 || j >= items.length) return;
          [items[i], items[j]] = [items[j], items[i]];
          renderRail(); renderSide(); touch();
        };
        q('[data-up]').addEventListener('click', () => move(-1));
        q('[data-down]').addEventListener('click', () => move(1));
        q('[data-del]').addEventListener('click', () => {
          const i = idx();
          const gone = sel;
          items.splice(i, 1);
          // The last question gone leaves an empty one in its place.
          const placeholder = items.length ? null : blankItem();
          if (placeholder) items.push(placeholder);
          sel = items[Math.min(i, items.length - 1)];
          renderAll(); touch();
          if (!isBlank(gone)) {
            toast('حُذف السؤال.', { label: 'تراجع', fn: () => {
              if (placeholder && isBlank(placeholder)) items = items.filter((x) => x !== placeholder);
              items.splice(Math.min(i, items.length), 0, gone);
              sel = gone; renderAll(); touch();
