        // Leaving through «مجالسي»: save first; warn about unfinished work.
        q<HTMLAnchorElement>('[data-back]').addEventListener('click', async (e) => {
          e.preventDefault();
          const go = () => { leaving = true; location.href = '/majlis/host'; };
          if (hasUnfinished()) {
            const n = items.filter((it) => !isBlank(it) && !toWire(it).wire).length;
            toast(n === 1 ? 'في مجلسك سؤال غير مكتمل، تُحفظ آخر نسخة مكتملة منه فقط.' : 'في مجلسك أسئلة غير مكتملة، تُحفظ آخر نسخة مكتملة منها فقط.',
              { label: 'اخرج', fn: async () => { await saveNow(); go(); } }, 8000);
            return;
