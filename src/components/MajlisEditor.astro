        q('[data-acc-sw]').addEventListener('click', () => { settings.scoring = settings.scoring === 'accuracy' ? 'speed' : 'accuracy'; renderSide(); touch(); });

        function insertAfterSel(...add: Item[]) {
          let at = idx() + 1;
          // A blank question in hand is replaced, not kept.
          if (items.length && isBlank(sel)) { at = idx(); items.splice(at, 1); }
          items.splice(at, 0, ...add);
          sel = add[0];
