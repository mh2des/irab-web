            row.type = 'button'; row.className = 'me-bank-row';
            const locked = !isPremium && PREMIUM_TYPES.has(String(v.type));
            row.innerHTML = `<span class="me-qi-meta"><span class="me-tag">${TYPE_LABELS[String(v.type)] ?? '؟'}</span>${locked ? PLUS_CHIP : ''}</span><p></p>`;
            row.querySelector('p')!.textContent = String(v.questionText ?? '') + (v.sourceText ? ` «${v.sourceText}»` : '');
            row.addEventListener('click', () => {
              if (locked) { paywall(); return; }
              if (!canAdd()) return;
              // Bank reuse mints a FRESH id and drops provenance/bank flags (contract §2).
