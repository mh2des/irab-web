---
/**
 * Article FAQ, drop-in FAQ section + JSON-LD schema injection.
 */
import Container from './Container.astro';

interface FaqItem { q: string; a: string; }

interface Props {
  items: FaqItem[];
  lang?: 'en' | 'ar';
}

const { items, lang = 'ar' } = Astro.props;

const t = lang === 'ar'
  ? { eyebrow: 'أسئلة شائعة', title: 'أسئلة متكررة' }
  : { eyebrow: 'Common questions', title: 'Frequently asked' };

const titleClass = lang === 'ar' ? 'font-arabic-display' : 'font-display';
const bodyClass  = lang === 'ar' ? 'font-arabic leading-loose' : '';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<section class="py-16 md:py-20 border-t border-stone dark:border-coal-edge">
  <Container size="narrow">
    <p class="eyebrow mb-4">{t.eyebrow}</p>
    <h2 class:list={[titleClass, 'text-[clamp(1.75rem,3.5vw,2.5rem)] tracking-tight mb-10']}>{t.title}</h2>

    <div class="flex flex-col gap-2.5" data-acc-group>
      {items.map((f) => (
        <details class="card overflow-hidden group" data-acc>
          <summary class="flex items-center justify-between gap-4 list-none select-none px-5 py-5 md:px-6 [&::-webkit-details-marker]:hidden">
            <h3 class:list={[titleClass, 'text-h3 leading-snug transition-colors duration-200 group-hover:text-purple']}>{f.q}</h3>
            <span class="acc-icon shrink-0 grid place-items-center w-8 h-8 rounded-full bg-purple/8 group-hover:bg-purple/15 text-purple">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path class="acc-v" d="M12 5v14"/><path d="M5 12h14"/></svg>
            </span>
          </summary>
          <div class="acc-panel px-5 md:px-6 pb-6">
            <p class:list={[bodyClass, 'text-body text-ink/70 dark:text-mist/70 pe-10']}>{f.a}</p>
          </div>
        </details>
      ))}
    </div>
  </Container>
</section>

<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
