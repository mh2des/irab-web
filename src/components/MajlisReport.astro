---
/**
 * MajlisReport — full report for a finished majlis, mirroring the app's
 * MajalisReportScreen (contract: docs/majlis-host-contracts.md Part 3 §2):
 * reads majalis_reports/{roomId} (host-only per rules), renders the 2×2 stat
 * grid, hardest/easiest cards, the all-questions list with per-question
 * drill-down (correct/wrong tiles + distribution bars with per-type labels),
 * and the full standings. Server-first load with cache fallback and a retry
 * button. Distribution coerced defensively (Map OR List with holes).
 * 2026-10 additions: the badges, the scoring mode and length, a
 * student-by-question grid (perQuestion[i].answers), «لم يجب» counts, CSV
 * export, «أعد المجلس» (host the same quiz again) and «مجلس علاجي» (the AI
 * editor on this majlis's weak points).
 * Western digits, Thmanyah headings, no em-dashes.
 */
---

<div data-mreport-root dir="rtl" class="mx-auto w-full max-w-3xl">

  <div data-v="loading" class="grid gap-3">
    <div class="skeleton h-10 w-44 rounded-xl"></div>
    <div class="grid grid-cols-2 gap-2">
      <div class="skeleton h-24 rounded-2xl"></div>
      <div class="skeleton h-24 rounded-2xl"></div>
      <div class="skeleton h-24 rounded-2xl"></div>
      <div class="skeleton h-24 rounded-2xl"></div>
    </div>
    <div class="skeleton h-16 rounded-2xl"></div>
    <div class="skeleton h-16 rounded-2xl"></div>
  </div>

  <section data-v="gate" class="hidden">
    <div class="card p-8 text-center">
      <h1 class="font-sans font-black text-2xl text-ink dark:text-mist">سجّل الدخول لعرض التقرير</h1>
      <a data-login-link href="/login?next=/majlis/host?tab=history" class="btn-primary btn-lg mt-5">تسجيل الدخول</a>
    </div>
  </section>

  <section data-v="error" class="hidden">
    <div class="card p-8 text-center">
      <h1 class="font-sans font-black text-xl text-ink dark:text-mist">تعذر تحميل التقرير. تحقق من اتصالك بالإنترنت وحاول مجددًا.</h1>
      <div class="mt-5 flex justify-center gap-2">
        <button type="button" data-retry class="btn-primary">حاول مجددًا</button>
        <a href="/majlis/host?tab=history" class="btn-ghost">إلى السجل</a>
      </div>
    </div>
  </section>

  <section data-v="report" class="hidden">
    <div class="flex items-center justify-between gap-3 flex-wrap">
      <div>
        <p class="text-sm font-bold text-teal">مجالس الإعراب</p>
        <h1 class="font-sans font-black text-2xl text-ink dark:text-mist">تقرير المجلس</h1>
      </div>
      <a href="/majlis/host?tab=history" class="btn-ghost px-4 text-sm">السجل</a>
    </div>
    <p data-r-title class="mt-2 text-[15px] font-bold text-ink-soft dark:text-mist-soft leading-relaxed"></p>
    <div data-r-meta class="mt-2 flex flex-wrap items-center gap-2 text-sm text-ink-subtle dark:text-mist-subtle"></div>

    <!-- Next steps for the teacher -->
    <div class="mt-4 flex flex-wrap gap-2">
      <button type="button" data-r-again class="btn-primary">أعد المجلس</button>
      <a data-r-remedial href="/majlis/create" class="btn-ghost" title="أسئلة جديدة يولّدها الذكاء الاصطناعي على ما أخطأ فيه طلابك في هذا المجلس">مجلس علاجي</a>
      <button type="button" data-r-csv class="btn-ghost">تنزيل النتائج (CSV)</button>
    </div>
    <p data-r-action-msg class="hidden mt-2 text-sm font-bold text-ink-muted dark:text-mist-muted"></p>

    <!-- Stats -->
    <div data-r-stats class="mt-5 grid grid-cols-2 gap-2"></div>

    <!-- Hardest / easiest -->
    <div data-r-extremes class="mt-3 grid gap-2"></div>

    <!-- Badges -->
    <div data-r-badges-wrap class="hidden">
      <h2 class="font-sans font-black text-lg text-ink dark:text-mist mt-7">الأوسمة</h2>
      <div data-r-badges class="mt-3 grid gap-2 sm:grid-cols-2"></div>
    </div>

    <!-- Student by question -->
    <div data-r-grid-wrap class="hidden">
      <h2 class="font-sans font-black text-lg text-ink dark:text-mist mt-7">إجابات الطلاب</h2>
      <p class="mt-1 text-sm text-ink-subtle dark:text-mist-subtle">كل صف طالب وكل عمود سؤال. مرّر المؤشر على خانة لترى الإجابة.</p>
      <div class="mt-3 overflow-x-auto rounded-2xl border border-stone dark:border-coal-edge bg-card dark:bg-coal-soft">
        <table data-r-grid class="w-full text-sm"></table>
      </div>
    </div>

    <!-- All questions -->
    <h2 class="font-sans font-black text-lg text-ink dark:text-mist mt-7">كل الأسئلة</h2>
    <div data-r-questions class="mt-3 grid gap-2"></div>

    <!-- Standings -->
    <h2 class="font-sans font-black text-lg text-ink dark:text-mist mt-7">ترتيب المشاركين</h2>
    <div data-r-standings class="mt-3 grid gap-1.5"></div>
  </section>
</div>

<script>
  import { maybeSignedIn } from '../lib/session';
  import { firestore } from '../lib/majlis/fb';
  import { stagger, countUp, refire, showAnimated } from '../lib/majlis-fx';
  import { BADGES, readAwards } from '../lib/majlis/badges';

  const root = document.querySelector<HTMLElement>('[data-mreport-root]');
  if (root) {
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const views = ['loading', 'gate', 'error', 'report'];
    const show = (v: string) => showAnimated(root!, views, v);

    const roomId = new URLSearchParams(location.search).get('room');
    const TYPE_LABELS: Record<string, string> = {
      mcq: 'اختيار من متعدد', true_false: 'صواب وخطأ', tap_word: 'تحديد الكلمة',
      fix_error: 'صحّح الخطأ', arrange_irab: 'ترتيب الإعراب',
    };
    const wordsOf = (s: any) => String(s ?? '').split(/\s+/).filter(Boolean);
    const pctColor = (p: number) => p >= 60 ? 'text-teal' : p >= 35 ? 'text-amber-500' : 'text-rose-500';

    if (!roomId) { location.href = '/majlis/host?tab=history'; }
    else if (!maybeSignedIn()) { show('gate'); }
    else init();

    async function init() {
      const [{ onAuth }, fs, db] = await Promise.all([import('../lib/auth'), import('firebase/firestore'), firestore()]);
      let started = false;

      onAuth(async (u) => {
        if (!u || u.isAnonymous) { show('gate'); return; }
        if (started) return;
        started = true;
        const uid = u.uid;

        q<HTMLButtonElement>('[data-retry]').addEventListener('click', () => { show('loading'); load(); });
        load();

        async function load() {
          // Server first, cache fallback (app parity: fresh report preferred).
          let snap: any = null;
          try { snap = await fs.getDocFromServer(fs.doc(db, 'majalis_reports', String(roomId))); }
          catch {
            try { snap = await fs.getDocFromCache(fs.doc(db, 'majalis_reports', String(roomId))); }
            catch { /* fall through */ }
          }
          if (!snap || !snap.exists()) { show('error'); return; }
          let v: any;
          try { v = snap.data(); } catch { show('error'); return; }
          render(v);
          wireActions(v, uid);
          show('report');
          namedTitle(v, uid);
        }

        // A majlis named in the creator shows that name instead of its
        // first question (launched quiz -> its draft -> titleCustom).
        async function namedTitle(v: any, uid: string) {
          try {
            if (!v.quizId) return;
            const draftId = String((await fs.getDoc(fs.doc(db, 'majalis_quizzes', String(v.quizId)))).get('draftId') ?? '');
            if (!draftId) return;
            const d = await fs.getDoc(fs.doc(db, 'majalis_drafts', uid, 'drafts', draftId));
            const t = String(d.get('title') ?? '').trim();
            if (d.get('titleCustom') === true && t) q<HTMLElement>('[data-r-title]').textContent = t;
          } catch { /* the first question stays */ }
        }

        // ── Next steps: host again, remedial majlis, CSV ─────────────────
        function wireActions(v: any, uid: string) {
          const msg = q<HTMLElement>('[data-r-action-msg]');
          const say = (t: string) => { msg.textContent = t; msg.classList.remove('hidden'); };
          q<HTMLAnchorElement>('[data-r-remedial]').href = `/majlis/create?remedial=${encodeURIComponent(String(roomId))}`;
          q<HTMLButtonElement>('[data-r-csv]').onclick = () => downloadCsv(v);
          const again = q<HTMLButtonElement>('[data-r-again]');
          again.onclick = async () => {
            again.disabled = true; say('نجهّز المجلس…');
            try {
              // The launched quiz remembers its draft; if that draft was
              // deleted, rebuild one from the quiz so the same questions run.
              const quiz = v.quizId ? await fs.getDoc(fs.doc(db, 'majalis_quizzes', String(v.quizId))) : null;
              let draftId = String(quiz?.get('draftId') ?? '');
              const exists = draftId ? (await fs.getDoc(fs.doc(db, 'majalis_drafts', uid, 'drafts', draftId))).exists() : false;
              if (!exists) {
                const questions = (quiz?.get('questions') as any[] | undefined) ?? [];
                if (!questions.length) { say('لم نعد نجد أسئلة هذا المجلس.'); again.disabled = false; return; }
                const first = questions[0] ?? {};
                const title = String(first.sourceText ?? first.questionText ?? 'مجلس إعرابي').trim().slice(0, 60);
                const ref = await fs.addDoc(fs.collection(db, 'majalis_drafts', uid, 'drafts'), {
                  title, questions, createdAt: fs.Timestamp.now(), updatedAt: fs.Timestamp.now(),
                  hasAiQuestions: questions.some((x: any) => !!x?.aiGenerated),
                });
                draftId = ref.id;
              }
              location.href = `/majlis/live?draft=${encodeURIComponent(draftId)}`;
            } catch {
              say('تعذّر تجهيز المجلس. تحقق من اتصالك ثم جرّب مجددًا.');
              again.disabled = false;
            }
          };
        }
      });
    }

    // App-parity defensive coercion: distribution may arrive as a Map or a
    // sparse List; counts may be numbers or strings.
    function coerceDistribution(raw: any): Record<string, number> {
      const out: Record<string, number> = {};
      if (Array.isArray(raw)) {
        raw.forEach((c, i) => { if (c != null) out[String(i)] = Number(c) || 0; });
      } else if (raw && typeof raw === 'object') {
        for (const [k, c] of Object.entries(raw)) out[String(k)] = Number(c) || 0;
      }
      return out;
    }

    let playerCount = 0;
    function render(v: any) {
      const per: any[] = Array.isArray(v.perQuestion) ? v.perQuestion : [];
      playerCount = Number(v.participantCount) || (Array.isArray(v.participants) ? v.participants.length : 0);
      q<HTMLElement>('[data-r-title]').textContent = String(per[0]?.questionText ?? 'مجلس إعرابي');

      // Accuracy is out of the questions actually played. Reports written
      // before playedCount existed divided by the planned count, so it is
      // recomputed here from each player's correct answers.
      const players: any[] = Array.isArray(v.participants) ? v.participants : [];
      const played = Number(v.playedCount) || per.length;
      const planned = Math.max(Number(v.qCount) || 0, played);
      const avg = players.length && played
        ? players.reduce((sum, p) => sum + Math.min(1, (Number(p?.correctCount) || 0) / played), 0) / players.length
        : 0;

      const metaRow = q<HTMLElement>('[data-r-meta]');
      metaRow.innerHTML = '';
      const chip = (text: string, strong = false) => {
        const c = document.createElement('span');
        c.className = strong
          ? 'rounded-full bg-paper-soft dark:bg-coal border border-stone dark:border-coal-edge px-2.5 py-0.5 text-xs font-black text-ink-soft dark:text-mist-soft'
          : '';
        c.textContent = text;
        metaRow.appendChild(c);
      };
      const at = typeof v.finishedAt?.toDate === 'function' ? v.finishedAt.toDate() : null;
      if (at) chip(at.toLocaleDateString('ar-u-nu-latn', { day: 'numeric', month: 'long', year: 'numeric' }));
      const startMs = Number(v.startedAtMs) || 0;
      if (at && startMs) {
        const mins = Math.max(1, Math.round((at.getTime() - startMs) / 60000));
        chip(mins === 1 ? 'استغرق دقيقة واحدة' : mins === 2 ? 'استغرق دقيقتين' : mins <= 10 ? `استغرق ${mins} دقائق` : `استغرق ${mins} دقيقة`);
      }
      if (v.scoring === 'accuracy') chip('الدقة أولًا', true);
      if (v.partial === true) chip('انتهى تلقائيًّا بعد انقطاع المضيف', true);
      else if (played < planned) chip(`لُعب ${played} من ${planned} أسئلة`, true);

      const statsWrap = q<HTMLElement>('[data-r-stats]');
      statsWrap.innerHTML = '';
      const stats: Array<{ label: string; val: number; suffix?: string }> = [
        { label: 'مشاركون', val: Number(v.participantCount) || 0 },
        { label: played < planned ? `أسئلة لُعبت من ${planned}` : 'أسئلة', val: played },
        { label: 'متوسط الدقة', val: Math.round(avg * 100), suffix: '%' },
        { label: 'أعلى نقاط', val: Number(v.topScore) || 0 },
      ];
      stats.forEach((s, i) => {
        const el = document.createElement('div');
        el.className = 'card px-4 py-4 text-center';
        el.innerHTML = `<p data-num class="text-2xl font-black text-ink dark:text-mist tabular-nums">0</p><p class="mt-1 text-sm text-ink-subtle dark:text-mist-subtle">${s.label}</p>`;
        stagger(el, i);
        statsWrap.appendChild(el);
        countUp(el.querySelector<HTMLElement>('[data-num]')!, s.val, { ms: 900, suffix: s.suffix });
      });

      // Hardest / easiest
      const ext = q<HTMLElement>('[data-r-extremes]');
      ext.innerHTML = '';
      const byIndex = (i: any) => per.find((p) => Number(p?.index) === Number(i));
      const extremeCard = (label: string, cls: string, p: any) => {
        const el = document.createElement('button');
        el.type = 'button';
        el.className = 'card card-interactive text-start p-4';
        const pct = Math.round((Number(p.correctRate) || 0) * 100);
        el.innerHTML = `<div class="flex items-center justify-between gap-3"><span class="text-sm font-black ${cls}">${label}</span><span class="font-black tabular-nums ${cls}">${pct}%</span></div><p class="mt-1.5 text-[15px] font-bold text-ink dark:text-mist leading-relaxed" data-x-text></p>`;
        el.querySelector('[data-x-text]')!.textContent = String(p.questionText ?? '');
        el.addEventListener('click', () => {
          const row = q<HTMLElement>(`[data-q-row="${Number(p.index)}"]`);
          row?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          row?.querySelector<HTMLButtonElement>('button')?.click();
        });
        return el;
      };
      const hardest = v.hardestIndex != null ? byIndex(v.hardestIndex) : null;
      const easiest = v.easiestIndex != null ? byIndex(v.easiestIndex) : null;
      if (hardest) ext.appendChild(extremeCard('أصعب سؤال', 'text-rose-500', hardest));
      if (easiest && easiest !== hardest) ext.appendChild(extremeCard('أسهل سؤال', 'text-teal', easiest));

      // All questions with expandable drill-down
      const list = q<HTMLElement>('[data-r-questions]');
      list.innerHTML = '';
      [...per].sort((a, b) => Number(a?.index) - Number(b?.index))
        .forEach((p, i) => { const row = questionRow(p); stagger(row, i); list.appendChild(row); });

      // Standings (all, stored score-desc)
      const st = q<HTMLElement>('[data-r-standings]');
      st.innerHTML = '';
      const rows = players;
      rows.forEach((p, i) => {
        const row = document.createElement('div');
        row.className = 'flex items-center gap-3 rounded-xl border border-stone dark:border-coal-edge bg-card dark:bg-coal-soft px-3.5 py-2.5';
        stagger(row, i);
        row.innerHTML = `<span class="w-6 text-center font-black tabular-nums ${i === 0 ? 'text-purple' : 'text-ink-muted dark:text-mist-muted'}">${i + 1}</span>
          <img src="/majlis-avatars/a${((Number(p.avatar) || 0) % 64 + 64) % 64}.svg" width="28" height="28" alt="" class="w-7 h-7 rounded-full" />
          <span class="flex-1 font-bold text-[15px] text-ink dark:text-mist truncate"></span>
          <span class="text-sm tabular-nums text-ink-subtle dark:text-mist-subtle">${Number(p.correctCount) || 0} من ${played} صحيحة</span>
          <span class="w-14 text-end font-black tabular-nums text-ink-soft dark:text-mist-soft">${Number(p.score) || 0}</span>`;
        row.querySelector('span.flex-1')!.textContent = String(p.name ?? '؟');
        st.appendChild(row);
      });
      if (!rows.length) st.innerHTML = '<p class="text-sm text-ink-muted dark:text-mist-muted">بلا مشاركين</p>';

      renderBadges(v);
      renderGrid(per, players);
    }

    function renderBadges(v: any) {
      const list = readAwards(Object.fromEntries((Array.isArray(v.badges) ? v.badges : []).map((b: any, i: number) => [String(i), b])));
      q('[data-r-badges-wrap]').classList.toggle('hidden', list.length === 0);
      const wrap = q<HTMLElement>('[data-r-badges]');
      wrap.innerHTML = '';
      // One card per badge; a shared badge (ties, the top three) lists names.
      const ids = [...new Set(list.map((b) => b.id))];
      ids.forEach((id) => {
        const names = list.filter((b) => b.id === id).map((b) => b.name).join('، ');
        const el = document.createElement('div');
        el.className = 'card p-3 flex items-center gap-3';
        el.innerHTML = `<img src="/majlis-fx/${BADGES[id].img}.png" alt="" width="36" height="36" class="w-9 h-9 shrink-0" /><div class="min-w-0"><p class="font-black text-ink dark:text-mist" data-t></p><p class="text-sm text-ink-subtle dark:text-mist-subtle" data-s></p></div>`;
        el.querySelector('[data-t]')!.textContent = BADGES[id].title;
        el.querySelector('[data-s]')!.textContent = `${names} · ${BADGES[id].rule}`;
        wrap.appendChild(el);
      });
    }

    /** An answer's words from its distribution key, per question type. */
    function answerLabel(p: any, k: string): string {
      if (!k || k === 'other') return 'أخرى';
      const options: string[] = Array.isArray(p?.options) ? p.options.map(String) : [];
      const words = wordsOf(p?.sourceText);
      switch (p?.type) {
        case 'true_false': return k === 'true' ? 'صواب' : 'خطأ';
        case 'arrange_irab': return k.split(',').map((i) => options[Number(i)] ?? '؟').join(' ');
        case 'fix_error': { const [w, o] = k.split('|').map(Number); return `«${words[w] ?? '؟'}» صوابها «${options[o] ?? '؟'}»`; }
        case 'tap_word': return words[Number(k)] ?? '؟';
        default: return options[Number(k)] ?? '؟';
      }
    }

    // Rows are students (standings order), columns are questions. Reports
    // from before 2026-10 have no per-student answers, so the grid hides.
    function renderGrid(per: any[], players: any[]) {
      const qs = [...per].sort((a, b) => Number(a?.index) - Number(b?.index));
      const has = qs.some((p) => p?.answers && typeof p.answers === 'object');
      q('[data-r-grid-wrap]').classList.toggle('hidden', !has || !players.length);
      if (!has) return;
      const t = q<HTMLElement>('[data-r-grid]');
      t.innerHTML = '';
      const head = document.createElement('tr');
      head.className = 'border-b border-stone dark:border-coal-edge';
      head.innerHTML = '<th class="sticky right-0 bg-card dark:bg-coal-soft px-3 py-2 text-start font-black">الطالب</th>' +
        qs.map((p, i) => `<th class="px-2 py-2 text-center font-black tabular-nums" title="">${'س' + (i + 1)}</th>`).join('') +
        '<th class="px-3 py-2 text-center font-black">الصحيحة</th><th class="px-3 py-2 text-center font-black">النقاط</th>';
      qs.forEach((p, i) => { (head.children[i + 1] as HTMLElement).title = String(p?.questionText ?? ''); });
      t.appendChild(head);
      for (const pl of players) {
        const tr = document.createElement('tr');
        tr.className = 'border-b border-stone/60 dark:border-coal-edge/60 last:border-0';
        const name = document.createElement('td');
        name.className = 'sticky right-0 bg-card dark:bg-coal-soft px-3 py-2 font-bold whitespace-nowrap max-w-[10rem] truncate';
        name.textContent = String(pl.name ?? '؟');
        tr.appendChild(name);
        qs.forEach((p) => {
          const a = p?.answers?.[pl.uid];
          const td = document.createElement('td');
          td.className = 'px-2 py-2 text-center font-black';
          if (!a) { td.textContent = '–'; td.className += ' text-ink-subtle dark:text-mist-subtle'; td.title = 'لم يجب'; }
          else if (a.c) { td.textContent = '✓'; td.className += ' text-teal'; td.title = `${answerLabel(p, a.k)} · ${a.p} نقطة`; }
          else { td.textContent = '✗'; td.className += ' text-rose-500'; td.title = answerLabel(p, a.k); }
          tr.appendChild(td);
        });
        const c = document.createElement('td'); c.className = 'px-3 py-2 text-center tabular-nums'; c.textContent = String(Number(pl.correctCount) || 0);
        const sc = document.createElement('td'); sc.className = 'px-3 py-2 text-center tabular-nums font-black'; sc.textContent = String(Number(pl.score) || 0);
        tr.append(c, sc);
        t.appendChild(tr);
      }
    }

    // A spreadsheet of the same grid, with each answer written out.
    function downloadCsv(v: any) {
      const per = (Array.isArray(v.perQuestion) ? v.perQuestion : []).slice().sort((a: any, b: any) => Number(a?.index) - Number(b?.index));
      const players: any[] = Array.isArray(v.participants) ? v.participants : [];
      const cell = (x: unknown) => { const t = String(x ?? ''); return /[",\n]/.test(t) ? `"${t.replace(/"/g, '""')}"` : t; };
      const header = ['الترتيب', 'الطالب', 'النقاط', 'الإجابات الصحيحة',
        ...per.map((p: any, i: number) => `س${i + 1}: ${String(p?.questionText ?? '').slice(0, 50)}`)];
      const lines = [header.map(cell).join(',')];
      players.forEach((pl, i) => {
        const row = [i + 1, pl.name, Number(pl.score) || 0, Number(pl.correctCount) || 0,
          ...per.map((p: any) => {
            const a = p?.answers?.[pl.uid];
            if (!p?.answers) return '';
            if (!a) return 'لم يجب';
            return `${a.c ? 'صحيحة' : 'خطأ'}: ${answerLabel(p, a.k)}`;
          })];
        lines.push(row.map(cell).join(','));
      });
      // BOM so Excel reads the Arabic as UTF-8.
      const blob = new Blob(['\ufeff' + lines.join('\r\n')], { type: 'text/csv;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      const day = typeof v.finishedAt?.toDate === 'function' ? v.finishedAt.toDate().toISOString().slice(0, 10) : 'majlis';
      a.download = `majlis-${day}.csv`;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 2000);
    }

    function questionRow(p: any) {
      const el = document.createElement('div');
      el.setAttribute('data-q-row', String(Number(p?.index) || 0));
      el.className = 'card overflow-hidden';
      const pct = Math.round((Number(p?.correctRate) || 0) * 100);
      const head = document.createElement('button');
      head.type = 'button';
      head.className = 'w-full text-start p-4 flex items-center gap-3';
      head.innerHTML = `<span class="flex-1 text-[15px] font-bold text-ink dark:text-mist leading-relaxed" data-q-text></span><span class="font-black tabular-nums ${pctColor(pct)}">${pct}%</span>`;
      head.querySelector('[data-q-text]')!.textContent = String(p?.questionText ?? '؟');
      const body = document.createElement('div');
      body.className = 'hidden px-4 pb-4 grid gap-3';
      head.addEventListener('click', () => {
        const nowHidden = body.classList.toggle('hidden');
        if (!nowHidden) {
          if (!body.childElementCount) fillDrilldown(body, p);
          refire(body, 'panel-in');
        }
      });
      el.append(head, body);
      return el;
    }

    function fillDrilldown(body: HTMLElement, p: any) {
      const type = String(p?.type ?? 'mcq');
      const meta = document.createElement('div');
      meta.className = 'flex items-center gap-2 flex-wrap';
      meta.innerHTML = `<span class="rounded-full bg-paper-soft dark:bg-coal border border-stone dark:border-coal-edge px-2.5 py-0.5 text-xs font-black text-ink-soft dark:text-mist-soft">${TYPE_LABELS[type] ?? '؟'}</span>`;
      body.appendChild(meta);
      if (p?.sourceText) {
        const src = document.createElement('p');
        src.className = 'text-[15px] text-ink-soft dark:text-mist-soft leading-relaxed';
        src.textContent = `«${p.sourceText}»`;
        body.appendChild(src);
      }

      const answered = Number(p?.answeredCount) || 0;
      const correct = Number(p?.correctCount) || 0;
      const unanswered = Math.max(0, playerCount - answered);
      const tiles = document.createElement('div');
      tiles.className = 'grid grid-cols-3 gap-2';
      tiles.innerHTML =
        `<div class="rounded-xl bg-teal/10 px-3 py-2.5 text-center"><p class="font-black text-teal tabular-nums">${correct}</p><p class="text-xs text-ink-subtle dark:text-mist-subtle">أجابوا صوابًا</p></div>` +
        `<div class="rounded-xl bg-rose-500/10 px-3 py-2.5 text-center"><p class="font-black text-rose-500 tabular-nums">${Math.max(0, answered - correct)}</p><p class="text-xs text-ink-subtle dark:text-mist-subtle">أجابوا خطأً</p></div>` +
        `<div class="rounded-xl bg-paper-soft dark:bg-coal px-3 py-2.5 text-center"><p class="font-black text-ink-muted dark:text-mist-muted tabular-nums">${unanswered}</p><p class="text-xs text-ink-subtle dark:text-mist-subtle">لم يجيبوا</p></div>`;
      body.appendChild(tiles);

      // Distribution rows with app-parity per-type labels.
      const dist = coerceDistribution(p?.distribution);
      const options: string[] = Array.isArray(p?.options) ? p.options.map(String) : [];
      const correctDisplay = String(p?.correctDisplay ?? '');
      let rows: Array<{ label: string; count: number; correct: boolean }> = [];
      if (type === 'true_false') {
        rows = [
          { label: 'صواب', count: dist['true'] ?? 0, correct: correctDisplay === 'صواب' },
          { label: 'خطأ', count: dist['false'] ?? 0, correct: correctDisplay === 'خطأ' },
        ];
      } else if (type === 'mcq') {
        rows = options.map((o, i) => ({ label: o, count: dist[String(i)] ?? 0, correct: o === correctDisplay }));
      } else if (type === 'tap_word') {
        rows = wordsOf(p?.sourceText).map((w, i) => ({ label: w, count: dist[String(i)] ?? 0, correct: w === correctDisplay }));
      } else {
        const words = wordsOf(p?.sourceText);
        rows = Object.entries(dist)
          .sort((a, b) => b[1] - a[1])
          .map(([k, count]) => {
            let label = 'أخرى';
            if (k !== 'other') {
              if (type === 'fix_error') {
                const [w, o] = k.split('|');
                label = `«${words[Number(w)] ?? '؟'}» صوابها «${options[Number(o)] ?? '؟'}»`;
              } else {
                label = k.split(',').map((i) => options[Number(i)] ?? '؟').join(' ');
              }
            }
            return { label, count, correct: label === correctDisplay };
          });
      }
      const total = Math.max(1, answered);
      const bars = document.createElement('div');
      bars.className = 'grid gap-1.5';
      rows.forEach((r, i) => {
        const bar = document.createElement('div');
        bar.className = 'relative overflow-hidden rounded-xl border px-3.5 py-2 ' + (r.correct ? 'border-teal' : 'border-stone dark:border-coal-edge');
        const fill = document.createElement('div');
        fill.className = 'mj-bar-fill absolute inset-y-0 start-0 ' + (r.correct ? 'bg-teal/15' : 'bg-purple/8');
        fill.style.setProperty('--ratio', '0');
        fill.style.transitionDelay = `${i * 70}ms`;
        requestAnimationFrame(() => requestAnimationFrame(() =>
          fill.style.setProperty('--ratio', String(r.count / total))));
        const line = document.createElement('div');
        line.className = 'relative flex items-center justify-between gap-3';
        line.innerHTML = `<span class="font-bold text-sm text-ink dark:text-mist truncate" data-b-label></span><span class="font-black tabular-nums text-xs ${r.correct ? 'text-teal' : 'text-ink-muted dark:text-mist-muted'}">${r.count}</span>`;
        line.querySelector('[data-b-label]')!.textContent = r.label;
        bar.append(fill, line);
        bars.appendChild(bar);
      });
      body.appendChild(bars);

      const ans = document.createElement('p');
      ans.className = 'text-sm font-bold text-teal';
      ans.textContent = `الإجابة الصحيحة: ${correctDisplay || '؟'}`;
      body.appendChild(ans);

      if (p?.explanation) {
        const ex = document.createElement('p');
        ex.className = 'text-sm text-ink-muted dark:text-mist-muted leading-relaxed';
        ex.textContent = String(p.explanation);
        body.appendChild(ex);
      }
    }
  }
</script>
