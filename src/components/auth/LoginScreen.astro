---
/**
 * LoginScreen: the whole of /login and /en/login.
 *
 * Phone: the form alone, under the minimal auth header, so every step of
 * signing in stays one short screen. From 1024px the screen splits: the form
 * keeps its column, and the other half shows what the account is for, one
 * real i'rab of a short sentence in the analyzer's colours, drawn word by
 * word. The panel is pure HTML and CSS (no image, no script), and on a phone
 * it is display:none, so its font is never fetched there.
 *
 * The form (AuthForm) and its Firebase logic are unchanged; this file only
 * places it.
 */
import '../../styles/irab-ui.css';
import AuthHeader from '../AuthHeader.astro';
import AuthForm from '../AuthForm.astro';

interface Props { lang?: 'ar' | 'en'; }
const { lang = 'ar' } = Astro.props;
const en = lang === 'en';
const dir = en ? 'ltr' : 'rtl';

const t = en
  ? {
      headline: 'Parse any sentence, word by word.',
      sub: "Your account opens the analyzer, the teacher, practice and the majalis, on the web and in the app.",
      sample: 'A sample analysis',
      words: [
        { w: 'العلمُ', role: "Mubtada' (subject)", note: 'Marked by a visible damma on its last letter.' },
        { w: 'نورٌ', role: 'Khabar (predicate)', note: 'Marked by a visible damma on its last letter.' },
      ],
      marfu: 'Nominative',
      foot: 'One account for the web and the iOS and Android apps.',
      privacy: 'Privacy', terms: 'Terms',
      copy: '© 2026 Irab App',
    }
  : {
      headline: 'أعرِب أيَّ جملة، كلمةً بكلمة.',
      sub: 'حسابك يفتح لك المحلّل والأستاذ والتدريب والمجالس، على الموقع وفي التطبيق.',
      sample: 'مثال من المحلّل',
      words: [
        { w: 'العلمُ', role: 'مبتدأ', note: 'وعلامة رفعه الضمة الظاهرة على آخره.' },
        { w: 'نورٌ', role: 'خبر', note: 'وعلامة رفعه الضمة الظاهرة على آخره.' },
      ],
      marfu: 'مرفوع',
      foot: 'حسابٌ واحد للموقع ولتطبيقَي iOS وAndroid.',
      privacy: 'الخصوصية', terms: 'الشروط',
      copy: '© ٢٠٢٦ إعراب آب',
    };
---

<div class="ls" dir={dir}>
  <div class="ls-side">
    <AuthHeader lang={lang} />
    <main class="ls-main">
      <AuthForm lang={lang} />
    </main>
    <footer class="ls-foot">
      <span>{t.copy}</span>
      <span aria-hidden="true">·</span>
      <a href="/privacy">{t.privacy}</a>
      <span aria-hidden="true">·</span>
      <a href="/terms">{t.terms}</a>
      <span aria-hidden="true">·</span>
      <a href="mailto:support@irab.app" dir="ltr">support@irab.app</a>
    </footer>
  </div>

  <aside class="ls-brand" lang={lang}>
    <div class="ls-panel">
      <div class="ls-top">
        <p class="ls-headline">{t.headline}</p>
        <p class="ls-sub">{t.sub}</p>
      </div>

      <figure class="ls-card">
        <figcaption class="ls-cap">{t.sample}</figcaption>
        <p class="ls-sentence" lang="ar" dir="rtl">
          {t.words.map((w, i) => <span class="ls-w" style={`--i:${i}`}>{w.w}</span>)}
        </p>
        <ol class="ls-rows">
          {t.words.map((w, i) => (
            <li class="ls-row" style={`--i:${i}`}>
              <span class="ls-row-word" lang="ar" dir="rtl">{w.w}</span>
              <span class="ls-row-body">
                <span class="ls-row-head"><strong>{w.role}</strong><span class="ls-case">{t.marfu}</span></span>
                <span class="ls-row-note">{w.note}</span>
              </span>
            </li>
          ))}
        </ol>
      </figure>

      <p class="ls-bottom">{t.foot}</p>
    </div>
  </aside>
</div>

<style>
  .ls { min-height: 100dvh; display: grid; }
  .ls-side { display: flex; flex-direction: column; min-height: 100dvh; min-width: 0; }
  .ls-main { flex: 1; display: grid; align-content: center; padding: clamp(2rem, 6vh, 3.5rem) 1.5rem; }
  .ls-foot {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.35rem 0.6rem;
    padding: 0 1.5rem 1.75rem; font-size: 0.9rem; color: var(--color-ink-subtle);
  }
  :global(.dark) .ls-foot { color: var(--color-mist-subtle); }
  .ls-foot a { transition: color .2s; }
  .ls-foot a:hover { color: var(--color-purple); }

  .ls-brand { display: none; }

  @media (min-width: 1024px) {
    .ls { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .ls-brand { display: block; position: sticky; top: 0; height: 100dvh; padding: 1rem; padding-inline-start: 0; }
  }

  /* The brand half: the site's ink, the site's lattice, nothing else. */
  .ls-panel {
    position: relative; isolation: isolate; overflow: hidden;
    height: 100%; border-radius: 28px;
    display: flex; flex-direction: column; justify-content: space-between; gap: 2rem;
    padding: clamp(2.25rem, 4vw, 3.5rem);
    color: #fff; background-color: #173847;
  }
  .ls-panel::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background-image:
      repeating-linear-gradient(45deg, rgb(255 255 255 / 0.05) 0 1px, transparent 1px 30px),
      repeating-linear-gradient(135deg, rgb(255 255 255 / 0.05) 0 1px, transparent 1px 30px);
  }
  :global(.dark) .ls-panel { background-color: #131B22; box-shadow: inset 0 0 0 1px #1C262E; }

  .ls-headline {
    margin: 0; max-width: 26rem;
    font-family: var(--font-arabic); font-weight: 700;
    font-size: clamp(2rem, 3.2vw, 2.8rem); line-height: 1.35; text-wrap: balance;
  }
  .ls-brand[lang='en'] .ls-headline { font-family: var(--font-sans); line-height: 1.12; letter-spacing: -0.02em; }
  .ls-sub { margin: 1rem 0 0; max-width: 28rem; font-size: 1.1rem; line-height: 1.8; color: rgb(255 255 255 / 0.74); }

  /* The sample: a light card, the way the analyzer shows a result. */
  .ls-card {
    margin: 0; max-width: 30rem; width: 100%; align-self: center;
    padding: 1.5rem 1.6rem 1.35rem; border-radius: 22px;
    color: #173847; background: #FFFFFF;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.55), 0 0 0 1px rgb(255 255 255 / 0.06);
  }
  :global(.dark) .ls-card { color: #F5F5F0; background: #0F171D; box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.7), inset 0 0 0 1px #2B3844; }
  .ls-cap { font-size: 0.85rem; font-weight: 700; color: #5E7077; }
  :global(.dark) .ls-cap { color: #8A9096; }
  .ls-sentence {
    display: flex; justify-content: center; gap: 1.1rem; margin: 0.75rem 0 1rem;
    font-family: 'Amiri', var(--font-arabic); font-size: 2.6rem; font-weight: 700; line-height: 1.7;
  }
  .ls-w {
    position: relative; color: #7C4DFF;
    animation: ls-word .7s cubic-bezier(.22, 1, .36, 1) both;
    animation-delay: calc(0.25s + var(--i) * 0.35s);
  }
  /* The case underline the analyzer draws under a word, drawn in. */
  .ls-w::after {
    content: ''; position: absolute; inset-inline: 0.1em; bottom: 0.18em; height: 3px; border-radius: 99px;
    background: currentColor; opacity: .35; transform: scaleX(0);
    animation: ls-line .6s cubic-bezier(.22, 1, .36, 1) both;
    animation-delay: calc(0.6s + var(--i) * 0.35s);
  }
  .ls-rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .ls-row {
    display: flex; align-items: flex-start; gap: 0.9rem;
    padding: 0.8rem 0.95rem; border-radius: 14px; background: #F4F1EA;
    animation: ls-row .6s cubic-bezier(.22, 1, .36, 1) both;
    animation-delay: calc(0.9s + var(--i) * 0.3s);
  }
  :global(.dark) .ls-row { background: #131B22; }
  .ls-row-word { flex: none; min-width: 3.4rem; font-family: 'Amiri', var(--font-arabic); font-size: 1.45rem; font-weight: 700; line-height: 1.5; color: #7C4DFF; }
  :global(.dark) .ls-row-word, :global(.dark) .ls-w { color: #A88BFF; }
  .ls-row-body { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .ls-row-head { display: flex; align-items: center; gap: 0.5rem; font-size: 1.02rem; line-height: 1.5; }
  .ls-case { padding: 0.05rem 0.55rem; border-radius: 999px; font-size: 0.78rem; font-weight: 700; color: #6200EA; background: #F2EDFF; }
  :global(.dark) .ls-case { color: #C4B0FF; background: #26244A; }
  .ls-row-note { font-size: 0.92rem; line-height: 1.65; color: #5E7077; }
  :global(.dark) .ls-row-note { color: #8A9096; }

  .ls-bottom { margin: 0; font-size: 0.98rem; font-weight: 600; color: rgb(255 255 255 / 0.7); }

  @keyframes ls-word { from { opacity: 0; translate: 0 10px; } to { opacity: 1; translate: 0 0; } }
  @keyframes ls-line { to { transform: scaleX(1); } }
  @keyframes ls-row { from { opacity: 0; translate: 0 8px; } to { opacity: 1; translate: 0 0; } }
  @media (prefers-reduced-motion: reduce) {
    .ls-w, .ls-w::after, .ls-row { animation: none; }
    .ls-w::after { transform: none; }
  }
</style>
