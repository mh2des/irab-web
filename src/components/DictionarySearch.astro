---
/**
 * DictionarySearch: the smart (AI) Arabic dictionary as a web tool.
 * Login-gated (the worker /api/dictionary needs a Firebase token); free users
 * get their daily quota, premium unlimited: enforced server side, same engine
 * as the app. Firebase loads only on this tool page, never on content pages.
 *
 * Renders the full v3 entry (2026-08): every vocalised reading as a tab,
 * meaning first, how the word behaves in i'rab, morphology, collocations and
 * common mistakes, the root family, Quran occurrences linking to the ayah
 * i'rab pages, the classical-dictionary excerpt (qamoos.org) with a
 * "matches the dictionaries" badge, and translations. Old (v2) responses
 * still render: every section is optional.
 */
import Paywall from './Paywall.astro';
interface Props { lang?: 'ar' | 'en'; }
const { lang = 'ar' } = Astro.props;
const login = lang === 'ar' ? '/login' : '/en/login';
const dir = lang === 'ar' ? 'rtl' : 'ltr';

const t = lang === 'ar'
  ? {
      placeholder: 'اكتب كلمة عربية…', search: 'بحث',
      signedOutTitle: 'سجّل الدخول لاستعمال المعجم',
      signedOutBody: 'المعجم الذكي متاح لأصحاب الحساب. سجّل الدخول مجاناً للبدء.',
      signIn: 'تسجيل الدخول',
      tryRoots: 'جرّب هذه الجذور:',
    }
  : {
      placeholder: 'Type an Arabic word…', search: 'Search',
      signedOutTitle: 'Sign in to use the dictionary',
      signedOutBody: 'The smart dictionary is for account holders. Sign in free to start.',
      signIn: 'Sign in',
      tryRoots: 'Try these roots:',
    };
---
<div data-dict-root data-lang={lang} data-login={login} dir={dir} class="w-full max-w-2xl mx-auto">
  {/* Signed-out gate */}
  <div data-dict-gate class="hidden card panel-in p-8 md:p-10 text-center">
    <h2 class="font-arabic-display text-h2 mb-3">{t.signedOutTitle}</h2>
    <p class="text-body text-ink/75 dark:text-mist/75 mb-7 max-w-md mx-auto">{t.signedOutBody}</p>
    <a href={login} class="btn-primary btn-lg">{t.signIn}</a>
  </div>

  {/* Tool (shown when signed in) */}
  <div data-dict-tool class="hidden">
    <form data-dict-form class="flex gap-2 mb-3">
      <input data-dict-input type="text" dir="rtl" autocomplete="off" placeholder={t.placeholder}
        class="input flex-1 text-lg" />
      <button type="submit" data-dict-submit class="btn-primary">
        <span data-dict-submit-label>{t.search}</span>
      </button>
    </form>
    <p data-dict-quota class="text-small font-semibold text-ink/65 dark:text-mist/65 mb-6 h-5"></p>

    {/* Empty-state suggestions: tap a curated root to run a real lookup. */}
    <div data-dict-examples class="mb-6">
      <p class="text-small font-semibold text-ink-subtle dark:text-mist-subtle mb-2">{t.tryRoots}</p>
      <div class="flex flex-wrap gap-2">
        {['كتب', 'علم', 'نور', 'صبر', 'رحمة', 'فهم'].map((w) => (
          <button type="button" class="ex-chip" data-dict-example={w} lang="ar" dir="rtl">{w}</button>
        ))}
      </div>
    </div>

    <p data-dict-msg class="hidden text-small rounded-lg px-4 py-3 mb-4"></p>

    {/* Skeleton shown while a fresh word is being generated (5 to 10 s). */}
    <div data-dict-pending class="hidden" aria-busy="true">
      <div class="card p-6 md:p-8">
        <div class="skeleton h-9 w-40 rounded-lg mb-5"></div>
        <div class="skeleton h-4 w-full rounded mb-2"></div>
        <div class="skeleton h-4 w-5/6 rounded mb-2"></div>
        <div class="skeleton h-4 w-2/3 rounded mb-6"></div>
        <div class="skeleton h-4 w-1/2 rounded mb-2"></div>
        <div class="skeleton h-4 w-3/4 rounded"></div>
      </div>
      <p data-dict-pending-note class="text-small text-ink/60 dark:text-mist/60 mt-3 text-center"></p>
    </div>

    <div data-dict-result></div>
  </div>

  {/* Loading skeleton */}
  <div data-dict-loading aria-busy="true">
    <div class="skeleton h-14 w-full rounded-full mb-6"></div>
    <div class="skeleton h-48 w-full rounded-2xl"></div>
  </div>
</div>

<Paywall lang={lang} />

<style is:global>
  /* Global on purpose: the entry is built by JavaScript, and Astro's scoped
     styles only reach static markup. Everything is prefixed .dict-. The
     card, badge, ex-chip and skeleton utilities come from global.css. */
  .dict-sec { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--color-card-edge); }
  .dark .dict-sec { border-top-color: var(--color-coal-edge); }
  .dict-sec-h {
    display: flex; align-items: baseline; gap: 0.6rem; margin: 0 0 0.7rem;
    font-family: var(--font-arabic, inherit); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.04em; line-height: 1.5;
    color: color-mix(in srgb, var(--color-ink) 62%, transparent);
  }
  .dark .dict-sec-h { color: color-mix(in srgb, var(--color-mist) 62%, transparent); }
  .dict-sec-h .n { font-weight: 500; opacity: 0.8; }
  /* Answer block — the part that must land on the first screen. */
  .dict-headword { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; margin-bottom: 1.1rem; }
  .dict-lemma { font-family: var(--font-arabic-display); font-size: clamp(2.1rem, 5vw, 2.9rem); line-height: 1.15; color: var(--color-ink); }
  .dark .dict-lemma { color: var(--color-mist); }
  .dict-key { font-size: var(--text-caption); font-weight: 700; color: var(--color-purple); }
  .dict-key.muted { color: var(--color-ink-subtle); }
  .dark .dict-key.muted { color: var(--color-mist-subtle); }
  .dict-senses { display: grid; gap: 1.1rem; margin-bottom: 1.75rem; }
  .dict-sense-n { font-size: var(--text-small); font-weight: 800; color: var(--color-purple); }
  .dict-def { font-size: var(--text-body); line-height: 1.75; color: var(--color-ink); }
  .dark .dict-def { color: var(--color-mist); }
  .dict-wrong { color: #dc2626; text-decoration: line-through; }
  .dark .dict-wrong { color: #f87171; }

  /* Sub-heading INSIDE a tab panel. Distinct from .dict-sec-h on purpose: the
     old markup used .dict-sec-h for both section titles and the groupings
     inside them, so "أضداد" rendered as loud as "مرادفات / أضداد" above it and
     the entry read as 13 flat sections. */
  .dict-sub-h {
    font-family: var(--font-arabic, inherit); font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.03em; margin: 0 0 0.55rem;
    color: color-mix(in srgb, var(--color-ink) 52%, transparent);
  }
  .dark .dict-sub-h { color: color-mix(in srgb, var(--color-mist) 55%, transparent); }
  .dict-tabs { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1rem; }
  /* Section tabs as a real segmented control. They were white pills on a white
     card behind a hairline border: no fill, no hover, and a 10%-tint selected
     state — so they read as plain text and nobody could tell they switched the
     content below. Now the group sits on a tinted track, the selected tab is a
     solid purple chip, and hover/press give physical feedback. */
  .dict-tabs-sections {
    display: flex; flex-wrap: wrap; gap: 0.3rem;
    margin: 1.6rem 0 1.25rem; padding: 0.35rem;
    border-radius: 1rem;
    border: 1px solid var(--color-card-edge);
    background: color-mix(in srgb, var(--color-ink) 4%, transparent);
  }
  .dark .dict-tabs-sections {
    border-color: var(--color-coal-edge);
    background: color-mix(in srgb, var(--color-mist) 6%, transparent);
  }
  .dict-tabs-sections .dict-tab {
    padding: 0.55rem 1.05rem; border-radius: 0.7rem;
    border: 1px solid transparent; background: transparent;
    color: var(--color-ink-muted); font-size: 0.95rem; font-weight: 700; line-height: 1.2;
    transition: background .18s var(--ease-out-quart), color .18s, border-color .18s,
                transform .18s var(--ease-out-quart), box-shadow .18s;
  }
  /* background must be restated: the base .dark .dict-tab rule below has equal
     specificity and comes later, so it would win and fill every idle tab. */
  .dark .dict-tabs-sections .dict-tab { color: var(--color-mist-muted); background: transparent; }
  .dict-tabs-sections .dict-tab:hover {
    background: var(--color-card); color: var(--color-ink);
    border-color: var(--color-card-edge); transform: translateY(-1px);
  }
  .dark .dict-tabs-sections .dict-tab:hover {
    background: var(--color-coal-soft); color: var(--color-mist); border-color: var(--color-coal-edge);
  }
  .dict-tabs-sections .dict-tab:active { transform: translateY(0); }
  .dict-tabs-sections .dict-tab[aria-selected="true"] {
    background: var(--color-purple); color: #fff; border-color: var(--color-purple);
    box-shadow: 0 8px 18px -10px var(--color-purple);
  }
  .dict-tabs-sections .dict-tab[aria-selected="true"]:hover { transform: none; }
  .dict-tab-n { font-weight: 500; opacity: 0.75; margin-inline-start: 0.4rem; }
  .dict-tabs-sections .dict-tab[aria-selected="true"] .dict-tab-n { color: #fff; opacity: 0.85; }

  /* The panel animates in, so switching tabs is visibly a change of content
     rather than a silent swap. */
  .dict-panel { min-height: 4rem; }
  .dict-panel > * { animation: dict-panel-in .22s var(--ease-out-quart) both; }
  @keyframes dict-panel-in { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .dict-panel > * { animation: none; } }
  .dict-tab {
    padding: 0.3rem 0.85rem; border-radius: 999px; font-weight: 700; cursor: pointer;
    border: 1px solid var(--color-card-edge); background: var(--color-card); color: var(--color-ink);
  }
  .dark .dict-tab { border-color: var(--color-coal-edge); background: var(--color-coal-soft); color: var(--color-mist); }
  .dict-tab[aria-selected="true"] { border-color: var(--color-purple); color: var(--color-purple); background: color-mix(in srgb, var(--color-purple) 10%, transparent); }
  .dict-tab:focus-visible { outline: 2px solid var(--color-teal); outline-offset: 2px; }
  .dict-chip {
    display: inline-block; padding: 0.15rem 0.6rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600;
    border: 1px solid color-mix(in srgb, var(--color-teal) 40%, transparent); color: var(--color-teal);
  }
  .dict-chip.purple { border-color: color-mix(in srgb, var(--color-purple) 40%, transparent); color: var(--color-purple); }
  .dict-chip.muted { border-color: var(--color-card-edge); color: color-mix(in srgb, var(--color-ink) 65%, transparent); }
  .dark .dict-chip.muted { border-color: var(--color-coal-edge); color: color-mix(in srgb, var(--color-mist) 65%, transparent); }
  .dict-match {
    display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.2rem 0.7rem; border-radius: 999px;
    font-size: 0.8rem; font-weight: 700; color: var(--color-teal);
    background: color-mix(in srgb, var(--color-teal) 12%, transparent);
  }
  .dict-ex { position: relative; padding-inline-start: 0.85rem; border-inline-start: 2px solid color-mix(in srgb, var(--color-teal) 40%, transparent); }
  .dict-ex-link { display: inline-block; font-size: 0.8rem; font-weight: 700; color: var(--color-purple); text-decoration: none; margin-inline-start: 0.6rem; padding: 0.1rem 0.55rem; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--color-purple) 35%, transparent); white-space: nowrap; }
  .dict-ex-link:hover { background: color-mix(in srgb, var(--color-purple) 10%, transparent); }
  .dict-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .dict-table th { text-align: start; font-weight: 600; padding: 0.35rem 0.6rem 0.35rem 0; color: color-mix(in srgb, var(--color-ink) 62%, transparent); width: 9rem; white-space: nowrap; }
  .dark .dict-table th { color: color-mix(in srgb, var(--color-mist) 62%, transparent); }
  .dict-table td { padding: 0.35rem 0; color: var(--color-ink); }
  .dark .dict-table td { color: var(--color-mist); }
  .dict-table tr + tr th, .dict-table tr + tr td { border-top: 1px solid color-mix(in srgb, var(--color-card-edge) 70%, transparent); }
  .dict-ayah { display: block; padding: 0.6rem 0.75rem; border-radius: 10px; text-decoration: none; border: 1px solid var(--color-card-edge); background: var(--color-card); }
  .dark .dict-ayah { border-color: var(--color-coal-edge); background: var(--color-coal-soft); }
  .dict-ayah:hover { border-color: var(--color-purple); }
  .dict-ayah .ref { font-size: 0.8rem; font-weight: 700; color: var(--color-purple); }
  .dict-ayah .an { font-size: 0.9rem; color: color-mix(in srgb, var(--color-ink) 75%, transparent); }
  .dark .dict-ayah .an { color: color-mix(in srgb, var(--color-mist) 75%, transparent); }
  .dict-classical { font-size: 0.95rem; line-height: 1.9; padding: 0.7rem 0.9rem; border-radius: 10px; background: color-mix(in srgb, var(--color-teal) 6%, transparent); }
  .dict-classical .src { display: block; font-size: 0.8rem; font-weight: 700; color: var(--color-teal); margin-bottom: 0.2rem; }
  .dict-meta { margin-top: 1.5rem; font-size: 0.8rem; color: color-mix(in srgb, var(--color-ink) 55%, transparent); display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; }
  .dark .dict-meta { color: color-mix(in srgb, var(--color-mist) 55%, transparent); }
  .dict-meta a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
</style>

<script>
  import { maybeSignedIn } from '../lib/session';

  const root = document.querySelector<HTMLElement>('[data-dict-root]');
  if (root) {
    const lang = root.dataset.lang === 'en' ? 'en' : 'ar';
    const login = root.dataset.login || '/login';
    const WORKER = 'https://irab-api-v2.mansourhassan783.workers.dev';
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const gate = q<HTMLElement>('[data-dict-gate]');
    const tool = q<HTMLElement>('[data-dict-tool]');
    const loadingEl = q<HTMLElement>('[data-dict-loading]');
    const form = q<HTMLFormElement>('[data-dict-form]');
    const input = q<HTMLInputElement>('[data-dict-input]');
    const submit = q<HTMLButtonElement>('[data-dict-submit]');
    const submitLabel = q<HTMLElement>('[data-dict-submit-label]');
    const msg = q<HTMLElement>('[data-dict-msg]');
    const result = q<HTMLElement>('[data-dict-result]');
    const quota = q<HTMLElement>('[data-dict-quota]');
    const pending = q<HTMLElement>('[data-dict-pending]');
    const pendingNote = q<HTMLElement>('[data-dict-pending-note]');

    const T = lang === 'ar'
      ? {
          searching: 'جارٍ البحث…', search: 'بحث', root: 'الجذر', pattern: 'الوزن',
          sessionEnded: 'انتهت جلستك. سجّل الدخول من جديد للبحث.',
          meanings: 'المعاني', analyze: 'أعرب هذه الجملة', irab: 'الإعراب', morphology: 'الصرف',
          usage: 'الاستعمال', relations: 'العلاقات', evidence: 'الشواهد',
          collocations: 'تعابير شائعة', mistakes: 'أخطاء شائعة', nuance: 'الفرق عن مرادفاتها',
          synonyms: 'مرادفات', antonyms: 'أضداد', derivations: 'مشتقات', family: 'من الجذر نفسه',
          quran: 'في القرآن الكريم', quranN: (n: string) => `${n} موضعًا`, quranOne: 'موضع واحد', quranForms: 'الصيغ الواردة',
          classical: 'في المعاجم الكلاسيكية', match: 'مطابق للمعاجم', translations: 'الترجمة', etymology: 'أصل الكلمة',
          gender: 'الجنس', declension: 'الصرف', transitivity: 'التعدّي', preps: 'يتعدّى بـ',
          m: { plural: 'الجمع', plural_type: 'نوع الجمع', dual: 'المثنى', feminine: 'المؤنث', verbal_noun: 'المصدر', active_participle: 'اسم الفاعل', passive_participle: 'اسم المفعول', past: 'الماضي', present: 'المضارع', imperative: 'الأمر' },
          wrong: 'خطأ', right: 'صواب', readings: 'القراءات',
          noResult: 'لم نجد نتيجة لهذه الكلمة. تأكّد من الإملاء.',
          limit: 'بلغت حدّك اليومي المجاني. اشترك من التطبيق لبحثٍ غير محدود.',
          error: 'حدث خطأ. حاول مرة أخرى.', unlimited: 'بحث غير محدود ⚡',
          generating: 'كلمة جديدة على المعجم، يُؤلَّف مدخلها الآن، ثوانٍ قليلة…',
          aiNote: 'المدخل مولَّد بالذكاء الاصطناعي وقد يخطئ.', report: 'أبلغ عن خطأ', fromCache: 'من المعجم', fresh: 'أُضيف الآن',
        }
      : {
          searching: 'Searching…', search: 'Search', root: 'Root', pattern: 'Pattern',
          sessionEnded: 'Your session has ended. Sign in again to search.',
          meanings: 'Meanings', analyze: 'Parse this sentence', irab: "I'rab", morphology: 'Morphology',
          usage: 'Usage', relations: 'Relations', evidence: 'Citations',
          collocations: 'Collocations', mistakes: 'Common mistakes', nuance: 'Compared with its synonyms',
          synonyms: 'Synonyms', antonyms: 'Antonyms', derivations: 'Derivations', family: 'Same root',
          quran: 'In the Quran', quranN: (n: string) => `${n} occurrences`, quranOne: '1 occurrence', quranForms: 'Forms found',
          classical: 'In the classical dictionaries', match: 'Matches the dictionaries', translations: 'Translation', etymology: 'Etymology',
          gender: 'Gender', declension: 'Declension', transitivity: 'Transitivity', preps: 'Takes',
          m: { plural: 'Plural', plural_type: 'Plural type', dual: 'Dual', feminine: 'Feminine', verbal_noun: 'Verbal noun', active_participle: 'Active participle', passive_participle: 'Passive participle', past: 'Past', present: 'Present', imperative: 'Imperative' },
          wrong: 'Wrong', right: 'Right', readings: 'Readings',
          noResult: 'No result for that word: check the spelling.',
          limit: "You've reached your free daily limit. Subscribe in the app for unlimited search.",
          error: 'Something went wrong. Please try again.', unlimited: 'Unlimited search ⚡',
          generating: 'New word for the dictionary: writing its entry now, a few seconds…',
          aiNote: 'AI-generated entry; it can be wrong.', report: 'Report an error', fromCache: 'From the dictionary', fresh: 'Just added',
        };

    const toolPath = lang === 'ar' ? '/tool' : '/en/tool';
    const AR_DIGITS = '٠١٢٣٤٥٦٧٨٩';
    const num = (n: number) => lang === 'ar' ? String(n).replace(/[0-9]/g, (d) => AR_DIGITS[+d]) : String(n);

    let idToken: string | null = null;
    // Auth resolves in the BACKGROUND (see the boot block): the search box
    // paints first, and the lookup awaits this before calling the worker.
    let signedOut = false;
    let deepLinkRan = false;
    let resolveAuth: () => void = () => {};
    const authReady = new Promise<void>((r) => { resolveAuth = r; });

    function showMsg(text: string, kind: 'err' | 'info') {
      msg.textContent = text;
      msg.className = 'text-small rounded-lg px-4 py-3 mb-4 ' +
        (kind === 'info' ? 'bg-purple/10 text-purple' : 'bg-red-500/10 text-red-600 dark:text-red-400');
    }
    const clearMsg = () => { msg.className = 'hidden'; };

    const el = (tag: string, cls?: string, text?: string) => {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text != null) n.textContent = text;
      return n;
    };
    const ar = (n: HTMLElement) => { n.setAttribute('dir', 'rtl'); n.setAttribute('lang', 'ar'); return n; };
    const list = (v: unknown): string[] => Array.isArray(v) ? v.filter((x): x is string => typeof x === 'string' && x.trim().length > 0) : [];
    const objs = (v: unknown): any[] => Array.isArray(v) ? v.filter((x) => x && typeof x === 'object') : [];

    function chips(items: string[], cls = 'dict-chip') {
      const w = el('div', 'flex flex-wrap gap-2');
      items.forEach((x) => w.appendChild(ar(el('span', cls, x))));
      return w;
    }

    // ── One vocalised reading ────────────────────────────────────────────────
    // Answer first, depth behind tabs. Everything used to stack as 13
    // equal-weight sections — 2.1 screens of scrolling for one word, with no
    // signal about what mattered. The headword and its meanings now always sit
    // on the first screen; reference material moves into tab panels, and only
    // panels that actually have content get a tab.
    function renderVariant(v: any, entry: any, container: HTMLElement) {
      container.replaceChildren();

      // ── Answer block: headword + meanings, never behind a tab ────────────
      const head = el('div', 'dict-headword');
      const word = ar(el('span', 'dict-lemma', v.lemma || input.value.trim()));
      head.appendChild(word);
      if (v.pos) head.appendChild(el('span', 'badge badge-good', v.pos));
      if (v.root) head.appendChild(ar(el('span', 'dict-key', `${T.root}: ${v.root}`)));
      if (v.pattern) head.appendChild(ar(el('span', 'dict-key muted', `${T.pattern}: ${v.pattern}`)));
      const classical = entry?.classical;
      if (classical && (classical.count > 0 || objs(classical.entries).length > 0)) {
        const b = el('span', 'dict-match'); b.textContent = '✓ ' + T.match; b.title = T.classical; head.appendChild(b);
      }
      container.appendChild(head);

      const senses = objs(v.senses).filter((s: any) => typeof s.definition === 'string' && s.definition.trim());
      if (senses.length) {
        const ol = el('ol', 'dict-senses');
        senses.forEach((sn: any, i: number) => {
          const li = el('li');
          const row = el('div', 'flex flex-wrap items-baseline gap-2');
          if (senses.length > 1) row.appendChild(el('span', 'dict-sense-n', num(i + 1) + '.'));
          row.appendChild(ar(el('p', 'dict-def', sn.definition)));
          li.appendChild(row);
          const tags = [sn.register, sn.domain].filter((x: any) => typeof x === 'string' && x && x !== 'عام' && x !== 'فصحى');
          if (tags.length) li.appendChild(chips(tags, 'dict-chip muted'));
          const exs = objs(sn.examples).map((e: any) => e.text || e.ar || e.example).filter((x: any) => typeof x === 'string' && x.trim());
          if (exs.length) {
            const ul = el('ul', 'mt-2 space-y-1.5');
            exs.slice(0, 3).forEach((text: string) => {
              const line = ar(el('li', 'dict-ex text-small text-ink-muted dark:text-mist-muted'));
              line.appendChild(document.createTextNode(text + ' '));
              const a = el('a', 'dict-ex-link', T.analyze) as HTMLAnchorElement;
              a.href = `${toolPath}?s=${encodeURIComponent(text)}`;
              line.appendChild(a);
              ul.appendChild(line);
            });
            li.appendChild(ul);
          }
          ol.appendChild(li);
        });
        container.appendChild(ol);
      }

      // ── Depth: one builder per tab, each returns null when it has nothing ──
      const sub = (title: string) => el('p', 'dict-sub-h', title);

      function panelSarf(): HTMLElement | null {
        const m = v.morphology && typeof v.morphology === 'object' ? v.morphology : {};
        const rows = Object.entries(T.m).filter(([k]) => typeof m[k] === 'string' && m[k].trim());
        if (!rows.length) return null;
        const wrap = el('div');
        const table = el('table', 'dict-table');
        rows.forEach(([k, label]) => {
          const tr = el('tr'); tr.appendChild(el('th', '', label as string)); tr.appendChild(ar(el('td', '', m[k])));
          table.appendChild(tr);
        });
        wrap.appendChild(table);
        return wrap;
      }

      function panelIrab(): HTMLElement | null {
        const ir = v.irab && typeof v.irab === 'object' ? v.irab : null;
        const preps = ir ? list(ir.prepositions) : [];
        if (!ir || !(ir.gender || ir.declension || ir.transitivity || preps.length || ir.note)) return null;
        const wrap = el('div');
        const facts: string[] = [];
        if (ir.gender) facts.push(ir.gender);
        if (ir.declension) facts.push(ir.declension);
        if (ir.transitivity) facts.push(ir.transitivity);
        if (facts.length) wrap.appendChild(chips(facts, 'dict-chip purple'));
        if (preps.length) wrap.appendChild(ar(el('p', 'text-small text-ink-muted dark:text-mist-muted mt-2', `${T.preps} ${preps.join('، ')}`)));
        if (ir.note) wrap.appendChild(ar(el('p', 'text-body text-ink dark:text-mist leading-relaxed mt-2', ir.note)));
        return wrap;
      }

      function panelUsage(): HTMLElement | null {
        const coll = objs(v.collocations).filter((c: any) => typeof c.text === 'string' && c.text.trim());
        const mist = objs(v.common_mistakes).filter((c: any) => typeof c.right === 'string' && c.right.trim());
        const nuance = typeof v.nuance === 'string' && v.nuance.trim() ? v.nuance : null;
        if (!coll.length && !mist.length && !nuance) return null;
        const wrap = el('div', 'space-y-5');
        if (coll.length) {
          const g = el('div'); g.appendChild(sub(T.collocations));
          const ul = el('ul', 'space-y-1.5');
          coll.forEach((c: any) => {
            const li = ar(el('li', 'text-body text-ink dark:text-mist'));
            li.appendChild(el('span', 'font-semibold', c.text));
            if (c.meaning) li.appendChild(el('span', 'text-ink-muted dark:text-mist-muted', `: ${c.meaning}`));
            ul.appendChild(li);
          });
          g.appendChild(ul); wrap.appendChild(g);
        }
        if (mist.length) {
          const g = el('div'); g.appendChild(sub(T.mistakes));
          const ul = el('ul', 'space-y-2');
          mist.forEach((c: any) => {
            const li = ar(el('li', 'text-body'));
            if (c.wrong) { li.appendChild(el('span', 'dict-wrong', c.wrong)); li.appendChild(document.createTextNode(' ')); }
            li.appendChild(el('span', 'font-semibold text-teal', c.right));
            if (c.why) li.appendChild(el('span', 'block text-small text-ink-muted dark:text-mist-muted', c.why));
            ul.appendChild(li);
          });
          g.appendChild(ul); wrap.appendChild(g);
        }
        if (nuance) {
          const g = el('div'); g.appendChild(sub(T.nuance));
          g.appendChild(ar(el('p', 'text-body text-ink dark:text-mist leading-relaxed', nuance)));
          wrap.appendChild(g);
        }
        return wrap;
      }

      function panelRelations(): HTMLElement | null {
        const syn = list(v.synonyms), ant = list(v.antonyms), der = list(v.derivations);
        const fam = objs(entry?.root_family).filter((r: any) => typeof r.word === 'string' && r.word.trim());
        if (!syn.length && !ant.length && !der.length && !fam.length) return null;
        const wrap = el('div', 'space-y-5');
        if (syn.length) { const g = el('div'); g.appendChild(sub(T.synonyms)); g.appendChild(chips(syn)); wrap.appendChild(g); }
        if (ant.length) { const g = el('div'); g.appendChild(sub(T.antonyms)); g.appendChild(chips(ant, 'dict-chip muted')); wrap.appendChild(g); }
        if (der.length) { const g = el('div'); g.appendChild(sub(T.derivations)); g.appendChild(chips(der, 'dict-chip purple')); wrap.appendChild(g); }
        if (fam.length) {
          const g = el('div'); g.appendChild(sub(T.family));
          const ul = el('ul', 'flex flex-wrap gap-x-4 gap-y-1');
          fam.slice(0, 8).forEach((r: any) => {
            const li = ar(el('li', 'text-small text-ink-muted dark:text-mist-muted'));
            li.appendChild(el('span', 'font-semibold text-ink dark:text-mist', r.word));
            if (r.gloss) li.appendChild(el('span', '', `: ${r.gloss}`));
            ul.appendChild(li);
          });
          g.appendChild(ul); wrap.appendChild(g);
        }
        return wrap;
      }

      function panelEvidence(): { node: HTMLElement; note: string } | null {
        const qn = entry?.quran && typeof entry.quran === 'object' ? entry.quran : null;
        const hasQuran = qn && typeof qn.n === 'number' && qn.n > 0;
        const cl = objs(entry?.classical?.entries).filter((c: any) => {
          const text = typeof c.text === 'string' ? c.text.trim() : '';
          return text.length >= 12 && text !== (c.headword || '').trim();
        });
        if (!hasQuran && !cl.length) return null;
        const wrap = el('div', 'space-y-5');
        if (hasQuran) {
          const g = el('div');
          g.appendChild(sub(T.quran));
          const forms = qn.forms && typeof qn.forms === 'object' ? Object.entries(qn.forms) as Array<[string, number]> : [];
          if (forms.length > 1) g.appendChild(chips(forms.map(([f, c]) => `${f} (${num(c)})`), 'dict-chip muted'));
          const refs = objs(qn.refs).filter((r: any) => r.slug && r.a);
          if (refs.length) {
            const ul = el('ul', 'grid gap-2 mt-3');
            refs.slice(0, 3).forEach((r: any) => {
              const a = ar(el('a', 'dict-ayah')) as HTMLAnchorElement;
              a.href = `/quran/${r.slug}/${r.a}`;
              a.appendChild(el('span', 'ref', `${lang === 'ar' ? 'سورة' : 'Surah'} ${r.name || r.slug} · ${lang === 'ar' ? 'الآية' : 'ayah'} ${num(r.a)}${r.token ? ` · ${r.token}` : ''}`));
              if (r.analysis) a.appendChild(el('span', 'an block mt-0.5', r.analysis));
              ul.appendChild(a);
            });
            g.appendChild(ul);
          }
          wrap.appendChild(g);
        }
        if (cl.length) {
          const g = el('div'); g.appendChild(sub(T.classical));
          cl.slice(0, 3).forEach((c: any) => {
            const bq = ar(el('blockquote', 'dict-classical mb-2'));
            if (c.dictionary) bq.appendChild(el('span', 'src', c.dictionary));
            bq.appendChild(document.createTextNode(c.text));
            g.appendChild(bq);
          });
          wrap.appendChild(g);
        }
        const note = hasQuran ? (qn.n === 1 ? T.quranOne : T.quranN(num(qn.n))) : '';
        return { node: wrap, note };
      }

      function panelTranslation(): HTMLElement | null {
        const tr = v.translations || {};
        const en = list(tr.en), fr = list(tr.fr);
        const ety = typeof entry?.etymology === 'string' && entry.etymology.trim() ? entry.etymology : null;
        if (!en.length && !fr.length && !ety) return null;
        const wrap = el('div', 'space-y-3');
        if (en.length) wrap.appendChild(el('p', 'text-body text-ink-muted dark:text-mist-muted', 'EN: ' + en.join(', ')));
        if (fr.length) wrap.appendChild(el('p', 'text-body text-ink-muted dark:text-mist-muted', 'FR: ' + fr.join(', ')));
        if (ety) { const g = el('div'); g.appendChild(sub(T.etymology)); g.appendChild(ar(el('p', 'text-small text-ink-muted dark:text-mist-muted', ety))); wrap.appendChild(g); }
        return wrap;
      }

      const ev = panelEvidence();
      const groups: Array<{ label: string; note?: string; node: HTMLElement | null }> = [
        { label: T.morphology,   node: panelSarf() },
        { label: T.irab,         node: panelIrab() },
        { label: T.usage,        node: panelUsage() },
        { label: T.relations,    node: panelRelations() },
        { label: T.evidence,     node: ev ? ev.node : null, note: ev ? ev.note : '' },
        { label: T.translations, node: panelTranslation() },
      ].filter((g) => g.node !== null);

      if (!groups.length) return;

      const nav = el('div', 'dict-tabs dict-tabs-sections'); nav.setAttribute('role', 'tablist');
      const panelHost = el('div', 'dict-panel');
      panelHost.setAttribute('role', 'tabpanel');
      const buttons: HTMLButtonElement[] = [];
      const selectTab = (i: number, focus = false) => {
        buttons.forEach((x, j) => {
          const on = i === j;
          x.setAttribute('aria-selected', on ? 'true' : 'false');
          // Roving tabindex: one stop for the whole group, arrows move within.
          x.tabIndex = on ? 0 : -1;
        });
        panelHost.replaceChildren(groups[i].node!);
        if (focus) buttons[i].focus();
      };
      groups.forEach((g, i) => {
        const b = el('button', 'dict-tab', g.label) as HTMLButtonElement;
        b.type = 'button'; b.setAttribute('role', 'tab');
        b.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
        b.tabIndex = i === 0 ? 0 : -1;
        if (g.note) b.appendChild(el('span', 'dict-tab-n', g.note));
        b.addEventListener('click', () => selectTab(i));
        b.addEventListener('keydown', (e: KeyboardEvent) => {
          // RTL: ArrowLeft advances, ArrowRight goes back (mirrored for en).
          const fwd = lang === 'ar' ? 'ArrowLeft' : 'ArrowRight';
          const back = lang === 'ar' ? 'ArrowRight' : 'ArrowLeft';
          let next = -1;
          if (e.key === fwd) next = (i + 1) % groups.length;
          else if (e.key === back) next = (i - 1 + groups.length) % groups.length;
          else if (e.key === 'Home') next = 0;
          else if (e.key === 'End') next = groups.length - 1;
          if (next >= 0) { e.preventDefault(); selectTab(next, true); }
        });
        buttons.push(b);
        nav.appendChild(b);
      });
      container.appendChild(nav);
      panelHost.appendChild(groups[0].node!);
      container.appendChild(panelHost);
    }

    // ── Whole entry: readings as tabs + footer ───────────────────────────────
    function render(data: any, source?: string) {
      result.replaceChildren();
      const variants: any[] = objs(data?.variants).filter((v) => objs(v.senses).length > 0);
      const legacy = data && objs(data.senses).length > 0 ? [data] : [];
      const readings = variants.length ? variants : legacy;
      if (readings.length === 0) { showMsg(T.noResult, 'info'); return; }
      clearMsg();

      const card = el('div', 'card panel-in p-6 md:p-8');
      let body = el('div');
      if (readings.length > 1) {
        const tabs = el('div', 'dict-tabs'); tabs.setAttribute('role', 'tablist');
        tabs.appendChild(el('span', 'dict-sec-h self-center', T.readings));
        readings.forEach((v, i) => {
          const b = ar(el('button', 'dict-tab', v.lemma || `${i + 1}`)) as HTMLButtonElement;
          b.type = 'button'; b.setAttribute('role', 'tab'); b.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
          b.addEventListener('click', () => {
            tabs.querySelectorAll('.dict-tab').forEach((x) => x.setAttribute('aria-selected', 'false'));
            b.setAttribute('aria-selected', 'true');
            renderVariant(v, data, body);
          });
          tabs.appendChild(b);
        });
        card.appendChild(tabs);
      }
      card.appendChild(body);
      renderVariant(readings[0], data, body);

      // Footer: provenance + report link
      const meta = el('p', 'dict-meta');
      meta.appendChild(el('span', '', T.aiNote));
      if (source === 'cache') meta.appendChild(el('span', '', T.fromCache));
      else if (source === 'generated') meta.appendChild(el('span', '', T.fresh));
      const rep = el('a', '', T.report) as HTMLAnchorElement;
      const w = readings[0].lemma || input.value.trim();
      rep.href = `mailto:support@irab.app?subject=${encodeURIComponent((lang === 'ar' ? 'خطأ في المعجم: ' : 'Dictionary error: ') + w)}`;
      meta.appendChild(rep);
      card.appendChild(meta);

      result.appendChild(card);
    }

    async function search(word: string) {
      if (!word) return;
      clearMsg(); result.replaceChildren();
      submit.disabled = true; submitLabel.textContent = T.searching;
      // A cached word answers in well under a second; a fresh one takes a few
      // seconds to write. Show the skeleton, and explain after 1.5 s.
      pending.classList.remove('hidden'); pendingNote.textContent = '';
      const noteTimer = window.setTimeout(() => { pendingNote.textContent = T.generating; }, 1500);
      try {
        // Almost always already settled — this only waits when the user types
        // faster than Firebase loads.
        await authReady;
        if (!idToken || signedOut) {
          window.clearTimeout(noteTimer);
          pending.classList.add('hidden');
          showMsg(T.sessionEnded, 'err');
          return;
        }
        const res = await fetch(`${WORKER}/api/dictionary`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', ...(idToken ? { Authorization: `Bearer ${idToken}` } : {}) },
          body: JSON.stringify({ word }),
        });
        if (res.status === 429) {
          if ((window as any).IrabPaywall) (window as any).IrabPaywall.show();
          else showMsg(T.limit, 'info');
          return;
        }
        if (!res.ok) { showMsg(T.error, 'err'); return; }
        const json = await res.json();
        if (json && json.data === null) { showMsg(T.noResult, 'info'); return; }
        render(json?.data ?? json, json?.source);
      } catch {
        showMsg(T.error, 'err');
      } finally {
        window.clearTimeout(noteTimer);
        pending.classList.add('hidden');
        submit.disabled = false; submitLabel.textContent = T.search;
      }
    }

    form.addEventListener('submit', (e) => { e.preventDefault(); search(input.value.trim()); });

    // Empty-state chips: fill the input with a curated root and run the same lookup.
    const examplesWrap = root.querySelector<HTMLElement>('[data-dict-examples]');
    examplesWrap?.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLElement>('[data-dict-example]');
      if (!chip) return;
      const word = chip.dataset.dictExample || '';
      if (!word) return;
      input.value = word;
      search(word);
    });

    // Auth gate: Firebase only loads here (a tool page), never on content pages.
    //
    // The search box paints IMMEDIATELY for a returning user and Firebase
    // resolves behind it — maybeSignedIn() is a synchronous localStorage read,
    // and nothing about typing a word needs a token. Only the lookup does, and
    // it awaits authReady behind the button's existing busy state. (The second
    // skeleton, data-dict-pending, is honest: it covers real AI generation.)
    (async () => {
      if (!maybeSignedIn()) { loadingEl.classList.add('hidden'); gate.classList.remove('hidden'); resolveAuth(); return; }

      loadingEl.classList.add('hidden');
      tool.classList.remove('hidden');
      const deepLink = new URLSearchParams(location.search).get('w');
      if (!deepLink) input.focus();

      try {
        const [{ onAuth }, { fetchMe }] = await Promise.all([import('../lib/auth'), import('../lib/entitlement')]);
        onAuth(async (u) => {
          if (!u) {
            // Session really gone. Don't yank a typed word: swap to the gate
            // only when the box is empty; otherwise the lookup path reports it.
            signedOut = true; resolveAuth();
            if (!input.value.trim()) { tool.classList.add('hidden'); gate.classList.remove('hidden'); }
            return;
          }
          signedOut = false;
          try { idToken = await u.getIdToken(); } catch {}
          resolveAuth();
          if (deepLink && !deepLinkRan) { deepLinkRan = true; input.value = deepLink; search(deepLink); }
          try { const me = await fetchMe(u); if (me?.premium) quota.textContent = T.unlimited; } catch {}
        });
      } catch {
        resolveAuth();
        if (!input.value.trim()) { tool.classList.add('hidden'); gate.classList.remove('hidden'); }
      }
    })();
  }
</script>
