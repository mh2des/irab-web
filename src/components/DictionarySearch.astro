---
/**
 * DictionarySearch: the smart (AI) Arabic dictionary as a web tool.
 * Login-gated (the worker /api/dictionary needs a Firebase token); free users
 * get their daily quota, premium unlimited: enforced server side, same engine
 * as the app. Firebase loads only on this tool page, never on content pages.
 *
 * Renders the full v3 entry (2026-08): every vocalised reading as a tab,
 * meaning first, how the word behaves in i'rab, morphology, collocations and
 * common mistakes, the root family, Quran occurrences linking to the ayah
 * i'rab pages, the classical-dictionary excerpt (qamoos.org) with a
 * "matches the dictionaries" badge, and translations. Old (v2) responses
 * still render: every section is optional.
 */
import Paywall from './Paywall.astro';
interface Props { lang?: 'ar' | 'en'; }
const { lang = 'ar' } = Astro.props;
const login = lang === 'ar' ? '/login' : '/en/login';
const dir = lang === 'ar' ? 'rtl' : 'ltr';

const t = lang === 'ar'
  ? {
      placeholder: 'اكتب كلمة عربية…', search: 'بحث',
      signedOutTitle: 'سجّل الدخول لاستعمال المعجم',
      signedOutBody: 'المعجم الذكي متاح لأصحاب الحساب. سجّل الدخول مجاناً للبدء.',
      signIn: 'تسجيل الدخول',
      tryRoots: 'جرّب هذه الجذور:',
    }
  : {
      placeholder: 'Type an Arabic word…', search: 'Search',
      signedOutTitle: 'Sign in to use the dictionary',
      signedOutBody: 'The smart dictionary is for account holders. Sign in free to start.',
      signIn: 'Sign in',
      tryRoots: 'Try these roots:',
    };
---
<div data-dict-root data-lang={lang} data-login={login} dir={dir} class="w-full max-w-2xl mx-auto">
  {/* Signed-out gate */}
  <div data-dict-gate class="hidden card panel-in p-8 md:p-10 text-center">
    <h2 class="font-arabic-display text-h2 mb-3">{t.signedOutTitle}</h2>
    <p class="text-body text-ink/75 dark:text-mist/75 mb-7 max-w-md mx-auto">{t.signedOutBody}</p>
    <a href={login} class="btn-primary btn-lg">{t.signIn}</a>
  </div>

  {/* Tool (shown when signed in) */}
  <div data-dict-tool class="hidden">
    <form data-dict-form class="flex gap-2 mb-3">
      <input data-dict-input type="text" dir="rtl" autocomplete="off" placeholder={t.placeholder}
        class="input flex-1 text-lg" />
      <button type="submit" data-dict-submit class="btn-primary">
        <span data-dict-submit-label>{t.search}</span>
      </button>
    </form>
    <p data-dict-quota class="text-small font-semibold text-ink/65 dark:text-mist/65 mb-6 h-5"></p>

    {/* Empty-state suggestions: tap a curated root to run a real lookup. */}
    <div data-dict-examples class="mb-6">
      <p class="text-small font-semibold text-ink-subtle dark:text-mist-subtle mb-2">{t.tryRoots}</p>
      <div class="flex flex-wrap gap-2">
        {['كتب', 'علم', 'نور', 'صبر', 'رحمة', 'فهم'].map((w) => (
          <button type="button" class="ex-chip" data-dict-example={w} lang="ar" dir="rtl">{w}</button>
        ))}
      </div>
    </div>

    <p data-dict-msg class="hidden text-small rounded-lg px-4 py-3 mb-4"></p>

    {/* Skeleton shown while a fresh word is being generated (5 to 10 s). */}
    <div data-dict-pending class="hidden" aria-busy="true">
      <div class="card p-6 md:p-8">
        <div class="skeleton h-9 w-40 rounded-lg mb-5"></div>
        <div class="skeleton h-4 w-full rounded mb-2"></div>
        <div class="skeleton h-4 w-5/6 rounded mb-2"></div>
        <div class="skeleton h-4 w-2/3 rounded mb-6"></div>
        <div class="skeleton h-4 w-1/2 rounded mb-2"></div>
        <div class="skeleton h-4 w-3/4 rounded"></div>
      </div>
      <p data-dict-pending-note class="text-small text-ink/60 dark:text-mist/60 mt-3 text-center"></p>
    </div>

    <div data-dict-result></div>
  </div>

  {/* Loading skeleton */}
  <div data-dict-loading aria-busy="true">
    <div class="skeleton h-14 w-full rounded-full mb-6"></div>
    <div class="skeleton h-48 w-full rounded-2xl"></div>
  </div>
</div>

<Paywall lang={lang} />

<style>
  /* Section rhythm inside the entry card. Everything else reuses the site's
     utilities (card, badge, ex-chip, skeleton). */
  .dict-sec { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--color-card-edge); }
  :global(.dark) .dict-sec { border-top-color: var(--color-coal-edge); }
  .dict-sec-h {
    display: flex; align-items: baseline; gap: 0.6rem; margin-bottom: 0.7rem;
    font-size: 0.8rem; font-weight: 700; letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--color-ink) 62%, transparent);
  }
  :global(.dark) .dict-sec-h { color: color-mix(in srgb, var(--color-mist) 62%, transparent); }
  .dict-sec-h .n { font-weight: 500; opacity: 0.8; }
  .dict-tabs { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1rem; }
  .dict-tab {
    padding: 0.3rem 0.85rem; border-radius: 999px; font-weight: 700; cursor: pointer;
    border: 1px solid var(--color-card-edge); background: var(--color-card); color: var(--color-ink);
  }
  :global(.dark) .dict-tab { border-color: var(--color-coal-edge); background: var(--color-coal-soft); color: var(--color-mist); }
  .dict-tab[aria-selected="true"] { border-color: var(--color-purple); color: var(--color-purple); background: color-mix(in srgb, var(--color-purple) 10%, transparent); }
  .dict-tab:focus-visible { outline: 2px solid var(--color-teal); outline-offset: 2px; }
  .dict-chip {
    display: inline-block; padding: 0.15rem 0.6rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600;
    border: 1px solid color-mix(in srgb, var(--color-teal) 40%, transparent); color: var(--color-teal);
  }
  .dict-chip.purple { border-color: color-mix(in srgb, var(--color-purple) 40%, transparent); color: var(--color-purple); }
  .dict-chip.muted { border-color: var(--color-card-edge); color: color-mix(in srgb, var(--color-ink) 65%, transparent); }
  :global(.dark) .dict-chip.muted { border-color: var(--color-coal-edge); color: color-mix(in srgb, var(--color-mist) 65%, transparent); }
  .dict-match {
    display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.2rem 0.7rem; border-radius: 999px;
    font-size: 0.8rem; font-weight: 700; color: var(--color-teal);
    background: color-mix(in srgb, var(--color-teal) 12%, transparent);
  }
  .dict-ex { position: relative; padding-inline-start: 0.85rem; border-inline-start: 2px solid color-mix(in srgb, var(--color-teal) 40%, transparent); }
  .dict-ex a { font-size: 0.8rem; font-weight: 700; color: var(--color-purple); text-decoration: none; margin-inline-start: 0.5rem; white-space: nowrap; }
  .dict-ex a:hover { text-decoration: underline; }
  .dict-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .dict-table th { text-align: start; font-weight: 600; padding: 0.35rem 0.6rem 0.35rem 0; color: color-mix(in srgb, var(--color-ink) 62%, transparent); width: 9rem; white-space: nowrap; }
  :global(.dark) .dict-table th { color: color-mix(in srgb, var(--color-mist) 62%, transparent); }
  .dict-table td { padding: 0.35rem 0; color: var(--color-ink); }
  :global(.dark) .dict-table td { color: var(--color-mist); }
  .dict-table tr + tr th, .dict-table tr + tr td { border-top: 1px solid color-mix(in srgb, var(--color-card-edge) 70%, transparent); }
  .dict-ayah { display: block; padding: 0.6rem 0.75rem; border-radius: 10px; text-decoration: none; border: 1px solid var(--color-card-edge); background: var(--color-card); }
  :global(.dark) .dict-ayah { border-color: var(--color-coal-edge); background: var(--color-coal-soft); }
  .dict-ayah:hover { border-color: var(--color-purple); }
  .dict-ayah .ref { font-size: 0.8rem; font-weight: 700; color: var(--color-purple); }
  .dict-ayah .an { font-size: 0.9rem; color: color-mix(in srgb, var(--color-ink) 75%, transparent); }
  :global(.dark) .dict-ayah .an { color: color-mix(in srgb, var(--color-mist) 75%, transparent); }
  .dict-classical { font-size: 0.95rem; line-height: 1.9; padding: 0.7rem 0.9rem; border-radius: 10px; background: color-mix(in srgb, var(--color-teal) 6%, transparent); }
  .dict-classical .src { display: block; font-size: 0.8rem; font-weight: 700; color: var(--color-teal); margin-bottom: 0.2rem; }
  .dict-meta { margin-top: 1.5rem; font-size: 0.8rem; color: color-mix(in srgb, var(--color-ink) 55%, transparent); display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; }
  :global(.dark) .dict-meta { color: color-mix(in srgb, var(--color-mist) 55%, transparent); }
  .dict-meta a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
</style>

<script>
  import { maybeSignedIn } from '../lib/session';

  const root = document.querySelector<HTMLElement>('[data-dict-root]');
  if (root) {
    const lang = root.dataset.lang === 'en' ? 'en' : 'ar';
    const login = root.dataset.login || '/login';
    const WORKER = 'https://irab-api-v2.mansourhassan783.workers.dev';
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const gate = q<HTMLElement>('[data-dict-gate]');
    const tool = q<HTMLElement>('[data-dict-tool]');
    const loadingEl = q<HTMLElement>('[data-dict-loading]');
    const form = q<HTMLFormElement>('[data-dict-form]');
    const input = q<HTMLInputElement>('[data-dict-input]');
    const submit = q<HTMLButtonElement>('[data-dict-submit]');
    const submitLabel = q<HTMLElement>('[data-dict-submit-label]');
    const msg = q<HTMLElement>('[data-dict-msg]');
    const result = q<HTMLElement>('[data-dict-result]');
    const quota = q<HTMLElement>('[data-dict-quota]');
    const pending = q<HTMLElement>('[data-dict-pending]');
    const pendingNote = q<HTMLElement>('[data-dict-pending-note]');

    const T = lang === 'ar'
      ? {
          searching: 'جارٍ البحث…', search: 'بحث', root: 'الجذر', pattern: 'الوزن',
          meanings: 'المعاني', analyze: 'أعرب هذه الجملة', irab: 'كيف تُعرب هذه الكلمة', morphology: 'الصرف',
          collocations: 'تعابير شائعة', mistakes: 'أخطاء شائعة', nuance: 'الفرق عن مرادفاتها',
          synonyms: 'مرادفات', antonyms: 'أضداد', derivations: 'مشتقات', family: 'من الجذر نفسه',
          quran: 'في القرآن الكريم', quranN: (n: string) => `${n} موضعًا`, quranOne: 'موضع واحد', quranForms: 'الصيغ الواردة',
          classical: 'في المعاجم الكلاسيكية', match: 'مطابق للمعاجم', translations: 'الترجمة', etymology: 'أصل الكلمة',
          gender: 'الجنس', declension: 'الصرف', transitivity: 'التعدّي', preps: 'يتعدّى بـ',
          m: { plural: 'الجمع', plural_type: 'نوع الجمع', dual: 'المثنى', feminine: 'المؤنث', verbal_noun: 'المصدر', active_participle: 'اسم الفاعل', passive_participle: 'اسم المفعول', past: 'الماضي', present: 'المضارع', imperative: 'الأمر' },
          wrong: 'خطأ', right: 'صواب', readings: 'القراءات',
          noResult: 'لم نجد نتيجة لهذه الكلمة. تأكّد من الإملاء.',
          limit: 'بلغت حدّك اليومي المجاني. اشترك من التطبيق لبحثٍ غير محدود.',
          error: 'حدث خطأ. حاول مرة أخرى.', unlimited: 'بحث غير محدود ⚡',
          generating: 'كلمة جديدة على المعجم، يُؤلَّف مدخلها الآن، ثوانٍ قليلة…',
          aiNote: 'المدخل مولَّد بالذكاء الاصطناعي وقد يخطئ.', report: 'أبلغ عن خطأ', fromCache: 'من المعجم', fresh: 'أُضيف الآن',
        }
      : {
          searching: 'Searching…', search: 'Search', root: 'Root', pattern: 'Pattern',
          meanings: 'Meanings', analyze: 'Parse this sentence', irab: "How the word behaves in i'rab", morphology: 'Morphology',
          collocations: 'Collocations', mistakes: 'Common mistakes', nuance: 'Compared with its synonyms',
          synonyms: 'Synonyms', antonyms: 'Antonyms', derivations: 'Derivations', family: 'Same root',
          quran: 'In the Quran', quranN: (n: string) => `${n} occurrences`, quranOne: '1 occurrence', quranForms: 'Forms found',
          classical: 'In the classical dictionaries', match: 'Matches the dictionaries', translations: 'Translation', etymology: 'Etymology',
          gender: 'Gender', declension: 'Declension', transitivity: 'Transitivity', preps: 'Takes',
          m: { plural: 'Plural', plural_type: 'Plural type', dual: 'Dual', feminine: 'Feminine', verbal_noun: 'Verbal noun', active_participle: 'Active participle', passive_participle: 'Passive participle', past: 'Past', present: 'Present', imperative: 'Imperative' },
          wrong: 'Wrong', right: 'Right', readings: 'Readings',
          noResult: 'No result for that word: check the spelling.',
          limit: "You've reached your free daily limit. Subscribe in the app for unlimited search.",
          error: 'Something went wrong. Please try again.', unlimited: 'Unlimited search ⚡',
          generating: 'New word for the dictionary: writing its entry now, a few seconds…',
          aiNote: 'AI-generated entry; it can be wrong.', report: 'Report an error', fromCache: 'From the dictionary', fresh: 'Just added',
        };

    const toolPath = lang === 'ar' ? '/tool' : '/en/tool';
    const AR_DIGITS = '٠١٢٣٤٥٦٧٨٩';
    const num = (n: number) => lang === 'ar' ? String(n).replace(/[0-9]/g, (d) => AR_DIGITS[+d]) : String(n);

    let idToken: string | null = null;

    function showMsg(text: string, kind: 'err' | 'info') {
      msg.textContent = text;
      msg.className = 'text-small rounded-lg px-4 py-3 mb-4 ' +
        (kind === 'info' ? 'bg-purple/10 text-purple' : 'bg-red-500/10 text-red-600 dark:text-red-400');
    }
    const clearMsg = () => { msg.className = 'hidden'; };

    const el = (tag: string, cls?: string, text?: string) => {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text != null) n.textContent = text;
      return n;
    };
    const ar = (n: HTMLElement) => { n.setAttribute('dir', 'rtl'); n.setAttribute('lang', 'ar'); return n; };
    const list = (v: unknown): string[] => Array.isArray(v) ? v.filter((x): x is string => typeof x === 'string' && x.trim().length > 0) : [];
    const objs = (v: unknown): any[] => Array.isArray(v) ? v.filter((x) => x && typeof x === 'object') : [];

    function section(title: string, extra?: string) {
      const s = el('section', 'dict-sec');
      const h = el('h3', 'dict-sec-h'); h.appendChild(el('span', '', title));
      if (extra) h.appendChild(el('span', 'n', extra));
      s.appendChild(h);
      return s;
    }
    function chips(items: string[], cls = 'dict-chip') {
      const w = el('div', 'flex flex-wrap gap-2');
      items.forEach((x) => w.appendChild(ar(el('span', cls, x))));
      return w;
    }

    // ── One vocalised reading ────────────────────────────────────────────────
    function renderVariant(v: any, entry: any, container: HTMLElement) {
      container.replaceChildren();

      // Header: lemma, pos, root, pattern, classical-match badge
      const head = el('div', 'flex flex-wrap items-center gap-x-3 gap-y-2 mb-4');
      const word = ar(el('span', 'font-arabic-display text-[2rem] leading-none text-ink dark:text-mist', v.lemma || input.value.trim()));
      head.appendChild(word);
      if (v.pos) head.appendChild(el('span', 'badge badge-good', v.pos));
      if (v.root) head.appendChild(ar(el('span', 'text-small font-semibold text-purple', `${T.root}: ${v.root}`)));
      if (v.pattern) head.appendChild(ar(el('span', 'text-small font-semibold text-ink/60 dark:text-mist/60', `${T.pattern}: ${v.pattern}`)));
      const classical = entry?.classical;
      if (classical && (classical.count > 0 || objs(classical.entries).length > 0)) {
        const b = el('span', 'dict-match'); b.textContent = '✓ ' + T.match; b.title = T.classical; head.appendChild(b);
      }
      container.appendChild(head);

      // Meanings: definition first, examples with a link into the analyzer
      const senses = objs(v.senses).filter((s) => typeof s.definition === 'string' && s.definition.trim());
      const mean = el('div');
      mean.appendChild(el('h3', 'dict-sec-h', T.meanings));
      const ol = el('ol', 'space-y-4');
      senses.forEach((s, i) => {
        const li = el('li');
        const row = el('div', 'flex flex-wrap items-baseline gap-2');
        if (senses.length > 1) row.appendChild(el('span', 'text-small font-bold text-purple', num(i + 1) + '.'));
        row.appendChild(ar(el('p', 'text-body text-ink dark:text-mist leading-relaxed', s.definition)));
        li.appendChild(row);
        const tags = [s.register, s.domain].filter((x) => typeof x === 'string' && x && x !== 'عام' && x !== 'فصحى');
        if (tags.length) li.appendChild(chips(tags, 'dict-chip muted'));
        const exs = objs(s.examples).map((e) => e.text || e.ar || e.example).filter((x) => typeof x === 'string' && x.trim());
        if (exs.length) {
          const ul = el('ul', 'mt-2 space-y-1.5');
          exs.slice(0, 3).forEach((text: string) => {
            const line = ar(el('li', 'dict-ex text-small text-ink/80 dark:text-mist/80'));
            line.appendChild(document.createTextNode(text));
            const a = el('a', '', T.analyze) as HTMLAnchorElement;
            a.href = `${toolPath}?s=${encodeURIComponent(text)}`;
            line.appendChild(a);
            ul.appendChild(line);
          });
          li.appendChild(ul);
        }
        ol.appendChild(li);
      });
      mean.appendChild(ol);
      container.appendChild(mean);

      // How the word behaves in i'rab
      const ir = v.irab && typeof v.irab === 'object' ? v.irab : null;
      const preps = ir ? list(ir.prepositions) : [];
      if (ir && (ir.gender || ir.declension || ir.transitivity || preps.length || ir.note)) {
        const s = section(T.irab);
        const facts: string[] = [];
        if (ir.gender) facts.push(ir.gender);
        if (ir.declension) facts.push(ir.declension);
        if (ir.transitivity) facts.push(ir.transitivity);
        if (facts.length) s.appendChild(chips(facts, 'dict-chip purple'));
        if (preps.length) s.appendChild(ar(el('p', 'text-small text-ink/80 dark:text-mist/80 mt-2', `${T.preps} ${preps.join('، ')}`)));
        if (ir.note) s.appendChild(ar(el('p', 'text-body text-ink dark:text-mist leading-relaxed mt-2', ir.note)));
        container.appendChild(s);
      }

      // Morphology table
      const m = v.morphology && typeof v.morphology === 'object' ? v.morphology : {};
      const rows = Object.entries(T.m).filter(([k]) => typeof m[k] === 'string' && m[k].trim());
      if (rows.length) {
        const s = section(T.morphology);
        const table = el('table', 'dict-table');
        rows.forEach(([k, label]) => {
          const tr = el('tr'); tr.appendChild(el('th', '', label)); tr.appendChild(ar(el('td', '', m[k])));
          table.appendChild(tr);
        });
        s.appendChild(table);
        container.appendChild(s);
      }

      // Collocations, mistakes, nuance
      const coll = objs(v.collocations).filter((c) => typeof c.text === 'string' && c.text.trim());
      if (coll.length) {
        const s = section(T.collocations);
        const ul = el('ul', 'space-y-1.5');
        coll.forEach((c) => {
          const li = ar(el('li', 'text-body text-ink dark:text-mist'));
          li.appendChild(el('span', 'font-semibold', c.text));
          if (c.meaning) li.appendChild(el('span', 'text-ink/65 dark:text-mist/65', `: ${c.meaning}`));
          ul.appendChild(li);
        });
        s.appendChild(ul); container.appendChild(s);
      }
      const mist = objs(v.common_mistakes).filter((c) => typeof c.right === 'string' && c.right.trim());
      if (mist.length) {
        const s = section(T.mistakes);
        const ul = el('ul', 'space-y-2');
        mist.forEach((c) => {
          const li = ar(el('li', 'text-body'));
          if (c.wrong) { const w = el('span', 'text-red-600 dark:text-red-400 line-through', c.wrong); li.appendChild(w); li.appendChild(document.createTextNode(' ')); }
          li.appendChild(el('span', 'font-semibold text-teal', c.right));
          if (c.why) li.appendChild(el('span', 'block text-small text-ink/65 dark:text-mist/65', c.why));
          ul.appendChild(li);
        });
        s.appendChild(ul); container.appendChild(s);
      }
      if (typeof v.nuance === 'string' && v.nuance.trim()) {
        const s = section(T.nuance);
        s.appendChild(ar(el('p', 'text-body text-ink dark:text-mist leading-relaxed', v.nuance)));
        container.appendChild(s);
      }

      // Synonyms, antonyms, derivations, root family
      const syn = list(v.synonyms), ant = list(v.antonyms), der = list(v.derivations);
      const fam = objs(entry?.root_family).filter((r) => typeof r.word === 'string' && r.word.trim());
      if (syn.length || ant.length || der.length || fam.length) {
        const s = section(T.synonyms + (ant.length ? ` / ${T.antonyms}` : ''));
        if (syn.length) s.appendChild(chips(syn));
        if (ant.length) { s.appendChild(el('p', 'dict-sec-h mt-3', T.antonyms)); s.appendChild(chips(ant, 'dict-chip muted')); }
        if (der.length) { s.appendChild(el('p', 'dict-sec-h mt-3', T.derivations)); s.appendChild(chips(der, 'dict-chip purple')); }
        if (fam.length) {
          s.appendChild(el('p', 'dict-sec-h mt-3', T.family));
          const ul = el('ul', 'flex flex-wrap gap-x-4 gap-y-1');
          fam.slice(0, 8).forEach((r) => {
            const li = ar(el('li', 'text-small text-ink/80 dark:text-mist/80'));
            li.appendChild(el('span', 'font-semibold text-ink dark:text-mist', r.word));
            if (r.gloss) li.appendChild(el('span', '', `: ${r.gloss}`));
            ul.appendChild(li);
          });
          s.appendChild(ul);
        }
        container.appendChild(s);
      }

      // Quran occurrences (own index) linking to the ayah i'rab pages
      const qn = entry?.quran && typeof entry.quran === 'object' ? entry.quran : null;
      if (qn && typeof qn.n === 'number' && qn.n > 0) {
        const s = section(T.quran, qn.n === 1 ? T.quranOne : T.quranN(num(qn.n)));
        const forms = qn.forms && typeof qn.forms === 'object' ? Object.entries(qn.forms) as Array<[string, number]> : [];
        if (forms.length > 1) s.appendChild(chips(forms.map(([f, c]) => `${f} (${num(c)})`), 'dict-chip muted'));
        const refs = objs(qn.refs).filter((r) => r.slug && r.a);
        if (refs.length) {
          const ul = el('ul', 'grid gap-2 mt-3');
          refs.slice(0, 3).forEach((r) => {
            const a = ar(el('a', 'dict-ayah')) as HTMLAnchorElement;
            a.href = `/quran/${r.slug}/${r.a}`;
            a.appendChild(el('span', 'ref', `${lang === 'ar' ? 'سورة' : 'Surah'} ${r.name || r.slug} · ${lang === 'ar' ? 'الآية' : 'ayah'} ${num(r.a)}${r.token ? ` · ${r.token}` : ''}`));
            if (r.analysis) a.appendChild(el('span', 'an block mt-0.5', r.analysis));
            ul.appendChild(a);
          });
          s.appendChild(ul);
        }
        container.appendChild(s);
      }

      // Classical dictionaries (qamoos.org)
      const cl = objs(entry?.classical?.entries).filter((c) => typeof c.text === 'string' && c.text.trim());
      if (cl.length) {
        const s = section(T.classical);
        cl.slice(0, 3).forEach((c) => {
          const p = ar(el('blockquote', 'dict-classical mb-2'));
          if (c.dictionary) p.appendChild(el('span', 'src', c.dictionary));
          p.appendChild(document.createTextNode(c.text));
          s.appendChild(p);
        });
        container.appendChild(s);
      }

      // Translations + etymology
      const tr = v.translations || {};
      const en = list(tr.en), fr = list(tr.fr);
      if (en.length || fr.length || (typeof entry?.etymology === 'string' && entry.etymology.trim())) {
        const s = section(T.translations);
        if (en.length) s.appendChild(el('p', 'text-body text-ink/80 dark:text-mist/80', 'EN: ' + en.join(', ')));
        if (fr.length) s.appendChild(el('p', 'text-body text-ink/80 dark:text-mist/80', 'FR: ' + fr.join(', ')));
        if (typeof entry?.etymology === 'string' && entry.etymology.trim()) {
          s.appendChild(el('p', 'dict-sec-h mt-3', T.etymology));
          s.appendChild(ar(el('p', 'text-small text-ink/80 dark:text-mist/80', entry.etymology)));
        }
        container.appendChild(s);
      }
    }

    // ── Whole entry: readings as tabs + footer ───────────────────────────────
    function render(data: any, source?: string) {
      result.replaceChildren();
      const variants: any[] = objs(data?.variants).filter((v) => objs(v.senses).length > 0);
      const legacy = data && objs(data.senses).length > 0 ? [data] : [];
      const readings = variants.length ? variants : legacy;
      if (readings.length === 0) { showMsg(T.noResult, 'info'); return; }
      clearMsg();

      const card = el('div', 'card panel-in p-6 md:p-8');
      let body = el('div');
      if (readings.length > 1) {
        const tabs = el('div', 'dict-tabs'); tabs.setAttribute('role', 'tablist');
        tabs.appendChild(el('span', 'dict-sec-h self-center', T.readings));
        readings.forEach((v, i) => {
          const b = ar(el('button', 'dict-tab', v.lemma || `${i + 1}`)) as HTMLButtonElement;
          b.type = 'button'; b.setAttribute('role', 'tab'); b.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
          b.addEventListener('click', () => {
            tabs.querySelectorAll('.dict-tab').forEach((x) => x.setAttribute('aria-selected', 'false'));
            b.setAttribute('aria-selected', 'true');
            renderVariant(v, data, body);
          });
          tabs.appendChild(b);
        });
        card.appendChild(tabs);
      }
      card.appendChild(body);
      renderVariant(readings[0], data, body);

      // Footer: provenance + report link
      const meta = el('p', 'dict-meta');
      meta.appendChild(el('span', '', T.aiNote));
      if (source === 'cache') meta.appendChild(el('span', '', T.fromCache));
      else if (source === 'generated') meta.appendChild(el('span', '', T.fresh));
      const rep = el('a', '', T.report) as HTMLAnchorElement;
      const w = readings[0].lemma || input.value.trim();
      rep.href = `mailto:support@irab.app?subject=${encodeURIComponent((lang === 'ar' ? 'خطأ في المعجم: ' : 'Dictionary error: ') + w)}`;
      meta.appendChild(rep);
      card.appendChild(meta);

      result.appendChild(card);
    }

    async function search(word: string) {
      if (!word) return;
      clearMsg(); result.replaceChildren();
      submit.disabled = true; submitLabel.textContent = T.searching;
      // A cached word answers in well under a second; a fresh one takes a few
      // seconds to write. Show the skeleton, and explain after 1.5 s.
      pending.classList.remove('hidden'); pendingNote.textContent = '';
      const noteTimer = window.setTimeout(() => { pendingNote.textContent = T.generating; }, 1500);
      try {
        const res = await fetch(`${WORKER}/api/dictionary`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', ...(idToken ? { Authorization: `Bearer ${idToken}` } : {}) },
          body: JSON.stringify({ word }),
        });
        if (res.status === 429) {
          if ((window as any).IrabPaywall) (window as any).IrabPaywall.show();
          else showMsg(T.limit, 'info');
          return;
        }
        if (!res.ok) { showMsg(T.error, 'err'); return; }
        const json = await res.json();
        if (json && json.data === null) { showMsg(T.noResult, 'info'); return; }
        render(json?.data ?? json, json?.source);
      } catch {
        showMsg(T.error, 'err');
      } finally {
        window.clearTimeout(noteTimer);
        pending.classList.add('hidden');
        submit.disabled = false; submitLabel.textContent = T.search;
      }
    }

    form.addEventListener('submit', (e) => { e.preventDefault(); search(input.value.trim()); });

    // Empty-state chips: fill the input with a curated root and run the same lookup.
    const examplesWrap = root.querySelector<HTMLElement>('[data-dict-examples]');
    examplesWrap?.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLElement>('[data-dict-example]');
      if (!chip) return;
      const word = chip.dataset.dictExample || '';
      if (!word) return;
      input.value = word;
      search(word);
    });

    // Auth gate: Firebase only loads here (a tool page), never on content pages.
    (async () => {
      if (!maybeSignedIn()) { loadingEl.classList.add('hidden'); gate.classList.remove('hidden'); return; }
      try {
        const [{ onAuth }, { fetchMe }] = await Promise.all([import('../lib/auth'), import('../lib/entitlement')]);
        onAuth(async (u) => {
          loadingEl.classList.add('hidden');
          if (!u) { gate.classList.remove('hidden'); return; }
          try { idToken = await u.getIdToken(); } catch {}
          tool.classList.remove('hidden');
          try { const me = await fetchMe(u); if (me?.premium) quota.textContent = T.unlimited; } catch {}
          // Deep link: /dictionary?w=<word> runs the lookup on arrival.
          const w = new URLSearchParams(location.search).get('w');
          if (w) { input.value = w; search(w); } else input.focus();
        });
      } catch { loadingEl.classList.add('hidden'); gate.classList.remove('hidden'); }
    })();
  }
</script>
