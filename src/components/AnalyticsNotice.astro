---
/**
 * One-line analytics notice (owner decision 2026-09-22: no blocking banner;
 * 2026-10-21: as rarely as possible).
 *
 * At most once per browser: it counts as seen the moment it appears, not only
 * when «OK» is pressed, so ignoring it never brings it back on the next page
 * or the next day. Signed-in visitors never see it (they accepted the privacy
 * policy when they made their account). It waits for the visitor's first
 * scroll, tap or key press, so it never interrupts the first look at a page
 * and never competes with the first paint; then it slides away by itself
 * after a few seconds unless the pointer or focus is on it. A privacy link
 * and a one-tap opt-out (PostHog's opt_out_capturing) stay on it. Rendered
 * only when a PostHog token is configured; anonymous visitors are tracked
 * without cookies (localStorage), signed-in users under their account.
 */
import { POSTHOG_TOKEN, ANALYTICS_NOTICE_VERSION } from '../config/analytics';

interface Props { lang?: 'ar' | 'en' }
const { lang = 'ar' } = Astro.props;
const enabled = POSTHOG_TOKEN.length > 0;
const t = lang === 'en'
  ? {
      body: 'We use privacy-friendly analytics (no cookies) to improve Irab. Your sentences are never sent.',
      privacy: 'Privacy',
      optOut: 'Opt out',
      ok: 'OK',
      href: '/en/privacy',
    }
  : {
      body: 'نستخدم تحليلات تحترم الخصوصية (بدون كوكيز) لتحسين إعراب. جملك لا تُرسل أبدًا.',
      privacy: 'الخصوصية',
      optOut: 'إيقاف التحليلات',
      ok: 'حسنًا',
      href: '/privacy',
    };
---
{enabled && (
  <div data-analytics-notice data-version={ANALYTICS_NOTICE_VERSION} hidden role="status" class="an">
    <p class="an-body">{t.body}</p>
    <div class="an-actions">
      <a href={t.href} class="an-link">{t.privacy}</a>
      <button type="button" data-notice-optout class="an-link">{t.optOut}</button>
      <button type="button" data-notice-ok class="an-ok">{t.ok}</button>
    </div>
  </div>
  <style>
    .an {
      position: fixed; z-index: 60; bottom: 12px; inset-inline: 12px;
      display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px;
      padding: 10px; padding-inline-start: 16px;
      border-radius: 16px; font-size: 13.5px; line-height: 1.6;
      color: var(--color-ink); background: var(--color-card);
      border: 1px solid var(--color-card-edge);
      box-shadow: 0 2px 6px rgb(23 56 71 / 0.08), 0 18px 40px -18px rgb(23 56 71 / 0.35);
      opacity: 0; translate: 0 14px;
      transition: opacity .35s var(--ease-out-quart), translate .45s var(--ease-out-expo);
    }
    @media (min-width: 640px) { .an { inset-inline: 16px auto; bottom: 16px; max-width: 34rem; } }
    :global(.dark) .an { color: var(--color-mist); background: var(--color-coal-soft); border-color: var(--color-coal-edge); box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.7); }
    .an.is-in { opacity: 1; translate: 0 0; }
    .an[hidden] { display: none; }
    .an-body { flex: 1 1 16rem; margin: 0; color: var(--color-ink-muted); }
    :global(.dark) .an-body { color: var(--color-mist-muted); }
    .an-actions { display: flex; align-items: center; gap: 12px; margin-inline-start: auto; }
    .an-link { font-size: 12.5px; color: var(--color-ink-subtle); text-decoration: underline; text-underline-offset: 3px; background: none; border: 0; padding: 0; cursor: pointer; }
    :global(.dark) .an-link { color: var(--color-mist-subtle); }
    .an-link:hover { color: var(--color-purple); }
    .an-ok {
      min-height: 36px; padding: 0 18px; border-radius: 999px; border: 0; cursor: pointer;
      font-size: 13.5px; font-weight: 700; color: var(--color-paper); background: var(--color-ink);
      transition: opacity .2s;
    }
    :global(.dark) .an-ok { color: var(--color-coal); background: var(--color-mist); }
    .an-ok:hover { opacity: .9; }
    .an-ok:focus-visible, .an-link:focus-visible { outline: 2px solid var(--color-purple); outline-offset: 2px; }
    @media (prefers-reduced-motion: reduce) { .an { transition: opacity .2s; translate: none; } }
  </style>
  <script>
    import { maybeSignedIn } from '../lib/session';

    (() => {
      const el = document.querySelector<HTMLElement>('[data-analytics-notice]');
      if (!el) return;
      const key = 'irab-analytics-notice';
      const version = el.dataset.version || '1';
      const markSeen = () => { try { localStorage.setItem(key, version); } catch { /* private mode */ } };
      let seen = false;
      try { seen = localStorage.getItem(key) === version; } catch { /* treat as unseen */ }
      if (seen) return;
      if (maybeSignedIn()) { markSeen(); return; }

      let timer = 0;
      let hovered = false;
      const hide = () => {
        clearTimeout(timer);
        el.classList.remove('is-in');
        setTimeout(() => { el.hidden = true; }, 450);
      };
      // Slides away on its own, unless the pointer or keyboard focus is on it.
      const arm = () => {
        clearTimeout(timer);
        timer = window.setTimeout(() => { if (!hovered && !el.contains(document.activeElement)) hide(); }, 9000);
      };
      el.querySelector('[data-notice-ok]')?.addEventListener('click', hide);
      el.querySelector('[data-notice-optout]')?.addEventListener('click', async () => {
        try { const m = await import('../lib/analytics'); m.optOut(); } catch { /* ignore */ }
        hide();
      });
      el.addEventListener('pointerenter', () => { hovered = true; clearTimeout(timer); });
      el.addEventListener('pointerleave', () => { hovered = false; arm(); });
      el.addEventListener('focusout', () => setTimeout(() => { if (!el.contains(document.activeElement)) arm(); }, 0));

      // The first scroll, tap or key press shows it, once, a moment later.
      const events = ['scroll', 'pointerdown', 'keydown'] as const;
      let pending = false;
      const show = () => {
        markSeen();
        el.hidden = false;
        requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('is-in')));
        arm();
      };
      const onFirst = () => {
        if (pending) return;
        pending = true;
        events.forEach((ev) => removeEventListener(ev, onFirst));
        setTimeout(show, 700);
      };
      events.forEach((ev) => addEventListener(ev, onFirst, { passive: true }));
    })();
  </script>
)}
