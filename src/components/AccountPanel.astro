---
/**
 * AccountPanel: the account settings page for /account and /en/account, in
 * the tools' design (irab-ui). The hub (/app) carries progress and tools;
 * this page carries the profile, the plan, preferences, help and sign-out.
 * Firebase loads only in the script below; the page stays noindex.
 * Words: lib/account/strings.ts.
 */
import '../styles/irab-ui.css';
import Paywall from './Paywall.astro';
import { ACCOUNT } from '../lib/account/strings';
import * as I from '../lib/irab/icons';

interface Props { lang?: 'ar' | 'en'; }
const { lang = 'ar' } = Astro.props;
const s = ACCOUNT[lang];
const en = lang === 'en';
const p = (path: string) => (en ? `/en${path}` : path);
const dir = en ? 'ltr' : 'rtl';
const chev = I.chevronLeft.replace('<svg', '<svg class="flip-ltr ac-chev"');
const back = I.arrowRight.replace('<svg', '<svg class="flip-ltr"');

const svg = (body: string) => `<svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${body}</svg>`;
const ic = {
  mail: svg('<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>'),
  key: svg('<path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"/><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"/>'),
  calendar: svg('<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>'),
  moon: svg('<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>'),
  globe: svg('<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>'),
  scale: svg('<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>'),
  receipt: svg('<path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 17.5v-11"/>'),
  logOut: svg('<path d="m16 17 5-5-5-5"/><path d="M21 12H9"/><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>'),
};
---

<div class="iu iu-account" data-account-root data-lang={lang} data-login={p('/login')} dir={dir} lang={lang}>
  <a href={p('/app')} class="iu-card-link ac-back"><Fragment set:html={back} />{s.back}</a>
  <header class="ac-head">
    <h1 class="t-display c-1">{s.title}</h1>
    <p class="t-body c-2">{s.intro}</p>
  </header>

  <div data-loading aria-busy="true" aria-label={s.loading} class="ac-stack">
    {[0, 1, 2].map(() => <div class="iu-card az-skel" aria-hidden="true"><span></span><span></span><span></span></div>)}
  </div>

  <div data-panel class="hidden ac-stack">
    <section aria-labelledby="ac-profile">
      <h2 id="ac-profile" class="t-title c-1 ac-h2">{s.profile}</h2>
      <div class="iu-card ac-card">
        <div class="ac-identity">
          <div class="ac-avatar" data-avatar aria-hidden="true">{en ? 'I' : 'إ'}</div>
          <div class="ac-who">
            <p class="t-title-l c-1 ac-name" data-name></p>
          </div>
        </div>
        <div data-email-row class="hidden ac-row">
          <span class="ac-icon"><Fragment set:html={ic.mail} /></span>
          <span class="ac-text">
            <span class="t-body-strong c-1">{s.email}</span>
            <span class="t-caption c-3 ac-email" data-email dir="ltr"></span>
          </span>
          <span data-verify class="iu-tag"></span>
        </div>
        <div data-resend-row class="hidden ac-resend">
          <button type="button" data-resend class="iu-btn secondary">{s.resend}</button>
          <p data-resend-note class="t-caption c-3" role="status"></p>
        </div>
        <div data-method-row class="hidden ac-row">
          <span class="ac-icon"><Fragment set:html={ic.key} /></span>
          <span class="ac-text"><span class="t-body-strong c-1">{s.signInMethod}</span></span>
          <span data-method class="t-label c-2 ac-value" dir="auto"></span>
        </div>
        <div data-member-row class="hidden ac-row">
          <span class="ac-icon"><Fragment set:html={ic.calendar} /></span>
          <span class="ac-text"><span class="t-body-strong c-1">{s.memberSince}</span></span>
          <span data-member class="t-label c-2 ac-value"></span>
        </div>
      </div>
    </section>

    <section aria-labelledby="ac-plan">
      <h2 id="ac-plan" class="t-title c-1 ac-h2">{s.plan}</h2>
      <div data-plan-card class="iu-card ac-card ac-plan">
        <div class="ac-plan-head">
          <span class="ac-plan-icon" aria-hidden="true"><Fragment set:html={I.crown} /></span>
          <p data-plan class="t-card-title c-1">{s.checking}</p>
          <span data-plan-badge class="hidden iu-tag success">{s.active}</span>
        </div>
        <p data-plan-note class="t-body-s c-2 ac-plan-note"></p>
        {/*
          Shown only on the free plan. A subscriber paid on one Google address,
          signed in later with a second address of his own, and read "Free plan"
          as proof the payment had failed. His email was already on this page and
          that was not enough: nothing connected the address to the plan he saw.
        */}
        <p data-plan-hint class="hidden t-caption c-3 ac-plan-hint"></p>
        <button type="button" data-upgrade class="hidden iu-btn primary lg block ac-upgrade">
          <Fragment set:html={I.crown} /><span>{s.upgrade}</span>
        </button>
      </div>
    </section>

    <section aria-labelledby="ac-prefs">
      <h2 id="ac-prefs" class="t-title c-1 ac-h2">{s.prefs}</h2>
      <div class="iu-card ac-card ac-list">
        <button type="button" data-theme-toggle class="ac-row ac-link">
          <span class="ac-icon"><Fragment set:html={ic.moon} /></span>
          <span class="ac-text"><span class="t-body-strong c-1">{s.theme}</span></span>
          <span class="t-label c-2 ac-value"><span class="ac-when-light">{s.light}</span><span class="ac-when-dark">{s.dark}</span></span>
        </button>
        <a href={en ? '/account' : '/en/account'} class="ac-row ac-link" hreflang={en ? 'ar' : 'en'}>
          <span class="ac-icon"><Fragment set:html={ic.globe} /></span>
          <span class="ac-text"><span class="t-body-strong c-1">{s.language}</span></span>
          <span class="t-label c-primary ac-value" lang={en ? 'ar' : 'en'}>{s.langValue}</span>
          <Fragment set:html={chev} />
        </a>
      </div>
    </section>

    <section aria-labelledby="ac-help">
      <h2 id="ac-help" class="t-title c-1 ac-h2">{s.help}</h2>
      <nav class="iu-card ac-card ac-list" aria-labelledby="ac-help">
        <a href="mailto:support@irab.app" class="ac-row ac-link">
          <span class="ac-icon"><Fragment set:html={I.messageQuestion} /></span>
          <span class="ac-text">
            <span class="t-body-strong c-1">{s.support}</span>
            <span class="t-caption c-3" dir="ltr">support@irab.app</span>
          </span>
          <Fragment set:html={chev} />
        </a>
        <a href={p('/privacy')} class="ac-row ac-link">
          <span class="ac-icon"><Fragment set:html={I.shieldCheck} /></span>
          <span class="ac-text"><span class="t-body-strong c-1">{s.privacy}</span></span>
          <Fragment set:html={chev} />
        </a>
        <a href={p('/terms')} class="ac-row ac-link">
          <span class="ac-icon"><Fragment set:html={ic.scale} /></span>
          <span class="ac-text"><span class="t-body-strong c-1">{s.terms}</span></span>
          <Fragment set:html={chev} />
        </a>
        <a href={p('/refund')} class="ac-row ac-link">
          <span class="ac-icon"><Fragment set:html={ic.receipt} /></span>
          <span class="ac-text"><span class="t-body-strong c-1">{s.refund}</span></span>
          <Fragment set:html={chev} />
        </a>
      </nav>
    </section>

    <button type="button" data-signout class="iu-btn secondary lg block ac-signout">
      <Fragment set:html={ic.logOut} /><span>{s.signOut}</span>
    </button>
  </div>
</div>

<Paywall lang={lang} />

<style is:global>
  .iu-account { max-width: 780px; margin: 0 auto; padding: 0 0 40px; }
  /* The script shows and hides parts with the .hidden class; card layouts must not win over it. */
  .iu-account .hidden { display: none !important; }
  .iu-account .ac-back { margin-bottom: 10px; text-decoration: none; }
  .iu-account .ac-head { margin-bottom: 26px; }
  .iu-account .ac-head p { margin: 4px 0 0; }
  .iu-account .ac-stack { display: flex; flex-direction: column; gap: 26px; }
  .iu-account .ac-h2 { margin: 0 0 12px; }

  .iu-account .ac-card { padding: 8px 20px; }
  .iu-account .ac-identity { display: flex; align-items: center; gap: 16px; padding: 16px 0; }
  .iu-account .ac-avatar {
    width: 66px; height: 66px; border-radius: 999px; display: grid; place-items: center; flex: none;
    background: var(--iu-primary-soft); color: var(--iu-primary-text); font-size: 28px; font-weight: 700;
  }
  .iu-account .ac-who { flex: 1; min-width: 0; }
  .iu-account .ac-name { margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* A settings row: icon tile, label, then a value, a tag or a chevron. */
  .iu-account .ac-row {
    display: flex; align-items: center; gap: 14px; width: 100%; min-height: 68px; padding: 12px 0;
    border: 0; border-top: 1px solid var(--iu-border); background: none; color: inherit;
    font: inherit; text-align: start; text-decoration: none;
  }
  .iu-account .ac-list .ac-row:first-child { border-top: 0; }
  .iu-account .ac-icon {
    width: 42px; height: 42px; border-radius: 13px; display: grid; place-items: center; flex: none;
    background: var(--iu-sunken); color: var(--iu-text-2);
  }
  .iu-account .ac-icon svg { width: 20px; height: 20px; }
  .iu-account .ac-text { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .iu-account .ac-email { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .iu-account[dir='rtl'] .ac-text [dir='ltr'] { text-align: right; }
  .iu-account .ac-value { flex: none; }
  .iu-account .ac-chev { width: 19px; height: 19px; flex: none; color: var(--iu-text-3); transition: translate .3s cubic-bezier(.22, 1, .36, 1), color .2s ease; }
  .iu-account .ac-link { cursor: pointer; border-radius: 0; }
  .iu-account .ac-link:focus-visible { outline: 2px solid var(--iu-primary); outline-offset: 2px; border-radius: 12px; }
  @media (hover: hover) {
    .iu-account .ac-link:hover .ac-icon { background: var(--iu-primary-soft); color: var(--iu-primary); }
    .iu-account .ac-link:hover .ac-chev { translate: -3px 0; color: var(--iu-text-2); }
    .iu-account[dir='ltr'] .ac-link:hover .ac-chev { translate: 3px 0; }
  }
  .iu-account .ac-when-dark { display: none; }
  .dark .iu-account .ac-when-light { display: none; }
  .dark .iu-account .ac-when-dark { display: inline; }

  .iu-account .ac-resend { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 0 0 14px; }
  .iu-account .ac-resend p { margin: 0; }
  .iu-account .ac-resend p:empty { display: none; }

  /* Plan */
  .iu-account .ac-plan { padding: 20px; }
  .iu-account .ac-plan-head { display: flex; align-items: center; gap: 12px; }
  .iu-account .ac-plan-head p { flex: 1; margin: 0; }
  .iu-account .ac-plan-icon { width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; flex: none; background: var(--iu-sunken); color: var(--iu-text-2); }
  .iu-account .ac-plan-icon svg { width: 22px; height: 22px; }
  .iu-account .ac-plan.is-plus { background: color-mix(in srgb, var(--iu-primary) 5%, var(--iu-card)); border-color: color-mix(in srgb, var(--iu-primary) 20%, var(--iu-border)); }
  .iu-account .ac-plan.is-plus .ac-plan-icon { background: var(--iu-primary-soft); color: var(--iu-primary); }
  .iu-account .ac-plan-note { margin: 12px 0 0; }
  .iu-account .ac-plan-note:empty { display: none; }
  .iu-account .ac-plan-hint { margin: 12px 0 0; padding-top: 12px; border-top: 1px solid var(--iu-border); }
  .iu-account .ac-upgrade { margin-top: 16px; }

  .iu-account .iu-btn.ac-signout { color: var(--iu-error-text); }
  @media (hover: hover) {
    .iu-account .iu-btn.ac-signout:hover { background: var(--iu-error-soft); border-color: transparent; }
  }

  @media (prefers-reduced-motion: reduce) {
    .iu-account .ac-chev { translate: none !important; }
  }
</style>

<script>
  import { maybeSignedIn } from '../lib/session';
  import { ACCOUNT } from '../lib/account/strings';
  import { digits } from '../lib/irab/strings';

  const root = document.querySelector<HTMLElement>('[data-account-root]');
  if (root) {
    const lang = root.dataset.lang === 'en' ? 'en' : 'ar';
    const s = ACCOUNT[lang];
    const login = root.dataset.login || '/login';
    const q = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const toLogin = () => window.location.replace(`${login}?next=${encodeURIComponent(window.location.pathname)}`);

    (async () => {
      if (!maybeSignedIn()) { toLogin(); return; }
      const [{ onAuth, logout, resendVerification }, { fetchMe }, { rememberSignedIn, forgetSignedIn }] =
        await Promise.all([import('../lib/auth'), import('../lib/entitlement'), import('../lib/session')]);

      q<HTMLButtonElement>('[data-signout]').addEventListener('click', async () => {
        try { await logout(); } catch {}
        forgetSignedIn();
        window.location.assign(login);
      });

      onAuth((user) => {
        if (!user) { forgetSignedIn(); toLogin(); return; }
        rememberSignedIn();
        q<HTMLElement>('[data-loading]').classList.add('hidden');
        q<HTMLElement>('[data-panel]').classList.remove('hidden');

        const name = user.displayName || (user.email ? user.email.split('@')[0] : s.user);
        q<HTMLElement>('[data-name]').textContent = name;
        q<HTMLElement>('[data-email]').textContent = user.email || '';
        const initial = (user.displayName || user.email || '').trim();
        if (initial) q<HTMLElement>('[data-avatar]').textContent = Array.from(initial)[0].toUpperCase();

        const verify = q<HTMLElement>('[data-verify]');
        verify.textContent = user.emailVerified ? s.verified : s.unverified;
        verify.className = `iu-tag ${user.emailVerified ? 'success' : 'partial'}`;
        if (user.email) q<HTMLElement>('[data-email-row]').classList.remove('hidden');
        if (!user.emailVerified && user.email) {
          q<HTMLElement>('[data-resend-row]').classList.remove('hidden');
          const btn = q<HTMLButtonElement>('[data-resend]');
          const note = q<HTMLElement>('[data-resend-note]');
          btn.addEventListener('click', async () => {
            btn.disabled = true;
            try { await resendVerification(user); note.textContent = s.resent; }
            catch { note.textContent = s.resendFailed; btn.disabled = false; }
          });
        }

        // Which door the user came in by: the usual reason a subscriber
        // "lost" a plan is signing in with a different provider or address.
        const provider = user.providerData.map((d) => d?.providerId ?? '').find((id) => id) || '';
        const method = s.methods[provider.replace('.com', '')];
        if (method) {
          q<HTMLElement>('[data-method]').textContent = method;
          q<HTMLElement>('[data-method-row]').classList.remove('hidden');
        }

        const created = user.metadata?.creationTime;
        if (created) {
          try {
            const date = new Intl.DateTimeFormat(lang, { month: 'long', year: 'numeric' }).format(new Date(created));
            q<HTMLElement>('[data-member]').textContent = digits(date, lang);
            q<HTMLElement>('[data-member-row]').classList.remove('hidden');
          } catch {}
        }

        const card = q<HTMLElement>('[data-plan-card]');
        const planEl = q<HTMLElement>('[data-plan]');
        const noteEl = q<HTMLElement>('[data-plan-note]');
        const hintEl = q<HTMLElement>('[data-plan-hint]');
        const upgrade = q<HTMLButtonElement>('[data-upgrade]');
        const showFree = () => {
          planEl.textContent = s.planFree;
          noteEl.textContent = s.noteFree;
          if (user.email) {
            hintEl.textContent = s.hintFree.replace('@email', user.email);
            hintEl.classList.remove('hidden');
          }
          upgrade.classList.remove('hidden');
        };
        upgrade.addEventListener('click', () => {
          const paywall = (window as any).IrabPaywall;
          if (paywall) paywall.show({ uid: user.uid, email: user.email || undefined });
          else window.location.href = lang === 'en' ? '/en/pricing' : '/pricing';
        });
        fetchMe(user).then((me) => {
          if (me?.premium !== true) { showFree(); return; }
          planEl.textContent = s.planPlus;
          noteEl.textContent = s.notePlus;
          card.classList.add('is-plus');
          q<HTMLElement>('[data-plan-badge]').classList.remove('hidden');
        }).catch(() => {
          // The lookup failed, so this "Free plan" may be wrong. That is exactly
          // when a paying subscriber needs the account hint most.
          showFree();
        });
      });
    })();
  }
</script>
