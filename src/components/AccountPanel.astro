---
/**
 * AccountPanel — signed-in account dashboard for /account and /en/account.
 * Firebase is imported only in the client island below; the page stays noindex.
 */
import Paywall from './Paywall.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props { lang?: 'ar' | 'en'; }
const { lang = 'ar' } = Astro.props;
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const login = lang === 'ar' ? '/login' : '/en/login';
const appHref = lang === 'ar' ? '/app' : '/en/app';
const historyHref = lang === 'ar' ? '/history' : '/en/history';
const dictHref = lang === 'ar' ? '/dictionary' : '/en/dictionary';
const libraryHref = lang === 'ar' ? '/library' : '/en/library';
const altLangHref = lang === 'ar' ? '/en/account' : '/account';
const privacyHref = '/privacy';
const termsHref = '/terms';
const support = 'mailto:support@irab.app';
const chev = lang === 'ar' ? 'M15 18l-6-6 6-6' : 'M9 18l6-6-6-6';

const t = lang === 'ar'
  ? {
      loading: 'جارٍ تجهيز حسابك…', eyebrow: 'حسابي', title: 'مساحتك في إعراب',
      intro: 'تابع نشاطك، افتح أدواتك، وأدر اشتراكك وتفضيلاتك من مكان واحد.',
      memberSince: 'عضو منذ', activity: 'ملخّص التقدّم', activityBody: 'أرقامك المحفوظة على هذا الجهاز',
      statAnalyses: 'تحليلات', statPractice: 'تمارين', statStreak: 'أيام متتالية', statBest: 'أفضل نتيجة',
      noActivityTitle: 'ابدأ رحلتك الأولى', noActivity: 'حلّل جملة أو ابدأ تمرينًا، وسنرتّب تقدّمك هنا.', startNow: 'افتح لوحة التعلّم',
      plan: 'اشتراكك', planChecking: 'جارٍ التحقّق…', upgrade: 'الترقية إلى إعراب بلس',
      planHint: 'الخطة الحالية', explore: 'الوصول السريع', exploreBody: 'كل ما تحتاجه في ضغطة واحدة',
      openApp: 'لوحة التعلّم', appDesc: 'أدواتك وتقدّمك اليومي', history: 'سجلّي', historyDesc: 'تحليلاتك وتمارينك السابقة',
      dictionary: 'المعجم الذكي', dictionaryDesc: 'معنى الكلمة وجذرها ووزنها', library: 'المكتبة', libraryDesc: '٤٧ كتابًا في علوم العربية',
      prefs: 'التفضيلات', prefsBody: 'اجعل إعراب مناسبًا لطريقتك', darkMode: 'مظهر الموقع', darkModeDesc: 'التبديل بين الوضعين الفاتح والداكن',
      language: 'لغة الواجهة', langValue: 'English', languageDesc: 'تغيير لغة الحساب والموقع',
      supportTitle: 'الحساب والمساعدة', help: 'تواصل مع الدعم', privacy: 'سياسة الخصوصية', terms: 'الشروط والأحكام',
      signOut: 'تسجيل الخروج', resend: 'إعادة إرسال رابط التوثيق', verifiedLabel: 'حالة البريد',
    }
  : {
      loading: 'Preparing your account…', eyebrow: 'My account', title: 'Your Irab space',
      intro: 'Track progress, open your tools, and manage your plan and preferences in one place.',
      memberSince: 'Member since', activity: 'Progress overview', activityBody: 'Activity saved on this device',
      statAnalyses: 'Analyses', statPractice: 'Practice', statStreak: 'Day streak', statBest: 'Best score',
      noActivityTitle: 'Start your first journey', noActivity: 'Analyze a sentence or complete a practice session, and your progress appears here.', startNow: 'Open learning dashboard',
      plan: 'Your subscription', planChecking: 'Checking…', upgrade: 'Upgrade to Irab Plus',
      planHint: 'Current plan', explore: 'Quick access', exploreBody: 'Everything you need, one click away',
      openApp: 'Learning dashboard', appDesc: 'Your tools and daily progress', history: 'My history', historyDesc: 'Previous analyses and practice',
      dictionary: 'Smart dictionary', dictionaryDesc: 'Meaning, root, and word pattern', library: 'Library', libraryDesc: '47 works on Arabic studies',
      prefs: 'Preferences', prefsBody: 'Make Irab work your way', darkMode: 'Appearance', darkModeDesc: 'Switch between light and dark mode',
      language: 'Interface language', langValue: 'العربية', languageDesc: 'Change the language of your account',
      supportTitle: 'Account & help', help: 'Contact support', privacy: 'Privacy policy', terms: 'Terms & conditions',
      signOut: 'Sign out', resend: 'Resend verification link', verifiedLabel: 'Email status',
    };
---

<div data-account-root data-lang={lang} data-login={login} dir={dir} class="account-dashboard">
  <div data-loading class="account-loading" aria-busy="true" aria-label={t.loading}>
    <div class="skeleton loading-hero"></div>
    <div class="loading-grid">
      <div class="skeleton loading-panel"></div>
      <div class="skeleton loading-panel"></div>
    </div>
  </div>

  <div data-panel class="hidden panel-in account-flow">
    <header class="account-heading">
      <div>
        <p class="account-kicker">{t.eyebrow}</p>
        <h1>{t.title}</h1>
        <p>{t.intro}</p>
      </div>
      <a href={appHref} class="heading-action">
        <span>{t.startNow}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={chev}/></svg>
      </a>
    </header>

    <section class="identity-card" aria-labelledby="account-name">
      <div class="identity-main">
        <div data-avatar class="account-avatar"></div>
        <div class="identity-copy">
          <span class="identity-label">{t.eyebrow}</span>
          <h2 id="account-name" data-name></h2>
          <p data-email dir="ltr" class="account-email"></p>
          <div class="identity-meta">
            <span class="verification-item">
              <span class="status-dot" aria-hidden="true"></span>
              <span class="sr-only">{t.verifiedLabel}: </span>
              <span data-verify-badge></span>
            </span>
            <button type="button" data-resend class="resend-link hidden">{t.resend}</button>
            <span data-member class="member-date hidden"></span>
          </div>
        </div>
      </div>

      <div class="plan-summary">
        <div class="plan-topline">
          <span>{t.planHint}</span>
          <span data-plan-badge class="plan-state hidden"></span>
        </div>
        <p data-plan class="plan-name">{t.planChecking}</p>
        <p data-plan-note class="plan-note"></p>
        {/*
          Shown only on the free plan. A subscriber paid on one Google address,
          signed in later with a second address of his own, and read "Free plan"
          as proof the payment had failed. His email was already on this page and
          that was not enough: nothing connected the address to the plan he saw.
        */}
        <p data-plan-hint class="plan-hint hidden"></p>
        <button type="button" data-upgrade class="upgrade-action hidden">
          <span>{t.upgrade}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={chev}/></svg>
        </button>
      </div>
    </section>

    <section data-stats class="progress-section hidden" aria-labelledby="progress-title">
      <div class="section-heading">
        <h2 id="progress-title">{t.activity}</h2>
        <p>{t.activityBody}</p>
      </div>
      <div class="stats-grid">
        <div class="stat-card stat-purple"><span data-stat="analyze" class="stat-value">0</span><span>{t.statAnalyses}</span></div>
        <div class="stat-card stat-teal"><span data-stat="practice" class="stat-value">0</span><span>{t.statPractice}</span></div>
        <div class="stat-card"><span data-stat="streak" class="stat-value">0</span><span>{t.statStreak}</span></div>
        <div data-stat-best-wrap class="stat-card"><span data-stat="best" class="stat-value">—</span><span>{t.statBest}</span></div>
      </div>
    </section>

    <section data-empty class="empty-state hidden">
      <span class="empty-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="M5 8.5C6.5 7 9 7 12 9v8c-3-2-5.5-2-7-0.5z"/><path d="M19 8.5C17.5 7 15 7 12 9v8c3-2 5.5-2 7-0.5z"/></svg>
      </span>
      <div><h2>{t.noActivityTitle}</h2><p>{t.noActivity}</p></div>
      <a href={appHref} class="empty-action">{t.startNow}</a>
    </section>

    <div class="dashboard-columns">
      <section class="dashboard-panel access-panel" aria-labelledby="access-title">
        <div class="section-heading">
          <h2 id="access-title">{t.explore}</h2>
          <p>{t.exploreBody}</p>
        </div>
        <div class="access-grid">
          <a href={appHref} class="access-card access-primary">
            <span class="access-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg></span>
            <span class="access-copy"><strong>{t.openApp}</strong><small>{t.appDesc}</small></span>
            <svg class="access-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={chev}/></svg>
          </a>
          <a href={historyHref} class="access-card">
            <span class="access-icon access-icon-teal" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v5h5"/><path d="M3.05 13A9 9 0 1 0 6 5.3L3 8"/><path d="M12 7v5l4 2"/></svg></span>
            <span class="access-copy"><strong>{t.history}</strong><small>{t.historyDesc}</small></span>
            <svg class="access-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={chev}/></svg>
          </a>
          <a href={dictHref} class="access-card">
            <span class="access-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><path d="M9 7h7"/><path d="M9 11h5"/></svg></span>
            <span class="access-copy"><strong>{t.dictionary}</strong><small>{t.dictionaryDesc}</small></span>
            <svg class="access-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={chev}/></svg>
          </a>
          <a href={libraryHref} class="access-card">
            <span class="access-icon access-icon-teal" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6v15"/><path d="M5 4h4a3 3 0 0 1 3 3v14a3 3 0 0 0-3-3H5z"/><path d="M19 4h-4a3 3 0 0 0-3 3v14a3 3 0 0 1 3-3h4z"/></svg></span>
            <span class="access-copy"><strong>{t.library}</strong><small>{t.libraryDesc}</small></span>
            <svg class="access-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={chev}/></svg>
          </a>
        </div>
      </section>

      <aside class="account-sidebar">
        <section class="dashboard-panel preferences-panel" aria-labelledby="preferences-title">
          <div class="section-heading compact"><h2 id="preferences-title">{t.prefs}</h2></div>
          <p class="panel-intro">{t.prefsBody}</p>
          <div class="preference-list">
            <div class="preference-row">
              <span class="preference-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z"/></svg></span>
              <span class="preference-copy"><strong>{t.darkMode}</strong><small>{t.darkModeDesc}</small></span>
              <ThemeToggle />
            </div>
            <a href={altLangHref} class="preference-row preference-link">
              <span class="preference-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18"/><path d="M12 3a15 15 0 0 0 0 18"/></svg></span>
              <span class="preference-copy"><strong>{t.language}</strong><small>{t.languageDesc}</small></span>
              <span class="language-value">{t.langValue}</span>
            </a>
          </div>
        </section>

        <section class="dashboard-panel support-panel" aria-labelledby="support-title">
          <div class="section-heading compact"><h2 id="support-title">{t.supportTitle}</h2></div>
          <nav class="support-links" aria-label={t.supportTitle}>
            <a href={support}>{t.help}<svg viewBox="0 0 24 24" aria-hidden="true"><path d={chev}/></svg></a>
            <a href={privacyHref}>{t.privacy}<svg viewBox="0 0 24 24" aria-hidden="true"><path d={chev}/></svg></a>
            <a href={termsHref}>{t.terms}<svg viewBox="0 0 24 24" aria-hidden="true"><path d={chev}/></svg></a>
          </nav>
          <button type="button" data-signout class="signout-action">
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 17l5-5-5-5"/><path d="M15 12H3"/><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/></svg>
            <span>{t.signOut}</span>
          </button>
        </section>
      </aside>
    </div>
  </div>
</div>

<Paywall lang={lang} />

<style>
  .account-dashboard { width: 100%; max-width: 72rem; margin-inline: auto; font-family: var(--font-sans); }
  .account-dashboard .hidden { display: none !important; }
  .account-flow:not(.hidden) { display: grid; gap: 1.4rem; }
  .account-loading { display: grid; gap: 1rem; }
  .loading-hero { height: 17rem; border-radius: 1.4rem; }
  .loading-grid { display: grid; grid-template-columns: 1.5fr 0.8fr; gap: 1rem; }
  .loading-panel { height: 24rem; border-radius: 1.2rem; }

  .account-heading {
    display: flex; align-items: end; justify-content: space-between; gap: 2rem;
    padding: 0.9rem 0.35rem 1.15rem;
  }
  .account-kicker {
    color: var(--color-purple-deep); font-size: clamp(1.15rem, 2vw, 1.4rem); font-weight: 900; line-height: 1.55;
  }
  :global(.dark) .account-kicker { color: color-mix(in srgb, var(--color-purple) 78%, white); }
  .account-heading h1 {
    margin-top: 0.35rem; color: var(--color-ink); font-family: var(--font-sans); font-weight: 900;
    font-size: clamp(2.8rem, 5vw, 4.75rem); line-height: 1.18;
  }
  :global(.dark) .account-heading h1 { color: var(--color-mist); }
  .account-heading p:last-child {
    max-width: 44rem; margin-top: 0.9rem; color: var(--color-ink-muted); font-size: var(--text-small); line-height: 1.8;
  }
  :global(.dark) .account-heading p:last-child { color: var(--color-mist-muted); }
  .heading-action {
    min-height: 3.4rem; flex: none; display: inline-flex; align-items: center; justify-content: center; gap: 0.7rem;
    border-radius: 0.85rem; padding: 0.8rem 1.1rem; color: white; background: var(--color-ink);
    border: 1px solid var(--color-ink); font-size: 1rem; font-weight: 900;
    box-shadow: 0 16px 30px -20px rgb(23 56 71 / 0.72);
    transition: transform .2s var(--ease-out-quart), background-color .2s, border-color .2s, box-shadow .2s;
  }
  :global(.dark) .heading-action { background: var(--color-purple); border-color: var(--color-purple); }
  .heading-action:hover { transform: translateY(-2px); background: var(--color-purple); border-color: var(--color-purple); box-shadow: var(--lift-shadow); }
  .heading-action svg { width: 1.1rem; height: 1.1rem; }

  .identity-card, .dashboard-panel, .progress-section, .empty-state {
    background: var(--color-card); border: 1px solid var(--color-card-edge); box-shadow: var(--shadow-card);
  }
  :global(.dark) .identity-card, :global(.dark) .dashboard-panel,
  :global(.dark) .progress-section, :global(.dark) .empty-state {
    background: var(--color-coal-soft); border-color: var(--color-coal-edge);
  }
  .identity-card {
    position: relative; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(20rem, 0.7fr);
    min-height: 15.5rem; border-radius: 1.35rem;
  }
  .identity-card::before { content: ''; position: absolute; inset-inline-start: 0; top: 0; bottom: 0; width: 0.38rem; background: var(--color-purple); }
  .identity-main { display: flex; align-items: center; gap: 1.65rem; padding: clamp(1.8rem, 3.4vw, 2.75rem); min-width: 0; }
  .account-avatar {
    width: clamp(5rem, 9vw, 7rem); height: clamp(5rem, 9vw, 7rem); border-radius: 1.5rem; flex: none;
    overflow: hidden; display: grid; place-items: center; background: var(--color-purple); background-size: cover; background-position: center;
    color: white; font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 900;
    border: 5px solid color-mix(in srgb, var(--color-purple) 12%, white);
    box-shadow: 0 18px 34px -20px color-mix(in srgb, var(--color-purple) 75%, transparent);
  }
  :global(.dark) .account-avatar { border-color: color-mix(in srgb, var(--color-purple) 26%, var(--color-coal-soft)); }
  .account-avatar.has-photo { background-image: var(--photo); }
  .identity-copy { min-width: 0; }
  .identity-label { color: var(--color-ink-subtle); font-size: 1rem; font-weight: 900; line-height: 1.6; }
  :global(.dark) .identity-label { color: var(--color-mist-subtle); }
  .identity-copy h2 {
    margin-top: 0.08rem; overflow: hidden; color: var(--color-ink); font-family: var(--font-sans); font-size: clamp(2rem, 4vw, 3.25rem); font-weight: 900;
    line-height: 1.25; text-overflow: ellipsis; white-space: nowrap;
  }
  :global(.dark) .identity-copy h2 { color: var(--color-mist); }
  .account-email { margin-top: 0.45rem; overflow: hidden; color: var(--color-ink-muted); font-size: 1rem; line-height: 1.6; text-overflow: ellipsis; white-space: nowrap; }
  :global(.dark) .account-email { color: var(--color-mist-muted); }
  .identity-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 0.7rem 1rem; margin-top: 1.25rem; }
  .verification-item, .member-date {
    display: inline-flex; align-items: center; gap: 0.45rem; color: var(--color-ink-muted); font-size: 0.9rem; font-weight: 800;
  }
  :global(.dark) .verification-item, :global(.dark) .member-date { color: var(--color-mist-muted); }
  .status-dot { width: 0.55rem; height: 0.55rem; border-radius: 999px; background: var(--color-teal); box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-teal) 14%, transparent); }
  .resend-link { color: var(--color-purple-deep); font-size: 0.9rem; font-weight: 900; }
  :global(.dark) .resend-link { color: color-mix(in srgb, var(--color-purple) 78%, white); }

  .plan-summary {
    display: flex; flex-direction: column; justify-content: center; padding: clamp(1.75rem, 3.2vw, 2.4rem);
    color: white; background: var(--color-ink); border-inline-start: 1px solid var(--color-card-edge);
  }
  :global(.dark) .plan-summary { background: color-mix(in srgb, var(--color-purple-deep) 34%, var(--color-coal)); border-color: var(--color-coal-edge); }
  .plan-topline { display: flex; align-items: center; justify-content: space-between; gap: 1rem; color: rgb(255 255 255 / 0.7); font-size: 0.88rem; font-weight: 900; }
  .plan-state { border-radius: 999px; padding: 0.28rem 0.65rem; color: white; background: var(--color-teal); font-size: 0.78rem; }
  .plan-name { margin-top: 0.5rem; font-family: var(--font-sans); font-size: clamp(2rem, 3vw, 2.75rem); font-weight: 900; line-height: 1.12; }
  .plan-note { margin-top: 0.9rem; color: rgb(255 255 255 / 0.8); font-size: 0.98rem; line-height: 1.75; }
  .plan-hint {
    margin-top: 0.8rem; padding-top: 0.8rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
    color: rgb(255 255 255 / 0.62); font-size: 0.86rem; line-height: 1.65;
  }
  .upgrade-action {
    width: 100%; min-height: 3.2rem; margin-top: 1.15rem; display: flex; align-items: center; justify-content: space-between; gap: 0.7rem;
    border-radius: 0.75rem; padding: 0.72rem 0.9rem; color: white; background: var(--color-purple); border: 1px solid color-mix(in srgb, white 18%, var(--color-purple));
    font-size: 0.94rem; font-weight: 900; transition: transform .2s var(--ease-out-quart), box-shadow .2s, background-color .2s;
  }
  .upgrade-action:hover { transform: translateY(-2px); background: var(--color-purple-deep); box-shadow: 0 18px 34px -22px var(--color-purple); }
  .upgrade-action svg { width: 1rem; height: 1rem; }

  .progress-section, .dashboard-panel { border-radius: 1.15rem; padding: clamp(1.45rem, 2.7vw, 1.9rem); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; margin-bottom: 1.35rem; }
  .section-heading h2 { color: var(--color-ink); font-family: var(--font-sans); font-size: clamp(1.85rem, 2.8vw, 2.35rem); font-weight: 900; line-height: 1.2; }
  :global(.dark) .section-heading h2 { color: var(--color-mist); }
  .section-heading > p, .panel-intro { color: var(--color-ink-subtle); font-size: 0.96rem; line-height: 1.7; }
  :global(.dark) .section-heading > p, :global(.dark) .panel-intro { color: var(--color-mist-subtle); }
  .section-heading.compact { margin-bottom: 0.55rem; }
  .stats-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border: 1px solid var(--color-card-edge); border-radius: 0.9rem; overflow: hidden; }
  :global(.dark) .stats-grid { border-color: var(--color-coal-edge); }
  .stat-card { min-height: 6.5rem; display: grid; align-content: center; gap: 0.25rem; padding: 1rem 1.15rem; color: var(--color-ink-subtle); font-size: 0.9rem; font-weight: 800; }
  .stat-card + .stat-card { border-inline-start: 1px solid var(--color-card-edge); }
  :global(.dark) .stat-card { color: var(--color-mist-subtle); }
  :global(.dark) .stat-card + .stat-card { border-color: var(--color-coal-edge); }
