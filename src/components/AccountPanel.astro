  :global(.dark) .access-icon-teal { color: color-mix(in srgb, var(--color-teal) 74%, white); background: color-mix(in srgb, var(--color-teal) 20%, var(--color-coal)); }
  :global(.dark) .access-primary .access-icon { color: white; background: rgb(255 255 255 / 0.13); }
  .access-icon svg { width: 1.35rem; height: 1.35rem; }
  .access-copy { min-width: 0; display: grid; gap: 0.2rem; }
  .access-copy strong { font-size: 1.08rem; font-weight: 900; line-height: 1.5; }
  .access-copy small { overflow: hidden; color: var(--color-ink-subtle); font-size: 0.86rem; line-height: 1.6; text-overflow: ellipsis; white-space: nowrap; }
  .access-primary small { color: rgb(255 255 255 / 0.7); }
  :global(.dark) .access-copy small { color: var(--color-mist-subtle); }
  :global(.dark) .access-primary small { color: rgb(255 255 255 / 0.72); }
  .access-arrow { width: 1rem; height: 1rem; color: var(--color-ink-subtle); }
  .access-primary .access-arrow { color: white; }
  :global(.dark) .access-arrow { color: var(--color-mist-subtle); }

  .account-sidebar { display: grid; gap: 1.4rem; }
  .panel-intro { margin-bottom: 1.15rem; }
  .preference-list { display: grid; border-top: 1px solid var(--color-card-edge); }
  :global(.dark) .preference-list { border-color: var(--color-coal-edge); }
  .preference-row { min-height: 5.2rem; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 0.9rem; padding: 0.9rem 0; }
  .preference-row + .preference-row { border-top: 1px solid var(--color-card-edge); }
  :global(.dark) .preference-row + .preference-row { border-color: var(--color-coal-edge); }
  .preference-icon { width: 2.2rem; height: 2.2rem; display: grid; place-items: center; border-radius: 0.65rem; color: var(--color-teal); background: color-mix(in srgb, var(--color-teal) 10%, white); }
  :global(.dark) .preference-icon { color: color-mix(in srgb, var(--color-teal) 72%, white); background: color-mix(in srgb, var(--color-teal) 18%, var(--color-coal)); }
  .preference-icon svg { width: 1.1rem; height: 1.1rem; }
  .preference-copy { min-width: 0; display: grid; gap: 0.15rem; }
  .preference-copy strong { color: var(--color-ink); font-size: 1rem; font-weight: 900; line-height: 1.5; }
  :global(.dark) .preference-copy strong { color: var(--color-mist); }
  .preference-copy small { color: var(--color-ink-subtle); font-size: 0.8rem; line-height: 1.6; }
  :global(.dark) .preference-copy small { color: var(--color-mist-subtle); }
  .preference-link { transition: color .18s; }
  .preference-link:hover .preference-copy strong { color: var(--color-purple-deep); }
  :global(.dark) .preference-link:hover .preference-copy strong { color: color-mix(in srgb, var(--color-purple) 78%, white); }
  .language-value { color: var(--color-purple-deep); font-size: 0.86rem; font-weight: 900; }
  :global(.dark) .language-value { color: color-mix(in srgb, var(--color-purple) 78%, white); }

  .support-links { display: grid; margin-top: 0.8rem; border-block: 1px solid var(--color-card-edge); }
  :global(.dark) .support-links { border-color: var(--color-coal-edge); }
  .support-links a { min-height: 3rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; color: var(--color-ink-muted); font-size: 0.88rem; font-weight: 800; }
  :global(.dark) .support-links a { color: var(--color-mist-muted); }
  .support-links a + a { border-top: 1px solid var(--color-card-edge); }
  :global(.dark) .support-links a + a { border-color: var(--color-coal-edge); }
  .support-links a:hover { color: var(--color-purple-deep); }
  :global(.dark) .support-links a:hover { color: color-mix(in srgb, var(--color-purple) 78%, white); }
  .support-links svg { width: 0.95rem; height: 0.95rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .signout-action { width: 100%; min-height: 3.1rem; margin-top: 0.8rem; display: flex; align-items: center; justify-content: center; gap: 0.55rem; border-radius: 0.7rem; color: #b42318; background: color-mix(in srgb, #b42318 7%, white); border: 1px solid color-mix(in srgb, #b42318 16%, var(--color-card-edge)); font-size: 0.9rem; font-weight: 900; transition: background-color .18s, border-color .18s; }
  :global(.dark) .signout-action { color: #fda29b; background: color-mix(in srgb, #b42318 17%, var(--color-coal)); border-color: color-mix(in srgb, #b42318 34%, var(--color-coal-edge)); }
  .signout-action:hover { background: color-mix(in srgb, #b42318 12%, white); border-color: color-mix(in srgb, #b42318 30%, var(--color-card-edge)); }
  .signout-action svg { width: 1.05rem; height: 1.05rem; }

  .account-dashboard :where(a, button):focus-visible { outline: 3px solid color-mix(in srgb, var(--color-purple) 60%, transparent); outline-offset: 3px; }

  @media (max-width: 960px) {
    .identity-card, .dashboard-columns { grid-template-columns: 1fr; }
    .plan-summary { border-inline-start: 0; border-top: 1px solid var(--color-card-edge); }
    .loading-grid { grid-template-columns: 1fr; }
    .account-sidebar { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 700px) {
    .account-heading { align-items: stretch; flex-direction: column; gap: 1rem; }
    .heading-action { width: 100%; }
    .identity-main { align-items: flex-start; }
    .identity-copy h2 { white-space: normal; }
    .stats-grid, .access-grid { grid-template-columns: 1fr 1fr; }
    .stat-card:nth-child(3) { border-inline-start: 0; border-top: 1px solid var(--color-card-edge); }
    .stat-card:nth-child(4) { border-top: 1px solid var(--color-card-edge); }
    :global(.dark) .stat-card:nth-child(3), :global(.dark) .stat-card:nth-child(4) { border-top-color: var(--color-coal-edge); }
    .account-sidebar { grid-template-columns: 1fr; }
    .section-heading { align-items: flex-start; flex-direction: column; gap: 0.25rem; }
    .empty-state { grid-template-columns: auto 1fr; }
    .empty-action { grid-column: 1 / -1; text-align: center; }
  }
  @media (max-width: 480px) {
    .identity-main { flex-direction: column; }
    .account-avatar { width: 4.6rem; height: 4.6rem; border-radius: 1.15rem; }
    .access-grid { grid-template-columns: 1fr; }
    .access-card { min-height: 5.7rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .heading-action:hover, .upgrade-action:hover, .access-card:hover { transform: none; }
  }
</style>

<script>
  import { onAuth, logout, resendVerification } from '../lib/auth';
  import { fetchMe } from '../lib/entitlement';
  import { rememberSignedIn, forgetSignedIn } from '../lib/session';
  import { getStats } from '../lib/history';

  const root = document.querySelector<HTMLElement>('[data-account-root]');
  if (root) {
    const lang = root.dataset.lang === 'en' ? 'en' : 'ar';
    const login = root.dataset.login || '/login';
    const q = <T extends Element>(selector: string) => root.querySelector<T>(selector)!;
    const loading = q<HTMLElement>('[data-loading]');
    const panel = q<HTMLElement>('[data-panel]');
    const sentMsg = lang === 'ar' ? 'أُرسل رابط التوثيق إلى بريدك ✓' : 'Verification link sent ✓';
    const verifyText = lang === 'ar'
      ? { yes: 'البريد موثّق', no: 'البريد غير موثّق' }
      : { yes: 'Email verified', no: 'Email not verified' };
    const planText = lang === 'ar'
      ? { free: 'الخطة المجانية', plus: 'إعراب بلس',
          noteFree: 'لديك ٣ تحليلات يوميًّا. يفتح إعراب بلس التحليل غير المحدود وجميع مستويات التحديات ومزايا إضافية في التطبيق.',
          notePlus: 'اشتراكك مفعّل على جميع أجهزتك: الويب والتطبيق.',
          hintFree: 'اشتركت من قبل ولا يظهر اشتراكك؟ تأكّد أنك داخل بالحساب نفسه الذي دفعت به. أنت الآن داخل بحساب @email' }
      : { free: 'Free plan', plus: 'Irab Plus',
          noteFree: 'You get 3 analyses a day. Irab Plus unlocks unlimited i\'rab, every challenge level, and additional app features.',
          notePlus: 'Your subscription is active on all your devices: web and mobile.',
          hintFree: 'Already subscribed but not seeing it here? Check that you are signed in with the address you paid with. You are currently signed in as @email' };
    const memberSince = lang === 'ar' ? 'عضو منذ' : 'Member since';

    onAuth((user) => {
      if (!user) { forgetSignedIn(); window.location.replace(login); return; }
      rememberSignedIn();
      loading.classList.add('hidden');
      panel.classList.remove('hidden');

      const name = user.displayName || (user.email ? user.email.split('@')[0] : (lang === 'ar' ? 'مستخدم' : 'User'));
      q<HTMLElement>('[data-name]').textContent = name;
      q<HTMLElement>('[data-email]').textContent = user.email || '';

      const avatar = q<HTMLElement>('[data-avatar]');
      if (user.photoURL) {
        avatar.classList.add('has-photo');
        avatar.style.setProperty('--photo', `url("${user.photoURL}")`);
      } else {
        avatar.textContent = (Array.from(name.trim())[0] || '?').toUpperCase();
      }

      const created = user.metadata?.creationTime;
      if (created) {
        try {
          const date = new Date(created);
          const formatter = new Intl.DateTimeFormat(lang === 'ar' ? 'ar' : 'en', { month: 'long', year: 'numeric' });
          const member = q<HTMLElement>('[data-member]');
          member.textContent = `${memberSince} ${formatter.format(date)}`;
          member.classList.remove('hidden');
        } catch {}
      }

      const verifyBadge = q<HTMLElement>('[data-verify-badge]');
      const resend = q<HTMLButtonElement>('[data-resend]');
      if (user.emailVerified) {
        verifyBadge.textContent = verifyText.yes;
      } else {
        verifyBadge.textContent = verifyText.no;
        root.querySelector<HTMLElement>('.status-dot')?.style.setProperty('background', '#c48320');
        resend.classList.remove('hidden');
        resend.addEventListener('click', async () => {
          try { await resendVerification(user); resend.textContent = sentMsg; resend.disabled = true; } catch {}
        }, { once: true });
      }

      try {
        const stats = getStats(user.uid);
        if (stats.total > 0) {
          q<HTMLElement>('[data-stat="analyze"]').textContent = String(stats.analyzeCount);
          q<HTMLElement>('[data-stat="practice"]').textContent = String(stats.practiceCount);
          q<HTMLElement>('[data-stat="streak"]').textContent = String(stats.streak);
          const bestWrap = q<HTMLElement>('[data-stat-best-wrap]');
          if (stats.bestScore != null) q<HTMLElement>('[data-stat="best"]').textContent = `${stats.bestScore}%`;
          else bestWrap.classList.add('hidden');
          q<HTMLElement>('[data-stats]').classList.remove('hidden');
        } else {
          q<HTMLElement>('[data-empty]').classList.remove('hidden');
        }
      } catch {}

      const planEl = q<HTMLElement>('[data-plan]');
      const planBadge = q<HTMLElement>('[data-plan-badge]');
      const planNote = q<HTMLElement>('[data-plan-note]');
      const planHint = q<HTMLElement>('[data-plan-hint]');
      const upgrade = q<HTMLButtonElement>('[data-upgrade]');
      fetchMe(user).then((me) => {
        const premium = me?.premium === true;
        planEl.textContent = premium ? planText.plus : planText.free;
        planNote.textContent = premium ? planText.notePlus : planText.noteFree;
        if (premium) {
          planBadge.textContent = lang === 'ar' ? 'مفعّل' : 'Active';
          planBadge.classList.remove('hidden');
        } else {
          if (user.email) {
            planHint.textContent = planText.hintFree.replace('@email', user.email);
            planHint.classList.remove('hidden');
          }
          upgrade.classList.remove('hidden');
          upgrade.addEventListener('click', () => {
            const paywall = (window as any).IrabPaywall;
            if (paywall) paywall.show({ uid: user.uid, email: user.email || undefined });
            else window.location.href = '/pricing';
          });
        }
      }).catch(() => {
        // The lookup failed, so this "Free plan" may be wrong. That is exactly
        // when a paying subscriber needs the account hint most.
        planEl.textContent = planText.free;
        planNote.textContent = planText.noteFree;
        if (user.email) {
          planHint.textContent = planText.hintFree.replace('@email', user.email);
          planHint.classList.remove('hidden');
        }
        upgrade.classList.remove('hidden');
      });
    });

    q<HTMLButtonElement>('[data-signout]').addEventListener('click', async () => {
      await logout();
      forgetSignedIn();
      window.location.assign(login);
    });
  }
</script>
