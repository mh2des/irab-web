  }
  .profile-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--color-teal);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-teal) 14%, transparent);
  }
  .profile-side {
    display: grid;
    align-content: space-between;
    gap: 1rem;
  }
  .profile-plan-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
  }
  .profile-side-label {
    color: color-mix(in srgb, var(--color-ink) 62%, transparent);
    font-size: var(--text-caption);
    font-weight: 800;
  }
  :global(.dark) .profile-side-label { color: color-mix(in srgb, var(--color-mist) 68%, transparent); }
  .profile-ready {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    border-radius: 0.55rem;
