---
/**
 * AppHub: the signed-in account hub for /app and /en/app, in the tools'
 * design (irab-ui): the profile card with plan and progress, the tools with
 * today's allowance, Irab+ for a free account (Paddle checkout and the
 * activation wait), and recent activity. Firebase loads lazily only after the
 * local signed-in hint passes. Words: lib/hub/strings.ts.
 */
import '../styles/irab-ui.css';
import { PADDLE_ENABLED } from '../lib/paddle';
import { HUB } from '../lib/hub/strings';
import { BOOKS } from '../lib/library';
import { digits } from '../lib/irab/strings';
import * as I from '../lib/irab/icons';

interface Props { lang?: 'ar' | 'en'; }
const { lang = 'ar' } = Astro.props;
const s = HUB[lang];
const en = lang === 'en';
const p = (path: string) => (en ? `/en${path}` : path);
const login = p('/login');
const home = en ? '/en' : '/';
const dir = en ? 'ltr' : 'rtl';
const chev = I.chevronLeft.replace('<svg', '<svg class="flip-ltr"');

const svg = (body: string) => `<svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${body}</svg>`;
const ic = {
  analyzer: svg('<path d="M4 6h16"/><path d="M4 12h10"/><path d="M4 18h7"/><path d="m16 16 2 2 4-5"/>'),
  practice: I.pencil,
  challenges: svg('<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><path d="m9 8 1.5 1.5L14 6"/><path d="M9 14h7"/>'),
  dictionary: svg('<circle cx="11" cy="11" r="8"/><path d="m21 21-4.34-4.34"/>'),
  majalis: svg('<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>'),
  quran: I.book,
  lessons: I.graduationCap,
  library: svg('<path d="m16 6 4 14"/><path d="M12 6v14"/><path d="M8 8v12"/><path d="M4 4v16"/>'),
  user: svg('<path d="M20 21a8 8 0 0 0-16 0"/><circle cx="12" cy="8" r="4"/>'),
  logOut: svg('<path d="m16 17 5-5-5-5"/><path d="M21 12H9"/><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>'),
  lock: svg('<rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>'),
};

const books = digits(BOOKS.length, lang);
const tools = en
  ? [
      { key: 'analyzer', title: "I'rab analyzer", desc: "Full word by word i'rab for Arabic sentences, with the marker and why.", href: '/en/tool', usage: 'irabAnalysis', tone: 'primary' },
      { key: 'practice', title: 'Parse it yourself', desc: 'Write a sentence, parse its words yourself, and the teacher checks each answer.', href: '/en/practice/play', usage: 'customPractice', tone: 'teal' },
      { key: 'challenges', title: 'Challenges', desc: "Choose a ready-made sentence, then set each word's type, role, and case marker.", href: '/en/challenges', usage: '', tone: 'primary' },
      { key: 'dictionary', title: 'Dictionary', desc: "Meaning, root, pattern, morphology and i'rab for any Arabic word.", href: '/en/dictionary', usage: 'smartDictionary', tone: 'teal' },
      { key: 'majalis', title: "Majalis: live i'rab quizzes", desc: 'Host a live grammar competition: manual or AI questions, a join PIN, and a full report.', href: '/majlis/host', usage: '', tone: 'primary' },
      { key: 'quran', title: "Quran i'rab", desc: "Browse structured i'rab pages for Quranic verses.", href: '/en/quran', usage: '', tone: 'teal' },
      { key: 'lessons', title: 'Grammar lessons', desc: "Short lessons on the rules of i'rab, chapter by chapter.", href: '/en/duroos', usage: '', tone: 'primary' },
      { key: 'library', title: 'Grammar library', desc: `${books} works on nahw, sarf, and balagha: read in full.`, href: '/en/library', usage: '', tone: 'teal' },
    ]
  : [
      { key: 'analyzer', title: 'محلّل الإعراب', desc: 'إعراب كامل للجمل العربية كلمة بكلمة، مع العلامة والسبب.', href: '/tool', usage: 'irabAnalysis', tone: 'primary' },
      { key: 'practice', title: 'أعرب بنفسك', desc: 'اكتب جملة، ثم أعرب كلماتها بنفسك، ويقيّم الأستاذ إجابتك كلمة كلمة.', href: '/practice/play', usage: 'customPractice', tone: 'teal' },
      { key: 'challenges', title: 'التحديات', desc: 'اختر من الجمل الجاهزة، ثم حدّد نوع كل كلمة وموقعها وعلامتها.', href: '/challenges', usage: '', tone: 'primary' },
      { key: 'dictionary', title: 'المعجم', desc: 'معنى الكلمة وجذرها ووزنها وصرفها وكيف تُعرب.', href: '/dictionary', usage: 'smartDictionary', tone: 'teal' },
      { key: 'majalis', title: 'مجالس الإعراب', desc: 'استضف مسابقة إعراب مباشرة: أسئلة يدوية أو بالذكاء الاصطناعي، رمز دخول، وتقرير كامل.', href: '/majlis/host', usage: '', tone: 'primary' },
      { key: 'quran', title: 'إعراب القرآن', desc: 'مكتبة منظمة لإعراب الآيات، مناسبة للمراجعة والدراسة.', href: '/quran', usage: '', tone: 'teal' },
      { key: 'lessons', title: 'دروس النحو', desc: 'دروس قصيرة في قواعد الإعراب، بابًا بابًا.', href: '/duroos', usage: '', tone: 'primary' },
      { key: 'library', title: 'المكتبة النحوية', desc: `${books} كتابًا في النحو والصرف والبلاغة، تُقرأ كاملةً.`, href: '/library', usage: '', tone: 'teal' },
    ];
---

<div class="iu iu-hub" data-hub-root data-lang={lang} data-login={login} data-home={home} dir={dir} lang={lang}>
  <div data-hub-loading aria-busy="true" aria-label={s.loading} class="hb-loading">
    <div class="iu-card az-skel" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="hb-tools" aria-hidden="true">
      {[0, 1, 2, 3].map(() => <div class="iu-card az-skel"><span></span><span></span><span></span></div>)}
    </div>
  </div>

  <section data-hub-gate class="hidden">
    <div class="iu-card hb-gate">
      <span class="hb-gate-icon"><Fragment set:html={ic.lock} /></span>
      <h1 class="t-display c-1">{s.gateTitle}</h1>
      <p class="t-body c-2">{s.gateBody}</p>
      <a href={`${login}?next=${encodeURIComponent(p('/app'))}`} data-hub-gate-signin class="iu-btn teal lg">{s.signIn}</a>
    </div>
  </section>

  <div data-hub class="hidden hb-body">
    <section class="iu-card hb-profile" aria-label={s.statsLabel}>
      <div class="hb-identity">
        <div class="hb-avatar" data-hub-avatar aria-hidden="true">{en ? 'I' : 'إ'}</div>
        <div class="hb-who">
          <h1 class="t-title-l c-1 hb-name" data-hub-name></h1>
          <p class="t-caption c-3 hb-email" data-hub-email dir="ltr"></p>
        </div>
        <span data-hub-plan class="iu-tag missing hb-plan">{s.planFree}</span>
      </div>
      <p data-plan-note class="t-body-s c-2 hb-note">{s.freeNote}</p>
      <div class="hb-stats">
        <div><span class="hb-stat" data-stat="analyze">{digits(0, lang)}</span><span class="t-caption c-3">{s.statAnalyzed}</span></div>
        <div><span class="hb-stat" data-stat="practice">{digits(0, lang)}</span><span class="t-caption c-3">{s.statPracticed}</span></div>
        <div><span class="hb-stat" data-stat="avg">-</span><span class="t-caption c-3">{s.statAvg}</span></div>
        <div><span class="hb-stat" data-stat="streak">{digits(0, lang)}</span><span class="t-caption c-3">{s.statStreak}</span></div>
      </div>
      <div class="hb-links">
        <a href={p('/history')} class="iu-pill quiet"><Fragment set:html={I.history} /><span>{s.history}</span></a>
        <a href={p('/account')} class="iu-pill quiet"><Fragment set:html={ic.user} /><span>{s.manage}</span></a>
        <button type="button" data-hub-signout class="iu-pill quiet hb-signout"><Fragment set:html={ic.logOut} /><span>{s.signOut}</span></button>
      </div>
    </section>

    <div data-hub-activating class="hidden iu-card hb-activating" aria-live="polite"
         data-s-slow={s.activatingSlow} data-s-timeout-title={s.timeoutTitle} data-s-timeout-body={s.timeoutBody}>
      <span class="hb-act-icon"><Fragment set:html={I.check} /></span>
      <div>
        <p data-hub-act-title class="t-body-strong c-1">{s.activatingTitle}</p>
        <p data-hub-act-body class="t-body-s c-2">{s.activatingBody}</p>
        <button type="button" data-hub-refresh class="hidden iu-btn secondary hb-refresh"><Fragment set:html={I.refresh} />{s.refresh}</button>
      </div>
    </div>

    <section>
      <h2 class="t-title c-1 hb-h2">{s.tools}</h2>
      <div class="hb-tools" data-hub-tools>
        {tools.map((tool) => (
          <a href={tool.href} data-usage-key={tool.usage || undefined} class:list={['iu-card', 'hb-tool', `hb-${tool.tone}`]}>
            <span class="hb-tool-icon" aria-hidden="true"><Fragment set:html={ic[tool.key as keyof typeof ic]} /></span>
            <span class="hb-tool-text">
              <span class="t-card-title c-1">{tool.title}</span>
              <span class="t-caption c-2">{tool.desc}</span>
              {tool.usage && <span data-usage class="t-micro hb-usage"></span>}
            </span>
            <Fragment set:html={chev} />
          </a>
        ))}
      </div>
    </section>

    <section data-hub-upgrade class="hidden iu-card hb-upgrade">
      <div class="hb-upgrade-head">
        <span class="hb-upgrade-icon" aria-hidden="true"><Fragment set:html={I.crown} /></span>
        <div>
          <h2 class="t-title c-1">{s.upgradeTitle}</h2>
          <p class="t-body-s c-2">{s.upgradeBody}</p>
        </div>
      </div>
      <ul class="hb-benefits">
        {s.benefits.map((b) => <li class="t-body-s c-1"><Fragment set:html={I.checkCircle} /><span>{b}</span></li>)}
      </ul>
      {PADDLE_ENABLED ? (
        <div class="hb-plans">
          <button type="button" data-paddle-plan="annual" class="iu-btn primary lg hb-plan-btn">
            <span>{s.annualCta}</span><small>{s.annualMeta}</small>
          </button>
          <button type="button" data-paddle-plan="monthly" class="iu-btn secondary lg hb-plan-btn">
            <span>{s.monthlyCta}</span><small>{s.monthlyMeta}</small>
          </button>
          <p data-hub-pay-error class="hidden t-body-s c-error hb-pay-error" role="alert">{s.checkoutError}</p>
        </div>
      ) : (
        <a href={`${home}#cta`} class="iu-btn primary lg">{s.getApp}</a>
      )}
    </section>

    <section data-hub-recent class="hidden">
      <div class="hb-recent-head">
        <h2 class="t-title c-1 hb-h2">{s.recentTitle}</h2>
        <a href={p('/history')} data-recent-seeall class="iu-card-link">{s.seeAll}<Fragment set:html={chev} /></a>
      </div>
      <div data-recent-list class="hb-recent"></div>
    </section>
  </div>
</div>

<style is:global>
  .iu-hub { max-width: 960px; margin: 0 auto; padding: 0 0 40px; }
  /* The script shows and hides parts with the .hidden class; card layouts must not win over it. */
  .iu-hub .hidden { display: none !important; }
  .iu-hub .hb-loading, .iu-hub .hb-body { display: flex; flex-direction: column; gap: 26px; }
  .iu-hub .hb-h2 { margin: 0 0 12px; }

  .iu-hub .hb-gate { max-width: 560px; margin: 0 auto; padding: 26px 20px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; }
  .iu-hub .hb-gate .iu-btn { margin-top: 6px; }
  .iu-hub .hb-gate-icon { width: 60px; height: 60px; border-radius: 999px; display: grid; place-items: center; background: var(--iu-primary-soft); color: var(--iu-primary); }
  .iu-hub .hb-gate-icon svg { width: 28px; height: 28px; }

  /* Profile */
  .iu-hub .hb-profile { padding: 24px; }
  .iu-hub .hb-identity { display: flex; align-items: center; gap: 16px; }
  .iu-hub .hb-avatar {
    width: 66px; height: 66px; border-radius: 999px; display: grid; place-items: center; flex: none;
    background: var(--iu-primary-soft); color: var(--iu-primary-text); font-size: 28px; font-weight: 700;
  }
  .iu-hub .hb-who { flex: 1; min-width: 0; }
  .iu-hub .hb-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .iu-hub .hb-email { margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .iu-hub[dir='rtl'] .hb-email { text-align: right; }
  .iu-hub .hb-plan { flex: none; font-size: 14px; padding: 6px 14px; }
  .iu-hub .hb-plan svg { width: 16px; height: 16px; }
  .iu-hub .hb-note { margin: 14px 0 0; }
  .iu-hub .hb-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 16px; }
  .iu-hub .hb-stats > div { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 14px 6px; border-radius: 14px; background: var(--iu-sunken); text-align: center; }
  .iu-hub .hb-stat { font-size: 28px; font-weight: 700; line-height: 1.3; color: var(--iu-text); }
  @media (max-width: 520px) { .iu-hub .hb-stats { grid-template-columns: repeat(2, 1fr); } }
  .iu-hub .hb-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--iu-border); }
  .iu-hub .hb-links .iu-pill { text-decoration: none; }
  .iu-hub .hb-signout { margin-inline-start: auto; }
  @media (hover: hover) {
    .iu-hub .hb-links .iu-pill:hover { background: var(--iu-primary-soft); color: var(--iu-primary-text); }
    .iu-hub .hb-links .hb-signout:hover { background: var(--iu-error-soft); color: var(--iu-error-text); }
  }

  /* After a checkout: the wait for the subscription to arrive */
  .iu-hub .hb-activating { display: flex; align-items: flex-start; gap: 12px; padding: 16px 18px; background: var(--iu-success-soft); border-color: transparent; }
  .iu-hub .hb-activating p { margin: 0; }
  .iu-hub .hb-act-icon { width: 40px; height: 40px; border-radius: 999px; display: grid; place-items: center; flex: none; background: var(--iu-card); color: var(--iu-success); }
  .iu-hub .hb-act-icon svg { width: 21px; height: 21px; }
  .iu-hub .hb-refresh { margin-top: 10px; }

  /* Tools: cards as the challenge topics, lifting on hover */
  .iu-hub .hb-tools { display: grid; grid-template-columns: 1fr; gap: 14px; }
  @media (min-width: 640px) { .iu-hub .hb-tools { grid-template-columns: 1fr 1fr; } }
  .iu-hub .hb-tool {
    display: flex; align-items: center; gap: 14px; padding: 18px 20px; color: inherit; text-decoration: none;
    transition: border-color .2s ease, box-shadow .25s ease, transform .3s cubic-bezier(.22, 1, .36, 1);
  }
  .iu-hub .hb-tool:focus-visible { outline: 2px solid var(--iu-teal); outline-offset: 2px; }
  .iu-hub .hb-tool-icon { width: 54px; height: 54px; border-radius: 16px; display: grid; place-items: center; flex: none; transition: transform .3s cubic-bezier(.22, 1, .36, 1); }
  .iu-hub .hb-tool-icon svg { width: 25px; height: 25px; }
  .iu-hub .hb-primary .hb-tool-icon { background: var(--iu-primary-soft); color: var(--iu-primary); }
  .iu-hub .hb-teal .hb-tool-icon { background: var(--iu-teal-soft); color: var(--iu-teal); }
  .iu-hub .hb-tool-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .iu-hub .hb-usage { margin-top: 4px; color: var(--iu-teal-text); }
  .iu-hub .hb-usage:empty { display: none; }
  .iu-hub .hb-usage.is-out { color: var(--iu-error-text); }
  .iu-hub .hb-tool > svg { width: 19px; height: 19px; flex: none; color: var(--iu-text-3); transition: translate .3s cubic-bezier(.22, 1, .36, 1), color .2s ease; }
  @media (hover: hover) {
    .iu-hub .hb-tool:hover { transform: translateY(-3px); box-shadow: var(--iu-shadow-lift); }
    .iu-hub .hb-primary:hover { border-color: var(--iu-primary); }
    .iu-hub .hb-teal:hover { border-color: var(--iu-teal); }
    .iu-hub .hb-tool:hover .hb-tool-icon { transform: scale(1.06); }
    .iu-hub .hb-tool:hover > svg { translate: -3px 0; color: var(--iu-text-2); }
    .iu-hub[dir='ltr'] .hb-tool:hover > svg { translate: 3px 0; }
  }
  .iu-hub .hb-tool:active { transform: translateY(-1px) scale(.99); }

  /* Irab+ for a free account */
  .iu-hub .hb-upgrade { padding: 24px; background: color-mix(in srgb, var(--iu-primary) 5%, var(--iu-card)); border-color: color-mix(in srgb, var(--iu-primary) 20%, var(--iu-border)); }
  .iu-hub .hb-upgrade-head { display: flex; align-items: flex-start; gap: 12px; }
  .iu-hub .hb-upgrade-head p { margin: 2px 0 0; }
  .iu-hub .hb-upgrade-icon { width: 54px; height: 54px; border-radius: 16px; display: grid; place-items: center; flex: none; background: var(--iu-primary-soft); color: var(--iu-primary); }
  .iu-hub .hb-upgrade-icon svg { width: 26px; height: 26px; }
  .iu-hub .hb-benefits { list-style: none; margin: 14px 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .iu-hub .hb-benefits li { display: flex; align-items: center; gap: 10px; }
  .iu-hub .hb-benefits svg { width: 19px; height: 19px; flex: none; color: var(--iu-primary); }
  .iu-hub .hb-plans { display: grid; grid-template-columns: 1fr; gap: 10px; margin-top: 16px; }
  @media (min-width: 640px) { .iu-hub .hb-plans { grid-template-columns: 1fr 1fr; } }
  .iu-hub .hb-plan-btn { height: auto; min-height: 66px; padding: 10px 18px; flex-direction: column; gap: 2px; white-space: normal; }
  .iu-hub .hb-plan-btn small { font-size: 13.5px; font-weight: 500; opacity: .85; }
  .iu-hub .hb-pay-error { grid-column: 1 / -1; margin: 0; }

  /* Recent activity, as the challenge sentence cards */
  .iu-hub .hb-recent-head { display: flex; align-items: center; justify-content: space-between; }
  .iu-hub .hb-recent { display: flex; flex-direction: column; gap: 12px; }
  .iu-hub .hb-recent-item {
    display: flex; align-items: center; gap: 14px; padding: 16px 20px; color: inherit; text-decoration: none;
    transition: border-color .2s ease, box-shadow .25s ease, transform .3s cubic-bezier(.22, 1, .36, 1);
  }
  .iu-hub .hb-recent-icon { width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center; flex: none; }
  .iu-hub .hb-recent-icon svg { width: 21px; height: 21px; }
  .iu-hub .hb-recent-item.is-analyze .hb-recent-icon { background: var(--iu-primary-soft); color: var(--iu-primary); }
  .iu-hub .hb-recent-item.is-practice .hb-recent-icon { background: var(--iu-teal-soft); color: var(--iu-teal); }
  .iu-hub .hb-recent-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .iu-hub .hb-recent-main .t-sentence-s { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .iu-hub .hb-recent-time { flex: none; }
  @media (hover: hover) {
    .iu-hub .hb-recent-item:hover { transform: translateY(-2px); border-color: var(--iu-teal); box-shadow: var(--iu-shadow-lift); }
  }

  @media (prefers-reduced-motion: reduce) {
    .iu-hub :is(.hb-tool, .hb-tool-icon, .hb-recent-item) { transform: none !important; }
    .iu-hub .hb-tool > svg { translate: none !important; }
  }
</style>

<script>
  import { maybeSignedIn } from '../lib/session';
  import { getStats, getHistory } from '../lib/history';
  import { HUB } from '../lib/hub/strings';
  import { WORKER } from '../lib/irab/api';
  import { esc } from '../lib/irab/render';
  import { STRINGS, ago, digits } from '../lib/irab/strings';
  import { revealOnScroll } from '../lib/scroll-in';
  import * as I from '../lib/irab/icons';

  const root = document.querySelector<HTMLElement>('[data-hub-root]');
  if (root) {
    const lang = root.dataset.lang === 'en' ? 'en' : 'ar';
    const s = HUB[lang];
    const S = STRINGS[lang];
    const home = root.dataset.home || '/';
    const q = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const loadingEl = q<HTMLElement>('[data-hub-loading]');
    const gate = q<HTMLElement>('[data-hub-gate]');

    // ?checkout=annual|monthly: a plan CTA elsewhere on the site (homepage,
    // /pricing, nav Plus chip) sent the user here to complete checkout.
    // Signed-in free users get the overlay auto-opened; signed-out users keep
    // the intent through login via the gate link's ?next= param.
    const coRaw = new URLSearchParams(window.location.search).get('checkout');
    const checkoutIntent = coRaw === 'annual' || coRaw === 'monthly' ? coRaw : null;
    if (checkoutIntent) {
      const gateSignin = root.querySelector<HTMLAnchorElement>('[data-hub-gate-signin]');
      if (gateSignin) {
        const back = `${window.location.pathname}?checkout=${checkoutIntent}`;
        gateSignin.href = `${root.dataset.login || '/login'}?next=${encodeURIComponent(back)}`;
      }
    }
    const hub = q<HTMLElement>('[data-hub]');
    const nameEl = q<HTMLElement>('[data-hub-name]');
    const emailEl = q<HTMLElement>('[data-hub-email]');
    const avatarEl = q<HTMLElement>('[data-hub-avatar]');
    const planEl = q<HTMLElement>('[data-hub-plan]');
    const planNoteEl = q<HTMLElement>('[data-plan-note]');
    const upgradeEl = q<HTMLElement>('[data-hub-upgrade]');

    function setUsage(key: string, text: string, out = false) {
      const span = root!.querySelector<HTMLElement>(`[data-usage-key="${key}"] [data-usage]`);
      if (!span) return;
      span.textContent = text;
      span.classList.toggle('is-out', out);
    }
    const unlimitedAll = () => ['irabAnalysis', 'customPractice', 'smartDictionary'].forEach((k) => setUsage(k, s.unlimited));

    function renderStats(uid: string) {
      const stats = getStats(uid);
      const set = (k: string, v: string) => { const el = root!.querySelector<HTMLElement>(`[data-stat="${k}"]`); if (el) el.textContent = v; };
      set('analyze', digits(stats.analyzeCount, lang));
      set('practice', digits(stats.practiceCount, lang));
      set('avg', stats.avgScore == null ? '-' : lang === 'ar' ? `${digits(stats.avgScore, lang)}٪` : `${stats.avgScore}%`);
      set('streak', digits(stats.streak, lang));
    }

    function renderRecent(uid: string) {
      const section = root!.querySelector<HTMLElement>('[data-hub-recent]');
      const list = root!.querySelector<HTMLElement>('[data-recent-list]');
      if (!section || !list) return;
      section.classList.add('hidden');
      const items = getHistory(uid).slice(0, 5);
      if (!items.length) return;
      section.classList.remove('hidden');
      const toolBase = lang === 'ar' ? '/tool' : '/en/tool';
      const practiceBase = lang === 'ar' ? '/practice/play' : '/en/practice/play';
      const icA = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16"/><path d="M4 12h10"/><path d="M4 18h7"/><path d="m16 16 2 2 4-5"/></svg>';
      list.innerHTML = items.map((it) => {
        const isA = it.kind === 'analyze';
        const pct = (n: number) => (lang === 'ar' ? `${digits(Math.round(n * 100), lang)}٪` : `${Math.round(n * 100)}%`);
        const meta = isA
          ? (it.wordCount ? digits(S.words(it.wordCount), lang) : s.analysis)
          : (typeof it.score === 'number' ? `${pct(it.score)}${it.level ? ' · ' + it.level : ''}` : s.practice);
        const href = `${isA ? toolBase : practiceBase}?h=${encodeURIComponent(it.id)}`;
        return `
          <a class="iu-card hb-recent-item ${isA ? 'is-analyze' : 'is-practice'}" href="${href}">
            <span class="hb-recent-icon" aria-hidden="true">${isA ? icA : I.pencil}</span>
            <span class="hb-recent-main">
              <span class="t-sentence-s c-1" dir="rtl" lang="ar">${esc(it.sentence)}</span>
              <span class="t-caption c-3">${esc(meta)}</span>
            </span>
            <span class="t-caption c-3 hb-recent-time">${esc(digits(ago(it.ts, S), lang))}</span>
          </a>`;
      }).join('');
      revealOnScroll(list, '.hb-recent-item');
    }

    (async () => {
      if (!maybeSignedIn()) {
        loadingEl.classList.add('hidden');
        gate.classList.remove('hidden');
        return;
      }
      try {
        const [{ onAuth, logout }, { fetchMe }, { forgetSignedIn, rememberSignedIn }] =
          await Promise.all([import('../lib/auth'), import('../lib/entitlement'), import('../lib/session')]);

        q<HTMLButtonElement>('[data-hub-signout]').addEventListener('click', async () => {
          try { await logout(); } catch {}
          forgetSignedIn();
          window.location.assign(home);
        });

        onAuth(async (u) => {
          loadingEl.classList.add('hidden');
          if (!u) {
            forgetSignedIn();
            hub.classList.add('hidden');
            gate.classList.remove('hidden');
            return;
          }
          rememberSignedIn();
          gate.classList.add('hidden');
          hub.classList.remove('hidden');
          revealOnScroll(q('[data-hub-tools]'), '.hb-tool');

          const name = u.displayName || (u.email ? u.email.split('@')[0] : s.user);
          nameEl.textContent = name;
          emailEl.textContent = u.email || '';
          const initialSource = (u.displayName || u.email || s.user).trim();
          avatarEl.textContent = initialSource ? Array.from(initialSource)[0].toUpperCase() : (lang === 'ar' ? 'إ' : 'I');

          // Stats + recent activity from this account's saved history.
          try { renderStats(u.uid); renderRecent(u.uid); } catch {}

          let idToken: string | null = null;
          try { idToken = await u.getIdToken(); } catch {}

          let premium = false;
          try {
            const me = await fetchMe(u);
            premium = me?.premium === true;
          } catch {}

          if (premium) {
            if (checkoutIntent) window.history.replaceState(null, '', window.location.pathname);
            planEl.innerHTML = `${I.crown}${esc(s.planPlus)}`;
            planEl.className = 'iu-tag primary hb-plan';
            planNoteEl.textContent = s.plusNote;
            unlimitedAll();
          } else {
            planEl.textContent = s.planFree;
            planEl.className = 'iu-tag missing hb-plan';
            planNoteEl.textContent = s.freeNote;
            upgradeEl.classList.remove('hidden');

            const track = (e: string, p?: Record<string, string | number | boolean | null | undefined>) => import('../lib/analytics').then((m) => m.track(e, p)).catch(() => {});
            const payError = root!.querySelector<HTMLElement>('[data-hub-pay-error]');
            root!.querySelectorAll<HTMLButtonElement>('[data-paddle-plan]').forEach((btn) => {
              btn.addEventListener('click', async () => {
                const plan = btn.dataset.paddlePlan === 'monthly' ? 'monthly' : 'annual';
                track('purchase_initiated', { plan: plan === 'annual' ? 'yearly' : 'monthly', store: 'paddle', trigger: 'hub' });
                btn.disabled = true;
                payError?.classList.add('hidden');
                try {
                  const { openCheckout } = await import('../lib/paddle');
                  await openCheckout({
                    plan,
                    firebaseUid: u.uid,
                    email: u.email || undefined,
                    lang,
                    onComplete: async () => {
                      track('checkout_completed', { plan: plan === 'annual' ? 'yearly' : 'monthly', store: 'paddle', trigger: 'hub' });
                      // Webhook-driven entitlement: quick poll → "still
                      // activating" notice → patient poll. Reload only on a
                      // confirmed unlock; on timeout tell the truth and give
                      // a refresh button instead of reloading into "Free".
                      const act = q<HTMLElement>('[data-hub-activating]');
                      act.classList.remove('hidden');
                      upgradeEl.classList.add('hidden');
                      act.scrollIntoView({ behavior: 'smooth', block: 'center' });
                      const actBody = act.querySelector<HTMLElement>('[data-hub-act-body]');
                      let unlocked = false;
                      try {
                        const { waitForPremium } = await import('../lib/entitlement');
                        unlocked = await waitForPremium(u, {
                          onSlow: () => { if (actBody) actBody.textContent = act.dataset.sSlow || actBody.textContent; },
                        });
                      } catch {}
                      if (unlocked) { window.location.reload(); return; }
                      const actTitle = act.querySelector<HTMLElement>('[data-hub-act-title]');
                      const refreshBtn = act.querySelector<HTMLButtonElement>('[data-hub-refresh]');
                      if (actTitle) actTitle.textContent = act.dataset.sTimeoutTitle || actTitle.textContent;
                      if (actBody) actBody.textContent = act.dataset.sTimeoutBody || actBody.textContent;
                      refreshBtn?.classList.remove('hidden');
                      refreshBtn?.addEventListener('click', () => window.location.reload());
                    },
                  });
                } catch (e) {
                  console.error('paddle checkout failed', e);
                  payError?.classList.remove('hidden');
                } finally {
                  btn.disabled = false;
                }
              });
            });

            // Complete a checkout intent carried in from another page: open
            // the overlay for the requested plan, once (param is cleared so
            // a reload doesn't re-open it).
            if (checkoutIntent) {
              window.history.replaceState(null, '', window.location.pathname);
              upgradeEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
              root!.querySelector<HTMLButtonElement>(`[data-paddle-plan="${checkoutIntent}"]`)?.click();
            }
          }

          if (idToken) {
            try {
              const res = await fetch(`${WORKER}/api/usage`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${idToken}` },
                body: '{}',
              });
              if (res.ok) {
                const j = await res.json();
                const usage = j?.data?.usage || {};
                if (premium || j?.data?.isPremium === true) { unlimitedAll(); return; }
                for (const key of ['irabAnalysis', 'customPractice', 'smartDictionary']) {
                  const u2 = usage[key];
                  if (u2 && typeof u2.remaining === 'number' && u2.limit > 0) {
                    const left = Math.max(0, u2.remaining);
                    setUsage(key, left > 0 ? s.leftToday(digits(left, lang)) : s.noneLeft, left === 0);
                  }
                }
              }
            } catch {
              if (premium) unlimitedAll();
            }
          }
        });
      } catch {
        loadingEl.classList.add('hidden');
        gate.classList.remove('hidden');
      }
    })();
  }
</script>
