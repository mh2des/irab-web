    }
    .metric-item:nth-child(4) { border-top: 1px solid var(--color-card-edge); }
    :global(.dark) .metric-item:nth-child(3),
    :global(.dark) .metric-item:nth-child(4) { border-top-color: var(--color-coal-edge); }
    .command-actions { display: grid; grid-template-columns: 1fr; }
    .command-action { width: 100%; }
