---
/**
 * AppHub: signed in profile dashboard for /app and /en/app.
 *
 * This is intentionally a product surface, not a marketing section: plan state,
 * upgrade choice, daily usage, and tools are visible at a glance. Firebase still
 * loads lazily only after the local signed in hint passes.
 */
import { PADDLE_ENABLED } from '../lib/paddle';

interface Props { lang?: 'ar' | 'en'; }
const { lang = 'ar' } = Astro.props;
const login = lang === 'ar' ? '/login' : '/en/login';
const home = lang === 'ar' ? '/' : '/en';
const account = lang === 'ar' ? '/account' : '/en/account';
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const titleClass = lang === 'ar' ? 'font-arabic-display' : 'font-display';

const tools = lang === 'ar'
  ? [
      { key: 'analyzer', title: 'محلّل الإعراب', desc: 'إعراب كامل للجمل العربية كلمة بكلمة، مع العلامة والسبب.', href: '/tool', usageKey: '', accent: 'purple', cta: 'حلّل الآن' },
      { key: 'practice', title: 'التدريب بالتصحيح الذكي', desc: 'اكتب جملتك وإعرابك بنفسك، ثم احصل على تصحيح وشرح لكل كلمة.', href: '/practice/play', usageKey: 'customPractice', accent: 'teal', cta: 'ابدأ التدريب' },
      { key: 'challenges', title: 'التحديات', desc: 'اختر من الجمل الجاهزة، ثم حدّد نوع كل كلمة وموقعها وعلامتها.', href: '/challenges', usageKey: 'practiceMode', accent: 'purple', cta: 'ابدأ التحدي' },
      { key: 'dictionary', title: 'المعجم الذكي', desc: 'معنى الكلمة وجذرها ووزنها وأمثلة عليها في سياقها.', href: '/dictionary', usageKey: 'smartDictionary', accent: 'purple', cta: 'افتح المعجم' },
      { key: 'quran', title: 'إعراب القرآن', desc: 'مكتبة منظمة لإعراب الآيات، مناسبة للمراجعة والدراسة.', href: '/quran', usageKey: '', accent: 'teal', cta: 'تصفّح' },
      { key: 'library', title: 'المكتبة النحوية', desc: '٤٧ كتابًا في النحو والصرف والبلاغة، تُقرأ كاملةً.', href: '/library', usageKey: '', accent: 'purple', cta: 'افتح المكتبة' },
    ]
  : [
      { key: 'analyzer', title: "I'rab analyzer", desc: "Full word by word i'rab for Arabic sentences, with the marker and why.", href: '/en/tool', usageKey: '', accent: 'purple', cta: 'Analyze now' },
      { key: 'practice', title: 'AI feedback practice', desc: "Write your own sentence and i'rab, then get word-by-word correction and explanation.", href: '/en/practice/play', usageKey: 'customPractice', accent: 'teal', cta: 'Start practicing' },
      { key: 'challenges', title: 'Challenges', desc: "Choose a ready-made sentence, then set each word's type, role, and case marker.", href: '/en/challenges', usageKey: 'practiceMode', accent: 'purple', cta: 'Start a challenge' },
      { key: 'dictionary', title: 'Smart dictionary', desc: 'Meaning, root, pattern, examples, and translation for any word.', href: '/en/dictionary', usageKey: 'smartDictionary', accent: 'purple', cta: 'Open dictionary' },
      { key: 'quran', title: "Quran i'rab", desc: "Browse structured i'rab pages for Quranic verses.", href: '/en/quran', usageKey: '', accent: 'teal', cta: 'Browse' },
      { key: 'library', title: 'Grammar library', desc: '47 works on nahw, sarf, and balagha: read in full.', href: '/en/library', usageKey: '', accent: 'purple', cta: 'Open library' },
    ];

const t = lang === 'ar'
  ? {
      loading: 'جارٍ التحميل…',
      signInTitle: 'سجّل الدخول لفتح حسابك',
      signInBody: 'لوحة واحدة لحسابك، خطتك، تقدّمك، وأدوات إعراب على الويب والتطبيق.',
      signInCta: 'تسجيل الدخول',
      dashboard: 'لوحة الحساب',
      profile: 'الملف الشخصي',
      signedIn: 'متصل الآن',
      planFree: 'الخطة المجانية',
      freeNote: 'خطة مجانية نشطة. ابدأ بما تحتاجه الآن.',
      plusNote: 'اشتراكك فعّال على الويب والتطبيق بالحساب نفسه.',
      history: 'السجل',
      manage: 'إدارة الحساب',
      signOut: 'تسجيل الخروج',
      continueTitle: 'ابدأ الآن',
      continueBody: 'اختر مهمتك التالية',
      primaryTool: 'حلّل جملة',
      secondaryTool: 'تدرّب الآن',
      today: 'استخدام اليوم',
      todayBody: 'حدود التدريب والمعجم',
      practice: 'التدريب',
      challenges: 'التحديات',
      dictionary: 'المعجم',
      workspaceEyebrow: 'مساحة العمل',
      tools: 'الأدوات',
      toolsBody: 'أدوات الحساب مرتبة كسطور عمل واضحة.',
      upgradeEyebrow: 'إعراب بلس',
      upgradeBody: 'تحليل غير محدود وحدود أعلى بنفس الحساب على الويب والتطبيق.',
      annualPrice: '٣٥٫٩٩$',
      monthlyPrice: '٤٫٩٩$',
      annualMeta: 'تجربة مجانية ٧ أيام',
      annualCta: 'ابدأ التجربة المجانية',
      monthlyCta: 'اشترك شهريًّا',
      activatingTitle: 'تم الدفع: جارٍ تفعيل اشتراكك',
      activatingBody: 'سيُفتح كل شيء تلقائيًّا خلال لحظات.',
      leftToday: (n: number) => `${n} متبقٍ`,
      unlimited: 'غير محدود',
      user: 'مستخدم',
      statsKicker: 'تقدّمك',
      statAnalyzed: 'جملة محلَّلة',
      statPracticed: 'تمرين',
      statAvg: 'متوسّط الدقّة',
      statStreak: 'يوم متتالٍ',
      recentTitle: 'النشاط الأخير',
      recentEmpty: 'لا نشاط بعد: ابدأ بتحليل جملة أو تمرين، وسيظهر هنا.',
      seeAll: 'عرض الكل',
    }
  : {
      loading: 'Loading…',
      signInTitle: 'Sign in to open your profile',
      signInBody: 'One dashboard for your account, plan, progress, and Irab tools across web and mobile.',
      signInCta: 'Sign in',
      dashboard: 'Account dashboard',
      profile: 'Profile',
      signedIn: 'Signed in',
      planFree: 'Free plan',
      freeNote: 'Your free plan is active. Start with what you need now.',
      plusNote: 'Your subscription is active on web and mobile with the same account.',
      history: 'History',
      manage: 'Manage account',
      signOut: 'Sign out',
      continueTitle: 'Start now',
      continueBody: 'Choose your next task',
      primaryTool: 'Analyze a sentence',
      secondaryTool: 'Practice now',
      today: "Today's usage",
      todayBody: 'Practice and dictionary limits',
      practice: 'Practice',
      challenges: 'Challenges',
      dictionary: 'Dictionary',
      workspaceEyebrow: 'Workspace',
      tools: 'Tools',
      toolsBody: 'Your account tools, arranged as clear action rows.',
      upgradeEyebrow: 'Irab Plus',
      upgradeBody: 'Unlimited analysis and higher limits with the same account on web and mobile.',
      annualPrice: '$35.99',
      monthlyPrice: '$4.99',
      annualMeta: '7 day free trial',
      annualCta: 'Start free trial',
      monthlyCta: 'Subscribe monthly',
      activatingTitle: 'Payment received: activating your subscription',
      activatingBody: 'Everything unlocks automatically in a few moments.',
      leftToday: (n: number) => `${n} left`,
      unlimited: 'Unlimited',
      user: 'User',
      statsKicker: 'Your progress',
      statAnalyzed: 'analyzed',
      statPracticed: 'practiced',
      statAvg: 'avg accuracy',
      statStreak: 'day streak',
      recentTitle: 'Recent activity',
      recentEmpty: 'No activity yet: analyze a sentence or practice, and it shows up here.',
      seeAll: 'See all',
    };
const historyHref = lang === 'ar' ? '/history' : '/en/history';
const toolHref = lang === 'ar' ? '/tool' : '/en/tool';
const practiceHref = lang === 'ar' ? '/practice/play' : '/en/practice/play';
---
<div data-hub-root data-lang={lang} data-login={login} data-home={home} dir={dir} class="app-shell w-full max-w-6xl mx-auto">
  <div data-hub-loading aria-busy="true" aria-label={t.loading} class="space-y-6">
    <div class="app-hero skeleton h-56"></div>
    <div class="grid grid-cols-1 lg:grid-cols-[1.08fr_0.92fr] gap-5">
      <div class="skeleton h-96"></div>
      <div class="skeleton h-96"></div>
    </div>
  </div>

  <div data-hub-gate class="hidden app-gate panel-in text-center">
    <div class="mx-auto mb-5 grid place-items-center app-gate-mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 15v2"/><path d="M7 10V8a5 5 0 0 1 10 0v2"/><rect x="5" y="10" width="14" height="10" rx="2"/>
      </svg>
    </div>
    <h2 class:list={[titleClass, 'text-h2 leading-tight mb-3']}>{t.signInTitle}</h2>
    <p class="text-body text-ink/70 dark:text-mist/70 mb-7 max-w-lg mx-auto">{t.signInBody}</p>
    <a href={login} class="btn-primary btn-lg">{t.signInCta}</a>
  </div>

  <div data-hub class="hidden panel-in profile-dashboard">
    <section class="profile-shell" aria-label={t.dashboard}>
      <div class="profile-main-row">
        <div class="identity-block">
          <div class="profile-avatar" data-hub-avatar aria-hidden="true">إ</div>
          <div class="identity-copy">
            <p class="app-kicker">{t.profile}</p>
            <h1 class:list={[titleClass, 'profile-title']} data-hub-name></h1>
            <div class="profile-meta">
              <span data-hub-email class="profile-email"></span>
              <span class="profile-dot" aria-hidden="true"></span>
              <span>{t.signedIn}</span>
            </div>
          </div>
        </div>

      <div class="account-actions">
        <span data-hub-plan class="app-plan-pill">{t.planFree}</span>
        <a href={historyHref} class="app-link">{t.history}</a>
        <a href={account} class="app-link">{t.manage}</a>
        <button type="button" data-hub-signout class="app-link app-link-muted">{t.signOut}</button>
      </div>
      </div>

      <div class="profile-support-row">
        <p data-plan-note class="profile-note">{t.freeNote}</p>
        <div class="profile-metrics" aria-label={t.statsKicker}>
          <div class="metric-item"><span class="metric-value" data-stat="analyze">0</span><span>{t.statAnalyzed}</span></div>
          <div class="metric-item"><span class="metric-value" data-stat="practice">0</span><span>{t.statPracticed}</span></div>
          <div class="metric-item"><span class="metric-value" data-stat="avg">0%</span><span>{t.statAvg}</span></div>
          <div class="metric-item"><span class="metric-value" data-stat="streak">0</span><span>{t.statStreak}</span></div>
        </div>
      </div>
    </section>

    <section class="command-bar">
      <div class="command-copy">
        <p class="app-kicker">{t.continueTitle}</p>
        <h2 class:list={[titleClass, 'command-title']}>{t.continueBody}</h2>
      </div>
      <div class="command-actions">
        <a href={toolHref} class="command-action command-action-primary">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16"/><path d="M4 12h10"/><path d="M4 18h7"/><path d="m16 16 2 2 4-5"/></svg>
          <span>{t.primaryTool}</span>
        </a>
        <a href={practiceHref} class="command-action">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H6a2 2 0 0 0-2 2v15h16V5a2 2 0 0 0-2-2h-2"/><path d="M8 3h8v4H8z"/><path d="M8 13h8"/><path d="M8 17h5"/></svg>
          <span>{t.secondaryTool}</span>
        </a>
      </div>
    </section>

    <div data-hub-activating class="hidden app-activating">
      <svg viewBox="0 0 24 24" class="w-7 h-7 shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 6 9 17l-5-5"/>
      </svg>
      <div>
        <p class:list={[titleClass, 'text-h3 leading-tight']}>{t.activatingTitle}</p>
        <p class="text-small text-ink/70 dark:text-mist/70">{t.activatingBody}</p>
      </div>
    </div>

    <section class="workspace-panel">
      <div class="workspace-head">
        <div>
          <p class="app-kicker">{t.workspaceEyebrow}</p>
          <h2 class:list={[titleClass, 'workspace-title']}>{t.tools}</h2>
          <p class="workspace-body">{t.toolsBody}</p>
        </div>
      </div>

      <div class="workspace-list">
        {tools.map((tool) => (
          <a href={tool.href} data-usage-key={tool.usageKey} class:list={['workspace-row', tool.accent === 'teal' ? 'workspace-row-teal' : 'workspace-row-purple']}>
            <span class="workspace-icon" aria-hidden="true">
              {tool.key === 'analyzer' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16"/><path d="M4 12h10"/><path d="M4 18h7"/><path d="m16 16 2 2 4-5"/></svg>
              )}
              {tool.key === 'practice' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H6a2 2 0 0 0-2 2v15h16V5a2 2 0 0 0-2-2h-2"/><path d="M8 3h8v4H8z"/><path d="M8 13h8"/><path d="M8 17h5"/></svg>
              )}
              {tool.key === 'challenges' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><path d="m9 8 1.5 1.5L14 6"/><path d="M9 14h7"/></svg>
              )}
              {tool.key === 'dictionary' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><path d="M9 7h7"/><path d="M9 11h5"/></svg>
              )}
              {tool.key === 'quran' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6v15"/><path d="M5 4h4a3 3 0 0 1 3 3v14a3 3 0 0 0-3-3H5z"/><path d="M19 4h-4a3 3 0 0 0-3 3"/></svg>
              )}
              {tool.key === 'library' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><path d="M9.5 2v15"/><path d="M13 6h3"/></svg>
              )}
            </span>
            <span class="workspace-main">
              <span class:list={[titleClass, 'workspace-row-title']}>{tool.title}</span>
              <span class="workspace-row-desc">{tool.desc}</span>
            </span>
            <span data-usage class="workspace-usage"></span>
            <span class="workspace-cta">{tool.cta}<span aria-hidden="true">{lang === 'ar' ? '←' : '→'}</span></span>
          </a>
        ))}
      </div>
    </section>

    <div class="profile-info-rail">
      <details class="usage-disclosure">
        <summary>
          <span>
            <span class="app-kicker">{t.today}</span>
            <strong>{t.todayBody}</strong>
          </span>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="usage-inline-list">
          <div class="usage-inline-row">
            <span>{t.practice}</span>
            <strong data-usage-summary="customPractice">0</strong>
          </div>
          <div class="usage-inline-row">
            <span>{t.challenges}</span>
            <strong data-usage-summary="practiceMode">0</strong>
          </div>
          <div class="usage-inline-row">
            <span>{t.dictionary}</span>
            <strong data-usage-summary="smartDictionary">0</strong>
          </div>
        </div>
      </details>

      <section data-hub-upgrade class="hidden upgrade-nudge">
        <div class="upgrade-copy">
          <p class="app-kicker">{t.upgradeEyebrow}</p>
          <p class:list={[titleClass, 'upgrade-lead']}>{t.upgradeBody}</p>
        </div>
        {PADDLE_ENABLED ? (
          <div class="upgrade-actions">
            <button type="button" data-paddle-plan="annual" class="upgrade-btn upgrade-btn-primary">
              <span>{t.annualCta}</span>
              <small>{t.annualPrice} · {t.annualMeta}</small>
            </button>
            <button type="button" data-paddle-plan="monthly" class="upgrade-btn">
              <span>{t.monthlyCta}</span>
              <small>{t.monthlyPrice}</small>
            </button>
          </div>
        ) : (
          <a href={`${home}#cta`} class="upgrade-btn upgrade-btn-primary">{lang === 'ar' ? 'حمّل التطبيق' : 'Get the app'}</a>
        )}
      </section>
    </div>

    <section data-hub-recent class="app-panel hidden">
      <div class="flex items-center justify-between gap-4 mb-5">
        <h2 class="recent-heading">{t.recentTitle}</h2>
        <a href={historyHref} data-recent-seeall class="btn-ghost app-action hidden">{t.seeAll}</a>
      </div>
      <ul data-recent-list class="recent-list"></ul>
      <p data-recent-empty class="hidden text-small text-ink/65 dark:text-mist/65 py-8 text-center">{t.recentEmpty}</p>
    </section>
  </div>
</div>

<style>
  .app-shell { --panel-pad: clamp(1.25rem, 2.4vw, 2rem); }
  .app-gate,
  .app-hero,
  .app-panel,
  .usage-panel,
  .upgrade-panel,
  .app-activating {
    background: var(--color-card);
    border: 1px solid var(--color-card-edge);
    box-shadow: var(--shadow-lift);
  }
  :global(.dark) .app-gate,
  :global(.dark) .app-hero,
  :global(.dark) .app-panel,
  :global(.dark) .usage-panel,
  :global(.dark) .upgrade-panel,
  :global(.dark) .app-activating {
    background: var(--color-coal-soft);
    border-color: var(--color-coal-edge);
    box-shadow: 0 20px 46px -24px rgb(0 0 0 / 0.75);
  }
  .app-gate { border-radius: 1.25rem; padding: clamp(2rem, 6vw, 4rem); }
  .app-gate-mark {
    width: 4.25rem; height: 4.25rem; border-radius: 1.2rem;
    color: var(--color-purple-deep);
    background: color-mix(in srgb, var(--color-purple) 12%, white);
    border: 1px solid color-mix(in srgb, var(--color-purple) 28%, var(--color-card-edge));
  }
  .app-hero {
    border-radius: 1.25rem;
    padding: clamp(1.4rem, 3vw, 2.25rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.25rem;
    align-items: center;
    position: relative;
    overflow: hidden;
  }
  .app-hero::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    top: 0;
    width: 0.45rem;
    height: 100%;
    background: var(--color-purple);
  }
  .app-title { font-size: clamp(2.25rem, 5vw, 4.25rem); }
  .app-subtitle { max-width: 42rem; color: color-mix(in srgb, var(--color-ink) 70%, transparent); font-size: var(--text-small); }
  :global(.dark) .app-subtitle { color: color-mix(in srgb, var(--color-mist) 72%, transparent); }
  .app-kicker {
    display: block;
    color: var(--color-purple-deep);
    font-weight: 800;
    font-size: var(--text-caption);
    line-height: 1.35;
  }
  :global(.dark) .app-kicker { color: color-mix(in srgb, var(--color-purple) 85%, white); }
  .app-kicker-light { color: color-mix(in srgb, white 86%, transparent); }
  .app-status { display: flex; flex-direction: column; align-items: flex-end; gap: 1rem; }
  .app-plan-pill {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 8rem;
    border-radius: 999px;
    padding: 0.65rem 1.1rem;
    font-size: var(--text-caption);
    font-weight: 800;
    background: color-mix(in srgb, var(--color-ink) 8%, transparent);
    color: var(--color-ink);
  }
  .app-plan-pill.is-plus {
    background: var(--color-purple);
    color: white;
    box-shadow: 0 14px 26px -12px color-mix(in srgb, var(--color-purple) 70%, transparent);
  }
  .app-action { padding: 0.7rem 1.05rem; font-size: var(--text-caption); }
  .app-action-muted { color: color-mix(in srgb, var(--color-ink) 62%, transparent); }
  :global(.dark) .app-action-muted { color: color-mix(in srgb, var(--color-mist) 68%, transparent); }

  .profile-hero,
  .quick-panel {
    border-radius: 0.65rem;
    border: 1px solid var(--color-card-edge);
    background: var(--color-card);
    box-shadow: var(--shadow-card);
  }
  :global(.dark) .profile-hero,
  :global(.dark) .quick-panel {
    background: var(--color-coal-soft);
    border-color: var(--color-coal-edge);
    box-shadow: 0 18px 46px -28px rgb(0 0 0 / 0.78);
  }
  .profile-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(21rem, 0.46fr);
    gap: 1px;
    overflow: hidden;
    background: var(--color-card-edge);
  }
  :global(.dark) .profile-hero { background: var(--color-coal-edge); }
  .profile-card,
  .profile-side {
    background: var(--color-card);
    padding: clamp(1.25rem, 2.6vw, 2rem);
  }
  :global(.dark) .profile-card,
  :global(.dark) .profile-side { background: var(--color-coal-soft); }
  .profile-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.15rem;
    align-items: center;
  }
  .profile-avatar {
    width: clamp(4.4rem, 8vw, 6rem);
    height: clamp(4.4rem, 8vw, 6rem);
    border-radius: 0.65rem;
    display: grid;
    place-items: center;
