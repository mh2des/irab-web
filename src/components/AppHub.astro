  .upgrade-actions {
    display: grid;
    gap: 0.5rem;
    min-width: min(18rem, 100%);
  }
  .upgrade-btn {
    border-radius: 0.5rem;
    border: 1px solid var(--color-card-edge);
    background: var(--color-card);
    color: var(--color-ink);
