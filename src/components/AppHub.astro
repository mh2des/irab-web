  @media (max-width: 900px) {
    .profile-strip,
    .start-panel,
    .upgrade-panel { grid-template-columns: 1fr; }
    .profile-strip { align-items: stretch; }
    .account-actions { justify-content: flex-start; }
    .start-actions { grid-template-columns: 1fr; }
    .lower-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 680px) {
    .profile-strip,
    .start-panel,
    .workspace-panel,
    .usage-panel,
    .upgrade-panel,
    .app-panel { padding: 0.9rem; }
    .identity-block { align-items: flex-start; }
    .profile-avatar { width: 3.35rem; height: 3.35rem; font-size: 1.75rem; }
    .profile-title { font-size: 2rem; white-space: normal; }
    .stats-strip { grid-template-columns: repeat(2, 1fr); }
    .stat-cell:nth-child(3) { border-inline-start: 0; border-top: 1px solid var(--color-card-edge); }
    .stat-cell:nth-child(4) { border-top: 1px solid var(--color-card-edge); }
    :global(.dark) .stat-cell:nth-child(3),
    :global(.dark) .stat-cell:nth-child(4) { border-top-color: var(--color-coal-edge); }
    .workspace-row {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: start;
    }
    .workspace-usage,
    .workspace-cta {
      grid-column: 2;
      justify-self: start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .app-link:hover,
    .start-action:hover,
    .workspace-row:hover,
    .upgrade-btn:hover { transform: none; }
    .start-action:hover svg { transform: none; }
  }

