    border: 1px solid var(--color-card-edge);
  }
  :global(.dark) .profile-ready { background: color-mix(in srgb, var(--color-coal) 56%, var(--color-coal-soft)); border-color: var(--color-coal-edge); }
  .profile-ready strong,
  .profile-ready small { display: block; }
  .profile-ready strong { font-size: var(--text-small); line-height: 1.2; }
  .profile-ready small {
    margin-top: 0.2rem;
    color: color-mix(in srgb, var(--color-ink) 66%, transparent);
    font-size: var(--text-caption);
    line-height: 1.45;
  }
  :global(.dark) .profile-ready small { color: color-mix(in srgb, var(--color-mist) 70%, transparent); }
  .ready-icon {
    width: 2.15rem;
    height: 2.15rem;
    border-radius: 0.5rem;
    display: grid;
    place-items: center;
    color: white;
    background: var(--color-teal);
  }
  .ready-icon svg { width: 1.1rem; height: 1.1rem; }
  .profile-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }

  .quick-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    padding: clamp(1rem, 2vw, 1.35rem);
  }
  .quick-title { font-size: clamp(1.75rem, 3vw, 2.35rem); line-height: 1.12; }
  .quick-body {
    color: color-mix(in srgb, var(--color-ink) 66%, transparent);
    font-size: var(--text-caption);
    line-height: 1.5;
  }
  :global(.dark) .quick-body { color: color-mix(in srgb, var(--color-mist) 70%, transparent); }
  .quick-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(10rem, 1fr));
    gap: 0.75rem;
  }
  .quick-action {
    min-height: 3.8rem;
    border-radius: 0.55rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--color-card-edge);
    background: color-mix(in srgb, var(--color-paper-soft) 66%, white);
    color: var(--color-ink);
    font-size: var(--text-caption);
    font-weight: 900;
    transition: transform .22s var(--ease-out-quart), box-shadow .22s var(--ease-out-quart), border-color .2s, background-color .2s, color .2s;
  }
  :global(.dark) .quick-action { background: color-mix(in srgb, var(--color-coal) 54%, var(--color-coal-soft)); color: var(--color-mist); border-color: var(--color-coal-edge); }
  .quick-action:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--color-teal) 52%, var(--color-card-edge));
    box-shadow: var(--lift-shadow);
  }
  .quick-action-primary {
    color: white;
    background: var(--color-ink);
    border-color: var(--color-ink);
  }
  :global(.dark) .quick-action-primary { background: var(--color-purple); border-color: var(--color-purple); color: white; }
  .quick-action-primary:hover { border-color: var(--color-purple); background: var(--color-purple); }
  .quick-icon {
    width: 1.8rem;
    height: 1.8rem;
    display: grid;
    place-items: center;
  }
  .quick-icon svg { width: 1.25rem; height: 1.25rem; transition: transform .22s var(--ease-out-quart); }
  .quick-action:hover .quick-icon svg { transform: scale(1.12); }

  .dashboard-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.16fr) minmax(21rem, 0.84fr);
    gap: 1rem;
    align-items: start;
  }

  /* Stats strip */
  .app-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.85rem; }
  .stat-tile {
    border-radius: 0.55rem; padding: 1.05rem 1.1rem;
    background: var(--color-card); border: 1px solid var(--color-card-edge); box-shadow: var(--shadow-card);
    display: flex; flex-direction: column; gap: 0.25rem;
    transition: transform .22s var(--ease-out-quart), border-color .22s, box-shadow .22s;
  }
  :global(.dark) .stat-tile { background: var(--color-coal-soft); border-color: var(--color-coal-edge); }
  .stat-tile:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--color-ink) 18%, var(--color-card-edge)); box-shadow: var(--lift-shadow); }
  :global(.dark) .stat-tile:hover { border-color: color-mix(in srgb, var(--color-purple) 34%, var(--color-coal-edge)); }
  .stat-tile-num { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.9rem, 4vw, 2.7rem); line-height: 1; color: var(--color-ink); }
  :global(.dark) .stat-tile-num { color: var(--color-mist); }
  .stat-tile-purple .stat-tile-num { color: var(--color-purple-deep); }
  :global(.dark) .stat-tile-purple .stat-tile-num { color: color-mix(in srgb, var(--color-purple) 85%, white); }
  .stat-tile-teal .stat-tile-num { color: var(--color-teal); }
  .stat-tile-label { font-size: var(--text-caption); font-weight: 700; color: color-mix(in srgb, var(--color-ink) 66%, transparent); }
  :global(.dark) .stat-tile-label { color: color-mix(in srgb, var(--color-mist) 70%, transparent); }

  /* Recent activity */
  /* .recent-* rows are injected via JS — styled in the global block below. */
  .app-panel,
  .usage-panel {
    border-radius: 0.65rem;
    padding: var(--panel-pad);
  }
  .app-activating {
    border-radius: 0.65rem;
    padding: 1rem 1.25rem;
    display: flex;
    gap: 1rem;
    align-items: center;
    color: var(--color-teal);
    border-color: color-mix(in srgb, var(--color-teal) 45%, var(--color-card-edge));
  }
  .app-activating.hidden { display: none; }
  .tool-card {
    min-height: 13.75rem;
    border-radius: 0.55rem;
    padding: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    background: color-mix(in srgb, var(--color-paper-soft) 62%, white);
    border: 1px solid var(--color-card-edge);
    transition: transform .24s var(--ease-out-quart), border-color .22s, box-shadow .22s, background-color .22s;
  }
  :global(.dark) .tool-card {
    background: color-mix(in srgb, var(--color-coal) 52%, var(--color-coal-soft));
    border-color: var(--color-coal-edge);
  }
  .tool-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--lift-shadow);
    background: var(--color-card);
  }
  :global(.dark) .tool-card:hover { background: var(--color-coal-soft); }
  .tool-card-purple:hover { border-color: color-mix(in srgb, var(--color-purple) 48%, var(--color-card-edge)); }
  .tool-card-teal:hover { border-color: color-mix(in srgb, var(--color-teal) 52%, var(--color-card-edge)); }
  .tool-icon {
    width: 3rem; height: 3rem; border-radius: 0.55rem;
    display: grid; place-items: center;
    background: white;
    border: 1px solid var(--color-card-edge);
  }
  :global(.dark) .tool-icon { background: var(--color-coal-soft); border-color: var(--color-coal-edge); }
  .tool-card-purple .tool-icon, .tool-card-purple .tool-cta { color: var(--color-purple-deep); }
  .tool-card-teal .tool-icon, .tool-card-teal .tool-cta { color: var(--color-teal); }
  .tool-icon svg { width: 1.55rem; height: 1.55rem; }
  .tool-title { display: block; font-size: 1.5rem; line-height: 1.25; }
  .tool-desc {
    display: block;
    margin-top: 0.35rem;
    color: color-mix(in srgb, var(--color-ink) 68%, transparent);
    font-size: var(--text-caption);
    line-height: 1.55;
  }
  :global(.dark) .tool-desc { color: color-mix(in srgb, var(--color-mist) 72%, transparent); }
  .tool-footer {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
  }
  .tool-usage {
    min-height: 1.75rem;
    color: color-mix(in srgb, var(--color-ink) 58%, transparent);
    font-size: var(--text-caption);
    font-weight: 800;
  }
  :global(.dark) .tool-usage { color: color-mix(in srgb, var(--color-mist) 70%, transparent); }
  .tool-cta {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    font-size: var(--text-caption);
    font-weight: 800;
    white-space: nowrap;
  }
  .usage-panel { display: grid; gap: 1rem; }
  .usage-intro {
    margin-top: 0.25rem;
    color: color-mix(in srgb, var(--color-ink) 64%, transparent);
    font-size: var(--text-caption);
    line-height: 1.45;
  }
  :global(.dark) .usage-intro { color: color-mix(in srgb, var(--color-mist) 68%, transparent); }
  .usage-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
  .usage-card {
    border-radius: 0.55rem;
    border: 1px solid var(--color-card-edge);
    background: color-mix(in srgb, var(--color-paper-soft) 58%, white);
    padding: 1rem;
  }
  :global(.dark) .usage-card { background: color-mix(in srgb, var(--color-coal) 48%, var(--color-coal-soft)); border-color: var(--color-coal-edge); }
  .usage-label {
    display: block;
    font-size: var(--text-caption);
    color: color-mix(in srgb, var(--color-ink) 62%, transparent);
    font-weight: 700;
  }
  :global(.dark) .usage-label { color: color-mix(in srgb, var(--color-mist) 68%, transparent); }
  .usage-card strong {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.55rem);
    line-height: 1.05;
    color: var(--color-ink);
  }
  :global(.dark) .usage-card strong { color: var(--color-mist); }
  .upgrade-panel {
    border-radius: 0.65rem;
    padding: var(--panel-pad);
    color: white;
    background: var(--color-ink);
    border-color: color-mix(in srgb, var(--color-purple) 42%, transparent);
  }
  :global(.dark) .upgrade-panel {
    background: color-mix(in srgb, var(--color-coal-soft) 72%, var(--color-purple-deep));
  }
  .upgrade-title { font-size: clamp(2rem, 4vw, 3rem); line-height: 1.08; }
  .upgrade-body {
    margin-top: 0.75rem;
    color: color-mix(in srgb, white 78%, transparent);
    font-size: var(--text-small);
    line-height: 1.55;
  }
  .upgrade-features {
    list-style: none;
    display: grid;
    gap: 0.55rem;
    margin: 1rem 0 0;
    padding: 0;
  }
  .upgrade-features li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: color-mix(in srgb, white 88%, transparent);
    font-size: var(--text-caption);
    font-weight: 800;
    line-height: 1.35;
  }
  .upgrade-features svg {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    color: var(--color-teal);
    background: white;
    border-radius: 999px;
    padding: 0.18rem;
  }
  .upgrade-plans { display: grid; gap: 0.85rem; margin-top: 1.25rem; }
  .plan-card {
    position: relative;
    width: 100%;
    text-align: start;
    border-radius: 0.55rem;
    padding: 1.05rem;
    background: rgb(255 255 255 / 0.1);
    border: 1px solid rgb(255 255 255 / 0.18);
    color: white;
    transition: transform .2s var(--ease-out-quart), background-color .2s, border-color .2s;
  }
  .plan-card:hover {
    transform: translateY(-3px);
    background: rgb(255 255 255 / 0.16);
    border-color: rgb(255 255 255 / 0.38);
  }
  .plan-card-featured {
    background: white;
    color: var(--color-ink);
    border-color: white;
    box-shadow: 0 18px 34px -18px rgb(0 0 0 / 0.55);
  }
  .plan-card-featured:hover { background: white; border-color: white; }
  .plan-badge {
    position: absolute;
    inset-inline-end: 1rem;
    top: 1rem;
    border-radius: 999px;
    padding: 0.26rem 0.7rem;
    background: var(--color-teal);
    color: white;
    font-size: 0.95rem;
    font-weight: 900;
  }
  .plan-name,
  .plan-meta,
  .plan-cta { display: block; }
  .plan-name { font-size: var(--text-caption); font-weight: 900; opacity: 0.78; }
  .plan-price { display: block; margin-top: 0.2rem; font-family: var(--font-display); font-size: 2.45rem; line-height: 1; font-weight: 700; }
  .plan-meta { margin-top: 0.2rem; font-size: var(--text-caption); opacity: 0.76; }
  .plan-cta {
    margin-top: 0.8rem;
    border-radius: 999px;
    padding: 0.62rem 0.9rem;
    text-align: center;
    font-size: var(--text-caption);
    font-weight: 900;
    background: rgb(255 255 255 / 0.16);
  }
  .plan-card-featured .plan-cta { background: var(--color-purple); color: white; }
  .upgrade-fineprint {
    margin-top: 1rem;
    color: color-mix(in srgb, white 66%, transparent);
    font-size: var(--text-caption);
    line-height: 1.45;
  }
  .upgrade-link {
    display: inline-flex;
    margin-top: 0.55rem;
    color: white;
    font-size: var(--text-caption);
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  @media (max-width: 780px) {
    .profile-hero,
    .dashboard-grid,
    .quick-panel { grid-template-columns: 1fr; }
    .profile-card { grid-template-columns: 1fr; text-align: center; }
    .profile-avatar { margin-inline: auto; }
    .profile-title { justify-content: center; }
    .profile-meta { justify-content: center; }
    .profile-plan-row { align-items: flex-start; }
    .profile-actions { flex-direction: column; }
    .quick-actions { grid-template-columns: 1fr; }
    .app-hero { grid-template-columns: 1fr; }
    .app-status { align-items: stretch; }
    .app-status > .flex { flex-direction: column; }
    .app-action { width: 100%; }
    .usage-grid { grid-template-columns: 1fr; }
    .tool-card { min-height: 14rem; }
    .app-stats { grid-template-columns: 1fr 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tool-card:hover,
    .plan-card:hover,
    .stat-tile:hover,
    .quick-action:hover { transform: none; }
    .quick-action:hover .quick-icon svg { transform: none; }
  }

  /* Profile dashboard v2: calm, sparse, and action-led. These rules override
     the older card-heavy dashboard styles above while keeping the same auth
     wiring and Paddle hooks. */
  .dashboard-flow {
    display: grid;
    gap: 0.9rem;
  }
  .profile-strip,
  .start-panel,
  .stats-strip,
  .workspace-panel,
  .usage-panel,
  .upgrade-panel,
  .app-panel,
  .app-activating {
    border-radius: 0.55rem;
    border: 1px solid var(--color-card-edge);
    background: var(--color-card);
    box-shadow: 0 12px 28px -22px rgb(23 56 71 / 0.34);
  }
  :global(.dark) .profile-strip,
  :global(.dark) .start-panel,
  :global(.dark) .stats-strip,
  :global(.dark) .workspace-panel,
  :global(.dark) .usage-panel,
  :global(.dark) .upgrade-panel,
  :global(.dark) .app-panel,
  :global(.dark) .app-activating {
    background: var(--color-coal-soft);
    border-color: var(--color-coal-edge);
    box-shadow: 0 16px 42px -28px rgb(0 0 0 / 0.78);
  }
  .profile-strip {
    min-height: 7.5rem;
    padding: 1.15rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .identity-block {
    display: flex;
    align-items: center;
    gap: 0.95rem;
    min-width: 0;
  }
  .profile-avatar {
    width: 4rem;
    height: 4rem;
    border-radius: 0.55rem;
    display: grid;
    place-items: center;
    color: white;
    background: var(--color-ink);
    box-shadow: 0 14px 24px -18px rgb(23 56 71 / 0.55);
    font-family: var(--font-display);
    font-size: 2.15rem;
    line-height: 1;
  }
  :global(.dark) .profile-avatar { background: var(--color-purple-deep); }
  .identity-copy { min-width: 0; }
  .profile-title {
    margin-top: 0.1rem;
    max-width: 38rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: clamp(2rem, 3.4vw, 3.15rem);
    line-height: 1.05;
    color: var(--color-ink);
  }
  :global(.dark) .profile-title { color: var(--color-mist); }
  .profile-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
    color: color-mix(in srgb, var(--color-ink) 60%, transparent);
    font-size: var(--text-caption);
    font-weight: 700;
  }
  :global(.dark) .profile-meta { color: color-mix(in srgb, var(--color-mist) 66%, transparent); }
  .profile-email {
    max-width: min(30rem, 100%);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    direction: ltr;
    unicode-bidi: plaintext;
  }
  .profile-dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: var(--color-teal);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-teal) 14%, transparent);
  }
  .account-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.55rem;
    flex-wrap: wrap;
  }
  .app-plan-pill {
    min-width: 0;
    border-radius: 999px;
    padding: 0.48rem 0.85rem;
    background: color-mix(in srgb, var(--color-ink) 7%, transparent);
    color: var(--color-ink);
    font-size: var(--text-caption);
    font-weight: 900;
  }
  :global(.dark) .app-plan-pill { color: var(--color-mist); background: color-mix(in srgb, white 9%, transparent); }
  .app-plan-pill.is-plus {
    color: white;
    background: var(--color-purple);
    box-shadow: 0 12px 24px -16px color-mix(in srgb, var(--color-purple) 80%, transparent);
  }
  .app-link {
    border-radius: 0.5rem;
    border: 1px solid var(--color-card-edge);
    background: var(--color-card);
    padding: 0.55rem 0.85rem;
    color: var(--color-ink);
    font-size: var(--text-caption);
    font-weight: 800;
    transition: transform .18s var(--ease-out-quart), border-color .18s, box-shadow .18s, color .18s;
  }
  :global(.dark) .app-link { background: var(--color-coal-soft); border-color: var(--color-coal-edge); color: var(--color-mist); }
  .app-link:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-purple) 38%, var(--color-card-edge));
    box-shadow: var(--shadow-card);
