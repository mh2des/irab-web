  }
  @media (prefers-reduced-motion: reduce) {
    .command-action:hover,
    .workspace-row:hover,
    .upgrade-btn:hover { transform: none; }
    .command-action:hover svg,
    .usage-disclosure[open] summary svg { transform: none; }
  }

  /* Profile dashboard v4: spacious Thmanyah hierarchy shared with /account. */
