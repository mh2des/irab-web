  }
  :global(.dark) .profile-avatar { background: var(--color-purple-deep); }
  .profile-copy { min-width: 0; }
  .profile-title {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em;
    align-items: baseline;
    margin-top: 0.15rem;
    font-size: clamp(2.4rem, 5vw, 4.4rem);
