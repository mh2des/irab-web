  .app-link-muted { color: color-mix(in srgb, var(--color-ink) 56%, transparent); }
  :global(.dark) .app-link-muted { color: color-mix(in srgb, var(--color-mist) 62%, transparent); }

  .start-panel {
    padding: 1.1rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
  }
  .start-title,
  .workspace-title,
  .panel-title {
    font-size: clamp(1.65rem, 2.7vw, 2.25rem);
    line-height: 1.12;
    color: var(--color-ink);
  }
  :global(.dark) .start-title,
  :global(.dark) .workspace-title,
  :global(.dark) .panel-title { color: var(--color-mist); }
  .start-note,
  .workspace-body,
