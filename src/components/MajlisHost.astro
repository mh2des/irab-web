---
/**
 * MajlisHost — the host hub (مجالسي): drafts, history (reports), question
 * bank. Reads/writes the SAME Firestore the app uses (verified contract in
 * docs/majlis-host-contracts.md):
 *   drafts : majalis_drafts/{uid}/drafts  orderBy updatedAt desc limit 30
 *   history: majalis_reports where hostUid==uid orderBy finishedAt desc limit 20
 *   bank   : majalis_bank/{uid}/questions limit 100 (NO orderBy — docs have no timestamp)
 * Deletes are direct doc deletes (owner-only rules), optimistic UI.
 * Quota pill via callable majalisQuotaStatus {used, limit, remaining,
 * nextFreeAtMs, isPremium}; it shows what is left today, never the plan's
 * allowance (numbers live on /pricing). A banner returns the host to a room
 * that is still live (hostActive/{uid} in RTDB). Cache-first then server refresh, per-doc
 * parse-or-skip — mirrors the app's resilience. Western digits (owner call).
 * Thmanyah only: headings carry font-sans to beat the global display-font rule.
 */
---

<div data-mhost-root dir="rtl" class="mx-auto w-full max-w-2xl">

  <!-- Loading skeleton: shaped like the cards it becomes -->
  <div data-v="loading" class="grid gap-3">
    <div class="skeleton h-10 w-40 rounded-xl"></div>
    <div class="skeleton h-32 rounded-2xl"></div>
    <div class="skeleton h-32 rounded-2xl"></div>
    <div class="skeleton h-32 rounded-2xl"></div>
  </div>

  <!-- Sign-in gate -->
  <section data-v="gate" class="hidden">
    <div class="card p-8 text-center">
      <h1 class="font-sans font-black text-2xl text-ink dark:text-mist">سجّل الدخول لإدارة مجالسك</h1>
      <p class="mt-2 text-ink-muted dark:text-mist-muted">مسوداتك وسجل مجالسك وبنك أسئلتك، متزامنة بين التطبيق والويب.</p>
      <a data-login-link href="/login?next=/majlis/host" class="btn-primary btn-lg mt-5">تسجيل الدخول</a>
    </div>
  </section>

  <!-- Hub -->
  <section data-v="hub" class="hidden">
    <div class="flex items-center justify-between gap-3 flex-wrap">
      <div>
        <p class="text-sm font-bold text-teal">مجالس الإعراب</p>
        <h1 class="font-sans font-black text-3xl text-ink dark:text-mist">مجالسي</h1>
      </div>
      <span data-quota-pill class="hidden rounded-full border border-stone dark:border-coal-edge bg-paper dark:bg-coal px-3.5 py-1.5 text-sm font-bold text-ink-soft dark:text-mist-soft"></span>
    </div>

    <!-- Live room still running (refresh, closed tab, another device) -->
    <div data-live-banner class="hidden mt-4 flex flex-wrap items-center justify-between gap-4 rounded-2xl border-2 border-teal bg-teal/10 px-5 py-4 text-ink dark:text-mist">
      <span>
        <span class="block font-black text-lg">مجلسك ما زال مباشرًا</span>
        <span data-live-sub class="block text-sm text-ink-muted dark:text-mist-muted"></span>
      </span>
      <span class="flex flex-wrap gap-2">
        <a data-live-display href="#" class="btn-ghost text-sm" title="للعرض على جهاز العرض بينما تدير المجلس من التطبيق">اعرضه على شاشة</a>
        <a data-live-go href="#" class="btn-primary">أدره من هنا</a>
      </span>
    </div>

    <!-- Create CTA (same drafts on app and web) -->
    <div class="card mt-4 p-5 flex items-center justify-between gap-4 flex-wrap">
      <p class="text-[15px] text-ink-muted dark:text-mist-muted">أنشئ مجلسًا هنا أو من التطبيق، فمسوداتك متزامنة بينهما.</p>
      <a href="/majlis/create" class="btn-primary">مجلس جديد</a>
    </div>

    <!-- Tabs -->
    <div class="mt-6 rounded-2xl border border-stone dark:border-coal-edge bg-paper-soft dark:bg-coal p-1.5 grid grid-cols-3 gap-1" role="tablist">
      <button data-tab="drafts" role="tab" class="rounded-xl py-2.5 text-sm font-black">المسودات</button>
      <button data-tab="history" role="tab" class="rounded-xl py-2.5 text-sm font-black">السجل</button>
      <button data-tab="bank" role="tab" class="rounded-xl py-2.5 text-sm font-black">بنك الأسئلة</button>
    </div>

    <div data-list class="mt-4 grid gap-3"></div>
    <p data-empty class="hidden mt-6 text-center text-ink-muted dark:text-mist-muted text-[15px] leading-relaxed px-6"></p>
    <p data-note class="hidden mt-4 text-center text-sm text-ink-subtle dark:text-mist-subtle">المسودات لا تُحتسب من حصتك اليومية حتى تبدأ المجلس</p>
  </section>

  <div data-undo role="status" class="hidden fixed bottom-6 inset-x-0 mx-auto w-fit max-w-[90vw] z-50 flex items-center gap-4 rounded-xl bg-ink text-paper dark:bg-mist dark:text-coal px-4 py-3 text-sm font-bold">
    <span data-undo-msg></span>
    <button data-undo-btn type="button" class="underline underline-offset-4">تراجع</button>
  </div>
</div>

<script>
  import { maybeSignedIn } from '../lib/session';
  import { stagger, showAnimated } from '../lib/majlis-fx';
  import { firestore, rtdb, callMajlis } from '../lib/majlis/fb';

  const root = document.querySelector<HTMLElement>('[data-mhost-root]');
  if (root) {
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const views = ['loading', 'gate', 'hub'];
    const show = (v: string) => showAnimated(root!, views, v);

    const TYPE_LABELS: Record<string, string> = {
      mcq: 'اختيار من متعدد', true_false: 'صواب وخطأ', tap_word: 'تحديد الكلمة',
      fix_error: 'صحّح الخطأ', arrange_irab: 'ترتيب الإعراب',
    };
    const participantsLabel = (n: number) =>
      n === 0 ? 'بلا مشاركين' : n === 1 ? 'مشارك واحد' : n === 2 ? 'مشاركان'
        : n <= 10 ? `${n} مشاركين` : `${n} مشاركًا`;

    if (!maybeSignedIn()) { show('gate'); }
    else init();

    async function init() {
      const [{ onAuth }, fs, db] = await Promise.all([import('../lib/auth'), import('firebase/firestore'), firestore()]);

      onAuth(async (u) => {
        if (!u || u.isAnonymous) { show('gate'); return; }
        const uid = u.uid;
        show('hub');
        loadQuota();
        loadLiveRoom(uid);

        type Tab = 'drafts' | 'history' | 'bank';
        const tabParam = new URLSearchParams(location.search).get('tab');
        let tab: Tab = tabParam === 'history' || tabParam === 'bank' ? tabParam : 'drafts';
        let drafts: Array<{ id: string; title: string; count: number }> = [];
        let reports: Array<{ id: string; data: any }> = [];
        let bank: Array<{ id: string; data: any }> = [];

        // Ids whose delete is waiting behind the undo toast. A background
        // refresh must not bring them back on screen.
        const hiddenIds = new Set<string>();

        const tabBtns = root!.querySelectorAll<HTMLButtonElement>('[data-tab]');
        tabBtns.forEach((b) => b.addEventListener('click', () => { tab = b.dataset.tab as Tab; render(); }));

        // Cache-first, then server — one corrupt doc never blanks a tab.
        async function loadList(qy: any, apply: (docs: any[]) => void) {
          try {
            const c = await fs.getDocsFromCache(qy);
            if (!c.empty) apply(c.docs);
            render();
          } catch { /* no cache */ }
          try {
            const s = await fs.getDocs(qy);
            apply(s.docs);
          } catch { /* offline with no cache: settle on what we have */ }
          render();
        }

        loadList(
          fs.query(fs.collection(db, 'majalis_drafts', uid, 'drafts'), fs.orderBy('updatedAt', 'desc'), fs.limit(30)),
          (docs) => { drafts = docs.flatMap((d) => { if (hiddenIds.has(d.id)) return []; try { const v = d.data(); return [{ id: d.id, title: String(v.title ?? '؟'), count: Array.isArray(v.questions) ? v.questions.length : 0 }]; } catch { return []; } }); },
        );
        loadList(
          fs.query(fs.collection(db, 'majalis_reports'), fs.where('hostUid', '==', uid), fs.orderBy('finishedAt', 'desc'), fs.limit(20)),
          (docs) => { reports = docs.flatMap((d) => { try { return [{ id: d.id, data: d.data() }]; } catch { return []; } }); },
        );
        loadList(
          fs.query(fs.collection(db, 'majalis_bank', uid, 'questions'), fs.limit(100)),
          (docs) => { bank = docs.flatMap((d) => { if (hiddenIds.has(d.id)) return []; try { return [{ id: d.id, data: d.data() }]; } catch { return []; } }); },
        );

        const EMPTIES: Record<Tab, string> = {
          drafts: 'لا مسودات بعد. أنشئ مجلسًا وستُحفظ مسودته هنا تلقائيًّا.',
          history: 'لا مجالس منتهية بعد. أطلق مجلسك الأول وستجد تقاريره هنا.',
          bank: 'بنك أسئلتك فارغ. فعّل «حفظ في بنك الأسئلة» عند إنشاء سؤال ليظهر هنا.',
        };

        function card() {
          const el = document.createElement('div');
          el.className = 'card p-5';
          return el;
        }
        const btn = (label: string, cls: string) => {
          const b = document.createElement('button');
          b.type = 'button'; b.className = cls; b.textContent = label; return b;
        };

        function render() {
          tabBtns.forEach((b) => {
            const on = b.dataset.tab === tab;
            b.className = 'rounded-xl py-2.5 text-sm font-black ' + (on
              ? 'bg-purple text-white'
              : 'text-ink-muted dark:text-mist-muted hover:text-ink dark:hover:text-mist');
          });
          const list = q<HTMLElement>('[data-list]');
          list.innerHTML = '';
          q('[data-note]').classList.toggle('hidden', tab !== 'drafts' || drafts.length === 0 ? tab !== 'drafts' : false);

          const items: Array<() => HTMLElement> =
            tab === 'drafts' ? drafts.map((d) => () => draftCard(d))
            : tab === 'history' ? reports.map((r) => () => reportCard(r))
            : bank.map((b) => () => bankCard(b));

          q('[data-empty]').classList.toggle('hidden', items.length > 0);
          q('[data-empty]').textContent = EMPTIES[tab];
          q('[data-note]').classList.toggle('hidden', !(tab === 'drafts' && drafts.length > 0));
          items.forEach((make, i) => { const el = make(); stagger(el, i); list.appendChild(el); });
        }

        function draftCard(d: { id: string; title: string; count: number }) {
          const el = card();
          el.innerHTML = `
            <div class="flex items-center gap-2">
              <span class="rounded-full bg-paper-soft dark:bg-coal border border-stone dark:border-coal-edge px-2.5 py-0.5 text-xs font-black text-ink-soft dark:text-mist-soft">مسودة</span>
              <span class="text-xs text-ink-subtle dark:text-mist-subtle">${d.count} أسئلة</span>
            </div>
            <p class="mt-2 font-bold text-lg text-ink dark:text-mist truncate"></p>`;
          el.querySelector('p:last-child')!.textContent = d.title || '؟';
          const row = document.createElement('div');
          row.className = 'mt-4 flex gap-2';
          const host = btn('استضف الآن', 'btn-primary flex-1');
          host.addEventListener('click', () => { location.href = `/majlis/live?draft=${encodeURIComponent(d.id)}`; });
          const edit = btn('متابعة', 'btn-ghost px-4 text-sm');
          edit.addEventListener('click', () => { location.href = `/majlis/create?draft=${encodeURIComponent(d.id)}`; });
          const del = btn('حذف', 'btn-ghost px-4 text-sm');
          del.addEventListener('click', () => {
            const at = drafts.findIndex((x) => x.id === d.id);
            drafts = drafts.filter((x) => x.id !== d.id); render();
            withUndo(d.id, 'حُذفت المسودة', async () => {
              try { await fs.deleteDoc(fs.doc(db, 'majalis_drafts', uid, 'drafts', d.id)); }
              catch { drafts.splice(at, 0, d); render(); }
            }, () => { drafts.splice(Math.max(0, at), 0, d); render(); });
          });
          row.append(host, edit, del);
          el.appendChild(row);
          return el;
        }

        function reportCard(r: { id: string; data: any }) {
          const v = r.data ?? {};
          const title = String(v.perQuestion?.[0]?.questionText ?? 'مجلس إعرابي');
          const el = card();
          el.innerHTML = `
            <div class="flex items-center gap-2">
              <span class="rounded-full bg-teal/10 border border-teal/30 px-2.5 py-0.5 text-xs font-black text-teal">منتهٍ</span>
              <span class="text-xs text-ink-subtle dark:text-mist-subtle">${participantsLabel(Number(v.participantCount ?? 0))}</span>
            </div>
            <p class="mt-2 font-bold text-lg text-ink dark:text-mist truncate"></p>`;
          el.querySelector('p:last-child')!.textContent = title;
          const toggle = btn('التقرير', 'btn-ghost btn-block mt-4 text-sm');
          toggle.addEventListener('click', () => { location.href = `/majlis/report?room=${encodeURIComponent(r.id)}`; });
          el.appendChild(toggle);
          return el;
        }

        function bankCard(b: { id: string; data: any }) {
          const v = b.data ?? {};
          const el = card();
          el.innerHTML = `
            <div class="flex items-center gap-2">
              <span class="rounded-full bg-paper-soft dark:bg-coal border border-stone dark:border-coal-edge px-2.5 py-0.5 text-xs font-black text-ink-soft dark:text-mist-soft">${TYPE_LABELS[String(v.type)] ?? String(v.type ?? '؟')}</span>
            </div>
            <p class="mt-2 text-[15px] font-bold text-ink dark:text-mist leading-relaxed" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden"></p>`;
          el.querySelector('p:last-child')!.textContent = String(v.questionText ?? '');
          const del = btn('حذف من البنك', 'btn-ghost mt-3 px-4 text-sm');
          del.addEventListener('click', () => {
            const at = bank.findIndex((x) => x.id === b.id);
            bank = bank.filter((x) => x.id !== b.id); render();
            withUndo(b.id, 'حُذف السؤال من البنك', async () => {
              try { await fs.deleteDoc(fs.doc(db, 'majalis_bank', uid, 'questions', b.id)); }
              catch { bank.splice(at, 0, b); render(); }
            }, () => { bank.splice(Math.max(0, at), 0, b); render(); });
          });
          el.appendChild(del);
          return el;
        }

        // A delete waits 5 s behind an undo toast before it reaches Firestore.
        // Starting another delete commits the pending one first.
        let pending: { commit: () => void; timer: number } | null = null;
        function withUndo(id: string, msg: string, commit: () => Promise<void>, undo: () => void) {
          if (pending) { clearTimeout(pending.timer); pending.commit(); }
          hiddenIds.add(id);
          const bar = q<HTMLElement>('[data-undo]');
          q('[data-undo-msg]').textContent = msg;
          bar.classList.remove('hidden');
          const run = () => { commit().finally(() => hiddenIds.delete(id)); };
          const timer = window.setTimeout(() => { bar.classList.add('hidden'); pending = null; run(); }, 5000);
          pending = { commit: run, timer };
          q<HTMLButtonElement>('[data-undo-btn]').onclick = () => {
            clearTimeout(timer); pending = null; hiddenIds.delete(id); bar.classList.add('hidden'); undo();
          };
        }
        // A tab closed with a delete pending: commit it rather than lose it.
        window.addEventListener('pagehide', () => { if (pending) { clearTimeout(pending.timer); pending.commit(); pending = null; } });

        render();
      });
    }

    async function loadLiveRoom(uid: string) {
      try {
        const rt = await import('firebase/database');
        const db = await rtdb();
        const ptr = (await rt.get(rt.ref(db, `hostActive/${uid}`))).val();
        if (!ptr?.roomId) return;
        const meta = (await rt.get(rt.ref(db, `rooms/${ptr.roomId}/meta`))).val();
        if (!meta || meta.status === 'finished' || meta.hostUid !== uid) return;
        const banner = q<HTMLElement>('[data-live-banner]');
        const live = `/majlis/live?room=${encodeURIComponent(ptr.roomId)}`;
        q<HTMLAnchorElement>('[data-live-go]').href = live;
        q<HTMLAnchorElement>('[data-live-display]').href = `${live}&view=display`;
        q('[data-live-sub]').textContent = meta.status === 'lobby'
          ? `الرمز ${meta.pin} · اللاعبون في الانتظار`
          : `الرمز ${meta.pin} · السؤال ${Number(meta.currentQuestionIndex ?? 0) + 1} من ${meta.qCount ?? '؟'}`;
        banner.classList.remove('hidden');
        banner.classList.add('panel-in');
      } catch { /* no live room, or the pointer is not readable yet */ }
    }

    async function loadQuota() {
      try {
        const d: any = (await callMajlis('majalisQuotaStatus', {})) ?? {};
        const pill = q<HTMLElement>('[data-quota-pill]');
        pill.textContent = `مجالس متبقية اليوم: ${d.remaining ?? '؟'}`;
        pill.classList.remove('hidden');
        pill.classList.add('panel-in');
      } catch { /* pill stays hidden — the server still enforces */ }
    }
  }
</script>
