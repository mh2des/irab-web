  :global(.dark) .demo-textarea { background: var(--color-coal); border-color: var(--color-coal-edge); box-shadow: none; }

  /* Result action buttons (copy / share / pdf): big, clear, with depth + lift. */
  .act-btn {
    display: inline-flex; align-items: center; gap: 0.55rem;
    min-height: 2.85rem; padding: 0.75rem 1.35rem; border-radius: 0.5rem;
    font-family: var(--font-arabic); font-size: 1.1rem; font-weight: 700; line-height: 1;
    color: var(--color-ink);
    background: var(--color-card); border: 1.5px solid var(--color-card-edge);
    appearance: none; list-style: none; text-decoration: none;
    cursor: pointer; box-shadow: var(--shadow-card);
    transition: color .2s, border-color .2s, transform .22s var(--ease-out-quart), box-shadow .22s var(--ease-out-quart);
  }
  .act-btn::before,
  .act-btn::after,
  .act-btn::marker {
    content: none;
    display: none;
  }
  :global(.dark) .act-btn { color: var(--color-mist); background: var(--color-coal-soft); border-color: var(--color-coal-edge); }
  .act-btn:hover { color: var(--color-purple); border-color: var(--color-purple); transform: translateY(-3px); box-shadow: var(--lift-shadow); }
  .act-btn svg { width: 1.35rem; height: 1.35rem; }
  /* Share is the primary action: filled so it leads the row. */
  .act-btn-primary { color: #fff; background: var(--color-purple); border-color: var(--color-purple); }
  :global(.dark) .act-btn-primary { color: #fff; background: var(--color-purple); border-color: var(--color-purple); }
  .act-btn-primary:hover { color: #fff; filter: brightness(1.07); border-color: var(--color-purple); }

  /* Skeleton shimmer: the loading placeholder while the AI parses. */
  :global(.skel) {
    background: linear-gradient(90deg,
      color-mix(in srgb, var(--color-ink) 6%, transparent) 25%,
      color-mix(in srgb, var(--color-ink) 12%, transparent) 37%,
      color-mix(in srgb, var(--color-ink) 6%, transparent) 63%);
    background-size: 400% 100%;
    animation: skel-shimmer 1.4s ease-in-out infinite;
  }
  :global(.dark .skel) {
    background: linear-gradient(90deg, rgb(255 255 255 / 0.04) 25%, rgb(255 255 255 / 0.09) 37%, rgb(255 255 255 / 0.04) 63%);
    background-size: 400% 100%;
  }
  @keyframes skel-shimmer { from { background-position: 100% 0; } to { background-position: 0 0; } }
  /* One-per-word placeholders, so the layout does not jump when cards land. */
  :global(.skel) { min-height: 9rem; border-radius: 0.75rem; }

  @media (prefers-reduced-motion: reduce) {
    :global(.word-card) { animation: none; }
