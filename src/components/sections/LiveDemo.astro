  }
  :global(.word-details-toggle::-webkit-details-marker) { display: none; }
  :global(.word-details-toggle:hover) { background: color-mix(in srgb, var(--color-purple) 16%, transparent); border-color: color-mix(in srgb, var(--color-purple) 42%, transparent); transform: translateY(-1px); }
  :global(.dark .word-details-toggle) { color: color-mix(in srgb, var(--color-purple) 86%, white); background: color-mix(in srgb, var(--color-purple) 22%, transparent); border-color: color-mix(in srgb, var(--color-purple) 36%, transparent); }
  :global(.word-details-toggle .wd-chev) { width: 0.95rem; height: 0.95rem; transition: transform .3s var(--ease-out-quart); }
  :global(.word-details[open] .word-details-toggle .wd-chev) { transform: rotate(180deg); }

  /* Case pill: a quiet status tag carrying the case color. GLOBAL (injected). */
  :global(.word-chip) {
    padding: 0.15rem 0.7rem;
    border-radius: 0.5rem;
    color: var(--chip);
    background: color-mix(in srgb, var(--chip) 11%, transparent);
    border: 1px solid color-mix(in srgb, var(--chip) 22%, transparent);
  }
  :global(.dark .word-chip) {
    color: color-mix(in srgb, var(--chip) 80%, white);
