<script>
  import { EXAMPLES, CASE_COLORS, TYPE_META, type ParseExample } from '../../data/demo-examples';
  import { maybeSignedIn } from '../../lib/session';
  import { addHistory, getHistory, getHistoryItem } from '../../lib/history';
  import { revealStagger, springPress } from '../../lib/animate';
  import { shareImage, downloadPdf, exportFilename, warmExport } from '../../lib/share';

  const STORAGE_KEY = 'irab-demo-quota';
  const FP_KEY = 'irab-fp';
  let MAX_FREE = 2;          // becomes Infinity for signed in premium users
  let idToken: string | null = null;  // sent to the worker so premium uncaps
  // TEMP: workers.dev URL until 2026-05-16 when irab.app domain unlocks transfer.
  // Then map api.irab.app to the worker and swap to:
  //   https://api.irab.app/v1/parse-public
  const API_URL = 'https://irab-api-v2.mansourhassan783.workers.dev/v1/parse-public';

  /**
   * A device signature for the anonymous free-parse cap, which the worker
   * enforces per fingerprint (2, lifetime, 90-day TTL).
   *
   * The rule this follows: include what separates one visitor from another,
   * exclude what merely changes over time for everyone. The old signature got
   * that backwards in two places and the cap silently reset as a result.
   *
   *  • userAgent carried the browser's MAJOR VERSION. Every Chrome user shares
   *    that number at any given moment, so it separated nobody — it just handed
   *    the entire anonymous audience a new identity, and two fresh parses,
   *    every release (~4 weeks). Now only the browser and platform FAMILY.
   *  • getTimezoneOffset() shifts with daylight saving, rotating identities
   *    twice a year for whole regions. The IANA zone name does not move, and
   *    carries MORE entropy than the offset (many zones share one offset).
   *  • Screen dimensions are kept: unlike the version, they genuinely separate
   *    visitors. They are sorted so rotating a phone does not mint a new
   *    identity.
   */
  function deviceSignature(): string {
    const ua = navigator.userAgent;
    const browser =
      /Edg\//.test(ua)     ? 'edge'    :
      /OPR\//.test(ua)     ? 'opera'   :
      /Firefox\//.test(ua) ? 'firefox' :
      /Chrome\//.test(ua)  ? 'chrome'  :
      /Safari\//.test(ua)  ? 'safari'  : 'other';
    const platform =
      /iPhone/.test(ua)     ? 'iphone'  :
      /iPad/.test(ua)       ? 'ipad'    :
      /Android/.test(ua)    ? 'android' :
      /Macintosh/.test(ua)  ? 'mac'     :
      /Windows/.test(ua)    ? 'windows' :
      /Linux/.test(ua)      ? 'linux'   : 'other';

    let tz = '';
    try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch { /* older engine */ }
    if (!tz) tz = String(new Date().getTimezoneOffset());

    // Sorted, so portrait and landscape hash the same.
    const dims = [screen.width, screen.height].sort((a, b) => a - b).join('x');

    return [
      browser, platform,
      navigator.language,
      `${dims}x${screen.colorDepth}`,
      tz,
      navigator.hardwareConcurrency || '',
      (navigator as any).deviceMemory || '',
    ].join('|');
  }

  async function getFingerprint(): Promise<string> {
    try {
      // Anyone who already has a cached id keeps it: re-deriving would reset
      // every existing visitor's counter once, which is the very bug this fixes.
      const cached = localStorage.getItem(FP_KEY);
      if (cached && /^[a-f0-9]{16}$/.test(cached)) return cached;
      const buf = new TextEncoder().encode(deviceSignature());
      const hash = await crypto.subtle.digest('SHA-256', buf);
      const fp = Array.from(new Uint8Array(hash)).map(b => b.toString(16).padStart(2, '0')).join('').slice(0, 16);
      localStorage.setItem(FP_KEY, fp);
      return fp;
    } catch {
      // No crypto/storage (very old or locked-down browser). A random id means
      // this visitor is uncapped by fingerprint — the per-IP daily cap is the
      // backstop, which is the correct trade: never block a real user outright.
      return 'anon-' + Math.random().toString(36).slice(2, 10);
    }
  }

  const root = document.querySelector<HTMLElement>('[data-demo]');
  if (root) {
    const lang = (root.dataset.lang === 'ar' ? 'ar' : 'en') as 'en' | 'ar';
    const i18n = lang === 'ar'
      ? { remainingN: (n: number) => n === 0 ? 'نَفِدت المحاولات' : n === 1 ? 'محاولة واحدة مجانية' : 'محاولتان مجانيتان',
          parsing: 'جارٍ الإعراب…', error: 'تعذّر الإعراب الآن. حاول مرة أخرى.', customSrc: 'جملتك', fallback: 'العرض غير متاح · عرض النموذج',
          irabLabel: 'الإعراب', showDetails: 'عرض التفاصيل', hideDetails: 'إخفاء التفاصيل',
          wordsCount: (n: number) => `${n} كلمات`, parsedIn: (s: string) => `أُعرِب في ${s} ثانية`, parse: 'أعرب', unlimited: 'إعراب غير محدود ⚡',
          signTitle: 'أنشئ حسابًا مجانيًا للمتابعة', signBody: 'سجّل الدخول لتحصل على ٣ محاولات يوميًّا.', signCta: 'تسجيل الدخول / إنشاء حساب',
          upTitle: 'بلغت حدّك اليومي المجاني', upBody: 'لديك ٣ محاولات مجانية يوميًّا. اشترك في إعراب بلس لإعرابٍ غير محدود، أو عُد غدًا.', upCta: 'اشترك في إعراب بلس',
          copied: 'تم النسخ ✓', units: 'الوحدات الإعرابية', retry: 'أعد المحاولة',
          preparing: 'جارٍ التجهيز…', exportFail: 'تعذّر التصدير',
          charLeft: (n: number) => `${n} حرفًا متبقية`,
          micStart: 'إدخال صوتي', micStop: 'إيقاف الاستماع',
          micListening: 'أنصت… تكلّم الآن بالعربية الفصحى.',
          micDenied: 'الميكروفون محظور لهذا الموقع. فعّله من إعدادات المتصفح ثم أعد المحاولة.',
          micNoSpeech: 'لم أسمع شيئًا. اقترب من الميكروفون وحاول مجددًا.',
          micNoMic: 'لم يُعثر على ميكروفون في هذا الجهاز.',
          micNetwork: 'تعذّر الوصول إلى خدمة التعرّف على الصوت. تحقّق من اتصالك وحاول مجددًا.',
          micNoLang: 'التعرّف على العربية غير متاح في هذا المتصفح. اكتب الجملة بدلًا من ذلك.',
          micError: 'تعذّر الإدخال الصوتي الآن. اكتب الجملة أو حاول لاحقًا.',
          loadSteps: ['نقرأ الجملة…', 'نحدّد أنواع الكلمات…', 'نحدّد المواقع الإعرابية…', 'نجهّز الشرح…'] }
      : { remainingN: (n: number) => n === 0 ? 'No free parses left' : n === 1 ? '1 free parse left' : '2 free parses left',
          parsing: 'Parsing…', error: "Couldn't analyze right now. Please try again.", customSrc: 'Your sentence', fallback: 'Demo offline · showing specimen',
          irabLabel: "I'rab", showDetails: 'Show details', hideDetails: 'Hide details',
          wordsCount: (n: number) => `${n} words`, parsedIn: (s: string) => `Parsed in ${s}s`, parse: 'Parse', unlimited: 'Unlimited parsing ⚡',
          signTitle: 'Create a free account to continue', signBody: 'Sign in to get 3 free parses a day.', signCta: 'Sign in / Create account',
          upTitle: "You've reached your daily free limit", upBody: 'You get 3 free parses a day. Subscribe to Irab Plus for unlimited, or come back tomorrow.', upCta: 'Subscribe to Irab Plus',
          copied: 'Copied ✓', units: 'Grammatical units', retry: 'Try again',
          preparing: 'Preparing…', exportFail: "Couldn't export",
          charLeft: (n: number) => `${n} characters left`,
          micStart: 'Voice input', micStop: 'Stop listening',
          micListening: 'Listening… speak in Arabic now.',
          micDenied: 'Microphone is blocked for this site. Allow it in your browser settings and try again.',
          micNoSpeech: "I didn't hear anything. Move closer and try again.",
          micNoMic: 'No microphone found on this device.',
          micNetwork: "Couldn't reach the speech service. Check your connection and try again.",
          micNoLang: "Arabic speech recognition isn't available in this browser. Type the sentence instead.",
          micError: "Voice input isn't available right now. Type the sentence instead.",
          loadSteps: ['Reading the sentence…', 'Identifying word types…', 'Determining grammatical roles…', 'Preparing the explanation…'] };

    const sourceMainEl = root.querySelector<HTMLElement>('[data-source-main]')!;
    const sourceSubEl  = root.querySelector<HTMLElement>('[data-source-sub]');
    const quotaDots    = root.querySelectorAll<HTMLElement>('[data-dot]');
    const verseInner   = root.querySelector<HTMLElement>('[data-demo-verse-inner]')!;
    const meaningEl    = root.querySelector<HTMLElement>('[data-demo-meaning]');
    const wordCountEl  = root.querySelector<HTMLElement>('[data-demo-wordcount]');
    const timeEl       = root.querySelector<HTMLElement>('[data-demo-time]');
    const cardsEl      = root.querySelector<HTMLElement>('[data-demo-cards]')!;
    const explanationEl = root.querySelector<HTMLElement>('[data-demo-explanation]');
    const explanationTextEl = root.querySelector<HTMLElement>('[data-explanation-text]');
    const clarificationEl = root.querySelector<HTMLElement>('[data-demo-clarification]');
    const clarificationTextEl = root.querySelector<HTMLElement>('[data-clarification-text]');
    const formEl       = root.querySelector<HTMLFormElement>('[data-demo-form]')!;
    const inputEl      = root.querySelector<HTMLTextAreaElement>('[data-demo-input]')!;
    const submitEl     = root.querySelector<HTMLButtonElement>('[data-demo-submit]')!;
    const submitLabelEl = submitEl.querySelector<HTMLElement>('[data-submit-label]')!;
    const quotaEl      = root.querySelector<HTMLElement>('[data-demo-quota]')!;
    const gateEl       = document.querySelector<HTMLElement>('[data-demo-gate]')!;
    const resultEl     = root.querySelector<HTMLElement>('[data-demo-result]')!;
    const loadingEl    = root.querySelector<HTMLElement>('[data-demo-loading]')!;
    const errorEl      = root.querySelector<HTMLElement>('[data-demo-error]')!;
    const sourceSepEl  = root.querySelector<HTMLElement>('[data-source-sep]');
    const submitSpinnerEl = submitEl.querySelector<HTMLElement>('[data-submit-spinner]')!;
    const submitArrowEl   = submitEl.querySelector<HTMLElement>('[data-submit-arrow]')!;
    const actionsEl     = root.querySelector<HTMLElement>('[data-demo-actions]')!;
    const nudgeEl       = root.querySelector<HTMLElement>('[data-demo-nudge]');
    const nudgeCtaEl    = root.querySelector<HTMLButtonElement>('[data-nudge-cta]');
    const copyBtn       = root.querySelector<HTMLButtonElement>('[data-act-copy]');
    const copyLabelEl   = root.querySelector<HTMLElement>('[data-act-copy-label]');
    const shareBtn      = root.querySelector<HTMLButtonElement>('[data-act-share]');
    const shareLabelEl  = root.querySelector<HTMLElement>('[data-act-share-label]');
    const pdfBtn        = root.querySelector<HTMLButtonElement>('[data-act-pdf]');
    const pdfLabelEl    = root.querySelector<HTMLElement>('[data-act-pdf-label]');
    const loadingStepEl = root.querySelector<HTMLElement>('[data-loading-step]');
    const loadingEchoEl = root.querySelector<HTMLElement>('[data-loading-echo]');
    const skeletonEl    = root.querySelector<HTMLElement>('[data-loading-skeleton]');
    const unitsEl       = root.querySelector<HTMLElement>('[data-demo-units]');
    const unitsWrapEl   = root.querySelector<HTMLElement>('[data-demo-units-wrap]');
    const legendEl      = root.querySelector<HTMLElement>('[data-demo-legend]');
    const charLeftEl    = root.querySelector<HTMLElement>('[data-char-left]');
    const errorTextEl   = root.querySelector<HTMLElement>('[data-demo-error-text]');
    const retryBtn      = root.querySelector<HTMLButtonElement>('[data-demo-retry]');
    const micBtn        = root.querySelector<HTMLButtonElement>('[data-demo-mic]');
    const micIdleIcon   = root.querySelector<HTMLElement>('[data-mic-idle]');
    const micLiveIcon   = root.querySelector<HTMLElement>('[data-mic-live]');
    const micStatusEl   = root.querySelector<HTMLElement>('[data-mic-status]');

    let lastEx: ParseExample | null = null;
    const exportCardEl  = document.querySelector<HTMLElement>('[data-export-card]'); // sibling of [data-demo], not a child
    const gateTitleEl  = gateEl.querySelector<HTMLElement>('[data-gate-title]')!;
    const gateBodyEl   = gateEl.querySelector<HTMLElement>('[data-gate-body]')!;
    const gateCtaEl    = gateEl.querySelector<HTMLAnchorElement>('[data-gate-cta]')!;
    const loginHref    = root.dataset.login || '/login';
    const appHref      = root.dataset.app || '/app';

    let isSignedIn = false;
    let isPremium = false;
    let currentUid: string | null = null;

    // The gate has two modes: 'signin' (anonymous, used 2 free) and 'upgrade'
    // (signed in, hit the daily limit). NEVER show 'signin' to a signed in user.
    function showGate(kind: 'signin' | 'upgrade') {
      gateTitleEl.textContent = kind === 'upgrade' ? i18n.upTitle : i18n.signTitle;
      gateBodyEl.textContent  = kind === 'upgrade' ? i18n.upBody  : i18n.signBody;
      gateCtaEl.textContent   = kind === 'upgrade' ? i18n.upCta   : i18n.signCta;
      gateCtaEl.href          = kind === 'upgrade' ? appHref      : loginHref;
      gateEl.classList.remove('hidden');
      gateEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    /* Upgrade nudge. It used to fire after every parse AND every example tap,
       which turns the moment of delight into a sales pitch and trains people to
       ignore it. Now: never for an example (the visitor invested nothing), and
       only from a visitor's SECOND parse of their own — the first one should be
       pure result — and at most once per page. */
    let ownParses = 0;
    let nudgeShown = false;
    function showNudge() {
      if (!nudgeEl || isPremium || nudgeShown || ownParses < 2) return;
      nudgeShown = true;
      nudgeEl.classList.remove('hidden');
    }
    function hideNudge() { nudgeEl?.classList.add('hidden'); }

    function getQuota(): number {
      try { const raw = localStorage.getItem(STORAGE_KEY); return raw ? parseInt(raw, 10) : 0; } catch { return 0; }
    }
    function bumpQuota() { try { localStorage.setItem(STORAGE_KEY, String(getQuota() + 1)); } catch {} }
    function renderQuota() {
      // Premium: unlimited: badge, no dots, no gate.
      if (isPremium) {
        quotaEl.textContent = i18n.unlimited;
        quotaDots.forEach((dot) => dot.classList.add('hidden'));
        gateEl.classList.add('hidden');
        hideNudge();
        submitEl.disabled = false;
        submitLabelEl.textContent = i18n.parse;
        return;
      }
      // Signed in (free): the SERVER enforces 3/day. No anonymous dots/gate here :
      // the daily-limit ("upgrade") gate appears only on a 429 from the server.
      if (isSignedIn) {
        quotaEl.textContent = '';
        quotaDots.forEach((dot) => dot.classList.add('hidden'));
        gateEl.classList.add('hidden');   // ← the bug: signed in users must never see the gate on load
        submitEl.disabled = false;
        submitLabelEl.textContent = i18n.parse;
        return;
      }
      // Anonymous: keep the free quota invisible until it is spent, then ask
      // for sign-in. Do not reveal "2 free parses" on first visit.
      const remaining = Math.max(0, MAX_FREE - getQuota());
      quotaEl.textContent = '';
      quotaDots.forEach((dot) => dot.classList.add('hidden'));
      // Only gate truly-anonymous visitors. If the signed in flag is present, auth
      // is resolving and the signed in branch will run in a moment: don't flash the gate.
      if (remaining === 0 && !maybeSignedIn()) {
        submitEl.disabled = false;
        submitLabelEl.textContent = i18n.signCta;
        showGate('signin');
      } else {
        submitEl.disabled = false;
        submitLabelEl.textContent = i18n.parse;
      }
    }

    /* Every parse is recorded via addHistory, and /history renders it — but the
       tool never mentioned it, so the feature was invisible. The link appears
       only when the log is non-empty, and is re-checked after auth resolves
       (history is keyed by uid) and after each parse. */
    const historyLinkEl = root.querySelector<HTMLElement>('[data-history-link]');
    function refreshHistoryLink() {
      if (!historyLinkEl) return;
      let n = 0;
      try {
        n = getHistory('anon', 'analyze').length;
        if (currentUid) n += getHistory(currentUid, 'analyze').length;
      } catch { n = 0; }
      historyLinkEl.classList.toggle('hidden', n === 0);
      historyLinkEl.classList.toggle('inline-flex', n > 0);
    }

    function escape(s: string): string {
      return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
    }

    function renderExample(ex: ParseExample, parsedSeconds: string | null = null) {
      lastEx = ex; // keep the latest result for copy/share/pdf
      fillExportCard(ex); // populate the branded share card
      // Update source as main + sub split by "·"
      const sourceText = ex.source ?? i18n.customSrc;
      const parts = sourceText.split('·');
      sourceMainEl.textContent = (parts[0] ?? '').trim();
      if (sourceSubEl && sourceSepEl) {
        if (parts.length > 1) {
          sourceSubEl.textContent = parts[1].trim();
          sourceSubEl.classList.remove('hidden');
          sourceSepEl.classList.remove('hidden');
        } else {
          sourceSubEl.classList.add('hidden');
          sourceSepEl.classList.add('hidden');
        }
      }

      // Verse: the Mushaf face is for Quran only (design-system rule). Anything
      // the user typed gets the body face at display size — rendering an
      // ordinary sentence in Mushaf typography reads as scripture.
      verseInner.textContent = ex.vocalizedSentence || ex.words.map((w) => w.word).join(' ');
      verseInner.style.fontFamily = ex.quran ? 'var(--font-quran)' : 'var(--font-arabic-classical)';

      // Grammatical units: one token per word, coloured by case, linked to its
      // card. Buttons, so they are keyboard reachable and announce themselves.
      if (unitsEl && unitsWrapEl) {
        unitsEl.innerHTML = ex.words.map((w, i) => {
          const hex = CASE_COLORS[w.case].hex;
          const label = `${w.word} — ${w.caseLabel}`;
          return `<button type="button" class="unit" data-unit="${i}" style="--unit:${hex};" aria-label="${escape(label)}">${escape(w.word)}</button>`;
        }).join('');
        // Only worth showing when there is more than one unit to compare.
        unitsWrapEl.classList.toggle('hidden', ex.words.length < 2);
      }

      // Legend: only the cases actually present, so it never teaches noise.
      if (legendEl) {
        const seen: string[] = [];
        ex.words.forEach((w) => { if (!seen.includes(w.case)) seen.push(w.case); });
        legendEl.innerHTML = seen.map((c) => {
          const meta = CASE_COLORS[c as keyof typeof CASE_COLORS];
          const arLabel = ex.words.find((w) => w.case === c)?.caseLabel ?? c;
          return `<span class="legend-item"><span class="legend-dot" style="--dot:${meta.hex}"></span>${escape(arLabel)}</span>`;
        }).join('');
      }

      // Meaning
      if (meaningEl) {
        if (ex.meaning) { meaningEl.textContent = `"${ex.meaning}"`; meaningEl.style.display = ''; }
        else { meaningEl.style.display = 'none'; }
      }

      // Word count + parse time. Both were computed and then dropped on the
      // floor for want of these two elements.
      if (wordCountEl) wordCountEl.textContent = i18n.wordsCount(ex.words.length);
      if (timeEl) timeEl.textContent = parsedSeconds ? i18n.parsedIn(parsedSeconds) : '';

      // Cards
      cardsEl.innerHTML = ex.words.map((w) => {
        const caseColor = CASE_COLORS[w.case].hex;
        const typeMeta = TYPE_META[w.type];
        const showDetails = w.details && w.details !== 'لا توجد تفاصيل إضافية';
        const detailsHtml = showDetails ? `
          <details class="word-details group/details" data-acc>
            <summary class="word-details-toggle">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
              <span class="group-open/details:hidden">${i18n.showDetails}</span>
              <span class="hidden group-open/details:inline">${i18n.hideDetails}</span>
              <svg class="wd-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="mt-3 pt-4 border-t border-stone/60 dark:border-coal-edge/60">
              <p lang="ar" dir="rtl" class="font-arabic text-small text-ink/75 dark:text-mist/75 leading-loose">${escape(w.details)}</p>
            </div>
          </details>` : '';
        return `
          <article class="demo-card word-card relative p-6 md:p-7" style="--rail: ${caseColor}; opacity: 0;">
            <div class="flex items-start justify-between gap-4 mb-4">
              <div lang="ar" dir="rtl" class="font-bold text-[clamp(2rem,3.6vw,2.7rem)] leading-tight text-ink dark:text-mist" style="font-family: var(--font-quran);">${escape(w.word)}</div>
              <div class="flex flex-col items-end gap-1.5 shrink-0 pt-1">
                <span lang="ar" dir="rtl" class="word-chip font-arabic text-small font-semibold" style="--chip: ${caseColor};">${escape(w.caseLabel)}</span>
                <span lang="ar" dir="rtl" class="font-arabic text-caption font-medium text-ink/45 dark:text-mist/45">${typeMeta.ar}</span>
              </div>
            </div>
            <p lang="ar" dir="rtl" class="font-arabic text-body leading-loose text-ink/85 dark:text-mist/85" style="font-family: var(--font-arabic-classical);">${escape(w.irab)}</p>
            ${detailsHtml}
          </article>`;
      }).join('');


      // Sentence explanation
      if (explanationEl && explanationTextEl) {
        if (ex.explanation) { explanationTextEl.textContent = ex.explanation; explanationEl.classList.remove('hidden'); }
        else explanationEl.classList.add('hidden');
      }
      // Clarification
      if (clarificationEl && clarificationTextEl) {
        if (ex.additionalClarification) { clarificationTextEl.textContent = ex.additionalClarification; clarificationEl.classList.remove('hidden'); }
        else clarificationEl.classList.add('hidden');
      }
    }

    root.querySelectorAll<HTMLButtonElement>('[data-demo-chip]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const ex = EXAMPLES.find((item) => item.id === btn.dataset.exampleId);
        if (!ex) return;
        errorEl.classList.add('hidden');
        loadingEl.classList.add('hidden');
        gateEl.classList.add('hidden');
        hideNudge();
        renderExample(ex);
        resultEl.classList.remove('hidden');
        actionsEl.classList.remove('hidden');
        warmExportSoon();
        revealStagger(cardsEl.querySelectorAll('.demo-card'));
        // Deliberately no nudge here: an example tap costs the visitor nothing.
        resultEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    /* ── Unit ↔ card linking ──────────────────────────────────────────────
       The strip and the cards are the same words in the same order, so index
       is the whole relationship. Delegated, because both sides are injected
       via innerHTML on every render. Focus counts as well as hover, so the
       link is reachable from the keyboard. */
    function linkWord(i: number | null) {
      const cards = cardsEl.querySelectorAll<HTMLElement>('.demo-card');
      const units = unitsEl?.querySelectorAll<HTMLElement>('.unit') ?? [];
      cards.forEach((c, idx) => c.classList.toggle('is-linked', idx === i));
      units.forEach((u, idx) => u.classList.toggle('is-linked', idx === i));
    }
    function indexOfTarget(e: Event): number | null {
      const el = e.target instanceof Element ? e.target : null;
      const unit = el?.closest<HTMLElement>('.unit');
      if (unit) return Number(unit.dataset.unit);
      const card = el?.closest<HTMLElement>('.demo-card');
      if (card) return [...cardsEl.querySelectorAll('.demo-card')].indexOf(card);
      return null;
    }
    ['pointerover', 'focusin'].forEach((evt) => {
      root.addEventListener(evt, (e) => {
        const i = indexOfTarget(e);
        if (i !== null && !Number.isNaN(i)) linkWord(i);
      });
    });
    ['pointerleave', 'focusout'].forEach((evt) => {
      root.addEventListener(evt, (e) => { if (indexOfTarget(e) !== null) linkWord(null); }, true);
    });
    // Tapping a unit is the touch equivalent of hovering it: bring its card up.
    root.addEventListener('click', (e) => {
      const el = e.target instanceof Element ? e.target : null;
      const unit = el?.closest<HTMLElement>('.unit');
      if (!unit) return;
      const i = Number(unit.dataset.unit);
      const card = cardsEl.querySelectorAll<HTMLElement>('.demo-card')[i];
      if (!card) return;
      linkWord(i);
      card.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    // Loading state on the submit button (spinner swaps in for the arrow).
    function setLoading(on: boolean) {
      submitEl.disabled = on;
      submitSpinnerEl.classList.toggle('hidden', !on);
      submitArrowEl.classList.toggle('hidden', on);
      submitLabelEl.textContent = on ? i18n.parsing : i18n.parse;
    }

    // Narrated loading: rotate the "thinking" steps while the AI parses.
    let stepTimer: number | null = null;
    function startNarration() {
      if (!loadingStepEl) return;
      const steps = i18n.loadSteps;
      let i = 0;
      loadingStepEl.textContent = steps[0];
      stepTimer = window.setInterval(() => { i = (i + 1) % steps.length; loadingStepEl.textContent = steps[i]; }, 1100);
    }
    function stopNarration() { if (stepTimer !== null) { clearInterval(stepTimer); stepTimer = null; } }

    /* The skeleton now predicts the answer's shape: one placeholder per word in
       the submitted sentence, so nothing jumps when the real cards land. */
    function buildSkeleton(text: string) {
      if (!skeletonEl) return;
      const words = text.trim().split(/\s+/).filter(Boolean).length;
      const n = Math.min(Math.max(words, 2), 8);
      skeletonEl.innerHTML = Array.from({ length: n }, () => '<div class="skel h-36 rounded-lg"></div>').join('');
    }

    /* ── The shared artefact ──────────────────────────────────────────────
       Builds a self-contained document, not a copy of the page: masthead,
       source, the sentence, a case legend, the full analysis as a table
       (including each word's extra detail), both notes, and a QR back to the
       analyzer. A share lands in a chat with no context, so it has to explain
       itself. */
    const QR_URL = 'https://irab.app/tool';
    let qrPromise: Promise<void> | null = null;
    function ensureQr(): Promise<void> {
      if (qrPromise) return qrPromise;
      const img = exportCardEl?.querySelector<HTMLImageElement>('[data-ec-qr]');
      if (!img) return Promise.resolve();
      qrPromise = import('qrcode')
        .then((mod: any) => {
          // The package ships both shapes depending on the bundler's interop.
          const toDataURL = mod?.toDataURL ?? mod?.default?.toDataURL;
          if (typeof toDataURL !== 'function') throw new Error('qrcode: no toDataURL export');
          return toDataURL(QR_URL, { width: 208, margin: 1, color: { dark: '#173847', light: '#FFFFFF' } });
        })
        .then((url: string) => { img.src = url; })
        .catch((e) => {
          // A missing QR must never block a share, but swallowing it silently
          // is how it went unnoticed in the first place.
          console.warn('[irab-qr]', e);
          qrPromise = null;   // let a later share retry
        });
      return qrPromise;
    }

    function fillExportCard(ex: ParseExample) {
      if (!exportCardEl) return; // never let a missing share card break parsing
      const q1 = <T extends HTMLElement>(sel: string) => exportCardEl.querySelector<T>(sel);

      const src = q1('[data-ec-source]');
      if (src) src.textContent = ex.source && ex.source !== i18n.customSrc ? ex.source : '';

      const v = q1('[data-ec-verse]');
      if (v) {
        v.textContent = ex.vocalizedSentence || ex.words.map((w) => w.word).join(' ');
        // Same rule as on screen: the Mushaf face is for Quran only.
        v.style.fontFamily = ex.quran ? 'var(--font-quran)' : 'var(--font-arabic-classical)';
      }

      const m = q1('[data-ec-meaning]');
      if (m) m.textContent = ex.meaning ? `"${ex.meaning}"` : '';

      const count = q1('[data-ec-count]');
      if (count) count.textContent = i18n.wordsCount(ex.words.length);

      const legend = q1('[data-ec-legend]');
      if (legend) {
        const seen: string[] = [];
        ex.words.forEach((w) => { if (!seen.includes(w.case)) seen.push(w.case); });
        legend.innerHTML = seen.map((c) => {
          const hex = CASE_COLORS[c as keyof typeof CASE_COLORS].hex;
          const label = ex.words.find((w) => w.case === c)?.caseLabel ?? c;
          return `<span class="ec-leg"><span class="ec-leg-dot" style="--dot:${hex}"></span>${escape(label)}</span>`;
        }).join('');
      }

      const rows = q1('[data-ec-rows]');
      if (rows) {
        rows.innerHTML = ex.words.map((w) => {
          const hex = CASE_COLORS[w.case].hex;
          const tokenFont = ex.quran ? 'var(--font-quran)' : 'var(--font-arabic-classical)';
          const hasDetails = w.details && w.details !== 'لا توجد تفاصيل إضافية';
          const details = hasDetails ? `<div class="ec-details">${escape(w.details)}</div>` : '';
          return `<tr class="ec-row" style="--rail:${hex}">` +
            `<td><span class="ec-tok" style="font-family:${tokenFont}">${escape(w.word)}</span></td>` +
            `<td><span class="ec-type">${escape(TYPE_META[w.type].ar)}</span>` +
              (w.functionLatin ? `<span class="ec-fn">${escape(w.functionLatin)}</span>` : '') + `</td>` +
            `<td><span class="ec-chip" style="--rail:${hex}">${escape(w.caseLabel)}</span></td>` +
            `<td><div class="ec-irab">${escape(w.irab)}</div>${details}</td>` +
          `</tr>`;
        }).join('');
      }

      const expBlock = q1('[data-ec-explanation]');
      const expText = q1('[data-ec-explanation-text]');
      if (expBlock && expText) {
        if (ex.explanation) { expText.textContent = ex.explanation; expBlock.style.display = ''; }
        else expBlock.style.display = 'none';
      }
      const clarBlock = q1('[data-ec-clarification]');
      const clarText = q1('[data-ec-clarification-text]');
      if (clarBlock && clarText) {
        if (ex.additionalClarification) { clarText.textContent = ex.additionalClarification; clarBlock.style.display = ''; }
        else clarBlock.style.display = 'none';
      }

      const date = q1('[data-ec-date]');
      if (date) {
        try { date.textContent = new Intl.DateTimeFormat(lang === 'ar' ? 'ar' : 'en', { dateStyle: 'long' }).format(new Date()); }
        catch { date.textContent = ''; }
      }

      ensureQr();
    }

    function buildCopyText(ex: ParseExample): string {
      const lines: string[] = [];
      if (ex.vocalizedSentence) lines.push(ex.vocalizedSentence);
      if (ex.meaning) lines.push(`"${ex.meaning}"`);
      lines.push('');
      ex.words.forEach((w) => lines.push(`${w.word}: ${w.irab}`));
      if (ex.explanation) { lines.push(''); lines.push(ex.explanation); }
      lines.push('', ': irab.app');
      return lines.join('\n');
    }

    // Form
    formEl.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Anonymous client-side pre-check (saves a call). Signed in users rely on
      // the server's 3/day, so they're never pre-blocked here (kills the loop).
      if (!isSignedIn && getQuota() >= MAX_FREE) { showGate('signin'); return; }
      const text = inputEl.value.trim();
      if (!text) return;

      const start = performance.now();
      errorEl.classList.add('hidden');
      resultEl.classList.add('hidden');
      gateEl.classList.add('hidden');
      actionsEl.classList.add('hidden');
      hideNudge();
      if (loadingEchoEl) loadingEchoEl.textContent = text;
      buildSkeleton(text);
      loadingEl.classList.remove('hidden');
      loadingEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setLoading(true);
      startNarration();

      try {
        const fingerprint = await getFingerprint();
        const res = await fetch(API_URL, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            ...(idToken ? { Authorization: `Bearer ${idToken}` } : {}),
          },
          body: JSON.stringify({ text, fingerprint }),
        });
        loadingEl.classList.add('hidden');
        stopNarration();
        if (res.status === 429) {
          // Limit reached: signed in → the upgrade paywall (Paddle checkout);
          // anonymous → the sign-in gate (no account yet, nothing to bill).
          if (isSignedIn && (window as any).IrabPaywall) (window as any).IrabPaywall.show();
          else showGate(isSignedIn ? 'upgrade' : 'signin');
          return;
        }
        if (!res.ok) throw new Error(`API ${res.status}`);
        const parsed = await res.json() as ParseExample;
        const elapsed = ((performance.now() - start) / 1000).toFixed(1);
        const ex = { ...parsed, source: i18n.customSrc };
        renderExample(ex, elapsed);
        try {
          addHistory({
            kind: 'analyze', uid: currentUid || 'anon', sentence: text,
            vocalized: parsed.vocalizedSentence, meaning: (parsed as any).meaning,
            wordCount: Array.isArray(parsed.words) ? parsed.words.length : undefined,
            data: ex,
          });
        } catch { /* history is best-effort */ }
        resultEl.classList.remove('hidden');
        actionsEl.classList.remove('hidden');
        warmExportSoon();
        revealStagger(cardsEl.querySelectorAll('.demo-card'));
        ownParses += 1;
        showNudge();
        refreshHistoryLink();
        if (!isSignedIn) bumpQuota();
        renderQuota();
        resultEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        // The input keeps the sentence. Clearing it meant a one-word tweak
        // required retyping the whole thing.
      } catch (err) {
        console.warn('Demo API error', err);
        loadingEl.classList.add('hidden');
        if (errorTextEl) errorTextEl.textContent = i18n.error;
        errorEl.classList.remove('hidden');
      } finally {
        setLoading(false);
        stopNarration();
      }
    });

    // ⌘ / Ctrl + Enter to analyze
    inputEl.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') { e.preventDefault(); formEl.requestSubmit(); }
    });

    /* The box grows with the sentence instead of scrolling inside three fixed
       rows, and the remaining-character count appears once it starts to matter.
       Before this the 200-char cap truncated in silence. */
    function syncInput() {
      inputEl.style.height = 'auto';
      inputEl.style.height = `${Math.min(inputEl.scrollHeight, 320)}px`;
      if (charLeftEl) {
        // Read the cap live: it is raised to 600 for premium after auth resolves.
        const cap = inputEl.maxLength > 0 ? inputEl.maxLength : 200;
        const left = cap - inputEl.value.length;
        const near = inputEl.value.length >= cap * 0.75;
        charLeftEl.textContent = near ? i18n.charLeft(left) : '';
        charLeftEl.classList.toggle('hidden', !near);
      }
    }
    inputEl.addEventListener('input', syncInput);
    syncInput();

    /* ── Voice input ──────────────────────────────────────────────────────
       Web Speech API: no backend, no per-request cost, and it recognises
       Arabic. Chrome/Edge (desktop + Android) and Safari 14.5+ have it;
       Firefox has none, which is exactly why the button starts hidden and is
       only revealed after feature detection. Requires HTTPS (or localhost).

       Text is composed as: whatever was already typed + the finalised
       transcript + the live interim, so speaking never destroys typed input
       and the interim can be replaced on every event without flicker. */
    const SpeechRec: any =
      (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
    const isMobileSpeech = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);

    if (micBtn && SpeechRec) {
      micBtn.classList.remove('hidden');

      let rec: any = null;
      let listening = false;
      let baseText = '';

      function micStatus(msg: string, isError = false) {
        if (!micStatusEl) return;
        micStatusEl.textContent = msg;
        micStatusEl.classList.toggle('is-error', isError);
      }

      function setMicUi(on: boolean) {
        listening = on;
        micBtn!.classList.toggle('is-live', on);
        micBtn!.setAttribute('aria-pressed', String(on));
        micBtn!.setAttribute('aria-label', on ? i18n.micStop : i18n.micStart);
        micBtn!.setAttribute('title', on ? i18n.micStop : i18n.micStart);
        micIdleIcon?.classList.toggle('hidden', on);
        micLiveIcon?.classList.toggle('hidden', !on);
      }

      function stopListening() {
        try { rec?.stop(); } catch { /* already stopped */ }
        setMicUi(false);
      }

      function startListening() {
        rec = new SpeechRec();
        // The analyzer only parses Arabic, so recognition stays Arabic even on
        // the English page — the UI language and the content language differ.
        rec.lang = 'ar-SA';
        // Android Chrome's continuous mode is unreliable: it ends the session
        // after each utterance and restarts oddly, which compounded the problem
        // above. One utterance per press is both steadier there and the right
        // shape for "say a sentence".
        rec.continuous = !isMobileSpeech;
        rec.interimResults = true;
        rec.maxAlternatives = 1;

        baseText = inputEl.value.trim();

        rec.onstart = () => { setMicUi(true); micStatus(i18n.micListening); };

        rec.onresult = (e: any) => {
          // Rebuild the whole transcript from e.results on every event rather
          // than appending to a running total. Android Chrome does not reliably
          // advance resultIndex past finalised results — it re-emits them — so
          // appending repeated every phrase the user had already said. Reading
          // the full list and assigning is idempotent: however many times the
          // engine re-emits, the text is right.
          const finalParts: string[] = [];
          let interim = '';
          for (let i = 0; i < e.results.length; i++) {
            const r = e.results[i];
            if (r.isFinal) finalParts.push(r[0].transcript);
            else interim += r[0].transcript;
          }
          // Join rather than concatenate: some engines prefix each segment with
          // a space and some don't, so gluing them ran words together. Joining
          // and then collapsing runs is right either way.
          const spoken = [...finalParts, interim].join(' ').replace(/\s+/g, ' ').trim();
          const joined = [baseText, spoken].filter(Boolean).join(' ');
          const cap = inputEl.maxLength > 0 ? inputEl.maxLength : 200;
          inputEl.value = joined.slice(0, cap);
          syncInput();
          // Stop cleanly once the cap is reached rather than silently dropping
          // the rest of what the user is still saying.
          if (joined.length >= cap) stopListening();
        };

        rec.onerror = (e: any) => {
          const code = e?.error;
          if (code === 'aborted') return;   // we stopped it on purpose
          if (code === 'not-allowed' || code === 'service-not-allowed') micStatus(i18n.micDenied, true);
          else if (code === 'no-speech') micStatus(i18n.micNoSpeech, true);
          else if (code === 'audio-capture') micStatus(i18n.micNoMic, true);
          // Recognition on Android runs through a cloud service, so 'network'
          // is common there and used to fall through to the useless generic
          // "something went wrong, try later".
          else if (code === 'network') micStatus(i18n.micNetwork, true);
          else if (code === 'language-not-supported') micStatus(i18n.micNoLang, true);
          else micStatus(i18n.micError, true);
          setMicUi(false);
        };

        // Fires on natural end (silence) as well as on stop(); never auto-restart,
        // an unexpectedly hot mic is a genuine privacy problem.
        rec.onend = () => {
          setMicUi(false);
          if (micStatusEl && !micStatusEl.classList.contains('is-error')) micStatus('');
          // Not on mobile: recognition now ends on its own after each utterance
          // there, and focusing would throw the soft keyboard up over the box
          // the moment the user stops speaking.
          if (!isMobileSpeech) inputEl.focus({ preventScroll: true });
        };

        try { rec.start(); }
        catch { micStatus(i18n.micError, true); setMicUi(false); }
      }

      micBtn.addEventListener('click', () => {
        micStatus('');
        if (listening) stopListening();
        else startListening();
      });

      // Submitting while the mic is hot would leave it listening behind a result.
      formEl.addEventListener('submit', () => { if (listening) stopListening(); });
      // And a page teardown must never leave the mic open.
      window.addEventListener('pagehide', () => { if (listening) stopListening(); });
    }

    // Retry: put the user back in the box with their sentence intact.
    retryBtn?.addEventListener('click', () => {
      errorEl.classList.add('hidden');
      inputEl.focus();
      if (inputEl.value.trim()) formEl.requestSubmit();
    });

    // Result actions: copy / share-as-image / PDF
    const copyDefault = copyLabelEl?.textContent ?? '';
    copyBtn?.addEventListener('click', async () => {
      if (!lastEx) return;
      try {
        await navigator.clipboard.writeText(buildCopyText(lastEx));
        if (copyLabelEl) { copyLabelEl.textContent = i18n.copied; window.setTimeout(() => { copyLabelEl.textContent = copyDefault; }, 1600); }
      } catch { /* clipboard blocked: ignore */ }
    });
    /**
     * Pull the export chunks in while the reader is reading, not when they
     * press the button. Only after a result exists — someone who never gets an
     * analysis never pays for it — and only on idle, so it cannot compete with
     * rendering the analysis itself.
     */
    function warmExportSoon() {
      const go = () => { warmExport(); };
      const ric = (window as any).requestIdleCallback;
      if (typeof ric === 'function') ric(go, { timeout: 3000 });
      else window.setTimeout(go, 1500);
    }

    /**
     * Export is real work — snapdom rasterises the card at 2.5x and jsPDF wraps
     * the result — which runs to seconds on a phone. With no feedback the tap
     * looked inert, so people tapped again and started a second capture. This
     * spins, blocks re-entry, and surfaces failure: the old .catch(() => {})
     * made a broken export look exactly like a working one.
     */
    async function runExport(
      btn: HTMLButtonElement | null,
      labelEl: HTMLElement | null,
      task: () => Promise<void>,
    ) {
      if (!btn || btn.dataset.busy === '1') return;
      const icon = btn.querySelector<HTMLElement>('[data-act-icon]');
      const spin = btn.querySelector<HTMLElement>('[data-act-spin]');
      const restore = labelEl?.textContent ?? '';
      btn.dataset.busy = '1';
      btn.disabled = true;
      btn.setAttribute('aria-busy', 'true');
      icon?.classList.add('hidden');
      spin?.classList.remove('hidden');
      if (labelEl) labelEl.textContent = i18n.preparing;
      // Hand the browser a frame to paint the busy state and get the spin onto
      // the compositor before the heavy work starts, otherwise the animation
      // never starts and the button reads as frozen.
      //
      // Never *block* on rAF: a hidden or backgrounded tab does not fire it at
      // all, so awaiting one there left the button stuck on "preparing" with
      // the export never starting. The timeout makes the frame an optimisation
      // rather than a dependency.
      await new Promise<void>((resolve) => {
        let settled = false;
        const done = () => { if (!settled) { settled = true; resolve(); } };
        requestAnimationFrame(() => requestAnimationFrame(done));
        window.setTimeout(done, 120);
      });
      try {
        await task();
      } catch (e) {
        console.warn('[irab-export]', e);
        if (labelEl) {
          labelEl.textContent = i18n.exportFail;
          await new Promise((r) => window.setTimeout(r, 2200));
        }
      } finally {
        btn.dataset.busy = '0';
        btn.disabled = false;
        btn.removeAttribute('aria-busy');
        spin?.classList.add('hidden');
        icon?.classList.remove('hidden');
        if (labelEl) labelEl.textContent = restore;
      }
    }

    shareBtn?.addEventListener('click', () => {
      if (!exportCardEl) return;
      runExport(shareBtn, shareLabelEl, async () => {
        await ensureQr();   // capturing before the QR decodes would bake in a blank
        await shareImage(exportCardEl, {
          filename: exportFilename(lastEx?.vocalizedSentence || '', 'png'),
          title: 'إعراب · irab.app',
          text: lastEx?.vocalizedSentence,
        });
      });
    });
    pdfBtn?.addEventListener('click', () => {
      if (!exportCardEl) return;
      runExport(pdfBtn, pdfLabelEl, async () => {
        await ensureQr();
        await downloadPdf(exportCardEl, exportFilename(lastEx?.vocalizedSentence || '', 'pdf'));
      });
    });

    // Upgrade nudge CTA: signed-in → Paddle checkout; anonymous → sign-in (start the funnel).
    nudgeCtaEl?.addEventListener('click', () => {
      if (isSignedIn && (window as any).IrabPaywall) (window as any).IrabPaywall.show();
      else window.location.href = loginHref;
    });

    // Spring micro-interactions on the primary + action buttons
    springPress([submitEl, ...Array.from(actionsEl.querySelectorAll('button'))]);

    renderQuota();
    refreshHistoryLink();

    // Initial state: replay a saved analysis from ?h=. Otherwise keep the
    // results area empty until the user submits text or taps an example.
    try {
      const histId = new URLSearchParams(location.search).get('h');
      if (histId) {
        const item = getHistoryItem(histId);
        if (item && item.kind === 'analyze' && item.data) {
          renderExample(item.data as ParseExample);
          resultEl.classList.remove('hidden');
          actionsEl.classList.remove('hidden');
        warmExportSoon();
          revealStagger(cardsEl.querySelectorAll('.demo-card'));
          resultEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
      // Prefill from ?s= (dictionary example links): the sentence is ready in
      // the box, the visitor presses أعرب. Nothing runs without a click.
      const prefill = new URLSearchParams(location.search).get('s');
      if (prefill && !histId) {
        inputEl.value = prefill.slice(0, 200);
        inputEl.focus();
      }
    } catch { /* ignore */ }

    // Signed in premium → uncap. Firebase is lazy-loaded ONLY when the
    // signed in flag is present, so anonymous visitors never download it.
    if (maybeSignedIn()) {
      (async () => {
        try {
          const [{ onAuth }, { fetchMe }] = await Promise.all([
            import('../../lib/auth'),
            import('../../lib/entitlement'),
          ]);
          await new Promise<void>((resolve) => {
            const unsub = onAuth(async (u) => {
              unsub();
              if (u) {
                isSignedIn = true;
                currentUid = u.uid;
                try { idToken = await u.getIdToken(); } catch { /* ignore */ }
                try { const me = await fetchMe(u); if (me?.premium) isPremium = true; } catch { /* ignore */ }
                MAX_FREE = Infinity; // no anonymous lifetime cap once signed in; server enforces 3/day
                if (isPremium) inputEl.maxLength = 600;
              }
              resolve();
            });
          });
          renderQuota();
          refreshHistoryLink();  // history is keyed by uid, which only exists now
          syncInput();           // premium raises the cap to 600
        } catch { /* ignore: anonymous/free path already rendered */ }
      })();
    }
  }
</script>
