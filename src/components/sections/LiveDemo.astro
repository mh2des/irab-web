---
/**
 * LiveDemo: the homepage's live analyzer (#demo). Since 2026-10-13 it is the
 * app-redesign analyzer (components/analyzer/Analyzer.astro, the same as
 * /tool) inside the homepage's section frame; this file keeps the section,
 * its #demo anchor (hero, sticky and pricing buttons point at it) and the
 * optional header, so the pages that embed it need no change.
 */
import Container from '../Container.astro';
import Section from '../Section.astro';
import Analyzer from '../analyzer/Analyzer.astro';

interface Props { lang?: 'en' | 'ar'; showHeader?: boolean; }
const { lang = 'en', showHeader = true } = Astro.props;

const t = lang === 'ar'
  ? {
      eyebrow: 'تجربة مباشرة',
      headline: 'جرّبه الآن. على هذه الصفحة.',
      sub: 'إعرابٌ كامل بعمق العالِم لأيّ جملة عربية تكتبها. جرّبه الآن مجانًا.',
    }
  : {
      eyebrow: 'Live demo',
      headline: 'Try it. Now. On this page.',
      sub: "Full, scholar-grade i'rab for any Arabic sentence you type. Try it now, free.",
    };
---
<Section id="demo" class="bg-paper-soft/40 dark:bg-coal-soft/40">
  <Container>
    {showHeader && (
      <div class="text-center max-w-2xl mx-auto mb-10">
        <p class="eyebrow mb-4" data-reveal>{t.eyebrow}</p>
        <h2 class="font-display text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.1] tracking-tight" data-reveal data-reveal-delay="100">
          {t.headline}
        </h2>
        <p class="mt-6 text-body-lg text-ink/70 dark:text-mist/70" data-reveal data-reveal-delay="200">
          {t.sub}
        </p>
      </div>
    )}
    <Analyzer lang={lang} />
  </Container>
</Section>
