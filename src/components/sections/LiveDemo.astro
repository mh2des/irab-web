  :global(.dark .meta-chip) { color: var(--color-mist-subtle); background: color-mix(in srgb, var(--color-mist) 8%, transparent); }
  :global(.meta-chip:empty) { display: none; }

  @media (prefers-reduced-motion: reduce) {
    :global(.demo-card.is-linked), :global(.unit:hover), :global(.unit.is-linked) { transform: none; }
  }

  /* "Show details" — a clear pill button (was easy-to-miss muted text). */
  :global(.word-details-toggle) {
    display: inline-flex; align-items: center; gap: 0.45rem; width: fit-content;
    margin-top: 1.1rem; padding: 0.5rem 0.95rem; border-radius: 0.5rem; cursor: pointer;
    font-family: var(--font-arabic); font-size: 0.95rem; font-weight: 700; line-height: 1;
    color: var(--color-purple-deep);
    background: color-mix(in srgb, var(--color-purple) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-purple) 24%, transparent);
