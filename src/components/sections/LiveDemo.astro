---
import Container from '../Container.astro';
import Section from '../Section.astro';
import Paywall from '../Paywall.astro';
import { EXAMPLES } from '../../data/demo-examples';

interface Props { lang?: 'en' | 'ar'; showHeader?: boolean; }
const { lang = 'en', showHeader = true } = Astro.props;
const login = lang === 'ar' ? '/login' : '/en/login';
const appHref = lang === 'ar' ? '/app' : '/en/app';
const historyHref = lang === 'ar' ? '/history' : '/en/history';

const t = lang === 'ar'
  ? {
      eyebrow:    'تجربة مباشرة',
      headline:   'جرّبه الآن. على هذه الصفحة.',
      sub:        'إعرابٌ كامل بعمق العالِم لأيّ جملة عربية تكتبها. لك تحليلان مجانيّان الآن، و٣ يوميًّا بتسجيل الدخول.',
      remainingN: (n: number) => n === 0 ? 'نَفِدت المحاولات' : n === 1 ? 'محاولة واحدة مجانية' : 'محاولتان مجانيتان',
      tryYour:    'جرّب جملتك',
      free:       'مجاني · بلا تسجيل',
      tryExample: 'أمثلة جاهزة:',
      history:    'سجلّي',
      micStart:   'إدخال صوتي',
      micStop:    'إيقاف الاستماع',
      nudgeTitle: 'أعجبك هذا؟ افتح إعرابًا غير محدود مع إعراب بلس.',
      nudgeCta:   'اشترك في إعراب بلس',
      placeholder:'ألصق أو اكتب أيّ جملة عربية…',
      parse:      'أعرب',
      copy:       'نسخ', share: 'مشاركة', pdf: 'PDF', madeWith: 'أُعرِب على irab.app',
      analyzing:  'جارٍ الإعراب…',
      errorMsg:   'تعذّر الإعراب الآن. حاول مرة أخرى.',
      signTitle:  'أنشئ حسابًا مجانيًا للمتابعة',
      signBody:   'لقد استخدمت محاولتيك المجانيتين. سجّل الدخول لتحصل على ٣ محاولات يوميًّا: وإن كان لديك اشتراك فيُفتح لك الإعراب غير المحدود فورًا.',
      signCta:    'تسجيل الدخول / إنشاء حساب',
      upTitle:    'بلغت حدّك اليومي المجاني',
      upBody:     'لديك ٣ محاولات مجانية يوميًّا. اشترك في إعراب بلس لإعرابٍ غير محدود، أو عُد غدًا.',
      upCta:      'اشترك في إعراب بلس',
      poweredBy:  'مدعوم بالمحرّك المحمي نفسه في التطبيق',
      gateLabel:  'لقد ذُقتَ القوّة',
      gateTitle:  'الإعراب اللامحدود في التطبيق.',
      gateBody:   'يمنحك التطبيق تحليلات يومية مجانية. يفتح Irab Plus الإعراب غير المحدود، بنك التدريب الكامل، OCR، PDF، الشهادات السنوية، والتحليلات المتقدمة.',
      googlePlay: 'حمّل من Google Play',
      appStore:   'متجر التطبيقات',
      irabLabel:  'الإعراب',
      structure:  'بنية الجملة',
      rhetorical: 'ملاحظة بلاغية',
      showDetails:'عرض التفاصيل',
      hideDetails:'إخفاء التفاصيل',
      wordsCount: (n: number) => `${n} كلمات`,
      parsedIn:   (s: string) => `أُعرِب في ${s}`,
      units:      'الوحدات الإعرابية',
      legend:     'ألوان المواقع',
      hint:       'أو اضغط ⌘ + Enter',
      retry:      'أعد المحاولة',
      tooLong:    (n: number) => `${n} حرفًا متبقية`,
    }
  : {
      eyebrow:    'Live demo',
      headline:   'Try it. Now. On this page.',
      sub:        "Full, scholar-grade i'rab for any Arabic sentence you type. Two free parses now, 3 a day when you sign in.",
      remainingN: (n: number) => n === 0 ? 'No free parses left' : n === 1 ? '1 free parse left' : '2 free parses left',
      tryYour:    'Try your own',
      free:       'Free · no signup',
      tryExample: 'Examples:',
      history:    'My history',
      micStart:   'Voice input',
      micStop:    'Stop listening',
      nudgeTitle: "Liked that? Unlock unlimited i'rab with Irab Plus.",
      nudgeCta:   'Get Irab Plus',
      placeholder:'ألصق أو اكتب أيّ جملة عربية…',
      parse:      'Parse',
      copy:       'Copy', share: 'Share', pdf: 'PDF', madeWith: 'Parsed on irab.app',
      analyzing:  'Analyzing…',
      errorMsg:   "Couldn't analyze right now. Please try again.",
      signTitle:  'Create a free account to continue',
      signBody:   "You've used your two free parses. Sign in to get 3 a day: and if you have a subscription, unlimited parsing unlocks instantly.",
      signCta:    'Sign in / Create account',
      upTitle:    "You've reached your daily free limit",
      upBody:     'You get 3 free parses a day. Subscribe to Irab Plus for unlimited, or come back tomorrow.',
      upCta:      'Subscribe to Irab Plus',
      poweredBy:  'Powered by the same protected AI engine as the app',
      gateLabel:  "YOU'VE TASTED THE POWER",
      gateTitle:  'Unlimited parsing lives in the app.',
      gateBody:   "The app gives you daily free parses. Irab Plus unlocks unlimited i'rab, the full practice bank, OCR, PDF export, annual certificates, and deeper analytics.",
      googlePlay: 'Get on Google Play',
      appStore:   'App Store',
      irabLabel:  "I'rab",
      structure:  'Sentence structure',
      rhetorical: 'Rhetorical note',
      showDetails:'Show details',
      hideDetails:'Hide details',
      wordsCount: (n: number) => `${n} words`,
      parsedIn:   (s: string) => `Parsed in ${s}`,
      units:      'Grammatical units',
      legend:     'Case colours',
      hint:       'or press ⌘ + Enter',
      retry:      'Try again',
      tooLong:    (n: number) => `${n} characters left`,
    };

---
<Section id="demo" class="bg-paper-soft/40 dark:bg-coal-soft/40">
  <Container>
    {/* ── Section header (hidden when the page provides its own hero) ──── */}
    {showHeader && (
      <div class="text-center max-w-2xl mx-auto mb-14">
        <p class="eyebrow mb-4" data-reveal>{t.eyebrow}</p>
        <h2 class="font-display text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.1] tracking-tight" data-reveal data-reveal-delay="100">
          {t.headline}
        </h2>
        <p class="mt-6 text-body-lg text-ink/70 dark:text-mist/70" data-reveal data-reveal-delay="200">
          {t.sub}
        </p>
      </div>
    )}

    {/* ── Result panel ───────────────────────────────────────────────── */}
    <div class="max-w-4xl mx-auto" data-demo data-lang={lang} data-login={login} data-app={appHref} data-history={historyHref}>
      {/* ── The tool: a clean, solid input card ─────────────────────────── */}
      <div class="demo-shell card p-4 md:p-5">
        <form data-demo-form>
          <textarea data-demo-input lang="ar" dir="rtl" rows="3" maxlength="200" placeholder={t.placeholder}
            class="demo-textarea w-full rounded-lg px-5 md:px-6 py-5 font-arabic text-[clamp(1.45rem,3vw,2rem)] leading-relaxed text-ink dark:text-mist placeholder:text-ink/30 dark:placeholder:text-mist/30 resize-none"
            style="font-family: var(--font-arabic-classical);"></textarea>
          <div class="mt-4 flex items-center justify-between gap-3" data-demo-actions-row>
            <div class="flex items-center gap-3 min-w-0">
              <span data-demo-quota class="font-arabic text-small text-ink-subtle dark:text-mist-subtle"></span>
              {/* Appears only as the 200-char cap approaches: it used to
                  truncate silently, which reads as the tool losing your text. */}
              <span data-char-left class="hidden font-arabic text-caption text-ink-subtle dark:text-mist-subtle tabular-nums"></span>
              <span class="hidden sm:inline font-arabic text-caption text-ink-subtle dark:text-mist-subtle">{t.hint}</span>
              {/* Every parse is already saved (addHistory below) but nothing
                  ever said so. Appears only once there is something to open. */}
              <a data-history-link href={historyHref} class="hidden items-center gap-1.5 font-arabic text-caption text-purple hover:text-purple-deep transition-colors">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                <span data-history-label>{t.history}</span>
              </a>
            </div>
            <div class="flex items-center gap-2">
              {/* Voice input. Rendered hidden and only revealed by the script when
                  SpeechRecognition actually exists — Firefox has none, and a mic
                  that cannot listen is worse than no mic. */}
              <button type="button" data-demo-mic class="mic-btn hidden" aria-label={t.micStart} aria-pressed="false" title={t.micStart}>
                <svg data-mic-idle class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0"/><path d="M12 17v5"/>
                </svg>
                <svg data-mic-live class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <rect x="6" y="6" width="12" height="12" rx="2.5"/>
                </svg>
              </button>
              <button type="submit" data-demo-submit class="btn-primary text-small disabled:opacity-50 disabled:cursor-not-allowed">
                <svg data-submit-spinner class="hidden w-4 h-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                <span data-submit-label>{t.parse}</span>
                <svg data-submit-arrow class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={lang === 'ar' ? 'M19 12H5M11 19l-7-7 7-7' : 'M5 12h14M13 5l7 7-7 7'}/></svg>
              </button>
            </div>
          </div>
        </form>
        {/* Spoken-state feedback; also the only channel a screen reader gets. */}
        <p data-mic-status role="status" aria-live="polite" class="mic-status"></p>
        <div class="mt-3 flex items-center gap-1" data-quota-dots>
          <span class="w-2 h-2 rounded-full bg-purple transition-all duration-300" data-dot></span>
          <span class="w-2 h-2 rounded-full bg-purple transition-all duration-300" data-dot></span>
        </div>
      </div>

      {/* The chips used to be labelled with the SOURCE ("البسملة"), so you
          could not tell what you were about to parse. They now lead with the
          sentence itself and keep the source as a caption. */}
      <div class="mt-5">
        <p class="font-arabic text-caption text-ink-subtle dark:text-mist-subtle mb-2.5">{t.tryExample}</p>
        <div class="grid gap-2.5 sm:grid-cols-3">
          {EXAMPLES.slice(0, 3).map((ex) => (
            <button type="button" data-demo-chip data-example-id={ex.id} class="ex-card" lang="ar" dir="rtl">
              <span class="ex-card-text">{ex.vocalizedSentence}</span>
              <span class="ex-card-src">{ex.source}</span>
            </button>
          ))}
        </div>
      </div>

      {/* ── Loading state ───────────────────────────────────────────────── */}
      {/* The sentence stays on screen while it is parsed — it used to vanish
          the moment you submitted, leaving two grey boxes shaped nothing like
          the result. The skeleton now matches the real card count. */}
      <div data-demo-loading class="hidden mt-10">
        <p lang="ar" dir="rtl" data-loading-echo
           class="text-center mb-7 px-4 text-[clamp(1.5rem,4vw,2.4rem)] leading-[1.9] text-ink/70 dark:text-mist/70"></p>
        <div class="flex items-center justify-center gap-3 mb-8">
          <svg class="w-6 h-6 text-purple animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
          <p data-loading-step role="status" aria-live="polite" class="font-arabic text-body text-ink-muted dark:text-mist-muted">{t.analyzing}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5" data-loading-skeleton></div>
      </div>

      {/* ── Error ───────────────────────────────────────────────────────── */}
      <div data-demo-error class="hidden mt-8 text-center" role="alert">
        <p data-demo-error-text class="font-arabic text-body text-red-600 dark:text-red-400"></p>
        <button type="button" data-demo-retry class="btn-ghost mt-4">{t.retry}</button>
      </div>

      {/* ── Result (hidden until the user parses: no specimen on load) ──── */}
      <div data-demo-result class="hidden mt-10">
        <div data-demo-source class="flex items-baseline gap-2.5 mb-6 px-1 min-h-[2rem]">
          <span data-source-main class="font-arabic-display font-bold text-[clamp(1.125rem,2vw,1.5rem)] text-purple leading-none"></span>
          <span data-source-sep class="hidden text-ink/25 dark:text-mist/25 text-small select-none">·</span>
          <span data-source-sub class="hidden font-mono text-caption text-ink/55 dark:text-mist/55 tracking-widest"></span>
        </div>

        {/* The verse keeps its own typography and stays unsegmented: the words
            are split grammatically (بِ + ٱسْمِ), so rebuilding the line from them
            would render البسملة as "بِ ٱسْمِ". The Mushaf face is applied only to
            Quranic text — see the `quran` flag on ParseExample. */}
        <div lang="ar" dir="rtl" class="text-center mb-5 px-4" data-demo-verse>
          <div class="text-[clamp(2rem,5.5vw,3.75rem)] leading-[1.9] text-ink dark:text-mist" data-demo-verse-inner></div>
        </div>

        <p class="hidden text-center text-body text-ink-subtle dark:text-mist-subtle italic mb-6" dir="auto" data-demo-meaning></p>

        {/* Meta: word count + how long the parse took. Both were already being
            computed and then discarded — the elements simply weren't here. */}
        <div class="flex items-center justify-center flex-wrap gap-2 mb-7" data-demo-meta>
          <span data-demo-wordcount class="meta-chip"></span>
          <span data-demo-time class="meta-chip"></span>
        </div>

        {/* Grammatical units: the interactive index into the cards. Hovering or
            focusing a unit raises its card and vice versa, and the case colour
            makes the whole sentence readable at a glance — which is what the
            `case` field was always documented to drive. */}
        <div class="mb-7" data-demo-units-wrap>
          <p class="units-label">{t.units}</p>
          <div lang="ar" dir="rtl" class="units-strip" data-demo-units></div>
          <div class="legend" data-demo-legend></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-6" data-demo-cards></div>

        <div class="hidden card p-7 md:p-8 mb-5" data-demo-explanation>
          <p class="flex items-center gap-2 mb-4 font-arabic-display font-bold text-3xl text-purple">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            <span lang="ar" dir="rtl" class="font-arabic">{t.structure}</span>
          </p>
          <p lang="ar" dir="rtl" class="font-arabic text-body-lg text-ink/85 dark:text-mist/85 leading-loose" style="font-family: var(--font-arabic-classical);" data-explanation-text></p>
        </div>

        <div class="hidden card p-6 md:p-7 mb-5" data-demo-clarification>
          <p class="flex items-center gap-2 mb-3 font-arabic-display font-bold text-3xl text-teal">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            <span lang="ar" dir="rtl" class="font-arabic">{t.rhetorical}</span>
          </p>
          <p lang="ar" dir="rtl" class="font-arabic text-body text-ink/80 dark:text-mist/80 leading-loose" style="font-family: var(--font-arabic-classical);" data-clarification-text></p>
        </div>

        {/* Result actions sit below EVERYTHING the analysis produced — cards and
             both notes — so the export offer comes after the reader has the
             whole answer, not halfway through it. */}
        <div data-demo-actions class="hidden mb-10 flex items-center justify-center flex-wrap gap-3">
          <button type="button" data-act-copy class="act-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            <span data-act-copy-label>{t.copy}</span>
          </button>
          <button type="button" data-act-share class="act-btn act-btn-primary">
            <svg data-act-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            <svg data-act-spin class="hidden animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
            <span data-act-share-label>{t.share}</span>
          </button>
          <button type="button" data-act-pdf class="act-btn">
            <svg data-act-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
            <svg data-act-spin class="hidden animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
            <span data-act-pdf-label>{t.pdf}</span>
          </button>
        </div>

        {/* Contextual upgrade nudge — the peak-delight moment, revealed after a
            parse/chip for non-premium users. NOT part of the share/PDF export. */}
        <div data-demo-nudge class="hidden mb-8 rounded-lg border border-purple/25 bg-purple/5 dark:bg-purple/10 px-6 py-7 text-center">
          <p class="font-bold text-h3 leading-snug mb-4">{t.nudgeTitle}</p>
          <button type="button" data-nudge-cta class="btn-primary lift">{t.nudgeCta}</button>
        </div>

        {/* Branded footer: part of the shared image/PDF */}
        <div class="flex items-center justify-center gap-2 pt-6 mt-2 border-t border-stone dark:border-coal-edge">
          <img src="/brand-mark.png" alt="" aria-hidden="true" width="20" height="20" class="w-5 h-5 rounded-md" />
          <span class="font-arabic text-small text-ink/45 dark:text-mist/45">{t.madeWith}</span>
        </div>
      </div>
    </div>

    {/* ── The shared artefact ────────────────────────────────────────────
         Rendered off-screen and captured by snapdom for both the PNG and the
         PDF. It is deliberately NOT a screenshot of the page: a share lands in
         someone's chat with no context, so it carries its own masthead, a real
         table of the analysis, both notes, and a QR back to the analyzer. */}
    <div data-export-card lang="ar" dir="rtl" aria-hidden="true" class="export-card">
      <header class="ec-head">
        <img src="/brand-mark.png" alt="" aria-hidden="true" width="52" height="52" class="ec-logo" />
        <div class="ec-id">
          <div class="ec-brand">إعراب</div>
          <div class="ec-sub">إعرابٌ كامل بالذكاء الاصطناعي</div>
        </div>
        <div class="ec-source" data-ec-source></div>
      </header>

      <section class="ec-hero">
        <div class="ec-verse" data-ec-verse></div>
        <div class="ec-meaning" dir="auto" data-ec-meaning></div>
      </section>

      <div class="ec-meta">
        <span class="ec-count" data-ec-count></span>
        <span class="ec-legend" data-ec-legend></span>
      </div>

      <table class="ec-table">
        <thead>
          <tr>
            <th class="ec-c-word">الكلمة</th>
            <th class="ec-c-type">النوع</th>
            <th class="ec-c-case">الموقع</th>
            <th class="ec-c-irab">الإعراب</th>
          </tr>
        </thead>
        <tbody data-ec-rows></tbody>
      </table>

      <div class="ec-note" data-ec-explanation>
        <div class="ec-note-label">بنية الجملة</div>
        <div class="ec-note-text" data-ec-explanation-text></div>
      </div>
      <div class="ec-note ec-note-teal" data-ec-clarification>
        <div class="ec-note-label">ملاحظة بلاغية</div>
        <div class="ec-note-text" data-ec-clarification-text></div>
      </div>

      <footer class="ec-foot">
        <img class="ec-qr" data-ec-qr alt="" aria-hidden="true" width="104" height="104" />
        <div class="ec-foot-main">
          <div class="ec-foot-url">irab.app</div>
          <div class="ec-foot-cta">امسح الرمز وأعرِب أيّ جملة عربية فورًا</div>
        </div>
        <div class="ec-date" data-ec-date></div>
      </footer>
    </div>

    {/* ── Sign-up gate (shown after the free parses are used) ──────────── */}
    <div data-demo-gate class="hidden max-w-2xl mx-auto mt-10 card p-8 md:p-10 text-center">
      <p data-gate-title class="font-arabic-display font-bold text-h2 leading-tight mb-3">{t.signTitle}</p>
      <p data-gate-body class="font-arabic text-body text-ink/65 dark:text-mist/65 leading-loose mb-7 max-w-lg mx-auto">{t.signBody}</p>
      <a data-gate-cta href={login} class="btn-primary lift">{t.signCta}</a>
    </div>
  </Container>
</Section>

<Paywall lang={lang} />

<style>
  /* Entrance: `backwards` fill (not forwards) so the settled transform stays
     free for the hover lift below. */
  /* These target innerHTML-injected result cards, so they must be GLOBAL :
     Astro scoped styles never reach dynamically-inserted nodes (that was why
     the result cards looked unstyled: plain text on the background). */
  /* Word-card reveal is driven by Motion (revealStagger): springy stagger. */
  :global(.demo-card details[open] > summary ~ *) { animation: details-in 350ms ease-out; }
