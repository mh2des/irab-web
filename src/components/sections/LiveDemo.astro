  }
  :global(.unit:focus-visible) { outline: 2px solid var(--color-purple); outline-offset: 2px; }

  /* ── Case legend: the colours mean something; say what ─────────────────── */
  .legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.35rem 1rem; margin-top: 0.9rem; }
  :global(.legend-item) {
