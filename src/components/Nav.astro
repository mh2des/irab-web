---
import Container from './Container.astro';
import ThemeToggle from './ThemeToggle.astro';
import { enTwinFor } from '../lib/en-twin';

interface Props {
  lang?: 'en' | 'ar';
}

const { lang = 'ar' } = Astro.props;

const t = lang === 'ar'
  ? {
      tryDemo:  'محلّل الإعراب',
      practice: 'التدريب',
      challenges: 'التحديات',
      dictionary: 'المعجم',
      quran:    'إعراب القرآن',
      library:  'المكتبة',
      pricing:  'الأسعار',
      features: 'المميزات',
      majalis:  'المجالس',
      signin:   'دخول',
      myApp:    'حسابي',
      cta:      'جرِّب بلس',
      menu:     'القائمة',
      close:    'إغلاق',
    }
  : {
      tryDemo:  "I'rab analyzer",
      practice: 'Practice',
      challenges: 'Challenges',
      dictionary: 'Dictionary',
      quran:    "Quran i'rab",
      library:  'Library',
      pricing:  'Pricing',
      features: 'Features',
      majalis:  'Majalis',
      signin:   'Sign in',
      myApp:    'Profile',
      cta:      'Try Plus',
      menu:     'Menu',
      close:    'Close',
    };

// Arabic at root, English under /en
const home = lang === 'ar' ? '/' : '/en';
const quranHref = lang === 'ar' ? '/quran' : '/en/quran'; // Quran-i'rab section (en mirror = pilot)
const toolHref = lang === 'ar' ? '/tool' : '/en/tool'; // the AI analyzer landing page
const practiceHref = lang === 'ar' ? '/practice/play' : '/en/practice/play'; // do-it-yourself + AI feedback
const challengesHref = lang === 'ar' ? '/challenges' : '/en/challenges'; // ready-made answer-choice drills
const dictionaryHref = lang === 'ar' ? '/dictionary' : '/en/dictionary'; // smart dictionary tool
const libraryHref = lang === 'ar' ? '/library' : '/en/library'; // classical grammar library
const signinHref = lang === 'ar' ? '/login' : '/en/login'; // web account
const appHref = lang === 'ar' ? '/app' : '/en/app'; // signed in web app hub
const pricingHref = lang === 'ar' ? '/pricing' : '/en/pricing';
const majalisHref = '/majalis'; // live-quiz landing (AR only; EN nav keeps Features)
// «جرِّب بلس» goes to the plan chooser, NOT straight into a checkout: the
// user picks annual (with trial) or monthly there, then /app?checkout=<plan>
// opens the payment overlay. (Owner decision 2026-08-07.)
const plusHref = pricingHref;

// Equivalent URL in the other language for the toggle. AR → EN goes through
// enTwinFor so we never link to a 404 (most Quran pages have no EN twin yet);
// EN → AR is always safe since Arabic is the superset.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const otherUrl = lang === 'ar'
  ? enTwinFor(path)
  : (path === '/en' ? '/' : path.replace(/^\/en/, ''));

// A nav tab is "active" on its own page and any sub-page (e.g. /practice/play
// keeps Practice active, /quran/al-fatihah keeps Quran active).
const isActive = (href: string) =>
  path === href ||
  path.startsWith(href + '/') ||
  (href === practiceHref && path === (lang === 'ar' ? '/practice' : '/en/practice'));
---
<nav class="sticky top-0 z-50 bg-paper/90 dark:bg-coal/90 backdrop-blur-xl border-b border-stone/70 dark:border-coal-edge/70">
  <Container size="wide">
    <div class="flex items-center justify-between py-3 gap-3">
      {/* Logo: pulled snug into the corner */}
      <a href={home} class="flex items-center gap-2.5 shrink-0 group -ms-1">
        <img src="/brand-mark.png" alt={lang === 'ar' ? 'إعراب' : 'Irab'} width="48" height="48" loading="eager" decoding="sync" class="w-11 h-11 md:w-12 md:h-12 rounded-lg shrink-0 transition-transform duration-200 group-hover:scale-105"/>
        <span aria-hidden="true" class:list={[lang === 'ar' ? 'font-arabic-display font-bold text-4xl' : 'font-display text-3xl', 'tracking-tight']}>{lang === 'ar' ? 'إعراب' : 'Irab'}</span>
      </a>

      {/* Desktop links: segmented pill bar, soft fill + shadow lift on hover */}
      <div class="nav-bar hidden xl:flex items-center gap-1 text-caption">
        <a href={toolHref}           class:list={['nav-link', { 'is-active': isActive(toolHref) }]}       aria-current={isActive(toolHref) ? 'page' : undefined}>{t.tryDemo}</a>
        <a href={practiceHref}       class:list={['nav-link', { 'is-active': isActive(practiceHref) }]}   aria-current={isActive(practiceHref) ? 'page' : undefined}>{t.practice}</a>
        <a href={challengesHref}     class:list={['nav-link', { 'is-active': isActive(challengesHref) }]} aria-current={isActive(challengesHref) ? 'page' : undefined}>{t.challenges}</a>
        {lang === 'ar'
          ? <a href={majalisHref} class:list={['nav-link', { 'is-active': isActive(majalisHref) }]} aria-current={isActive(majalisHref) ? 'page' : undefined}>{t.majalis}</a>
          : <a href={`${home}#features`} class="nav-link">{t.features}</a>}
        <a href={dictionaryHref}     class:list={['nav-link', { 'is-active': isActive(dictionaryHref) }]} aria-current={isActive(dictionaryHref) ? 'page' : undefined}>{t.dictionary}</a>
        <a href={quranHref}          class:list={['nav-link', { 'is-active': isActive(quranHref) }]}       aria-current={isActive(quranHref) ? 'page' : undefined}>{t.quran}</a>
        <a href={libraryHref}        class:list={['nav-link', { 'is-active': isActive(libraryHref) }]}     aria-current={isActive(libraryHref) ? 'page' : undefined}>{t.library}</a>
        <a href={pricingHref}        class:list={['nav-link', { 'is-active': isActive(pricingHref) }]}     aria-current={isActive(pricingHref) ? 'page' : undefined}>{t.pricing}</a>
      </div>

      {/* Right cluster, desktop */}
      <div class="hidden xl:flex items-center gap-2">
        {/* Language toggle (segmented) */}
        <div class="flex items-center bg-stone/60 dark:bg-coal-edge/60 rounded-lg p-0.5 font-mono text-caption" role="group" aria-label="Language">
          <a
            href={lang === 'ar' ? path : otherUrl}
            class:list={[
              'px-2.5 py-1 rounded-md transition-colors duration-200',
              lang === 'ar' ? 'bg-paper dark:bg-coal text-ink dark:text-mist shadow-sm' : 'text-ink/50 dark:text-mist/50 hover:text-ink dark:hover:text-mist',
            ]}
            aria-current={lang === 'ar' ? 'true' : 'false'}
          >ع</a>
          <a
            href={lang === 'en' ? path : otherUrl}
            class:list={[
              'px-2.5 py-1 rounded-md transition-colors duration-200',
              lang === 'en' ? 'bg-paper dark:bg-coal text-ink dark:text-mist shadow-sm' : 'text-ink/50 dark:text-mist/50 hover:text-ink dark:hover:text-mist',
            ]}
            aria-current={lang === 'en' ? 'true' : 'false'}
          >EN</a>
        </div>

        <ThemeToggle />

        <a href={signinHref} data-signin-link class="nav-link">{t.signin}</a>
        <a href={appHref} data-app-link class="nav-link nav-link-feature hidden">{t.myApp}</a>

        <a
          href={plusHref}
          data-upsell-cta
          class="inline-flex items-center gap-2 px-4 py-2 whitespace-nowrap bg-ink dark:bg-mist text-paper dark:text-coal text-caption font-bold tracking-tight rounded-lg hover:bg-purple dark:hover:bg-purple hover:text-white lift"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" class="w-3.5 h-3.5"><path d="M13 2 4.7 13.2h5.6L11 22l8.3-11.2h-5.6z"/></svg>
          {t.cta}
        </a>
      </div>

      {/* Right cluster, mobile */}
      <div class="xl:hidden flex items-center gap-2">
        <ThemeToggle />
        <button
          type="button"
          data-mobile-toggle
          aria-label={t.menu}
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="grid place-items-center w-10 h-10 rounded-lg text-ink dark:text-mist hover:bg-stone/70 dark:hover:bg-coal-edge/70 transition-colors duration-200"
        >
          <svg data-icon-menu class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"/>
          </svg>
          <svg data-icon-close class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6l-12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </Container>

  {/* Mobile menu, slide-down panel */}
  <div
    id="mobile-menu"
    data-mobile-menu
    class="xl:hidden hidden border-t border-stone dark:border-coal-edge bg-paper dark:bg-coal"
  >
    <Container>
      <div class="py-6 flex flex-col gap-1">
        <a href={toolHref}           class:list={['nav-mlink', isActive(toolHref) && 'is-active']}       aria-current={isActive(toolHref) ? 'page' : undefined}>{t.tryDemo}</a>
        <a href={practiceHref}       class:list={['nav-mlink', isActive(practiceHref) && 'is-active']}   aria-current={isActive(practiceHref) ? 'page' : undefined}>{t.practice}</a>
        <a href={challengesHref}     class:list={['nav-mlink', isActive(challengesHref) && 'is-active']} aria-current={isActive(challengesHref) ? 'page' : undefined}>{t.challenges}</a>
        {lang === 'ar'
          ? <a href={majalisHref} class:list={['nav-mlink', isActive(majalisHref) && 'is-active']} aria-current={isActive(majalisHref) ? 'page' : undefined}>{t.majalis}</a>
          : <a href={`${home}#features`} class="nav-mlink">{t.features}</a>}
        <a href={dictionaryHref}     class:list={['nav-mlink', isActive(dictionaryHref) && 'is-active']} aria-current={isActive(dictionaryHref) ? 'page' : undefined}>{t.dictionary}</a>
        <a href={quranHref}          class:list={['nav-mlink', isActive(quranHref) && 'is-active']}       aria-current={isActive(quranHref) ? 'page' : undefined}>{t.quran}</a>
        <a href={libraryHref}        class:list={['nav-mlink', isActive(libraryHref) && 'is-active']}     aria-current={isActive(libraryHref) ? 'page' : undefined}>{t.library}</a>
        <a href={pricingHref}        class:list={['nav-mlink', isActive(pricingHref) && 'is-active']}     aria-current={isActive(pricingHref) ? 'page' : undefined}>{t.pricing}</a>
        <a href={signinHref} data-signin-link class="block py-3 font-display text-h3 tracking-tight text-purple hover:text-purple-deep transition-colors">{t.signin}</a>
        <a href={appHref} data-app-link class="hidden py-3 font-display text-h3 tracking-tight text-teal hover:text-teal-deep transition-colors">{t.myApp}</a>

        <div class="hairline my-5"></div>

        {/* Mobile language toggle */}
        <div class="flex items-center justify-between py-2">
          <span class="font-mono text-caption text-ink/50 dark:text-mist/50 uppercase tracking-widest">{lang === 'ar' ? 'اللغة' : 'Language'}</span>
          <div class="flex items-center bg-stone/60 dark:bg-coal-edge/60 rounded-lg p-0.5 font-mono text-caption">
            <a
              href={lang === 'ar' ? path : otherUrl}
              class:list={['px-3 py-1.5 rounded-md transition-colors duration-200', lang === 'ar' ? 'bg-paper dark:bg-coal text-ink dark:text-mist shadow-sm' : 'text-ink/50 dark:text-mist/50']}
            >العربية</a>
            <a
              href={lang === 'en' ? path : otherUrl}
              class:list={['px-3 py-1.5 rounded-md transition-colors duration-200', lang === 'en' ? 'bg-paper dark:bg-coal text-ink dark:text-mist shadow-sm' : 'text-ink/50 dark:text-mist/50']}
            >English</a>
          </div>
        </div>

        <a
          href={plusHref}
          data-upsell-cta
          class="mt-3 inline-flex items-center justify-center gap-2 px-5 py-3.5 bg-ink dark:bg-mist text-paper dark:text-coal font-bold tracking-tight rounded-lg hover:bg-purple dark:hover:bg-purple hover:text-white lift"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" class="w-4 h-4"><path d="M13 2 4.7 13.2h5.6L11 22l8.3-11.2h-5.6z"/></svg>
          {t.cta}
        </a>
      </div>
    </Container>
  </div>
</nav>

<style>
  /* Segmented pill bar holding the links (screenshot inspiration). */
  .nav-bar {
    position: relative;
    background: color-mix(in srgb, var(--color-stone) 40%, transparent);
    border-radius: 0.75rem;
    padding: 0.3rem;
  }
  :global(.dark) .nav-bar { background: color-mix(in srgb, var(--color-coal-edge) 45%, transparent); }

  /* Sliding hover highlight (unlumen Highlight port): one shared pill that
     springs between links; geometry is driven from the script below. */
  .nav-link { position: relative; z-index: 1; }
  :global(.nav-glide) {
    position: absolute; left: 0; top: 0; z-index: 0;
    border-radius: 0.5rem; opacity: 0; pointer-events: none;
    background: var(--color-paper);
    box-shadow: 0 8px 20px -10px color-mix(in srgb, var(--color-purple) 50%, transparent),
                0 1px 2px color-mix(in srgb, var(--color-ink) 8%, transparent);
    transition: opacity .18s var(--ease-out-quart);
  }
  :global(.dark .nav-glide) {
    background: var(--color-coal-soft);
    box-shadow: 0 8px 22px -10px color-mix(in srgb, var(--color-purple) 60%, transparent);
  }
  :global(.nav-glide.on) { opacity: 1; }
  /* While the glide pill is live it carries the pill visual; the per-link
     hover/active backgrounds would double it. Text colors stay from above. */
  .nav-bar.has-glide .nav-link:hover,
  .nav-bar.has-glide .nav-link.is-active {
    background: transparent; box-shadow: none; transform: none;
  }

  /* Each link is a pill that fills + lifts with a soft shadow on hover. */
  .nav-link {
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    color: color-mix(in srgb, var(--color-ink) 68%, transparent);
    white-space: nowrap;
    transition: background-color .22s var(--ease-out-quart),
                box-shadow .22s var(--ease-out-quart),
                transform .22s var(--ease-out-quart), color .2s;
  }
  :global(.dark) .nav-link { color: color-mix(in srgb, var(--color-mist) 68%, transparent); }
  .nav-link:hover {
    color: var(--color-purple-deep);
    background: var(--color-paper);
    box-shadow: 0 8px 20px -10px color-mix(in srgb, var(--color-purple) 50%, transparent),
                0 1px 2px color-mix(in srgb, var(--color-ink) 8%, transparent);
    transform: translateY(-1.5px);
  }
  :global(.dark) .nav-link:hover {
    color: var(--color-mist);
    background: var(--color-coal-soft);
    box-shadow: 0 8px 22px -10px color-mix(in srgb, var(--color-purple) 60%, transparent);
  }

  /* Active tab: the same lift treatment, kept on the current page's tab. */
  .nav-link.is-active {
    color: var(--color-purple-deep);
    background: var(--color-paper);
    box-shadow: 0 8px 20px -10px color-mix(in srgb, var(--color-purple) 50%, transparent),
                0 1px 2px color-mix(in srgb, var(--color-ink) 8%, transparent);
    transform: translateY(-1.5px);
  }
  :global(.dark) .nav-link.is-active {
    color: var(--color-mist);
    background: var(--color-coal-soft);
    box-shadow: 0 8px 22px -10px color-mix(in srgb, var(--color-purple) 60%, transparent);
  }

  /* The Quran-i'rab feature: teal accent so it stands out as the key feature. */
  .nav-link-feature { color: var(--color-teal); font-weight: 700; }
  :global(.dark) .nav-link-feature { color: color-mix(in srgb, var(--color-teal) 88%, white); }
  .nav-link-feature:hover {
    color: var(--color-teal-deep);
    background: var(--color-paper);
    box-shadow: 0 8px 20px -10px color-mix(in srgb, var(--color-teal) 55%, transparent),
                0 1px 2px color-mix(in srgb, var(--color-ink) 8%, transparent);
  }
  :global(.dark) .nav-link-feature:hover { color: color-mix(in srgb, var(--color-teal) 88%, white); background: var(--color-coal-soft); }

  /* Mobile menu links — large display rows; active page is highlighted. */
  .nav-mlink {
    display: block; padding: 0.75rem 0.85rem;
    border-radius: 0.5rem;
    font-family: var(--font-display); font-size: var(--text-h3); line-height: 1.3;
    color: var(--color-ink); transition: color .2s, background-color .2s;
  }
  :global(.dark) .nav-mlink { color: var(--color-mist); }
  .nav-mlink:hover { color: var(--color-purple); background: color-mix(in srgb, var(--color-stone) 45%, transparent); }
  .nav-mlink.is-active { color: var(--color-purple-deep); background: color-mix(in srgb, var(--color-purple) 10%, transparent); font-weight: 700; }
  :global(.dark) .nav-mlink.is-active { color: color-mix(in srgb, var(--color-purple) 85%, white); }
</style>

<script>
  import { maybeSignedIn } from '../lib/session';

  // Signed in users see their profile link instead of "Sign in" (progressive, no Firebase).
  if (maybeSignedIn()) {
    document.querySelectorAll<HTMLElement>('[data-signin-link]').forEach((el) => el.classList.add('hidden'));
    document.querySelectorAll<HTMLElement>('[data-app-link]').forEach((el) => el.classList.remove('hidden'));
    // Hide the «جرِّب بلس» CTA for already-premium users. 'irab-premium' is a
    // cached copy of the last /v1/me answer (written by entitlement.fetchMe);
    // a stale value only shows/hides the button, never blocks anything.
    let premium = false;
    try { premium = localStorage.getItem('irab-premium') === '1'; } catch { /* keep the CTA */ }
    if (premium) {
      document.querySelectorAll<HTMLElement>('[data-upsell-cta]').forEach((el) => el.classList.add('hidden'));
    }
  }

  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const menu   = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const open   = document.querySelector<SVGElement>('[data-icon-menu]');
  const close  = document.querySelector<SVGElement>('[data-icon-close]');

  function closeMenu() {
    menu?.classList.add('hidden');
    open?.classList.remove('hidden');
    close?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    if (isOpen) {
      closeMenu();
    } else {
      menu?.classList.remove('hidden');
      open?.classList.add('hidden');
      close?.classList.remove('hidden');
      toggle?.setAttribute('aria-expanded', 'true');
    }
  });

  // Close on link tap inside the menu
  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', closeMenu);
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  // Close on resize to desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1280) closeMenu();
  });

  // ── Sliding hover highlight across the desktop nav (unlumen Highlight).
  // One shared pill springs between links (stiffness 1250 / damping 40 /
  // mass 0.5 ≈ the original), parks on the active tab, fades out otherwise.
  const bar = document.querySelector<HTMLElement>('.nav-bar');
  if (bar &&
      matchMedia('(hover: hover) and (pointer: fine)').matches &&
      !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const glide = document.createElement('span');
    glide.className = 'nav-glide';
    glide.setAttribute('aria-hidden', 'true');
    bar.prepend(glide);
    bar.classList.add('has-glide');

    const K = 1250, D = 40, M = 0.5;
    type Axis = { x: number; v: number };
    const ax = { x: { x: 0, v: 0 }, y: { x: 0, v: 0 }, w: { x: 0, v: 0 }, h: { x: 0, v: 0 } };
    const target = { x: 0, y: 0, w: 0, h: 0 };
    let current: HTMLElement | null = null;
    let visible = false;
    let raf = 0, last = 0;

    const stepAxis = (a: Axis, t: number, dt: number) => {
      while (dt > 0) {
        const h = Math.min(dt, 0.008);
        a.v += ((-K * (a.x - t) - D * a.v) / M) * h;
        a.x += a.v * h;
        dt -= h;
      }
    };
    const done = (a: Axis, t: number) => Math.abs(a.x - t) < 0.3 && Math.abs(a.v) < 0.3;

    const loop = (t: number) => {
      // Hold writes while a theme view-transition sweeps (see ui-fx.ts).
      if (document.documentElement.classList.contains('vt-active')) {
        last = t; raf = requestAnimationFrame(loop); return;
      }
      const dt = Math.min((t - last) / 1000, 0.032);
      last = t;
      stepAxis(ax.x, target.x, dt); stepAxis(ax.y, target.y, dt);
      stepAxis(ax.w, target.w, dt); stepAxis(ax.h, target.h, dt);
      glide.style.setProperty('translate', `${ax.x.x.toFixed(2)}px ${ax.y.x.toFixed(2)}px`);
      glide.style.width = `${ax.w.x.toFixed(2)}px`;
      glide.style.height = `${ax.h.x.toFixed(2)}px`;
      raf = done(ax.x, target.x) && done(ax.y, target.y) && done(ax.w, target.w) && done(ax.h, target.h)
        ? 0 : requestAnimationFrame(loop);
    };
    const kick = () => { if (!raf) { last = performance.now(); raf = requestAnimationFrame(loop); } };

    const show = (link: HTMLElement, instant = false) => {
      current = link;
      target.x = link.offsetLeft; target.y = link.offsetTop;
      target.w = link.offsetWidth; target.h = link.offsetHeight;
      if (instant || !visible) {
        ax.x = { x: target.x, v: 0 }; ax.y = { x: target.y, v: 0 };
        ax.w = { x: target.w, v: 0 }; ax.h = { x: target.h, v: 0 };
      }
      visible = true;
      glide.classList.add('on');
      kick();
    };
    const park = (instant = false) => {
      const active = bar.querySelector<HTMLElement>('.nav-link.is-active');
      if (active) {
        show(active, instant);
      } else {
        visible = false;
        current = null;
        glide.classList.remove('on');
      }
    };

    bar.querySelectorAll<HTMLElement>('.nav-link').forEach((link) => {
      link.addEventListener('mouseenter', () => show(link));
    });
    bar.addEventListener('mouseleave', () => park());

    park(true);
    // Re-measure once webfonts land and on resize (link widths shift).
    document.fonts?.ready.then(() => { if (current) show(current, true); });
    window.addEventListener('resize', () => { if (current) show(current, true); });
  }
</script>
